+        if (!height || *height <= *options.rescue_height || *height == std::numeric_limits<int>::max()) {
+            throw std::runtime_error(strprintf("-signetrescueend must be a height above the -signetrescue height %d and below %d, not '%s'.",
+                                               *options.rescue_height, std::numeric_limits<int>::max(), values[0]));
+        }
+        options.rescue_end_height = *height;
+    }
 }
 
