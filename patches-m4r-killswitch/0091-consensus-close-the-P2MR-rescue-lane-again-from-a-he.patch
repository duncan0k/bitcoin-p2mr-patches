             }
@@ -231,6 +231,23 @@ void ReadSigNetArgs(const ArgsManager& args, CChainParams::SigNetOptions& option
         }
         options.rescue_height = *height;
     }
+    // The kill switch of the rescue lane (doc/p2mr-rescue.md) closes it again from a height above the
+    // one it opens at.
+    if (!args.GetArgs("-signetrescueend").empty()) {
+        const auto values = args.GetArgs("-signetrescueend");
+        if (values.size() != 1) {
+            throw std::runtime_error("-signetrescueend cannot be multiple values.");
+        }
