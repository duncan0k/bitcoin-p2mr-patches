+        for (const char* arg : {"-signetpowtargetspacing", "-signetpqblock", "-signetmldsa44", "-signetslhdsa128s", "-signettripwire", "-signetrescue", "-signetrescueend"}) {
             if (!args.GetArgs(arg).empty()) {
