@@ -342,6 +370,9 @@ std::unique_ptr<const CChainParams> CreateChainParams(const ArgsManager& args, c
     if (chain != ChainType::SIGNET && args.IsArgSet("-signetrescue")) {
         throw std::runtime_error("-signetrescue can only be used with signet.");
     }
+    if (chain != ChainType::SIGNET && args.IsArgSet("-signetrescueend")) {
