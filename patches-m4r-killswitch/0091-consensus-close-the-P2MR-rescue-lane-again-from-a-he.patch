diff --git a/test/functional/feature_p2mr_rescue_killswitch.py b/test/functional/feature_p2mr_rescue_killswitch.py
new file mode 100755
index 0000000..bb19fa3
--- /dev/null
+++ b/test/functional/feature_p2mr_rescue_killswitch.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test the kill switch of the P2MR rescue lane (doc/p2mr-rescue.md, section 11), on regtest.
+
+Not part of the M4-R1 release: the prepared patch that closes the lane again from END
+(-testactivationheight=p2mr_rescue_end@END here), a soft fork. Heights: tripwire rules from 220 with
+a tripwire output that never existed (elliptic curve checks disabled from there), the lane from 230,
+END = 240.
+
+  node 0  the rules and the kill switch, where the chain is mined
+  node 1  the same, which builds a competing branch for a reorganization that ends at END - 1
+
+Covered: a rescue spend in the mempool when a block connects END - 1 is removed, and the template and
+the next block are fine; at tip END - 1 new rescue spends are refused, and a block at END with one is
+invalid; reorganizations across END in both directions, and one that ends exactly at END - 1; rescue
+spends confirmed before END stay valid (-reindex).
+"""
+
+import hashlib
+
+from test_framework.messages import COIN, COutPoint, CTransaction, CTxIn, CTxInWitness, CTxOut
+from test_framework.p2mr import p2mr_construct
+from test_framework.p2mr_rescue import (
+    P2MR_LEAF_TRIPWIRED,
+    RESCUE_STATEMENT_HMAC,
+    WALLET_V1_SCHNORR_K,
+    find_prover,
+    network_id_regtest,
+    prove,
+    rescue_annex,
+    rescue_key,
+    rescue_message,
+    rescue_pub,
+    rescue_sighash,
+    rescue_token,
+    rescue_y,
+)
+from test_framework.script import CScript, OP_CHECKSIG, OP_RETURN
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, assert_raises_rpc_error
+from test_framework.wallet import MiniWallet
+
+H3 = 220
+H4R = 230
+END = 240
+FUND_SATS = 1_000_000
+FEE_SATS = 60_000
+EC_DISABLED_ERROR = "Elliptic curve signature checks are disabled in this leaf"
+ARGS = [f"-signettripwire={H3}@{'11' * 32}:0", f"-testactivationheight=p2mr_rescue@{H4R}", f"-testactivationheight=p2mr_rescue_end@{END}"]
+
+
+class P2MRRescueKillSwitchTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 2
+        self.extra_args = [ARGS, ARGS]
+
+    def rescue_tx(self, utxo):
+        x = hashlib.sha256(b"feature_p2mr_rescue_killswitch").digest()
+        y = rescue_y(WALLET_V1_SCHNORR_K, x, 0)
+        tx = CTransaction()
+        tx.vin = [CTxIn(COutPoint(utxo["txid"], utxo["vout"]), b"", 0xfffffffd)]
+        tx.vout = [CTxOut(FUND_SATS - FEE_SATS, self.wallet.get_output_script())]
+        leaf = self.tree.leaves["rescue"]
+        pub = rescue_pub(WALLET_V1_SCHNORR_K, 0, y)
+        sighash = rescue_sighash(tx, 0, [CTxOut(FUND_SATS, self.tree.scriptPubKey)], leaf.script, network_id_regtest(), RESCUE_STATEMENT_HMAC, pub)
+        _, proof = prove(self.prover, WALLET_V1_SCHNORR_K, 0, x, rescue_message(sighash, network_id_regtest(), self.pubkey))
+        tx.wit.vtxinwit = [CTxInWitness()]
+        tx.wit.vtxinwit[0].scriptWitness.stack = [rescue_token(WALLET_V1_SCHNORR_K, 0, y), bytes(leaf.script), leaf.control_block, rescue_annex(proof)]
+        return tx
+
+    def mine_to(self, height):
+        node = self.nodes[0]
+        self.generate(node, height - node.getblockcount())
+        assert_equal(node.getblockcount(), height)
+
+    def empty_block(self):
+        return self.nodes[0].generateblock(self.wallet.get_address(), [], called_by_framework=True)["hash"]
+
+    def run_test(self):
+        node = self.nodes[0]
+        self.prover = find_prover(self.config)
+        self.wallet = MiniWallet(node)
+        self.wallet.rescan_utxos()
+        y = rescue_y(WALLET_V1_SCHNORR_K, hashlib.sha256(b"feature_p2mr_rescue_killswitch").digest(), 0)
+        self.pubkey = rescue_key(y)
+        self.tree = p2mr_construct([("rescue", CScript([self.pubkey, OP_CHECKSIG]), P2MR_LEAF_TRIPWIRED), ("fail", CScript([OP_RETURN]))])
+
+        utxo = self.wallet.get_utxo(confirmed_only=True)
+        fund = CTransaction()
+        fund.vin = [CTxIn(COutPoint(int(utxo["txid"], 16), utxo["vout"]))]
+        fund.vout = [CTxOut(FUND_SATS, self.tree.scriptPubKey) for _ in range(8)]
+        fund.vout.append(CTxOut(int(utxo["value"] * COIN) - 8 * FUND_SATS - 20_000, self.wallet.get_output_script()))
+        self.wallet.sign_tx(fund)
+        self.wallet.sendrawtransaction(from_node=node, tx_hex=fund.serialize().hex())
+        self.generate(node, 1)
+        outs = [{"txid": fund.txid_int, "vout": n} for n in range(8)]
+
+        self.log.info("Startup log, and the lane open between H4R and END")
+        assert node.debug_log_path.read_text().count(f"P2MR rescue lane closed again from height {END} (the kill switch)") == 1
+        self.mine_to(H4R + 1)
+        info = node.gettripwireinfo()["rescue"]
+        assert_equal((info["end_height"], info["active_next_block"], info["mempool_accepts"]), (END, True, True))
+        before = self.rescue_tx(outs[0])
+        node.sendrawtransaction(before.serialize().hex())
+        confirmed = self.generate(node, 1)[0]
+        assert before.txid_hex in node.getblock(confirmed)["tx"]
+
+        self.log.info("A rescue spend in the mempool when END - 1 connects goes, with its descendant; the next block is fine")
+        self.mine_to(END - 2)
+        pooled = self.rescue_tx(outs[1])
+        node.sendrawtransaction(pooled.serialize().hex())
+        self.wallet.rescan_utxos()
+        child = self.wallet.send_self_transfer(from_node=node, utxo_to_spend=self.wallet.get_utxo(txid=pooled.txid_hex))
+        assert {pooled.txid_hex, child["txid"]} <= set(node.getrawmempool())
+        self.empty_block()
+        self.sync_blocks()
+        assert_equal(node.getblockcount(), END - 1)
+        assert pooled.txid_hex not in node.getrawmempool() and child["txid"] not in node.getrawmempool()
+        info = node.gettripwireinfo()["rescue"]
+        assert_equal((info["active_next_block"], info["mempool_accepts"]), (False, False))
+        node.getblocktemplate({"rules": ["segwit"]})
+
+        self.log.info("Tip END - 1: a new rescue spend is refused; a block at END with one is invalid")
+        late = self.rescue_tx(outs[2])
+        assert_raises_rpc_error(-26, EC_DISABLED_ERROR, node.sendrawtransaction, late.serialize().hex())
+        assert_raises_rpc_error(-25, EC_DISABLED_ERROR, node.generateblock, self.wallet.get_address(), [late.serialize().hex()], called_by_framework=True)
+        self.generate(node, 3)
+
+        self.log.info("Reorganization back below END - 1: the mempool takes rescue spends again; forward over END - 1: they go")
+        tip = node.getbestblockhash()
+        at_end_minus_2 = node.getblockhash(END - 2)
+        node.invalidateblock(at_end_minus_2)
+        assert_equal(node.getblockcount(), END - 3)
+        again = self.rescue_tx(outs[3])
+        node.sendrawtransaction(again.serialize().hex())
+        assert again.txid_hex in node.getrawmempool()
+        node.reconsiderblock(at_end_minus_2)
+        assert_equal(node.getbestblockhash(), tip)
+        assert again.txid_hex not in node.getrawmempool()
+
+        self.log.info("A reorganization that ends exactly at END - 1 removes them too")
+        self.disconnect_nodes(0, 1)
+        node.invalidateblock(node.getblockhash(END - 1))
+        assert_equal(node.getblockcount(), END - 2)
+        pool = self.rescue_tx(outs[4])
+        node.sendrawtransaction(pool.serialize().hex())
+        assert pool.txid_hex in node.getrawmempool()
+        # Node 1 replaces the block at END - 2 and adds one: a branch that ends at END - 1 and leaves
+        # node 0's tip, at END - 2, out.
+        n1 = self.nodes[1]
+        n1.invalidateblock(n1.getblockhash(END - 2))
+        self.generate(n1, 2, sync_fun=self.no_op)
+        assert_equal(n1.getblockcount(), END - 1)
+        self.connect_nodes(0, 1)
+        self.wait_until(lambda: node.getbestblockhash() == n1.getbestblockhash())
+        assert_equal(node.getblockcount(), END - 1)
+        assert pool.txid_hex not in node.getrawmempool()
+
+        self.log.info("Rescue spends confirmed before END stay valid")
+        self.generate(node, 2)
+        assert before.txid_hex in node.getblock(confirmed)["tx"]
+        height = node.getblockcount()
+        self.restart_node(0, extra_args=ARGS + ["-reindex"])
+        self.wait_until(lambda: node.getblockcount() >= height)
+        assert node.getblock(confirmed)["confirmations"] > 0
+
+
+if __name__ == '__main__':
+    P2MRRescueKillSwitchTest(__file__).main()
