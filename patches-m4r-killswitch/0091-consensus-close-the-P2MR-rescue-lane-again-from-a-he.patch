             throw std::runtime_error(strprintf("The p2mr_rescue height must be at or above the p2mr_tripwire height %d, not %d.", tripwire_height, rescue->second));
         }
     }
+    // The kill switch (doc/p2mr-rescue.md) closes the lane above the height it opens at.
+    if (const auto end{options.activation_heights.find(Consensus::DEPLOYMENT_P2MR_RESCUE_END)}; end != options.activation_heights.end()) {
+        const auto rescue{options.activation_heights.find(Consensus::DEPLOYMENT_P2MR_RESCUE)};
+        const auto tripwire{options.activation_heights.find(Consensus::DEPLOYMENT_P2MR_TRIPWIRE)};
+        const int rescue_height{rescue != options.activation_heights.end() ? rescue->second :
+                                options.tripwire                       ? options.tripwire->height :
+                                tripwire != options.activation_heights.end() ? tripwire->second : 0};
+        if (end->second <= rescue_height) {
+            throw std::runtime_error(strprintf("The p2mr_rescue_end height must be above the p2mr_rescue height %d, not %d.", rescue_height, end->second));
+        }
+    }
 
     for (const std::string& strDeployment : args.GetArgs("-vbparams")) {
