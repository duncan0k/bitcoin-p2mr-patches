-/** Whether an input of the transaction executes a P2MR leaf (leaf version 0xc0, depth one or
- *  more) that has OP_CHECKMLDSA44 among its opcodes (doc/p2mr-mldsa44.md). */
-static bool SpendsP2MRMLDSA44Leaf(const CTransaction& tx, const CCoinsView& view)
+/** Whether an input of the transaction spends a P2MR output through a leaf at depth one or more
+ *  whose leaf version and script `match` accepts. */
+template <typename F>
+static bool SpendsP2MRLeaf(const CTransaction& tx, const CCoinsView& view, F match)
 {
     for (const CTxIn& txin : tx.vin) {
         std::span<const std::vector<unsigned char>> stack{txin.scriptWitness.stack};
         if (stack.size() >= 2 && !stack.back().empty() && stack.back()[0] == ANNEX_TAG) stack = stack.first(stack.size() - 1);
         if (stack.size() < 2) continue;
         const std::vector<unsigned char>& control{stack.back()};
-        if (control.size() <= P2MR_CONTROL_BASE_SIZE || (control[0] & TAPROOT_LEAF_MASK) != TAPROOT_LEAF_TAPSCRIPT) continue;
-        if (!HasMLDSA44Opcode(stack[stack.size() - 2])) continue;
+        if (control.size() <= P2MR_CONTROL_BASE_SIZE || !match(control[0] & TAPROOT_LEAF_MASK, stack[stack.size() - 2])) continue;
         const std::optional<Coin> coin{view.GetCoin(txin.prevout)};
         if (coin && coin->out.scriptPubKey.IsPayToMerkleRoot()) return true;
     }
     return false;
 }
 
+/** Whether an input of the transaction executes a P2MR leaf (leaf version 0xc0, or 0xe0, depth one
+ *  or more) that has OP_CHECKMLDSA44 among its opcodes (doc/p2mr-mldsa44.md). */
+static bool SpendsP2MRMLDSA44Leaf(const CTransaction& tx, const CCoinsView& view)
+{
+    return SpendsP2MRLeaf(tx, view, [](uint8_t leaf_version, std::span<const unsigned char> script) {
+        return (leaf_version == TAPROOT_LEAF_TAPSCRIPT || leaf_version == P2MR_LEAF_TRIPWIRED) && HasMLDSA44Opcode(script);
+    });
+}
+
+/** Whether an input of the transaction spends a P2MR output through a leaf of version 0xe0 at depth
+ *  one or more, which executes once the P2MR tripwire rules apply (doc/p2mr-tripwire.md). */
+static bool SpendsP2MRTripwiredLeaf(const CTransaction& tx, const CCoinsView& view)
+{
+    return SpendsP2MRLeaf(tx, view, [](uint8_t leaf_version, std::span<const unsigned char>) {
+        return leaf_version == P2MR_LEAF_TRIPWIRED;
+    });
+}
+
+/** The script verification flags the mempool checks a transaction with: the standard ones, as they
+ *  apply to the block after `tip`, whose UTXO set `coins` is. */
+static script_verify_flags MempoolScriptFlags(const CBlockIndex* tip, const CCoinsView& coins, const ChainstateManager& chainman)
+{
+    script_verify_flags flags{STANDARD_SCRIPT_VERIFY_FLAGS};
+    // Until OP_CHECKMLDSA44 is active for the next block, its byte stays the OP_SUCCESSx that
+    // DISCOURAGE_OP_SUCCESS keeps out of the mempool, whatever the signature
+    // (doc/p2mr-mldsa44.md): a P2MR leaf that is not yet protected is not relayed as if it were.
+    if (!DeploymentActiveAfter(tip, chainman, Consensus::DEPLOYMENT_P2MR_MLDSA44)) {
+        flags &= ~SCRIPT_VERIFY_P2MR_MLDSA44;
+    }
+    // Likewise, until leaf version 0xe0 executes in the next block, it stays the unknown leaf version
+    // that DISCOURAGE_UPGRADABLE_TAPROOT_VERSION keeps out of the mempool (doc/p2mr-tripwire.md).
+    if (!DeploymentActiveAfter(tip, chainman, Consensus::DEPLOYMENT_P2MR_TRIPWIRE)) {
+        flags &= ~SCRIPT_VERIFY_P2MR_TRIPWIRE;
+    }
+    // Elliptic curve checks in those leaves fail as they will in the next block. Whether a tripwire
+    // output is missing is read from the confirmed UTXO set: a spend of one that is only in the
+    // mempool changes nothing until a block confirms it.
+    if (P2MRECDisabledAfter(tip, coins, chainman)) {
+        flags |= SCRIPT_VERIFY_P2MR_EC_DISABLED;
+    }
+    return flags;
+}
+
+/**
+ * Whether a mempool transaction that spends a P2MR leaf of version 0xe0 fails the script checks
+ * under `flags`, the mempool's for the next block, once elliptic curve checks in such leaves fail
+ * there (doc/p2mr-tripwire.md). Its inputs are read through `view`, the confirmed UTXO set with the
+ * mempool on top, which the caller has made consistent with the chain. Every other transaction
+ * passes untouched.
+ */
+static bool TripwiredSpendFails(const CTransaction& tx, CCoinsViewMemPool& view, script_verify_flags flags, ValidationCache& validation_cache)
+    EXCLUSIVE_LOCKS_REQUIRED(::cs_main)
+{
+    AssertLockHeld(::cs_main);
+    if (!SpendsP2MRTripwiredLeaf(tx, view)) return false;
+    CCoinsViewCache inputs{&view};
+    // An input that cannot be read cannot be checked, and the next block could not include the
+    // transaction either.
+    if (!std::ranges::all_of(tx.vin, [&](const CTxIn& txin) { return inputs.HaveCoin(txin.prevout); })) return true;
+    PrecomputedTransactionData txdata;
+    TxValidationState state;
+    // As PolicyScriptChecks checks a transaction.
+    return !CheckInputScripts(tx, state, inputs, flags, /*cacheSigStore=*/true, /*cacheFullScriptStore=*/false, txdata, validation_cache);
+}
