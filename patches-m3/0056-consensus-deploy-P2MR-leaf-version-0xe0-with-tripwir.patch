+/**
+ * -signettripwire=<height>@<txid:vout>[,<txid:vout>...] (doc/p2mr-tripwire.md): the height from
+ * which P2MR leaves of leaf version 0xe0 execute, and the tripwire outputs. nullopt without it.
+ */
+static std::optional<CChainParams::TripwireOptions> ReadTripwireArg(const ArgsManager& args)
+{
+    const auto values{args.GetArgs("-signettripwire")};
+    if (values.empty()) return std::nullopt;
+    if (values.size() != 1) {
+        throw std::runtime_error("-signettripwire cannot be multiple values.");
+    }
+    const auto& value{values[0]};
+    const std::string malformed{strprintf("-signettripwire must be <height>@<txid:vout>[,<txid:vout>...], not '%s'.", value)};
+    const auto at{value.find('@')};
+    if (at == std::string::npos) throw std::runtime_error(malformed);
+    const auto height{ToIntegral<int32_t>(value.substr(0, at))};
+    if (!height) throw std::runtime_error(malformed);
+    if (*height < 1 || *height == std::numeric_limits<int>::max()) {
+        throw std::runtime_error(strprintf("-signettripwire height must be at least 1 and below %d, not %d.", std::numeric_limits<int>::max(), *height));
+    }
+    CChainParams::TripwireOptions tripwire{.height = *height, .outpoints = {}};
+    for (const std::string& item : SplitString(value.substr(at + 1), ',')) {
+        const auto colon{item.find(':')};
+        if (colon == std::string::npos) throw std::runtime_error(malformed);
+        const auto txid{Txid::FromHex(item.substr(0, colon))};
+        const auto vout{ToIntegral<uint32_t>(item.substr(colon + 1))};
+        if (!txid || !vout) throw std::runtime_error(malformed);
+        const COutPoint outpoint{*txid, *vout};
+        if (std::ranges::find(tripwire.outpoints, outpoint) != tripwire.outpoints.end()) {
+            throw std::runtime_error(strprintf("-signettripwire names %s more than once.", item));
+        }
+        tripwire.outpoints.push_back(outpoint);
+    }
+    return tripwire;
+}
