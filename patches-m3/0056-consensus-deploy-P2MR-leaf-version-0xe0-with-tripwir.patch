+//! The tripwire outputs of the Ark-0 signet (doc/p2mr-tripwire.md), each with the x-only key its
+//! leaf checks and a label: one whose leaf checks the BIP-341 NUMS point, XOnlyPubKey::NUMS_H,
+//! labelled "BIP-341 NUMS", which no one can spend, and the drill output, labelled "drill", whose
+//! key the operator holds. Not set yet, like ARK0_TRIPWIRE_HEIGHT: the commit that sets that height
+//! adds both outputs, which are created below it.
+static const std::vector<Consensus::P2MRTripwire> ARK0_TRIPWIRE_OUTPOINTS{};
+
 bool IsArk0SignetChallenge(std::span<const uint8_t> challenge)
 {
     return std::ranges::equal(challenge, ARK0_SIGNET_CHALLENGE);
 }
 
+//! The P2MR tripwire rules as a node logs them at startup, so that the nodes of one network can
+//! compare them (doc/p2mr-tripwire.md): the height, and each tripwire outpoint, with the label of
+//! one the code fixes and the SHA256 of its key unless the key is the BIP-341 NUMS point.
+static std::string DescribeTripwireRules(const Consensus::Params& consensus)
+{
+    std::vector<std::string> outputs;
+    for (const auto& tripwire : consensus.p2mr_tripwires) {
+        std::string output{strprintf("%s:%u", tripwire.outpoint.hash.ToString(), tripwire.outpoint.n)};
+        if (!tripwire.label.empty() && std::ranges::equal(tripwire.key, XOnlyPubKey::NUMS_H)) {
+            output += strprintf(" (%s)", tripwire.label);
+        } else if (!tripwire.label.empty()) {
+            std::array<unsigned char, CSHA256::OUTPUT_SIZE> key_hash;
+            CSHA256().Write(tripwire.key.data(), tripwire.key.size()).Finalize(key_hash.data());
+            output += strprintf(" (%s key SHA256 %s)", tripwire.label, HexStr(key_hash));
+        }
+        outputs.push_back(std::move(output));
+    }
+    return strprintf("P2MR tripwire rules from height %d in leaf version 0x%02x; %s", consensus.P2MRTripwireHeight, P2MR_LEAF_TRIPWIRED,
+                     outputs.empty() ? "no tripwire outputs" : "tripwire outputs " + util::Join(outputs, " and "));
+}
