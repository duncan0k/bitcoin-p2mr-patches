+    if (!args.GetArgs("-signetmldsa44").empty()) {
+        const auto values = args.GetArgs("-signetmldsa44");
+        if (values.size() != 1) {
+            throw std::runtime_error("-signetmldsa44 cannot be multiple values.");
+        }
+        if (!options.challenge) {
+            throw std::runtime_error("-signetmldsa44 requires -signetchallenge.");
+        }
+        if (IsArk0SignetChallenge(*options.challenge)) {
+            throw std::runtime_error("-signetmldsa44 cannot be used on the Ark-0 signet, whose rules are fixed in the code.");
+        }
+        const auto height{ToIntegral<int32_t>(values[0])};
+        if (!height) {
+            throw std::runtime_error(strprintf("-signetmldsa44 must be a height, not '%s'.", values[0]));
+        }
+        if (*height < 1 || *height == std::numeric_limits<int>::max()) {
+            throw std::runtime_error(strprintf("-signetmldsa44 height must be at least 1 and below %d, not %d.", std::numeric_limits<int>::max(), *height));
+        }
+        options.mldsa44_height = *height;
+    }
+    if (auto tripwire{ReadTripwireArg(args)}) {
+        if (!options.challenge) {
+            throw std::runtime_error("-signettripwire requires -signetchallenge.");
+        }
+        if (IsArk0SignetChallenge(*options.challenge)) {
+            throw std::runtime_error("-signettripwire cannot be used on the Ark-0 signet, whose rules are fixed in the code.");
+        }
+        // The ML-DSA-44 leaves of leaf version 0xe0 are what is left once their elliptic curve
+        // checks fail, so OP_CHECKMLDSA44 has to be active before the leaves execute.
+        if (!options.mldsa44_height) {
+            throw std::runtime_error("-signettripwire requires -signetmldsa44.");
+        }
+        if (*options.mldsa44_height >= tripwire->height) {
+            throw std::runtime_error(strprintf("-signettripwire height must be above the -signetmldsa44 height %d, not %d.", *options.mldsa44_height, tripwire->height));
+        }
+        options.tripwire = std::move(*tripwire);
+    }
 }
 
