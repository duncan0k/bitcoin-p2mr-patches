+
+def format_rows(rows):
+    """Render rows in the multi line style of script_tests.json, under their own header row."""
+    return p2mr_rows.format_rows(rows).replace(
+        '["P2MR (BIP-360) tests, and the taproot rows that calibrate them"],', BLOCK_HEADER, 1)
+
+
+def splice(path, text):
+    """Put the block just above the first of ANCHORS that the file has, replacing an earlier one."""
+    with open(path, encoding="utf-8") as f:
+        content = f.read()
+    start = content.find("\n" + BLOCK_HEADER)
+    if start != -1:
+        ends = [i for i in (content.find(a, start + 1) for a in ANCHORS) if i != -1]
+        content = content[:start] + content[min(ends):]
+    anchor = next(i for i in (content.find(a) for a in ANCHORS) if i != -1)
+    head = content[:anchor].rstrip("\n")
+    with open(path, "w", encoding="utf-8", newline="\n") as f:
+        f.write(head + "\n\n" + text + "\n" + content[anchor:])
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--inplace", action="store_true", help="rewrite the leaf version 0xe0 block of script_tests.json")
+    args = parser.parse_args()
+
+    assert AMOUNT_SAT == 1 and AMOUNT_BTC == 0.00000001
+    rows = build_rows()
+    text = format_rows(rows)
+    if args.inplace:
+        path = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "src", "test", "data",
+                                             "script_tests.json"))
+        splice(path, text)
+        print(f"wrote {len(rows)} leaf version 0xe0 rows to {path}", file=sys.stderr)
+    else:
+        print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
