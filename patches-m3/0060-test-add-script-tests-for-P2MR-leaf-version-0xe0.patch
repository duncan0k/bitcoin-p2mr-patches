@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Helpers for P2MR leaf version 0xe0 and its tripwire outputs (doc/p2mr-tripwire.md).
+
+From the height of the P2MR tripwire rules, a P2MR leaf of leaf version 0xe0 at depth one
+or more executes as one of leaf version 0xc0 does. Once a tripwire output is missing from
+the UTXO set a block builds on, a signature check with a 32-byte key and a non-empty
+signature in such a leaf fails the script, from that block on.
+
+    tripwire output:  <key> OP_CHECKSIG and OP_RETURN, both leaf version 0xc0 at depth one
+    template S3:      <x-only key> OP_CHECKSIG and S1, both leaf version 0xe0 at depth one
+
+The control block of a leaf of version 0xe0 starts with 0xe1.
+"""
+
+from .key import sign_schnorr
+from .p2mr import p2mr_construct
+from .p2mr_mldsa44 import (
+    NO_CODESEPARATOR,
+    mldsa44_leaf,
+    mldsa44_sig_chunks,
+    mldsa44_sign_input,
+)
+from .script import (
+    CScript,
+    OP_CHECKSIG,
+    OP_RETURN,
+    SIGHASH_DEFAULT,
+    TaprootSignatureHash,
+)
+
+# The leaf version of the rules.
+LEAF_VERSION_TRIPWIRED = 0xe0
+# BIP-341's NUMS point H, an x-only key nobody can sign for (XOnlyPubKey::NUMS_H).
+NUMS_H = bytes.fromhex("50929b74c1a04954b78b4b6035e97a5e078a5a0f28ec96d547bfee9ace803ac0")
+# The script error of an elliptic curve check in such a leaf once a tripwire output is missing.
+EC_DISABLED_ERROR = "Elliptic curve signature checks are disabled in this leaf"
+
+
+def tripwire_tree(xonly):
+    """A tripwire output: <xonly> OP_CHECKSIG and OP_RETURN, both leaf version 0xc0 at depth one."""
+    assert len(xonly) == 32
+    return p2mr_construct([("csig", CScript([xonly, OP_CHECKSIG])), ("fail", CScript([OP_RETURN]))])
+
+
+def hybrid_tree(xonly, pq_pubkey):
+    """Template S3: <xonly> OP_CHECKSIG and the ML-DSA-44 leaf S1, both leaf version 0xe0 at depth one."""
+    assert len(xonly) == 32
+    return p2mr_construct([("ec", CScript([xonly, OP_CHECKSIG]), LEAF_VERSION_TRIPWIRED),
+                           ("pq", mldsa44_leaf(pq_pubkey), LEAF_VERSION_TRIPWIRED)])
+
+
+def schnorr_leaf_witness(seckey, leaf, tx, spent_utxos, input_index, *, hash_type=SIGHASH_DEFAULT, annex=None,
+                         leaf_ver=None):
+    """The witness that spends a leaf <xonly> OP_CHECKSIG: the signature, the script, the control block,
+    and the annex if there is one. leaf_ver signs as if the leaf had another version."""
+    msg = TaprootSignatureHash(tx, spent_utxos, hash_type, input_index, scriptpath=True, leaf_script=leaf.script,
+                               leaf_ver=leaf.leaf_ver if leaf_ver is None else leaf_ver, annex=annex,
+                               codeseparator_pos=NO_CODESEPARATOR)
+    sig = sign_schnorr(seckey, msg)
+    if hash_type != SIGHASH_DEFAULT:
+        sig += bytes([hash_type])
+    return [sig, bytes(leaf.script), leaf.control_block] + ([annex] if annex is not None else [])
+
+
+def mldsa44_leaf_witness(seckey, leaf, tx, spent_utxos, input_index, *, hash_type=SIGHASH_DEFAULT):
+    """The witness that spends an ML-DSA-44 leaf S1: five signature chunks, the script, the control block."""
+    sig = mldsa44_sign_input(seckey, tx, spent_utxos, input_index, leaf.script, hash_type=hash_type,
+                             leaf_ver=leaf.leaf_ver)
+    return mldsa44_sig_chunks(sig) + [bytes(leaf.script), leaf.control_block]
