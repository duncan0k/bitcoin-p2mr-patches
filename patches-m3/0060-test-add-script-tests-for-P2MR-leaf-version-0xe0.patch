@@ -0,0 +1,380 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Generate the script_tests.json rows of P2MR leaf version 0xe0 (doc/p2mr-tripwire.md).
+
+The rows have the format generate_p2mr_script_tests.py describes. Their block goes
+just above the OP_CHECKMLDSA44 rows signed by p2mr-ts (or, without them, above the
+OP_CHECKMLDSA44 block), where neither of the other two generators rewrites it.
+
+The Schnorr, ECDSA and ML-DSA-44 signatures are real and deterministic, made over the
+transactions script_json_test builds for each row. The rows cover each combination of
+P2MR_TRIPWIRE (the leaf version executes) and P2MR_EC_DISABLED (its elliptic curve
+checks fail), and show that the second leaves every other kind of script alone.
+
+Usage, from the repository root:
+
+    ./test/util/generate_p2mr_tripwire_script_tests.py            # print the rows
+    ./test/util/generate_p2mr_tripwire_script_tests.py --inplace  # write them
+
+script_json_test re-runs every row with random flags removed (passing rows) or added
+(failing rows) and requires the outcome to stay. So a passing row that executes a leaf
+of version 0xe0 never lists DISCOURAGE_UPGRADABLE_TAPROOT_VERSION, and a row that fails
+only because P2MR_TRIPWIRE is absent carries a witness that fails once the leaf executes.
+"""
+
+import argparse
+import hashlib
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "functional"))
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import generate_p2mr_script_tests as p2mr_rows  # noqa: E402
+from generate_p2mr_script_tests import (  # noqa: E402
+    AMOUNT_BTC,
+    AMOUNT_SAT,
+    LEAF_VERSION_FUTURE,
+    NO_CODESEPARATOR,
+    OP_SUCCESS187,
+    PUB_A,
+    SEC_A,
+    SEC_B,
+    raw_row,
+    row,
+    sign,
+    spending_tx,
+)
+from test_framework.key import ECKey, sign_schnorr, tweak_add_privkey  # noqa: E402
+from test_framework.p2mr import p2mr_construct  # noqa: E402
+from test_framework.p2mr_mldsa44 import (  # noqa: E402
+    mldsa44_keygen,
+    mldsa44_leaf,
+    mldsa44_sig_chunks,
+    mldsa44_sighash,
+    mldsa44_sign,
+)
+from test_framework.p2mr_tripwire import LEAF_VERSION_TRIPWIRED, hybrid_tree  # noqa: E402
+from test_framework.script import (  # noqa: E402
+    CScript,
+    CScriptOp,
+    LEAF_VERSION_TAPSCRIPT,
+    LegacySignatureHash,
+    OP_0,
+    OP_1,
+    OP_2,
+    OP_CHECKSIG,
+    OP_CHECKSIGADD,
+    OP_CHECKSIGVERIFY,
+    OP_DROP,
+    OP_DUP,
+    OP_EQUAL,
+    OP_EQUALVERIFY,
+    OP_HASH160,
+    OP_NOT,
+    OP_RETURN,
+    SIGHASH_ALL,
+    SIGHASH_DEFAULT,
+    SegwitV0SignatureHash,
+    TaprootSignatureHash,
+    hash160,
+    taproot_construct,
+)
+
+BLOCK_HEADER = '["P2MR leaf version 0xe0 tests (doc/p2mr-tripwire.md)"],'
+# The blocks this one goes above, the nearest first.
+ANCHORS = ('\n["P2MR OP_CHECKMLDSA44 rows signed by p2mr-ts',
+           '\n["P2MR OP_CHECKMLDSA44 tests',
+           '\n["P2MR (BIP-360) tests',
+           '\n["The End"]')
+
+FLAGS_BASE = "P2SH,WITNESS,TAPROOT,P2MR,P2MR_MLDSA44"
+FLAGS_EC_ONLY = FLAGS_BASE + ",P2MR_EC_DISABLED"
+FLAGS_TW = FLAGS_BASE + ",P2MR_TRIPWIRE"
+FLAGS_EC = FLAGS_TW + ",P2MR_EC_DISABLED"
+
+PQ_PUB, PQ_SEC = mldsa44_keygen(hashlib.sha256(b"p2mr tripwire script_tests key").digest())
+
+E0 = LEAF_VERSION_TRIPWIRED
+LEAF_CSIG = CScript([PUB_A, OP_CHECKSIG])
+LEAF_FAIL = CScript([OP_RETURN])
+# Signatures that only have the right size: what a check does with them depends on the flags.
+JUNK_SIG = b"\x01" * 64
+# A 33-byte key, an upgradable public key type of BIP 342.
+KEY_33 = b"\x02" + b"\x03" * 32
+
+
+def tree(leaf, leaf_ver=E0):
+    """The leaf at depth one, next to a leaf that can only fail."""
+    return p2mr_construct([("x", leaf, leaf_ver), ("fail", LEAF_FAIL)])
+
+
+def leaf_row(stack, leaf, flags, error, comment, *, leaf_ver=E0, extra=()):
+    """A row spending `leaf` of the tree tree(leaf, leaf_ver) with `stack` below the leaf."""
+    t = tree(leaf, leaf_ver)
+    return row(list(stack) + [bytes(leaf), t.leaves["x"].control_block] + list(extra), t.scriptPubKey, flags, error,
+               f"P2MR_TRIPWIRE: {comment}")
+
+
+def schnorr(leaf, *, leaf_ver=E0, sign_ver=None, sec=SEC_A, hash_type=SIGHASH_DEFAULT, annex=None):
+    """A BIP 340 signature for spending `leaf` of tree(leaf, leaf_ver), over the message of the leaf
+    at version sign_ver (by default its own)."""
+    t = tree(leaf, leaf_ver)
+    return sign(t.scriptPubKey, [], leaf, sec, hash_type=hash_type, annex=annex,
+                leaf_ver=leaf_ver if sign_ver is None else sign_ver)
+
+
+def pq_chunks(leaf, *, leaf_ver=E0, sign_ver=None):
+    """The ML-DSA-44 signature chunks for spending `leaf` (S1 or S2) of tree(leaf, leaf_ver)."""
+    t = tree(leaf, leaf_ver)
+    spend, spent = spending_tx(t.scriptPubKey, [])
+    msg = mldsa44_sighash(spend, spent, 0, leaf, leaf_ver=leaf_ver if sign_ver is None else sign_ver)
+    return mldsa44_sig_chunks(mldsa44_sign(PQ_SEC, msg))
+
+
+def witness_size(stack):
+    """GetSerializeSize of a witness stack."""
+    def compact(n):
+        return 1 if n < 253 else 3 if n <= 0xffff else 5
+    return compact(len(stack)) + sum(compact(len(e)) + len(e) for e in stack)
+
+
+def budget_rows():
+    """A leaf whose 33-byte key checks use up the budget just before its 32-byte key check, and the
+    same leaf with 50 more bytes of witness: validation weight is charged before the check fails.
+
+    The budget is the witness size plus 50, and each check with a signature takes 50. The leaf
+    starts with a padding push that is dropped, whose length tunes the witness size, then checks
+    one signature against a 33-byte key k times, then against PUB_A.
+    """
+    def leaf(pad, k):
+        return CScript([bytes(pad), OP_DROP] + [OP_DUP, KEY_33, OP_CHECKSIGVERIFY] * k + [PUB_A, OP_CHECKSIG])
+
+    def left_before_last(script, k):
+        return witness_size([JUNK_SIG, bytes(script), bytes(33)]) + 50 - 50 * k
+
+    pad, k = next((pad, k) for k in range(2, 30) for pad in range(1, 76) if left_before_last(leaf(pad, k), k) == 0)
+    short, roomy = leaf(pad, k), leaf(pad + 50, k)
+    assert left_before_last(short, k) == 0 and 50 <= left_before_last(roomy, k) < 100
+    return [
+        leaf_row([JUNK_SIG], short, FLAGS_EC, "TAPSCRIPT_VALIDATION_WEIGHT",
+                 f"{k} checks with a 33-byte key use up the budget: the 32-byte key check fails on weight first"),
+        leaf_row([JUNK_SIG], roomy, FLAGS_EC, "P2MR_EC_DISABLED",
+                 f"the same {k} checks with 50 more bytes of budget: the 32-byte key check fails as disabled"),
+    ]
+
+
+def build_rows():
+    rows = []
+
+    # --- Without P2MR_TRIPWIRE a leaf of version 0xe0 at depth one is not executed ---
+    for flags, note in ((FLAGS_BASE, ""), (FLAGS_EC_ONLY, ", P2MR_EC_DISABLED alone changes nothing")):
+        rows.append(leaf_row([JUNK_SIG], LEAF_CSIG, flags, "OK",
+                             f"without the flag a leaf of version 0xe0 is not executed: an invalid signature passes{note}"))
+        rows.append(leaf_row([JUNK_SIG], LEAF_CSIG, flags + ",DISCOURAGE_UPGRADABLE_TAPROOT_VERSION",
+                             "DISCOURAGE_UPGRADABLE_TAPROOT_VERSION",
+                             f"without the flag leaf version 0xe0 is an upgradable one{note}"))
+
+    # --- With P2MR_TRIPWIRE, and with or without P2MR_EC_DISABLED ---
+    leaf_not = CScript([PUB_A, OP_CHECKSIG, OP_NOT])
+    leaf_verify = CScript([PUB_A, OP_CHECKSIGVERIFY, OP_1])
+    leaf_add0 = CScript([OP_0, PUB_A, OP_CHECKSIGADD, OP_1, OP_EQUAL])
+    leaf_add0_empty = CScript([OP_0, PUB_A, OP_CHECKSIGADD, OP_0, OP_EQUAL])
+    leaf_add1 = CScript([OP_1, PUB_A, OP_CHECKSIGADD, OP_2, OP_EQUAL])
+    leaf_add_overflow = CScript([b"\x01\x00\x00\x00\x00", PUB_A, OP_CHECKSIGADD])
+    leaf_empty_key = CScript([OP_0, OP_CHECKSIG])
+    leaf_key33 = CScript([KEY_33, OP_CHECKSIG])
+    valid = schnorr(LEAF_CSIG)
+    wrong = schnorr(LEAF_CSIG, sec=SEC_B)
+    for flags, ec in ((FLAGS_TW, False), (FLAGS_EC, True)):
+        tag = "with P2MR_EC_DISABLED, " if ec else ""
+        disabled = "P2MR_EC_DISABLED"
+
+        def expect(error):
+            return disabled if ec else error
+
+        rows.append(leaf_row([valid], LEAF_CSIG, flags, expect("OK"), f"{tag}a valid signature, SIGHASH_DEFAULT"))
+        rows.append(leaf_row([schnorr(LEAF_CSIG, hash_type=SIGHASH_ALL)], LEAF_CSIG, flags, expect("OK"),
+                             f"{tag}a valid signature, SIGHASH_ALL"))
+        rows.append(leaf_row([wrong], LEAF_CSIG, flags, expect("SCHNORR_SIG"), f"{tag}a signature by another key"))
+        rows.append(leaf_row([valid[:63]], LEAF_CSIG, flags, expect("SCHNORR_SIG_SIZE"), f"{tag}a 63-byte signature"))
+        rows.append(leaf_row([valid + b"\x00"], LEAF_CSIG, flags, expect("SCHNORR_SIG_HASHTYPE"),
+                             f"{tag}an explicit SIGHASH_DEFAULT byte"))
+        rows.append(leaf_row([valid + b"\x04"], LEAF_CSIG, flags, expect("SCHNORR_SIG_HASHTYPE"), f"{tag}hash type 0x04"))
+        rows.append(leaf_row([valid + b"\x01" * 456], LEAF_CSIG, flags, expect("SCHNORR_SIG_SIZE"), f"{tag}a 520-byte signature"))
+        rows.append(leaf_row([valid + b"\x01" * 457], LEAF_CSIG, flags, "PUSH_SIZE",
+                             f"{tag}a 521-byte signature fails before the script runs"))
+        # A check whose outcome OP_NOT would turn around: once disabled, the script fails outright.
+        rows.append(leaf_row([schnorr(leaf_not)], leaf_not, flags, expect("EVAL_FALSE"),
+                             f"{tag}OP_NOT after a check with a valid signature"))
+        rows.append(leaf_row([schnorr(leaf_not, sec=SEC_B)], leaf_not, flags, expect("SCHNORR_SIG"),
+                             f"{tag}OP_NOT after a check with an invalid signature"))
