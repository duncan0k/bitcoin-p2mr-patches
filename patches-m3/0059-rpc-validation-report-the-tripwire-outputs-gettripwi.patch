+std::string DescribeP2MRTripwireState(const CBlockIndex* pindex, const CCoinsView& view, const ChainstateManager& chainman)
+{
+    const Consensus::Params& params{chainman.GetConsensus()};
+    std::vector<std::string> outputs;
+    for (const Consensus::P2MRTripwire& tripwire : params.p2mr_tripwires) {
+        outputs.push_back(strprintf("%s:%u %s", tripwire.outpoint.hash.ToString(), tripwire.outpoint.n,
+                                    IsP2MRTripwirePresent(view, tripwire.outpoint, params) ? "unspent" : "missing"));
+    }
+    return strprintf("tripwire outputs %s; elliptic curve checks in leaf version 0x%02x are %s for the next block",
+                     util::Join(outputs, ", "), P2MR_LEAF_TRIPWIRED, P2MRECDisabledAfter(pindex, view, chainman) ? "disabled" : "enabled");
+}
+
 
 /** Apply the effects of this block (with given index) on the UTXO set represented by coins.
  *  Validity checks that depend on the UTXO set are also done; ConnectBlock()
@@ -3308,6 +3320,30 @@ bool Chainstate::ConnectTip(
         });
     }
 
+    // The tripwire outputs this block spends, now that they are spent in the active chain, and the
+    // state of all of them when the block reaches the activation height (doc/p2mr-tripwire.md).
+    // Nowhere else: ConnectBlock also checks proposals, candidates that turn out invalid and blocks
+    // VerifyDB connects again, and the background chainstate of an assumeutxo snapshot connects
+    // blocks the active chain already has.
+    const Consensus::Params& consensus{m_chainman.GetConsensus()};
+    if (this == &m_chainman.ActiveChainstate() && !consensus.p2mr_tripwires.empty() &&
+        DeploymentEnabled(m_chainman, Consensus::DEPLOYMENT_P2MR_TRIPWIRE)) {
+        for (const CTransactionRef& tx : block_to_connect->vtx) {
+            for (const CTxIn& txin : tx->vin) {
+                if (std::ranges::none_of(consensus.p2mr_tripwires, [&](const Consensus::P2MRTripwire& tripwire) { return tripwire.outpoint == txin.prevout; })) continue;
+                LogInfo("P2MR tripwire %s:%u spent by %s in block %s (height %d): elliptic curve checks in leaf version 0x%02x are %s",
+                        txin.prevout.hash.ToString(), txin.prevout.n, tx->GetHash().ToString(), pindexNew->GetBlockHash().ToString(),
+                        pindexNew->nHeight, P2MR_LEAF_TRIPWIRED,
+                        ec_disabled_before ? std::string{"already disabled"} :
+                                             strprintf("disabled from height %d", std::max(consensus.P2MRTripwireHeight, pindexNew->nHeight + 1)));
+            }
+        }
+        if (pindexNew->nHeight == consensus.P2MRTripwireHeight) {
+            LogInfo("P2MR tripwire rules active from height %d, reached by block %s: %s", pindexNew->nHeight,
+                    pindexNew->GetBlockHash().ToString(), DescribeP2MRTripwireState(pindexNew, CoinsTip(), m_chainman));
+        }
+    }
+
     const auto time_6{SteadyClock::now()};
     m_chainman.time_post_connect += time_6 - time_5;
     m_chainman.time_total += time_6 - time_1;
