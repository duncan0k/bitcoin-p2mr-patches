+static RPCHelpMan gettripwireinfo()
+{
+    return RPCHelpMan{
+        "gettripwireinfo",
+        "Returns the state of the experimental P2MR tripwire rules (doc/p2mr-tripwire.md) at the active chain tip.\n"
+        "From their height on, elliptic curve signature checks in P2MR leaves of leaf version 0xe0 fail in every block "
+        "whose parent leaves a tripwire output missing.\n",
+        {},
+        RPCResult{
+            RPCResult::Type::OBJ, "", "",
+            {
+                {RPCResult::Type::STR_HEX, "tip_hash", "the hash of the active chain tip the state is read at"},
+                {RPCResult::Type::NUM, "tip_height", "the height of that tip"},
+                {RPCResult::Type::NUM, "height", "the height from which the rules apply"},
+                {RPCResult::Type::STR_HEX, "leaf_version", "the leaf version the rules apply to"},
+                {RPCResult::Type::ARR, "tripwires", "the tripwire outputs", {
+                    {RPCResult::Type::OBJ, "", "", {
+                        {RPCResult::Type::STR, "outpoint", "the output, as txid:vout"},
+                        {RPCResult::Type::STR, "state", "\"unspent\" while it is an unspent output created below the height of the rules; "
+                                                        "\"missing\" otherwise: spent, never created, or created at or above that height, which the UTXO set does not tell apart"},
+                        {RPCResult::Type::STR_HEX, "key", /*optional=*/true, "the x-only key the output's leaf checks (only for the outputs the code fixes, on the Ark-0 signet)"},
+                        {RPCResult::Type::STR, "label", /*optional=*/true, "what the output is for (only for the outputs the code fixes, on the Ark-0 signet)"},
+                    }},
+                }},
+                {RPCResult::Type::BOOL, "ec_disabled_next_block", "whether elliptic curve signature checks in those leaves fail in the next block"},
+            }},
+        RPCExamples{
+            HelpExampleCli("gettripwireinfo", "")
+            + HelpExampleRpc("gettripwireinfo", "")
+        },
+        [&](const RPCHelpMan& self, const JSONRPCRequest& request) -> UniValue
+{
+    ChainstateManager& chainman = EnsureAnyChainman(request.context);
+    if (!DeploymentEnabled(chainman, Consensus::DEPLOYMENT_P2MR_TRIPWIRE)) {
+        throw JSONRPCError(RPC_MISC_ERROR, "The P2MR tripwire rules are not enabled on this network");
+    }
+    const Consensus::Params& consensus{chainman.GetConsensus()};
+    // One snapshot: the tip, the outputs and the state for the next block are read under one lock.
+    LOCK(cs_main);
+    Chainstate& active_chainstate{chainman.ActiveChainstate()};
+    const CBlockIndex& tip{*CHECK_NONFATAL(active_chainstate.m_chain.Tip())};
+    const CCoinsViewCache& coins{active_chainstate.CoinsTip()};
+
+    UniValue tripwires(UniValue::VARR);
+    for (const Consensus::P2MRTripwire& tripwire : consensus.p2mr_tripwires) {
+        UniValue entry(UniValue::VOBJ);
+        entry.pushKV("outpoint", strprintf("%s:%u", tripwire.outpoint.hash.ToString(), tripwire.outpoint.n));
+        entry.pushKV("state", IsP2MRTripwirePresent(coins, tripwire.outpoint, consensus) ? "unspent" : "missing");
+        // An outpoint does not tell which key its output's leaf checks: only the outputs the code
+        // fixes come with one.
+        if (!tripwire.key.empty()) entry.pushKV("key", HexStr(tripwire.key));
+        if (!tripwire.label.empty()) entry.pushKV("label", tripwire.label);
+        tripwires.push_back(std::move(entry));
+    }
+
+    UniValue result(UniValue::VOBJ);
+    result.pushKV("tip_hash", tip.GetBlockHash().GetHex());
+    result.pushKV("tip_height", tip.nHeight);
+    result.pushKV("height", consensus.P2MRTripwireHeight);
+    result.pushKV("leaf_version", strprintf("%02x", P2MR_LEAF_TRIPWIRED));
+    result.pushKV("tripwires", std::move(tripwires));
+    result.pushKV("ec_disabled_next_block", P2MRECDisabledAfter(&tip, coins, chainman));
+    return result;
+},
+    };
+}
