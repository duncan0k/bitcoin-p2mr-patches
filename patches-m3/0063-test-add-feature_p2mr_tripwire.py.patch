+        self.log.info("A block below H3 takes a 0xe0 spend with an invalid signature, which is not executed there")
+        invalid = self.spend([(o["boundary_invalid"], ec_witness(corrupt=True))])
+        below = self.build_block([invalid, lone])
+        self.submit(below)
+        self.sync_main()
+
+        self.log.info("Tip H3-1: the mempool executes them")
+        self.assert_next(active=True, disabled=False)
+        self.accept(ec)
+        self.accept(pq)
+        self.reject(other, NONSTANDARD)
+        self.accept(other, node=1)
