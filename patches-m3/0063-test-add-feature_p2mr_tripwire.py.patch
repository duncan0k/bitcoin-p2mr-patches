+    def test_reorg_onto_same_transactions(self):
+        self.log.info("Reorg whose first block repeats the transactions of the block it replaces, and whose second spends B")
+        n0 = self.nodes[0]
+        self.disconnect_main()
+        before = self.mempool()
+        fork = n0.getbestblockhash()
+        # Block A confirms a parent, whose child waits in the mempool behind a relative lock of one
+        # block, with lock points that refer to A; next to it, a Schnorr spend of a 0xe0 leaf.
+        funds, funds_witness = self.wallet_input()
+        parent = self.spend([(funds, funds_witness)])
+        block_a = self.build_block([parent])
+        self.submit(block_a)
+        child = self.spend([(output(parent), self.wallet_witness)])
+        child.vin[0].nSequence = 1
+        schnorr = self.spend([(self.outs["same_ec"], ec_witness())])
+        for tx in (child, schnorr):
+            self.accept(tx)
+
+        # B1 has the transactions of A, coinbase included, at another time: once it is connected,
+        # nothing of A is left to put back in the mempool, while the child's lock points still refer
+        # to A. B2 spends B, so the reorganization ends with the checks disabled. Version 4 keeps the
+        # spend of B out of the mempool when B2 is disconnected again.
+        block_b1 = self.build_block([parent], prev=fork, nudge=1)
+        assert_equal([tx.txid_hex for tx in block_b1.vtx], [tx.txid_hex for tx in block_a.vtx])
+        self.submit(block_b1, "inconclusive")
+        trigger = self.spend([(self.tw["B"], ec_witness(TREE_B, "csig", key=SEC_B))], version=4)
+        block_b2 = self.build_block([trigger], prev=block_b1.hash_hex)
+        self.submit(block_b2)
+        assert_equal(n0.getbestblockhash(), block_b2.hash_hex)
+        self.assert_state(["unspent", "missing", "unspent"], True)
+        assert_equal(self.mempool(), before | {child.txid_hex})
+
+        n0.invalidateblock(block_b1.hash_hex)
+        assert_equal(n0.getbestblockhash(), block_a.hash_hex)
+        self.assert_state(["unspent"] * 3, False)
+        assert schnorr.txid_hex not in self.mempool()
+        self.connect_main()
