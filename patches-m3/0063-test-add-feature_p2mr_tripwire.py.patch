+
+        self.log.info("A reorg that brings back B alone leaves the checks disabled")
+        self.disconnect_main()
+        n0.invalidateblock(y_hash)
+        self.assert_state(["missing", "unspent", "unspent"], True)
+        n0.reconsiderblock(y_hash)
+        self.assert_state(["missing", "missing", "unspent"], True)
+
+        self.log.info("A reorg that takes away the block creating the tripwires; they confirm again at H3, and stay missing")
+        n0.invalidateblock(self.c_hash)
+        assert_equal(n0.getblockcount(), self.c_height - 1)
+        self.assert_state(["missing"] * 3, False)
+        while n0.getblockcount() < H3 - 1:
+            self.generateblock(n0, output="raw(51)", transactions=[], sync_fun=self.no_op)
+        self.assert_state(["missing"] * 3, True)
+        self.generateblock(n0, output="raw(51)", transactions=[self.tripwire_tx.serialize().hex()], sync_fun=self.no_op)
+        assert_equal(n0.getblockcount(), H3)
+        assert_equal(n0.gettxout(f"{self.tw['A']['txid']:064x}", self.tw["A"]["vout"])["confirmations"], 1)
+        self.assert_state(["missing"] * 3, True)
+        n0.reconsiderblock(self.c_hash)
+        assert_equal(n0.getbestblockhash(), tip)
+        self.assert_state(["missing", "missing", "unspent"], True)
+        self.connect_main()
+        self.mine()
+
+    def test_nums(self):
+        self.log.info("Tripwire N, locked to the NUMS point, cannot be spent")
+        leaf, fail = TREE_N.leaves["csig"], TREE_N.leaves["fail"]
+        forged = self.spend([(self.tw["N"], lambda tx, spent, index: [bytes(range(64)), bytes(leaf.script), leaf.control_block])])
+        self.reject(forged, "mempool-script-verify-flag-failed (Invalid Schnorr signature)")
+        self.submit(self.build_block([forged]), "block-script-verify-flag-failed (Invalid Schnorr signature)")
+        returned = self.spend([(self.tw["N"], lambda tx, spent, index: [bytes(fail.script), fail.control_block])])
+        self.reject(returned, "mempool-script-verify-flag-failed (OP_RETURN was encountered)")
+
+    def test_late_upgrade(self):
+        n0, n2 = self.nodes[0], self.nodes[2]
+        self.log.info("Late upgrade: node 2 follows past the trigger without the rules; with them its state is right")
+        self.connect_nodes(0, 2)
+        self.sync_blocks([n0, n2])
+        self.restart_node(2, extra_args=self.base_args[2][:1] + self.rules)
+        assert_equal(n2.gettripwireinfo(), n0.gettripwireinfo())
+
+        self.log.info("Late upgrade: a block that breaks the rules, mined without them, stays; -reindex drops it")
+        self.restart_node(2, extra_args=self.base_args[2])
+        block = self.build_block([self.spend([(self.outs["node2"], ec_witness())])], node=n2)
+        self.submit(block, node=n2)
+        self.submit(block, BLOCK_EC)
+        self.restart_node(2, extra_args=self.base_args[2][:1] + self.rules)
+        assert_equal(n2.getbestblockhash(), block.hash_hex)
+        self.restart_node(2, extra_args=self.base_args[2][:1] + self.rules + ["-reindex"])
+        self.wait_until(lambda: {"hash": block.hash_hex, "status": "invalid"} in
+                        [{"hash": tip["hash"], "status": tip["status"]} for tip in n2.getchaintips()])
+        assert_equal(n2.getbestblockhash(), f"{block.hashPrevBlock:064x}")
+        self.main.append(n2)
+        self.connect_main(n2)
+
+    def test_restarts(self):
+        n0, n1, n3 = self.nodes[0], self.nodes[1], self.nodes[3]
+        expected = n0.gettripwireinfo()
+        self.log.info("VerifyDB level 4 connects the blocks around the trigger again, each against its own parent")
+        depth = n0.getblockcount() - (H3 - 2)
+        assert n0.verifychain(4, depth)
+        self.restart_node(0, extra_args=self.base_args[0] + self.rules + ["-checklevel=4", f"-checkblocks={depth}"])
+        assert_equal(n0.gettripwireinfo(), expected)
+        self.log.info("-reindex-chainstate and -reindex rebuild the same state")
+        for node, option in ((n0, "-reindex-chainstate"), (n1, "-reindex")):
+            self.restart_node(node.index, extra_args=self.base_args[node.index] + self.rules + [option])
+            self.wait_until(lambda: node.getbestblockhash() == expected["tip_hash"])
+            assert_equal(node.gettripwireinfo(), expected)
+        self.connect_main()
+
+        self.log.info("Pruned node: the state does not need the pruned blocks")
+        # A block of its own fills a block file, so that X's file ends early and can be pruned.
+        self.wallet.send_self_transfer(from_node=n0, target_vsize=70_000)
+        self.mine()
+        self.mine(300)
+        n3.pruneblockchain(n3.getblockcount())
+        assert n3.getblockchaininfo()["pruneheight"] > self.x_height
+        self.restart_node(3, extra_args=self.base_args[3] + self.rules)
+        assert_equal(n3.gettripwireinfo(), n0.gettripwireinfo())
+        self.submit(self.build_block([self.spend([(self.outs["pruned_ec"], ec_witness())])], node=n3), BLOCK_EC, node=n3)
+        self.submit(self.build_block([self.spend([(self.outs["pruned_pq"], pq_witness())])], node=n3), node=n3)
+        self.connect_main(n3)
