+        self.reject(ec, DISCOURAGED)
+        self.reject(pq, DISCOURAGED)
+        self.reject(other, DISCOURAGED, node=1)
+        lone = self.spend([(o["lone_1"], lone_witness)])
+        self.accept(lone)
