+
+        self.log.info("Tip H3-2: the mempool turns away spends of 0xe0 leaves at depth one, not those at depth zero")
+        self.assert_next(active=False, disabled=False)
+        ec = self.spend([(o["boundary_ec"], ec_witness())])
+        pq = self.spend([(o["boundary_pq"], pq_witness())])
