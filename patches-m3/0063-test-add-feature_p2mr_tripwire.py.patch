+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test P2MR leaf version 0xe0 and its tripwire outputs (doc/p2mr-tripwire.md).
+
+With -signettripwire=<height>@<outpoints> on regtest, P2MR leaves of leaf version 0xe0 at
+depth one or more execute from that height on as leaves of version 0xc0 do. In a block
+whose parent leaves one of the tripwire outputs missing from the UTXO set (spent, never
+created, or created at or above the height), a signature check with a 32-byte key and a
+non-empty signature in such a leaf fails. There are three tripwire outputs here: A and B,
+whose keys the test holds, and N, locked to the NUMS point.
+
+  node 0  the rules and the default policy; builds the chain up to the regtest assumeutxo
+          snapshot at 299 exactly as feature_assumeutxo.py does, before any other node
+  node 1  the rules, -acceptnonstdtxn=1
+  node 2  without the rules, as an M2 build, until it upgrades late; it stays away while
+          node 0 is offered blocks that only the rules refuse, which its peers would relay
+          to it as compact blocks before checking them
+  node 3  the rules, pruned
+  node 4  other parameters: the rules from a height above the block that spends A, then a
+          tripwire output that never existed
+  node 5  loads the snapshot with a tripwire output that block 200, below the snapshot, spends
+
+Covered: the activation boundary in the mempool and in blocks, the m=0 exception, the
+block that spends a tripwire (spends before and after the trigger in it are valid, the
+same spends one block later are not), a tripwire spend only in the mempool, removal from
+the mempool on a plain connect (chains, a package, TRUC, mixed inputs) and after a
+reorganization (a parent that comes back while its Schnorr child goes; a first block that
+repeats the transactions of the block it replaces, so that none come back), the script and
+signature caches, reorgs over the trigger, over the creation of the tripwires and below
+the height, both tripwires missing, the NUMS tripwire, the policy of 0xe0 leaves,
+templates and proposals, the logs and gettripwireinfo, VerifyDB level 4, restarts,
+-reindex, -reindex-chainstate, pruning, assumeutxo, a late upgrade, and the options.
+"""
+
+import hashlib
+import re
+
+from test_framework.blocktools import (
+    add_witness_commitment,
+    create_block,
+    create_coinbase,
+)
+from test_framework.key import compute_xonly_pubkey, sign_schnorr, tweak_add_privkey
+from test_framework.messages import COIN, COutPoint, CTransaction, CTxIn, CTxInWitness, CTxOut
+from test_framework.p2mr import p2mr_construct
+from test_framework.p2mr_mldsa44 import (
+    MLDSA44_PUBKEY_CHUNK_SIZES,
+    OP_CHECKMLDSA44,
+    mldsa44_keygen,
+    mldsa44_leaf,
+    split_chunks,
+)
+from test_framework.p2mr_tripwire import (
+    EC_DISABLED_ERROR,
+    LEAF_VERSION_TRIPWIRED,
+    NUMS_H,
+    hybrid_tree,
+    mldsa44_leaf_witness,
+    schnorr_leaf_witness,
+    tripwire_tree,
+)
+from test_framework.script import (
+    CScript,
+    OP_1,
+    OP_CHECKSIG,
+    OP_DROP,
+    OP_RETURN,
+    SIGHASH_DEFAULT,
+    TaprootSignatureHash,
+    taproot_construct,
+)
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.test_node import ErrorMatch
+from test_framework.util import assert_equal, assert_raises_rpc_error
+from test_framework.wallet import MiniWallet
+
+H3 = 310
+NEVER = 2147483646  # the highest height -testactivationheight takes
+START_HEIGHT = 199
+SNAPSHOT_BASE_HEIGHT = 299
+SNAPSHOT_BASE_HASH = "7cc695046fec709f8c9394b6f928f81e81fd3ac20977bb68760fa1faa7916ea2"
+SNAPSHOT_H3 = 150
+FUND_SATS = 100_000
+FEE_SATS = 5_000
+ARK0_CHALLENGE = "5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae"
+
+
+def seckey(tag):
+    return hashlib.sha256(b"feature_p2mr_tripwire " + tag).digest()
+
+
+SEC_A, SEC_B, SEC_U = seckey(b"tripwire a"), seckey(b"tripwire b"), seckey(b"user")
+PUB_A, PUB_B, PUB_U = (compute_xonly_pubkey(key)[0] for key in (SEC_A, SEC_B, SEC_U))
+PQ_PUB, PQ_SEC = mldsa44_keygen(seckey(b"ml-dsa-44"))
+
+TREE_A = tripwire_tree(PUB_A)
+TREE_B = tripwire_tree(PUB_B)
+TREE_N = tripwire_tree(NUMS_H)
+# Template S3: a Schnorr leaf and an ML-DSA-44 leaf, both of leaf version 0xe0 at depth one.
+HYBRID = hybrid_tree(PUB_U, PQ_PUB)
+# M1's template S2 (ML-DSA-44 AND Schnorr in one leaf) in a leaf of version 0xe0.
+MIXED = p2mr_construct([("mix", mldsa44_leaf(PQ_PUB, PUB_U), LEAF_VERSION_TRIPWIRED), ("fail", CScript([OP_RETURN]))])
+# A single leaf tree has m=0: the leaf is not executed at any height.
+LONE = p2mr_construct([("ec", CScript([PUB_U, OP_CHECKSIG]), LEAF_VERSION_TRIPWIRED)])
+# Drops one witness item, for the 80-byte stack item limit of policy.
+ITEM = p2mr_construct([("drop", CScript([OP_DROP, OP_1]), LEAF_VERSION_TRIPWIRED), ("fail", CScript([OP_RETURN]))])
+# Uses OP_CHECKMLDSA44 but is not one of its templates.
+OTHER = p2mr_construct([("pq", CScript([OP_1, OP_DROP] + split_chunks(PQ_PUB, MLDSA44_PUBKEY_CHUNK_SIZES) + [OP_CHECKMLDSA44]),
+                         LEAF_VERSION_TRIPWIRED), ("fail", CScript([OP_RETURN]))])
+# Elliptic curve checks elsewhere: a P2MR leaf of version 0xc0 and a P2TR key path.
+CSIG_C0 = p2mr_construct([("csig", CScript([PUB_U, OP_CHECKSIG])), ("fail", CScript([OP_RETURN]))])
+TAP = taproot_construct(PUB_U, [])
+
+DISCOURAGED = "mempool-script-verify-flag-failed (Taproot version reserved for soft-fork upgrades)"
+NONSTANDARD = "bad-witness-nonstandard"
+MEMPOOL_EC = f"mempool-script-verify-flag-failed ({EC_DISABLED_ERROR})"
+BLOCK_EC = f"block-script-verify-flag-failed ({EC_DISABLED_ERROR})"
+
+
+def output(tx, n=0):
+    return {"txid": tx.txid_int, "vout": n, "value": tx.vout[n].nValue, "script_pubkey": tx.vout[n].scriptPubKey}
+
+
+def outpoint(utxo):
+    return f"{utxo['txid']:064x}:{utxo['vout']}"
+
+
+def ec_witness(tree=HYBRID, name="ec", *, key=SEC_U, corrupt=False):
+    """Spend a leaf <xonly> OP_CHECKSIG; corrupt flips one bit of the signature."""
+    leaf = tree.leaves[name]
+
+    def make(tx, spent, index):
+        stack = schnorr_leaf_witness(key, leaf, tx, spent, index)
+        if corrupt:
+            stack[0] = bytes([stack[0][0] ^ 1]) + stack[0][1:]
+        return stack
+    return make
+
+
+def pq_witness(tree=HYBRID, name="pq", *, mutate=None):
+    """Spend an ML-DSA-44 leaf; mutate edits the whole witness stack."""
+    leaf = tree.leaves[name]
+
+    def make(tx, spent, index):
+        stack = mldsa44_leaf_witness(PQ_SEC, leaf, tx, spent, index)
+        return stack if mutate is None else mutate(stack)
+    return make
+
+
+def flip_bit(stack):
+    return stack[:2] + [bytes([stack[2][0] ^ 1]) + stack[2][1:]] + stack[3:]
+
+
+def mixed_witness(tx, spent, index):
+    leaf = MIXED.leaves["mix"]
+    return [schnorr_leaf_witness(SEC_U, leaf, tx, spent, index)[0]] + mldsa44_leaf_witness(PQ_SEC, leaf, tx, spent, index)
+
+
+def lone_witness(tx, spent, index):
+    leaf = LONE.leaves["ec"]
+    return [bytes(leaf.script), leaf.control_block]
+
+
+def lone_item_witness(size):
+    leaf = LONE.leaves["ec"]
+    return lambda tx, spent, index: [b"\x01" * size, bytes(leaf.script), leaf.control_block]
+
+
+def item_witness(size):
+    leaf = ITEM.leaves["drop"]
+    return lambda tx, spent, index: [b"\x01" * size, bytes(leaf.script), leaf.control_block]
+
+
+def keypath_witness(tx, spent, index):
+    msg = TaprootSignatureHash(tx, spent, SIGHASH_DEFAULT, index)
+    return [sign_schnorr(tweak_add_privkey(SEC_U, TAP.tweak), msg)]
+
+
+# What each output funded before the rules activate is for.
+OUTPUTS = {
+    "boundary_ec": HYBRID, "boundary_pq": HYBRID, "boundary_invalid": HYBRID, "boundary_other": OTHER,
+    "lone_1": LONE, "lone_2": LONE, "lone_3": LONE, "lone_81_1": LONE, "lone_81_2": LONE,
+    "after_pq": HYBRID, "item_80": ITEM, "item_81": ITEM, "extra": HYBRID, "mixed_1": MIXED, "mixed_2": MIXED,
+    "old_ec": HYBRID, "same_ec": HYBRID,
+    "cache_ec": HYBRID, "kept_pq": HYBRID, "parent_ec": HYBRID, "parent_pq": HYBRID, "package": HYBRID,
+    "truc_ec": HYBRID, "truc_pq": HYBRID, "mixed_ec": HYBRID, "mixed_pq": HYBRID, "before": HYBRID, "after": HYBRID,
+    "late_pq": HYBRID, "csig_c0": CSIG_C0, "tap": TAP,
+    "node4_1": HYBRID, "node4_2": HYBRID, "node4_3": HYBRID, "node2": HYBRID, "pruned_ec": HYBRID, "pruned_pq": HYBRID,
+}
+
+
+class P2MRTripwireTest(BitcoinTestFramework):
+    def set_test_params(self):
+        # The cached chain up to 199, which the regtest assumeutxo snapshot at 299 builds on.
+        self.num_nodes = 6
+        self.rpc_timeout = 120
+        noban = "-whitelist=noban@127.0.0.1"
+        self.base_args = [
+            [noban],
+            [noban, "-acceptnonstdtxn=1"],
+            [noban, f"-testactivationheight=p2mr_tripwire@{NEVER}"],
+            [noban, "-fastprune", "-prune=1"],
+            [noban],
+            [noban],
+        ]
+        self.extra_args = [list(args) for args in self.base_args]
+
+    def setup_network(self):
+        # Disconnected, and without the block setup_nodes() mines on the cached chain: node 0 builds
+        # the snapshot chain on its own, and node 5 only gets its headers.
+        self.add_nodes(self.num_nodes, self.extra_args)
+        self.start_nodes()
+
+    # ------------------------------------------------------------------
+    # Helpers
+    # ------------------------------------------------------------------
+
+    def sync_main(self):
+        self.sync_blocks(self.main)
+
+    def mine(self, count=1):
+        return self.generate(self.wallet, count, sync_fun=self.sync_main)
+
+    def connect_main(self, *nodes):
+        """Connect node 0 to the other main nodes, or to those given, and sync."""
+        for node in nodes or self.main[1:]:
+            self.connect_nodes(0, node.index)
+        self.sync_main()
+
+    def disconnect_main(self):
+        for node in self.main[1:]:
+            self.disconnect_nodes(0, node.index)
+
+    def wallet_witness(self, tx, spent, index):
+        return list(self.wallet_stack)
+
+    def wallet_input(self):
+        utxo = self.wallet.get_utxo(confirmed_only=True)
+        return ({"txid": int(utxo["txid"], 16), "vout": utxo["vout"], "value": int(utxo["value"] * COIN),
+                 "script_pubkey": self.wallet.get_output_script()}, self.wallet_witness)
+
+    def spend(self, inputs, *, outputs=None, version=2):
+        """Build a transaction from (utxo, witness function) pairs; one output to the wallet by default."""
+        tx = CTransaction()
+        tx.version = version
+        tx.vin = [CTxIn(COutPoint(utxo["txid"], utxo["vout"]), b"", 0xfffffffd) for utxo, _ in inputs]
+        total = sum(utxo["value"] for utxo, _ in inputs)
+        tx.vout = outputs if outputs is not None else [CTxOut(total - FEE_SATS, self.wallet.get_output_script())]
+        spent = [CTxOut(utxo["value"], utxo["script_pubkey"]) for utxo, _ in inputs]
+        tx.wit.vtxinwit = [CTxInWitness() for _ in inputs]
+        for index, (_, make) in enumerate(inputs):
+            tx.wit.vtxinwit[index].scriptWitness.stack = make(tx, spent, index)
+        return tx
+
+    def fund(self, script_pubkeys):
+        """Create one confirmed output for each scriptPubKey, all in one transaction."""
+        utxo, witness = self.wallet_input()
+        outputs = [CTxOut(FUND_SATS, spk) for spk in script_pubkeys]
+        outputs.append(CTxOut(utxo["value"] - FUND_SATS * len(outputs) - FEE_SATS, self.wallet.get_output_script()))
+        tx = self.spend([(utxo, witness)], outputs=outputs)
+        self.wallet.sendrawtransaction(from_node=self.nodes[0], tx_hex=tx.serialize().hex())
+        self.mine()
+        return tx, [output(tx, n) for n in range(len(script_pubkeys))]
+
+    def build_block(self, txs, *, node=None, prev=None, nudge=0):
+        node = node or self.nodes[0]
+        prev = prev or node.getbestblockhash()
+        header = node.getblockheader(prev)
+        block = create_block(int(prev, 16), create_coinbase(header["height"] + 1), header["mediantime"] + 1 + nudge, txlist=txs)
+        add_witness_commitment(block)
+        block.solve()
+        return block
+
+    def submit(self, block, expected=None, *, node=None):
+        assert_equal((node or self.nodes[0]).submitblock(block.serialize().hex()), expected)
+
+    def propose(self, block):
+        return self.nodes[0].getblocktemplate({"mode": "proposal", "data": block.serialize().hex()})
+
+    def accept(self, tx, node=0):
+        self.nodes[node].sendrawtransaction(tx.serialize().hex(), 0)
+        assert tx.txid_hex in self.nodes[node].getrawmempool()
+
+    def reject(self, tx, reason, node=0):
+        assert_raises_rpc_error(-26, reason, self.nodes[node].sendrawtransaction, tx.serialize().hex(), 0)
+
+    def mempool(self, node=0):
+        return set(self.nodes[node].getrawmempool())
+
+    def assert_next(self, *, active, disabled, nodes=None):
+        """The deployment and the state as they apply to the next block."""
+        for node in nodes or [self.nodes[i] for i in (0, 1, 3)]:
+            assert_equal(node.getdeploymentinfo()["deployments"]["p2mr_tripwire"]["active"], active)
+            assert_equal(node.gettripwireinfo()["ec_disabled_next_block"], disabled)
+
+    def assert_state(self, states, disabled, node=None):
+        info = (node or self.nodes[0]).gettripwireinfo()
+        assert_equal([tripwire["state"] for tripwire in info["tripwires"]], states)
+        assert_equal(info["ec_disabled_next_block"], disabled)
+
+    def spent_log(self, name, tx, block_hash, height, effect):
+        return (f"P2MR tripwire {self.tripwires[name]} spent by {tx.txid_hex} in block {block_hash} (height {height}): "
+                f"elliptic curve checks in leaf version 0xe0 are {effect}")
+
+    def state_log(self, states, checks):
+        outputs = ", ".join(f"{op} {state}" for op, state in zip(self.tripwires.values(), states))
+        return f"tripwire outputs {outputs}; elliptic curve checks in leaf version 0xe0 are {checks} for the next block"
+
+    # ------------------------------------------------------------------
+    # Test body
+    # ------------------------------------------------------------------
+
+    def run_test(self):
+        # The nodes that follow the chain node 0 mines; node 2 joins with its late upgrade.
+        self.main = [self.nodes[0], self.nodes[1], self.nodes[3]]
+        snapshot = self.build_snapshot_chain()
+        for i in (1, 2, 3, 4):
+            self.connect_nodes(0, i)
+        self.sync_blocks(self.nodes[:5])
+        self.wallet.rescan_utxos()
+        probe = CTransaction()
+        probe.vin = [CTxIn()]
+        self.wallet.sign_tx(probe)
+        self.wallet_stack = list(probe.wit.vtxinwit[0].scriptWitness.stack)
+
+        self.test_assumeutxo(snapshot)
+        self.create_tripwires()
+        self.test_activation()
+        self.test_after_activation()
+        self.test_resurrection()
+        self.test_reorg_onto_same_transactions()
+        self.test_trigger()
+        self.test_trigger_below_height()
+        self.test_reorg_over_trigger()
+        self.test_both_missing()
+        self.test_nums()
+        self.test_late_upgrade()
+        self.test_restarts()
+        self.test_options()
+
+    def build_snapshot_chain(self):
+        self.log.info("Mine blocks 200 to 299 as feature_assumeutxo.py does, for the snapshot regtest knows")
+        n0 = self.nodes[0]
+        assert_equal(n0.getblockcount(), START_HEIGHT)
+        n0.setmocktime(n0.getblockheader(n0.getbestblockhash())["time"])
+        self.wallet = MiniWallet(n0)
+        for i in range(SNAPSHOT_BASE_HEIGHT - START_HEIGHT):
+            if i % 3 == 0:
+                self.wallet.send_self_transfer(from_node=n0)
+            self.generate(n0, nblocks=1, sync_fun=self.no_op)
+        assert_equal(n0.getbestblockhash(), SNAPSHOT_BASE_HASH)
+        return n0.dumptxoutset("utxos.dat", "latest")["path"]
+
+    def test_assumeutxo(self, snapshot):
+        self.log.info("assumeutxo: the snapshot chainstate is past a tripwire spend the background one has not reached")
+        n0, n5 = self.nodes[0], self.nodes[5]
+        # Node 5's tripwire: the output the first transaction of block 200 spends, created far below.
+        spend = n0.getblock(n0.getblockhash(START_HEIGHT + 1), 2)["tx"][1]["vin"][0]
+        created = next(h for h in range(START_HEIGHT + 1) if n0.getblock(n0.getblockhash(h))["tx"][0] == spend["txid"])
+        assert created < SNAPSHOT_H3 < START_HEIGHT
+        tripwire = f"{spend['txid']}:{spend['vout']}"
+        with n5.assert_debug_log([f"P2MR tripwire rules from height {SNAPSHOT_H3} in leaf version 0xe0; tripwire outputs {tripwire}",
+                                  f"P2MR tripwire state at height {START_HEIGHT}: tripwire outputs {tripwire} unspent; "
+                                  "elliptic curve checks in leaf version 0xe0 are enabled for the next block"]):
+            self.restart_node(5, extra_args=self.base_args[5] + [f"-signettripwire={SNAPSHOT_H3}@{tripwire}"])
+        n5.setmocktime(n0.getblockheader(n0.getbestblockhash())["time"])
+        for height in range(START_HEIGHT + 1, SNAPSHOT_BASE_HEIGHT + 1):
+            n5.submitheader(n0.getblock(n0.getblockhash(height), 0))
+        assert_equal(n5.loadtxoutset(snapshot)["base_height"], SNAPSHOT_BASE_HEIGHT)
+        assert_equal([chainstate["blocks"] for chainstate in n5.getchainstates()["chainstates"]], [START_HEIGHT, SNAPSHOT_BASE_HEIGHT])
+        info = n5.gettripwireinfo()
