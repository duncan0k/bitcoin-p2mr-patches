+    def test_resurrection(self):
+        self.log.info("Reorg to a branch that spends tripwire B: a parent comes back, its Schnorr child goes")
+        n0 = self.nodes[0]
+        self.disconnect_main()
+        # The old branch confirms the parent and a Schnorr spend; its last input conflicts with the trigger.
+        conflict, conflict_witness = self.wallet_input()
+        funds, funds_witness = self.wallet_input()
+        parent = self.spend([(funds, funds_witness)], outputs=[
+            CTxOut(FUND_SATS, HYBRID.scriptPubKey), CTxOut(FUND_SATS, HYBRID.scriptPubKey),
+            CTxOut(funds["value"] - 2 * FUND_SATS - FEE_SATS, self.wallet.get_output_script())])
+        old_ec = self.spend([(self.outs["old_ec"], ec_witness())])
+        conflicting = self.spend([(conflict, conflict_witness)])
+        fork = n0.getbestblockhash()
+        old = self.build_block([parent, old_ec, conflicting])
+        self.submit(old)
+        child_ec = self.spend([(output(parent, 0), ec_witness())])
+        grandchild = self.spend([(output(child_ec), self.wallet_witness)])
+        child_pq = self.spend([(output(parent, 1), pq_witness())])
+        for tx in (child_ec, grandchild, child_pq):
+            self.accept(tx)
+
+        trigger = self.spend([(self.tw["B"], ec_witness(TREE_B, "csig", key=SEC_B)), (conflict, conflict_witness)])
+        new = self.build_block([trigger], prev=fork, nudge=1)
+        self.submit(new, "inconclusive")
+        assert_equal(n0.getbestblockhash(), old.hash_hex)
+        height = n0.getblockcount()
+        longer = self.build_block([], prev=new.hash_hex)
+        with n0.assert_debug_log([self.spent_log("B", trigger, new.hash_hex, height, f"disabled from height {height + 1}")]):
+            self.submit(longer)
+        assert_equal(n0.getbestblockhash(), longer.hash_hex)
+        self.assert_state(["unspent", "missing", "unspent"], True)
+        assert_equal(self.mempool(), {parent.txid_hex, child_pq.txid_hex})
+        template = n0.getblocktemplate({"rules": ["segwit"]})
+        assert_equal({tx["txid"] for tx in template["transactions"]}, {parent.txid_hex, child_pq.txid_hex})
+
+        n0.invalidateblock(new.hash_hex)
+        assert_equal(n0.getbestblockhash(), old.hash_hex)
+        self.assert_state(["unspent"] * 3, False)
+        assert_equal(self.mempool(), {child_pq.txid_hex})
+        self.connect_main()
