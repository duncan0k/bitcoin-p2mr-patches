+    def test_options(self):
+        self.log.info("Options: -signettripwire needs OP_CHECKMLDSA44 active below its height; Ark-0 takes neither option")
+        node = self.nodes[4]
+        tripwire = f"{'ab' * 32}:0"
+
+        def refused(args, message):
+            node.assert_start_raises_init_error(args, re.escape(f"Error: {message}"), match=ErrorMatch.PARTIAL_REGEX)
+        refused(["-testactivationheight=p2mr_mldsa44@20", f"-signettripwire=20@{tripwire}"],
+                "-signettripwire height must be above the p2mr_mldsa44 height 20, not 20.")
+        refused(["-testactivationheight=p2mr_tripwire@5", f"-signettripwire=20@{tripwire}"],
+                "-signettripwire sets the height of p2mr_tripwire, which -testactivationheight cannot set too.")
+        signet = ["-regtest=0", "-signet"]
+        refused(signet + ["-signetmldsa44=20"], "-signetmldsa44 requires -signetchallenge.")
+        refused(signet + ["-signetchallenge=51", f"-signettripwire=20@{tripwire}"], "-signettripwire requires -signetmldsa44.")
+        refused(signet + ["-signetchallenge=51", "-signetmldsa44=20", f"-signettripwire=20@{tripwire}"],
+                "-signettripwire height must be above the -signetmldsa44 height 20, not 20.")
+        refused(signet + [f"-signetchallenge={ARK0_CHALLENGE}", "-signetmldsa44=20"],
+                "-signetmldsa44 cannot be used on the Ark-0 signet, whose rules are fixed in the code.")
+        refused(signet + [f"-signetchallenge={ARK0_CHALLENGE}", "-signetmldsa44=20", f"-signettripwire=30@{tripwire}"],
+                "-signetmldsa44 cannot be used on the Ark-0 signet, whose rules are fixed in the code.")
+        refused(signet + [f"-signetchallenge={ARK0_CHALLENGE}", f"-signettripwire=30@{tripwire}"],
+                "-signettripwire cannot be used on the Ark-0 signet, whose rules are fixed in the code.")
+
+        self.log.info("Options: refused on the chains they are not for, whatever their value")
+        refused(["-regtest=0", "-signettripwire=garbage"], "-signettripwire can only be used with signet or regtest.")
+        refused(["-signetmldsa44=garbage"], "-signetmldsa44 can only be used with signet.")
