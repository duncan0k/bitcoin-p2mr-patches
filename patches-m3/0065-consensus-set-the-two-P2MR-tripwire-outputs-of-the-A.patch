-inline constexpr int ARK0_TRIPWIRE_HEIGHT{std::numeric_limits<int>::max()};
+inline constexpr int ARK0_TRIPWIRE_HEIGHT{30000};
 // Leaf version 0xe0 runs OP_CHECKMLDSA44, which has to be active before the leaves are.
 static_assert(ARK0_TRIPWIRE_HEIGHT > ARK0_MLDSA44_HEIGHT);
 
+/** Height of the block that created both tripwire outputs of the Ark-0 signet. */
+inline constexpr int ARK0_TRIPWIRE_CREATION_HEIGHT{15748};
+// An output counts as present only when it was created below the height of the rules.
+static_assert(ARK0_TRIPWIRE_HEIGHT > ARK0_TRIPWIRE_CREATION_HEIGHT);
