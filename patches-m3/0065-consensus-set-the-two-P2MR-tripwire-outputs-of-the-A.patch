+// The two tripwire outputs of Ark-0, created at ARK0_TRIPWIRE_CREATION_HEIGHT. Each scriptPubKey,
+// rebuilt from the key and the two leaves of version 0xc0 at depth one, <key> OP_CHECKSIG and
+// OP_RETURN, is the one on that chain, so that a key copied wrong shows up here.
+BOOST_AUTO_TEST_CASE(ark0_tripwire_outputs)
+{
+    struct Expected {
+        std::string outpoint, label, key, script_pubkey;
+    };
+    const std::vector<Expected> expected{
+        {"4319a38c0842846474ff038b54f22aec844147a97c2abc462bfb92957c1bc3a0:1", "BIP-341 NUMS",
+         "50929b74c1a04954b78b4b6035e97a5e078a5a0f28ec96d547bfee9ace803ac0",
+         "52202883f815a950fc2eb0d9d39f293f95e20d100a893c92d9122d958490b7a0d117"},
+        {"8991bb83673474b7c324f303365479c093d0b34f5e7d7ddf0648bcfdb1d42495:0", "drill",
+         "2f605bb3d127c17ff8e88e214587876b0c7623dbad79f8a1115fa172bda0315f",
+         "5220c1f0ac831a7ec446dfff7b35697fc9821ce29c109443d5bad4bcb988080c1e7a"},
+    };
+    const auto ark0{MakeParams(ChainType::SIGNET, {{"-signetchallenge", ARK0_CHALLENGE}})};
+    const std::vector<Consensus::P2MRTripwire>& tripwires{ark0->GetConsensus().p2mr_tripwires};
+    BOOST_REQUIRE_EQUAL(tripwires.size(), expected.size());
+    BOOST_CHECK(std::ranges::equal(tripwires[0].key, XOnlyPubKey::NUMS_H));
+    const CScript fail_leaf{CScript{} << OP_RETURN};
+    for (size_t i{0}; i < expected.size(); ++i) {
+        const Consensus::P2MRTripwire& tripwire{tripwires[i]};
+        BOOST_CHECK_EQUAL(strprintf("%s:%u", tripwire.outpoint.hash.ToString(), tripwire.outpoint.n), expected[i].outpoint);
+        BOOST_CHECK_EQUAL(tripwire.label, expected[i].label);
+        BOOST_CHECK_EQUAL(HexStr(tripwire.key), expected[i].key);
+        const CScript checksig_leaf{CScript{} << tripwire.key << OP_CHECKSIG};
+        const uint256 root{ComputeTapbranchHash(ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, checksig_leaf),
+                                                ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, fail_leaf))};
+        BOOST_CHECK_EQUAL(HexStr(CScript{} << OP_2 << ToByteVector(root)), expected[i].script_pubkey);
+    }
+    BOOST_CHECK_GT(ARK0_TRIPWIRE_HEIGHT, ARK0_TRIPWIRE_CREATION_HEIGHT);
+}
