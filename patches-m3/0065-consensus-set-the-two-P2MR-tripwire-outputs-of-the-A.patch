     "fc8974a6e31d3270043e779b5e3bdabd40f01cfc0f7438937d505a2897cdf0dc"_hex_u8};
 static_assert(ARK0_PQ_BLOCK_PUBKEY.size() == MLDSA44_PUBKEY_SIZE);
 
-//! The tripwire outputs of the Ark-0 signet (doc/p2mr-tripwire.md), each with the x-only key its
-//! leaf checks and a label: one whose leaf checks the BIP-341 NUMS point, XOnlyPubKey::NUMS_H,
-//! labelled "BIP-341 NUMS", which no one can spend, and the drill output, labelled "drill", whose
-//! key the operator holds. Not set yet, like ARK0_TRIPWIRE_HEIGHT: the commit that sets that height
-//! adds both outputs, which are created below it.
-static const std::vector<Consensus::P2MRTripwire> ARK0_TRIPWIRE_OUTPOINTS{};
+//! The x-only key of the leaf of the Ark-0 drill tripwire output, which the operator holds.
+static constexpr auto ARK0_TRIPWIRE_DRILL_KEY{"2f605bb3d127c17ff8e88e214587876b0c7623dbad79f8a1115fa172bda0315f"_hex_u8};
+
+//! The tripwire outputs of the Ark-0 signet (doc/p2mr-tripwire.md), both created at height
+//! ARK0_TRIPWIRE_CREATION_HEIGHT, each a P2MR output of two leaves of version 0xc0 at depth one,
+//! <key> OP_CHECKSIG and OP_RETURN, with that key and a label: the one whose key is the BIP-341
+//! NUMS point, XOnlyPubKey::NUMS_H, which no one can spend, labelled "BIP-341 NUMS", and the drill
+//! output, labelled "drill", whose key the operator holds and spends to trigger the drill.
+static const std::vector<Consensus::P2MRTripwire> ARK0_TRIPWIRE_OUTPOINTS{
+    {
+        .outpoint = COutPoint{Txid{"4319a38c0842846474ff038b54f22aec844147a97c2abc462bfb92957c1bc3a0"}, 1},
+        .key = {XOnlyPubKey::NUMS_H.begin(), XOnlyPubKey::NUMS_H.end()},
+        .label = "BIP-341 NUMS",
+    },
+    {
+        .outpoint = COutPoint{Txid{"8991bb83673474b7c324f303365479c093d0b34f5e7d7ddf0648bcfdb1d42495"}, 0},
+        .key = {ARK0_TRIPWIRE_DRILL_KEY.begin(), ARK0_TRIPWIRE_DRILL_KEY.end()},
+        .label = "drill",
+    },
+};
 
 bool IsArk0SignetChallenge(std::span<const uint8_t> challenge)
 {
