diff --git a/src/script/interpreter.cpp b/src/script/interpreter.cpp
index 924806c..76afc86 100644
--- a/src/script/interpreter.cpp
+++ b/src/script/interpreter.cpp
@@ -355,7 +355,9 @@ static bool EvalChecksigTapscript(const valtype& sig, const valtype& pubkey, Scr
      *  The following validation sequence is consensus critical. Please note how --
      *    upgradable public key versions precede other rules;
      *    the script execution fails when using empty signature with invalid public key;
-     *    the script execution fails when using non-empty invalid signature.
+     *    the script execution fails when using non-empty invalid signature;
+     *    in a tripwired P2MR leaf with SCRIPT_VERIFY_P2MR_EC_DISABLED, the script execution
+     *    fails when using any non-empty signature with a 32-byte public key.
      */
     success = !sig.empty();
     if (success) {
@@ -370,6 +372,11 @@ static bool EvalChecksigTapscript(const valtype& sig, const valtype& pubkey, Scr
     if (pubkey.size() == 0) {
         return set_error(serror, SCRIPT_ERR_TAPSCRIPT_EMPTY_PUBKEY);
     } else if (pubkey.size() == 32) {
+        // Once a tripwire output is missing, elliptic curve checks in leaf version 0xe0 fail rather
+        // than push false, whatever the signature, before it is looked at (doc/p2mr-tripwire.md).
+        if (success && execdata.m_tripwired_leaf && (flags & SCRIPT_VERIFY_P2MR_EC_DISABLED)) {
+            return set_error(serror, SCRIPT_ERR_P2MR_EC_DISABLED);
+        }
         if (success && !checker.CheckSchnorrSignature(sig, pubkey, sigversion, execdata, serror)) {
             return false; // serror is set
         }
@@ -2151,13 +2158,18 @@ static bool VerifyWitnessProgram(const CScriptWitness& witness, int witversion,
             // The leaf sits at depth zero (m = 0): succeed without executing the script.
             return set_success(serror);
         }
-        if ((control[0] & TAPROOT_LEAF_MASK) == TAPROOT_LEAF_TAPSCRIPT) {
-            // Tapscript (leaf version 0xc0)
+        const uint8_t leaf_version{static_cast<uint8_t>(control[0] & TAPROOT_LEAF_MASK)};
+        // Leaf version 0xe0 executes as 0xc0 does once SCRIPT_VERIFY_P2MR_TRIPWIRE is set (doc/p2mr-tripwire.md).
+        const bool tripwired{leaf_version == P2MR_LEAF_TRIPWIRED && (flags & SCRIPT_VERIFY_P2MR_TRIPWIRE)};
+        if (leaf_version == TAPROOT_LEAF_TAPSCRIPT || tripwired) {
+            // Tapscript (leaf version 0xc0, or 0xe0)
             exec_script = CScript(script.begin(), script.end());
             execdata.m_validation_weight_left = ::GetSerializeSize(witness.stack) + VALIDATION_WEIGHT_OFFSET;
             execdata.m_validation_weight_left_init = true;
             // Where OP_CHECKMLDSA44 can execute (doc/p2mr-mldsa44.md).
             execdata.m_p2mr_leaf = true;
+            // Where elliptic curve checks fail with SCRIPT_VERIFY_P2MR_EC_DISABLED (doc/p2mr-tripwire.md).
+            execdata.m_tripwired_leaf = tripwired;
             return ExecuteWitnessScript(stack, exec_script, flags, SigVersion::TAPSCRIPT, checker, execdata, serror);
         }
         if (flags & SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_TAPROOT_VERSION) {
@@ -2366,6 +2378,8 @@ const std::map<std::string, script_verify_flag_name>& ScriptFlagNamesToEnum()
         FLAG_NAME(TAPROOT),
         FLAG_NAME(P2MR),
         FLAG_NAME(P2MR_MLDSA44),
+        FLAG_NAME(P2MR_TRIPWIRE),
+        FLAG_NAME(P2MR_EC_DISABLED),
         FLAG_NAME(DISCOURAGE_UPGRADABLE_PUBKEYTYPE),
         FLAG_NAME(DISCOURAGE_OP_SUCCESS),
         FLAG_NAME(DISCOURAGE_UPGRADABLE_TAPROOT_VERSION),
