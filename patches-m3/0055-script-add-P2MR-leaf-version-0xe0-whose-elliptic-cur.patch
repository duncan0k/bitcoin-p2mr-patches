+    //
+    SCRIPT_VERIFY_P2MR_EC_DISABLED,
+
     // Constants to point to the highest flag in use. Add new flags above this line.
     //
     SCRIPT_VERIFY_END_MARKER
@@ -248,8 +262,13 @@ struct ScriptExecutionData
     //! The hash of the corresponding output
     std::optional<uint256> m_output_hash;
 
-    //! Whether the script is a P2MR leaf that is executed: leaf version 0xc0 at depth one or more.
+    //! Whether the script is a P2MR leaf that is executed: leaf version 0xc0 at depth one or more,
+    //! or 0xe0 with SCRIPT_VERIFY_P2MR_TRIPWIRE.
     bool m_p2mr_leaf = false;
+
+    //! Whether the script is a P2MR leaf of leaf version 0xe0 that is executed, whose elliptic
+    //! curve signature checks fail with SCRIPT_VERIFY_P2MR_EC_DISABLED (doc/p2mr-tripwire.md).
+    bool m_tripwired_leaf{false};
 };
 
 /** Signature hash sizes */
@@ -273,6 +292,10 @@ static constexpr size_t P2MR_CONTROL_NODE_SIZE = 32;
 static constexpr size_t P2MR_CONTROL_MAX_NODE_COUNT = 128;
 static constexpr size_t P2MR_CONTROL_MAX_SIZE = P2MR_CONTROL_BASE_SIZE + P2MR_CONTROL_NODE_SIZE * P2MR_CONTROL_MAX_NODE_COUNT;
 static_assert(P2MR_CONTROL_MAX_SIZE == 4097);
+/** Experimental P2MR leaf version (doc/p2mr-tripwire.md), control byte 0xe1: executed as
+ *  tapscript with SCRIPT_VERIFY_P2MR_TRIPWIRE, and its elliptic curve signature checks fail
+ *  with SCRIPT_VERIFY_P2MR_EC_DISABLED. In P2TR it stays an unknown leaf version. */
+static constexpr uint8_t P2MR_LEAF_TRIPWIRED{0xe0};
 
 /** OP_CHECKMLDSA44 (doc/p2mr-mldsa44.md) takes the ML-DSA-44 public key as three stack
  *  elements of these sizes, and the signature as five: the last one may carry one more
