+        // SCRIPT_VERIFY_P2MR_EC_DISABLED only makes more scripts fail, and is fuzzed.
+        fuzzed_flags &= ~(SCRIPT_VERIFY_P2MR | SCRIPT_VERIFY_P2MR_MLDSA44 | SCRIPT_VERIFY_P2MR_TRIPWIRE);
 
         std::vector<CTxOut> spent_outputs;
         for (unsigned i = 0; i < tx.vin.size(); ++i) {
