 src/script/interpreter.h       | 27 +++++++++++++++++++++++++--
 src/script/script_error.cpp    |  2 ++
 src/script/script_error.h      |  3 +++
 src/test/fuzz/script_flags.cpp |  8 ++++++++
 src/test/script_tests.cpp      |  1 +
