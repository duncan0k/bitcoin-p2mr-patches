+    // with leaf version 0xc0, or 0xe0 with SCRIPT_VERIFY_P2MR_TRIPWIRE. See
+    // doc/p2mr-mldsa44.md.
     //
     SCRIPT_VERIFY_P2MR_MLDSA44,
 
+    // Experimental P2MR leaf version 0xe0 (P2MR_LEAF_TRIPWIRED): a leaf of depth one
