diff --git a/src/test/fuzz/script_flags.cpp b/src/test/fuzz/script_flags.cpp
index 3ab5880..c92c961 100644
--- a/src/test/fuzz/script_flags.cpp
+++ b/src/test/fuzz/script_flags.cpp
@@ -40,6 +40,14 @@ FUZZ_TARGET(script_flags)
 
         script_verify_flags fuzzed_flags;
         ds >> fuzzed_flags;
+        // Each of these flags makes a script execute that without it meets an upgrade hook, which a
+        // DISCOURAGE flag refuses: a P2MR output is an unknown witness program
+        // (DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM), OP_CHECKMLDSA44 is OP_SUCCESS240
