+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Edge cases of the ML-DSA-44 block signature a signet requires with -signetpqblock (doc/signet-pqblock.md).
+
+An OP_TRUE signet with a node that has the rule and a pruned node that gets it late:
+
+- a pruned node that accepted a block without the signature before it upgraded cannot use
+  -reindex-chainstate; -reindex marks the block invalid, and the node takes the valid chain from a
+  peer;
+- a signed block of exactly the maximum weight is accepted and one weight unit heavier is rejected:
+  the PQ push counts as non-witness data;
+- a copy of a signed block with another witness is rejected as mutated, the block hash is not marked
+  invalid, and the block itself is accepted afterwards.
+
+The coinbases pay to a P2WSH output that a witness element of up to 520 bytes spends, so that the
+blocks above the height can carry a witness of a chosen size.
+"""
+
+import copy
+import subprocess
+
+from test_framework.blocktools import COINBASE_MATURITY, add_witness_commitment, create_block, create_coinbase
+from test_framework.messages import (
+    MAX_BLOCK_WEIGHT,
+    WITNESS_SCALE_FACTOR,
+    CBlockHeader,
+    COutPoint,
+    CTransaction,
+    CTxIn,
+    CTxInWitness,
+    CTxOut,
+    from_hex,
+    ser_uint256,
+)
+from test_framework.script import CScript, OP_DROP, OP_RETURN, OP_TRUE
+from test_framework.script_util import script_to_p2wsh_script
+from test_framework.signet_pq import (
+    WITNESS_COMMITMENT_SIZE,
+    add_signet_pq_signature,
+    signet_pq_keygen,
+    verify_signet_pq_signature,
+    witness_commitment_index,
+)
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.test_node import ErrorMatch
+from test_framework.util import assert_equal, assert_raises_rpc_error
+
+# Test key only: derived from a public string.
+PQ_PUBKEY, PQ_SECKEY = signet_pq_keygen(bytes.fromhex("11" * 32))
+
+CHALLENGE = bytes(CScript([OP_TRUE]))
+# The -signetpqblock height. The blocks above it can spend the first coinbases.
+PQ_HEIGHT = COINBASE_MATURITY
+# The coinbases pay to this witness script, which drops one witness element.
+REWARD_SCRIPT = bytes(CScript([OP_DROP, OP_TRUE]))
+REWARD_SPK = script_to_p2wsh_script(REWARD_SCRIPT)
+# The heavy blocks push at least this many bytes, where the size of the push's encoding stays the same.
+PADDING = 990_000
+
+
+def coinbase_outpoint(node, height):
+    """The REWARD_SPK output of the coinbase at height."""
+    return COutPoint(int(node.getblock(node.getblockhash(height))["tx"][0], 16), 0)
+
+
+def spend(outpoint, *, padding=0, witness_size=0):
+    """A transaction that spends a REWARD_SPK output with a witness element of witness_size bytes, into
+    an OP_RETURN output that pushes padding bytes."""
+    tx = CTransaction()
+    tx.vin = [CTxIn(outpoint)]
+    tx.vout = [CTxOut(0, CScript([OP_RETURN, bytes(padding)]))]
+    tx.wit.vtxinwit = [CTxInWitness()]
+    tx.wit.vtxinwit[0].scriptWitness.stack = [bytes(witness_size), REWARD_SCRIPT]
+    return tx
+
+
+class SignetPQBlockEdgesTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.chain = "signet"
+        self.setup_clean_chain = True
+        self.num_nodes = 2
+        self.rule = f"-signetpqblock={PQ_PUBKEY.hex()}@{PQ_HEIGHT}"
+        self.extra_args = [
+            ["-signetchallenge=51", self.rule],
+            # pruned, and without the rule until it upgrades
+            ["-signetchallenge=51", "-prune=1", "-fastprune"],
+        ]
+
+    def skip_test_if_missing_module(self):
+        self.skip_if_no_bitcoin_util()
+
+    # Blocks
+
+    def grind(self, block):
+        util_argv = self.nodes[0].binaries.util_argv() + ["grind"]
+        header = CBlockHeader.serialize(block).hex()
+        out = subprocess.run(util_argv + [header], stdout=subprocess.PIPE, check=True).stdout.strip()
+        block.nNonce = from_hex(CBlockHeader(), out.decode()).nNonce
+        return block
+
+    def true_block(self, node, txs=(), *, sign=True):
+        """A ground block on the node's tip with the transactions txs after the coinbase, signed with
+        ML-DSA-44 unless sign is False."""
+        tmpl = node.getblocktemplate({"rules": ["signet", "segwit"]})
+        coinbase = create_coinbase(tmpl["height"], script_pubkey=REWARD_SPK)
+        coinbase.vout[0].nValue = tmpl["coinbasevalue"]
+        block = create_block(tmpl=tmpl, coinbase=coinbase, txlist=list(txs))
+        add_witness_commitment(block)
+        if sign:
+            add_signet_pq_signature(block, PQ_SECKEY, CHALLENGE)
+        return self.grind(block)
+
+    def submit(self, node, block, expected=None):
+        assert_equal(node.submitblock(block.serialize().hex()), expected)
+
+    # Tests
+
+    def run_test(self):
+        self.log.info(f"Mine the {PQ_HEIGHT - 1} blocks below the height")
+        node = self.nodes[0]
+        while node.getblockcount() < PQ_HEIGHT - 1:
+            self.submit(node, self.true_block(node, sign=False))
+        self.sync_blocks()
+        self.test_pruned_late_upgrade()
+        self.test_weight_limit()
+        self.test_mutated_witness()
+
+    def test_pruned_late_upgrade(self):
+        self.log.info("A pruned node that took a block without the signature before it upgraded")
+        node, pruned = self.nodes[0], self.nodes[1]
+        assert pruned.getblockchaininfo()["pruned"]
+        # A signet node prunes nothing below height 1000 (nPruneAfterHeight), so its block files still
+        # hold every block, the one without the signature included.
+        assert_raises_rpc_error(-1, "Blockchain is too short for pruning.", pruned.pruneblockchain, PQ_HEIGHT - 1)
+        self.disconnect_nodes(0, 1)
+        parent = pruned.getbestblockhash()
+        unsigned = self.true_block(pruned, sign=False)
+        self.submit(pruned, unsigned)
+        assert_equal(pruned.getbestblockhash(), unsigned.hash_hex)
+        for _ in range(2):
+            self.submit(node, self.true_block(node))
+
+        args = self.extra_args[1] + [self.rule]
+        self.stop_node(1)
+        # Restarted with the rule, the block check at startup finds the block among the last ones.
+        pruned.assert_start_raises_init_error(args, "Corrupted block database detected", match=ErrorMatch.PARTIAL_REGEX)
+        # A pruned node cannot rebuild its chainstate alone, as doc/signet-pqblock.md says.
+        pruned.assert_start_raises_init_error(args + ["-reindex-chainstate"],
+                                              "Error: Prune mode is incompatible with -reindex-chainstate. Use full -reindex instead.")
+        # -reindex drops the undo data and rebuilds the block index from the block files, checking every
+        # block again: the one without the signature is marked invalid.
+        with pruned.assert_debug_log(["Removing unusable blk?????.dat and rev?????.dat files for -reindex with -prune",
+                                      "Reindexing finished"], timeout=60):
+            self.start_node(1, extra_args=args + ["-reindex"])
+        self.wait_until(lambda: pruned.getbestblockhash() == parent)
+        invalid = {"height": PQ_HEIGHT, "hash": unsigned.hash_hex, "branchlen": 1, "status": "invalid"}
+        assert invalid in pruned.getchaintips()
+
+        self.log.info("It then downloads the valid chain from a peer")
+        self.connect_nodes(1, 0)
+        self.sync_blocks()
+        assert_equal(pruned.getblockhash(PQ_HEIGHT), node.getblockhash(PQ_HEIGHT))
+        assert invalid in pruned.getchaintips()
+
+    def test_weight_limit(self):
+        self.log.info("A signed block of exactly the maximum weight is accepted, one weight unit heavier is rejected")
+        node = self.nodes[0]
+        outpoint = coinbase_outpoint(node, 1)
+
+        def heavy(padding, witness_size):
+            return self.true_block(node, [spend(outpoint, padding=padding, witness_size=witness_size)])
+
+        # The pushed bytes add four weight units each and the witness element's bytes one each. The
+        # ML-DSA-44 signature covers the transactions, so every block is signed after it is filled.
+        missing = MAX_BLOCK_WEIGHT - heavy(PADDING, 0).get_weight()
+        padding, witness_size = PADDING + missing // WITNESS_SCALE_FACTOR, missing % WITNESS_SCALE_FACTOR
+        exact = heavy(padding, witness_size)
+        heavier = heavy(padding, witness_size + 1)
+        assert_equal(exact.get_weight(), MAX_BLOCK_WEIGHT)
+        assert_equal(heavier.get_weight(), MAX_BLOCK_WEIGHT + 1)
+
+        # The PQ push is in a coinbase output: each of its bytes weighs four units, as non-witness data.
+        unsigned = copy.deepcopy(exact)
+        index = witness_commitment_index(unsigned)
+        unsigned.vtx[0].vout[index].scriptPubKey = bytes(unsigned.vtx[0].vout[index].scriptPubKey)[:WITNESS_COMMITMENT_SIZE]
+        assert_equal(exact.get_weight() - unsigned.get_weight(),
+                     WITNESS_SCALE_FACTOR * (len(exact.serialize()) - len(unsigned.serialize())))
+
+        self.submit(node, heavier, "bad-blk-weight")
+        self.submit(node, exact)
+        assert_equal(node.getbestblockhash(), exact.hash_hex)
+        assert_equal(node.getblock(exact.hash_hex)["weight"], MAX_BLOCK_WEIGHT)
+        self.sync_blocks()
+
+    def test_mutated_witness(self):
+        self.log.info("A copy of a signed block with another witness is rejected as mutated, then the block is accepted")
+        node = self.nodes[0]
+        block = self.true_block(node, [spend(coinbase_outpoint(node, 2), witness_size=1)])
+        tip = {"height": node.getblockcount() + 1, "hash": block.hash_hex, "branchlen": 1, "status": "headers-only"}
+
+        witnesses = {
+            "another witness reserved value": (0, [ser_uint256(1)], "bad-witness-merkle-match"),
+            "a witness reserved value of 33 bytes": (0, [bytes(33)], "bad-witness-nonce-size"),
+            "another witness element in the transaction": (1, [b"\x01", REWARD_SCRIPT], "bad-witness-merkle-match"),
+        }
+        for name, (tx_index, stack, reason) in witnesses.items():
+            self.log.debug(f"  {name}")
+            mutated = copy.deepcopy(block)
+            mutated.vtx[tx_index].wit.vtxinwit[0].scriptWitness.stack = stack
+            # Only a witness changes: the coinbase, its witness commitment included, and every other
+            # non-witness byte stay as they were. Neither the header nor the txids cover witnesses, so the
+            # copy keeps the block's hash, and its ML-DSA-44 signature stays valid: transactions enter the
+            # signed message only through their txids.
+            assert_equal(mutated.hash_hex, block.hash_hex)
+            assert verify_signet_pq_signature(mutated, PQ_PUBKEY, CHALLENGE)
+            self.submit(node, mutated, reason)
+            # The hash is not marked invalid: the node keeps the header and waits for the block.
+            assert tip in node.getchaintips()
+
+        # A copy with another PQ push no longer matches the header's merkle root. It is rejected as
+        # mutated too, before the ML-DSA-44 signature is checked.
+        mutated = copy.deepcopy(block)
+        index = witness_commitment_index(mutated)
+        script = bytearray(mutated.vtx[0].vout[index].scriptPubKey)
+        script[-1] ^= 1
+        mutated.vtx[0].vout[index].scriptPubKey = bytes(script)
+        self.submit(node, mutated, "bad-txnmrklroot")
+        assert tip in node.getchaintips()
+
+        self.submit(node, block)
+        assert_equal(node.getbestblockhash(), block.hash_hex)
+        self.sync_blocks()
+
+
+if __name__ == '__main__':
+    SignetPQBlockEdgesTest(__file__).main()
