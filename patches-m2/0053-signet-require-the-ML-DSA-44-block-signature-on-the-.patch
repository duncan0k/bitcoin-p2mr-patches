+// The Ark-0 signet has the rule without the option: from ARK0_PQ_BLOCK_HEIGHT on, by the key the
+// code fixes, whose SHA256 is published with the release.
+BOOST_AUTO_TEST_CASE(ark0)
+{
+    ArgsManager args;
+    args.ForceSetArg("-signetchallenge", "5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae");
+    std::unique_ptr<const CChainParams> params;
+    {
+        ASSERT_DEBUG_LOG("Signet blocks need an ML-DSA-44 block signature from height 20000, by the key whose SHA256 is eee8548f51f25492de3ae430b7ce7ec549edfaa663b8f577f026ce0498fdd6ad");
+        params = CreateChainParams(args, ChainType::SIGNET);
+    }
+    const Consensus::Params& consensus{params->GetConsensus()};
+    BOOST_REQUIRE(consensus.signet_pq_block);
+    BOOST_CHECK_EQUAL(consensus.signet_pq_block->height, ARK0_PQ_BLOCK_HEIGHT);
+    BOOST_CHECK_EQUAL(ARK0_PQ_BLOCK_HEIGHT, 20000);
+    std::array<unsigned char, CSHA256::OUTPUT_SIZE> key_hash;
+    CSHA256().Write(consensus.signet_pq_block->pubkey.data(), consensus.signet_pq_block->pubkey.size()).Finalize(key_hash.data());
+    BOOST_CHECK_EQUAL(HexStr(key_hash), "eee8548f51f25492de3ae430b7ce7ec549edfaa663b8f577f026ce0498fdd6ad");
+
+    // A block without a PQ push, at 19999 and at 20000.
+    const UniValue file{read_json(json_tests::signet_pqblock)};
+    const CBlock signed_block{ReadBlock(file[1]["cases"][0]["block"])};
+    const std::vector<unsigned char> script{Commitment(signed_block)};
+    const CBlock block{WithCommitment(signed_block, std::vector<unsigned char>(script.begin(), script.begin() + MINIMUM_WITNESS_COMMITMENT))};
+    BOOST_CHECK(CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << 19999 << OP_0), consensus));
+    BOOST_CHECK(!CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << 20000 << OP_0), consensus));
+    // The Ark-0 genesis block is the signet genesis block, exempt as on every signet.
+    BOOST_CHECK(CheckSignetPQBlock(params->GenesisBlock(), consensus));
+}
