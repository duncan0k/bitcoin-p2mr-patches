 src/kernel/chainparams.cpp        | 66 ++++++++++++++++++++++++++++---
 src/kernel/chainparams.h          | 10 +++++
 src/test/signet_pqblock_tests.cpp | 34 ++++++++++++++++
 4 files changed, 109 insertions(+), 6 deletions(-)

