 inline constexpr int ARK0_MLDSA44_HEIGHT{8600};
 
+/**
+ * Height from which the Ark-0 signet requires the ML-DSA-44 block signature of
+ * doc/signet-pqblock.md, by the key kernel/chainparams.cpp fixes as
+ * ARK0_PQ_BLOCK_PUBKEY (SHA256 eee8548f51f25492de3ae430b7ce7ec549edfaa663b8f577f026ce0498fdd6ad).
+ * Like ARK0_MLDSA44_HEIGHT, it is a rule of that network, fixed here rather than
+ * given by an option. Set once, when the rule was adopted on 2026-09-29; it does
+ * not change after a build carrying it has left the network's own nodes.
+ */
+inline constexpr int ARK0_PQ_BLOCK_HEIGHT{20000};
+
 /** Whether a signet challenge is the Ark-0 signet's, whose rules this code fixes. */
 bool IsArk0SignetChallenge(std::span<const uint8_t> challenge);
 
