+std::unique_ptr<const CChainParams> MakeParams(ChainType chain, const std::vector<std::pair<std::string, std::string>>& settings)
+{
+    ArgsManager args;
+    for (const auto& [name, value] : settings) args.ForceSetArg(name, value);
+    return CreateChainParams(args, chain);
+}
+
+/** Parameters with several values of one option (its name without the dash), and other settings. */
+std::unique_ptr<const CChainParams> MakeParamsMulti(const std::vector<std::string>& values, const std::string& name = "testactivationheight",
+                                                    ChainType chain = ChainType::REGTEST,
+                                                    const std::vector<std::pair<std::string, std::string>>& settings = {})
+{
+    ArgsManager args;
+    for (const auto& [setting, value] : settings) args.ForceSetArg(setting, value);
+    args.LockSettings([&](common::Settings& s) {
+        UniValue array{UniValue::VARR};
+        for (const std::string& value : values) array.push_back(value);
+        s.forced_settings[name] = array;
+    });
+    return CreateChainParams(args, chain);
+}
+
+/** A checker that counts OP_CHECKMLDSA44 verifications and finds every signature valid. */
+class CountingMLDSA44Checker : public BaseSignatureChecker
+{
+public:
+    mutable int calls{0};
+    bool CheckMLDSA44Signature(std::span<const unsigned char>, std::span<const unsigned char>, SigVersion, ScriptExecutionData&, ScriptError*) const override
+    {
+        ++calls;
+        return true;
+    }
+};
+
+void Fails(ChainType chain, const std::vector<std::pair<std::string, std::string>>& settings, const std::string& message)
+{
+    BOOST_CHECK_EXCEPTION(MakeParams(chain, settings), std::runtime_error, HasReason{message});
+}
+
+/** The NUMS ML-DSA-44 public key of doc/p2mr-lattice-tripwire.md: X = SHAKE256(DST || 0x00 || label),
+ *  rho its first 32 bytes, then t by rejection sampling of 23-bit numbers below q from the next
+ *  bytes (FIPS 204 Algorithm 14), t1 = Power2Round(t).high (Algorithm 35), pk = pkEncode(rho, t1)
+ *  (Algorithm 22). Written from the description, with mldsa-native's SHAKE256. */
+std::vector<unsigned char> NumsPubkey(std::string_view dst, std::string_view label)
+{
+    constexpr int32_t Q{8380417};
+    std::vector<unsigned char> input(dst.begin(), dst.end());
+    input.push_back(0x00);
+    input.insert(input.end(), label.begin(), label.end());
+    // More than enough output for 1024 coefficients; the rejection rate is below 0.1%.
+    std::vector<unsigned char> x(32 + 4 * 256 * 3 * 2);
+    bitcoin_mldsa_shake256(x.data(), x.size(), input.data(), input.size());
+    std::vector<unsigned char> pk(x.begin(), x.begin() + 32);
+    size_t pos{32};
+    uint64_t bits{0};
+    int nbits{0};
+    for (int i = 0; i < 4 * 256; ++i) {
+        int32_t z;
+        do {
+            BOOST_REQUIRE(pos + 3 <= x.size());
+            z = int32_t{x[pos]} + (int32_t{x[pos + 1]} << 8) + (int32_t{x[pos + 2] & 0x7f} << 16);
+            pos += 3;
+        } while (z >= Q);
+        const uint64_t t1{static_cast<uint64_t>((z + (1 << 12) - 1) >> 13)};
+        BOOST_REQUIRE(t1 < 1024);
+        bits |= t1 << nbits;
+        nbits += 10;
+        while (nbits >= 8) {
+            pk.push_back(static_cast<unsigned char>(bits & 0xff));
+            bits >>= 8;
+            nbits -= 8;
+        }
+    }
+    BOOST_REQUIRE_EQUAL(nbits, 0);
+    return pk;
+}
+
+/** The leaf S1 of an ML-DSA-44 public key: its three chunks, then OP_CHECKMLDSA44. */
+CScript S1(std::span<const unsigned char> pubkey)
+{
+    CScript s1;
+    size_t pos{0};
+    for (const size_t size : MLDSA44_PUBKEY_CHUNK_SIZES) {
+        s1 << std::vector<unsigned char>(pubkey.begin() + pos, pubkey.begin() + pos + size);
+        pos += size;
+    }
+    return s1 << OP_CHECKMLDSA44;
+}
