+BOOST_FIXTURE_TEST_SUITE(p2mr_lattice_tripwire_tests, BasicTestingSetup)
+
+// H4T and the three lattice tripwire outputs of Ark-0 are not decided: the rules stay inactive there,
+// as those of leaf version 0xe0 did before their height was set, and leaf version 0xe2 is an unknown
+// leaf version in every block. The default signet, the testnets and mainnet never activate them.
+BOOST_AUTO_TEST_CASE(ark0_inactive)
+{
+    static_assert(ARK0_LATTICE_TRIPWIRE_HEIGHT == NEVER);
+    static_assert(!ARK0_LATTICE_TRIPWIRE_CREATION_HEIGHT.has_value());
+    // The order the heights must keep once they are set (doc/p2mr-lattice-tripwire.md).
+    static_assert(ARK0_MLDSA44_HEIGHT < ARK0_PQ_BLOCK_HEIGHT && ARK0_PQ_BLOCK_HEIGHT < ARK0_TRIPWIRE_HEIGHT);
+    static_assert(ARK0_TRIPWIRE_HEIGHT < ARK0_SLHDSA128S_HEIGHT && ARK0_SLHDSA128S_HEIGHT <= ARK0_LATTICE_TRIPWIRE_HEIGHT);
+    const auto ark0{MakeParams(ChainType::SIGNET, {{"-signetchallenge", ARK0_CHALLENGE}})};
+    const Consensus::Params& consensus{ark0->GetConsensus()};
+    BOOST_CHECK_EQUAL(consensus.P2MRLatticeTripwireHeight, NEVER);
+    BOOST_CHECK(consensus.p2mr_lattice_tripwires.empty());
+    BOOST_CHECK(!DeploymentEnabled(consensus, Consensus::DEPLOYMENT_P2MR_LATTICE_TRIPWIRE));
+    // The other rules of Ark-0 are unchanged.
+    BOOST_CHECK_EQUAL(consensus.P2MRTripwireHeight, ARK0_TRIPWIRE_HEIGHT);
+    BOOST_CHECK_EQUAL(consensus.P2MRSLHDSA128SHeight, ARK0_SLHDSA128S_HEIGHT);
+    BOOST_CHECK_EQUAL(consensus.P2MRRescueHeight, ARK0_RESCUE_HEIGHT);
+
+    // No block of Ark-0 executes leaf version 0xe2 or fails ML-DSA-44 checks in it.
+    kernel::Notifications notifications{};
+    const ChainstateManager::Options chainman_opts{
+        .chainparams = *ark0,
+        .datadir = m_args.GetDataDirNet(),
+        .notifications = notifications,
+    };
+    const node::BlockManager::Options blockman_opts{
+        .chainparams = *ark0,
+        .blocks_dir = m_args.GetBlocksDirPath(),
+        .notifications = notifications,
+        .block_tree_db_params = DBParams{
+            .path = m_args.GetDataDirNet() / "blocks" / "index",
+            .cache_bytes = 1 << 20,
+            .memory_only = true,
+        },
+    };
+    ChainstateManager chainman{m_interrupt, chainman_opts, blockman_opts};
+    const uint256 hash{1};
+    CBlockIndex block;
+    block.phashBlock = &hash;
+    for (const int height : {ARK0_SLHDSA128S_HEIGHT, ARK0_RESCUE_HEIGHT, 60'000, 1'000'000}) {
+        block.nHeight = height;
+        BOOST_CHECK(!(GetBlockScriptFlags(block, chainman) & SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE));
+        CCoinsView empty;
+        CCoinsViewCache coins{&empty};
+        BOOST_CHECK(!P2MRMLDSADisabledAfter(&block, coins, chainman));
+    }
+
+    const auto never{[](const std::unique_ptr<const CChainParams>& params) {
+        BOOST_CHECK_EQUAL(params->GetConsensus().P2MRLatticeTripwireHeight, NEVER);
+        BOOST_CHECK(params->GetConsensus().p2mr_lattice_tripwires.empty());
+    }};
+    never(MakeParams(ChainType::SIGNET, {{"-signetchallenge", "51"}}));
+    never(MakeParams(ChainType::SIGNET, {}));
+    never(MakeParams(ChainType::MAIN, {}));
+    never(MakeParams(ChainType::TESTNET, {}));
+    never(MakeParams(ChainType::TESTNET4, {}));
+
+    // An Ark-0 node says so at startup (init.cpp); the node's rule list names the deployment.
+    BOOST_CHECK_EQUAL(DeploymentName(Consensus::DEPLOYMENT_P2MR_LATTICE_TRIPWIRE), "p2mr_lattice_tripwire");
+    BOOST_CHECK(GetBuriedDeployment("p2mr_lattice_tripwire") == Consensus::DEPLOYMENT_P2MR_LATTICE_TRIPWIRE);
+    static_assert(Consensus::ValidDeployment(Consensus::DEPLOYMENT_P2MR_LATTICE_TRIPWIRE));
+    static_assert(!Consensus::ValidDeployment(static_cast<Consensus::BuriedDeployment>(Consensus::DEPLOYMENT_P2MR_LATTICE_TRIPWIRE + 1)));
+}
+
+// The NUMS key of the first lattice tripwire output, computed again from its domain separation tag
+// and label with the SHAKE256 of mldsa-native, against the constant, and the P2MR output of the shape
+// the three outputs have: S1 of the key and OP_RETURN, both of version 0xc0 at depth one. The output
+// was also computed with Python's hashlib.shake_256 (the functional test framework does it again).
+BOOST_AUTO_TEST_CASE(nums_key)
+{
+    const std::vector<unsigned char> pk{NumsPubkey(P2MR_LATTICE_NUMS_DST, P2MR_LATTICE_NUMS_LABEL)};
+    BOOST_REQUIRE_EQUAL(pk.size(), MLDSA44_PUBKEY_SIZE);
+    uint256 key_hash;
+    CSHA256().Write(pk.data(), pk.size()).Finalize(key_hash.begin());
+    BOOST_CHECK_EQUAL(HexStr(key_hash), P2MR_LATTICE_NUMS_KEY_SHA256);
+    BOOST_CHECK_EQUAL(HexStr(std::span{pk}.first(8)), "8f45f006458aa1e0");
+    BOOST_CHECK_EQUAL(HexStr(std::span{pk}.last(8)), "a71c0db76c9791c0");
+
+    const uint256 root{ComputeTapbranchHash(ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, S1(pk)),
+                                            ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, CScript{} << OP_RETURN))};
+    BOOST_CHECK_EQUAL(HexStr(CScript{} << OP_2 << ToByteVector(root)), "52208fda4317667005f0a85352aeae313b38d0c4d9476a43b80b9ef64dba29c8dd56");
+
+    // Another label is another key; the label is what the constant binds.
+    const std::vector<unsigned char> other{NumsPubkey(P2MR_LATTICE_NUMS_DST, "lattice-tripwire/1")};
+    BOOST_CHECK(other != pk);
+}
+
+BOOST_AUTO_TEST_CASE(signet_options)
+{
+    const std::pair<std::string, std::string> challenge{"-signetchallenge", "51"}, m1{"-signetmldsa44", "5"},
+        m3{"-signettripwire", "10@" + OUTPOINT_D}, m4s{"-signetslhdsa128s", "12"};
+    std::unique_ptr<const CChainParams> params;
+    {
+        ASSERT_DEBUG_LOG("Signet P2MR lattice tripwire rules from height 20 in leaf version 0xe2; tripwire outputs " +
+                         OUTPOINT_A + ", " + OUTPOINT_B + ", " + OUTPOINT_C);
+        params = MakeParams(ChainType::SIGNET, {challenge, m1, m3, m4s,
+                                                {"-signetlatticetripwire", "20@" + OUTPOINT_A + "," + OUTPOINT_B + "," + OUTPOINT_C}});
+    }
+    const Consensus::Params& consensus{params->GetConsensus()};
+    BOOST_CHECK_EQUAL(consensus.P2MRLatticeTripwireHeight, 20);
+    BOOST_CHECK_EQUAL(consensus.DeploymentHeight(Consensus::DEPLOYMENT_P2MR_LATTICE_TRIPWIRE), 20);
+    BOOST_REQUIRE_EQUAL(consensus.p2mr_lattice_tripwires.size(), 3U);
+    BOOST_CHECK(consensus.p2mr_lattice_tripwires[0].outpoint == COutPoint(*Txid::FromHex(TXID_A), 0));
+    BOOST_CHECK(consensus.p2mr_lattice_tripwires[1].outpoint == COutPoint(*Txid::FromHex(TXID_B), 1));
+    BOOST_CHECK(consensus.p2mr_lattice_tripwires[2].outpoint == COutPoint(*Txid::FromHex(TXID_C), 2));
+    // An outpoint does not tell the key its output's leaf checks.
+    for (const auto& tripwire : consensus.p2mr_lattice_tripwires) BOOST_CHECK(!tripwire.key_sha256 && tripwire.label.empty());
+    // The tripwire outputs of leaf version 0xe0 are separate.
+    BOOST_REQUIRE_EQUAL(consensus.p2mr_tripwires.size(), 1U);
+    BOOST_CHECK_EQUAL(consensus.P2MRTripwireHeight, 10);
+    // The heights may coincide: OP_CHECKSLHDSA128S and the tripwire rules at the lattice height.
+    BOOST_CHECK_EQUAL(MakeParams(ChainType::SIGNET, {challenge, m1, {"-signettripwire", "20@" + OUTPOINT_D}, {"-signetslhdsa128s", "20"},
+                                                     {"-signetlatticetripwire", "20@" + OUTPOINT_A}})->GetConsensus().P2MRLatticeTripwireHeight, 20);
+
+    const std::pair<std::string, std::string> lattice{"-signetlatticetripwire", "20@" + OUTPOINT_A};
+    Fails(ChainType::SIGNET, {lattice}, "-signetlatticetripwire requires -signetchallenge.");
+    Fails(ChainType::SIGNET, {{"-signetchallenge", ARK0_CHALLENGE}, lattice},
+          "-signetlatticetripwire cannot be used on the Ark-0 signet, whose rules are fixed in the code.");
+    Fails(ChainType::SIGNET, {{"-signetchallenge", "512103ad5e0edad18cb1f0fc0d28a3d4f1f3e445640337489abb10404f2d1e086be430210359ef5021964fe22d6f8e05b2463c9540ce96883fe3b278760f048f5189f2e6c452ae"}, lattice},
+          "-signetlatticetripwire cannot be used on the default signet, whose rules are fixed in the code.");
+    Fails(ChainType::SIGNET, {challenge, lattice}, "-signetlatticetripwire requires -signetmldsa44.");
+    Fails(ChainType::SIGNET, {challenge, m1, lattice}, "-signetlatticetripwire requires -signettripwire.");
+    Fails(ChainType::SIGNET, {challenge, m1, m3, lattice}, "-signetlatticetripwire requires -signetslhdsa128s.");
+    Fails(ChainType::SIGNET, {challenge, m1, {"-signettripwire", "21@" + OUTPOINT_D}, m4s, lattice},
+          "-signetlatticetripwire height must be at or above the -signettripwire height 21, not 20.");
+    Fails(ChainType::SIGNET, {challenge, m1, m3, {"-signetslhdsa128s", "21"}, lattice},
+          "-signetlatticetripwire height must be at or above the -signetslhdsa128s height 21, not 20.");
+    for (const std::string& value : {std::string{"20"}, std::string{"20@"}, "@" + OUTPOINT_A, "x@" + OUTPOINT_A, "20@" + TXID_A, "20@" + TXID_A + ":x",
+                                     "20@" + OUTPOINT_A + ",", "20@" + OUTPOINT_A + ";" + OUTPOINT_B}) {
+        Fails(ChainType::SIGNET, {challenge, m1, m3, m4s, {"-signetlatticetripwire", value}},
+              "-signetlatticetripwire must be <height>@<txid:vout>[,<txid:vout>...], not '" + value + "'.");
+    }
+    Fails(ChainType::SIGNET, {challenge, m1, m3, m4s, {"-signetlatticetripwire", "0@" + OUTPOINT_A}},
+          "-signetlatticetripwire height must be at least 1 and below 2147483647, not 0.");
+    Fails(ChainType::SIGNET, {challenge, m1, m3, m4s, {"-signetlatticetripwire", "20@" + OUTPOINT_A + "," + OUTPOINT_A}},
+          "-signetlatticetripwire names " + OUTPOINT_A + " more than once.");
+    // Edges of the syntax: the option twice, numbers that do not fit.
+    BOOST_CHECK_EXCEPTION(MakeParamsMulti({"20@" + OUTPOINT_A, "20@" + OUTPOINT_B}, "signetlatticetripwire", ChainType::SIGNET,
+                                          {challenge, m1, m3, m4s}),
+                          std::runtime_error, HasReason{"-signetlatticetripwire cannot be multiple values."});
+    for (const std::string& value : {"2147483648@" + OUTPOINT_A, "99999999999999999999@" + OUTPOINT_A,
+                                     "20@" + TXID_A + ":4294967296", "20@" + TXID_A + ":99999999999999999999"}) {
+        Fails(ChainType::SIGNET, {challenge, m1, m3, m4s, {"-signetlatticetripwire", value}},
+              "-signetlatticetripwire must be <height>@<txid:vout>[,<txid:vout>...], not '" + value + "'.");
+    }
+    Fails(ChainType::SIGNET, {challenge, m1, m3, m4s, {"-signetlatticetripwire", "-1@" + OUTPOINT_A}},
+          "-signetlatticetripwire height must be at least 1 and below 2147483647, not -1.");
+    Fails(ChainType::SIGNET, {challenge, m1, m3, m4s, {"-signetlatticetripwire", "2147483647@" + OUTPOINT_A}},
+          "-signetlatticetripwire height must be at least 1 and below 2147483647, not 2147483647.");
+    // The largest vout is an outpoint like any other, but a null txid is refused: no output has it,
+    // and every coinbase input names it with that vout.
+    BOOST_CHECK_EQUAL(MakeParams(ChainType::SIGNET, {challenge, m1, m3, m4s, {"-signetlatticetripwire", "20@" + TXID_A + ":4294967295"}})
