+// ConnectBlock reads the state from the view it is given, the UTXO set the block builds on, not from
+// the active chain (doc/p2mr-lattice-tripwire.md), in the same place as the state of the tripwire of
+// leaf version 0xe0. This code base has no ML-DSA-44 signer: an OP_CHECKMLDSA44 spend with a signature
+// of the right shape that is not valid fails as an invalid signature while the checks are enabled and
+// as disabled once they are, which tells the two states apart; a Schnorr spend of leaf version 0xe2
+// passes in both, since the elliptic curve checks follow the other tripwire.
+BOOST_FIXTURE_TEST_CASE(state_from_view, UncreatedLatticeTripwireSetup)
+{
+    ChainstateManager& chainman{*m_node.chainman};
+    const Consensus::Params& params{chainman.GetConsensus()};
+    BOOST_REQUIRE_EQUAL(params.p2mr_lattice_tripwires.size(), 1U);
+    BOOST_REQUIRE(params.p2mr_tripwires.empty());
+    const COutPoint tripwire{params.p2mr_lattice_tripwires[0].outpoint};
+
+    // A P2MR output of three leaves at depth two or one, <key> OP_CHECKSIG and S1 of version 0xe2,
+    // and OP_RETURN, funded in block 101.
+    const XOnlyPubKey key{coinbaseKey.GetPubKey()};
+    const CScript csig_leaf{CScript{} << ToByteVector(key) << OP_CHECKSIG};
+    const std::vector<unsigned char> pq_key(MLDSA44_PUBKEY_SIZE, 0x42);
+    const CScript s1_leaf{S1(pq_key)};
+    const uint256 csig_hash{ComputeTapleafHash(P2MR_LEAF_LATTICE_TRIPWIRED, csig_leaf)};
+    const uint256 s1_hash{ComputeTapleafHash(P2MR_LEAF_LATTICE_TRIPWIRED, s1_leaf)};
+    const uint256 fail_hash{ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, CScript{} << OP_RETURN)};
+    const uint256 pair_hash{ComputeTapbranchHash(csig_hash, s1_hash)};
+    const CScript script_pubkey{CScript{} << OP_2 << ToByteVector(ComputeTapbranchHash(pair_hash, fail_hash))};
+    const CMutableTransaction funding{CreateValidMempoolTransaction(m_coinbase_txns[0], 0, /*input_height=*/1, coinbaseKey,
+                                                                    script_pubkey, 1 * COIN, /*submit=*/false)};
+    CreateAndProcessBlock({funding}, CScript{} << OP_TRUE);
+    const CMutableTransaction funding2{CreateValidMempoolTransaction(m_coinbase_txns[1], 0, /*input_height=*/2, coinbaseKey,
+                                                                     script_pubkey, 1 * COIN, /*submit=*/false)};
+    CreateAndProcessBlock({funding2}, CScript{} << OP_TRUE);
+
+    const auto control_for{[&](const uint256& sibling) {
+        std::vector<unsigned char> control{static_cast<unsigned char>(P2MR_LEAF_LATTICE_TRIPWIRED | 1)};
+        control.insert(control.end(), sibling.begin(), sibling.end());
+        control.insert(control.end(), fail_hash.begin(), fail_hash.end());
+        return control;
+    }};
+
+    // The ML-DSA-44 spend of the first output: five chunks of the right sizes.
+    CMutableTransaction pq_spend;
+    pq_spend.vin.emplace_back(COutPoint{funding.GetHash(), 0});
+    pq_spend.vout.emplace_back(funding.vout[0].nValue - 1000, CScript{} << OP_TRUE);
+    std::vector<std::vector<unsigned char>> stack;
+    for (const size_t size : MLDSA44_SIG_CHUNK_SIZES) stack.emplace_back(size, 0x01);
+    stack.emplace_back(s1_leaf.begin(), s1_leaf.end());
+    stack.push_back(control_for(csig_hash));
+    pq_spend.vin[0].scriptWitness.stack = stack;
+
+    // The Schnorr spend of the second output.
+    CMutableTransaction ec_spend;
+    ec_spend.vin.emplace_back(COutPoint{funding2.GetHash(), 0});
+    ec_spend.vout.emplace_back(funding2.vout[0].nValue - 1000, CScript{} << OP_TRUE);
+    PrecomputedTransactionData txdata;
+    txdata.Init(ec_spend, {funding2.vout[0]}, /*force=*/true);
+    ScriptExecutionData execdata;
+    execdata.m_annex_init = true;
+    execdata.m_annex_present = false;
+    execdata.m_tapleaf_hash = csig_hash;
+    execdata.m_tapleaf_hash_init = true;
+    execdata.m_codeseparator_pos = 0xFFFFFFFF;
+    execdata.m_codeseparator_pos_init = true;
+    uint256 sighash;
+    BOOST_REQUIRE(SignatureHashSchnorr(sighash, execdata, ec_spend, 0, SIGHASH_DEFAULT, SigVersion::TAPSCRIPT, txdata, MissingDataBehavior::FAIL));
+    std::vector<unsigned char> sig(64);
+    BOOST_REQUIRE(coinbaseKey.SignSchnorr(sighash, sig, /*merkle_root=*/nullptr, /*aux=*/uint256{}));
+    ec_spend.vin[0].scriptWitness.stack = {sig, std::vector<unsigned char>(csig_leaf.begin(), csig_leaf.end()), control_for(s1_hash)};
+
+    const CBlock pq_block{CreateBlock({pq_spend}, CScript{} << OP_TRUE, chainman.ActiveChainstate())};
+    const CBlock ec_block{CreateBlock({ec_spend}, CScript{} << OP_TRUE, chainman.ActiveChainstate())};
+
+    LOCK(cs_main);
+    Chainstate& chainstate{chainman.ActiveChainstate()};
+    CBlockIndex* tip{chainstate.m_chain.Tip()};
+    BOOST_REQUIRE_EQUAL(tip->nHeight, 102);
+    const auto connect{[&](const CBlock& block, CCoinsViewCache& view, BlockValidationState& state) {
+        // As TestBlockValidity checks a block: on a dummy index, with a cache on top of the coins.
+        const uint256 hash{block.GetHash()};
+        CBlockIndex index{block};
+        index.pprev = tip;
+        index.nHeight = tip->nHeight + 1;
+        index.phashBlock = &hash;
+        return chainstate.ConnectBlock(block, state, &index, view, /*fJustCheck=*/true);
+    }};
+
+    // In a view where the lattice tripwire output is present, created below the height and unspent,
+    // the ML-DSA-44 check runs and finds the signature invalid; the Schnorr spend is valid.
+    {
+        CCoinsViewCache view{&chainstate.CoinsTip()};
+        view.AddCoin(tripwire, Coin{CTxOut{1000, CScript{} << OP_TRUE}, 1, false}, /*possible_overwrite=*/false);
+        BOOST_REQUIRE(!P2MRMLDSADisabledAfter(tip, view, chainman));
+        BlockValidationState state;
+        BOOST_CHECK(!connect(pq_block, view, state));
+        BOOST_CHECK_EQUAL(state.GetRejectReason(), "block-script-verify-flag-failed (Invalid ML-DSA-44 signature)");
+    }
+    {
+        CCoinsViewCache view{&chainstate.CoinsTip()};
+        view.AddCoin(tripwire, Coin{CTxOut{1000, CScript{} << OP_TRUE}, 1, false}, /*possible_overwrite=*/false);
+        BlockValidationState state;
+        BOOST_CHECK_MESSAGE(connect(ec_block, view, state), state.ToString());
+    }
+    // In the active chain's, where it is missing, the same ML-DSA-44 spend fails as disabled, before
+    // the signature is looked at; the Schnorr spend in leaf version 0xe2 is still valid.
+    {
+        CCoinsViewCache view{&chainstate.CoinsTip()};
+        BOOST_REQUIRE(P2MRMLDSADisabledAfter(tip, view, chainman));
+        BlockValidationState state;
+        BOOST_CHECK(!connect(pq_block, view, state));
+        BOOST_CHECK_EQUAL(state.GetRejectReason(), "block-script-verify-flag-failed (ML-DSA-44 signature checks are disabled in this leaf)");
+    }
+    {
+        CCoinsViewCache view{&chainstate.CoinsTip()};
+        BlockValidationState state;
+        BOOST_CHECK_MESSAGE(connect(ec_block, view, state), state.ToString());
+    }
+}
