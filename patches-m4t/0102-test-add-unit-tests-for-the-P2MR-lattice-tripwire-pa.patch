+// Once ML-DSA-44 is disabled, a check with a non-empty signature in leaf version 0xe2 fails before the
+// verifier is called; elsewhere, and with the checks enabled, the verifier runs once.
+BOOST_AUTO_TEST_CASE(no_verification_once_disabled)
+{
+    using valtype = std::vector<unsigned char>;
+    const valtype pq_key(MLDSA44_PUBKEY_SIZE, 0x42);
+    const CScript s1{S1(pq_key)};
+    const auto run{[&](uint8_t leaf_version, script_verify_flags extra, const valtype& first_chunk) {
+        const uint256 leaf_hash{ComputeTapleafHash(leaf_version, s1)};
+        const uint256 fail_hash{ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, CScript{} << OP_RETURN)};
+        valtype control{static_cast<unsigned char>(leaf_version | 1)};
+        control.insert(control.end(), fail_hash.begin(), fail_hash.end());
+        const CScript spk{CScript{} << OP_2 << ToByteVector(ComputeTapbranchHash(leaf_hash, fail_hash))};
+        CScriptWitness witness;
+        for (size_t i = 0; i < MLDSA44_SIG_CHUNK_SIZES.size(); ++i) witness.stack.emplace_back(MLDSA44_SIG_CHUNK_SIZES[i], 0x01);
+        witness.stack[0] = first_chunk;
+        witness.stack.emplace_back(s1.begin(), s1.end());
+        witness.stack.push_back(control);
+        const CountingMLDSA44Checker checker;
+        ScriptError err;
+        VerifyScript(CScript{}, spk, &witness, SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_P2MR | SCRIPT_VERIFY_P2MR_MLDSA44 |
+                                                   SCRIPT_VERIFY_P2MR_TRIPWIRE | SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE | extra,
+                     checker, &err);
+        return std::pair{checker.calls, err};
+    }};
+    const valtype chunk(MLDSA44_SIG_CHUNK_SIZES[0], 0x01);
+    BOOST_CHECK(run(P2MR_LEAF_LATTICE_TRIPWIRED, SCRIPT_VERIFY_NONE, chunk) == std::pair(1, SCRIPT_ERR_OK));
+    BOOST_CHECK(run(P2MR_LEAF_LATTICE_TRIPWIRED, SCRIPT_VERIFY_P2MR_MLDSA_DISABLED, chunk) == std::pair(0, SCRIPT_ERR_P2MR_MLDSA_DISABLED));
+    // A chunk of the wrong size too: the size is not looked at either.
+    BOOST_CHECK(run(P2MR_LEAF_LATTICE_TRIPWIRED, SCRIPT_VERIFY_P2MR_MLDSA_DISABLED, valtype(7, 0x01)) == std::pair(0, SCRIPT_ERR_P2MR_MLDSA_DISABLED));
+    BOOST_CHECK(run(P2MR_LEAF_LATTICE_TRIPWIRED, SCRIPT_VERIFY_P2MR_EC_DISABLED, chunk) == std::pair(1, SCRIPT_ERR_OK));
+    for (const uint8_t leaf_version : {TAPROOT_LEAF_TAPSCRIPT, P2MR_LEAF_TRIPWIRED}) {
+        BOOST_CHECK(run(leaf_version, SCRIPT_VERIFY_P2MR_MLDSA_DISABLED, chunk) == std::pair(1, SCRIPT_ERR_OK));
+    }
+}
