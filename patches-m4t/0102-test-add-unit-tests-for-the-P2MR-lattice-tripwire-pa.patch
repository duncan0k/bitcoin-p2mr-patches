+// The two flags take bits 27 and 28, after M4-S's 25 and M4-R's 26 (doc/p2mr-lattice-tripwire.md).
+BOOST_AUTO_TEST_CASE(flag_bits)
+{
+    static_assert(static_cast<int>(script_verify_flag_name::SCRIPT_VERIFY_P2MR_SLHDSA128S) == 25);
+    static_assert(static_cast<int>(script_verify_flag_name::SCRIPT_VERIFY_P2MR_NO_RESCUE) == 26);
+    static_assert(static_cast<int>(script_verify_flag_name::SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE) == 27);
+    static_assert(static_cast<int>(script_verify_flag_name::SCRIPT_VERIFY_P2MR_MLDSA_DISABLED) == 28);
+    static_assert(MAX_SCRIPT_VERIFY_FLAGS_BITS == 29);
+    BOOST_CHECK_EQUAL(script_verify_flags{SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE}.as_int(), uint64_t{1} << 27);
+    BOOST_CHECK_EQUAL(script_verify_flags{SCRIPT_VERIFY_P2MR_MLDSA_DISABLED}.as_int(), uint64_t{1} << 28);
+}
