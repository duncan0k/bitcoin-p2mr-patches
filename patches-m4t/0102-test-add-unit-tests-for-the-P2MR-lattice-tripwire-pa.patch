+const std::string TXID_B(64, 'b');
+const std::string TXID_C(64, 'c');
+const std::string TXID_D(64, 'd');
+const std::string OUTPOINT_A{TXID_A + ":0"};
+const std::string OUTPOINT_B{TXID_B + ":1"};
+const std::string OUTPOINT_C{TXID_C + ":2"};
+const std::string OUTPOINT_D{TXID_D + ":0"};
