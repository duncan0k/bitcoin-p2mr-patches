+// The log of lattice tripwire spends skips the coinbase, whose input names the null outpoint.
+// -signetlatticetripwire refuses that outpoint, so the parameters are made directly.
+BOOST_FIXTURE_TEST_CASE(coinbase_not_logged, TestChain100Setup)
+{
+    CChainParams::RegTestOptions options;
+    options.lattice_tripwire = CChainParams::TripwireOptions{.height = 1, .outpoints = {COutPoint{}}};
+    const auto params{CChainParams::RegTest(options)};
+    BOOST_REQUIRE(params->GetConsensus().p2mr_lattice_tripwires.at(0).outpoint.IsNull());
+    m_node.validation_signals->SyncWithValidationInterfaceQueue();
+    m_node.chainman.reset();
+    {
+        const ChainstateManager::Options chainman_opts{
+            .chainparams = *params,
+            .datadir = m_args.GetDataDirNet(),
+            .notifications = *m_node.notifications,
+            .signals = m_node.validation_signals.get(),
+        };
+        const node::BlockManager::Options blockman_opts{
+            .chainparams = *params,
+            .blocks_dir = m_args.GetBlocksDirPath(),
+            .notifications = *m_node.notifications,
+            .block_tree_db_params = DBParams{
+                .path = m_args.GetDataDirNet() / "blocks" / "index2",
+                .cache_bytes = 1 << 20,
+                .memory_only = true,
+            },
+        };
+        m_node.chainman = std::make_unique<ChainstateManager>(*Assert(m_node.shutdown_signal), chainman_opts, blockman_opts);
+    }
+    LoadVerifyActivateChainstate();
+    int spent_lines{0};
+    {
+        DebugLogHelper spent{"P2MR lattice tripwire ", [&](const std::string* line) {
+            if (line && line->find(" spent by ") != std::string::npos) ++spent_lines;
+            return false;
+        }};
+        for (int i = 0; i < 3; ++i) CreateAndProcessBlock({}, CScript{} << OP_TRUE);
+    }
+    BOOST_CHECK_EQUAL(WITH_LOCK(cs_main, return m_node.chainman->ActiveHeight()), 3);
+    BOOST_CHECK_EQUAL(spent_lines, 0);
+    m_node.validation_signals->SyncWithValidationInterfaceQueue();
+    m_node.chainman.reset();
+}
