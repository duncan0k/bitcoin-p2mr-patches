+// Relay policy (doc/p2mr-lattice-tripwire.md): IsWitnessStandard treats leaf version 0xe2 as 0xc0 and
+// 0xe0, at every height and at depth zero too, with the 80-byte limit and the exceptions of templates
+// S1 and SLH1; S2 is not a template there. The rescue template R1 is of leaf version 0xe0 only.
+BOOST_AUTO_TEST_CASE(witness_standard)
+{
+    using valtype = std::vector<unsigned char>;
+    // A transaction spending one P2MR output whose tree holds `leaf` at depth one next to OP_RETURN,
+    // or alone at depth zero.
+    const auto standard{[](const CScript& leaf, uint8_t leaf_version, std::vector<valtype> stack, bool depth_one = true,
+                           std::optional<valtype> annex = std::nullopt) {
+        const uint256 leaf_hash{ComputeTapleafHash(leaf_version, leaf)};
+        const uint256 fail_hash{ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, CScript{} << OP_RETURN)};
+        valtype control{static_cast<unsigned char>(leaf_version | 1)};
+        if (depth_one) control.insert(control.end(), fail_hash.begin(), fail_hash.end());
+        const uint256 root{depth_one ? ComputeTapbranchHash(leaf_hash, fail_hash) : leaf_hash};
+        const CTxOut spent{10000, CScript{} << OP_2 << ToByteVector(root)};
+        CMutableTransaction tx;
+        tx.vin.emplace_back(COutPoint{Txid::FromUint256(uint256::ONE), 0});
+        tx.vout.emplace_back(9000, CScript{} << OP_TRUE);
+        stack.emplace_back(leaf.begin(), leaf.end());
+        stack.push_back(control);
+        if (annex) stack.push_back(*annex);
+        tx.vin[0].scriptWitness.stack = stack;
+        CCoinsView empty;
+        CCoinsViewCache view{&empty};
+        view.AddCoin(tx.vin[0].prevout, Coin{spent, 1, false}, false);
+        return IsWitnessStandard(CTransaction{tx}, view);
+    }};
+    const valtype pq_key(MLDSA44_PUBKEY_SIZE, 0x42);
+    const valtype xonly(32, 0x07);
+    const valtype slh_key(SLHDSA128S_PUBKEY_SIZE, 0x09);
+    std::vector<valtype> pq_chunks;
+    for (const size_t size : MLDSA44_SIG_CHUNK_SIZES) pq_chunks.emplace_back(size, 0x01);
+    std::vector<valtype> slh_chunks;
+    for (const size_t size : SLHDSA128S_SIG_CHUNK_SIZES) slh_chunks.emplace_back(size, 0x01);
+    const CScript s1{S1(pq_key)};
+    const CScript s2{CScript{s1} << OP_VERIFY << xonly << OP_CHECKSIG};
+    const CScript slh1{CScript{} << slh_key << OP_CHECKSLHDSA128S};
+    std::vector<valtype> s2_stack{valtype(64, 0x03)};
+    s2_stack.insert(s2_stack.end(), pq_chunks.begin(), pq_chunks.end());
+
+    for (const uint8_t leaf_version : {TAPROOT_LEAF_TAPSCRIPT, P2MR_LEAF_TRIPWIRED, P2MR_LEAF_LATTICE_TRIPWIRED}) {
+        BOOST_TEST_CONTEXT("leaf version " << int{leaf_version}) {
+            BOOST_CHECK(standard(s1, leaf_version, pq_chunks));
+            BOOST_CHECK(standard(slh1, leaf_version, slh_chunks));
+            // S2 is a template in 0xc0 and 0xe0, not in 0xe2, whatever its elements.
+            BOOST_CHECK_EQUAL(standard(s2, leaf_version, s2_stack), leaf_version != P2MR_LEAF_LATTICE_TRIPWIRED);
+            BOOST_CHECK_EQUAL(standard(s2, leaf_version, {valtype{}, valtype{}, valtype{}, valtype{}, valtype{}, valtype{}}),
+                              leaf_version != P2MR_LEAF_LATTICE_TRIPWIRED);
+            // The 80-byte limit, at depth one and at depth zero. At depth zero it holds for 0xe2 at every
+            // height, before the rules activate too, as for 0xe0 (rule 4T-4): a policy change from a node
+            // without this series, which relays such a spend.
+            const CScript drop{CScript{} << OP_DROP << OP_1};
+            BOOST_CHECK(standard(drop, leaf_version, {valtype(80, 0x01)}));
+            BOOST_CHECK(!standard(drop, leaf_version, {valtype(81, 0x01)}));
+            BOOST_CHECK(standard(drop, leaf_version, {valtype(80, 0x01)}, /*depth_one=*/false));
+            BOOST_CHECK(!standard(drop, leaf_version, {valtype(81, 0x01)}, /*depth_one=*/false));
+            // A leaf with OP_CHECKMLDSA44 that is no template.
+            BOOST_CHECK(!standard(CScript{s1} << OP_VERIFY << OP_1, leaf_version, pq_chunks));
+            // An annex.
+            BOOST_CHECK(!standard(drop, leaf_version, {valtype(1, 0x01)}, true, valtype{ANNEX_TAG}));
+        }
+    }
+    // A leaf version that is not executed has no limit at all.
+    BOOST_CHECK(standard(CScript{} << OP_DROP << OP_1, 0xe4, {valtype(81, 0x01)}));
+
+    // Template R1, the rescue template: token, <key> OP_CHECKSIG, a control block, a rescue record. A
+    // rescue spend from a leaf of version 0xe2 is valid in a block, but not standard: its annex is not.
+    const std::string k{"ark0-wallet v1 schnorr"};
+    valtype token{P2MR_RESCUE_KEY_VERSION, P2MR_RESCUE_STATEMENT_HMAC, static_cast<unsigned char>(k.size())};
+    token.insert(token.end(), k.begin(), k.end());
+    token.push_back(0x00);
+    token.insert(token.end(), 32, 0x11);
+    BOOST_REQUIRE(IsP2MRRescueToken(token));
+    valtype record{ANNEX_TAG, 0x01};
+    record.resize(2 + *P2MRRescueProofSize(P2MR_RESCUE_STATEMENT_HMAC), 0x00);
+    BOOST_REQUIRE(IsP2MRRescueAnnex(record, P2MR_RESCUE_STATEMENT_HMAC));
+    const CScript csig{CScript{} << xonly << OP_CHECKSIG};
+    BOOST_CHECK(standard(csig, P2MR_LEAF_TRIPWIRED, {token}, true, record));
+    BOOST_CHECK(!standard(csig, P2MR_LEAF_LATTICE_TRIPWIRED, {token}, true, record));
+}
