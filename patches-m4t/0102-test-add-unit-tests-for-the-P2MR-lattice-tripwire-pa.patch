+// SHAKE256 of the vendored mldsa-native (src/crypto/mldsa44/, the FIPS 202 code ML-DSA-44 verification
+// uses), which src/crypto/mldsa44/bitcoin_mldsa44_config.h names with the prefix bitcoin_mldsa. The node
+// never calls it: only this test, to compute the NUMS key of the lattice tripwire again.
+extern "C" void bitcoin_mldsa_shake256(uint8_t* out, size_t outlen, const uint8_t* in, size_t inlen);
+
+namespace {
+constexpr int NEVER{std::numeric_limits<int>::max()};
+const std::string ARK0_CHALLENGE{"5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae"};
