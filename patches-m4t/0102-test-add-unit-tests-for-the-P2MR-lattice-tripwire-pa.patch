+// A lattice tripwire output is present while it is unspent and was created below the height of the
+// lattice rules, not of the tripwire rules of leaf version 0xe0; from that height on, a missing one
+// makes ML-DSA-44 checks in leaf version 0xe2 fail. The two tripwires are independent.
+BOOST_FIXTURE_TEST_CASE(state, LatticeTripwireTestingSetup)
+{
+    const ChainstateManager& chainman{*m_node.chainman};
+    const Consensus::Params& params{chainman.GetConsensus()};
+    BOOST_REQUIRE_EQUAL(params.P2MRTripwireHeight, 100);
+    BOOST_REQUIRE_EQUAL(params.P2MRLatticeTripwireHeight, 200);
+    BOOST_REQUIRE_EQUAL(params.p2mr_lattice_tripwires.size(), 3U);
+    const COutPoint a{params.p2mr_lattice_tripwires[0].outpoint};
+    const COutPoint b{params.p2mr_lattice_tripwires[1].outpoint};
+    const COutPoint c{params.p2mr_lattice_tripwires[2].outpoint};
+    const COutPoint d{params.p2mr_tripwires[0].outpoint};
+
+    // Tips whose next block is just below the height, and at it.
+    CBlockIndex below;
+    below.nHeight = 198;
+    CBlockIndex at;
+    at.nHeight = 199;
+
+    CCoinsView empty;
+    CCoinsViewCache coins{&empty};
+    const auto describe{[&](const std::string& sa, const std::string& sb, const std::string& sc, const std::string& checks) {
+        return strprintf("lattice tripwire outputs %s:0 %s, %s:1 %s, %s:2 %s; ML-DSA-44 checks in leaf version 0xe2 are %s for the next block",
+                         TXID_A, sa, TXID_B, sb, TXID_C, sc, checks);
+    }};
+
+    // Outputs that were never created are missing: the rules fail closed, from their height on.
+    BOOST_CHECK(!IsP2MRTripwirePresent(coins, a, params.P2MRLatticeTripwireHeight));
+    BOOST_CHECK(!P2MRMLDSADisabledAfter(&below, coins, chainman));
+    BOOST_CHECK(P2MRMLDSADisabledAfter(&at, coins, chainman));
+    BOOST_CHECK_EQUAL(DescribeP2MRLatticeTripwireState(&at, coins, chainman), describe("missing", "missing", "missing", "disabled"));
+
+    // Created below the lattice height and unspent, they are present, also when created at or above
+    // the height of the tripwire rules of leaf version 0xe0, whose cutoff is not theirs.
+    const CTxOut output{1000, CScript{} << OP_TRUE};
+    coins.AddCoin(a, Coin{output, 50, false}, false);
+    coins.AddCoin(b, Coin{output, 150, false}, false);
+    coins.AddCoin(c, Coin{output, 199, false}, false);
+    BOOST_CHECK(IsP2MRTripwirePresent(coins, b, params.P2MRLatticeTripwireHeight));
+    BOOST_CHECK(!IsP2MRTripwirePresent(coins, b, params.P2MRTripwireHeight));
+    BOOST_CHECK(!P2MRMLDSADisabledAfter(&at, coins, chainman));
+    BOOST_CHECK_EQUAL(DescribeP2MRLatticeTripwireState(&at, coins, chainman), describe("unspent", "unspent", "unspent", "enabled"));
+
+    // The tripwire output of leaf version 0xe0 is missing: elliptic curve checks fail, ML-DSA-44 ones
+    // do not.
+    BOOST_CHECK(P2MRECDisabledAfter(&at, coins, chainman));
+    BOOST_CHECK(!P2MRMLDSADisabledAfter(&at, coins, chainman));
+    // And the other way round.
+    coins.AddCoin(d, Coin{output, 99, false}, false);
+    BOOST_CHECK(!P2MRECDisabledAfter(&at, coins, chainman));
+    BOOST_CHECK(coins.SpendCoin(c));
+    BOOST_CHECK(P2MRMLDSADisabledAfter(&at, coins, chainman));
+    BOOST_CHECK(!P2MRECDisabledAfter(&at, coins, chainman));
+    // Any one of the three is enough, from the height on.
+    BOOST_CHECK(!P2MRMLDSADisabledAfter(&below, coins, chainman));
+    BOOST_CHECK_EQUAL(DescribeP2MRLatticeTripwireState(&at, coins, chainman), describe("unspent", "unspent", "missing", "disabled"));
+    coins.AddCoin(c, Coin{output, 199, false}, false);
+    BOOST_CHECK(coins.SpendCoin(a));
+    BOOST_CHECK(P2MRMLDSADisabledAfter(&at, coins, chainman));
+    coins.AddCoin(a, Coin{output, 50, false}, false);
+    BOOST_CHECK(coins.SpendCoin(b));
+    BOOST_CHECK(P2MRMLDSADisabledAfter(&at, coins, chainman));
+
+    // Created again at the height or above, as after a deep reorganization, it stays missing.
+    coins.AddCoin(b, Coin{output, 200, false}, false);
+    BOOST_CHECK(!IsP2MRTripwirePresent(coins, b, params.P2MRLatticeTripwireHeight));
+    BOOST_CHECK(P2MRMLDSADisabledAfter(&at, coins, chainman));
+
+    // Only the output created below the height counts again; with two missing, bringing back one
+    // keeps the checks disabled.
+    BOOST_CHECK(coins.SpendCoin(b));
+    BOOST_CHECK(coins.SpendCoin(c));
+    coins.AddCoin(b, Coin{output, 150, false}, false);
+    BOOST_CHECK(P2MRMLDSADisabledAfter(&at, coins, chainman));
+    coins.AddCoin(c, Coin{output, 10, false}, false);
+    BOOST_CHECK(!P2MRMLDSADisabledAfter(&at, coins, chainman));
+}
