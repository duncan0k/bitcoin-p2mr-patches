+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Helpers for P2MR leaf version 0xe2 and its lattice tripwire outputs (doc/p2mr-lattice-tripwire.md).
+
+From the height of the P2MR lattice tripwire rules, a P2MR leaf of leaf version 0xe2 at depth
+one or more executes as one of leaf version 0xc0 does; its elliptic curve checks follow the
+tripwire of leaf version 0xe0. Once a lattice tripwire output is missing from the UTXO set a
+block builds on, OP_CHECKMLDSA44 with a non-empty signature in such a leaf fails the script,
+from that block on; OP_CHECKSLHDSA128S is unaffected.
+
+    lattice tripwire output:  S1 of an ML-DSA-44 key and OP_RETURN, both leaf version 0xc0 at depth one
+    pq2:                      S1 and SLH1, both leaf version 0xe2 at depth one
+
+The control block of a leaf of version 0xe2 starts with 0xe3.
+"""
+
+import hashlib
+
+from .p2mr import p2mr_construct
+from .p2mr_mldsa44 import mldsa44_leaf, mldsa44_sig_chunks, mldsa44_sign_input
+from .p2mr_slhdsa128s import slhdsa128s_leaf, slhdsa128s_sig_chunks, slhdsa128s_sign_input
+from .script import CScript, OP_RETURN
+
+# The leaf version of the rules.
+LEAF_VERSION_LATTICE_TRIPWIRED = 0xe2
+# The script error of an ML-DSA-44 check with a non-empty signature in such a leaf once a lattice
+# tripwire output is missing.
+MLDSA_DISABLED_ERROR = "ML-DSA-44 signature checks are disabled in this leaf"
+# The NUMS key of the first lattice tripwire output.
+NUMS_DST = b"MLDSA44-NUMS/v1"
+NUMS_LABEL = b"lattice-tripwire/0"
+NUMS_KEY_SHA256 = "591dae318a0fdde81a590eab8c8581e07657d2c30b97cf31d87bafe636c92805"
+MLDSA44_Q = 8380417
+
+
+def nums_pubkey(dst=NUMS_DST, label=NUMS_LABEL):
+    """The NUMS ML-DSA-44 public key: X = SHAKE256(dst || 0x00 || label), rho its first 32 bytes, t by
+    rejection sampling of 23-bit numbers below q (FIPS 204 Algorithm 14), t1 = Power2Round(t).high
+    (Algorithm 35), pk = pkEncode(rho, t1) (Algorithm 22). With hashlib's SHAKE256."""
+    x = hashlib.shake_256(dst + b"\x00" + label).digest(32 + 4 * 256 * 3 * 2)
+    rho, pos, t1 = x[:32], 32, []
+    while len(t1) < 4 * 256:
+        z = x[pos] + 256 * x[pos + 1] + 65536 * (x[pos + 2] & 0x7f)
+        pos += 3
+        if z < MLDSA44_Q:
+            t1.append((z + (1 << 12) - 1) >> 13)
+    bits = n = 0
+    packed = bytearray()
+    for c in t1:
+        bits |= c << n
+        n += 10
+        while n >= 8:
+            packed.append(bits & 0xff)
+            bits >>= 8
+            n -= 8
+    pk = rho + bytes(packed)
+    assert len(pk) == 1312
+    return pk
+
+
+def lattice_tripwire_tree(pq_pubkey):
+    """A lattice tripwire output: S1 of the key and OP_RETURN, both leaf version 0xc0 at depth one."""
+    return p2mr_construct([("pq", mldsa44_leaf(pq_pubkey)), ("fail", CScript([OP_RETURN]))])
+
+
+def pq2_tree(pq_pubkey, slh_pubkey, leaf_ver=LEAF_VERSION_LATTICE_TRIPWIRED):
+    """pq2: S1 and SLH1, both of leaf version leaf_ver (0xe2 by default) at depth one."""
+    return p2mr_construct([("pq", mldsa44_leaf(pq_pubkey), leaf_ver), ("slh", slhdsa128s_leaf(slh_pubkey), leaf_ver)])
+
+
+def slhdsa128s_leaf_witness(seckey, leaf, tx, spent_utxos, input_index):
+    """The witness that spends an SLH-DSA leaf SLH1: sixteen signature chunks, the script, the control block."""
+    sig = slhdsa128s_sign_input(seckey, tx, spent_utxos, input_index, leaf.script, leaf_ver=leaf.leaf_ver)
+    return slhdsa128s_sig_chunks(sig) + [bytes(leaf.script), leaf.control_block]
+
+
+def mldsa44_any_leaf_witness(seckey, leaf, tx, spent_utxos, input_index, *, stack_below=()):
+    """The witness that spends a leaf with one OP_CHECKMLDSA44 check, with `stack_below` under the five
+    signature chunks."""
+    sig = mldsa44_sign_input(seckey, tx, spent_utxos, input_index, leaf.script, leaf_ver=leaf.leaf_ver)
+    return list(stack_below) + mldsa44_sig_chunks(sig) + [bytes(leaf.script), leaf.control_block]
