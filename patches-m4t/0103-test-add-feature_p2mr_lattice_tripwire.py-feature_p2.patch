new file mode 100644
index 0000000..cf2fc19
--- /dev/null
+++ b/test/functional/feature_p2mr_lattice_tripwire_storage.py
@@ -0,0 +1,333 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test the P2MR lattice tripwire rules with assumeutxo and with pruning (doc/p2mr-lattice-tripwire.md).
+
+What feature_p2mr_tripwire.py does for leaf version 0xe0, for leaf version 0xe2. The state the rules
+decide on, whether a lattice tripwire output is missing from the UTXO set, comes from the chainstate's
+own UTXO set, not from block data and not from another chainstate.
+
+  node 0  builds the chain up to the regtest assumeutxo snapshot at 299 exactly as
+          feature_assumeutxo.py does, before any other node; then the rules for the pruning part
+  node 1  loads that snapshot with a lattice tripwire output that block 200, below the snapshot,
+          spends, and validates blocks 200 to 299 in the background
+  node 2  pruned (-fastprune -prune=1), with the rules of node 0 for the pruning part
+
+The blocks up to 299 are fixed by the snapshot's hash, so they hold no spend of a 0xe2 leaf: what the
+background chainstate decides there shows only in what it logs and in finishing without a fault. The
+unit test p2mr_lattice_tripwire_tests/state_from_view shows that ConnectBlock reads the state from the
+view it is given.
+"""
+
+import hashlib
+
+from test_framework.blocktools import add_witness_commitment, create_block, create_coinbase
+from test_framework.messages import COIN, COutPoint, CTransaction, CTxIn, CTxInWitness, CTxOut
+from test_framework.p2mr_lattice_tripwire import (
+    MLDSA_DISABLED_ERROR,
+    lattice_tripwire_tree,
+    mldsa44_any_leaf_witness,
+    pq2_tree,
+    slhdsa128s_leaf_witness,
+)
+from test_framework.p2mr_mldsa44 import mldsa44_keygen
+from test_framework.p2mr_slhdsa128s import slhdsa128s_keygen
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, assert_raises_rpc_error
+from test_framework.wallet import MiniWallet
+
+START_HEIGHT = 199
+SNAPSHOT_BASE_HEIGHT = 299
+SNAPSHOT_BASE_HASH = "7cc695046fec709f8c9394b6f928f81e81fd3ac20977bb68760fa1faa7916ea2"
+# Node 1's lattice height: above the creation of its lattice tripwire output, below block 200 that spends it.
+SNAPSHOT_H4T = 150
+FUND_SATS = 100_000
+FEE_SATS = 5_000
+
+MEMPOOL_ML = f"mempool-script-verify-flag-failed ({MLDSA_DISABLED_ERROR})"
+BLOCK_ML = f"block-script-verify-flag-failed ({MLDSA_DISABLED_ERROR})"
+
+
+def seckey(tag):
+    return hashlib.sha256(b"feature_p2mr_lattice_tripwire_storage " + tag).digest()
+
+
+PQ_PUB, PQ_SEC = mldsa44_keygen(seckey(b"ml-dsa-44"))
+L2_PUB, L2_SEC = mldsa44_keygen(seckey(b"destroyed"))
+L3_PUB, L3_SEC = mldsa44_keygen(seckey(b"drill"))
+SLH_PUB, SLH_SEC = slhdsa128s_keygen(hashlib.sha512(b"feature_p2mr_lattice_tripwire_storage slh").digest()[:48])
+TREE_L2, TREE_L3 = (lattice_tripwire_tree(pk) for pk in (L2_PUB, L3_PUB))
+PQ2 = pq2_tree(PQ_PUB, SLH_PUB)
+
+
+def output(tx, n=0):
+    return {"txid": tx.txid_int, "vout": n, "value": tx.vout[n].nValue, "script_pubkey": tx.vout[n].scriptPubKey}
+
+
+def outpoint(utxo):
+    return f"{utxo['txid']:064x}:{utxo['vout']}"
+
+
+def pq_witness(tree=PQ2, name="pq", key=PQ_SEC):
+    leaf = tree.leaves[name]
+    return lambda tx, spent, index: mldsa44_any_leaf_witness(key, leaf, tx, spent, index)
+
+
+def slh_witness():
+    leaf = PQ2.leaves["slh"]
+    return lambda tx, spent, index: slhdsa128s_leaf_witness(SLH_SEC, leaf, tx, spent, index)
+
+
+class P2MRLatticeTripwireStorageTest(BitcoinTestFramework):
+    def set_test_params(self):
+        # The cached chain up to 199, which the regtest assumeutxo snapshot at 299 builds on.
+        self.num_nodes = 3
+        self.rpc_timeout = 120
+        noban = "-whitelist=noban@127.0.0.1"
+        self.base_args = [[noban], [noban], [noban, "-fastprune", "-prune=1"]]
+        self.extra_args = [list(args) for args in self.base_args]
+
+    def setup_network(self):
+        # Disconnected, and without the block setup_nodes() mines on the cached chain: node 0 builds
+        # the snapshot chain on its own, and node 1 only gets its headers.
+        self.add_nodes(self.num_nodes, self.extra_args)
+        self.start_nodes()
+
+    # ------------------------------------------------------------------
+    # Helpers
+    # ------------------------------------------------------------------
+
+    def wallet_witness(self, tx, spent, index):
+        return list(self.wallet_stack)
+
+    def wallet_input(self):
+        utxo = self.wallet.get_utxo(confirmed_only=True)
+        return ({"txid": int(utxo["txid"], 16), "vout": utxo["vout"], "value": int(utxo["value"] * COIN),
+                 "script_pubkey": self.wallet.get_output_script()}, self.wallet_witness)
+
+    def spend(self, inputs, *, outputs=None, version=2):
+        tx = CTransaction()
+        tx.version = version
+        tx.vin = [CTxIn(COutPoint(utxo["txid"], utxo["vout"]), b"", 0xfffffffd) for utxo, _ in inputs]
+        total = sum(utxo["value"] for utxo, _ in inputs)
+        tx.vout = outputs if outputs is not None else [CTxOut(total - FEE_SATS, self.wallet.get_output_script())]
+        spent = [CTxOut(utxo["value"], utxo["script_pubkey"]) for utxo, _ in inputs]
+        tx.wit.vtxinwit = [CTxInWitness() for _ in inputs]
+        for index, (_, make) in enumerate(inputs):
+            tx.wit.vtxinwit[index].scriptWitness.stack = make(tx, spent, index)
+        return tx
+
+    def funding(self, script_pubkeys):
+        """A transaction paying FUND_SATS to each script, from the wallet."""
+        utxo, witness = self.wallet_input()
+        outputs = [CTxOut(FUND_SATS, spk) for spk in script_pubkeys]
+        outputs.append(CTxOut(utxo["value"] - FUND_SATS * len(outputs) - FEE_SATS, self.wallet.get_output_script()))
+        return self.spend([(utxo, witness)], outputs=outputs)
+
+    def build_block(self, txs, *, node, prev=None, nudge=0):
+        prev = prev or node.getbestblockhash()
+        header = node.getblockheader(prev)
+        block = create_block(int(prev, 16), create_coinbase(header["height"] + 1), header["mediantime"] + 1 + nudge, txlist=txs)
+        add_witness_commitment(block)
+        block.solve()
+        return block
+
+    def submit(self, block, expected=None, *, node):
+        assert_equal(node.submitblock(block.serialize().hex()), expected)
+
+    def lattice(self, node):
+        return node.gettripwireinfo()["lattice"]
+
+    def state_log(self, outpoints, states, checks):
+        listed = ", ".join(f"{o} {state}" for o, state in zip(outpoints, states))
+        return f"lattice tripwire outputs {listed}; ML-DSA-44 checks in leaf version 0xe2 are {checks} for the next block"
+
+    # ------------------------------------------------------------------
+    # Test body
+    # ------------------------------------------------------------------
+
+    def run_test(self):
+        snapshot = self.build_snapshot_chain()
+        self.connect_nodes(0, 2)
+        self.sync_blocks([self.nodes[0], self.nodes[2]])
+        self.wallet.rescan_utxos()
+        probe = CTransaction()
+        probe.vin = [CTxIn()]
+        self.wallet.sign_tx(probe)
+        self.wallet_stack = list(probe.wit.vtxinwit[0].scriptWitness.stack)
+
+        self.test_assumeutxo(snapshot)
+        self.test_pruning()
+
+    def build_snapshot_chain(self):
+        self.log.info("Mine blocks 200 to 299 as feature_assumeutxo.py does, for the snapshot regtest knows")
+        n0 = self.nodes[0]
+        assert_equal(n0.getblockcount(), START_HEIGHT)
+        n0.setmocktime(n0.getblockheader(n0.getbestblockhash())["time"])
+        self.wallet = MiniWallet(n0)
+        for i in range(SNAPSHOT_BASE_HEIGHT - START_HEIGHT):
+            if i % 3 == 0:
+                self.wallet.send_self_transfer(from_node=n0)
+            self.generate(n0, nblocks=1, sync_fun=self.no_op)
+        assert_equal(n0.getbestblockhash(), SNAPSHOT_BASE_HASH)
+        return n0.dumptxoutset("utxos.dat", "latest")["path"]
+
+    def test_assumeutxo(self, snapshot):
+        self.log.info("assumeutxo: the snapshot chainstate is past a lattice tripwire spend the background one has not reached")
+        n0, n1, n2 = self.nodes[0], self.nodes[1], self.nodes[2]
+        # Node 1's lattice tripwire output: the one the first transaction of block 200 spends, created far below.
+        spend = n0.getblock(n0.getblockhash(START_HEIGHT + 1), 2)["tx"][1]["vin"][0]
+        created = next(h for h in range(START_HEIGHT + 1) if n0.getblock(n0.getblockhash(h))["tx"][0] == spend["txid"])
+        assert created < SNAPSHOT_H4T < START_HEIGHT
+        tripwire = f"{spend['txid']}:{spend['vout']}"
+        with n1.assert_debug_log([f"P2MR lattice tripwire rules from height {SNAPSHOT_H4T} in leaf version 0xe2; tripwire outputs {tripwire}",
+                                  f"P2MR lattice tripwire state at height {START_HEIGHT}: "
+                                  + self.state_log([tripwire], ["unspent"], "enabled")]):
+            self.restart_node(1, extra_args=self.base_args[1] + [f"-signetlatticetripwire={SNAPSHOT_H4T}@{tripwire}"])
+        n1.setmocktime(n0.getblockheader(n0.getbestblockhash())["time"])
+        for height in range(START_HEIGHT + 1, SNAPSHOT_BASE_HEIGHT + 1):
+            n1.submitheader(n0.getblock(n0.getblockhash(height), 0))
+        assert_equal(n1.loadtxoutset(snapshot)["base_height"], SNAPSHOT_BASE_HEIGHT)
+        assert_equal([chainstate["blocks"] for chainstate in n1.getchainstates()["chainstates"]], [START_HEIGHT, SNAPSHOT_BASE_HEIGHT])
+        expected = {"height": SNAPSHOT_H4T, "leaf_version": "e2", "tripwires": [{"outpoint": tripwire, "state": "missing"}],
+                    "mldsa_disabled_next_block": True}
+        assert_equal(self.lattice(n1), expected)
+        assert_equal(n1.gettripwireinfo()["tip_height"], SNAPSHOT_BASE_HEIGHT)
+
+        # The snapshot chainstate decides on its own UTXO set, from the first block after the snapshot:
+        # before block 300, the mempool refuses an ML-DSA-44 spend of 0xe2 that spends an unconfirmed
+        # output; and block 300 itself, with the funding and that spend, is refused, while one with
+        # the funding and an SLH-DSA spend of 0xe2 is taken.
+        funding = self.funding([PQ2.scriptPubKey] * 5)
+        n1.sendrawtransaction(funding.serialize().hex())
+        pq_300 = self.spend([(output(funding, 0), pq_witness())])
+        slh_300 = self.spend([(output(funding, 1), slh_witness())])
+        assert_equal(n1.testmempoolaccept([pq_300.serialize().hex()])[0]["reject-reason"], MEMPOOL_ML)
+        assert n1.testmempoolaccept([slh_300.serialize().hex()])[0]["allowed"]
+        assert_equal(n1.getblockcount(), SNAPSHOT_BASE_HEIGHT)
+        self.submit(self.build_block([funding, pq_300], node=n1), BLOCK_ML, node=n1)
+        first = self.build_block([funding, slh_300], node=n1)
+        self.submit(first, node=n1)
+        assert_equal(n1.getblockcount(), SNAPSHOT_BASE_HEIGHT + 1)
+        # And at 301, on confirmed outputs.
+        pq = self.spend([(output(funding, 2), pq_witness())])
+        slh = self.spend([(output(funding, 3), slh_witness())])
+        assert_equal(n1.testmempoolaccept([pq.serialize().hex()])[0]["reject-reason"], MEMPOOL_ML)
+        assert n1.testmempoolaccept([slh.serialize().hex()])[0]["allowed"]
+        self.submit(self.build_block([pq], node=n1), BLOCK_ML, node=n1)
+        second = self.build_block([slh], node=n1)
+        self.submit(second, node=n1)
+        assert_equal(n1.getchainstates()["chainstates"][0]["blocks"], START_HEIGHT)
+        # The other nodes continue from the same blocks; node 0 and node 2 have no lattice rules yet.
+        for block in (first, second):
+            self.submit(block, node=n0)
+        self.sync_blocks([n0, n2])
+        self.late_pq = output(funding, 4)
+
+        self.log.info("assumeutxo: the background chainstate replays the spend in block 200 without the log of the active chain")
+        with n1.assert_debug_log([], unexpected_msgs=[f"P2MR lattice tripwire {tripwire} spent by",
+                                                      "P2MR lattice tripwire rules active from height"]):
+            self.connect_nodes(1, 0)
+            self.wait_until(lambda: len(n1.getchainstates()["chainstates"]) == 1)
+        self.sync_blocks([n0, n1])
+        self.disconnect_nodes(1, 0)
+        assert_equal(n1.getchainstates()["chainstates"][0]["blocks"], SNAPSHOT_BASE_HEIGHT + 2)
+        self.log.info("assumeutxo: after the background validation, and after a restart, the state and the refusals are the same")
+        for restart in (False, True):
+            if restart:
+                with n1.assert_debug_log([f"P2MR lattice tripwire state at height {SNAPSHOT_BASE_HEIGHT + 2}: "
+                                          + self.state_log([tripwire], ["missing"], "disabled")]):
+                    self.restart_node(1, extra_args=self.base_args[1] + [f"-signetlatticetripwire={SNAPSHOT_H4T}@{tripwire}"])
+            assert_equal(self.lattice(n1), expected)
+            late = self.spend([(self.late_pq, pq_witness())])
+            assert_equal(n1.testmempoolaccept([late.serialize().hex()])[0]["reject-reason"], MEMPOOL_ML)
+            self.submit(self.build_block([late], node=n1, nudge=int(restart)), BLOCK_ML, node=n1)
+        self.stop_node(1)
+
+    def test_pruning(self):
+        n0, n2 = self.nodes[0], self.nodes[2]
+        main = [n0, n2]
+        self.log.info("Pruning: node 2 prunes, with the rules, before a lattice tripwire output is spent")
+        tx = self.funding([TREE_L2.scriptPubKey, TREE_L3.scriptPubKey] + [PQ2.scriptPubKey] * 6)
+        self.wallet.sendrawtransaction(from_node=n0, tx_hex=tx.serialize().hex())
+        self.generate(n0, 1, sync_fun=lambda: self.sync_blocks(main))
+        l2, l3 = output(tx, 0), output(tx, 1)
+        outs = [output(tx, n) for n in range(2, 8)]
+        # Past the 288 blocks a pruned node keeps, so that it has pruned before it meets the trigger.
+        self.generate(n0, 300, sync_fun=lambda: self.sync_blocks(main))
+        n2.pruneblockchain(n2.getblockcount())
+        assert n2.getblockchaininfo()["pruneheight"] > 0
+        height = n0.getblockcount() + 3
+        rules = [f"-signetlatticetripwire={height}@{outpoint(l2)},{outpoint(l3)}"]
+        for node in main:
+            self.restart_node(node.index, extra_args=self.base_args[node.index] + rules)
+        self.connect_nodes(0, 2)
+        self.generate(n0, height - n0.getblockcount(), sync_fun=lambda: self.sync_blocks(main))
+
+        self.log.info("Pruning: the pruned node connects the trigger, logs it, and drops the ML-DSA-44 spend of 0xe2 from its mempool")
+        pq_mempool = self.spend([(outs[0], pq_witness())])
+        slh_mempool = self.spend([(outs[1], slh_witness())])
+        for spend in (pq_mempool, slh_mempool):
+            n2.sendrawtransaction(spend.serialize().hex())
+        trigger = self.spend([(l2, pq_witness(TREE_L2, "pq", L2_SEC))], version=4)
+        x = self.build_block([trigger], node=n0)
+        self.x_height = n0.getblockcount() + 1
+        with n2.assert_debug_log([f"P2MR lattice tripwire {outpoint(l2)} spent by {trigger.txid_hex} in block {x.hash_hex} "
+                                  f"(height {self.x_height}): OP_CHECKMLDSA44 in leaf version 0xe2 is disabled from height {self.x_height + 1}"]):
+            self.submit(x, node=n0)
+            self.sync_blocks(main)
+        assert_equal(set(n2.getrawmempool()), {slh_mempool.txid_hex})
+        self.generate(n0, 2, sync_fun=lambda: self.sync_blocks(main))
+        states = ["missing", "unspent"]
+        assert_equal([t["state"] for t in self.lattice(n2)["tripwires"]], states)
+        assert self.lattice(n2)["mldsa_disabled_next_block"]
+
+        self.log.info("Pruning: a reorganization over the trigger, inside the blocks a pruned node keeps, brings the checks back")
+        self.disconnect_nodes(0, 2)
+        n2.invalidateblock(x.hash_hex)
+        assert_equal([t["state"] for t in self.lattice(n2)["tripwires"]], ["unspent", "unspent"])
+        assert not self.lattice(n2)["mldsa_disabled_next_block"]
+        n2.sendrawtransaction(pq_mempool.serialize().hex())
+        n2.reconsiderblock(x.hash_hex)
+        assert_equal(n2.getbestblockhash(), n0.getbestblockhash())
+        assert self.lattice(n2)["mldsa_disabled_next_block"]
+        assert pq_mempool.txid_hex not in n2.getrawmempool()
+        self.connect_nodes(0, 2)
+
+        self.log.info("Pruning: once the trigger's block is pruned, a restart rebuilds the same state from the UTXO set")
+        # A block of its own fills a block file, so that X's file ends early and can be pruned.
+        self.wallet.send_self_transfer(from_node=n0, target_vsize=70_000)
+        self.generate(n0, 1, sync_fun=lambda: self.sync_blocks(main))
+        self.generate(n0, 300, sync_fun=lambda: self.sync_blocks(main))
+        n2.pruneblockchain(n2.getblockcount())
+        assert n2.getblockchaininfo()["pruneheight"] > self.x_height
+        assert_raises_rpc_error(-1, "Block not available (pruned data)", n2.getblock, x.hash_hex)
+        tip = n2.getblockcount()
+        with n2.assert_debug_log([f"P2MR lattice tripwire state at height {tip}: "
+                                  + self.state_log([outpoint(l2), outpoint(l3)], states, "disabled")]):
+            self.restart_node(2, extra_args=self.base_args[2] + rules)
+        assert_equal(n2.gettripwireinfo(), n0.gettripwireinfo())
+        self.submit(self.build_block([self.spend([(outs[2], pq_witness())])], node=n2), BLOCK_ML, node=n2)
+        kept = self.build_block([self.spend([(outs[3], slh_witness())])], node=n2)
+        self.submit(kept, node=n2)
+
+        self.log.info("Pruning: the reorganizations pruning still allows, above the prune height, keep the state; spending L3 there too")
+        n2.invalidateblock(kept.hash_hex)
+        assert_equal([t["state"] for t in self.lattice(n2)["tripwires"]], states)
+        assert self.lattice(n2)["mldsa_disabled_next_block"]
+        trigger3 = self.spend([(l3, pq_witness(TREE_L3, "pq", L3_SEC))], version=4)
+        y = self.build_block([trigger3], node=n2, nudge=1)
+        self.submit(y, node=n2)
+        assert_equal([t["state"] for t in self.lattice(n2)["tripwires"]], ["missing", "missing"])
+        n2.invalidateblock(y.hash_hex)
+        assert_equal([t["state"] for t in self.lattice(n2)["tripwires"]], states)
+        assert self.lattice(n2)["mldsa_disabled_next_block"]
+        n2.reconsiderblock(kept.hash_hex)
+        self.connect_nodes(0, 2)
+        self.sync_blocks(main)
+        assert_equal(n2.gettripwireinfo(), n0.gettripwireinfo())
+
+
+if __name__ == '__main__':
+    P2MRLatticeTripwireStorageTest(__file__).main()
