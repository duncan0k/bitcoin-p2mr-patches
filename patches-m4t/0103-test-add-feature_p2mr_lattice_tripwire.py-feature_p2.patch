+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test the P2MR lattice tripwire rules on a custom signet, and their absence on Ark-0
+(doc/p2mr-lattice-tripwire.md).
+
+Node 0 runs a custom signet with -signetlatticetripwire, whose one lattice tripwire output never
+existed: from the height of the rules, ML-DSA-44 checks in leaf version 0xe2 are disabled, which
+gettripwireinfo and getdeploymentinfo report, and the startup log names the rules. Node 1 runs the
+Ark-0 signet, whose height and lattice tripwire outputs are not decided: the rules are not active
+there, the deployment is not listed, gettripwireinfo has no lattice object, and the startup log
+says so. The script rules themselves are tested on regtest (feature_p2mr_lattice_tripwire.py).
+"""
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal
+
+CHALLENGE = "51"
+ARK0_CHALLENGE = "5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae"
+H1, H3, H4, H4T = 1, 3, 4, 6
+NEVER_CREATED = f"{'22' * 32}:1"
+# Signet blocks need real proof of work, about 2^22 hashes each.
+MAXTRIES = 10**9
+ARGS = [f"-signetchallenge={CHALLENGE}", f"-signetmldsa44={H1}", f"-signettripwire={H3}@{'11' * 32}:0",
+        f"-signetslhdsa128s={H4}", f"-signetlatticetripwire={H4T}@{NEVER_CREATED}"]
+
+
+class P2MRLatticeTripwireSignetTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.chain = "signet"
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+        self.extra_args = [ARGS, [f"-signetchallenge={ARK0_CHALLENGE}"]]
+
+    def setup_network(self):
+        self.setup_nodes()
+
+    def run_test(self):
+        node, ark0 = self.nodes
+        self.log.info("A custom signet with -signetlatticetripwire: the parameters and the startup log")
+        assert_equal(node.getdeploymentinfo()["deployments"]["p2mr_lattice_tripwire"], {"type": "buried", "active": False, "height": H4T})
+        log = node.debug_log_path.read_text()
+        assert f"Signet P2MR lattice tripwire rules from height {H4T} in leaf version 0xe2; tripwire outputs {NEVER_CREATED}" in log
+        assert f"P2MR SLH-DSA-SHA2-128s rules active from height {H4} (leaf versions 0xc0, 0xe0, 0xe2)" in log
+        info = node.gettripwireinfo()["lattice"]
+        assert_equal(info, {"height": H4T, "leaf_version": "e2", "tripwires": [{"outpoint": NEVER_CREATED, "state": "missing"}],
+                            "mldsa_disabled_next_block": False})
+
+        self.log.info("A lattice tripwire output that never existed disables ML-DSA-44 checks in 0xe2 from the height on")
+        self.generatetodescriptor(node, H4T - 2, "raw(51)", maxtries=MAXTRIES, sync_fun=self.no_op)
+        assert_equal(node.gettripwireinfo()["lattice"]["mldsa_disabled_next_block"], False)
+        with node.assert_debug_log([f"P2MR lattice tripwire rules active from height {H4T}, reached by block ",
+                                    f"lattice tripwire outputs {NEVER_CREATED} missing; ML-DSA-44 checks in leaf version 0xe2 are disabled for the next block"]):
+            self.generatetodescriptor(node, 1, "raw(51)", maxtries=MAXTRIES, sync_fun=self.no_op)
+            assert_equal(node.gettripwireinfo()["lattice"]["mldsa_disabled_next_block"], True)
+            self.generatetodescriptor(node, 1, "raw(51)", maxtries=MAXTRIES, sync_fun=self.no_op)
+        assert_equal(node.getdeploymentinfo()["deployments"]["p2mr_lattice_tripwire"]["active"], True)
+        assert "P2MR_LATTICE_TRIPWIRE" in node.getdeploymentinfo()["script_flags"]
+
+        self.log.info("Ark-0: the lattice tripwire rules are not active, and the node says so")
+        assert "p2mr_lattice_tripwire" not in ark0.getdeploymentinfo()["deployments"]
+        assert "lattice" not in ark0.gettripwireinfo()
+        log = ark0.debug_log_path.read_text()
+        assert "P2MR lattice tripwire rules (leaf version 0xe2) are not active on the Ark-0 signet: their height and outputs are not decided yet" in log
+        assert "P2MR SLH-DSA-SHA2-128s rules active from height 32000 (leaf versions 0xc0, 0xe0)" in log
+        assert "P2MR lattice tripwire rules from height" not in log
+
+
+if __name__ == '__main__':
+    P2MRLatticeTripwireSignetTest(__file__).main()
