+    def create_tripwires(self):
+        self.log.info("Create the tripwire output D and the lattice tripwire outputs L1 (NUMS), L2 and L3")
+        n0 = self.nodes[0]
+        self.tripwire_tx, outputs = self.fund([TREE_D.scriptPubKey, TREE_L1.scriptPubKey, TREE_L2.scriptPubKey, TREE_L3.scriptPubKey])
+        self.c_hash, self.c_height = n0.getbestblockhash(), n0.getblockcount()
+        self.tw = dict(zip(("D", "L1", "L2", "L3"), outputs))
+        self.tripwires = {name: outpoint(utxo) for name, utxo in self.tw.items()}
+        # The NUMS output of the three, as the unit test computes it with mldsa-native.
+        assert_equal(bytes(TREE_L1.scriptPubKey).hex(), "52208fda4317667005f0a85352aeae313b38d0c4d9476a43b80b9ef64dba29c8dd56")
+        height = n0.getblockcount()
+
+        self.log.info(f"Restart with the rules: leaf version 0xe0 from {H3}, 0xe2 from {H4T}")
+        lattice_list = ", ".join(self.tripwires[n] for n in ("L1", "L2", "L3"))
+        logs = [f"P2MR lattice tripwire rules from height {H4T} in leaf version 0xe2; tripwire outputs {lattice_list}",
+                f"P2MR SLH-DSA-SHA2-128s rules active from height 0 (leaf versions 0xc0, 0xe0, 0xe2)",
+                f"P2MR lattice tripwire state at height {height}: " + self.state_log(["unspent"] * 3, "enabled")]
+        for i in (0, 1, 3):
+            with self.nodes[i].assert_debug_log(logs):
+                self.restart_node(i, extra_args=self.rules_args(i))
+        with self.nodes[2].assert_debug_log([], unexpected_msgs=["P2MR lattice tripwire state"]):
+            self.restart_node(2, extra_args=self.rules_args(2))
+        self.connect_main()
+
+        info = n0.gettripwireinfo()
+        assert_equal(info["lattice"], {
+            "height": H4T,
+            "leaf_version": "e2",
+            "tripwires": [{"outpoint": self.tripwires[n], "state": "unspent"} for n in ("L1", "L2", "L3")],
+            "mldsa_disabled_next_block": False,
+        })
+        assert_equal(info["tripwires"], [{"outpoint": self.tripwires["D"], "state": "unspent"}])
+        assert_equal(n0.getdeploymentinfo()["deployments"]["p2mr_lattice_tripwire"], {"type": "buried", "active": False, "height": H4T})
+        assert_equal(self.nodes[2].getdeploymentinfo()["deployments"]["p2mr_lattice_tripwire"]["height"], NEVER)
+
+        _, outputs = self.fund([tree.scriptPubKey for tree in OUTPUTS.values()])
+        self.outs = dict(zip(OUTPUTS, outputs))
