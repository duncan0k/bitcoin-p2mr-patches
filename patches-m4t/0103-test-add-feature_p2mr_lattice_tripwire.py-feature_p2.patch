+        leaf, fail = TREE_L1.leaves["pq"], TREE_L1.leaves["fail"]
+        chunks = mldsa44_sig_chunks(bytes(range(256)) * 9 + bytes(116))
+        forged = self.spend([(self.tw["L1"], lambda tx, spent, index: chunks + [bytes(leaf.script), leaf.control_block])])
+        self.reject(forged, "mempool-script-verify-flag-failed (Invalid ML-DSA-44 signature)")
+        self.submit(self.build_block([forged]), "block-script-verify-flag-failed (Invalid ML-DSA-44 signature)")
+        returned = self.spend([(self.tw["L1"], lambda tx, spent, index: [bytes(fail.script), fail.control_block])])
+        self.reject(returned, "mempool-script-verify-flag-failed (OP_RETURN was encountered)")
