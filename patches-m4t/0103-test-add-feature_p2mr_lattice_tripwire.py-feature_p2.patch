+        self.log.info("Block X+1: the same spends fail in the mempool, in a block and in a proposal, past both caches")
+        self.reject(self.cache_pq, MEMPOOL_ML)
+        self.reject(self.cache_pq, MEMPOOL_ML, node=1)
+        stale = self.build_block([self.cache_pq])
+        self.submit(stale, BLOCK_ML)
+        assert_equal(self.propose(self.build_block([self.cache_pq], nudge=1)), BLOCK_ML)
+        self.log.info("The M4-R node takes that block: the lattice tripwire only tightens the rules")
+        self.follow_m4r()
+        assert_equal(self.propose(self.build_block([self.cache_pq], nudge=2), node=self.nodes[2]), None)
+        self.log.info("ML-DSA-44 leaves of versions 0xc0 and 0xe0, and SLH-DSA leaves of 0xe2, are not affected")
+        self.late_slh = self.spend([(o["late_slh"], slh_witness())])
+        self.accept(self.late_slh)
