+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test P2MR leaf version 0xe2 and its lattice tripwire outputs (doc/p2mr-lattice-tripwire.md).
+
+With -signetlatticetripwire=<height>@<outpoints> on regtest, P2MR leaves of leaf version 0xe2 at
+depth one or more execute from that height on as leaves of version 0xc0 do. Their elliptic curve
+checks follow the tripwire of leaf version 0xe0 (-signettripwire); in a block whose parent leaves
+one of the lattice tripwire outputs missing from the UTXO set (spent, never created, or created at
+or above the height), OP_CHECKMLDSA44 with a non-empty signature in such a leaf fails. There are
+three lattice tripwire outputs here, of the shape the Ark-0 ones will have: L1 with the NUMS key,
+L2 and L3 with keys the test holds; and the tripwire output D of leaf version 0xe0.
+
+  node 0  the rules and the default policy
+  node 1  the rules, -acceptnonstdtxn=1
+  node 2  an M4-R node: the tripwire of leaf version 0xe0, without the lattice rules; it takes
+          every block node 0 takes (a soft fork), which it is given one by one: connected, it would
+          also take the blocks node 0 is offered and refuses, which node 0 relays to it as compact
+          blocks before checking them
+  node 3  the rules, with the rescue lane open from a height above that of the lattice rules
+
+Covered: the activation boundary in the mempool and in blocks, -acceptnonstdtxn, the m=0 exception
+and the 80-byte limit at depth zero, a reorganization below the height, the block that spends a
+lattice tripwire (spends before and after the trigger in it are valid, the same spends one block
+later are not, in the mempool, in a block and in a proposal), a lattice tripwire spend only in the
+mempool, removal from the mempool on a plain connect (chains, a package, TRUC, mixed inputs) and
+after a reorganization (a parent that comes back while its ML-DSA-44 child goes and its SLH-DSA child
+stays; a first block that repeats the transactions of the block it replaces, so that none come back),
+reorgs over the trigger (with the exact mempool after each: a child of two removed ML-DSA-44 spends
+goes, an SLH-DSA-only branch stays), both tripwires spent in one block and in adjacent blocks, a lattice
+tripwire spent below the height (the first block there refuses), outputs moved by a reorg and
+confirmed again at the height (missing), regtest's default height following OP_CHECKMLDSA44, both
+tripwires missing (S2, an AND leaf, SLH1 and Schnorr leaves
+in 0xe2), the NUMS output, the M4-R lane in 0xe2 (an elliptic curve rescue valid from
+max(H4R, H4T) but not standard, an ML-DSA-44 rescue token refused), the policy of 0xe2 leaves, the
+logs and gettripwireinfo, VerifyDB level 4, restarts, -reindex and -reindex-chainstate, a late
+upgrade of the M4-R node, a spendable output in the first lattice slot that triggers, an outpoint
+that was never created, and the options. assumeutxo and pruning are in
+feature_p2mr_lattice_tripwire_storage.py.
+"""
+
+import hashlib
+import re
+
+from test_framework.blocktools import add_witness_commitment, create_block, create_coinbase
+from test_framework.key import compute_xonly_pubkey
+from test_framework.messages import COIN, COutPoint, CTransaction, CTxIn, CTxInWitness, CTxOut
+from test_framework.p2mr import p2mr_construct
+from test_framework.p2mr_lattice_tripwire import (
+    LEAF_VERSION_LATTICE_TRIPWIRED,
+    MLDSA_DISABLED_ERROR,
+    NUMS_KEY_SHA256,
+    lattice_tripwire_tree,
+    mldsa44_any_leaf_witness,
+    nums_pubkey,
+    pq2_tree,
+    slhdsa128s_leaf_witness,
+)
+from test_framework.p2mr_mldsa44 import OP_CHECKMLDSA44, mldsa44_keygen, mldsa44_leaf, mldsa44_sig_chunks
+from test_framework.p2mr_rescue import (
+    RESCUE_STATEMENT_HMAC,
+    WALLET_V1_SCHNORR_K,
+    find_prover,
+    network_id_regtest,
+    prove,
+    rescue_annex,
+    rescue_key,
+    rescue_message,
+    rescue_pub,
+    rescue_sighash,
+    rescue_token,
+    rescue_y,
+)
+from test_framework.p2mr_slhdsa128s import OP_CHECKSLHDSA128S, slhdsa128s_keygen, slhdsa128s_leaf
+from test_framework.p2mr_tripwire import EC_DISABLED_ERROR, LEAF_VERSION_TRIPWIRED, schnorr_leaf_witness, tripwire_tree
+from test_framework.script import CScript, OP_1, OP_CHECKSIG, OP_DROP, OP_RETURN, OP_VERIFY
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.test_node import ErrorMatch
+from test_framework.util import assert_equal, assert_raises_rpc_error
+from test_framework.wallet import MiniWallet
+
+E2 = LEAF_VERSION_LATTICE_TRIPWIRED
+H3 = 215
+H4T = 230
+# Node 3's rescue lane, above H4T; node 0's opens at H3, as regtest's does by default.
+H4R_LATE = 250
+NEVER = 2147483646  # the highest height -testactivationheight takes
+FUND_SATS = 100_000
+FEE_SATS = 5_000
+
+DISCOURAGED = "mempool-script-verify-flag-failed (Taproot version reserved for soft-fork upgrades)"
+NONSTANDARD = "bad-witness-nonstandard"
+MEMPOOL_ML = f"mempool-script-verify-flag-failed ({MLDSA_DISABLED_ERROR})"
+BLOCK_ML = f"block-script-verify-flag-failed ({MLDSA_DISABLED_ERROR})"
+MEMPOOL_EC = f"mempool-script-verify-flag-failed ({EC_DISABLED_ERROR})"
+BLOCK_EC = f"block-script-verify-flag-failed ({EC_DISABLED_ERROR})"
+
+
+def seckey(tag):
+    return hashlib.sha256(b"feature_p2mr_lattice_tripwire " + tag).digest()
+
+
+SEC_D, SEC_U = seckey(b"tripwire d"), seckey(b"user")
+PUB_D, PUB_U = (compute_xonly_pubkey(key)[0] for key in (SEC_D, SEC_U))
+PQ_PUB, PQ_SEC = mldsa44_keygen(seckey(b"ml-dsa-44"))
+L2_PUB, L2_SEC = mldsa44_keygen(seckey(b"destroyed"))
+L3_PUB, L3_SEC = mldsa44_keygen(seckey(b"drill"))
+# A key for a spendable output in the first lattice slot, which on Ark-0 holds the NUMS output.
+SLOT_PUB, SLOT_SEC = mldsa44_keygen(seckey(b"first slot"))
+SLH_PUB, SLH_SEC = slhdsa128s_keygen(hashlib.sha512(b"feature_p2mr_lattice_tripwire slh").digest()[:48])
+NUMS_PUB = nums_pubkey()
+assert hashlib.sha256(NUMS_PUB).hexdigest() == NUMS_KEY_SHA256
+
+TREE_D = tripwire_tree(PUB_D)
+TREE_L1, TREE_L2, TREE_L3 = (lattice_tripwire_tree(pk) for pk in (NUMS_PUB, L2_PUB, L3_PUB))
+TREE_SLOT = lattice_tripwire_tree(SLOT_PUB)
+# pq2: the ML-DSA-44 leaf S1 and the SLH-DSA leaf SLH1, both of version 0xe2.
+PQ2 = pq2_tree(PQ_PUB, SLH_PUB)
+# The same leaves in 0xc0 and 0xe0: what the lattice tripwire leaves alone.
+PQ2_C0 = pq2_tree(PQ_PUB, SLH_PUB, 0xc0)
+PQ2_E0 = pq2_tree(PQ_PUB, SLH_PUB, LEAF_VERSION_TRIPWIRED)
+# A Schnorr leaf of version 0xe2, next to S1.
+HYBRID = p2mr_construct([("ec", CScript([PUB_U, OP_CHECKSIG]), E2), ("pq", mldsa44_leaf(PQ_PUB), E2)])
+# S2 (ML-DSA-44 AND Schnorr) and an ML-DSA-44 AND SLH-DSA leaf, both of version 0xe2.
+S2 = p2mr_construct([("s2", mldsa44_leaf(PQ_PUB, PUB_U), E2), ("fail", CScript([OP_RETURN]))])
+AND = p2mr_construct([("and", CScript(list(mldsa44_leaf(PQ_PUB))[:-1] + [OP_CHECKMLDSA44, OP_VERIFY, SLH_PUB, OP_CHECKSLHDSA128S]), E2),
+                      ("fail", CScript([OP_RETURN]))])
+# A single leaf tree has m=0: the leaf is not executed at any height.
+LONE = p2mr_construct([("pq", mldsa44_leaf(PQ_PUB), E2)])
+# Drops one witness item, for the 80-byte stack item limit of policy.
+ITEM = p2mr_construct([("drop", CScript([OP_DROP, OP_1]), E2), ("fail", CScript([OP_RETURN]))])
+
+# The rescue key: a web wallet v1 style key, y = HMAC-SHA256(K, x || 0), P = x(y*G), in a leaf
+# <P> OP_CHECKSIG of version 0xe2 (the shape of template R1, at another leaf version).
+RESCUE_X = seckey(b"rescue")
+RESCUE_Y = rescue_y(WALLET_V1_SCHNORR_K, RESCUE_X, 0)
+RESCUE_P = rescue_key(RESCUE_Y)
+RESCUE_TOKEN = rescue_token(WALLET_V1_SCHNORR_K, 0, RESCUE_Y)
+RESCUE = p2mr_construct([("rescue", CScript([RESCUE_P, OP_CHECKSIG]), E2), ("fail", CScript([OP_RETURN]))])
+
+OUTPUTS = {
+    "boundary_pq": PQ2, "boundary_slh": PQ2, "boundary_invalid": PQ2, "boundary_s2": S2, "boundary_rescue": RESCUE,
+    "boundary_token": PQ2, "lone_1": LONE, "lone_81": LONE, "item_81": ITEM, "s2_relay": S2,
+    "kept_slh": PQ2, "gone_pq": PQ2, "parent_pq": PQ2, "truc_pq": PQ2, "mixed_pq": PQ2, "package": PQ2,
+    "before": PQ2, "after": PQ2, "cache_pq": PQ2, "ec_e2": HYBRID, "pq_c0": PQ2_C0, "pq_e0": PQ2_E0, "late_slh": PQ2,
+    "and": AND, "s2": S2, "both_slh": PQ2, "both_ec": HYBRID, "ec_mempool": HYBRID,
+    "same_pq": PQ2, "late_pq": PQ2,
+    "one_ec": HYBRID, "one_pq": PQ2, "one_kept": PQ2, "adj_ec": HYBRID, "adj_pq": PQ2,
+    "early_1": PQ2, "early_2": PQ2, "m1_reorg": PQ2,
+    "rescue": RESCUE, "rescue_bad": RESCUE, "token": PQ2, "after_reorg": PQ2, "after_bad": PQ2, "rescue_bad2": RESCUE,
+    "two_a": PQ2, "two_b": PQ2, "slh_branch": PQ2, "reorg_a": PQ2, "reorg_b": PQ2, "reorg_slh": PQ2,
+    "slot1": TREE_SLOT, "slot2": TREE_L3, "slot_before": PQ2, "slot_after": PQ2, "slot_mempool": PQ2, "slot_late_pq": PQ2,
+    "slot_late_slh": PQ2, "never_pq": PQ2, "never_slh": PQ2,
+}
+
+
+def output(tx, n=0):
+    return {"txid": tx.txid_int, "vout": n, "value": tx.vout[n].nValue, "script_pubkey": tx.vout[n].scriptPubKey}
+
+
+def outpoint(utxo):
+    return f"{utxo['txid']:064x}:{utxo['vout']}"
+
+
+def pq_witness(tree=PQ2, name="pq", *, key=PQ_SEC, mutate=None, below=()):
+    leaf = tree.leaves[name]
+
+    def make(tx, spent, index):
+        stack = mldsa44_any_leaf_witness(key, leaf, tx, spent, index, stack_below=below)
+        return stack if mutate is None else mutate(stack)
+    return make
+
+
+def slh_witness(tree=PQ2, name="slh"):
+    leaf = tree.leaves[name]
+    return lambda tx, spent, index: slhdsa128s_leaf_witness(SLH_SEC, leaf, tx, spent, index)
+
+
+def ec_witness(tree=HYBRID, name="ec", key=SEC_U):
+    leaf = tree.leaves[name]
+    return lambda tx, spent, index: schnorr_leaf_witness(key, leaf, tx, spent, index)
+
+
+def flip_bit(stack):
+    return stack[:2] + [bytes([stack[2][0] ^ 1]) + stack[2][1:]] + stack[3:]
+
+
+def s2_witness(tx, spent, index):
+    leaf = S2.leaves["s2"]
+    schnorr = schnorr_leaf_witness(SEC_U, leaf, tx, spent, index)[0]
+    return mldsa44_any_leaf_witness(PQ_SEC, leaf, tx, spent, index, stack_below=[schnorr])
+
+
+def and_witness(tx, spent, index):
+    leaf = AND.leaves["and"]
+    slh = slhdsa128s_leaf_witness(SLH_SEC, leaf, tx, spent, index)[:-2]
+    return mldsa44_any_leaf_witness(PQ_SEC, leaf, tx, spent, index, stack_below=slh)
+
+
+def lone_witness(size=0):
+    leaf = LONE.leaves["pq"]
+    return lambda tx, spent, index: ([b"\x01" * size] if size else []) + [bytes(leaf.script), leaf.control_block]
+
+
+def item_witness(size):
+    leaf = ITEM.leaves["drop"]
+    return lambda tx, spent, index: [b"\x01" * size, bytes(leaf.script), leaf.control_block]
+
+
+def token_witness(tx, spent, index):
+    """A rescue token in place of the first ML-DSA-44 signature chunk, the other chunks empty, and a
+    rescue record: not a rescue, since the disabled ML-DSA-44 check is not rescuable."""
+    leaf = PQ2.leaves["pq"]
+    return [RESCUE_TOKEN, b"", b"", b"", b"", bytes(leaf.script), leaf.control_block, rescue_annex(bytes(130218))]
+
+
+class P2MRLatticeTripwireTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 4
+        self.rpc_timeout = 240
+        noban = "-whitelist=noban@127.0.0.1"
+        self.base_args = [[noban], [noban, "-acceptnonstdtxn=1"], [noban], [noban]]
+        self.extra_args = [list(args) for args in self.base_args]
+
+    def setup_network(self):
+        self.add_nodes(self.num_nodes, self.extra_args)
+        self.start_nodes()
+        for i in (1, 3):
+            self.connect_nodes(0, i)
+        self.sync_all()
+
+    # ------------------------------------------------------------------
+    # Helpers
+    # ------------------------------------------------------------------
+
+    def rules_args(self, i):
+        tripwire = f"-signettripwire={H3}@{self.tripwires['D']}"
+        if i == 2:
+            return self.base_args[2] + [tripwire, f"-testactivationheight=p2mr_lattice_tripwire@{NEVER}"]
+        lattice = f"-signetlatticetripwire={H4T}@{','.join(self.tripwires[n] for n in ('L1', 'L2', 'L3'))}"
+        rescue = [f"-testactivationheight=p2mr_rescue@{H4R_LATE}"] if i == 3 else []
+        return self.base_args[i] + [tripwire, lattice] + rescue
+
+    def sync_main(self):
+        self.sync_blocks(self.main)
+
+    def follow_m4r(self):
+        """Give node 2, the M4-R node, the blocks of node 0's active chain it does not have."""
+        n0, n2 = self.nodes[0], self.nodes[2]
+        height = min(n0.getblockcount(), n2.getblockcount())
+        while n0.getblockhash(height) != n2.getblockhash(height):
+            height -= 1
+        for h in range(height + 1, n0.getblockcount() + 1):
+            assert_equal(n2.submitblock(n0.getblock(n0.getblockhash(h), 0)), None)
+        assert_equal(n2.getbestblockhash(), n0.getbestblockhash())
+
+    def mine(self, count=1):
+        return self.generate(self.wallet, count, sync_fun=self.sync_main)
+
+    def connect_main(self):
+        for node in self.main[1:]:
+            self.connect_nodes(0, node.index)
+        self.sync_main()
+
+    def disconnect_main(self):
+        for node in self.main[1:]:
+            self.disconnect_nodes(0, node.index)
+
+    def wallet_witness(self, tx, spent, index):
+        return list(self.wallet_stack)
+
+    def wallet_input(self):
+        utxo = self.wallet.get_utxo(confirmed_only=True)
+        return ({"txid": int(utxo["txid"], 16), "vout": utxo["vout"], "value": int(utxo["value"] * COIN),
+                 "script_pubkey": self.wallet.get_output_script()}, self.wallet_witness)
+
+    def spend(self, inputs, *, outputs=None, version=2):
+        tx = CTransaction()
+        tx.version = version
+        tx.vin = [CTxIn(COutPoint(utxo["txid"], utxo["vout"]), b"", 0xfffffffd) for utxo, _ in inputs]
+        total = sum(utxo["value"] for utxo, _ in inputs)
+        tx.vout = outputs if outputs is not None else [CTxOut(total - FEE_SATS, self.wallet.get_output_script())]
+        spent = [CTxOut(utxo["value"], utxo["script_pubkey"]) for utxo, _ in inputs]
+        tx.wit.vtxinwit = [CTxInWitness() for _ in inputs]
+        for index, (_, make) in enumerate(inputs):
+            tx.wit.vtxinwit[index].scriptWitness.stack = make(tx, spent, index)
+        return tx
+
+    def fund(self, script_pubkeys):
+        utxo, witness = self.wallet_input()
+        outputs = [CTxOut(FUND_SATS, spk) for spk in script_pubkeys]
+        outputs.append(CTxOut(utxo["value"] - FUND_SATS * len(outputs) - FEE_SATS, self.wallet.get_output_script()))
+        tx = self.spend([(utxo, witness)], outputs=outputs)
+        self.wallet.sendrawtransaction(from_node=self.nodes[0], tx_hex=tx.serialize().hex())
+        self.mine()
+        return tx, [output(tx, n) for n in range(len(script_pubkeys))]
+
+    def families(self, pq_a, pq_b, slh_root):
+        """Two ML-DSA-44 spends of 0xe2 leaves and a child of both, which go when ML-DSA-44 is disabled;
+        and an SLH-DSA spend of a 0xe2 leaf with an SLH-DSA child, which stays. All in the mempool."""
+        a = self.spend([(self.outs[pq_a], pq_witness())])
+        b = self.spend([(self.outs[pq_b], pq_witness())])
+        child = self.spend([(output(a), self.wallet_witness), (output(b), self.wallet_witness)])
+        slh_parent = self.spend([(self.outs[slh_root], slh_witness())], outputs=[CTxOut(FUND_SATS - FEE_SATS, PQ2.scriptPubKey)])
+        slh_child = self.spend([(output(slh_parent), slh_witness())])
+        for tx in (a, b, child, slh_parent, slh_child):
+            self.accept(tx)
+        return {a.txid_hex, b.txid_hex, child.txid_hex}, {slh_parent.txid_hex, slh_child.txid_hex}
+
+    def rescue_spend(self, utxo, *, corrupt=False):
+        tx = CTransaction()
+        tx.version = 2
+        tx.vin = [CTxIn(COutPoint(utxo["txid"], utxo["vout"]), b"", 0xfffffffd)]
+        tx.vout = [CTxOut(utxo["value"] - FEE_SATS, self.wallet.get_output_script())]
+        spent = [CTxOut(utxo["value"], utxo["script_pubkey"])]
+        leaf = RESCUE.leaves["rescue"]
+        pub = rescue_pub(WALLET_V1_SCHNORR_K, 0, RESCUE_Y)
+        if corrupt:
+            proof = bytes(130218)
+        else:
+            sighash = rescue_sighash(tx, 0, spent, leaf.script, network_id_regtest(), RESCUE_STATEMENT_HMAC, pub, leaf_ver=E2)
+            _, proof = prove(self.prover, WALLET_V1_SCHNORR_K, 0, RESCUE_X, rescue_message(sighash, network_id_regtest(), RESCUE_P))
+        tx.wit.vtxinwit = [CTxInWitness()]
+        tx.wit.vtxinwit[0].scriptWitness.stack = [RESCUE_TOKEN, bytes(leaf.script), leaf.control_block, rescue_annex(proof)]
+        return tx
+
+    def build_block(self, txs, *, node=None, prev=None, nudge=0):
+        node = node or self.nodes[0]
+        prev = prev or node.getbestblockhash()
+        header = node.getblockheader(prev)
+        block = create_block(int(prev, 16), create_coinbase(header["height"] + 1), header["mediantime"] + 1 + nudge, txlist=txs)
+        add_witness_commitment(block)
+        block.solve()
+        return block
+
+    def submit(self, block, expected=None, *, node=None):
+        assert_equal((node or self.nodes[0]).submitblock(block.serialize().hex()), expected)
+
+    def propose(self, block, node=None):
+        return (node or self.nodes[0]).getblocktemplate({"mode": "proposal", "data": block.serialize().hex()})
+
+    def accept(self, tx, node=0):
+        self.nodes[node].sendrawtransaction(tx.serialize().hex(), 0)
+        assert tx.txid_hex in self.nodes[node].getrawmempool()
+
+    def reject(self, tx, reason, node=0):
+        assert_raises_rpc_error(-26, reason, self.nodes[node].sendrawtransaction, tx.serialize().hex(), 0)
+
+    def mempool(self, node=0):
+        return set(self.nodes[node].getrawmempool())
+
+    def lattice(self, node=None):
+        return (node or self.nodes[0]).gettripwireinfo()["lattice"]
+
+    def assert_next(self, *, active, disabled, nodes=None):
+        """The deployment and the state as they apply to the next block."""
+        for node in nodes or [self.nodes[i] for i in (0, 1, 3)]:
+            assert_equal(node.getdeploymentinfo()["deployments"]["p2mr_lattice_tripwire"]["active"], active)
+            assert_equal(self.lattice(node)["mldsa_disabled_next_block"], disabled)
+
+    def assert_state(self, states, disabled, node=None):
+        info = self.lattice(node)
+        assert_equal([tripwire["state"] for tripwire in info["tripwires"]], states)
+        assert_equal(info["mldsa_disabled_next_block"], disabled)
+
+    def spent_log(self, name, tx, block_hash, height, effect):
+        return (f"P2MR lattice tripwire {self.tripwires[name]} spent by {tx.txid_hex} in block {block_hash} (height {height}): "
+                f"OP_CHECKMLDSA44 in leaf version 0xe2 is {effect}")
+
+    def state_log(self, states, checks):
+        outputs = ", ".join(f"{self.tripwires[n]} {state}" for n, state in zip(("L1", "L2", "L3"), states))
+        return f"lattice tripwire outputs {outputs}; ML-DSA-44 checks in leaf version 0xe2 are {checks} for the next block"
