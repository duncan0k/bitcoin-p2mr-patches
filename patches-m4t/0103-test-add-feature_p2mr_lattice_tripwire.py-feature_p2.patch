+    def test_activation(self):
+        n0, n1, n3 = self.nodes[0], self.nodes[1], self.nodes[3]
+        o = self.outs
+        self.mine(H4T - 2 - n0.getblockcount())
+        self.log.info("Tip H4T-2: the mempool turns away spends of 0xe2 leaves at depth one, -acceptnonstdtxn too")
+        self.assert_next(active=False, disabled=False)
+        pq = self.spend([(o["boundary_pq"], pq_witness())])
+        slh = self.spend([(o["boundary_slh"], slh_witness())])
+        s2 = self.spend([(o["s2_relay"], s2_witness)])
+        for node in (0, 1):
+            self.reject(pq, DISCOURAGED, node=node)
+            self.reject(slh, DISCOURAGED, node=node)
+        self.log.info("Policy holds 0xe2 leaves to the limits of 0xc0 leaves at every height, at depth zero too")
+        # Rule 4T-4: a depth-zero spend of leaf version 0xe2 with an 81-byte element is not standard at
+        # every height, before the rules too, as for 0xe0; a node without this series relays it.
+        lone_81 = self.spend([(o["lone_81"], lone_witness(81))])
+        self.reject(lone_81, NONSTANDARD)
+        self.accept(lone_81, node=1)
+        lone = self.spend([(o["lone_1"], lone_witness())])
+        self.accept(lone)
+
+        self.log.info("A block below H4T takes 0xe2 spends that would fail: an invalid signature, a rescue with a bad proof")
+        invalid = self.spend([(o["boundary_invalid"], pq_witness(mutate=flip_bit))])
+        bad_rescue = self.rescue_spend(o["boundary_rescue"], corrupt=True)
+        below = self.build_block([invalid, bad_rescue])
+        self.submit(below)
+        self.sync_main()
+        self.follow_m4r()
+        assert lone_81.txid_hex in self.mempool(1)
+
+        self.log.info("Tip H4T-1: the mempool executes them; S2 is not standard in 0xe2")
+        self.assert_next(active=True, disabled=False)
+        self.accept(pq)
+        self.accept(slh)
+        self.reject(s2, NONSTANDARD)
+        self.accept(s2, node=1)
+        self.log.info("The M4-R node, without the lattice rules, still takes them as unknown leaf versions in a block only")
+        self.reject(pq, DISCOURAGED, node=2)
+
+        self.log.info("A reorg below H4T removes them from both mempools; the m=0 spend stays")
+        for node in (n0, n1):
+            node.invalidateblock(below.hash_hex)
+        self.assert_next(active=False, disabled=False, nodes=[n0, n1])
+        assert not {pq.txid_hex, slh.txid_hex} & self.mempool()
+        assert s2.txid_hex not in self.mempool(1)
+        assert lone.txid_hex in self.mempool()
+        for node in (n0, n1):
+            node.reconsiderblock(below.hash_hex)
+        assert_equal(n0.getbestblockhash(), below.hash_hex)
+        self.accept(pq)
+        self.accept(slh)
+        self.accept(s2, node=1)
+
+        self.log.info("H4T: the ML-DSA-44, SLH-DSA and S2 spends of 0xe2 leaves confirm")
+        with n0.assert_debug_log([f"P2MR lattice tripwire rules active from height {H4T}, reached by block ",
+                                  ": " + self.state_log(["unspent"] * 3, "enabled")]):
+            blockhash = self.mine()[0]
+        block = n0.getblock(blockhash)
+        assert_equal(block["height"], H4T)
+        assert {pq.txid_hex, slh.txid_hex} <= set(block["tx"])
+        self.assert_next(active=True, disabled=False)
+        blockhash = self.generate(n1, 1, sync_fun=self.sync_main)[0]
+        assert s2.txid_hex in n0.getblock(blockhash)["tx"]
+
+        self.log.info("From H4T: an invalid signature fails; a rescue token in place of an ML-DSA-44 signature is no rescue")
+        bad = self.spend([(o["after_bad"], pq_witness(mutate=flip_bit))])
+        self.submit(self.build_block([bad]), "block-script-verify-flag-failed (Invalid ML-DSA-44 signature)")
+        token = self.spend([(o["boundary_token"], token_witness)])
+        self.reject(token, NONSTANDARD)
+        self.submit(self.build_block([token]), "block-script-verify-flag-failed (Invalid ML-DSA-44 signature chunk size)")
+        self.log.info("From H4T the rescue lane of node 0 (open from H3) checks the proof of a rescue in 0xe2")
+        self.submit(self.build_block([self.rescue_spend(o["rescue_bad2"], corrupt=True)]), "block-script-verify-flag-failed (Invalid rescue proof)")
+        item_81 = self.spend([(o["item_81"], item_witness(81))])
+        self.reject(item_81, NONSTANDARD)
+
+        self.log.info("Node 3's rescue lane opens at its own height, above H4T: a valid rescue in 0xe2 waits for both")
+        self.rescue_tx = self.rescue_spend(o["rescue"])
+        proposal = self.build_block([self.rescue_tx], node=n3)
+        assert_equal(self.propose(proposal, node=n3), "block-script-verify-flag-failed (Invalid Schnorr signature size)")
+        assert_equal(self.propose(proposal), None)
+        self.follow_m4r()
+        assert_equal(self.propose(proposal, node=self.nodes[2]), None)
+
+    def test_resurrection(self):
+        self.log.info("Reorg to a branch that spends L3: a parent comes back, its ML-DSA-44 child goes, its SLH-DSA child stays")
+        n0 = self.nodes[0]
+        self.disconnect_main()
+        funds, funds_witness = self.wallet_input()
+        parent = self.spend([(funds, funds_witness)], outputs=[
+            CTxOut(FUND_SATS, PQ2.scriptPubKey), CTxOut(FUND_SATS, PQ2.scriptPubKey),
+            CTxOut(funds["value"] - 2 * FUND_SATS - FEE_SATS, self.wallet.get_output_script())])
+        fork = n0.getbestblockhash()
+        old = self.build_block([parent])
+        self.submit(old)
+        child_pq = self.spend([(output(parent, 0), pq_witness())])
+        grandchild = self.spend([(output(child_pq), self.wallet_witness)])
+        child_slh = self.spend([(output(parent, 1), slh_witness())])
+        for tx in (child_pq, grandchild, child_slh):
+            self.accept(tx)
+
+        # Version 4 keeps the trigger out of the mempool when its branch is disconnected again.
+        trigger = self.spend([(self.tw["L3"], pq_witness(TREE_L3, "pq", key=L3_SEC))], version=4)
+        new = self.build_block([trigger], prev=fork, nudge=1)
+        self.submit(new, "inconclusive")
+        assert_equal(n0.getbestblockhash(), old.hash_hex)
+        height = n0.getblockcount()
+        longer = self.build_block([], prev=new.hash_hex)
+        with n0.assert_debug_log([self.spent_log("L3", trigger, new.hash_hex, height, f"disabled from height {height + 1}")]):
+            self.submit(longer)
+        assert_equal(n0.getbestblockhash(), longer.hash_hex)
+        self.assert_state(["unspent", "unspent", "missing"], True)
+        assert_equal(self.mempool(), {parent.txid_hex, child_slh.txid_hex})
+        template = n0.getblocktemplate({"rules": ["segwit"]})
+        assert_equal({tx["txid"] for tx in template["transactions"]}, {parent.txid_hex, child_slh.txid_hex})
+
+        n0.invalidateblock(new.hash_hex)
+        assert_equal(n0.getbestblockhash(), old.hash_hex)
+        self.assert_state(["unspent"] * 3, False)
+        assert_equal(self.mempool(), {child_slh.txid_hex})
+        self.connect_main()
+        self.mine()
+
+    def test_reorg_onto_same_transactions(self):
+        self.log.info("Reorg whose first block repeats the transactions of the block it replaces, and whose second spends L3")
+        n0 = self.nodes[0]
+        self.disconnect_main()
+        before = self.mempool()
+        fork = n0.getbestblockhash()
+        # Block A confirms a parent, whose child waits in the mempool behind a relative lock of one
+        # block, with lock points that refer to A; next to it, an ML-DSA-44 spend of a 0xe2 leaf.
+        funds, funds_witness = self.wallet_input()
+        parent = self.spend([(funds, funds_witness)])
+        block_a = self.build_block([parent])
+        self.submit(block_a)
+        child = self.spend([(output(parent), self.wallet_witness)])
+        child.vin[0].nSequence = 1
+        pq = self.spend([(self.outs["same_pq"], pq_witness())])
+        for tx in (child, pq):
+            self.accept(tx)
+
+        # B1 has the transactions of A at another time: once it is connected, nothing of A is left to
+        # put back in the mempool. B2 spends L3, so the reorganization ends with ML-DSA-44 disabled;
+        # the mempool is checked after it, not in ConnectTip, and the node does not stop.
+        block_b1 = self.build_block([parent], prev=fork, nudge=1)
+        assert_equal([tx.txid_hex for tx in block_b1.vtx], [tx.txid_hex for tx in block_a.vtx])
+        self.submit(block_b1, "inconclusive")
+        trigger = self.spend([(self.tw["L3"], pq_witness(TREE_L3, "pq", key=L3_SEC))], version=4)
+        block_b2 = self.build_block([trigger], prev=block_b1.hash_hex)
+        self.submit(block_b2)
+        assert_equal(n0.getbestblockhash(), block_b2.hash_hex)
+        self.assert_state(["unspent", "unspent", "missing"], True)
+        assert_equal(self.mempool(), before | {child.txid_hex})
+
+        n0.invalidateblock(block_b1.hash_hex)
+        assert_equal(n0.getbestblockhash(), block_a.hash_hex)
+        self.assert_state(["unspent"] * 3, False)
+        assert pq.txid_hex not in self.mempool()
+        self.connect_main()
+
+    def test_both_tripwires_together(self):
+        n0 = self.nodes[0]
+        o = self.outs
+        self.log.info("D and L2 spent in the same block: one recheck drops the Schnorr and the ML-DSA-44 spends of 0xe2")
+        self.disconnect_main()
+        fork = n0.getbestblockhash()
+        ec = self.spend([(o["one_ec"], ec_witness())])
+        pq = self.spend([(o["one_pq"], pq_witness())])
+        kept = self.spend([(o["one_kept"], slh_witness())])
+        for tx in (ec, pq, kept):
+            self.accept(tx)
+        # Version 4 keeps the trigger spends out of the mempool once their blocks are disconnected.
+        d = self.spend([(self.tw["D"], ec_witness(TREE_D, "csig", key=SEC_D))], version=4)
+        l2 = self.spend([(self.tw["L2"], pq_witness(TREE_L2, "pq", key=L2_SEC))], version=4)
+        both = self.build_block([d, l2])
+        self.submit(both)
+        info = n0.gettripwireinfo()
+        assert_equal((info["ec_disabled_next_block"], info["lattice"]["mldsa_disabled_next_block"]), (True, True))
+        assert_equal(self.mempool(), {kept.txid_hex})
+        n0.invalidateblock(both.hash_hex)
+        assert_equal(n0.getbestblockhash(), fork)
+        info = n0.gettripwireinfo()
+        assert_equal((info["ec_disabled_next_block"], info["lattice"]["mldsa_disabled_next_block"]), (False, False))
+        assert_equal(self.mempool(), {kept.txid_hex})
+
+        self.log.info("D and L2 in adjacent blocks: the first drops the Schnorr spend of 0xe2, the second the ML-DSA-44 one")
+        ec = self.spend([(o["adj_ec"], ec_witness())])
+        pq = self.spend([(o["adj_pq"], pq_witness())])
+        for tx in (ec, pq):
+            self.accept(tx)
+        first = self.build_block([d], nudge=1)
+        self.submit(first)
+        info = n0.gettripwireinfo()
+        assert_equal((info["ec_disabled_next_block"], info["lattice"]["mldsa_disabled_next_block"]), (True, False))
+        assert_equal(self.mempool(), {kept.txid_hex, pq.txid_hex})
+        second = self.build_block([l2])
+        self.submit(second)
+        info = n0.gettripwireinfo()
+        assert_equal((info["ec_disabled_next_block"], info["lattice"]["mldsa_disabled_next_block"]), (True, True))
+        assert_equal(self.mempool(), {kept.txid_hex})
+        n0.invalidateblock(first.hash_hex)
+        assert_equal(n0.getbestblockhash(), fork)
+        self.assert_state(["unspent"] * 3, False)
+        self.connect_main()
+        blockhash = self.mine()[0]
+        assert kept.txid_hex in n0.getblock(blockhash)["tx"]
+
+    def test_trigger(self):
+        n0 = self.nodes[0]
+        o = self.outs
+        self.log.info("Before the trigger: spends of 0xe2 leaves, unconfirmed chains, a package, TRUC, mixed inputs")
+        kept_slh = self.spend([(o["kept_slh"], slh_witness())])
+        gone_pq = self.spend([(o["gone_pq"], pq_witness())])
+        parent_pq = self.spend([(o["parent_pq"], pq_witness())], outputs=[CTxOut(FUND_SATS - FEE_SATS, PQ2.scriptPubKey)])
+        slh_child = self.spend([(output(parent_pq), slh_witness())])
+        truc_pq = self.spend([(o["truc_pq"], pq_witness())], version=3)
+        truc_child = self.spend([(output(truc_pq), self.wallet_witness)], version=3)
+        mixed = self.spend([(o["mixed_pq"], pq_witness()), self.wallet_input()])
+        ec_e2 = self.spend([(o["ec_e2"], ec_witness())])
+        pq_c0 = self.spend([(o["pq_c0"], pq_witness(PQ2_C0))])
+        pq_e0 = self.spend([(o["pq_e0"], pq_witness(PQ2_E0))])
+        for tx in (kept_slh, gone_pq, parent_pq, slh_child, truc_pq, truc_child, mixed, ec_e2, pq_c0, pq_e0):
+            self.accept(tx)
+        package_parent = self.spend([(o["package"], pq_witness())], outputs=[CTxOut(FUND_SATS - FEE_SATS, PQ2.scriptPubKey)])
+        package_child = self.spend([(output(package_parent), slh_witness())])
+        assert_equal(n0.submitpackage([package_parent.serialize().hex(), package_child.serialize().hex()])["package_msg"], "success")
+        self.log.info("Before the trigger: a child of two ML-DSA-44 spends of 0xe2 leaves, and an SLH-DSA-only branch")
+        two_removed, slh_branch = self.families("two_a", "two_b", "slh_branch")
+        self.cache_pq = self.spend([(o["cache_pq"], pq_witness())])
+        # A block with the ML-DSA-44 spend is valid now, which also fills the script cache.
+        assert_equal(self.propose(self.build_block([self.cache_pq])), None)
+
+        self.log.info("A lattice tripwire spend only in the mempool changes nothing")
+        self.trigger = self.spend([(self.tw["L2"], pq_witness(TREE_L2, "pq", key=L2_SEC))])
+        self.accept(self.trigger)
+        self.assert_state(["unspent"] * 3, False)
+        self.before = self.spend([(o["before"], pq_witness())])
+        self.after = self.spend([(o["after"], pq_witness())])
+        self.accept(self.before)
+        self.accept(self.after)
+
+        self.log.info("Neither a proposal nor an invalid candidate that spends L2 logs the spend")
+        block = self.build_block([self.before, self.trigger, self.after])
+        invalid = self.spend([(o["late_slh"], pq_witness(mutate=flip_bit))])
+        with n0.assert_debug_log([], unexpected_msgs=[f"P2MR lattice tripwire {self.tripwires['L2']} spent by"]):
+            assert_equal(self.propose(block), None)
+            self.submit(self.build_block([self.trigger, invalid], nudge=1), "block-script-verify-flag-failed (Invalid ML-DSA-44 signature)")
+
+        self.log.info("Block X spends L2 between two ML-DSA-44 spends of 0xe2 leaves, which are both valid")
+        self.x_height = n0.getblockcount() + 1
+        with n0.assert_debug_log([self.spent_log("L2", self.trigger, block.hash_hex, self.x_height, f"disabled from height {self.x_height + 1}")]):
+            self.submit(block)
+            self.sync_main()
+        self.x_hash = block.hash_hex
+        self.assert_state(["unspent", "missing", "unspent"], True)
+        assert_equal(n0.gettripwireinfo()["ec_disabled_next_block"], False)
+
+        self.log.info("After X the mempool keeps the SLH-DSA, Schnorr and other spends, and drops the ML-DSA-44 ones in 0xe2")
