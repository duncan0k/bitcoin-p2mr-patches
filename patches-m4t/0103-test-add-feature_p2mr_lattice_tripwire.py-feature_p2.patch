+    def test_reorg_over_trigger(self):
+        n0 = self.nodes[0]
+        self.log.info("invalidateblock X: ML-DSA-44 spends of 0xe2 leaves are valid again, X's transactions come back")
+        self.disconnect_main()
+        n0.invalidateblock(self.x_hash)
+        self.assert_state(["unspent"] * 3, False)
+        assert {self.before.txid_hex, self.trigger.txid_hex, self.after.txid_hex} <= self.mempool()
+        kept = self.mempool() - {self.before.txid_hex, self.trigger.txid_hex, self.after.txid_hex}
+        self.accept(self.cache_pq)
+        two_removed, slh_branch = self.families("reorg_a", "reorg_b", "reorg_slh")
+        self.log.info("reconsiderblock X: they fail again, and the mempool drops them after the reorganization, the child of two with them")
+        n0.reconsiderblock(self.x_hash)
+        assert_equal(n0.getbestblockhash(), self.x_hash)
+        self.assert_state(["unspent", "missing", "unspent"], True)
+        assert not two_removed & self.mempool()
+        assert_equal(self.mempool(), kept | slh_branch)
+        self.connect_main()
+        blockhash = self.mine()[0]
+        assert self.kept | {self.late_slh.txid_hex} | slh_branch <= set(n0.getblock(blockhash)["tx"])
