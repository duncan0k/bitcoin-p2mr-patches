+/**
+ * -signetlatticetripwire, in the syntax of -signettripwire (doc/p2mr-lattice-tripwire.md). An outpoint
+ * with a null txid is refused: no output has it, and it is the prevout of every coinbase input.
+ */
+static std::optional<CChainParams::TripwireOptions> ReadLatticeTripwireArg(const ArgsManager& args)
+{
+    auto lattice{ReadTripwireArg(args, "-signetlatticetripwire")};
+    if (!lattice) return std::nullopt;
+    for (const COutPoint& outpoint : lattice->outpoints) {
+        if (outpoint.hash.IsNull()) {
+            throw std::runtime_error(strprintf("-signetlatticetripwire names %s:%u, whose txid is null: no output has it.",
+                                               outpoint.hash.ToString(), outpoint.n));
+        }
+    }
+    return lattice;
+}
