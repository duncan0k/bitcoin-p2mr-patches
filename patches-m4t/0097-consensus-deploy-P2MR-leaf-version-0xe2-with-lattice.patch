+    // their OP_CHECKMLDSA44 checks fail depends on the UTXO set, which ConnectBlock looks at.
+    if (DeploymentActiveAt(block_index, chainman, Consensus::DEPLOYMENT_P2MR) &&
+        DeploymentActiveAt(block_index, chainman, Consensus::DEPLOYMENT_P2MR_LATTICE_TRIPWIRE)) {
+        flags |= SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE;
+    }
+
     // Below the height of the P2MR rescue lane (doc/p2mr-rescue.md), a rescue token is a signature
     // like any other: a restricting flag, lifted at that height, which relaxes the rules (a hard
     // fork). It has nothing to act on where leaves of version 0xe0 do not execute.
