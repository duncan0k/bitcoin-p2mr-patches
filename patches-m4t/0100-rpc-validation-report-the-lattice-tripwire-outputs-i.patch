+++ b/test/functional/feature_p2mr_tripwire.py
@@ -426,6 +426,9 @@ class P2MRTripwireTest(BitcoinTestFramework):
             # The P2MR rescue lane (doc/p2mr-rescue.md) follows the tripwire height on regtest.
             "rescue": {"height": H3, "active_next_block": False, "mempool_accepts": False,
                        "network_id": hashlib.sha256(b"regtest").hexdigest(), "statements": ["01"]},
+            # Leaf version 0xe2 (doc/p2mr-lattice-tripwire.md) follows the tripwire height on regtest
+            # too, without lattice tripwire outputs.
+            "lattice": {"height": H3, "leaf_version": "e2", "tripwires": [], "mldsa_disabled_next_block": False},
         })
         assert_equal(n0.getdeploymentinfo()["deployments"]["p2mr_tripwire"], {"type": "buried", "active": False, "height": H3})
 
