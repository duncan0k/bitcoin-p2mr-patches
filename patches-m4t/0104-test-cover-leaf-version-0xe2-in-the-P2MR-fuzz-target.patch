From 9f343297eb90bfd61f92b763079c26570f9ae6d1 Mon Sep 17 00:00:00 2001
From: duncan0k <dev@ark0.si>
Date: Sat, 31 Oct 2026 09:02:41 +0000
Subject: [PATCH 104/105] test: cover leaf version 0xe2 in the P2MR fuzz
 targets

p2mr_mldsa44 now also builds leaves of version 0xe2 and sets
SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE, SCRIPT_VERIFY_P2MR_MLDSA_DISABLED and
SCRIPT_VERIFY_P2MR_EC_DISABLED at random, and its independent model of the
rules has the new one: in an executed leaf of version 0xe2 with the
restricting flag, a non-empty signature fails as disabled once the weight
and the public key chunks are checked; without the execution flag the leaf
is an unknown leaf version.

p2mr_rescue now also builds the leaves of its rescue checks at version
0xe2 and sets SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE and
SCRIPT_VERIFY_P2MR_MLDSA_DISABLED at random: an elliptic curve check in an
executed leaf of version 0xe2 is rescued, and disabled, as one in 0xe0 is,
and SCRIPT_VERIFY_P2MR_MLDSA_DISABLED changes neither.

p2mr_slhdsa128s now also builds leaves of version 0xe2 and sets
SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE and either or both disable flags at
random: in an executed leaf of version 0xe2, OP_CHECKSLHDSA128S runs with
the rules and order of 0xc0, and neither disable flag ever fails it.

script_flags and p2mr_rescue_script_flags leave the execution flag alone
and fuzz the restricting one since the commit that added them.
---
 src/test/fuzz/p2mr_mldsa44.cpp    | 28 +++++++++++++++++++++++-----
 src/test/fuzz/p2mr_rescue.cpp     | 19 +++++++++++++------
 src/test/fuzz/p2mr_slhdsa128s.cpp | 27 ++++++++++++++++++++++-----
 3 files changed, 58 insertions(+), 16 deletions(-)

diff --git a/src/test/fuzz/p2mr_mldsa44.cpp b/src/test/fuzz/p2mr_mldsa44.cpp
index b77ec5f..acdbc19 100644
--- a/src/test/fuzz/p2mr_mldsa44.cpp
+++ b/src/test/fuzz/p2mr_mldsa44.cpp
@@ -46,7 +46,7 @@ constexpr std::array<uint8_t, 10> HASH_TYPES{0x00, 0x01, 0x02, 0x03, 0x04, 0x80,
 /** The outcome of an executed OP_CHECKMLDSA44 leaf `<pk[0]> <pk[1]> <pk[2]> OP_CHECKMLDSA44`, from the
  *  rules of doc/p2mr-mldsa44.md in their order, written independently of the interpreter. */
 ScriptError ExpectedError(const std::vector<std::vector<unsigned char>>& items, const std::array<size_t, 3>& pubkey_sizes,
-                          int64_t budget, bool valid)
+                          int64_t budget, bool valid, bool disabled)
 {
     // The initial stack may not hold elements over 520 bytes.
     for (const auto& item : items) {
@@ -60,6 +60,9 @@ ScriptError ExpectedError(const std::vector<std::vector<unsigned char>>& items,
     // What is left on the stack below the eight elements the opcode takes.
     const size_t left_below{items.size() - 5};
     if (!signed_check) return left_below == 0 ? SCRIPT_ERR_EVAL_FALSE : SCRIPT_ERR_CLEANSTACK;
+    // Leaf version 0xe2 once a lattice tripwire output is missing (doc/p2mr-lattice-tripwire.md): any
+    // non-empty signature fails, before its chunks are looked at.
+    if (disabled) return SCRIPT_ERR_P2MR_MLDSA_DISABLED;
     for (size_t i = 0; i < 4; ++i) {
         if (sig_chunks[i].size() != 520) return SCRIPT_ERR_MLDSA44_SIG_SIZE;
     }
@@ -92,7 +95,13 @@ FUZZ_TARGET(p2mr_mldsa44)
         leaf << std::vector<unsigned char>(pubkey_sizes[i], provider.ConsumeIntegral<uint8_t>());
     }
     leaf << OP_CHECKMLDSA44;
-    const uint8_t leaf_version{provider.ConsumeIntegralInRange<int>(0, 3) != 0 ? TAPROOT_LEAF_TAPSCRIPT : static_cast<uint8_t>(provider.ConsumeIntegral<uint8_t>() & TAPROOT_LEAF_MASK)};
+    // Mostly 0xc0; now and then 0xe2 (doc/p2mr-lattice-tripwire.md), or any other.
+    uint8_t leaf_version{TAPROOT_LEAF_TAPSCRIPT};
+    switch (provider.ConsumeIntegralInRange<int>(0, 7)) {
+    case 0: leaf_version = static_cast<uint8_t>(provider.ConsumeIntegral<uint8_t>() & TAPROOT_LEAF_MASK); break;
+    case 1: case 2: leaf_version = P2MR_LEAF_LATTICE_TRIPWIRED; break;
+    default: break;
+    }
     // Depth one (a sibling hash in the control block) or depth zero.
     const bool depth_one{provider.ConsumeIntegralInRange<int>(0, 3) != 0};
     std::vector<unsigned char> control{static_cast<unsigned char>(leaf_version | 1)};
@@ -137,9 +146,16 @@ FUZZ_TARGET(p2mr_mldsa44)
 
     const bool active{provider.ConsumeBool()};
     const bool discourage{provider.ConsumeBool()};
+    const bool lattice{provider.ConsumeIntegralInRange<int>(0, 3) != 0};
+    const bool mldsa_disabled{provider.ConsumeBool()};
+    const bool ec_disabled{provider.ConsumeBool()};
     script_verify_flags flags{SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_P2MR};
     if (active) flags |= SCRIPT_VERIFY_P2MR_MLDSA44;
     if (discourage) flags |= SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS;
+    if (lattice) flags |= SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE;
+    if (mldsa_disabled) flags |= SCRIPT_VERIFY_P2MR_MLDSA_DISABLED;
+    // Elliptic curve checks failing changes nothing for OP_CHECKMLDSA44.
+    if (ec_disabled) flags |= SCRIPT_VERIFY_P2MR_EC_DISABLED;
 
     const bool valid{provider.ConsumeBool()};
     const FuzzedMLDSA44Checker checker{&tx, spent.nValue, txdata, valid};
@@ -148,15 +164,17 @@ FUZZ_TARGET(p2mr_mldsa44)
     assert(ret == (serror == SCRIPT_ERR_OK));
 
     ScriptError expected;
-    if (!depth_one || leaf_version != TAPROOT_LEAF_TAPSCRIPT) {
-        // A leaf at depth zero is not executed, and a leaf version other than 0xc0 is an upgradable one.
+    const bool executes{leaf_version == TAPROOT_LEAF_TAPSCRIPT || (leaf_version == P2MR_LEAF_LATTICE_TRIPWIRED && lattice)};
+    if (!depth_one || !executes) {
+        // A leaf at depth zero is not executed, and a leaf version other than 0xc0 is an upgradable
+        // one, 0xe2 too without SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE.
         expected = SCRIPT_ERR_OK;
     } else if (!active) {
         // Without the rules the byte is an OP_SUCCESSx, which overrides everything else.
         expected = discourage ? SCRIPT_ERR_DISCOURAGE_OP_SUCCESS : SCRIPT_ERR_OK;
     } else {
         const int64_t budget{static_cast<int64_t>(::GetSerializeSize(witness.stack)) + VALIDATION_WEIGHT_OFFSET};
-        expected = ExpectedError(items, pubkey_sizes, budget, valid);
+        expected = ExpectedError(items, pubkey_sizes, budget, valid, leaf_version == P2MR_LEAF_LATTICE_TRIPWIRED && mldsa_disabled);
     }
     assert(serror == expected);
 
diff --git a/src/test/fuzz/p2mr_rescue.cpp b/src/test/fuzz/p2mr_rescue.cpp
index bc761f5..687ee92 100644
--- a/src/test/fuzz/p2mr_rescue.cpp
+++ b/src/test/fuzz/p2mr_rescue.cpp
@@ -172,11 +172,12 @@ FUZZ_TARGET(p2mr_rescue)
     case 2: leaf << OP_0 << pubkey << OP_CHECKSIGADD << OP_1 << OP_NUMEQUAL; items = {token}; break;
     default: leaf << pubkey << OP_CHECKSIGVERIFY << pubkey << OP_CHECKSIG; items = {token, token}; break;
     }
-    // Leaf version 0xe0, 0xc0 or another; depth one or zero.
+    // Leaf version 0xe0, 0xc0, 0xe2 (doc/p2mr-lattice-tripwire.md) or another; depth one or zero.
     uint8_t leaf_version{P2MR_LEAF_TRIPWIRED};
     switch (provider.ConsumeIntegralInRange<int>(0, 7)) {
     case 0: leaf_version = TAPROOT_LEAF_TAPSCRIPT; break;
     case 1: leaf_version = static_cast<uint8_t>(provider.ConsumeIntegral<uint8_t>() & TAPROOT_LEAF_MASK); break;
+    case 2: leaf_version = P2MR_LEAF_LATTICE_TRIPWIRED; break;
     default: break;
     }
     const bool depth_one{provider.ConsumeIntegralInRange<int>(0, 7) != 0};
@@ -220,10 +221,14 @@ FUZZ_TARGET(p2mr_rescue)
     txdata.m_p2mr_rescue_network_id = RegtestNetworkId();
 
     const bool tripwire{provider.ConsumeIntegralInRange<int>(0, 7) != 0};
+    const bool lattice{provider.ConsumeIntegralInRange<int>(0, 3) != 0};
     const bool ec_disabled{provider.ConsumeBool()};
     const bool no_rescue{provider.ConsumeIntegralInRange<int>(0, 3) == 0};
     script_verify_flags flags{SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_P2MR};
     if (tripwire) flags |= SCRIPT_VERIFY_P2MR_TRIPWIRE;
+    if (lattice) flags |= SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE;
+    // Disabling ML-DSA-44 changes nothing for elliptic curve checks or rescues.
+    if (provider.ConsumeBool()) flags |= SCRIPT_VERIFY_P2MR_MLDSA_DISABLED;
     if (ec_disabled) flags |= SCRIPT_VERIFY_P2MR_EC_DISABLED;
     if (no_rescue) flags |= SCRIPT_VERIFY_P2MR_NO_RESCUE;
     const bool valid{provider.ConsumeBool()};
@@ -232,18 +237,20 @@ FUZZ_TARGET(p2mr_rescue)
     const bool ret{VerifyScript(CScript{}, spk, &witness, flags, checker, &serror)};
     assert(ret == (serror == SCRIPT_ERR_OK));
 
-    // The rules, written out.
-    const bool executes{depth_one && (leaf_version == TAPROOT_LEAF_TAPSCRIPT || (leaf_version == P2MR_LEAF_TRIPWIRED && tripwire))};
-    const bool rescue{executes && leaf_version == P2MR_LEAF_TRIPWIRED && !no_rescue && parsed.has_value()};
+    // The rules, written out. Leaf version 0xe2 follows 0xe0 for elliptic curve checks, rescues
+    // included, once it executes.
+    const bool tripwired{(leaf_version == P2MR_LEAF_TRIPWIRED && tripwire) || (leaf_version == P2MR_LEAF_LATTICE_TRIPWIRED && lattice)};
+    const bool executes{depth_one && (leaf_version == TAPROOT_LEAF_TAPSCRIPT || tripwired)};
+    const bool rescue{executes && tripwired && !no_rescue && parsed.has_value()};
     if (!executes) {
         assert(serror == SCRIPT_ERR_OK);
     } else if (token.empty()) {
         // An empty signature is no check at all.
         assert(serror != SCRIPT_ERR_P2MR_RESCUE_PROOF && serror != SCRIPT_ERR_P2MR_EC_DISABLED);
     } else if (!rescue) {
-        // A signature: EC disabled in 0xe0, else a Schnorr check, which cannot pass with this element
+        // A signature: EC disabled in 0xe0 or 0xe2, else a Schnorr check, which cannot pass with this element
         // (never 64 or 65 bytes when it is a token; random otherwise).
-        if (leaf_version == P2MR_LEAF_TRIPWIRED && ec_disabled) assert(serror == SCRIPT_ERR_P2MR_EC_DISABLED);
+        if (tripwired && ec_disabled) assert(serror == SCRIPT_ERR_P2MR_EC_DISABLED);
         assert(!ret);
     } else {
         const int64_t budget{static_cast<int64_t>(::GetSerializeSize(witness.stack)) + VALIDATION_WEIGHT_OFFSET};
diff --git a/src/test/fuzz/p2mr_slhdsa128s.cpp b/src/test/fuzz/p2mr_slhdsa128s.cpp
index bbb5c87..050f4ca 100644
--- a/src/test/fuzz/p2mr_slhdsa128s.cpp
+++ b/src/test/fuzz/p2mr_slhdsa128s.cpp
@@ -90,11 +90,12 @@ FUZZ_TARGET(p2mr_slhdsa128s)
     const size_t pubkey_size{size_or_other(SLHDSA128S_PUBKEY_SIZE)};
     CScript leaf;
     leaf << std::vector<unsigned char>(pubkey_size, provider.ConsumeIntegral<uint8_t>()) << OP_CHECKSLHDSA128S;
-    // Leaf version 0xc0, 0xe0 or another.
+    // Leaf version 0xc0, 0xe0, 0xe2 (doc/p2mr-lattice-tripwire.md) or another.
     uint8_t leaf_version{TAPROOT_LEAF_TAPSCRIPT};
-    switch (provider.ConsumeIntegralInRange<int>(0, 5)) {
+    switch (provider.ConsumeIntegralInRange<int>(0, 6)) {
     case 0: leaf_version = P2MR_LEAF_TRIPWIRED; break;
     case 1: leaf_version = static_cast<uint8_t>(provider.ConsumeIntegral<uint8_t>() & TAPROOT_LEAF_MASK); break;
+    case 2: leaf_version = P2MR_LEAF_LATTICE_TRIPWIRED; break;
     default: break;
     }
     // Depth one (a sibling hash in the control block) or depth zero.
@@ -141,12 +142,18 @@ FUZZ_TARGET(p2mr_slhdsa128s)
 
     const bool active{provider.ConsumeBool()};
     const bool tripwire{provider.ConsumeBool()};
+    const bool lattice{provider.ConsumeBool()};
     const bool discourage{provider.ConsumeBool()};
     script_verify_flags flags{SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_P2MR};
     if (active) flags |= SCRIPT_VERIFY_P2MR_SLHDSA128S;
     if (tripwire) flags |= SCRIPT_VERIFY_P2MR_TRIPWIRE;
-    // Disabled elliptic curve checks (doc/p2mr-tripwire.md) never touch OP_CHECKSLHDSA128S.
-    if (provider.ConsumeBool()) flags |= SCRIPT_VERIFY_P2MR_EC_DISABLED;
+    if (lattice) flags |= SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE;
+    // Disabled elliptic curve checks (doc/p2mr-tripwire.md) and disabled ML-DSA-44 checks
+    // (doc/p2mr-lattice-tripwire.md), alone or together, never touch OP_CHECKSLHDSA128S.
+    const bool ec_disabled{provider.ConsumeBool()};
+    const bool mldsa_disabled{provider.ConsumeBool()};
+    if (ec_disabled) flags |= SCRIPT_VERIFY_P2MR_EC_DISABLED;
+    if (mldsa_disabled) flags |= SCRIPT_VERIFY_P2MR_MLDSA_DISABLED;
     if (discourage) flags |= SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS;
 
     const bool valid{provider.ConsumeBool()};
@@ -155,7 +162,10 @@ FUZZ_TARGET(p2mr_slhdsa128s)
     const bool ret{VerifyScript(CScript{}, script_pubkey, &witness, flags, checker, &serror)};
     assert(ret == (serror == SCRIPT_ERR_OK));
 
-    const bool executes{leaf_version == TAPROOT_LEAF_TAPSCRIPT || (leaf_version == P2MR_LEAF_TRIPWIRED && tripwire)};
+    // Leaf version 0xe2 executes as 0xc0 once SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE is set, whatever the
+    // tripwire of 0xe0 and either disable flag say.
+    const bool lattice_leaf{leaf_version == P2MR_LEAF_LATTICE_TRIPWIRED && lattice};
+    const bool executes{leaf_version == TAPROOT_LEAF_TAPSCRIPT || (leaf_version == P2MR_LEAF_TRIPWIRED && tripwire) || lattice_leaf};
     ScriptError expected;
     if (!depth_one || !executes) {
         // A leaf at depth zero is not executed, and another leaf version is an upgradable one.
@@ -163,6 +173,13 @@ FUZZ_TARGET(p2mr_slhdsa128s)
     } else if (!active) {
         // Without the rules the byte is an OP_SUCCESSx, which overrides everything else.
         expected = discourage ? SCRIPT_ERR_DISCOURAGE_OP_SUCCESS : SCRIPT_ERR_OK;
+    } else if (lattice_leaf) {
+        // In leaf version 0xe2 OP_CHECKSLHDSA128S really runs: the same rules in the same order as in
+        // 0xc0, with neither disable flag ever giving SCRIPT_ERR_P2MR_EC_DISABLED or
+        // SCRIPT_ERR_P2MR_MLDSA_DISABLED. It is the fallback once ML-DSA-44 is disabled there.
+        const int64_t budget{static_cast<int64_t>(::GetSerializeSize(witness.stack)) + VALIDATION_WEIGHT_OFFSET};
+        expected = ExpectedError(items, pubkey_size, budget, valid);
+        assert(serror != SCRIPT_ERR_P2MR_EC_DISABLED && serror != SCRIPT_ERR_P2MR_MLDSA_DISABLED);
     } else {
         const int64_t budget{static_cast<int64_t>(::GetSerializeSize(witness.stack)) + VALIDATION_WEIGHT_OFFSET};
         expected = ExpectedError(items, pubkey_size, budget, valid);
