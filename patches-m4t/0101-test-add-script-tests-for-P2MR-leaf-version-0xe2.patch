+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Generate the script_tests.json rows of P2MR leaf version 0xe2 (doc/p2mr-lattice-tripwire.md).
+
+The rows have the format generate_p2mr_script_tests.py describes. Their block goes just
+above the rows of leaf version 0xe0 signed by p2mr-ts (or, without them, above the leaf
+version 0xe0 block), where none of the other generators rewrites it.
+
+The Schnorr, ML-DSA-44 and SLH-DSA-SHA2-128s signatures are real and deterministic, made
+over the transactions script_json_test builds for each row. The rows cover each
+combination of P2MR_LATTICE_TRIPWIRE (the leaf version executes), P2MR_EC_DISABLED (its
+elliptic curve checks fail, as in leaf version 0xe0) and P2MR_MLDSA_DISABLED (its
+OP_CHECKMLDSA44 checks with a non-empty signature fail), and show that the last one
+leaves every other kind of script alone. The elliptic curve rows of leaf version 0xe0
+(generate_p2mr_tripwire_script_tests.py) are repeated for 0xe2: OP_CHECKSIG,
+OP_CHECKSIGVERIFY and OP_CHECKSIGADD, signature sizes and hash types, public key types,
+and which error comes first.
+
+Usage, from the repository root:
+
+    ./test/util/generate_p2mr_lattice_tripwire_script_tests.py            # print the rows
+    ./test/util/generate_p2mr_lattice_tripwire_script_tests.py --inplace  # write them
+
+script_json_test re-runs every row with random flags removed (passing rows) or added
+(failing rows) and requires the outcome to stay. So a passing row that executes a leaf of
+version 0xe2 never lists DISCOURAGE_UPGRADABLE_TAPROOT_VERSION or DISCOURAGE_OP_SUCCESS,
+and a row that fails only because P2MR_LATTICE_TRIPWIRE is absent carries a witness that
+fails once the leaf executes, whatever else is added.
+"""
+
+import argparse
+import hashlib
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "functional"))
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import generate_p2mr_script_tests as p2mr_rows  # noqa: E402
+from generate_p2mr_script_tests import (  # noqa: E402
+    AMOUNT_BTC,
+    AMOUNT_SAT,
+    PUB_A,
+    SEC_A,
+    SEC_B,
+    row,
+    sign,
+    spending_tx,
+)
+from test_framework.p2mr import p2mr_construct  # noqa: E402
+from test_framework.p2mr_mldsa44 import (  # noqa: E402
+    OP_CHECKMLDSA44,
+    mldsa44_keygen,
+    mldsa44_leaf,
+    mldsa44_sig_chunks,
+    mldsa44_sighash,
+    mldsa44_sign,
+)
+from test_framework.p2mr_slhdsa128s import (  # noqa: E402
+    OP_CHECKSLHDSA128S,
+    slhdsa128s_keygen,
+    slhdsa128s_leaf,
+    slhdsa128s_sig_chunks,
+    slhdsa128s_sighash,
+    slhdsa128s_sign,
+)
+from test_framework.p2mr_tripwire import LEAF_VERSION_TRIPWIRED  # noqa: E402
+from test_framework.script import (  # noqa: E402
+    CScript,
+    LEAF_VERSION_TAPSCRIPT,
+    OP_0,
+    OP_1,
+    OP_2,
+    OP_CHECKSIG,
+    OP_CHECKSIGADD,
+    OP_CHECKSIGVERIFY,
+    OP_DROP,
+    OP_DUP,
+    OP_EQUAL,
+    OP_NOT,
+    OP_RETURN,
+    OP_VERIFY,
+    SIGHASH_ALL,
+    SIGHASH_DEFAULT,
+    taproot_construct,
+)
+
+BLOCK_HEADER = '["P2MR leaf version 0xe2 tests (doc/p2mr-lattice-tripwire.md)"],'
+# The blocks this one goes above, the nearest first.
+ANCHORS = ('\n["P2MR tripwired leaf (version 0xe0) rows signed by p2mr-ts',
+           '\n["P2MR leaf version 0xe0 tests',
+           '\n["P2MR OP_CHECKMLDSA44 rows signed by p2mr-ts',
+           '\n["P2MR OP_CHECKMLDSA44 tests',
+           '\n["P2MR (BIP-360) tests',
+           '\n["The End"]')
+
+FLAGS_BASE = "P2SH,WITNESS,TAPROOT,P2MR,P2MR_MLDSA44,P2MR_TRIPWIRE,P2MR_SLHDSA128S"
+FLAGS_LT = FLAGS_BASE + ",P2MR_LATTICE_TRIPWIRE"
+FLAGS_EC = FLAGS_LT + ",P2MR_EC_DISABLED"
+FLAGS_ML = FLAGS_LT + ",P2MR_MLDSA_DISABLED"
+FLAGS_BOTH = FLAGS_LT + ",P2MR_EC_DISABLED,P2MR_MLDSA_DISABLED"
+
+PQ_PUB, PQ_SEC = mldsa44_keygen(hashlib.sha256(b"p2mr lattice tripwire script_tests key").digest())
+SLH_PUB, SLH_SEC = slhdsa128s_keygen(hashlib.sha512(b"p2mr lattice tripwire script_tests slh key").digest()[:48])
+
+E0 = LEAF_VERSION_TRIPWIRED
+E2 = 0xe2
+LEAF_CSIG = CScript([PUB_A, OP_CHECKSIG])
+LEAF_FAIL = CScript([OP_RETURN])
+S1 = mldsa44_leaf(PQ_PUB)
+S2 = mldsa44_leaf(PQ_PUB, PUB_A)
+SLH1 = slhdsa128s_leaf(SLH_PUB)
+# ML-DSA-44 AND SLH-DSA in one leaf: the ML-DSA-44 check, then the SLH-DSA one.
+AND_LEAF = CScript(list(S1)[:-1] + [OP_CHECKMLDSA44, OP_VERIFY, SLH_PUB, OP_CHECKSLHDSA128S])
+# Signature chunks that only have the right sizes: what a check does with them depends on the flags.
+JUNK_CHUNKS = [b"\x01" * 520] * 4 + [b"\x01" * 340]
+JUNK_SIG = b"\x01" * 64
+KEY_33 = b"\x02" + b"\x03" * 32
+
+
+def tree(leaf, leaf_ver=E2):
+    """The leaf at depth one, next to a leaf that can only fail."""
+    return p2mr_construct([("x", leaf, leaf_ver), ("fail", LEAF_FAIL)])
+
+
+def leaf_row(stack, leaf, flags, error, comment, *, leaf_ver=E2, extra=()):
+    """A row spending `leaf` of the tree tree(leaf, leaf_ver) with `stack` below the leaf."""
+    t = tree(leaf, leaf_ver)
+    return row(list(stack) + [bytes(leaf), t.leaves["x"].control_block] + list(extra), t.scriptPubKey, flags, error,
+               f"P2MR_LATTICE_TRIPWIRE: {comment}")
+
+
+def schnorr(leaf, *, leaf_ver=E2, sign_ver=None, sec=SEC_A, hash_type=SIGHASH_DEFAULT):
+    """A BIP 340 signature for spending `leaf` of tree(leaf, leaf_ver), over the message of the leaf at
+    version sign_ver (by default its own)."""
+    t = tree(leaf, leaf_ver)
+    return sign(t.scriptPubKey, [], leaf, sec, hash_type=hash_type, leaf_ver=leaf_ver if sign_ver is None else sign_ver)
+
+
+def pq_sig(leaf, *, leaf_ver=E2, sign_ver=None):
+    """The ML-DSA-44 signature for spending `leaf` of tree(leaf, leaf_ver)."""
+    t = tree(leaf, leaf_ver)
+    spend, spent = spending_tx(t.scriptPubKey, [])
+    return mldsa44_sign(PQ_SEC, mldsa44_sighash(spend, spent, 0, leaf, leaf_ver=leaf_ver if sign_ver is None else sign_ver))
+
+
+def pq_chunks(leaf, **kwargs):
+    return mldsa44_sig_chunks(pq_sig(leaf, **kwargs))
+
+
+def slh_chunks(leaf, *, leaf_ver=E2, sign_ver=None):
+    """The SLH-DSA-SHA2-128s signature chunks for spending `leaf` of tree(leaf, leaf_ver), over the message
+    of the leaf at version sign_ver (by default its own)."""
+    t = tree(leaf, leaf_ver)
+    spend, spent = spending_tx(t.scriptPubKey, [])
+    msg = slhdsa128s_sighash(spend, spent, 0, leaf, leaf_ver=leaf_ver if sign_ver is None else sign_ver)
+    return slhdsa128s_sig_chunks(slhdsa128s_sign(SLH_SEC, msg))
+
+
+def witness_size(stack):
+    """GetSerializeSize of a witness stack."""
+    def compact(n):
+        return 1 if n < 253 else 3 if n <= 0xffff else 5
+    return compact(len(stack)) + sum(compact(len(e)) + len(e) for e in stack)
+
+
+def budget_rows():
+    """A leaf whose 33-byte key checks leave 249 of budget for OP_CHECKMLDSA44, which takes 250 with a
+    non-empty signature, and the same leaf with more witness: validation weight is charged before
+    the check fails as disabled.
+
+    The budget is the witness size plus 50, and each check with a signature takes 50. The leaf starts
+    with a padding push that is dropped, whose length tunes the witness size, then checks one
+    signature against a 33-byte key k times, drops it, and runs OP_CHECKMLDSA44 on five one-byte
+    signature chunks.
+    """
+    chunks = [b"\x01"] * 5
+    pk_pushes = list(S1)[:-1]
+
+    def leaf(pad, k):
+        return CScript([bytes(pad), OP_DROP] + [OP_DUP, KEY_33, OP_CHECKSIGVERIFY] * k + [OP_DROP] + pk_pushes + [OP_CHECKMLDSA44])
+
+    def left_before_check(script, k):
+        return witness_size(chunks + [JUNK_SIG, bytes(script), bytes(33)]) + 50 - 50 * k
+
+    pad, k = next((pad, k) for k in range(2, 200) for pad in range(1, 76) if left_before_check(leaf(pad, k), k) == 249)
+    short, roomy = leaf(pad, k), leaf(pad + 1, k)
+    assert left_before_check(short, k) == 249 and left_before_check(roomy, k) == 250
+    return [
+        leaf_row(chunks + [JUNK_SIG], short, FLAGS_ML, "TAPSCRIPT_VALIDATION_WEIGHT",
+                 f"{k} checks with a 33-byte key leave 249 of budget: OP_CHECKMLDSA44 fails on weight first"),
+        leaf_row(chunks + [JUNK_SIG], roomy, FLAGS_ML, "P2MR_MLDSA_DISABLED",
+                 f"the same {k} checks with one more byte of budget: OP_CHECKMLDSA44 fails as disabled"),
+        leaf_row(chunks + [JUNK_SIG], roomy, FLAGS_LT, "MLDSA44_SIG_SIZE",
+                 f"the same {k} checks with one more byte of budget, without P2MR_MLDSA_DISABLED: the chunk sizes"),
+    ]
+
+
+def ec_budget_rows():
+    """As for leaf version 0xe0: a leaf whose 33-byte key checks use up the budget just before its
+    32-byte key check, and the same leaf with 50 more bytes of witness. Validation weight is charged
+    before the check fails as disabled."""
+    def leaf(pad, k):
+        return CScript([bytes(pad), OP_DROP] + [OP_DUP, KEY_33, OP_CHECKSIGVERIFY] * k + [PUB_A, OP_CHECKSIG])
+
+    def left_before_last(script, k):
+        return witness_size([JUNK_SIG, bytes(script), bytes(33)]) + 50 - 50 * k
+
+    pad, k = next((pad, k) for k in range(2, 30) for pad in range(1, 76) if left_before_last(leaf(pad, k), k) == 0)
+    short, roomy = leaf(pad, k), leaf(pad + 50, k)
+    assert left_before_last(short, k) == 0 and 50 <= left_before_last(roomy, k) < 100
+    return [
+        leaf_row([JUNK_SIG], short, FLAGS_EC, "TAPSCRIPT_VALIDATION_WEIGHT",
+                 f"{k} checks with a 33-byte key use up the budget: the 32-byte key check fails on weight first"),
+        leaf_row([JUNK_SIG], roomy, FLAGS_EC, "P2MR_EC_DISABLED",
+                 f"the same {k} checks with 50 more bytes of budget: the 32-byte key check fails as disabled"),
+    ]
+
+
+def ec_rows():
+    """The elliptic curve rows of leaf version 0xe0 in a leaf of version 0xe2: P2MR_EC_DISABLED there
+    fails a check with a 32-byte key and a non-empty signature, after everything a check reads
+    before the signature, and leaves the rest alone. With P2MR_MLDSA_DISABLED too nothing changes."""
+    rows = []
+    leaf_not = CScript([PUB_A, OP_CHECKSIG, OP_NOT])
+    leaf_verify = CScript([PUB_A, OP_CHECKSIGVERIFY, OP_1])
+    leaf_add0 = CScript([OP_0, PUB_A, OP_CHECKSIGADD, OP_1, OP_EQUAL])
+    leaf_add0_empty = CScript([OP_0, PUB_A, OP_CHECKSIGADD, OP_0, OP_EQUAL])
+    leaf_add1 = CScript([OP_1, PUB_A, OP_CHECKSIGADD, OP_2, OP_EQUAL])
+    leaf_add_overflow = CScript([b"\x01\x00\x00\x00\x00", PUB_A, OP_CHECKSIGADD])
+    leaf_empty_key = CScript([OP_0, OP_CHECKSIG])
+    leaf_key33 = CScript([KEY_33, OP_CHECKSIG])
+    valid = schnorr(LEAF_CSIG)
+    wrong = schnorr(LEAF_CSIG, sec=SEC_B)
+    for flags, ec, tag in ((FLAGS_LT, False, "EC rows: "), (FLAGS_EC, True, "EC rows: with P2MR_EC_DISABLED, "),
+                           (FLAGS_BOTH, True, "EC rows: with both disabled, ")):
+        def expect(error):
+            return "P2MR_EC_DISABLED" if ec else error
+
+        rows.append(leaf_row([valid], LEAF_CSIG, flags, expect("OK"), f"{tag}a valid signature, SIGHASH_DEFAULT"))
+        rows.append(leaf_row([schnorr(LEAF_CSIG, hash_type=SIGHASH_ALL)], LEAF_CSIG, flags, expect("OK"),
+                             f"{tag}a valid signature, SIGHASH_ALL"))
+        rows.append(leaf_row([wrong], LEAF_CSIG, flags, expect("SCHNORR_SIG"), f"{tag}a signature by another key"))
+        rows.append(leaf_row([valid[:63]], LEAF_CSIG, flags, expect("SCHNORR_SIG_SIZE"), f"{tag}a 63-byte signature"))
+        rows.append(leaf_row([valid + b"\x00"], LEAF_CSIG, flags, expect("SCHNORR_SIG_HASHTYPE"),
+                             f"{tag}an explicit SIGHASH_DEFAULT byte"))
+        rows.append(leaf_row([valid + b"\x04"], LEAF_CSIG, flags, expect("SCHNORR_SIG_HASHTYPE"), f"{tag}hash type 0x04"))
+        rows.append(leaf_row([valid + b"\x01" * 456], LEAF_CSIG, flags, expect("SCHNORR_SIG_SIZE"), f"{tag}a 520-byte signature"))
+        rows.append(leaf_row([valid + b"\x01" * 457], LEAF_CSIG, flags, "PUSH_SIZE",
+                             f"{tag}a 521-byte signature fails before the script runs"))
+        rows.append(leaf_row([schnorr(leaf_not)], leaf_not, flags, expect("EVAL_FALSE"),
+                             f"{tag}OP_NOT after a check with a valid signature"))
+        rows.append(leaf_row([schnorr(leaf_not, sec=SEC_B)], leaf_not, flags, expect("SCHNORR_SIG"),
+                             f"{tag}OP_NOT after a check with an invalid signature"))
+        rows.append(leaf_row([b""], leaf_not, flags, "OK", f"{tag}an empty signature pushes false"))
+        rows.append(leaf_row([b""], LEAF_CSIG, flags, "EVAL_FALSE", f"{tag}an empty signature pushes false, which fails"))
+        rows.append(leaf_row([schnorr(leaf_verify)], leaf_verify, flags, expect("OK"), f"{tag}OP_CHECKSIGVERIFY"))
+        rows.append(leaf_row([schnorr(leaf_verify, sec=SEC_B)], leaf_verify, flags, expect("SCHNORR_SIG"),
+                             f"{tag}OP_CHECKSIGVERIFY with an invalid signature"))
+        rows.append(leaf_row([b""], leaf_verify, flags, "CHECKSIGVERIFY", f"{tag}OP_CHECKSIGVERIFY with an empty signature"))
+        rows.append(leaf_row([schnorr(leaf_add0)], leaf_add0, flags, expect("OK"), f"{tag}OP_CHECKSIGADD from 0"))
+        rows.append(leaf_row([schnorr(leaf_add1)], leaf_add1, flags, expect("OK"), f"{tag}OP_CHECKSIGADD from 1"))
+        rows.append(leaf_row([schnorr(leaf_add0, sec=SEC_B)], leaf_add0, flags, expect("SCHNORR_SIG"),
+                             f"{tag}OP_CHECKSIGADD with an invalid signature"))
+        rows.append(leaf_row([b""], leaf_add0_empty, flags, "OK", f"{tag}OP_CHECKSIGADD with an empty signature adds nothing"))
+        rows.append(leaf_row([schnorr(leaf_add_overflow)], leaf_add_overflow, flags, "SCRIPTNUM",
+                             f"{tag}OP_CHECKSIGADD reads a 5-byte number before the signature"))
