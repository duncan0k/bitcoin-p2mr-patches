+    // mempool.
+    if (!DeploymentActiveAfter(tip, chainman, Consensus::DEPLOYMENT_P2MR_LATTICE_TRIPWIRE)) {
+        flags &= ~SCRIPT_VERIFY_P2MR_LATTICE_TRIPWIRE;
+    }
