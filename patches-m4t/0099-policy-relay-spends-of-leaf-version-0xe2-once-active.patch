+/** Whether an input of the transaction spends a P2MR output through a leaf of version 0xe2 at depth
+ *  one or more, which executes once the P2MR lattice tripwire rules apply
+ *  (doc/p2mr-lattice-tripwire.md). What the mempool removes when a reorganization goes back below
+ *  their height. */
+static bool SpendsP2MRLatticeTripwiredLeaf(const CTransaction& tx, const CCoinsView& view)
+{
+    return SpendsP2MRLeaf(tx, view, [](uint8_t leaf_version, std::span<const unsigned char>) {
+        return leaf_version == P2MR_LEAF_LATTICE_TRIPWIRED;
+    });
+}
+
+/** Whether an input of the transaction spends a P2MR output through a leaf of version 0xe0 or 0xe2 at
+ *  depth one or more: the leaves whose checks a tripwire can disable, elliptic curve checks in both
+ *  (doc/p2mr-tripwire.md), ML-DSA-44 checks in 0xe2 (doc/p2mr-lattice-tripwire.md). What the mempool
+ *  checks again when one of the two states turns. */
+static bool SpendsP2MRDisablableLeaf(const CTransaction& tx, const CCoinsView& view)
+{
+    return SpendsP2MRLeaf(tx, view, [](uint8_t leaf_version, std::span<const unsigned char>) {
+        return leaf_version == P2MR_LEAF_TRIPWIRED || leaf_version == P2MR_LEAF_LATTICE_TRIPWIRED;
+    });
+}
+
