+
     std::string operator()(const WitnessUnknown& id) const
     {
         const std::vector<unsigned char>& program = id.GetWitnessProgram();
@@ -181,6 +189,13 @@ CTxDestination DecodeDestination(const std::string& str, const CChainParams& par
                 return tap;
             }
 
+            if (version == 2 && data.size() == WITNESS_V2_P2MR_SIZE) {
+                static_assert(WITNESS_V2_P2MR_SIZE == uint256::size());
+                WitnessV2P2MR merkle_root;
+                std::copy(data.begin(), data.end(), merkle_root.begin());
+                return merkle_root;
+            }
+
             if (CScript::IsPayToAnchor(version, data)) {
                 return PayToAnchor();
