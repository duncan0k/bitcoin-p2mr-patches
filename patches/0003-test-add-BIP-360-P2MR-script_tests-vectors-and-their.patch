index 0000000..440162c
--- /dev/null
+++ b/test/functional/test_framework/p2mr.py
@@ -0,0 +1,171 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026-present The Bitcoin Core developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Helpers for constructing BIP-360 Pay-to-Merkle-Root (P2MR) outputs.
+
+A P2MR output is a native SegWit version 2 output with a 32-byte witness
+program that *is* the Merkle root of a script tree:
+
+    scriptPubKey: OP_2 OP_PUSHBYTES_32 <merkle root>
+
+The script tree is hashed exactly as in BIP-341 (TapLeaf/TapBranch tagged
+hashes, lexicographically sorted branches), so the helpers below deliberately
+mirror taproot_tree_helper() in script.py. P2MR differs in that there is no
+internal public key, no output tweak and therefore no key path spend: the
+Merkle root is compared directly against the witness program.
+
+The control block is 1 + 32*m bytes rather than 33 + 32*m:
+
+    c = bytes([leaf_version | 1]) + path[0] + ... + path[m-1]
+
+The low bit of c[0] is unused by the leaf version (v = c[0] & 0xfe) and must
+be set to 1, so that an implementation which wrongly reads the leaf version as
+c[0] instead of c[0] & 0xfe errors out immediately (BIP-360 script validation,
+footnote on c[0]).
+
+Reference: bip-0360.mediawiki v0.12.1, bitcoin/bips commit
+620871a7a442e276a058b487cd8743775fb499a4.
+"""
+
+from collections import namedtuple
+
+from .key import TaggedHash
+from .messages import ser_string
+from .script import CScript, LEAF_VERSION_TAPSCRIPT, OP_2
+from .segwit_addr import encode_segwit_address
+
+# Witness version used by P2MR outputs.
+P2MR_WITNESS_VERSION = 2
+# Size of the witness program (== size of the Merkle root).
+P2MR_PROGRAM_SIZE = 32
+# Control block: 1 leading byte, then 0..128 inner nodes of 32 bytes each.
+P2MR_CONTROL_BASE_SIZE = 1
+P2MR_CONTROL_NODE_SIZE = 32
+P2MR_CONTROL_MAX_NODE_COUNT = 128
+P2MR_CONTROL_MAX_SIZE = P2MR_CONTROL_BASE_SIZE + P2MR_CONTROL_NODE_SIZE * P2MR_CONTROL_MAX_NODE_COUNT
+# First byte of the annex, shared with BIP-341.
+ANNEX_TAG = 0x50
+# Mask selecting the leaf version out of the control block's first byte.
+P2MR_LEAF_MASK = 0xfe
+
+# A P2MRLeafInfo describes one leaf of a P2MR script tree:
+# - name: the caller supplied identifier (may be None)
+# - script: the leaf script (CScript or bytes)
+# - leaf_ver: the leaf version (even; 0xc0 for BIP-342 tapscript)
+# - merklebranch: the Merkle path from this leaf to the root (32*m bytes)
+# - leaf_hash: hash_TapLeaf(leaf_ver || compact_size(len(script)) || script)
+# - control_block: bytes([leaf_ver | 1]) + merklebranch
+P2MRLeafInfo = namedtuple("P2MRLeafInfo", "name,script,leaf_ver,merklebranch,leaf_hash,control_block")
+
+# A P2MRInfo describes a whole P2MR output:
+# - scriptPubKey: the scriptPubKey (witness v2 CScript)
+# - merkle_root: the script tree's Merkle root (32 bytes)
+# - leaves: dict of name -> P2MRLeafInfo for all named leaves
+# - leaf_list: all leaves in tree order, including unnamed and duplicate ones
+P2MRInfo = namedtuple("P2MRInfo", "scriptPubKey,merkle_root,leaves,leaf_list")
+
+
+def p2mr_tapleaf_hash(leaf_ver, script):
+    """Compute the tapleaf hash of a leaf, as in BIP-341/BIP-360."""
+    assert leaf_ver & 1 == 0, "leaf versions are even; the control block sets the low bit"
+    return TaggedHash("TapLeaf", bytes([leaf_ver]) + ser_string(bytes(script)))
+
+
+def p2mr_tapbranch_hash(a, b):
+    """Combine two node hashes, lexicographically sorted as in BIP-341."""
+    assert len(a) == P2MR_CONTROL_NODE_SIZE and len(b) == P2MR_CONTROL_NODE_SIZE
+    return TaggedHash("TapBranch", a + b if a < b else b + a)
+
+
+def p2mr_control_block(leaf_ver, merklebranch):
+    """Build the control block for a leaf version and Merkle path."""
+    assert leaf_ver & 1 == 0
+    assert leaf_ver == leaf_ver & P2MR_LEAF_MASK
+    assert len(merklebranch) % P2MR_CONTROL_NODE_SIZE == 0
+    return bytes([leaf_ver | 1]) + merklebranch
+
+
+def p2mr_root_from_path(leaf_hash, path):
+    """Fold a leaf hash with a Merkle path (a list of 32-byte nodes) into a root.
+
+    This is the verifier's computation. Use it to build control blocks for
+    Merkle paths that no realistic script tree would produce, such as the
+    maximum depth of 128.
+    """
+    k = leaf_hash
+    for node in path:
+        k = p2mr_tapbranch_hash(k, node)
+    return k
+
+
+def p2mr_script_pubkey(merkle_root):
+    """Build the P2MR scriptPubKey committing to a Merkle root."""
+    assert len(merkle_root) == P2MR_PROGRAM_SIZE
+    return CScript([OP_2, merkle_root])
+
+
+def p2mr_address(merkle_root, hrp="bcrt"):
+    """Encode a P2MR output as a bech32m witness v2 address."""
+    assert len(merkle_root) == P2MR_PROGRAM_SIZE
+    return encode_segwit_address(hrp, P2MR_WITNESS_VERSION, merkle_root)
+
+
+def p2mr_tree_helper(scripts):
+    """Compute (leaf list, Merkle root) for a P2MR script tree.
+
+    scripts is a list of items; each item is either:
+             - a (name, CScript or bytes, leaf version) tuple
+             - a (name, CScript or bytes) tuple (defaulting to leaf version 0xc0)
+             - another list of items (with the same structure)
+
+    The splitting and hashing rules are those of taproot_tree_helper() in
+    script.py, so the two agree on any tree they can both express. Unlike that
+    helper this one returns a list rather than folding leaves into a dict, so
+    trees with repeated leaf scripts stay distinguishable.
+    """
+    if len(scripts) == 0:
+        return ([], bytes())
+    if len(scripts) == 1:
+        script = scripts[0]
+        if isinstance(script, list):
+            return p2mr_tree_helper(script)
+        assert isinstance(script, tuple)
+        name = script[0]
+        code = script[1]
+        leaf_ver = script[2] if len(script) == 3 else LEAF_VERSION_TAPSCRIPT
+        assert isinstance(code, bytes)
+        h = p2mr_tapleaf_hash(leaf_ver, code)
+        return ([(name, code, leaf_ver, bytes(), h)], h)
+    split_pos = len(scripts) // 2
+    left, left_h = p2mr_tree_helper(scripts[:split_pos])
+    right, right_h = p2mr_tree_helper(scripts[split_pos:])
+    left = [(name, code, ver, branch + right_h, leaf) for name, code, ver, branch, leaf in left]
+    right = [(name, code, ver, branch + left_h, leaf) for name, code, ver, branch, leaf in right]
+    return (left + right, p2mr_tapbranch_hash(left_h, right_h))
+
+
+def p2mr_construct(scripts):
+    """Construct a P2MR output from a tree of spending conditions.
+
+    scripts: a list of items as accepted by p2mr_tree_helper().
+
+    Returns: a P2MRInfo object.
+
+    Note that a single-leaf tree yields m == 0, which BIP-360 makes
+    anyone-can-spend: the leaf script is never executed. Wallets must not hand
+    out such an address.
+    """
+    ret, root = p2mr_tree_helper(scripts)
+    assert len(ret) > 0, "a P2MR output commits to a script tree with at least one leaf"
+    leaf_list = [
+        P2MRLeafInfo(name, code, ver, branch, leaf, p2mr_control_block(ver, branch))
+        for name, code, ver, branch, leaf in ret
+    ]
+    leaves = {}
+    for leaf in leaf_list:
+        if leaf.name is None:
+            continue
+        assert leaf.name not in leaves, f"duplicate leaf name {leaf.name!r}"
+        leaves[leaf.name] = leaf
+    return P2MRInfo(p2mr_script_pubkey(root), root, leaves, leaf_list)
