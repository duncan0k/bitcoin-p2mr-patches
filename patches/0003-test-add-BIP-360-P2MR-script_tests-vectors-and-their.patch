new file mode 100755
index 0000000..8f88b1a
--- /dev/null
+++ b/test/util/generate_p2mr_script_tests.py
@@ -0,0 +1,484 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026-present The Bitcoin Core developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Generate the BIP-360 P2MR entries of src/test/data/script_tests.json.
+
+Every entry is a script_tests.json row of the shape
+
+    [[<witness hex>..., <amount>], "<scriptSig>", "<scriptPubKey>",
+     "<FLAGS>", "<EXPECTED_ERROR>", "<comment>"]
+
+as consumed by script_json_test in src/test/script_tests.cpp. The Schnorr
+signatures are real: the crediting and spending transactions that
+BuildCreditingTransaction()/BuildSpendingTransaction() derive from each row are
+rebuilt here bit for bit, so the BIP-341 signature message can be computed over
+them with the functional test framework's TaprootSignatureHash().
+
+Usage, from the repository root:
+
+    ./test/util/generate_p2mr_script_tests.py            # print the entries
+    ./test/util/generate_p2mr_script_tests.py --inplace  # splice them into
+                                                         # script_tests.json
+
+Regenerating is deterministic: the private keys are fixed and
+sign_schnorr() derives its nonce from the message with a zero auxiliary value.
+
+Notes for whoever maintains the consensus side:
+
+  * The rows that set the P2MR flag need SCRIPT_VERIFY_P2MR registered in
+    ScriptFlagNamesToEnum() (src/script/interpreter.cpp), otherwise
+    ParseScriptFlags() reports an unknown flag and drops it.
+  * script_json_test re-runs every row 256 times with random flags added
+    (failing rows) or removed (passing rows) and requires the pass/fail
+    outcome to be unchanged. Two consequences are baked into the rows below:
+      - a passing row may not list TAPROOT as load bearing, because the subset
+        without it must still pass, i.e. SCRIPT_VERIFY_P2MR must be honoured
+        independently of SCRIPT_VERIFY_TAPROOT;
+      - a row that must fail only because P2MR is *not* set cannot carry a
+        witness that is a valid P2MR spend, since adding P2MR would make it
+        pass. Those rows use a witness that is invalid under P2MR as well.
+  * CONTROL_PARITY_ERROR below names the error a control block with the low bit
+    of c[0] cleared must produce. BIP-360 gives that rule no error of its own;
+    this generator reuses TAPROOT_WRONG_CONTROL_SIZE (a malformed control
+    block). Change the one constant if the implementation adds a dedicated
+    SCRIPT_ERR_P2MR_* code instead.
+"""
+
+import argparse
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "functional"))
+
+from test_framework.key import compute_xonly_pubkey, sign_schnorr  # noqa: E402
+from test_framework.messages import (  # noqa: E402
+    COutPoint,
+    CTransaction,
+    CTxIn,
+    CTxOut,
+    SEQUENCE_FINAL,
+)
+from test_framework.p2mr import (  # noqa: E402
+    ANNEX_TAG,
+    P2MR_CONTROL_MAX_NODE_COUNT,
+    P2MR_CONTROL_NODE_SIZE,
+    p2mr_construct,
+    p2mr_root_from_path,
+    p2mr_script_pubkey,
+    p2mr_tapleaf_hash,
+)
+from test_framework.script import (  # noqa: E402
+    CScript,
+    LEAF_VERSION_TAPSCRIPT,
+    OP_1,
+    OP_CHECKSIG,
+    OP_CODESEPARATOR,
+    OP_RETURN,
+    SIGHASH_ALL,
+    SIGHASH_ANYONECANPAY,
+    SIGHASH_DEFAULT,
+    OP_2,
+    SIGHASH_SINGLE,
+    TaprootSignatureHash,
+    taproot_construct,
+)
+
+# Error name for "the low bit of c[0] is not set". See the module docstring.
+CONTROL_PARITY_ERROR = "TAPROOT_WRONG_CONTROL_SIZE"
+
+# Flag string for rows validated with the P2MR consensus rules active. TAPROOT
+# is listed because a real node sets both, not because P2MR depends on it.
+FLAGS_P2MR = "P2SH,WITNESS,TAPROOT,P2MR"
+# Flag string for rows that model a node without the P2MR rules.
+FLAGS_NO_P2MR = "P2SH,WITNESS,TAPROOT"
+
+# Value of the output being spent, in BTC, matching the taproot rows in
+# script_tests.json.
+AMOUNT_BTC = 0.00000001
+AMOUNT_SAT = 1
+
+# An upgraded leaf version: even, and not 0xc0, so the script is never run.
+LEAF_VERSION_FUTURE = 0xfa
+# OP_SUCCESS187, which makes any script containing it succeed under 0xc0.
+OP_SUCCESS187 = 0xbb
+# No OP_CODESEPARATOR was executed.
+NO_CODESEPARATOR = 0xffffffff
+
+SEC_A = bytes(range(1, 33))
+SEC_B = bytes(range(33, 65))
+PUB_A = compute_xonly_pubkey(SEC_A)[0]
+PUB_B = compute_xonly_pubkey(SEC_B)[0]
+
+# Leaf scripts. LEAF_CODESEP executes OP_CODESEPARATOR as its opcode 0, so the
+# signature message commits to a codeseparator position of 0.
+LEAF_CSIG = CScript([PUB_A, OP_CHECKSIG])
+LEAF_RETURN = CScript([OP_RETURN])
+LEAF_CODESEP = CScript([OP_CODESEPARATOR, PUB_B, OP_CHECKSIG])
+LEAF_SUCCESS = CScript(bytes([OP_SUCCESS187]))
+LEAF_TRUE = CScript([OP_1])
+
+# Trees. p2mr_construct() places a single leaf at depth 0, which BIP-360 makes
+# anyone-can-spend without running the script.
+TREE_LONE_RETURN = p2mr_construct([("ret", LEAF_RETURN)])
+TREE_PAIR = p2mr_construct([("csig", LEAF_CSIG), ("ret", LEAF_RETURN)])
+TREE_DEEP = p2mr_construct([("csig", LEAF_CSIG), [("ret", LEAF_RETURN), ("future", LEAF_TRUE, LEAF_VERSION_FUTURE)]])
+TREE_MISC = p2mr_construct([("codesep", LEAF_CODESEP), ("success", LEAF_SUCCESS)])
+TREE_QUAD = p2mr_construct([[("csig", LEAF_CSIG), ("ret", LEAF_RETURN)],
+                            [("future", LEAF_TRUE, LEAF_VERSION_FUTURE), ("success", LEAF_SUCCESS)]])
+
+
+def synthetic_path(count, seed):
+    """Build a Merkle path of `count` inner nodes that no real tree would give."""
+    return [bytes([seed, i & 0xff]) + bytes(P2MR_CONTROL_NODE_SIZE - 2) for i in range(count)]
+
+
+def spending_tx(script_pubkey, witness_stack, script_sig=b""):
+    """Rebuild the transaction pair that script_json_test derives from a row.
+
+    Mirrors BuildCreditingTransaction() and BuildSpendingTransaction() in
+    src/test/util/transaction_utils.cpp.
+    """
+    credit = CTransaction()
+    credit.version = 1
+    credit.nLockTime = 0
+    # CScript() << CScriptNum(0) << CScriptNum(0) is two empty pushes.
+    credit.vin = [CTxIn(COutPoint(0, 0xffffffff), b"\x00\x00", SEQUENCE_FINAL)]
+    credit.vout = [CTxOut(AMOUNT_SAT, script_pubkey)]
+
+    spend = CTransaction()
+    spend.version = 1
+    spend.nLockTime = 0
+    spend.vin = [CTxIn(COutPoint(credit.txid_int, 0), script_sig, SEQUENCE_FINAL)]
+    spend.vout = [CTxOut(AMOUNT_SAT, b"")]
+    spend.wit.vtxinwit = []
+    return spend, [credit.vout[0]]
+
+
+def sign(script_pubkey, witness_stack, leaf_script, sec, *, hash_type=SIGHASH_DEFAULT,
+         leaf_ver=LEAF_VERSION_TAPSCRIPT, annex=None, codeseparator_pos=NO_CODESEPARATOR,
+         wrong_key=False):
+    """Produce a BIP-342 signature for a P2MR script path spend of one row."""
+    spend, spent_utxos = spending_tx(script_pubkey, witness_stack)
+    sighash = TaprootSignatureHash(spend, spent_utxos, hash_type, input_index=0, scriptpath=True,
+                                  leaf_script=leaf_script, leaf_ver=leaf_ver, annex=annex,
+                                  codeseparator_pos=codeseparator_pos)
+    sig = sign_schnorr(SEC_B if wrong_key else sec, sighash)
+    if hash_type != SIGHASH_DEFAULT:
+        sig += bytes([hash_type])
+    return sig
+
+
+def row(witness, script_pubkey, flags, error, comment, script_sig=""):
+    """Assemble one script_tests.json row."""
+    program = bytes(script_pubkey)
+    assert len(program) == 34 and program[0] in (OP_1, OP_2) and program[1] == 0x20, program.hex()
+    return {
+        "witness": [w.hex() if isinstance(w, (bytes, bytearray)) else w for w in witness],
+        "scriptSig": script_sig,
+        "scriptPubKey": f"0x{program[0]:02x} 0x20 0x{program[2:].hex()}",
+        "flags": flags,
+        "error": error,
+        "comment": comment,
+    }
+
+
+def raw_row(witness, script_pubkey_asm, flags, error, comment, script_sig=""):
+    """Assemble one row from an already formatted scriptPubKey."""
+    return {
+        "witness": [w.hex() if isinstance(w, (bytes, bytearray)) else w for w in witness],
+        "scriptSig": script_sig,
+        "scriptPubKey": script_pubkey_asm,
+        "flags": flags,
+        "error": error,
+        "comment": comment,
+    }
+
+
+def taproot_calibration_rows():
+    """Two witness v1 rows that exercise the same machinery under existing rules.
+
+    These are the only rows in script_tests.json that check a real Schnorr
+    signature, so they are what tells you whether DoTest() still hands a
+    PrecomputedTransactionData to the signature checker. Without that the P2MR
+    rows below cannot fail cleanly: CheckSchnorrSignature() would hit
+    MissingDataBehavior::ASSERT_FAIL and abort the test binary instead.
+    """
+    tap = taproot_construct(PUB_A, [("csig", LEAF_CSIG)])
+    leaf = tap.leaves["csig"]
+    control = bytes([leaf.version + tap.negflag]) + tap.internal_pubkey + leaf.merklebranch
+    rows = []
+    witness = [None, LEAF_CSIG, control]
+    witness[0] = sign(tap.scriptPubKey, witness, LEAF_CSIG, SEC_A)
+    rows.append(row(witness, tap.scriptPubKey, FLAGS_NO_P2MR, "OK",
+                    "TAPROOT: script path spend with a real Schnorr signature"))
+    witness = [None, LEAF_CSIG, control]
+    witness[0] = sign(tap.scriptPubKey, witness, LEAF_CSIG, SEC_A, wrong_key=True)
+    rows.append(row(witness, tap.scriptPubKey, FLAGS_NO_P2MR, "SCHNORR_SIG",
+                    "TAPROOT: script path spend signed by the wrong key"))
+    return rows
+
+
+def build_rows():
+    rows = list(taproot_calibration_rows())
+
+    # --- Well formed script path spends, one per depth the rule set allows ---
+
+    # m == 0: the leaf is never executed, so a leaf that could only fail still
+    # spends. BIP-360 script validation, "If m = 0, succeed immediately".
+    leaf = TREE_LONE_RETURN.leaves["ret"]
+    assert leaf.control_block == b"\xc1"
+    rows.append(row([LEAF_RETURN, leaf.control_block], TREE_LONE_RETURN.scriptPubKey,
+                    FLAGS_P2MR, "OK",
+                    "P2MR: m=0 succeeds without executing the leaf (leaf is OP_RETURN)"))
+
+    # The same OP_RETURN leaf one level deeper is executed, and fails.
+    leaf = TREE_PAIR.leaves["ret"]
+    rows.append(row([LEAF_RETURN, leaf.control_block], TREE_PAIR.scriptPubKey,
+                    FLAGS_P2MR, "OP_RETURN",
+                    "P2MR: the same OP_RETURN leaf at m=1 is executed and fails"))
+
+    # m == 1, signature with the default sighash.
+    leaf = TREE_PAIR.leaves["csig"]
+    assert len(leaf.merklebranch) == 32
+    witness = [None, LEAF_CSIG, leaf.control_block]
+    witness[0] = sign(TREE_PAIR.scriptPubKey, witness, LEAF_CSIG, SEC_A)
+    rows.append(row(witness, TREE_PAIR.scriptPubKey, FLAGS_P2MR, "OK",
+                    "P2MR: m=1 script path spend, SIGHASH_DEFAULT"))
+
+    # Same leaf, SIGHASH_ALL, so the signature is 65 bytes.
+    witness = [None, LEAF_CSIG, leaf.control_block]
+    witness[0] = sign(TREE_PAIR.scriptPubKey, witness, LEAF_CSIG, SEC_A, hash_type=SIGHASH_ALL)
+    rows.append(row(witness, TREE_PAIR.scriptPubKey, FLAGS_P2MR, "OK",
+                    "P2MR: m=1 script path spend, SIGHASH_ALL"))
+
+    # Same leaf, SIGHASH_SINGLE|SIGHASH_ANYONECANPAY.
+    witness = [None, LEAF_CSIG, leaf.control_block]
+    witness[0] = sign(TREE_PAIR.scriptPubKey, witness, LEAF_CSIG, SEC_A,
+                      hash_type=SIGHASH_SINGLE | SIGHASH_ANYONECANPAY)
+    rows.append(row(witness, TREE_PAIR.scriptPubKey, FLAGS_P2MR, "OK",
+                    "P2MR: m=1 script path spend, SIGHASH_SINGLE|SIGHASH_ANYONECANPAY"))
+
+    # A signature over the right message but from the wrong key.
+    witness = [None, LEAF_CSIG, leaf.control_block]
+    witness[0] = sign(TREE_PAIR.scriptPubKey, witness, LEAF_CSIG, SEC_A, wrong_key=True)
+    rows.append(row(witness, TREE_PAIR.scriptPubKey, FLAGS_P2MR, "SCHNORR_SIG",
+                    "P2MR: m=1 script path spend signed by the wrong key"))
+
+    # m == 2.
+    leaf = TREE_DEEP.leaves["csig"]
+    witness = [None, LEAF_CSIG, leaf.control_block]
+    witness[0] = sign(TREE_DEEP.scriptPubKey, witness, LEAF_CSIG, SEC_A)
+    rows.append(row(witness, TREE_DEEP.scriptPubKey, FLAGS_P2MR, "OK",
+                    "P2MR: m=1 script path spend in a three leaf tree"))
+    leaf = TREE_DEEP.leaves["ret"]
+    assert len(leaf.merklebranch) == 64
+    rows.append(row([LEAF_RETURN, leaf.control_block], TREE_DEEP.scriptPubKey,
+                    FLAGS_P2MR, "OP_RETURN",
+                    "P2MR: m=2 control block, leaf executed"))
+
+    leaf = TREE_QUAD.leaves["csig"]
+    assert len(leaf.merklebranch) == 64
+    witness = [None, LEAF_CSIG, leaf.control_block]
+    witness[0] = sign(TREE_QUAD.scriptPubKey, witness, LEAF_CSIG, SEC_A)
+    rows.append(row(witness, TREE_QUAD.scriptPubKey, FLAGS_P2MR, "OK",
+                    "P2MR: m=2 script path spend, SIGHASH_DEFAULT"))
+
+    # m == 128, the deepest control block the rules allow (4097 bytes).
+    path = synthetic_path(P2MR_CONTROL_MAX_NODE_COUNT, 0x11)
+    leaf_hash = p2mr_tapleaf_hash(LEAF_VERSION_TAPSCRIPT, LEAF_CSIG)
+    root = p2mr_root_from_path(leaf_hash, path)
+    spk = p2mr_script_pubkey(root)
+    control = bytes([LEAF_VERSION_TAPSCRIPT | 1]) + b"".join(path)
+    assert len(control) == 4097
+    witness = [None, LEAF_CSIG, control]
+    witness[0] = sign(spk, witness, LEAF_CSIG, SEC_A)
+    rows.append(row(witness, spk, FLAGS_P2MR, "OK",
+                    "P2MR: m=128 control block (4097 bytes) is the maximum depth"))
+
+    # m == 129 is one node too deep. The root matches the folded path, so the
+    # length rule is the only thing that can reject this.
+    path = synthetic_path(P2MR_CONTROL_MAX_NODE_COUNT + 1, 0x12)
+    root = p2mr_root_from_path(leaf_hash, path)
+    spk = p2mr_script_pubkey(root)
+    control = bytes([LEAF_VERSION_TAPSCRIPT | 1]) + b"".join(path)
+    assert len(control) == 4129
+    witness = [None, LEAF_CSIG, control]
+    witness[0] = sign(spk, witness, LEAF_CSIG, SEC_A)
+    rows.append(row(witness, spk, FLAGS_P2MR, "TAPROOT_WRONG_CONTROL_SIZE",
+                    "P2MR: m=129 control block (4129 bytes) exceeds the maximum depth"))
+
+    # --- Malformed control blocks ---
+
+    leaf = TREE_PAIR.leaves["csig"]
+    rows.append(row([LEAF_CSIG, leaf.control_block + b"\x00"], TREE_PAIR.scriptPubKey,
+                    FLAGS_P2MR, "TAPROOT_WRONG_CONTROL_SIZE",
+                    "P2MR: control block length 34 is not 1+32m"))
+    rows.append(row([LEAF_CSIG, b""], TREE_PAIR.scriptPubKey,
+                    FLAGS_P2MR, "TAPROOT_WRONG_CONTROL_SIZE",
+                    "P2MR: empty control block is not 1+32m"))
+
+    # The low bit of c[0] must be set, for every leaf version.
+    rows.append(row([LEAF_CSIG, bytes([LEAF_VERSION_TAPSCRIPT]) + leaf.merklebranch],
+                    TREE_PAIR.scriptPubKey, FLAGS_P2MR, CONTROL_PARITY_ERROR,
+                    "P2MR: c[0]=0xc0 has the low bit cleared"))
+    future = TREE_DEEP.leaves["future"]
+    rows.append(row([LEAF_TRUE, bytes([LEAF_VERSION_FUTURE]) + future.merklebranch],
+                    TREE_DEEP.scriptPubKey, FLAGS_P2MR, CONTROL_PARITY_ERROR,
+                    "P2MR: c[0]=0xfa has the low bit cleared"))
+
+    # --- Merkle root ---
+
+    bad_root = bytes([TREE_PAIR.merkle_root[0] ^ 1]) + TREE_PAIR.merkle_root[1:]
+    rows.append(row([LEAF_CSIG, leaf.control_block], p2mr_script_pubkey(bad_root),
+                    FLAGS_P2MR, "WITNESS_PROGRAM_MISMATCH",
+                    "P2MR: computed root does not match the witness program"))
+
+    # --- Witness stack shape ---
+
+    rows.append(row([], TREE_PAIR.scriptPubKey, FLAGS_P2MR,
+                    "WITNESS_PROGRAM_WITNESS_EMPTY",
+                    "P2MR: empty witness stack"))
+    rows.append(row([leaf.control_block], TREE_PAIR.scriptPubKey, FLAGS_P2MR,
+                    "WITNESS_PROGRAM_MISMATCH",
+                    "P2MR: witness stack of one element has no script and control block"))
+    rows.append(row([LEAF_CSIG, bytes([ANNEX_TAG])], TREE_PAIR.scriptPubKey, FLAGS_P2MR,
+                    "WITNESS_PROGRAM_MISMATCH",
+                    "P2MR: two elements with 0x50 last leaves nothing to spend with"))
+
+    # --- Annex ---
+
+    annex = bytes([ANNEX_TAG]) + b"\xde\xad\xbe\xef"
+    witness = [None, LEAF_CSIG, leaf.control_block, annex]
+    witness[0] = sign(TREE_PAIR.scriptPubKey, witness, LEAF_CSIG, SEC_A, annex=annex)
+    rows.append(row(witness, TREE_PAIR.scriptPubKey, FLAGS_P2MR, "OK",
+                    "P2MR: four element witness with an annex the signature commits to"))
+    witness = [None, LEAF_CSIG, leaf.control_block, annex]
+    witness[0] = sign(TREE_PAIR.scriptPubKey, witness, LEAF_CSIG, SEC_A, annex=None)
+    rows.append(row(witness, TREE_PAIR.scriptPubKey, FLAGS_P2MR, "SCHNORR_SIG",
+                    "P2MR: annex present but not committed to by the signature"))
+
+    # --- Upgraded leaf versions ---
+
+    rows.append(row([LEAF_TRUE, future.control_block], TREE_DEEP.scriptPubKey,
+                    FLAGS_P2MR, "OK",
+                    "P2MR: leaf version 0xfa succeeds without executing the leaf"))
+    rows.append(row([LEAF_TRUE, future.control_block], TREE_DEEP.scriptPubKey,
+                    FLAGS_P2MR + ",DISCOURAGE_UPGRADABLE_TAPROOT_VERSION",
+                    "DISCOURAGE_UPGRADABLE_TAPROOT_VERSION",
+                    "P2MR: leaf version 0xfa is non standard"))
+
+    # --- Tapscript details reached through P2MR ---
+
+    success_leaf = TREE_MISC.leaves["success"]
+    rows.append(row([LEAF_SUCCESS, success_leaf.control_block], TREE_MISC.scriptPubKey,
+                    FLAGS_P2MR, "OK",
+                    "P2MR: OP_SUCCESS187 in a 0xc0 leaf succeeds"))
+    rows.append(row([LEAF_SUCCESS, success_leaf.control_block], TREE_MISC.scriptPubKey,
+                    FLAGS_P2MR + ",DISCOURAGE_OP_SUCCESS",
+                    "DISCOURAGE_OP_SUCCESS",
+                    "P2MR: OP_SUCCESS187 in a 0xc0 leaf is non standard"))
+
+    codesep_leaf = TREE_MISC.leaves["codesep"]
+    witness = [None, LEAF_CODESEP, codesep_leaf.control_block]
+    witness[0] = sign(TREE_MISC.scriptPubKey, witness, LEAF_CODESEP, SEC_B, codeseparator_pos=0)
+    rows.append(row(witness, TREE_MISC.scriptPubKey, FLAGS_P2MR, "OK",
+                    "P2MR: signature commits to an OP_CODESEPARATOR position of 0"))
+    witness = [None, LEAF_CODESEP, codesep_leaf.control_block]
+    witness[0] = sign(TREE_MISC.scriptPubKey, witness, LEAF_CODESEP, SEC_B,
+                      codeseparator_pos=NO_CODESEPARATOR)
+    rows.append(row(witness, TREE_MISC.scriptPubKey, FLAGS_P2MR, "SCHNORR_SIG",
+                    "P2MR: signature commits to the wrong OP_CODESEPARATOR position"))
+
+    # --- Only a 32 byte witness v2 program is P2MR ---
+
+    leaf = TREE_PAIR.leaves["csig"]
+    witness = [None, LEAF_CSIG, leaf.control_block]
+    witness[0] = sign(TREE_PAIR.scriptPubKey, witness, LEAF_CSIG, SEC_A)
+    short = TREE_PAIR.merkle_root[:31]
+    long_ = TREE_PAIR.merkle_root + bytes(1)
+    rows.append(raw_row(witness, f"0x52 0x1f 0x{short.hex()}", FLAGS_P2MR, "OK",
+                        "P2MR: a 31 byte witness v2 program is not P2MR, so it is anyone-can-spend"))
+    rows.append(raw_row(witness, f"0x52 0x21 0x{long_.hex()}",
+                        FLAGS_P2MR + ",DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM",
+                        "DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM",
+                        "P2MR: a 33 byte witness v2 program is not P2MR, so it is non standard"))
+
+    # --- Without the P2MR rules, a witness v2 program is anyone-can-spend ---
+
+    leaf = TREE_PAIR.leaves["csig"]
+    witness = [None, LEAF_CSIG, leaf.control_block]
+    witness[0] = sign(TREE_PAIR.scriptPubKey, witness, LEAF_CSIG, SEC_A)
+    rows.append(row(witness, TREE_PAIR.scriptPubKey, FLAGS_NO_P2MR, "OK",
+                    "P2MR: a valid spend is an unknown witness program without the P2MR flag"))
+    # Both rows below must also fail once P2MR is added, because script_json_test
+    # adds random flags to failing rows. A root mismatch and an empty witness
+    # are rejected either way.
+    rows.append(row([LEAF_CSIG, leaf.control_block], p2mr_script_pubkey(bad_root),
+                    FLAGS_NO_P2MR + ",DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM",
+                    "DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM",
+                    "P2MR: witness v2 is non standard without the P2MR flag"))
+    rows.append(row([], TREE_PAIR.scriptPubKey,
+                    FLAGS_NO_P2MR + ",DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM",
+                    "DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM",
+                    "P2MR: empty witness on a witness v2 program is non standard"))
+
+    return rows
+
+
+def format_rows(rows):
+    """Render rows in the multi line style script_tests.json uses for taproot."""
+    out = ['["P2MR (BIP-360) tests, and the taproot rows that calibrate them"],']
+    for r in rows:
+        lines = ["["]
+        lines.append("    [")
+        for element in r["witness"]:
+            lines.append(f'        "{element}",')
+        lines.append(f"        {AMOUNT_BTC:.8f}")
+        lines.append("    ],")
+        lines.append(f'    {json.dumps(r["scriptSig"])},')
+        lines.append(f'    {json.dumps(r["scriptPubKey"])},')
+        lines.append(f'    {json.dumps(r["flags"])},')
+        lines.append(f'    {json.dumps(r["error"])},')
+        lines.append(f'    {json.dumps(r["comment"])}')
+        lines.append("],")
+        out.extend(lines)
+    return "\n".join(out)
+
+
+def splice(path, text):
+    """Insert the generated block just above the trailing ["The End"] row."""
+    with open(path, encoding="utf-8") as f:
+        content = f.read()
+    marker = '\n["The End"]\n'
+    assert marker in content, f"{path}: missing the trailing [\"The End\"] row"
+    head, tail = content.split(marker, 1)
+    start = head.find('\n["P2MR (BIP-360) tests')
+    if start != -1:
+        head = head[:start]
+    with open(path, "w", encoding="utf-8", newline="\n") as f:
+        f.write(head.rstrip("\n") + "\n\n" + text + marker + tail)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__,
+                                     formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--inplace", action="store_true",
+                        help="rewrite the P2MR block of src/test/data/script_tests.json")
+    args = parser.parse_args()
+
+    rows = build_rows()
+    text = format_rows(rows)
+    if args.inplace:
+        target = os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                              "..", "..", "src", "test", "data", "script_tests.json")
+        splice(os.path.normpath(target), text)
+        print(f"wrote {len(rows)} P2MR rows to {os.path.normpath(target)}", file=sys.stderr)
+    else:
+        print(text)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
