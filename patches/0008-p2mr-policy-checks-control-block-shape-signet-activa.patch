+    # m == 0 with a future leaf version: the depth-zero short circuit comes before
+    # the leaf version dispatch, so DISCOURAGE_UPGRADABLE_TAPROOT_VERSION does not
+    # apply either.
+    lone_future = p2mr_construct([("ret", LEAF_RETURN, LEAF_VERSION_FUTURE)])
+    leaf = lone_future.leaves["ret"]
+    assert leaf.control_block == bytes([LEAF_VERSION_FUTURE | 1])
+    rows.append(row([LEAF_RETURN, leaf.control_block], lone_future.scriptPubKey,
+                    FLAGS_P2MR + ",DISCOURAGE_UPGRADABLE_TAPROOT_VERSION", "OK",
+                    "P2MR: m=0 with leaf version 0xfa succeeds before the leaf version is considered"))
