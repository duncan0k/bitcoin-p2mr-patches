+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test the P2MR (BIP 360) activation parameters on signet.
+
+P2MR is a buried deployment that only activates on custom signets, i.e. when
+the operator supplies their own -signetchallenge. The default (public) signet
+keeps it disabled forever.
+"""
+
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal
+
+NEVER = 2147483647  # std::numeric_limits<int>::max()
+
+
+class P2MRSignetTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.chain = "signet"
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+        # node0: custom signet (OP_TRUE challenge); node1: default signet parameters
+        self.extra_args = [["-signetchallenge=51"], []]
+
+    def setup_network(self):
+        # The two nodes are on different signets; never connect them.
+        self.setup_nodes()
+
+    def run_test(self):
+        custom = self.nodes[0].getdeploymentinfo()["deployments"]["p2mr"]
+        assert_equal(custom["type"], "buried")
+        assert_equal(custom["height"], 1)
+        assert_equal(custom["active"], False)  # still at the genesis block
+        self.log.info("custom signet: p2mr activates at height 1")
+
+        default = self.nodes[1].getdeploymentinfo()["deployments"]["p2mr"]
+        assert_equal(default["type"], "buried")
+        assert_equal(default["height"], NEVER)
+        assert_equal(default["active"], False)
+        self.log.info("default signet: p2mr never activates")
+
+
+if __name__ == "__main__":
+    P2MRSignetTest(__file__).main()
