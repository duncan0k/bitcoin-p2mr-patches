+        self.log.info("Well-formed input: the signature in hex, with or without a final newline, upper case too")
+        for stdin in (msg.encode(), (msg + "\n").encode(), msg.upper().encode()):
+            code, out, err = self.run([self.keyfile], stdin)
+            assert_equal((code, err), (0, ""))
+            assert out.endswith(b"\n") and out.count(b"\n") == 1
+            assert_equal(len(out.strip()), 2 * 7856)
+            # Nothing of the key is printed: not the seed bytes nor their hex.
+            assert SLH_SEED.hex().encode() not in out and SLH_SEED[:16].hex().encode() not in out
