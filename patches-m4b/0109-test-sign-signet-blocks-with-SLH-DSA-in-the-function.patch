+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Signet blocks signed with SLH-DSA-SHA2-128s next to ML-DSA-44 (doc/signet-slhblock.md).
+
+A signet given -signetslhblock=<pubkey>@<height> (which needs -signetpqblock at or below that
+height) requires, from that height on, an SLH output right before the witness commitment output
+of every block, at vout[c - 1] where c is the commitment's index:
+
+    nValue 0, scriptPubKey  6a 4d b51e "PQH1" 01 <7856-byte signature>   (7865 bytes)
+
+The signature covers slh_msg = TaggedHash("SignetSLHBlock", SHA256(challenge) || nVersion ||
+hashPrevBlock || slh_merkle || nTime), where slh_merkle is the merkle root with the coinbase
+replaced by slh_coinbase: the coinbase the ML-DSA-44 signature covers (signet_pq.py), with the
+SLH output cut back to 6a 05 "PQH1" 01.
+
+The ML-DSA-44 message covers the SLH output as it is, so the SLH signature is made first. A block
+producer goes through the four steps of add_signet_slh_and_pq_signatures, then signs the signet
+solution over the result as before. The Ark-0 block producer (contrib/k3s/ark0/producer/ark0.py
+in the patch repository) calls that function, so the functional tests run its code path.
+
+Checks that a block producer depends on raise RuntimeError rather than use assert, which
+python -O removes.
+"""
+
+import hashlib
+import os
+import subprocess
+
+from .key import TaggedHash
+from .messages import CTxOut, ser_uint256
+from .p2mr_slhdsa128s import SLHDSA128S_SIGNATURE_SIZE, slhdsa128s_sign, slhdsa128s_verify
+from .script import CScriptOp, OP_RETURN
+from .signet_pq import (
+    SIGNET_PQ_HEADER,
+    SIGNET_PQ_VERSION,
+    WITNESS_COMMITMENT_SIZE,
+    add_signet_pq_signature,
+    signet_pq_coinbase,
+    witness_commitment_index,
+)
+
+SIGNET_SLH_HEADER = b"PQH1"
+SIGNET_SLH_VERSION = 0x01
+SIGNET_SLH_CONTEXT = b"SIGNET/SLHBLOCK/EXP0"
+# Header, version and signature: 4 + 1 + 7856 = 7861 = 0x1eb5, so OP_PUSHDATA2 is the shortest push.
+SIGNET_SLH_PUSH_SIZE = len(SIGNET_SLH_HEADER) + 1 + SLHDSA128S_SIGNATURE_SIZE
+# The first 9 bytes of the SLH output script: OP_RETURN, OP_PUSHDATA2 and its length, header, version.
+SIGNET_SLH_SCRIPT_PREFIX = (bytes([OP_RETURN, 0x4d]) + SIGNET_SLH_PUSH_SIZE.to_bytes(2, "little")
+                            + SIGNET_SLH_HEADER + bytes([SIGNET_SLH_VERSION]))
+SIGNET_SLH_SCRIPT_SIZE = len(SIGNET_SLH_SCRIPT_PREFIX) + SLHDSA128S_SIGNATURE_SIZE
+# The SLH output as slh_coinbase has it, and as a block producer inserts it before signing.
+SIGNET_SLH_PLACEHOLDER = bytes([OP_RETURN, 5]) + SIGNET_SLH_HEADER + bytes([SIGNET_SLH_VERSION])
+# The PQ push of the witness commitment output as pq_coinbase has it.
+SIGNET_PQ_CUT_PUSH = CScriptOp.encode_op_pushdata(SIGNET_PQ_HEADER + bytes([SIGNET_PQ_VERSION]))
+
+assert SIGNET_SLH_PUSH_SIZE == 7861 and SIGNET_SLH_SCRIPT_SIZE == 7865
+assert SIGNET_SLH_PLACEHOLDER.hex() == "6a055051483101"
+
+
+def _require(condition, message):
+    if not condition:
+        raise RuntimeError(message)
+
+
+def signet_slh_script(signature):
+    """The script of the SLH output for a signature."""
+    _require(len(signature) == SLHDSA128S_SIGNATURE_SIZE, "an SLH-DSA-SHA2-128s signature is 7856 bytes")
+    return SIGNET_SLH_SCRIPT_PREFIX + bytes(signature)
+
+
+def signet_slh_index(block):
+    """Index of the SLH output: the one right before the witness commitment. None without a
+    commitment, or when the commitment is the first output."""
+    c = witness_commitment_index(block)
+    return None if c is None or c < 1 else c - 1
+
+
+def signet_slh_coinbase(block):
+    """slh_coinbase (rule 4B-3): pq_coinbase with the output before the commitment cut back to
+    6a 05 "PQH1" 01."""
+    index = signet_slh_index(block)
+    _require(index is not None, "the block has no output before its witness commitment")
+    coinbase = signet_pq_coinbase(block)
+    coinbase.vout[index] = CTxOut(coinbase.vout[index].nValue, SIGNET_SLH_PLACEHOLDER)
+    return coinbase
+
+
+def signet_slh_merkle_root(block):
+    """slh_merkle: the merkle root over slh_coinbase and the block's other transactions."""
+    hashes = [ser_uint256(signet_slh_coinbase(block).txid_int)] + [ser_uint256(tx.txid_int) for tx in block.vtx[1:]]
+    return block.get_merkle_root(hashes)
+
+
+def signet_slh_message(block, challenge):
+    """slh_msg, the 32-byte message of the SLH-DSA block signature."""
+    data = (hashlib.sha256(bytes(challenge)).digest()
+            + block.nVersion.to_bytes(4, "little", signed=True)
+            + ser_uint256(block.hashPrevBlock)
+            + ser_uint256(signet_slh_merkle_root(block))
+            + block.nTime.to_bytes(4, "little"))
+    _require(len(data) == 104, "the slh_msg preimage is 104 bytes")
+    return TaggedHash("SignetSLHBlock", data)
+
+
+def signet_slh_signature(block):
+    """The signature in the block's SLH output, or None when that output is not in the required
+    form (the node's structural checks, rules 4B-1 and 4B-2, by bytes at fixed offsets)."""
+    index = signet_slh_index(block)
+    if index is None:
+        return None
+    outs = block.vtx[0].vout
+    script = bytes(outs[index].scriptPubKey)
+    if outs[index].nValue != 0 or len(script) != SIGNET_SLH_SCRIPT_SIZE or script[:9] != SIGNET_SLH_SCRIPT_PREFIX:
+        return None
+    if any(i != index and bytes(o.scriptPubKey)[:8] == SIGNET_SLH_SCRIPT_PREFIX[:8] for i, o in enumerate(outs)):
+        return None
+    return script[9:]
+
+
+def verify_signet_slh_signature(block, pubkey, challenge):
+    """Whether the block carries a valid SLH-DSA block signature by pubkey (pure Python)."""
+    signature = signet_slh_signature(block)
+    return signature is not None and slhdsa128s_verify(pubkey, signet_slh_message(block, challenge), signature,
+                                                       context=SIGNET_SLH_CONTEXT)
+
+
+def python_slh_signer(seckey):
+    """A signer in pure Python (slow: seconds per signature), hedged like the signer program."""
+    return lambda msg: slhdsa128s_sign(seckey, msg, context=SIGNET_SLH_CONTEXT, addrnd=os.urandom(16))
+
+
+# How long signet-slh-sign may take before it is killed: signing (measured p99 about 0.8 s on a
+# 2.1 GHz Xeon) and -pubkey (key generation only). A signer that hangs must not stop a producer.
+SIGNER_TIMEOUT = 30
+PUBKEY_TIMEOUT = 10
+
+
+def _run_signer(args, stdin, timeout, what):
+    """Run signet-slh-sign; its standard output, only when it exits 0. On any other exit the output
+    is ignored, whatever it holds (the program's interface: it can be part of a result whose
+    writing failed). On a timeout the child is killed (subprocess.run does that) and this raises."""
+    try:
+        p = subprocess.run(args, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout)
+    except subprocess.TimeoutExpired:
+        raise RuntimeError(f"signet-slh-sign {what} did not finish within {timeout} s and was killed")
+    except OSError as e:
+        raise RuntimeError(f"signet-slh-sign {what} could not be run: {e}")
+    _require(p.returncode == 0,
+             f"signet-slh-sign {what} failed with code {p.returncode}: {p.stderr.decode(errors='replace').strip()}")
+    try:
+        return bytes.fromhex(p.stdout.decode().strip())
+    except (UnicodeDecodeError, ValueError):
+        raise RuntimeError(f"signet-slh-sign {what} printed no hexadecimal result")
+
+
+def check_slh_signature(pubkey, message, signature):
+    """Raise unless signature is a valid SLH-DSA block signature of message under pubkey (the
+    Python verifier, about 2.5 ms). A producer calls it with the public key whose hash it checked,
+    which binds that check to the key that actually signed."""
+    _require(len(signature) == SLHDSA128S_SIGNATURE_SIZE, "the SLH signer returned no 7856-byte signature")
+    _require(slhdsa128s_verify(pubkey, message, signature, context=SIGNET_SLH_CONTEXT),
+             "the SLH signature does not verify under the checked public key")
+
+
+def program_slh_signer(program, keyfile, *, pubkey=None, timeout=SIGNER_TIMEOUT):
+    """A signer that runs signet-slh-sign (src/signet-slh-sign.c) on a 48-byte key file: the message
+    in hex on its standard input, the signature in hex on its standard output. The program verifies
+    the signature before it prints it; this checks the exit code and the length and, given pubkey,
+    verifies the signature again under that key (check_slh_signature)."""
+    def sign(msg):
+        _require(len(msg) == 32, "slh_msg is 32 bytes")
+        signature = _run_signer([program, keyfile], (bytes(msg).hex() + "\n").encode(), timeout, "signing")
+        _require(len(signature) == SLHDSA128S_SIGNATURE_SIZE, "signet-slh-sign printed no 7856-byte signature")
+        if pubkey is not None:
+            check_slh_signature(pubkey, msg, signature)
+        return signature
+    return sign
+
+
+def signet_slh_sign_program(config):
+    """The signer program the build made, from config.ini: signet-slh-sign, or in a build with
+    SANITIZERS the test-only signet-slh-sign-sanitizer-test (never the production name there).
+    None when neither is built."""
+    components = config["components"]
+    bindir = os.path.join(config["environment"]["BUILDDIR"], "bin")
+    for flag, name in (("BUILD_SIGNET_SLH_SIGNER", "signet-slh-sign"),
+                       ("BUILD_SIGNET_SLH_SIGN_SANITIZER_TEST", "signet-slh-sign-sanitizer-test")):
+        if components.getboolean(flag, fallback=False):
+            return os.path.join(bindir, name)
+    return None
+
+
+SIGNET_SLH_SIGN_NOT_BUILT = ("signet-slh-sign is not built (it is Linux only, needs -DBUILD_SIGNET_SLH_SIGNER=ON, "
+                             "and with SANITIZERS only its test build, -DSIGNET_SLH_SIGN_ALLOW_SANITIZERS=ON)")
+
+
+def program_slh_pubkey(program, keyfile, *, timeout=PUBKEY_TIMEOUT):
+    """The public key of a key file, as signet-slh-sign -pubkey prints it."""
+    pubkey = _run_signer([program, "-pubkey", keyfile], b"", timeout, "-pubkey")
+    _require(len(pubkey) == 32, "signet-slh-sign -pubkey printed no 32-byte key")
+    return pubkey
+
+
+def insert_signet_slh_placeholder(block):
+    """Step 1: insert the placeholder SLH output right before the witness commitment output (whose
+    index goes up by one) and append the cut PQ push to the commitment output. The coinbase is then
+    slh_coinbase itself. Returns the index of the SLH output."""
+    c = witness_commitment_index(block)
+    _require(c is not None, "the block has no witness commitment")
+    commitment = block.vtx[0].vout[c]
+    _require(len(bytes(commitment.scriptPubKey)) == WITNESS_COMMITMENT_SIZE,
+             "the witness commitment output already carries pushes")
+    _require(not any(bytes(o.scriptPubKey)[:8] == SIGNET_SLH_SCRIPT_PREFIX[:8] or bytes(o.scriptPubKey) == SIGNET_SLH_PLACEHOLDER
+                     for o in block.vtx[0].vout), "the coinbase already has an SLH output")
+    commitment.scriptPubKey = bytes(commitment.scriptPubKey) + SIGNET_PQ_CUT_PUSH
+    # Inserted, never appended: the commitment output stays last, as getblocktemplate's users
+    # (contrib/signet/miner's finish_block, which puts the signet solution on vout[-1]) expect.
+    block.vtx[0].vout.insert(c, CTxOut(0, SIGNET_SLH_PLACEHOLDER))
+    block.hashMerkleRoot = block.calc_merkle_root()
+    _require(witness_commitment_index(block) == c + 1, "the witness commitment did not move to the end")
+    return c
+
+
+def set_signet_slh_signature(block, index, signature, challenge, message):
+    """Step 4, first half: replace the placeholder at index with the full SLH output and cut the
+    commitment output back to its 38 bytes, ready for the ML-DSA-44 signature. Checks that the
+    message has not changed: the full output is cut back again when it is computed."""
+    _require(len(signature) == SLHDSA128S_SIGNATURE_SIZE, "the SLH signer returned no 7856-byte signature")
+    coinbase = block.vtx[0]
+    _require(bytes(coinbase.vout[index].scriptPubKey) == SIGNET_SLH_PLACEHOLDER, "no placeholder at the SLH output")
+    coinbase.vout[index] = CTxOut(0, signet_slh_script(signature))
+    commitment = coinbase.vout[index + 1]
+    _require(bytes(commitment.scriptPubKey)[WITNESS_COMMITMENT_SIZE:] == SIGNET_PQ_CUT_PUSH, "the commitment output changed")
+    commitment.scriptPubKey = bytes(commitment.scriptPubKey)[:WITNESS_COMMITMENT_SIZE]
+    block.hashMerkleRoot = block.calc_merkle_root()
+    _require(signet_slh_message(block, challenge) == message, "slh_msg changed with the full SLH output")
+    _require(signet_slh_signature(block) == bytes(signature), "the SLH output is not in the required form")
+
+
+def add_signet_slh_and_pq_signatures(block, challenge, slh_sign, pq_seckey, *, pq_rnd=None):
+    """Sign a block with SLH-DSA, then ML-DSA-44, in the only order that works (doc/signet-slhblock.md):
+
+    1. insert_signet_slh_placeholder: the placeholder SLH output and the cut PQ push; the coinbase
+       is slh_coinbase;
+    2. signet_slh_message: slh_msg;
+    3. slh_sign(slh_msg), which must verify its signature before returning it (signet-slh-sign does);
+    4. set_signet_slh_signature: the full SLH output in place of the placeholder; then
+       add_signet_pq_signature, whose message covers the SLH signature.
+
+    The caller then signs the signet solution over the block as before (generate_psbt,
+    walletprocesspsbt, finish_block). Returns (SLH signature, ML-DSA-44 signature). The Ark-0
+    producer calls the same functions in the same order.
+
+    The block must come from a template with the witness commitment last and nothing after it."""
+    challenge = bytes(challenge)
+    index = insert_signet_slh_placeholder(block)
+    message = signet_slh_message(block, challenge)
+    # The coinbase as it stands is slh_coinbase: its own merkle root gives the same message.
+    _require(block.vtx[0].txid_int == signet_slh_coinbase(block).txid_int, "the placeholder coinbase is not slh_coinbase")
+    signature = bytes(slh_sign(message))
+    set_signet_slh_signature(block, index, signature, challenge, message)
+    pq_signature = add_signet_pq_signature(block, pq_seckey, challenge, rnd=pq_rnd)
+    _require(signet_slh_signature(block) == signature, "the SLH output is not in the required form")
+    return signature, pq_signature
