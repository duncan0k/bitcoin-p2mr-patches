+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test signet-slh-sign, the SLH-DSA block signer of a signet block producer (doc/signet-slhblock.md).
+
+- its interface: a 48-byte key file, the 32-byte message as 64 hexadecimal characters on standard
+  input, the signature in hexadecimal on standard output, and on any malformed input a non-zero
+  exit with nothing on standard output;
+- its public key, against the Python key generation of the test framework;
+- its signatures, over the slh_msg of the p2mr-ts vectors, against the Python verifier, hedged;
+- against the node's verifier: a block it signs is accepted by a node with -signetslhblock;
+- a build that corrupts every signature before verifying it, and one whose random source fails,
+  print nothing (the fault build, skipped with a reason when it is not built);
+- the running signer is not dumpable (the owner of /proc/<pid>/status while it waits on standard
+  input), and it reads the message before it opens the key file;
+- the framework's side (program_slh_signer, program_slh_pubkey): a signer that hangs is killed after
+  the timeout; the output of a non-zero exit is ignored, half a signature included; a signer whose
+  -pubkey gives the expected key but which signs with another, or prints a valid-length signature
+  that does not verify, is caught by the check against the checked public key.
+
+The node only verifies; the signer links the same vendored slhdsa-c (src/crypto/slhdsa128s/).
+"""
+
+import importlib.machinery
+import importlib.util
+import json
+import logging
+import os
+import subprocess
+import sys
+import time
+
+from test_framework.messages import CBlock, CBlockHeader, CTransaction, from_hex, uint256_from_str
+from test_framework.p2mr_slhdsa128s import slhdsa128s_keygen, slhdsa128s_verify
+from test_framework.script import CScript, OP_TRUE
+from test_framework.signet_pq import signet_pq_keygen
+from test_framework.signet_slh import (
+    SIGNET_SLH_SIGN_NOT_BUILT,
+    signet_slh_sign_program,
+    SIGNET_SLH_CONTEXT,
+    check_slh_signature,
+    add_signet_slh_and_pq_signatures,
+    program_slh_pubkey,
+    program_slh_signer,
+    signet_slh_message,
+    verify_signet_slh_signature,
+)
+from test_framework.test_framework import BitcoinTestFramework, SkipTest
+from test_framework.util import assert_equal
+
+# Test keys only, from public strings.
+SLH_SEED = bytes(range(48))
+PQ_PUBKEY, PQ_SECKEY = signet_pq_keygen(bytes.fromhex("33" * 32))
+
+
+class SignetSLHSignTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.chain = "signet"
+        self.setup_clean_chain = True
+        self.num_nodes = 1
+
+    def skip_test_if_missing_module(self):
+        if signet_slh_sign_program(self.config) is None:
+            raise SkipTest(SIGNET_SLH_SIGN_NOT_BUILT)
+        self.skip_if_no_bitcoin_util()
+
+    def is_fault_build_compiled(self):
+        return self.config["components"].getboolean("BUILD_SIGNET_SLH_SIGN_FAULT_TEST", fallback=False)
+
+    def setup_network(self):
+        # The node starts in test_node_verifier, once the key is known.
+        self.add_nodes(self.num_nodes)
+
+    def run(self, args, stdin=b"", program=None):
+        p = subprocess.run([program or self.program] + args, input=stdin, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        return p.returncode, p.stdout, p.stderr.decode()
+
+    def run_test(self):
+        bindir = os.path.join(self.config["environment"]["BUILDDIR"], "bin")
+        self.program = signet_slh_sign_program(self.config)
+        self.fault_program = os.path.join(bindir, "signet-slh-sign-fault-test")
+        self.keyfile = os.path.join(self.options.tmpdir, "slh.key")
+        with open(self.keyfile, "wb") as f:
+            f.write(SLH_SEED)
+        self.test_interface()
+        self.test_message_first()
+        self.test_not_dumpable()
+        self.test_pubkey()
+        self.test_vectors()
+        self.test_fault()
+        self.test_framework_side()
+        self.test_node_verifier()
+
+    def test_interface(self):
+        self.log.info("Malformed input: a non-zero exit and nothing on standard output")
+        msg = bytes(range(32)).hex()
+        tmp = self.options.tmpdir
+        files = {}
+        for name, content in {"short": SLH_SEED[:47], "long": SLH_SEED + b"\n", "hex": SLH_SEED.hex().encode(), "empty": b""}.items():
+            files[name] = os.path.join(tmp, f"key-{name}")
+            with open(files[name], "wb") as f:
+                f.write(content)
+        cases = [
+            ("no arguments", [], msg.encode()),
+            ("two key files", [self.keyfile, self.keyfile], msg.encode()),
+            ("an unknown option", ["-x", self.keyfile], msg.encode()),
+            ("-pubkey without a file", ["-pubkey"], b""),
+            ("a missing key file", [os.path.join(tmp, "missing")], msg.encode()),
+            ("a 47-byte key", [files["short"]], msg.encode()),
+            ("a 49-byte key", [files["long"]], msg.encode()),
+            ("a key in hex", [files["hex"]], msg.encode()),
+            ("an empty key", [files["empty"]], msg.encode()),
+            ("no message", [self.keyfile], b""),
+            ("63 hex characters", [self.keyfile], msg[:-1].encode()),
+            ("65 hex characters", [self.keyfile], (msg + "0").encode()),
+            ("66 hex characters", [self.keyfile], (msg + "00").encode()),
+            ("a non-hex character", [self.keyfile], ("g" + msg[1:]).encode()),
+            ("a space", [self.keyfile], (" " + msg[1:]).encode()),
+            ("two newlines", [self.keyfile], (msg + "\n\n").encode()),
+            ("a carriage return", [self.keyfile], (msg + "\r\n").encode()),
+            ("a prefix 0x", [self.keyfile], ("0x" + msg[2:]).encode()),
+            ("the raw 32 bytes", [self.keyfile], bytes(range(32))),
+        ]
+        for name, args, stdin in cases:
+            self.log.debug(f"  {name}")
+            code, out, err = self.run(args, stdin)
+            assert code != 0, name
+            assert_equal(out, b"")
+            assert err, name
