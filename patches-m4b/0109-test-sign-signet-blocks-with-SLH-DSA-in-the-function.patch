+    def fake_signer(self, name, body):
+        """A stand-in for signet-slh-sign: a Python program, executable from its creation."""
+        path = os.path.join(self.options.tmpdir, name)
+        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o755)
+        os.write(fd, f"#!{sys.executable}\nimport os, sys, time\n{body}\n".encode())
+        os.close(fd)
+        return path
+
+    def test_framework_side(self):
+        msg = bytes(range(32))
+        real = program_slh_signer(self.program, self.keyfile)
+        signature = real(msg)
+        other_seed = bytes(47) + b"\x01"
+        _, other_seckey = slhdsa128s_keygen(other_seed)
+        from test_framework.p2mr_slhdsa128s import slhdsa128s_sign
+        other_signature = slhdsa128s_sign(other_seckey, msg, context=SIGNET_SLH_CONTEXT)
+
+        def raises(fn, needle):
+            try:
+                fn()
+            except RuntimeError as e:
+                assert needle in str(e), str(e)
+                return
+            raise AssertionError(f"no error ({needle})")
+
+        self.log.info("A signer that hangs is killed after the timeout")
+        pidfile = os.path.join(self.options.tmpdir, "sleeper.pid")
+        sleeper = self.fake_signer("sleeper", f"open({pidfile!r}, 'w').write(str(os.getpid())); time.sleep(600)")
+        start = time.time()
+        raises(lambda: program_slh_signer(sleeper, self.keyfile, timeout=2)(msg), "did not finish within 2 s")
+        raises(lambda: program_slh_pubkey(sleeper, self.keyfile, timeout=2), "did not finish within 2 s")
+        assert time.time() - start < 20
+        with open(pidfile, encoding="utf-8") as f:
+            assert not os.path.exists(f"/proc/{int(f.read())}"), "the hung signer was not killed"
+
+        self.log.info("The output of a non-zero exit is ignored: half a signature, exit 1")
+        half = self.fake_signer("half", f"sys.stdout.write({signature.hex()[:len(signature.hex()) // 2]!r}); sys.exit(1)")
+        raises(lambda: program_slh_signer(half, self.keyfile)(msg), "failed with code 1")
+        full_but_failed = self.fake_signer("full-but-failed", f"print({signature.hex()!r}); sys.exit(5)")
+        raises(lambda: program_slh_signer(full_but_failed, self.keyfile)(msg), "failed with code 5")
+
+        self.log.info("The signature is checked against the checked public key")
+        swapped = self.fake_signer("swapped", f"""if sys.argv[1] == '-pubkey':
+    print({self.pubkey.hex()!r})
+else:
+    sys.stdin.read(); print({other_signature.hex()!r})""")
+        assert_equal(program_slh_pubkey(swapped, self.keyfile), self.pubkey)
+        raises(lambda: program_slh_signer(swapped, self.keyfile, pubkey=self.pubkey)(msg), "does not verify under the checked public key")
+        broken = bytearray(signature)
+        broken[5000] ^= 1
+        invalid = self.fake_signer("invalid", f"sys.stdin.read(); print({bytes(broken).hex()!r})")
+        raises(lambda: program_slh_signer(invalid, self.keyfile, pubkey=self.pubkey)(msg), "does not verify under the checked public key")
+        # The real signer passes the same check.
+        assert_equal(len(program_slh_signer(self.program, self.keyfile, pubkey=self.pubkey)(msg)), 7856)
+        check_slh_signature(self.pubkey, msg, signature)
