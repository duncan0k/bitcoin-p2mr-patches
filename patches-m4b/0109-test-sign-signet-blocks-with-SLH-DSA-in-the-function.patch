+    def run_as_other_user(self, args):
+        """Start args with a uid that is not root, waiting on its standard input: as nobody when this
+        test runs as root, as this user otherwise."""
+        def demote():
+            if os.geteuid() == 0:
+                os.setgid(65534)
+                os.setuid(65534)
+        return subprocess.Popen(args, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, preexec_fn=demote)
+
+    def test_not_dumpable(self):
+        self.log.info("The running signer is not dumpable")
+        # For a non-dumpable process the kernel makes root the owner of /proc/<pid>/ (task_dump_owner
+        # in fs/proc/base.c); a dumpable process of a non-root user owns its own. A control process
+        # of the same user shows that this test tells the two apart.
+        uid = 65534 if os.geteuid() == 0 else os.geteuid()
+        if uid == 0:
+            raise AssertionError("cannot tell the owner apart as root")
+        keyfile = os.path.join(self.options.tmpdir, "slh-world-readable.key")
+        fd = os.open(keyfile, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
+        os.write(fd, SLH_SEED)
+        os.close(fd)
+        for args, owner in (([self.program, keyfile], 0), ([sys.executable, "-c", "import sys; sys.stdin.read()"], uid)):
+            p = self.run_as_other_user(args)
+            try:
+                deadline = time.time() + 10
+                while True:
+                    # Wait until the program runs (after exec), not the forked test process.
+                    with open(f"/proc/{p.pid}/cmdline", "rb") as f:
+                        if f.read().split(b"\0")[0] == args[0].encode():
+                            break
+                    assert time.time() < deadline
+                    time.sleep(0.05)
+                time.sleep(0.2)
+                assert_equal(os.stat(f"/proc/{p.pid}/status").st_uid, owner)
+            finally:
+                p.stdin.close()
+                p.wait()
+        os.remove(keyfile)
+
+    def test_fault(self):
+        if not self.is_fault_build_compiled():
+            self.log.info("Skipping the fault build: it is built only with the tests (BUILD_TESTS) on Linux")
+            return
+        self.log.info("A signature that does not verify is never printed")
+        msg = bytes(range(32)).hex().encode()
+        code, out, err = self.run([self.keyfile], msg, program=self.fault_program)
+        assert code != 0
+        assert_equal(out, b"")
+        assert "does not verify" in err
+        self.log.info("A random source that fails: nothing printed")
+        env = dict(os.environ, SIGNET_SLH_SIGN_TEST_FAULT="random")
+        p = subprocess.run([self.fault_program, self.keyfile], input=msg, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
+        assert p.returncode != 0 and p.stdout == b""
+        assert "cannot read randomness" in p.stderr.decode()
+        # The same build still prints the public key, which involves no signature.
+        code, out, _ = self.run(["-pubkey", self.keyfile], program=self.fault_program)
+        assert_equal((code, bytes.fromhex(out.decode().strip())), (0, self.pubkey))
