+// SLH-DSA-SHA2-128s block signature (doc/signet-slhblock.md)
+
+//! Context string of the SLH-DSA block signature: kept apart from OP_CHECKSLHDSA128S's and from the
+//! ML-DSA-44 block signature's.
+static constexpr std::string_view SIGNET_SLH_CONTEXT{"SIGNET/SLHBLOCK/EXP0"};
+static_assert(SIGNET_SLH_SCRIPT_SIZE == SIGNET_SLH_SCRIPT_PREFIX.size() + SLHDSA128S_SIGNATURE_SIZE);
+static_assert(SIGNET_SLH_SCRIPT_SIZE == 7865);
+// The push length in the prefix: header, version and signature.
+static_assert(SIGNET_SLH_SCRIPT_PREFIX[2] + 256 * SIGNET_SLH_SCRIPT_PREFIX[3] == SIGNET_SLH_HEADER.size() + 1 + SLHDSA128S_SIGNATURE_SIZE);
+
+static const HashWriter HASHER_SIGNET_SLH_BLOCK{TaggedHash("SignetSLHBlock")};
+
+std::optional<SignetSLHBlockDigest> ComputeSignetSLHBlockMessage(const CBlockHeader& header, const CTransaction& coinbase,
+                                                                std::span<const uint256> other_txids, std::span<const uint8_t> challenge)
+{
+    int cidx{NO_WITNESS_COMMITMENT};
+    {
+        CBlock block;
+        block.vtx.push_back(MakeTransactionRef(coinbase));
+        cidx = GetWitnessCommitmentIndex(block);
+    }
+    if (cidx == NO_WITNESS_COMMITMENT || cidx < 1) return std::nullopt;
+
+    // pq_coinbase, as SignetPQBlockMessage makes it: the witness commitment output cut back to
+    // OP_RETURN, the commitment and a push of the PQ header and version. Then the SLH output at
+    // vout[c - 1] cut back to OP_RETURN and a push of its own header and version.
+    SignetSLHBlockDigest digest{.coinbase = CMutableTransaction{coinbase}, .merkle_root = {}, .message = {}};
+    CScript& commitment{digest.coinbase.vout.at(cidx).scriptPubKey};
+    std::vector<uint8_t> pq_cut{SIGNET_PQ_HEADER.begin(), SIGNET_PQ_HEADER.end()};
+    pq_cut.push_back(SIGNET_PQ_VERSION);
+    commitment = CScript(commitment.begin(), commitment.begin() + MINIMUM_WITNESS_COMMITMENT) << pq_cut;
+    std::vector<uint8_t> slh_cut{SIGNET_SLH_HEADER.begin(), SIGNET_SLH_HEADER.end()};
+    slh_cut.push_back(SIGNET_SLH_VERSION);
+    digest.coinbase.vout.at(cidx - 1).scriptPubKey = CScript() << OP_RETURN << slh_cut;
+
+    std::vector<uint256> leaves;
+    leaves.reserve((other_txids.size() + 2) & ~size_t{1}); // capacity rounded up to even
+    leaves.push_back(digest.coinbase.GetHash().ToUint256());
+    leaves.insert(leaves.end(), other_txids.begin(), other_txids.end());
+    digest.merkle_root = ComputeMerkleRoot(std::move(leaves));
+
+    // SHA256 of the raw challenge, as for the ML-DSA-44 block signature.
+    uint256 challenge_hash;
+    CSHA256().Write(challenge.data(), challenge.size()).Finalize(challenge_hash.begin());
+
+    HashWriter hasher{HASHER_SIGNET_SLH_BLOCK};
+    hasher << challenge_hash << header.nVersion << header.hashPrevBlock << digest.merkle_root << header.nTime;
+    digest.message = hasher.GetSHA256();
+    return digest;
+}
+
+std::optional<SignetSLHBlockDigest> ComputeSignetSLHBlockMessage(const CBlock& block, std::span<const uint8_t> challenge)
+{
+    if (block.vtx.empty()) return std::nullopt;
+    std::vector<uint256> other_txids;
+    other_txids.reserve(block.vtx.size() - 1);
+    for (size_t i{1}; i < block.vtx.size(); ++i) other_txids.push_back(block.vtx[i]->GetHash().ToUint256());
+    return ComputeSignetSLHBlockMessage(block, *block.vtx[0], other_txids, challenge);
+}
+
+std::optional<uint256> SignetSLHBlockMessage(const CBlock& block, std::span<const uint8_t> challenge)
+{
+    const auto digest{ComputeSignetSLHBlockMessage(block, challenge)};
+    if (!digest) return std::nullopt;
+    return digest->message;
+}
+
+std::optional<std::span<const unsigned char>> SignetSLHBlockSignature(const CBlock& block)
+{
+    // Rules 4B-1 and 4B-2, by bytes at fixed offsets only. Nothing here parses a script (no GetOp,
+    // no CheckMinimalPush), so no form of these bytes can reach an assertion.
+    if (block.vtx.empty()) return std::nullopt;
+    const int cidx{GetWitnessCommitmentIndex(block)};
+    if (cidx == NO_WITNESS_COMMITMENT || cidx < 1) return std::nullopt;
+    const std::vector<CTxOut>& outs{block.vtx[0]->vout};
+    const size_t slh_index{static_cast<size_t>(cidx - 1)};
+    const CTxOut& slh{outs[slh_index]};
+    if (slh.nValue != 0 || slh.scriptPubKey.size() != SIGNET_SLH_SCRIPT_SIZE) return std::nullopt;
+    if (!std::equal(SIGNET_SLH_SCRIPT_PREFIX.begin(), SIGNET_SLH_SCRIPT_PREFIX.end(), slh.scriptPubKey.begin())) return std::nullopt;
+    // No other coinbase output may start like an SLH output, whatever version byte follows.
+    for (size_t i{0}; i < outs.size(); ++i) {
+        if (i == slh_index) continue;
+        const CScript& script{outs[i].scriptPubKey};
+        if (script.size() >= SIGNET_SLH_UNIQUE_PREFIX_SIZE &&
+            std::equal(SIGNET_SLH_SCRIPT_PREFIX.begin(), SIGNET_SLH_SCRIPT_PREFIX.begin() + SIGNET_SLH_UNIQUE_PREFIX_SIZE, script.begin())) {
+            return std::nullopt;
+        }
+    }
+    return std::span<const unsigned char>{slh.scriptPubKey.data() + SIGNET_SLH_SCRIPT_PREFIX.size(), SLHDSA128S_SIGNATURE_SIZE};
+}
+
+bool CheckSignetSLHBlock(const CBlock& block, const Consensus::Params& consensusParams)
+{
+    const auto& rule{consensusParams.signet_slh_block};
+    if (!rule || block.GetHash() == consensusParams.hashGenesisBlock) return true;
+
+    // As for the ML-DSA-44 block signature: the height the coinbase commits to (BIP34), and a
+    // height that cannot be read counts as reached.
+    const std::optional<int> height{CoinbaseHeight(block)};
+    const bool enforced{!height || *height >= rule->height};
+    // Below the height nothing is rejected, and the block is only looked at to log whether it
+    // would pass, so that the signatures can be checked before they are enforced.
+    if (!enforced && !LogAcceptCategory(BCLog::VALIDATION, BCLog::Level::Debug)) return true;
+
+    // The form first, then slh_merkle, then the signature.
+    const std::optional<std::span<const unsigned char>> signature{SignetSLHBlockSignature(block)};
+    bool valid{false};
+    if (signature) {
+        const std::optional<uint256> message{SignetSLHBlockMessage(block, consensusParams.signet_challenge)};
+        valid = message && SLHDSA128SVerify(std::span<const unsigned char>{rule->pubkey},
+                                            std::span<const unsigned char>{message->data(), message->size()},
+                                            MakeUCharSpan(SIGNET_SLH_CONTEXT),
+                                            *signature);
+    }
+    if (!enforced) {
+        LogDebug(BCLog::VALIDATION, "CheckSignetSLHBlock: block %s below height %d, SLH-DSA block signature %s\n",
+                 block.GetHash().ToString(), rule->height, !signature ? "absent or not in the required form" : valid ? "valid" : "invalid");
+        return true;
+    }
+    if (!signature) {
+        LogDebug(BCLog::VALIDATION, "CheckSignetSLHBlock: Errors in block (no SLH-DSA block signature in the required form)\n");
+        return false;
+    }
+    if (!valid) {
+        LogDebug(BCLog::VALIDATION, "CheckSignetSLHBlock: Errors in block (SLH-DSA block signature invalid)\n");
+        return false;
+    }
+    return true;
+}
