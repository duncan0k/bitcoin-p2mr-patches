diff --git a/test/functional/feature_signet_slhblock_lattice.py b/test/functional/feature_signet_slhblock_lattice.py
new file mode 100644
index 0000000..8047f24
--- /dev/null
+++ b/test/functional/feature_signet_slhblock_lattice.py
@@ -0,0 +1,356 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test the SLH-DSA block signature and the P2MR lattice tripwire rules starting at the same height,
+as they do on the Ark-0 signet at H4T (doc/signet-slhblock.md, doc/p2mr-lattice-tripwire.md).
+
+The two rules share no code or state: the SLH-DSA block signature is a block rule on the coinbase,
+checked in CheckBlock, and the lattice tripwire a script rule on spends of leaf version 0xe2,
+checked in ConnectBlock from the UTXO set. Two custom signets, each on a node of its own, with every
+option of both: -signetpqblock, -signetmldsa44, -signettripwire, -signetslhdsa128s, and
+-signetslhblock and -signetlatticetripwire at one height.
+
+- Node 0, both from height 6, with a lattice tripwire output that never existed: the four start-up
+  lines; blocks signed SLH first, then ML-DSA-44, accepted below, at and above the height; at the
+  height both rules start, and ML-DSA-44 checks in 0xe2 are disabled since a tripwire is missing;
+  above it a block without the SLH output is refused as bad-signet-slhblk with the lattice state
+  unchanged; and the dependency checks of the options, each series' own.
+- Node 1, shaped like Ark-0: three lattice tripwire outputs created by one transaction below the
+  height, both rules from height 110. An ML-DSA-44 spend of leaf version 0xe2 is accepted in a block
+  below the height (unexecuted) and after it while the three outputs are present; once the drill
+  output is spent, an ML-DSA-44 spend in 0xe2 is refused, in the mempool and in a block, while an
+  SLH-DSA spend in 0xe2 is still accepted, in blocks that carry the SLH output.
+"""
+
+import hashlib
+import importlib.machinery
+import importlib.util
+import logging
+import os
+import subprocess
+
+from test_framework.messages import COIN, COutPoint, CBlockHeader, CTransaction, CTxIn, CTxInWitness, CTxOut, from_hex
+from test_framework.p2mr_lattice_tripwire import (
+    MLDSA_DISABLED_ERROR,
+    lattice_tripwire_tree,
+    mldsa44_any_leaf_witness,
+    nums_pubkey,
+    pq2_tree,
+    slhdsa128s_leaf_witness,
+)
+from test_framework.p2mr_mldsa44 import mldsa44_keygen
+from test_framework.p2mr_slhdsa128s import slhdsa128s_keygen
+from test_framework.script import CScript, OP_TRUE
+from test_framework.signet_pq import add_signet_pq_signature, signet_pq_keygen
+from test_framework.signet_slh import (
+    add_signet_slh_and_pq_signatures,
+    program_slh_pubkey,
+    program_slh_signer,
+    python_slh_signer,
+    signet_slh_sign_program,
+    verify_signet_slh_signature,
+)
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.test_node import ErrorMatch
+from test_framework.util import assert_equal, assert_raises_rpc_error
+from test_framework.wallet import MiniWallet
+
+PQ_PUBKEY, PQ_SECKEY = signet_pq_keygen(bytes.fromhex("11" * 32))
+SLH_SEED = hashlib.sha256(b"tb_both_rules key").digest() + bytes(16)
+CHALLENGE = bytes(CScript([OP_TRUE]))
+NEVER_CREATED = f"{'22' * 32}:1"
+# Node 0: both rules from height 6, the lattice tripwire's (M4-T) and the SLH block signature's (M4-B).
+H = 6
+# Node 1: the ML-DSA-44 block signature from 104, both rules from 110, the outputs created below 104.
+PQ_B, H_B = 104, 110
+FUND_SATS = 100_000
+FEE_SATS = 5_000
+
+
+def seckey(tag):
+    return hashlib.sha256(b"feature_signet_slhblock_lattice " + tag).digest()
+
+
+L2_PUB, L2_SEC = mldsa44_keygen(seckey(b"destroyed"))
+L3_PUB, L3_SEC = mldsa44_keygen(seckey(b"drill"))
+PQ_PUB, PQ_SEC = mldsa44_keygen(seckey(b"ml-dsa-44"))
+SLH_PUB, SLH_SEC = slhdsa128s_keygen(hashlib.sha512(b"feature_signet_slhblock_lattice slh").digest()[:48])
+# The three lattice tripwire outputs, in Ark-0's order: the NUMS key, a "destroyed" key, the drill key.
+TREES = {"L1": lattice_tripwire_tree(nums_pubkey()), "L2": lattice_tripwire_tree(L2_PUB), "L3": lattice_tripwire_tree(L3_PUB)}
+# pq2: S1 and SLH1 in leaf version 0xe2.
+PQ2 = pq2_tree(PQ_PUB, SLH_PUB)
+
+
+def load_signet_miner(srcdir):
+    path = os.path.join(srcdir, "contrib", "signet", "miner")
+    loader = importlib.machinery.SourceFileLoader("signetminer", path)
+    spec = importlib.util.spec_from_loader("signetminer", loader)
+    module = importlib.util.module_from_spec(spec)
+    root = logging.getLogger()
+    handlers = list(root.handlers)
+    loader.exec_module(module)
+    for handler in list(root.handlers):
+        if handler not in handlers:
+            root.removeHandler(handler)
+    return module
+
+
+def outpoint(tx, n):
+    return f"{tx.txid_hex}:{n}"
+
+
+class SignetSLHBlockLatticeTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.chain = "signet"
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+        self.rpc_timeout = 240
+        self.slh_pubkey, self.slh_seckey = slhdsa128s_keygen(SLH_SEED)
+        self.lattice = ["-signetmldsa44=1", f"-signettripwire=3@{'11' * 32}:0", "-signetslhdsa128s=4",
+                        f"-signetlatticetripwire={H}@{NEVER_CREATED}"]
+        self.blocksig = [f"-signetpqblock={PQ_PUBKEY.hex()}@2", f"-signetslhblock={self.slh_pubkey.hex()}@{H}"]
+        # Node 1 starts without -signetlatticetripwire: its outputs do not exist yet.
+        self.base_b = ["-signetchallenge=51", "-signetmldsa44=1", f"-signettripwire=3@{'11' * 32}:0", "-signetslhdsa128s=4",
+                       f"-signetpqblock={PQ_PUBKEY.hex()}@{PQ_B}", f"-signetslhblock={self.slh_pubkey.hex()}@{H_B}",
+                       "-blockreservedweight=48000", "-debug=validation"]
+        self.extra_args = [["-signetchallenge=51"] + self.lattice + self.blocksig + ["-blockreservedweight=48000"], self.base_b]
+
+    def skip_test_if_missing_module(self):
+        self.skip_if_no_bitcoin_util()
+
+    def setup_network(self):
+        # Two separate signets: the nodes are not connected.
+        self.setup_nodes()
+
+    # ------------------------------------------------------------------
+    # Blocks
+    # ------------------------------------------------------------------
+
+    def grind(self, node, block):
+        util_argv = node.binaries.util_argv() + ["grind"]
+        out = subprocess.run(util_argv + [CBlockHeader.serialize(block).hex()], stdout=subprocess.PIPE, check=True).stdout.strip()
+        block.nNonce = from_hex(CBlockHeader(), out.decode()).nNonce
+        return block
+
+    def block(self, node, *, slh=True, pq=True, txs=None, reward=CHALLENGE):
+        """A block from node's template, or with txs in place of the template's transactions (the
+        node can hand out the same template for a few seconds after its mempool changed), signed
+        SLH first, then ML-DSA-44 (or ML-DSA-44 only, or neither), then ground."""
+        tmpl = node.getblocktemplate({"rules": ["signet", "segwit"]})
+        if txs is not None:
+            # The coinbase gives up the fees of the template's transactions and of txs.
+            tmpl["coinbasevalue"] -= sum(t["fee"] for t in tmpl["transactions"])
+            tmpl["transactions"] = [{"data": tx.serialize().hex()} for tx in txs]
+        block = self.miner.new_block(tmpl, reward)
+        if slh:
+            add_signet_slh_and_pq_signatures(block, CHALLENGE, self.sign, PQ_SECKEY)
+            assert verify_signet_slh_signature(block, self.slh_pubkey, CHALLENGE)
+        elif pq:
+            add_signet_pq_signature(block, PQ_SECKEY, CHALLENGE)
+        return self.grind(node, block)
+
+    def submit(self, node, block, expected=None):
+        assert_equal(node.submitblock(block.serialize().hex()), expected)
+
+    def mine_to_wallet(self, node, count, txs=None):
+        """count blocks below the ML-DSA-44 block signature's height, paying the wallet, the first with
+        txs; ground by bitcoin-util, faster than the node's own miner."""
+        for i in range(count):
+            self.submit(node, self.block(node, slh=False, pq=False, txs=txs if i == 0 else None, reward=self.wallet.get_output_script()))
+        self.wallet.rescan_utxos()
+
+    # ------------------------------------------------------------------
+    # Node 1's transactions
+    # ------------------------------------------------------------------
+
+    def spend(self, utxo, make_witness):
+        """A spend of one output of the funding transaction to the wallet, with the witness make_witness gives."""
+        tx = CTransaction()
+        tx.vin = [CTxIn(COutPoint(utxo["tx"].txid_int, utxo["n"]), b"", 0xfffffffd)]
+        tx.vout = [CTxOut(FUND_SATS - FEE_SATS, self.wallet.get_output_script())]
+        spent = [utxo["tx"].vout[utxo["n"]]]
+        tx.wit.vtxinwit = [CTxInWitness()]
+        tx.wit.vtxinwit[0].scriptWitness.stack = make_witness(tx, spent, 0)
+        return tx
+
+    def pq_spend(self, utxo):
+        leaf = PQ2.leaves["pq"]
+        return self.spend(utxo, lambda tx, spent, index: mldsa44_any_leaf_witness(PQ_SEC, leaf, tx, spent, index))
+
+    def slh_spend(self, utxo):
+        leaf = PQ2.leaves["slh"]
+        return self.spend(utxo, lambda tx, spent, index: slhdsa128s_leaf_witness(SLH_SEC, leaf, tx, spent, index))
+
+    def lattice_info(self, node):
+        return node.gettripwireinfo()["lattice"]
+
+    # ------------------------------------------------------------------
+    # Test body
+    # ------------------------------------------------------------------
+
+    def run_test(self):
+        self.miner = load_signet_miner(self.config["environment"]["SRCDIR"])
+        program = signet_slh_sign_program(self.config)
+        if program is None:
+            self.log.info("signet-slh-sign is not built: the blocks are signed in Python, which is slower")
+            self.sign = python_slh_signer(self.slh_seckey)
+        else:
+            keyfile = os.path.join(self.options.tmpdir, "slh.key")
+            with open(keyfile, "wb") as f:
+                f.write(SLH_SEED)
+            assert_equal(program_slh_pubkey(program, keyfile), self.slh_pubkey)
+            self.sign = program_slh_signer(program, keyfile, pubkey=self.slh_pubkey)
+
+        self.test_both_rules_never_created()
+        self.test_options()
+        self.test_both_rules_with_outputs()
+
+    def test_both_rules_never_created(self):
+        node = self.nodes[0]
+
+        self.log.info("Start-up: both rules log their line")
+        log = node.debug_log_path.read_text()
+        slh_key_sha = hashlib.sha256(self.slh_pubkey).hexdigest()
+        pq_key_sha = hashlib.sha256(PQ_PUBKEY).hexdigest()
+        for line in (f"Signet P2MR lattice tripwire rules from height {H} in leaf version 0xe2; tripwire outputs {NEVER_CREATED}",
+                     "P2MR SLH-DSA-SHA2-128s rules active from height 4 (leaf versions 0xc0, 0xe0, 0xe2)",
+                     f"Signet blocks need an ML-DSA-44 block signature from height 2, by the key whose SHA256 is {pq_key_sha}",
+                     f"Signet SLH-DSA block signature required from height {H}, public key SHA256 {slh_key_sha}"):
+            assert line in log, line
+
+        self.log.info("Blocks below, at and above the height of both rules, signed SLH first, then ML-DSA-44")
+        for height in range(1, H + 3):
+            if height == H:
+                with node.assert_debug_log([f"P2MR lattice tripwire rules active from height {H}, reached by block ",
+                                            f"lattice tripwire outputs {NEVER_CREATED} missing; ML-DSA-44 checks in leaf version 0xe2 are disabled for the next block"]):
+                    self.submit(node, self.block(node))
+            else:
+                self.submit(node, self.block(node))
+            assert_equal(node.getblockcount(), height)
+            # Both rules start at the same block: the deployment is active for the next block from H - 1 on.
+            assert_equal(node.getdeploymentinfo()["deployments"]["p2mr_lattice_tripwire"]["active"], height >= H - 1)
+            assert_equal(self.lattice_info(node)["mldsa_disabled_next_block"], height >= H - 1)
+        assert "P2MR_LATTICE_TRIPWIRE" in node.getdeploymentinfo()["script_flags"]
+
+        self.log.info("Above both heights, a block without the SLH output is refused, the lattice tripwire state unchanged")
+        before = self.lattice_info(node)
+        self.submit(node, self.block(node, slh=False), "bad-signet-slhblk")
+        assert_equal(node.getblockcount(), H + 2)
+        assert_equal(self.lattice_info(node), before)
+        assert_equal(before["mldsa_disabled_next_block"], True)
+
+    def test_options(self):
+        self.log.info("The options' dependency checks stay separate")
+        node = self.nodes[0]
+        node.stop_node()
+        base = ["-signetchallenge=51"]
+        cases = [
+            (self.lattice + [f"-signetslhblock={self.slh_pubkey.hex()}@{H}"], "-signetslhblock requires -signetpqblock."),
+            ([a for a in self.lattice if not a.startswith("-signetslhdsa128s")] + self.blocksig, "-signetlatticetripwire requires -signetslhdsa128s."),
+            ([a for a in self.lattice if not a.startswith("-signetmldsa44")] + self.blocksig, "-signettripwire requires -signetmldsa44."),
+        ]
+        for args, error in cases:
+            node.assert_start_raises_init_error(base + args, f"Error: {error}", match=ErrorMatch.FULL_TEXT)
+        # Both rules, on the same chain data, still start.
+        self.restart_node(0, base + self.lattice + self.blocksig)
+        assert_equal(node.getblockcount(), H + 2)
+
+    def test_both_rules_with_outputs(self):
+        node = self.nodes[1]
+        self.wallet = MiniWallet(node)
+
+        self.log.info(f"Node 1: {PQ_B - 2} blocks, then one transaction creates the three lattice tripwire outputs below the height")
+        self.mine_to_wallet(node, PQ_B - 3)
+        utxo = self.wallet.get_utxo(confirmed_only=True)
+        names = ["L1", "L2", "L3", "pq_below", "pq_at", "pq_after", "slh_after"]
+        fund = CTransaction()
+        fund.vin = [CTxIn(COutPoint(int(utxo["txid"], 16), utxo["vout"]), b"", 0xfffffffd)]
+        fund.vout = [CTxOut(FUND_SATS, (TREES[n] if n in TREES else PQ2).scriptPubKey) for n in names]
+        fund.vout.append(CTxOut(int(utxo["value"] * COIN) - FUND_SATS * len(names) - FEE_SATS, self.wallet.get_output_script()))
+        self.wallet.sign_tx(fund)
+        node.sendrawtransaction(fund.serialize().hex())
+        self.mine_to_wallet(node, 1, txs=[fund])
+        creation_height = node.getblockcount()
+        assert_equal(creation_height, PQ_B - 2)
+        assert fund.txid_hex in node.getblock(node.getbestblockhash())["tx"]
+        self.outs = {n: {"tx": fund, "n": i} for i, n in enumerate(names)}
+        tripwires = [outpoint(fund, i) for i in range(3)]
+
+        self.log.info(f"Restart with the lattice tripwire rules from {H_B}, the height of the SLH block signature: the start-up lines")
+        lattice_arg = f"-signetlatticetripwire={H_B}@{','.join(tripwires)}"
+        states = ", ".join(f"{t} unspent" for t in tripwires)
+        with node.assert_debug_log([f"Signet P2MR lattice tripwire rules from height {H_B} in leaf version 0xe2; tripwire outputs {', '.join(tripwires)}",
+                                    "P2MR SLH-DSA-SHA2-128s rules active from height 4 (leaf versions 0xc0, 0xe0, 0xe2)",
+                                    f"Signet blocks need an ML-DSA-44 block signature from height {PQ_B}, by the key whose SHA256 is {hashlib.sha256(PQ_PUBKEY).hexdigest()}",
+                                    f"Signet SLH-DSA block signature required from height {H_B}, public key SHA256 {hashlib.sha256(self.slh_pubkey).hexdigest()}",
+                                    f"P2MR lattice tripwire state at height {creation_height}: lattice tripwire outputs {states}; "
+                                    "ML-DSA-44 checks in leaf version 0xe2 are enabled for the next block"]):
+            self.restart_node(1, self.base_b + [lattice_arg])
+        assert_equal(node.getdeploymentinfo()["deployments"]["p2mr_lattice_tripwire"], {"type": "buried", "active": False, "height": H_B})
+        reward = self.wallet.get_output_script()
+        self.mine_to_wallet(node, 1)
+        assert_equal(node.getblockcount(), PQ_B - 1)
+
+        self.log.info("Below the height: an ML-DSA-44 spend of leaf version 0xe2 stays out of the mempool, and a block takes it")
+        below = self.pq_spend(self.outs["pq_below"])
+        assert_raises_rpc_error(-26, "Taproot version reserved for soft-fork upgrades", node.sendrawtransaction, below.serialize().hex())
+        self.submit(node, self.block(node, slh=False, txs=[below], reward=reward))
+        assert_equal(node.getblockcount(), PQ_B)
+        assert below.txid_hex in node.getblock(node.getbestblockhash())["tx"]
+
+        self.log.info("Blocks below the height, with the ML-DSA-44 block signature, then also the SLH one")
+        while node.getblockcount() < H_B - 3:
+            self.submit(node, self.block(node, slh=False, reward=reward))
+        while node.getblockcount() < H_B - 1:
+            with node.assert_debug_log([f"below height {H_B}, SLH-DSA block signature valid"]):
+                self.submit(node, self.block(node, reward=reward))
+        assert_equal(self.lattice_info(node)["mldsa_disabled_next_block"], False)
+        assert_equal(node.getdeploymentinfo()["deployments"]["p2mr_lattice_tripwire"]["active"], True)
+
+        self.log.info("At the height: a block without the SLH output is refused; with it, both rules start, the three outputs present")
+        self.submit(node, self.block(node, slh=False, reward=reward), "bad-signet-slhblk")
+        with node.assert_debug_log([f"P2MR lattice tripwire rules active from height {H_B}, reached by block ",
+                                    f"lattice tripwire outputs {states}; ML-DSA-44 checks in leaf version 0xe2 are enabled for the next block"]):
+            self.submit(node, self.block(node, reward=reward))
+        assert_equal(node.getblockcount(), H_B)
+        assert_equal([t["state"] for t in self.lattice_info(node)["tripwires"]], ["unspent"] * 3)
+
+        self.log.info("Above it, with all three present: an ML-DSA-44 spend of leaf version 0xe2 is accepted, in the mempool and in a block")
+        at = self.pq_spend(self.outs["pq_at"])
+        node.sendrawtransaction(at.serialize().hex())
+        self.submit(node, self.block(node, txs=[at], reward=reward))
+        assert at.txid_hex in node.getblock(node.getbestblockhash())["tx"]
+
+        self.log.info("The drill output is spent: ML-DSA-44 checks in leaf version 0xe2 are disabled from the next block on")
+        leaf = TREES["L3"].leaves["pq"]
+        trip = self.spend({"tx": self.outs["L3"]["tx"], "n": self.outs["L3"]["n"]},
+                          lambda tx, spent, index: mldsa44_any_leaf_witness(L3_SEC, leaf, tx, spent, index))
+        node.sendrawtransaction(trip.serialize().hex())
+        height = node.getblockcount() + 1
+        with node.assert_debug_log([f"P2MR lattice tripwire {tripwires[2]} spent by {trip.txid_hex} in block "]):
+            self.submit(node, self.block(node, txs=[trip], reward=reward))
+        assert_equal(node.getblockcount(), height)
+        info = self.lattice_info(node)
+        assert_equal([t["state"] for t in info["tripwires"]], ["unspent", "unspent", "missing"])
+        assert_equal(info["mldsa_disabled_next_block"], True)
+
+        self.log.info("Then an ML-DSA-44 spend in 0xe2 is refused, in the mempool and in a block, an SLH-DSA spend in 0xe2 still accepted")
+        after = self.pq_spend(self.outs["pq_after"])
+        assert_raises_rpc_error(-26, MLDSA_DISABLED_ERROR, node.sendrawtransaction, after.serialize().hex())
+        self.submit(node, self.block(node, txs=[after], reward=reward), f"block-script-verify-flag-failed ({MLDSA_DISABLED_ERROR})")
+        slh = self.slh_spend(self.outs["slh_after"])
+        node.sendrawtransaction(slh.serialize().hex())
+        self.submit(node, self.block(node, txs=[slh], reward=reward))
+        assert slh.txid_hex in node.getblock(node.getbestblockhash())["tx"]
+        assert_equal(node.getblockcount(), height + 1)
+
+        self.log.info("Above both heights, a block without the SLH output is refused, the lattice tripwire state unchanged")
+        before = self.lattice_info(node)
+        self.submit(node, self.block(node, slh=False, reward=reward), "bad-signet-slhblk")
+        assert_equal(self.lattice_info(node), before)
+        assert_equal(node.getblockcount(), height + 1)
+
+
+if __name__ == '__main__':
+    SignetSLHBlockLatticeTest(__file__).main()
