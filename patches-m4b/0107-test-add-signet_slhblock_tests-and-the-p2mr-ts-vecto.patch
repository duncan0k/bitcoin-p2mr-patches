+    fails({{"-signetchallenge", "51"}, pq, {"-signetslhblock", key + "00@5"}}, "-signetslhblock needs a 32-byte SLH-DSA-SHA2-128s public key, not 33 bytes.");
+    fails({{"-signetchallenge", "51"}, {"-signetpqblock", PQ_KEY + "@1"}, {"-signetslhblock", key + "@0"}}, "-signetslhblock height must be at least 1, not 0.");
+    // Negative, empty, zero, and outside int32_t: refused, never wrapped.
