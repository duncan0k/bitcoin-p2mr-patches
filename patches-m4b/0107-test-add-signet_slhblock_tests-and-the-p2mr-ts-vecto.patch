+    fails({{"-signetchallenge", "51"}, pq1, {"-signetslhblock", key + "@"}}, "-signetslhblock must be <pubkey>@<height>, not '" + key + "@'.");
+    fails({{"-signetchallenge", "51"}, pq1, {"-signetslhblock", key + "@00"}}, "-signetslhblock height must be at least 1, not 0.");
+    fails({{"-signetchallenge", "51"}, pq1, {"-signetslhblock", key + "@2147483648"}}, "-signetslhblock must be <pubkey>@<height>, not '" + key + "@2147483648'.");
+    fails({{"-signetchallenge", "51"}, pq1, {"-signetslhblock", key + "@99999999999999999999"}}, "-signetslhblock must be <pubkey>@<height>, not '" + key + "@99999999999999999999'.");
+    fails({{"-signetchallenge", "51"}, pq1, {"-signetslhblock", key + "@ 5"}}, "-signetslhblock must be <pubkey>@<height>, not '" + key + "@ 5'.");
