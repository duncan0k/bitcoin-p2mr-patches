+// Rules 4B-1 and 4B-2: every form of the SLH output the rule rejects, at the height. The signature
+// stays the one of the signed block; each variant fails for its form, before the signature.
+BOOST_AUTO_TEST_CASE(form)
+{
+    const CBlock& block{SignedBlock()};
+    const auto params{SLHParams(Key().pubkey, 100)};
+    const CScript script{block.vtx[0]->vout[1].scriptPubKey};
+    const std::vector<unsigned char> signature(script.begin() + 9, script.end());
+    const auto rejects{[&](const std::string& name, const CBlock& variant) {
+        BOOST_TEST_MESSAGE(name);
+        BOOST_CHECK_MESSAGE(!SignetSLHBlockSignature(variant), name);
+        BOOST_CHECK_MESSAGE(!CheckSignetSLHBlock(variant, params->GetConsensus()), name);
+    }};
+    const auto with_script{[&](const CScript& s) {
+        return WithCoinbase(block, [&](CMutableTransaction& tx) { tx.vout.at(1).scriptPubKey = s; });
+    }};
+    auto bytes{[&](std::vector<unsigned char> prefix, size_t sig_size, std::vector<unsigned char> tail = {}) {
+        CScript s(prefix.begin(), prefix.end());
+        s.insert(s.end(), signature.begin(), signature.begin() + std::min(sig_size, signature.size()));
+        if (sig_size > signature.size()) s.insert(s.end(), sig_size - signature.size(), 0);
+        s.insert(s.end(), tail.begin(), tail.end());
+        return s;
+    }};
+    const std::vector<unsigned char> head{0x50, 0x51, 0x48, 0x31, 0x01};
+
+    // Position.
+    rejects("missing", WithCoinbase(block, [](CMutableTransaction& tx) { tx.vout.erase(tx.vout.begin() + 1); }));
+    rejects("after the commitment", WithCoinbase(block, [](CMutableTransaction& tx) { std::swap(tx.vout[1], tx.vout[2]); }));
+    rejects("at c - 2", WithCoinbase(block, [](CMutableTransaction& tx) { tx.vout.insert(tx.vout.begin() + 2, CTxOut{0, CScript() << OP_RETURN}); }));
+    rejects("c = 0", WithCoinbase(block, [](CMutableTransaction& tx) { tx.vout.erase(tx.vout.begin(), tx.vout.begin() + 2); }));
+    rejects("c = 0 with the SLH output after it", WithCoinbase(block, [](CMutableTransaction& tx) { tx.vout.erase(tx.vout.begin()); std::swap(tx.vout[0], tx.vout[1]); }));
+    rejects("no witness commitment", WithCoinbase(block, [](CMutableTransaction& tx) { tx.vout.pop_back(); }));
+    // Encoding.
+    rejects("header PQB1", with_script(bytes({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x42, 0x31, 0x01}, 7856)));
+    rejects("header PQH2", with_script(bytes({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x32, 0x01}, 7856)));
+    rejects("version 0", with_script(bytes({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x00}, 7856)));
+    rejects("version 2", with_script(bytes({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x02}, 7856)));
+    rejects("OP_PUSHDATA4", with_script(bytes({0x6a, 0x4e, 0xb5, 0x1e, 0x00, 0x00, 0x50, 0x51, 0x48, 0x31, 0x01}, 7856)));
+    rejects("OP_PUSHDATA1 (cannot hold it)", with_script(bytes({0x6a, 0x4c, 0xff, 0x50, 0x51, 0x48, 0x31, 0x01}, 7856)));
+    rejects("signature of 7855 bytes", with_script(bytes({0x6a, 0x4d, 0xb4, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x01}, 7855)));
+    rejects("signature of 7857 bytes", with_script(bytes({0x6a, 0x4d, 0xb6, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x01}, 7857)));
+    rejects("7855 bytes, the length unchanged", with_script(bytes({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x01}, 7855)));
+    rejects("a byte after it", with_script(bytes({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x01}, 7856, {0x00})));
+    rejects("OP_RETURN after it", with_script(bytes({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x01}, 7856, {0x6a})));
+    rejects("no OP_RETURN", with_script(bytes({0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x01}, 7856, {0x00})));
+    rejects("the placeholder", with_script(Placeholder()));
+    rejects("empty", with_script(CScript{}));
+    // Non-push opcodes and unparsable pushes in place of the push opcode: compared as bytes, never parsed.
+    for (unsigned char op : {0x00, 0x4f, 0x51, 0x61, 0xab, 0xf1, 0xff}) {
+        rejects("opcode " + HexStr(std::vector<unsigned char>{op}), with_script(bytes({0x6a, op, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x01}, 7856)));
+    }
+    rejects("a truncated OP_PUSHDATA2", with_script(Raw({0x6a, 0x4d, 0xb5})));
+    rejects("an OP_PUSHDATA4 longer than the script", with_script(bytes({0x6a, 0x4e, 0xff, 0xff, 0xff, 0xff}, 7859)));
+    rejects("amount 1", WithCoinbase(block, [](CMutableTransaction& tx) { tx.vout[1].nValue = 1; }));
+    rejects("amount -1", WithCoinbase(block, [](CMutableTransaction& tx) { tx.vout[1].nValue = -1; }));
+    // Rule 4B-2: no other output starts with the first 8 bytes, whatever follows.
+    rejects("a second SLH output before", WithCoinbase(block, [&](CMutableTransaction& tx) { tx.vout.insert(tx.vout.begin(), tx.vout[1]); }));
+    rejects("another output with the prefix", WithCoinbase(block, [](CMutableTransaction& tx) {
+        tx.vout[0].scriptPubKey = Raw({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x31});
+    }));
+    rejects("another output with the prefix and another version", WithCoinbase(block, [](CMutableTransaction& tx) {
+        tx.vout[0].scriptPubKey = Raw({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48, 0x31, 0x07});
+    }));
+    rejects("the prefix after the commitment", WithCoinbase(block, [](CMutableTransaction& tx) {
+        tx.vout.push_back(tx.vout[1]);
+    }));
+    // Seven bytes of the prefix elsewhere are allowed.
+    BOOST_CHECK(CheckSignetSLHBlock(Signed(WithCoinbase(MakeBlock(100), [](CMutableTransaction& tx) {
+        tx.vout[0].scriptPubKey = Raw({0x6a, 0x4d, 0xb5, 0x1e, 0x50, 0x51, 0x48});
+    })), params->GetConsensus()));
+    // The commitment is the last output with its prefix: one more before the SLH output does not move it.
+    BOOST_CHECK(CheckSignetSLHBlock(Signed(WithCoinbase(MakeBlock(100), [](CMutableTransaction& tx) {
+        tx.vout.insert(tx.vout.begin(), tx.vout[2]);
+    })), params->GetConsensus()));
+    // The coinbase may hold only the SLH output and the commitment (c = 1).
+    BOOST_CHECK(CheckSignetSLHBlock(Signed(WithCoinbase(MakeBlock(100), [](CMutableTransaction& tx) { tx.vout.erase(tx.vout.begin()); })), params->GetConsensus()));
+}
