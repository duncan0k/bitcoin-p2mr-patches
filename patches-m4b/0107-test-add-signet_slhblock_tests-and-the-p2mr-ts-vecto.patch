+// The height: the BIP34 push, read as for the ML-DSA-44 block signature; the genesis block.
+BOOST_AUTO_TEST_CASE(height)
+{
+    const CBlock unsigned_block{MakeBlock(100)};
+    const auto with_height{[&](const CScript& script_sig) {
+        return WithCoinbase(unsigned_block, [&](CMutableTransaction& tx) { tx.vin[0].scriptSig = script_sig; });
+    }};
+    // Unsigned blocks: rejected at the height they commit to, accepted one below the rule's height.
+    for (const int64_t h : {int64_t{127}, int64_t{128}, int64_t{255}, int64_t{256}, int64_t{32767}, int64_t{32768}, int64_t{8388607}, int64_t{8388608}, int64_t{std::numeric_limits<int>::max() - 1}}) {
+        const CBlock block{with_height(CScript() << h << OP_0)};
+        const auto params{SLHParams(Key().pubkey, static_cast<int>(h))};
+        const auto above{SLHParams(Key().pubkey, static_cast<int>(h) + 1)};
+        BOOST_CHECK_MESSAGE(!CheckSignetSLHBlock(block, params->GetConsensus()), h);
+        BOOST_CHECK_MESSAGE(CheckSignetSLHBlock(block, above->GetConsensus()), h);
+    }
+    // A height that cannot be read counts as reached: a non-minimal push, a missing one, a negative one.
+    const auto params{SLHParams(Key().pubkey, std::numeric_limits<int>::max() - 1)};
+    BOOST_CHECK(!CheckSignetSLHBlock(with_height(Raw({0x02, 0x64, 0x00})), params->GetConsensus()));
+    BOOST_CHECK(!CheckSignetSLHBlock(with_height(CScript()), params->GetConsensus()));
+    BOOST_CHECK(!CheckSignetSLHBlock(with_height(CScript() << -1), params->GetConsensus()));
+    BOOST_CHECK(!CheckSignetSLHBlock(with_height(CScript() << OP_RETURN), params->GetConsensus()));
+    // H - 1 and H, with a signed block.
+    BOOST_CHECK(CheckSignetSLHBlock(SignedBlock(), SLHParams(Key().pubkey, 100)->GetConsensus()));
+    BOOST_CHECK(!CheckSignetSLHBlock(unsigned_block, SLHParams(Key().pubkey, 100)->GetConsensus()));
+    BOOST_CHECK(CheckSignetSLHBlock(unsigned_block, SLHParams(Key().pubkey, 101)->GetConsensus()));
+
+    // Below the height a verdict is logged with -debug=validation.
+    const auto below{SLHParams(Key().pubkey, 101)};
+    LogInstance().EnableCategory(BCLog::VALIDATION);
+    LogInstance().SetCategoryLogLevel("validation", "debug");
+    {
+        ASSERT_DEBUG_LOG("below height 101, SLH-DSA block signature valid");
+        BOOST_CHECK(CheckSignetSLHBlock(SignedBlock(), below->GetConsensus()));
+    }
+    {
+        ASSERT_DEBUG_LOG("below height 101, SLH-DSA block signature invalid");
+        BOOST_CHECK(CheckSignetSLHBlock(Signed(MakeBlock(100), OtherKey()), below->GetConsensus()));
+    }
+    {
+        ASSERT_DEBUG_LOG("below height 101, SLH-DSA block signature absent or not in the required form");
+        BOOST_CHECK(CheckSignetSLHBlock(unsigned_block, below->GetConsensus()));
+    }
+    {
+        ASSERT_DEBUG_LOG("CheckSignetSLHBlock: Errors in block (no SLH-DSA block signature in the required form)");
+        BOOST_CHECK(!CheckSignetSLHBlock(unsigned_block, SLHParams(Key().pubkey, 100)->GetConsensus()));
+    }
+    {
+        ASSERT_DEBUG_LOG("CheckSignetSLHBlock: Errors in block (SLH-DSA block signature invalid)");
+        BOOST_CHECK(!CheckSignetSLHBlock(Signed(MakeBlock(100), OtherKey()), SLHParams(Key().pubkey, 100)->GetConsensus()));
+    }
+    LogInstance().DisableCategory(BCLog::VALIDATION);
+
+    // The genesis block is exempt by its hash, and only it.
+    const auto genesis_params{SLHParams(Key().pubkey, 1)};
+    const CBlock& genesis{genesis_params->GenesisBlock()};
+    BOOST_CHECK(CheckSignetSLHBlock(genesis, genesis_params->GetConsensus()));
+    CBlock not_genesis{genesis};
+    ++not_genesis.nNonce;
+    BOOST_CHECK(!CheckSignetSLHBlock(not_genesis, genesis_params->GetConsensus()));
+    // Without the rule nothing is checked.
