+// The Ark-0 signet has no SLH-DSA block signature until its height and key are decided: M4-B is
+// inactive there, and the option is refused.
+BOOST_AUTO_TEST_CASE(ark0_inactive)
+{
+    BOOST_CHECK_EQUAL(ARK0_SLH_BLOCK_HEIGHT, std::numeric_limits<int>::max());
+    ArgsManager args;
+    args.ForceSetArg("-signetchallenge", std::string{ARK0_CHALLENGE});
+    const auto params{CreateChainParams(args, ChainType::SIGNET)};
+    BOOST_CHECK(!params->GetConsensus().signet_slh_block);
+    // The M2 rule is there; an Ark-0 block without any SLH output passes the M4-B check at any height.
+    BOOST_CHECK(params->GetConsensus().signet_pq_block);
+    CBlock block{MakeBlock(100)};
+    block = WithCoinbase(block, [](CMutableTransaction& tx) {
+        tx.vout.erase(tx.vout.begin() + 1);
+        tx.vin[0].scriptSig = CScript() << std::numeric_limits<int>::max() - 1 << OP_0;
+    });
+    BOOST_CHECK(CheckSignetSLHBlock(block, params->GetConsensus()));
+}
