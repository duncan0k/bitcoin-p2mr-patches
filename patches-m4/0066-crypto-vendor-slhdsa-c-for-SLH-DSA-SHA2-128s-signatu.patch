diff --git a/src/crypto/CMakeLists.txt b/src/crypto/CMakeLists.txt
index e1ae782..6b533b6 100644
--- a/src/crypto/CMakeLists.txt
+++ b/src/crypto/CMakeLists.txt
@@ -21,6 +21,126 @@ set_target_properties(bitcoin_mldsa44 PROPERTIES
   C_VISIBILITY_PRESET hidden
 )
 
+# SLH-DSA-SHA2-128s (FIPS 205) verification, vendored from slhdsa-c: see
+# slhdsa128s/README.md. The files of the SHA2 parameter sets only, unmodified,
+# with the library's own portable C SHA-256. The include directory is PUBLIC
+# so that the unit tests can sign with the same code; the node only verifies,
+# through slhdsa128s.h.
+add_library(bitcoin_slhdsa128s STATIC EXCLUDE_FROM_ALL
+  slhdsa128s/sha2_256.c
+  slhdsa128s/sha2_512.c
+  slhdsa128s/slh_dsa.c
+  slhdsa128s/slh_sha2.c
+)
+target_include_directories(bitcoin_slhdsa128s
+  PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/slhdsa128s
+)
+set_target_properties(bitcoin_slhdsa128s PROPERTIES
+  C_VISIBILITY_PRESET hidden
+)
+# Byte order. The library tests `__BYTE_ORDER__ == __ORDER_BIG_ENDIAN__`, which a C compiler without
+# these macros (MSVC) reads as true. slhdsa128s_byte_order.h, included before each of its files,
+# supplies them where they are known and stops the build otherwise; it also checks them against the
+# byte order CMake found, and the C and C++ compilers must agree on that.
+if(CMAKE_C_BYTE_ORDER AND CMAKE_CXX_BYTE_ORDER AND NOT CMAKE_C_BYTE_ORDER STREQUAL CMAKE_CXX_BYTE_ORDER)
+  message(FATAL_ERROR "The C compiler targets ${CMAKE_C_BYTE_ORDER}, the C++ compiler ${CMAKE_CXX_BYTE_ORDER}.")
+endif()
+if(CMAKE_C_BYTE_ORDER STREQUAL "LITTLE_ENDIAN")
+  target_compile_definitions(bitcoin_slhdsa128s PRIVATE SLHDSA128S_CMAKE_LITTLE_ENDIAN)
+elseif(CMAKE_C_BYTE_ORDER STREQUAL "BIG_ENDIAN")
+  target_compile_definitions(bitcoin_slhdsa128s PRIVATE SLHDSA128S_CMAKE_BIG_ENDIAN)
+endif()
+set(slhdsa128s_byte_order_header ${CMAKE_CURRENT_SOURCE_DIR}/slhdsa128s_byte_order.h)
+if(MSVC OR CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "MSVC")
+  target_compile_options(bitcoin_slhdsa128s PRIVATE /FI${slhdsa128s_byte_order_header})
+else()
+  target_compile_options(bitcoin_slhdsa128s PRIVATE -include ${slhdsa128s_byte_order_header})
+endif()
+# Compile options of the C files, chosen here rather than taken from core_interface (which also
+# carries Threads' generator expressions, -fmacro-prefix-map and C++ workarounds):
+# - Core's hardening, probed again with the C compiler as Core probes it for C++: the pair
+#   "-U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3" as one unit, with the same check for optimization, then
+#   -Wstack-protector, -fstack-protector-all, -fcf-protection=full, -fstack-clash-protection (not on
+#   MinGW) and on aarch64 -mbranch-protection; with MSVC, /sdl, which Core gives its C++ files. A unit
+#   the C compiler rejects is skipped with a message, as try_append_cxx_flags does; a skipped Fortify
+#   pair leaves what CMAKE_C_FLAGS defines.
+# - the -fsanitize flags of sanitize_interface, required when SANITIZERS is set;
+# - a warning set of their own (-Wformat -Wformat-security as one unit, as Core probes them; /W3 with
+#   MSVC), not Core's, whose style warnings (-Wtrailing-whitespace, ...) the
+#   unmodified upstream files do not follow (libsecp256k1 likewise keeps its own);
+# - APPEND_CPPFLAGS and APPEND_CFLAGS at the end of the command line.
+# This follows cmake/secp256k1.cmake for libsecp256k1, plus the hardening. Each unit is a CMake list,
+# never joined and split again.
+include(CheckCSourceCompiles)
+# APPEND_CPPFLAGS and APPEND_CFLAGS end the compile command line of the C files, and of the probes below.
+string(APPEND CMAKE_C_COMPILE_OBJECT " ${APPEND_CPPFLAGS} ${APPEND_CFLAGS}")
+function(slhdsa128s_try_add_c_options target required source)
+  set(unit ${ARGN})
+  list(JOIN unit " " unit_as_string)
+  string(SHA256 appended_hash "${APPEND_CPPFLAGS} ${APPEND_CFLAGS}")
+  string(SUBSTRING "${appended_hash}" 0 8 appended_hash)
+  string(MAKE_C_IDENTIFIER "SLHDSA128S_C_ACCEPTS_${unit_as_string}_${appended_hash}" accepted)
+  set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
+  # The probe compiles with the same rule as the library, APPEND_CPPFLAGS and APPEND_CFLAGS last, as
+  # Core passes its C++ rule to its probes (CMAKE_TRY_COMPILE_PLATFORM_VARIABLES, top-level
+  # CMakeLists.txt).
+  list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CMAKE_C_COMPILE_OBJECT)
+  set(CMAKE_REQUIRED_FLAGS "${unit_as_string} ${working_compiler_werror_flag}")
+  check_c_source_compiles("${source}" ${accepted})
+  if(${accepted})
+    target_compile_options(${target} PRIVATE ${unit})
+  elseif(required)
+    message(FATAL_ERROR "The C compiler rejects ${unit_as_string}, which bitcoin_slhdsa128s requires.")
+  else()
+    message(STATUS "bitcoin_slhdsa128s: the C compiler rejects ${unit_as_string}; not used.")
+  endif()
+endfunction()
+set(slhdsa128s_main "int main(void) { return 0; }")
+if(MSVC)
+  slhdsa128s_try_add_c_options(bitcoin_slhdsa128s FALSE "${slhdsa128s_main}" /sdl)
+else()
+  # _FORTIFY_SOURCE requires some optimization; the probe fails without it, as Core's does.
+  slhdsa128s_try_add_c_options(bitcoin_slhdsa128s FALSE "int main(void) {
+    #if !defined __OPTIMIZE__ || __OPTIMIZE__ <= 0
+    #error
+    #endif
+    return 0;
+    }" -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3)
+  foreach(flag IN ITEMS -Wstack-protector -fstack-protector-all -fcf-protection=full)
+    slhdsa128s_try_add_c_options(bitcoin_slhdsa128s FALSE "${slhdsa128s_main}" ${flag})
+  endforeach()
+  if(NOT MINGW)
+    slhdsa128s_try_add_c_options(bitcoin_slhdsa128s FALSE "${slhdsa128s_main}" -fstack-clash-protection)
+  endif()
+  if(CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64")
+    if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+      slhdsa128s_try_add_c_options(bitcoin_slhdsa128s FALSE "${slhdsa128s_main}" -mbranch-protection=bti)
+    else()
+      slhdsa128s_try_add_c_options(bitcoin_slhdsa128s FALSE "${slhdsa128s_main}" -mbranch-protection=standard)
+    endif()
+  endif()
+endif()
+get_target_property(slhdsa128s_sanitize_options sanitize_interface INTERFACE_COMPILE_OPTIONS)
+if(slhdsa128s_sanitize_options)
+  slhdsa128s_try_add_c_options(bitcoin_slhdsa128s TRUE "${slhdsa128s_main}" ${slhdsa128s_sanitize_options})
+elseif(SANITIZERS)
+  message(FATAL_ERROR "SANITIZERS is set, but sanitize_interface has no compile options for bitcoin_slhdsa128s.")
+endif()
+if(MSVC)
+  # MSVC reads -Wall as /Wall, every warning; /W3, with the warnings Core turns off for its own
+  # code, is what Core's own code gets.
+  foreach(warning IN ITEMS /W3 /wd4018 /wd4146 /wd4244 /wd4267 /wd4715 /wd4805)
+    slhdsa128s_try_add_c_options(bitcoin_slhdsa128s FALSE "${slhdsa128s_main}" ${warning})
+  endforeach()
+else()
+  foreach(warning IN ITEMS -Wall -Wextra -Wvla -Wundef -Wimplicit-fallthrough -Wbidi-chars=any)
+    slhdsa128s_try_add_c_options(bitcoin_slhdsa128s FALSE "${slhdsa128s_main}" ${warning})
+  endforeach()
+  # -Wformat-security only works together with -Wformat, so the two are one unit, as Core has them.
+  slhdsa128s_try_add_c_options(bitcoin_slhdsa128s FALSE "${slhdsa128s_main}" -Wformat -Wformat-security)
+endif()
+
 add_library(bitcoin_crypto STATIC EXCLUDE_FROM_ALL
   aes.cpp
   chacha20.cpp
@@ -39,6 +159,7 @@ add_library(bitcoin_crypto STATIC EXCLUDE_FROM_ALL
   sha3.cpp
   sha512.cpp
   siphash.cpp
+  slhdsa128s.cpp
   ../support/cleanse.cpp
 )
 
@@ -46,6 +167,7 @@ target_link_libraries(bitcoin_crypto
   PRIVATE
     core_interface
     bitcoin_mldsa44
+    bitcoin_slhdsa128s
 )
 
 if(HAVE_SSE41)
diff --git a/src/crypto/slhdsa128s.cpp b/src/crypto/slhdsa128s.cpp
new file mode 100644
index 0000000..6c42690
--- /dev/null
+++ b/src/crypto/slhdsa128s.cpp
@@ -0,0 +1,42 @@
+// Copyright (c) 2026 duncan0k
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <crypto/slhdsa128s.h>
+
+#include <slh_dsa.h>
+
+#include <atomic>
+
+// The byte order of the vendored code is checked where that code is compiled, in its own C files
+// (slhdsa128s_byte_order.h); this file includes only slh_dsa.h, which declares the functions with
+// stddef.h and stdint.h types and does not depend on it.
+
+namespace {
+std::atomic<uint64_t> g_library_calls{0};
+} // namespace
+
+bool SLHDSA128SVerify(std::span<const unsigned char> pubkey,
+                      std::span<const unsigned char> msg,
+                      std::span<const unsigned char> ctx,
+                      std::span<const unsigned char> sig)
+{
+    // slh_verify computes the message digest from the first n bytes of the signature, R, before it
+    // looks at the signature's length, and it reads 2n bytes of the public key whatever its size.
+    // Nothing of the wrong length may reach it.
+    if (pubkey.size() != SLHDSA128S_PUBKEY_SIZE) return false;
+    if (msg.size() != SLHDSA128S_MESSAGE_SIZE) return false;
+    if (sig.size() != SLHDSA128S_SIGNATURE_SIZE) return false;
+    if (ctx.size() > SLHDSA128S_MAX_CONTEXT_SIZE) return false;
+    // An empty span may have no data pointer, which C library code need not accept even for zero bytes.
+    static constexpr unsigned char EMPTY[1]{0};
+    const unsigned char* const ctx_data{ctx.empty() ? EMPTY : ctx.data()};
+    g_library_calls.fetch_add(1, std::memory_order_relaxed);
+    // One on success, zero for an invalid signature.
+    return slh_verify(msg.data(), msg.size(), sig.data(), sig.size(), ctx_data, ctx.size(), pubkey.data(), &slh_dsa_sha2_128s) == 1;
+}
+
+uint64_t SLHDSA128SVerifyLibraryCalls()
+{
+    return g_library_calls.load(std::memory_order_relaxed);
+}
diff --git a/src/crypto/slhdsa128s.h b/src/crypto/slhdsa128s.h
new file mode 100644
index 0000000..7518e54
--- /dev/null
+++ b/src/crypto/slhdsa128s.h
@@ -0,0 +1,44 @@
+// Copyright (c) 2026 duncan0k
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_CRYPTO_SLHDSA128S_H
+#define BITCOIN_CRYPTO_SLHDSA128S_H
+
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+/** Size in bytes of an SLH-DSA-SHA2-128s (FIPS 205) public key: PK.seed || PK.root. */
+static constexpr size_t SLHDSA128S_PUBKEY_SIZE{32};
+/** Size in bytes of an SLH-DSA-SHA2-128s (FIPS 205) signature: (1 + k(1 + a) + h + d len) n. */
+static constexpr size_t SLHDSA128S_SIGNATURE_SIZE{7856};
+/** Longest context string FIPS 205 allows. */
+static constexpr size_t SLHDSA128S_MAX_CONTEXT_SIZE{255};
+/** Size in bytes of the message OP_CHECKSLHDSA128S signs: a BIP 341 signature message hash. */
+static constexpr size_t SLHDSA128S_MESSAGE_SIZE{32};
+
+/** Verify an SLH-DSA-SHA2-128s signature on the 32-byte msg under the context string ctx.
+ *
+ *  This is slh_verify of FIPS 205 (Algorithm 24): the external interface of
+ *  pure SLH-DSA, which verifies over 0x00 || len(ctx) || ctx || msg. It is not
+ *  HashSLH-DSA and not the internal interface.
+ *
+ *  Every length is checked before the library is called, and a wrong one makes
+ *  this return false: the public key must be SLHDSA128S_PUBKEY_SIZE bytes, the
+ *  message SLHDSA128S_MESSAGE_SIZE bytes (the signature message of
+ *  OP_CHECKSLHDSA128S), the signature SLHDSA128S_SIGNATURE_SIZE bytes and the
+ *  context string at most SLHDSA128S_MAX_CONTEXT_SIZE bytes. The vendored
+ *  slh_verify reads the first 16 bytes of the signature before it checks its
+ *  length, so no caller may hand it a shorter one.
+ */
+bool SLHDSA128SVerify(std::span<const unsigned char> pubkey,
+                      std::span<const unsigned char> msg,
+                      std::span<const unsigned char> ctx,
+                      std::span<const unsigned char> sig);
+
+/** How many times SLHDSA128SVerify has called the library's slh_verify in this
+ *  process. For tests and measurements, which count complete verifications. */
+uint64_t SLHDSA128SVerifyLibraryCalls();
+
+#endif // BITCOIN_CRYPTO_SLHDSA128S_H
