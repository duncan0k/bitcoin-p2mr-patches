+/*
+ * Copyright (c) The slhdsa-c project authors
+ * SPDX-License-Identifier: Apache-2.0 OR ISC OR MIT
+ */
+
+/* === Internal parameter definition structure. */
+
+#ifndef _SLH_VAR_H_
+#define _SLH_VAR_H_
+
+#include "sha2_api.h"
+#include "slh_param.h"
+
+/* some structural sizes */
+
+#ifdef SLH_EXPERIMENTAL
+
+/* a and hp adjusted to facilitate experimental parameter sets */
+#define SLH_MAX_N 32
+#define SLH_MAX_LEN (2 * SLH_MAX_N + 3)
+#define SLH_MAX_K 35
+#define SLH_MAX_HP 20
+#define SLH_MAX_A 24
+#define SLH_MAX_M 49
+
+#else /* !SLH_EXPERIMENTAL */
+
+/* maximum parameter sizes for FIPS 205 parameters */
+#define SLH_MAX_N 32
+#define SLH_MAX_LEN (2 * SLH_MAX_N + 3)
+#define SLH_MAX_K 35
+#define SLH_MAX_HP 9
+#define SLH_MAX_A 14
+#define SLH_MAX_M 49
+
+#endif
+
+/* context */
+struct slh_var_s
+{
+  const slh_param_t *prm;
+  uint8_t sk_seed[SLH_MAX_N];
+  uint8_t sk_prf[SLH_MAX_N];
+  uint8_t pk_seed[SLH_MAX_N];
+  uint8_t pk_root[SLH_MAX_N];
+
+  adrs_t *adrs;  /* regular pointer */
+  adrs_t t_adrs; /* local ADRS buffer */
+
+  /* precomputed values */
+  sha2_256_t sha2_256_pk_seed;
+  sha2_512_t sha2_512_pk_seed;
+};
+
+/* === Lower-level functions */
+
+/* Core signing function (of a randomized digest) with initialized context. */
+size_t slh_do_sign(slh_var_t *var, uint8_t *sig, const uint8_t *digest);
+
+/* _SLH_VAR_H_ */
+#endif
diff --git a/src/crypto/slhdsa128s_byte_order.h b/src/crypto/slhdsa128s_byte_order.h
new file mode 100644
index 0000000..afc34b8
--- /dev/null
+++ b/src/crypto/slhdsa128s_byte_order.h
@@ -0,0 +1,43 @@
+/* Copyright (c) 2026 duncan0k
+ * Distributed under the MIT software license, see the accompanying
+ * file COPYING or http://www.opensource.org/licenses/mit-license.php.
+ *
+ * Included before every file of the vendored SLH-DSA library (src/crypto/slhdsa128s/), by
+ * src/crypto/CMakeLists.txt for that target only. The library chooses its byte order with
+ * `#if __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__`, which a C compiler that defines neither macro
+ * (MSVC) reads as 0 == 0: big-endian, on a little-endian machine. Here the macros are checked or
+ * supplied, and anything unknown stops the build.
+ */
+
+#ifndef BITCOIN_CRYPTO_SLHDSA128S_BYTE_ORDER_H
+#define BITCOIN_CRYPTO_SLHDSA128S_BYTE_ORDER_H
+
+#if defined(__BYTE_ORDER__) || defined(__ORDER_LITTLE_ENDIAN__) || defined(__ORDER_BIG_ENDIAN__)
+/* The compiler gives the byte order (GCC, Clang): all three macros, and one of the two orders. */
+#if !defined(__BYTE_ORDER__) || !defined(__ORDER_LITTLE_ENDIAN__) || !defined(__ORDER_BIG_ENDIAN__)
+#error "slhdsa128s: only some of __BYTE_ORDER__, __ORDER_LITTLE_ENDIAN__, __ORDER_BIG_ENDIAN__ are defined"
+#endif
+#if __ORDER_LITTLE_ENDIAN__ == __ORDER_BIG_ENDIAN__
+#error "slhdsa128s: __ORDER_LITTLE_ENDIAN__ equals __ORDER_BIG_ENDIAN__"
+#endif
+#if __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__ && __BYTE_ORDER__ != __ORDER_BIG_ENDIAN__
+#error "slhdsa128s: __BYTE_ORDER__ is neither little- nor big-endian"
+#endif
+#elif defined(_MSC_VER) && (defined(_M_IX86) || defined(_M_X64) || defined(_M_ARM) || defined(_M_ARM64))
+/* MSVC defines none of them; every target it has these macros for is little-endian. */
+#define __ORDER_LITTLE_ENDIAN__ 1234
+#define __ORDER_BIG_ENDIAN__ 4321
+#define __BYTE_ORDER__ __ORDER_LITTLE_ENDIAN__
+#else
+#error "slhdsa128s: the byte order of this C compiler and target is unknown"
+#endif
+
+/* The byte order CMake found for the C and C++ compilers, which must agree with the above. */
+#if defined(SLHDSA128S_CMAKE_LITTLE_ENDIAN) && __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error "slhdsa128s: CMake found a little-endian target, the C compiler says otherwise"
+#endif
+#if defined(SLHDSA128S_CMAKE_BIG_ENDIAN) && __BYTE_ORDER__ != __ORDER_BIG_ENDIAN__
+#error "slhdsa128s: CMake found a big-endian target, the C compiler says otherwise"
+#endif
+
+#endif /* BITCOIN_CRYPTO_SLHDSA128S_BYTE_ORDER_H */
