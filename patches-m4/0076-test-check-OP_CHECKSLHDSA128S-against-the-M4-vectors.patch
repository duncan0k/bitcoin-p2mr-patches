+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <test/data/p2mr_ts_m4_construction.json.h>
+#include <test/data/p2mr_ts_m4_spend.json.h>
+
+#include <bech32.h>
+#include <crypto/mldsa44.h>
+#include <crypto/sha256.h>
+#include <crypto/slhdsa128s.h>
+#include <hash.h>
+#include <primitives/transaction.h>
+#include <script/interpreter.h>
+#include <script/script.h>
+#include <script/script_error.h>
+#include <serialize.h>
+#include <streams.h>
+#include <test/util/setup_common.h>
+#include <test/util/slhdsa128s.h>
+#include <uint256.h>
+#include <util/strencodings.h>
+
+#include <univalue.h>
+
+#include <boost/test/unit_test.hpp>
+
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// Vectors made by p2mr-ts, the wallet side of these rules, written independently with its own code
+// (src/test/data/p2mr_ts_m4_vectors.md has their origin and SHA-256): every value they give
+// that this code base can compute is recomputed here and compared byte for byte, and every spend is
+// run through VerifyScript.
+
+namespace {
+using valtype = std::vector<unsigned char>;
+
+//! The flags of a block with P2MR, OP_CHECKMLDSA44, leaf version 0xe0 and OP_CHECKSLHDSA128S active.
+constexpr script_verify_flags ACTIVE{SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_TAPROOT | SCRIPT_VERIFY_P2MR |
+                                     SCRIPT_VERIFY_P2MR_MLDSA44 | SCRIPT_VERIFY_P2MR_TRIPWIRE | SCRIPT_VERIFY_P2MR_SLHDSA128S};
+//! Leaf version 0xe2, which p2mr-ts also covers and this series does not implement: an unknown leaf
+//! version here.
+constexpr uint8_t LEAF_VERSION_E2{0xe2};
+
+UniValue ReadObject(std::string_view text)
+{
+    UniValue value;
+    BOOST_REQUIRE(value.read(text));
+    BOOST_REQUIRE(value.isObject());
+    return value;
+}
+
+valtype Hex(const UniValue& field)
+{
+    const auto bytes{TryParseHex<unsigned char>(field.get_str())};
+    BOOST_REQUIRE_MESSAGE(bytes.has_value(), "not hex: " << field.get_str().substr(0, 40));
+    return *bytes;
+}
+
+std::string HexOf(std::span<const unsigned char> bytes) { return HexStr(bytes); }
+
+/** The bech32m address of a witness v2 program under `hrp`. */
+std::string P2MRAddress(const std::string& hrp, std::span<const unsigned char> program)
+{
+    std::vector<unsigned char> data{2};
+    ConvertBits<8, 5, true>([&](unsigned char c) { data.push_back(c); }, program.begin(), program.end());
+    return bech32::Encode(bech32::Encoding::BECH32M, hrp, data);
+}
+
+/** The pushes of a script, in order; a script that is not only pushes and opcodes fails the test. */
+std::vector<valtype> Pushes(const CScript& script)
+{
+    std::vector<valtype> pushes;
+    opcodetype opcode;
+    valtype data;
+    for (auto pc{script.begin()}; pc < script.end();) {
+        BOOST_REQUIRE(script.GetOp(pc, opcode, data));
+        if (opcode <= OP_PUSHDATA4) pushes.push_back(data);
+    }
+    return pushes;
+}
+} // namespace
+
+BOOST_FIXTURE_TEST_SUITE(p2mr_ts_m4_tests, BasicTestingSetup)
+
+BOOST_AUTO_TEST_CASE(spends)
+{
+    const UniValue file{ReadObject(json_tests::p2mr_ts_m4_spend)};
+    CMutableTransaction tx;
+    SpanReader{Hex(file["tx"])} >> TX_NO_WITNESS(tx);
+    std::vector<CTxOut> spent_outputs;
+    for (const UniValue& output : file["spentOutputs"].getValues()) {
+        const auto script_pubkey{Hex(output["scriptPubKey"])};
+        spent_outputs.emplace_back(output["amount"].getInt<int64_t>(), CScript(script_pubkey.begin(), script_pubkey.end()));
+    }
+    BOOST_REQUIRE_EQUAL(spent_outputs.size(), tx.vin.size());
+    PrecomputedTransactionData txdata;
+    txdata.Init(tx, std::vector<CTxOut>{spent_outputs}, /*force=*/true);
+
+    std::map<std::string, int> counts;
+    for (const UniValue& c : file["cases"].getValues()) {
+        const std::string id{c["id"].get_str()};
+        BOOST_TEST_CONTEXT("case " << id) {
+            const uint32_t in{c["inputIndex"].getInt<uint32_t>()};
+            BOOST_REQUIRE(in < tx.vin.size());
+            const valtype leaf_bytes{Hex(c["leafScript"])};
+            const CScript leaf{leaf_bytes.begin(), leaf_bytes.end()};
+            const uint8_t leaf_version{c["leafVersion"].getInt<uint8_t>()};
+            const valtype control{Hex(c["controlBlock"])};
+            const uint8_t hash_type{c["hashType"].getInt<uint8_t>()};
+            const std::optional<valtype> annex{c["annex"].isNull() ? std::nullopt : std::optional<valtype>{Hex(c["annex"])}};
+
+            // The construction: the tapleaf hash, the control byte, and the output it spends.
+            const uint256 leaf_hash{ComputeTapleafHash(leaf_version, leaf)};
+            BOOST_CHECK_EQUAL(HexStr(leaf_hash), c["leafHash"].get_str());
+            BOOST_REQUIRE(!control.empty());
+            BOOST_CHECK_EQUAL(int{control[0]}, leaf_version | 1);
+            const uint256 root{ComputeP2MRMerkleRoot(control, leaf_hash)};
+            BOOST_CHECK(spent_outputs[in].scriptPubKey == (CScript{} << OP_2 << ToByteVector(root)));
+
+            // The signature messages, for key_version 0, 1 and 2, and the one the signature is over.
+            ScriptExecutionData execdata;
+            execdata.m_annex_init = true;
+            execdata.m_annex_present = annex.has_value();
+            if (annex) execdata.m_annex_hash = (HashWriter{} << *annex).GetSHA256();
+            execdata.m_tapleaf_hash = leaf_hash;
+            execdata.m_tapleaf_hash_init = true;
+            execdata.m_codeseparator_pos = c["codesepPos"].getInt<uint32_t>();
+            execdata.m_codeseparator_pos_init = true;
+            std::map<int, std::string> expected_messages{{c["keyVersion"].getInt<int>(), c["sigHash"].get_str()}};
+            for (const UniValue& other : c["otherKeyVersions"].getValues()) {
+                expected_messages.emplace(other["keyVersion"].getInt<int>(), other["sigHash"].get_str());
+            }
+            BOOST_CHECK_EQUAL(expected_messages.size(), 3U);
+            for (const auto& [key_version, expected] : expected_messages) {
+                uint256 msg;
+                BOOST_REQUIRE(SignatureHashSchnorr(msg, execdata, tx, in, hash_type, SigVersion::TAPSCRIPT, txdata, MissingDataBehavior::FAIL,
+                                                   static_cast<uint8_t>(key_version)));
+                BOOST_CHECK_MESSAGE(HexStr(msg) == expected, "key_version " << key_version << ": Core " << HexStr(msg) << ", p2mr-ts " << expected);
+                ++counts["messages"];
+            }
+            // The file's preimage hashes to its own message.
+            HashWriter preimage{HASHER_TAPSIGHASH};
+            preimage.write(MakeByteSpan(Hex(c["sigMsg"])));
+            BOOST_CHECK_EQUAL(HexStr(preimage.GetSHA256()), c["sigHash"].get_str());
+
+            // The witness: its element sizes, and the signature in its chunks.
+            std::vector<valtype> witness_stack;
+            for (const UniValue& element : c["witness"].getValues()) witness_stack.push_back(Hex(element));
+            const UniValue& sizes{c["witnessElementSizes"]};
+            BOOST_REQUIRE_EQUAL(sizes.size(), witness_stack.size());
+            for (size_t i = 0; i < witness_stack.size(); ++i) BOOST_CHECK_EQUAL(witness_stack[i].size(), sizes[i].getInt<size_t>());
+            const valtype sig{Hex(c["signature"])};
+            const bool slh{c["signer"].isNull() || c["signer"]["scheme"].get_str() == "SLH-DSA-SHA2-128s"};
+            const size_t chunk_count{slh ? SLHDSA128S_SIG_CHUNK_COUNT : MLDSA44_SIG_CHUNK_SIZES.size()};
+            BOOST_REQUIRE(witness_stack.size() >= chunk_count + 2);
+            valtype joined;
+            for (size_t i = 0; i < chunk_count; ++i) joined.insert(joined.end(), witness_stack[i].begin(), witness_stack[i].end());
+            BOOST_CHECK(joined == sig);
+            BOOST_CHECK(witness_stack[chunk_count] == leaf_bytes);
+            BOOST_CHECK(witness_stack[chunk_count + 1] == control);
+            BOOST_CHECK(annex ? (witness_stack.size() == chunk_count + 3 && witness_stack.back() == *annex) : witness_stack.size() == chunk_count + 2);
+
+            // The signature itself, against the message, with the verifier of this code base.
+            uint256 msg;
+            BOOST_REQUIRE(SignatureHashSchnorr(msg, execdata, tx, in, hash_type, SigVersion::TAPSCRIPT, txdata, MissingDataBehavior::FAIL,
+                                               c["keyVersion"].getInt<uint8_t>()));
+            const std::vector<valtype> pushes{Pushes(leaf)};
+            if (!sig.empty()) {
+                const size_t bare{slh ? SLHDSA128S_SIGNATURE_SIZE : MLDSA44_SIGNATURE_SIZE};
+                BOOST_REQUIRE(sig.size() == bare || sig.size() == bare + 1);
+                BOOST_CHECK_EQUAL(sig.size() == bare + 1 ? int{sig.back()} : 0, int{hash_type});
+                const std::span<const unsigned char> bare_sig{std::span{sig}.first(bare)};
+                if (slh) {
+                    BOOST_REQUIRE(!pushes.empty());
+                    BOOST_CHECK(SLHDSA128SVerify(pushes.back(), MakeUCharSpan(msg), MakeUCharSpan(SLHDSA128S_CONTEXT), bare_sig));
+                } else {
+                    valtype pubkey;
+                    for (const valtype& push : pushes) pubkey.insert(pubkey.end(), push.begin(), push.end());
+                    BOOST_REQUIRE_EQUAL(pubkey.size(), MLDSA44_PUBKEY_SIZE);
+                    BOOST_CHECK(MLDSA44Verify(std::span<const unsigned char, MLDSA44_PUBKEY_SIZE>{pubkey.data(), MLDSA44_PUBKEY_SIZE}, MakeUCharSpan(msg),
+                                              MakeUCharSpan(MLDSA44_CONTEXT), bare_sig.first<MLDSA44_SIGNATURE_SIZE>()));
+                }
+                ++counts["signatures"];
+            }
+
+            // The whole witness through VerifyScript with the flags of these rules.
+            CScriptWitness witness;
+            witness.stack = witness_stack;
+            CMutableTransaction spending{tx};
+            spending.vin[in].scriptWitness = witness;
+            const MutableTransactionSignatureChecker checker{&spending, in, spent_outputs[in].nValue, txdata, MissingDataBehavior::ASSERT_FAIL};
+            ScriptError err;
+            VerifyScript(CScript{}, spent_outputs[in].scriptPubKey, &witness, ACTIVE, checker, &err);
+            if (leaf_version == LEAF_VERSION_E2) {
+                // Leaf version 0xe2 is not part of this series: an unknown leaf version, which succeeds without
+                // executing the leaf, and which policy refuses. Its signatures were checked above.
+                BOOST_CHECK_EQUAL(ScriptErrorString(err), ScriptErrorString(SCRIPT_ERR_OK));
+                VerifyScript(CScript{}, spent_outputs[in].scriptPubKey, &witness, ACTIVE | SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_TAPROOT_VERSION, checker, &err);
+                BOOST_CHECK_EQUAL(ScriptErrorString(err), ScriptErrorString(SCRIPT_ERR_DISCOURAGE_UPGRADABLE_TAPROOT_VERSION));
+                ++counts["unexecuted 0xe2"];
+            } else if (sig.empty()) {
+                // The unsigned form: sixteen empty chunks push false.
+                BOOST_CHECK_EQUAL(ScriptErrorString(err), ScriptErrorString(SCRIPT_ERR_EVAL_FALSE));
+                ++counts["rejected"];
+            } else {
+                BOOST_CHECK_EQUAL(ScriptErrorString(err), ScriptErrorString(SCRIPT_ERR_OK));
+                ++counts["accepted"];
+                // One flipped bit in the signature fails the script.
+                CScriptWitness bad{witness};
+                bad.stack[3][7] ^= 1;
+                spending.vin[in].scriptWitness = bad;
+                VerifyScript(CScript{}, spent_outputs[in].scriptPubKey, &bad, ACTIVE, checker, &err);
+                BOOST_CHECK_EQUAL(ScriptErrorString(err), ScriptErrorString(SCRIPT_ERR_SLHDSA128S_SIG));
+            }
+        }
+    }
+    BOOST_CHECK_EQUAL(counts["messages"], 33);
+    BOOST_CHECK_EQUAL(counts["signatures"], 10);
+    BOOST_CHECK_EQUAL(counts["accepted"], 6);
+    BOOST_CHECK_EQUAL(counts["rejected"], 1);
+    BOOST_CHECK_EQUAL(counts["unexecuted 0xe2"], 4);
+}
+
+BOOST_AUTO_TEST_CASE(construction)
+{
+    const UniValue file{ReadObject(json_tests::p2mr_ts_m4_construction)};
+
+    // Key generation: the SLH-DSA public key from its 48-byte seed (SK.seed, SK.prf, PK.seed).
+    std::map<std::string, valtype> slh_keys;
+    for (const UniValue& key : file["keys"]["slhdsa128s"].getValues()) {
+        const SLHDSA128SKey derived{SLHDSA128SKey::FromSeed(Hex(key["seed"]))};
+        BOOST_CHECK_EQUAL(HexOf(derived.pubkey), key["publicKey"].get_str());
+        slh_keys[key["name"].get_str()] = Hex(key["publicKey"]);
+    }
+    BOOST_CHECK_EQUAL(slh_keys.size(), 3U);
+    std::map<std::string, std::string> mldsa_key_hashes;
+    for (const UniValue& key : file["keys"]["mldsa44"].getValues()) mldsa_key_hashes[key["name"].get_str()] = key["publicKeySha256"].get_str();
+
+    // SLH1 of each key in each leaf version: the script, the tapleaf hash, the control byte.
+    int leaves{0};
+    for (const UniValue& leaf : file["leaves"].getValues()) {
+        const valtype& pubkey{slh_keys.at(leaf["key"].get_str())};
+        const CScript slh1{CScript{} << pubkey << OP_CHECKSLHDSA128S};
+        const uint8_t leaf_version{leaf["leafVersion"].getInt<uint8_t>()};
+        BOOST_CHECK_EQUAL(HexStr(slh1), leaf["script"].get_str());
+        BOOST_CHECK_EQUAL(HexStr(ComputeTapleafHash(leaf_version, slh1)), leaf["leafHash"].get_str());
+        BOOST_CHECK_EQUAL(leaf["controlByte"].get_str(), strprintf("%02x", leaf_version | 1));
+        ++leaves;
+    }
+    BOOST_CHECK_EQUAL(leaves, 9);
+
+    // Trees of two leaves at depth one: tapleaf hashes, Merkle root, scriptPubKey, both control
+    // blocks, and the addresses.
+    int trees{0};
+    for (const UniValue& vector : file["test_vectors"].getValues()) {
+        BOOST_TEST_CONTEXT("tree " << vector["id"].get_str()) {
+            const UniValue& tree{vector["given"]["scriptTree"]};
+            BOOST_REQUIRE_EQUAL(tree.size(), 2U);
+            std::vector<uint256> hashes;
+            std::vector<CScript> scripts;
+            for (size_t i = 0; i < 2; ++i) {
+                const valtype script{Hex(tree[i]["script"])};
+                scripts.emplace_back(script.begin(), script.end());
+                hashes.push_back(ComputeTapleafHash(tree[i]["leafVersion"].getInt<uint8_t>(), script));
+                BOOST_CHECK_EQUAL(HexStr(hashes[i]), vector["intermediary"]["leafHashes"][i].get_str());
+            }
+            const uint256 root{ComputeTapbranchHash(hashes[0], hashes[1])};
+            BOOST_CHECK_EQUAL(HexStr(root), vector["intermediary"]["merkleRoot"].get_str());
+            const CScript script_pubkey{CScript{} << OP_2 << ToByteVector(root)};
+            BOOST_CHECK_EQUAL(HexStr(script_pubkey), vector["expected"]["scriptPubKey"].get_str());
+            for (size_t i = 0; i < 2; ++i) {
+                valtype control{static_cast<unsigned char>(tree[i]["leafVersion"].getInt<uint8_t>() | 1)};
+                control.insert(control.end(), hashes[1 - i].begin(), hashes[1 - i].end());
+                BOOST_CHECK_EQUAL(HexStr(control), vector["expected"]["scriptPathControlBlocks"][i].get_str());
+                // The control block leads from the leaf to the root, as the interpreter computes it.
+                BOOST_CHECK(ComputeP2MRMerkleRoot(control, hashes[i]) == root);
+            }
+            BOOST_CHECK_EQUAL(P2MRAddress("tb", root), vector["expected"]["signetAddress"].get_str());
+            BOOST_CHECK_EQUAL(P2MRAddress("bcrt", root), vector["expected"]["regtestAddress"].get_str());
+
+            // pq2: leaf A is S1 of the ML-DSA-44 key, leaf B SLH1 of the SLH-DSA key.
+            const UniValue& given{vector["given"]};
+            if (!given["mldsa44PublicKey"].isNull()) {
+                const valtype mldsa_pubkey{Hex(given["mldsa44PublicKey"])};
+                BOOST_REQUIRE_EQUAL(mldsa_pubkey.size(), MLDSA44_PUBKEY_SIZE);
+                CScript s1;
+                size_t pos{0};
+                for (const size_t size : MLDSA44_PUBKEY_CHUNK_SIZES) {
+                    s1 << valtype{mldsa_pubkey.begin() + pos, mldsa_pubkey.begin() + pos + size};
+                    pos += size;
+                }
+                s1 << OP_CHECKMLDSA44;
+                BOOST_CHECK(scripts[0] == s1);
+                uint256 key_hash;
+                CSHA256().Write(mldsa_pubkey.data(), mldsa_pubkey.size()).Finalize(key_hash.begin());
+                const std::string name{vector["id"].get_str().substr(4)};
+                BOOST_CHECK_EQUAL(HexStr(key_hash), mldsa_key_hashes.at(name));
+                BOOST_CHECK(scripts[1] == (CScript{} << Hex(given["slhdsa128sPublicKey"]) << OP_CHECKSLHDSA128S));
+            }
+            ++trees;
+        }
+    }
+    BOOST_CHECK_EQUAL(trees, 6);
+}
+
+BOOST_AUTO_TEST_SUITE_END()
