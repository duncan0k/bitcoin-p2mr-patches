+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Helpers for OP_CHECKSLHDSA128S, the experimental SLH-DSA-SHA2-128s check in P2MR leaves.
+
+See doc/p2mr-slhdsa128s.md. No stack element may exceed 520 bytes, so the 7856-byte signature
+(7857 with an explicit hash type) is given in sixteen chunks; the 32-byte public key fits in one
+push of the leaf:
+
+    leaf SLH1:  <pk:32> OP_CHECKSLHDSA128S
+    witness:    <sig[0]:520> ... <sig[14]:520> <sig[15]:56 or 57> <leaf> <control block>
+
+The signed message is the BIP-342 signature message with key_version 2, and the FIPS 205
+context string is "P2MR/SLHDSA128S/EXP0". The default output puts the leaf next to a leaf that
+can only fail, so that both sit at depth one: a single leaf tree has depth zero, and P2MR does
+not execute a leaf at depth zero.
+
+Signing takes a few seconds in Python (test_framework/crypto/slhdsa128s.py), so tests should
+sign as few times as they can.
+"""
+
+from .crypto import slhdsa128s
+from .p2mr import p2mr_construct
+from .p2mr_mldsa44 import LEAF_FAIL, NO_CODESEPARATOR, split_chunks
+from .script import (
+    CScript,
+    CScriptOp,
+    LEAF_VERSION_TAPSCRIPT,
+    SIGHASH_DEFAULT,
+    TaprootSignatureHash,
+)
+
+# Byte 0xf1: OP_SUCCESS241 everywhere but in an executed P2MR leaf once active.
+OP_CHECKSLHDSA128S = CScriptOp(0xf1)
+
+SLHDSA128S_PUBKEY_SIZE = slhdsa128s.PUBKEY_SIZE
+SLHDSA128S_SIGNATURE_SIZE = slhdsa128s.SIGNATURE_SIZE
+SLHDSA128S_SIG_CHUNK_SIZES = (520,) * 15 + (56,)
+SLHDSA128S_KEY_VERSION = 2
+SLHDSA128S_CONTEXT = b"P2MR/SLHDSA128S/EXP0"
+# Validation weight one OP_CHECKSLHDSA128S with a signature uses up (provisional, see
+# VALIDATION_WEIGHT_PER_SLHDSA128S_CHECK in src/script/script.h).
+VALIDATION_WEIGHT_PER_SLHDSA128S_CHECK = 2000
+
+assert sum(SLHDSA128S_SIG_CHUNK_SIZES) == SLHDSA128S_SIGNATURE_SIZE
+
+__all__ = [
+    "LEAF_FAIL",
+    "NO_CODESEPARATOR",
+    "OP_CHECKSLHDSA128S",
+    "SLHDSA128S_CONTEXT",
+    "SLHDSA128S_KEY_VERSION",
+    "SLHDSA128S_PUBKEY_SIZE",
+    "SLHDSA128S_SIGNATURE_SIZE",
+    "SLHDSA128S_SIG_CHUNK_SIZES",
+    "VALIDATION_WEIGHT_PER_SLHDSA128S_CHECK",
+    "slhdsa128s_keygen",
+    "slhdsa128s_leaf",
+    "slhdsa128s_sig_chunks",
+    "slhdsa128s_sighash",
+    "slhdsa128s_sign",
+    "slhdsa128s_sign_input",
+    "slhdsa128s_tree",
+    "slhdsa128s_verify",
+]
+
+
+def slhdsa128s_keygen(seed):
+    """An SLH-DSA-SHA2-128s key pair (public key, secret key) from a 48-byte seed: SK.seed, SK.prf
+    and PK.seed."""
+    assert len(seed) == 48
+    return slhdsa128s.keygen(bytes(seed))
+
+
+def slhdsa128s_sign(seckey, msg, *, context=SLHDSA128S_CONTEXT, addrnd=None):
+    """Sign with pure SLH-DSA-SHA2-128s. addrnd None is the deterministic variant of FIPS 205."""
+    sig = slhdsa128s.sign(bytes(msg), bytes(context), bytes(seckey), addrnd)
+    assert len(sig) == SLHDSA128S_SIGNATURE_SIZE
+    return sig
+
+
+def slhdsa128s_verify(pubkey, msg, sig, *, context=SLHDSA128S_CONTEXT):
+    """Verify with pure SLH-DSA-SHA2-128s. A key or signature of the wrong size is invalid."""
+    if len(pubkey) != SLHDSA128S_PUBKEY_SIZE or len(sig) != SLHDSA128S_SIGNATURE_SIZE:
+        return False
+    return slhdsa128s.verify(bytes(msg), bytes(sig), bytes(context), bytes(pubkey))
+
+
+def slhdsa128s_sig_chunks(sig):
+    """The sixteen witness elements that carry a signature (with or without hash type)."""
+    assert len(sig) in (SLHDSA128S_SIGNATURE_SIZE, SLHDSA128S_SIGNATURE_SIZE + 1)
+    return split_chunks(bytes(sig), SLHDSA128S_SIG_CHUNK_SIZES)
+
+
+def slhdsa128s_leaf(pubkey):
+    """Leaf SLH1 for a public key."""
+    assert len(pubkey) == SLHDSA128S_PUBKEY_SIZE
+    return CScript([bytes(pubkey), OP_CHECKSLHDSA128S])
+
+
+def slhdsa128s_tree(leaf, *, leaf_ver=LEAF_VERSION_TAPSCRIPT):
+    """The default output: the SLH-DSA leaf and LEAF_FAIL, both at depth one, both of leaf version
+    leaf_ver."""
+    return p2mr_construct([("slh", leaf, leaf_ver), ("fail", LEAF_FAIL, leaf_ver)])
+
+
+def slhdsa128s_sighash(tx, spent_utxos, input_index, leaf_script, *, hash_type=SIGHASH_DEFAULT,
+                       annex=None, codeseparator_pos=NO_CODESEPARATOR, key_ver=SLHDSA128S_KEY_VERSION,
+                       leaf_ver=LEAF_VERSION_TAPSCRIPT):
+    """The 32-byte message an OP_CHECKSLHDSA128S signature signs: TapSighash with key_version 2."""
+    return TaprootSignatureHash(tx, spent_utxos, hash_type, input_index, scriptpath=True,
+                                leaf_script=leaf_script, leaf_ver=leaf_ver, annex=annex,
+                                codeseparator_pos=codeseparator_pos, key_ver=key_ver)
+
+
+def slhdsa128s_sign_input(seckey, tx, spent_utxos, input_index, leaf_script, *, hash_type=SIGHASH_DEFAULT,
+                          annex=None, codeseparator_pos=NO_CODESEPARATOR, key_ver=SLHDSA128S_KEY_VERSION,
+                          context=SLHDSA128S_CONTEXT, leaf_ver=LEAF_VERSION_TAPSCRIPT):
+    """Sign an input that spends an OP_CHECKSLHDSA128S leaf; a non-default hash type is appended."""
+    msg = slhdsa128s_sighash(tx, spent_utxos, input_index, leaf_script, hash_type=hash_type, annex=annex,
+                             codeseparator_pos=codeseparator_pos, key_ver=key_ver, leaf_ver=leaf_ver)
+    sig = slhdsa128s_sign(seckey, msg, context=context)
+    if hash_type != SIGHASH_DEFAULT:
+        sig += bytes([hash_type])
+    return sig
