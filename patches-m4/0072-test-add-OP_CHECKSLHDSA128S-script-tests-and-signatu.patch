+// A valid signature with one bit flipped, in each part of it, and a key with PK.seed or PK.root
+// changed, fail the script (4S-11): not push false.
+BOOST_AUTO_TEST_CASE(modified_signature_and_key)
+{
+    const P2MRSpend spend{SLH1(Key().pubkey)};
+    const valtype sig{SignMessage(*spend.Message())};
+    CHECK_ERR(spend.Verify(Chunks(sig), ACTIVE), SCRIPT_ERR_OK);
+    // R; the FORS signature (secret value, authentication path); each hypertree layer (the WOTS+
+    // chain values, then the XMSS authentication path); the last byte, in the 56-byte chunk.
+    std::vector<size_t> positions{0, 15, 16, 31, 2927};
+    for (size_t layer = 0; layer < 7; ++layer) {
+        positions.push_back(2928 + layer * 704 + 17);
+        positions.push_back(2928 + layer * 704 + 35 * 16 + 3);
+    }
+    positions.push_back(SLHDSA128S_SIGNATURE_SIZE - 1);
+    for (const size_t pos : positions) {
+        valtype bad{sig};
+        bad[pos] ^= 0x01;
+        BOOST_TEST_CONTEXT("bit flipped at byte " << pos) CHECK_ERR(spend.Verify(Chunks(bad), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+    }
+    for (const size_t pos : {size_t{0}, size_t{16}}) {
+        valtype pubkey{Key().pubkey.begin(), Key().pubkey.end()};
+        pubkey[pos] ^= 0x01;
+        const P2MRSpend other_key{SLH1(pubkey)};
+        BOOST_TEST_CONTEXT((pos == 0 ? "PK.seed" : "PK.root") << " changed") {
+            CHECK_ERR(other_key.Verify(Chunks(SignMessage(*other_key.Message())), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+        }
+    }
+}
+
+// The sizes of the sixteen chunks and of the key (4S-4, 4S-6, 4S-7, 4S-8), the hash type (4S-9) and
+// the order the checks run in.
+BOOST_AUTO_TEST_CASE(encoding)
+{
+    const P2MRSpend spend{SLH1(Key().pubkey)};
+    const valtype sig{SignMessage(*spend.Message())};
+    const std::vector<valtype> good{Chunks(sig)};
+
+    // Sixteen empty chunks: no signature, which pushes false (4S-7) and charges nothing.
+    const std::vector<valtype> empty(SLHDSA128S_SIG_CHUNK_COUNT);
+    CHECK_ERR(spend.Verify(empty, ACTIVE), SCRIPT_ERR_EVAL_FALSE);
+    const P2MRSpend negated{CScript{} << ToByteVector(Key().pubkey) << OP_CHECKSLHDSA128S << OP_NOT};
+    CHECK_ERR(negated.Verify(empty, ACTIVE), SCRIPT_ERR_OK);
+    // A non-empty invalid signature is not false: OP_NOT cannot turn it around.
+    valtype bad{sig};
+    bad[100] ^= 1;
+    CHECK_ERR(negated.Verify(Chunks(bad), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+
+    // Fewer than seventeen elements with the key (4S-4).
+    CHECK_ERR(spend.Verify({good.begin() + 1, good.end()}, ACTIVE), SCRIPT_ERR_INVALID_STACK_OPERATION);
+    CHECK_ERR(spend.Verify({}, ACTIVE), SCRIPT_ERR_INVALID_STACK_OPERATION);
+    // One more is left on the stack.
+    std::vector<valtype> extra{good};
+    extra.insert(extra.begin(), valtype{0x01});
+    CHECK_ERR(spend.Verify(extra, ACTIVE), SCRIPT_ERR_CLEANSTACK);
+
+    // Chunk sizes (4S-8): 519 anywhere, a last chunk of 55 or 58, some chunks empty.
+    for (size_t i = 0; i < SLHDSA128S_SIG_CHUNK_COUNT; i += 5) {
+        std::vector<valtype> chunks{good};
+        chunks[i].pop_back();
+        BOOST_TEST_CONTEXT("chunk " << i << " one byte short") CHECK_ERR(spend.Verify(chunks, ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG_SIZE);
+    }
+    {
+        std::vector<valtype> chunks{good};
+        chunks.back().pop_back();
+        CHECK_ERR(spend.Verify(chunks, ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG_SIZE);
+        chunks = good;
+        chunks.back().insert(chunks.back().end(), {0x01, 0x01});
+        CHECK_ERR(spend.Verify(chunks, ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG_SIZE);
+        // A byte of the first chunk moved to the last: the same bytes, another split.
+        chunks = good;
+        chunks[15].insert(chunks[15].begin(), chunks[0].back());
+        chunks[0].pop_back();
+        CHECK_ERR(spend.Verify(chunks, ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG_SIZE);
+    }
+    for (const size_t i : {size_t{0}, size_t{7}, size_t{15}}) {
+        std::vector<valtype> chunks{good};
+        chunks[i].clear();
+        BOOST_TEST_CONTEXT("chunk " << i << " empty") CHECK_ERR(spend.Verify(chunks, ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG_SIZE);
+    }
+    {
+        // Only the last chunk: a signature, so it is charged first, and the small witness has too
+        // little budget for it.
+        std::vector<valtype> chunks(SLHDSA128S_SIG_CHUNK_COUNT);
+        chunks.back() = good.back();
+        CHECK_ERR(spend.Verify(chunks, ACTIVE), SCRIPT_ERR_TAPSCRIPT_VALIDATION_WEIGHT);
+    }
+    // A chunk of 521 bytes never reaches the opcode: the initial stack may not hold it.
+    {
+        std::vector<valtype> chunks{good};
+        chunks[3].push_back(0x00);
+        CHECK_ERR(spend.Verify(chunks, ACTIVE), SCRIPT_ERR_PUSH_SIZE);
+    }
+
+    // Public key sizes (4S-6): with a signature, and with an empty one too.
+    for (const size_t size : {size_t{0}, size_t{31}, size_t{33}, size_t{64}}) {
+        const P2MRSpend wrong_key{CScript{} << valtype(size, 0x02) << OP_CHECKSLHDSA128S};
+        BOOST_TEST_CONTEXT("public key of " << size << " bytes") {
+            CHECK_ERR(wrong_key.Verify(good, ACTIVE), SCRIPT_ERR_SLHDSA128S_PUBKEY_SIZE);
+            CHECK_ERR(wrong_key.Verify(empty, ACTIVE), SCRIPT_ERR_SLHDSA128S_PUBKEY_SIZE);
+            // The key size comes before the chunk sizes.
+            std::vector<valtype> chunks{good};
+            chunks[0].pop_back();
+            CHECK_ERR(wrong_key.Verify(chunks, ACTIVE), SCRIPT_ERR_SLHDSA128S_PUBKEY_SIZE);
+        }
+    }
+
+    // Hash types (4S-9): an explicit 0x00, and every byte BIP 341 does not allow, fail before the
+    // signature is looked at. So does SIGHASH_SINGLE without an output of the same index.
+    for (const uint8_t hash_type : {0x00, 0x04, 0x05, 0x40, 0x80, 0x84, 0xc1, 0xff}) {
+        BOOST_TEST_CONTEXT("hash type " << int{hash_type}) CHECK_ERR(spend.Verify(Chunks(WithHashType(sig, hash_type)), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG_HASHTYPE);
+    }
+    const P2MRSpend second_input{SLH1(Key().pubkey), TAPROOT_LEAF_TAPSCRIPT, std::nullopt, 2, 1};
+    BOOST_CHECK(!second_input.Message(SIGHASH_SINGLE));
+    for (const uint8_t hash_type : {uint8_t{SIGHASH_SINGLE}, uint8_t{SIGHASH_SINGLE | SIGHASH_ANYONECANPAY}}) {
+        CHECK_ERR(second_input.Verify(Chunks(WithHashType(sig, hash_type)), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG_HASHTYPE);
+    }
+    // The chunk sizes come before the hash type.
+    {
+        std::vector<valtype> chunks{Chunks(WithHashType(sig, 0x00))};
+        chunks[0].pop_back();
+        CHECK_ERR(spend.Verify(chunks, ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG_SIZE);
+    }
+}
+
+// A check with any non-empty chunk uses VALIDATION_WEIGHT_PER_SLHDSA128S_CHECK of the input's budget
+// first of all (4S-5); an empty signature uses none.
+BOOST_AUTO_TEST_CASE(validation_weight)
+{
+    // Everything below follows from VALIDATION_WEIGHT_PER_SLHDSA128S_CHECK, which is provisional: a
+    // later value only has to keep these two design limits. A single SLH1 spend has a budget of
+    // 7972 + 50 = 8022, so the weight must stay below it, and an almost empty witness must not pay
+    // for a check.
+    constexpr int64_t weight{VALIDATION_WEIGHT_PER_SLHDSA128S_CHECK};
+    static_assert(weight < 8022);
+    static_assert(weight > 200);
+    const P2MRSpend spend{SLH1(Key().pubkey)};
+    const valtype sig{SignMessage(*spend.Message())};
+    BOOST_CHECK_EQUAL(GetSerializeSize(spend.Witness(Chunks(sig)).stack), 7972U);
+
+    // One byte of chunk with nothing else: the budget is far below the weight, and the weight is
+    // charged before the key size, the chunk sizes and everything else are looked at.
+    std::vector<valtype> one_byte(SLHDSA128S_SIG_CHUNK_COUNT);
+    one_byte[0] = {0x01};
+    CHECK_ERR(spend.Verify(one_byte, ACTIVE), SCRIPT_ERR_TAPSCRIPT_VALIDATION_WEIGHT);
+    const P2MRSpend wrong_key{CScript{} << valtype(31, 0x02) << OP_CHECKSLHDSA128S};
+    CHECK_ERR(wrong_key.Verify(one_byte, ACTIVE), SCRIPT_ERR_TAPSCRIPT_VALIDATION_WEIGHT);
+
+    // A leaf that checks the same signature `checks` times, copying the sixteen chunks with OP_PICK,
+    // after `padding` bytes of pushes it drops.
+    auto leaf_for = [&](int checks, size_t padding) {
+        CScript leaf;
+        while (padding > 0) {
+            const size_t size{std::min<size_t>(padding, 400)};
+            leaf << valtype(size, 0x00) << OP_DROP;
+            padding -= size;
+        }
+        for (int c = 1; c < checks; ++c) {
+            for (size_t i = 0; i < SLHDSA128S_SIG_CHUNK_COUNT; ++i) leaf << OP_15 << OP_PICK;
+            leaf << ToByteVector(Key().pubkey) << OP_CHECKSLHDSA128S << OP_VERIFY;
+        }
+        return leaf << ToByteVector(Key().pubkey) << OP_CHECKSLHDSA128S;
+    };
+    const std::vector<valtype> dummy(Chunks(valtype(SLHDSA128S_SIGNATURE_SIZE, 0x00)));
+    auto witness_size = [&](int checks, size_t padding) {
+        return static_cast<int64_t>(GetSerializeSize(P2MRSpend{leaf_for(checks, padding)}.Witness(dummy).stack));
+    };
+    // The fewest checks whose weight the witness of the unpadded leaf does not already cover, and the
+    // paddings that make that witness's budget exactly what the checks use, and one unit less. The
+    // push and size encodings are not linear, so search; each check adds less witness than weight,
+    // so some count of checks has both.
+    constexpr size_t NONE{std::numeric_limits<size_t>::max()};
+    int checks{0};
+    size_t exact{NONE}, short_by_one{NONE};
+    for (int k = 2; k <= 64 && (exact == NONE || short_by_one == NONE); ++k) {
+        const int64_t target{k * weight - VALIDATION_WEIGHT_OFFSET};
+        const int64_t unpadded{witness_size(k, 0)};
+        if (unpadded > target - 1) continue;
+        exact = short_by_one = NONE;
+        for (size_t padding = 0; padding <= static_cast<size_t>(target - unpadded) && (exact == NONE || short_by_one == NONE); ++padding) {
+            const int64_t size{witness_size(k, padding)};
+            if (size == target) exact = padding;
+            if (size == target - 1) short_by_one = padding;
+        }
+        checks = k;
+    }
+    BOOST_REQUIRE(exact != NONE && short_by_one != NONE);
+    BOOST_TEST_MESSAGE("validation weight test: " << checks << " checks of weight " << weight);
+
+    // The budget used up exactly by the checks: it passes.
+    const P2MRSpend at_zero{leaf_for(checks, exact)};
+    const valtype sig_at_zero{SignMessage(*at_zero.Message())};
+    BOOST_REQUIRE_EQUAL(static_cast<int64_t>(GetSerializeSize(at_zero.Witness(Chunks(sig_at_zero)).stack)), checks * weight - VALIDATION_WEIGHT_OFFSET);
+    CHECK_ERR(at_zero.Verify(Chunks(sig_at_zero), ACTIVE), SCRIPT_ERR_OK);
+    // One unit short: the last check fails.
+    const P2MRSpend at_minus_one{leaf_for(checks, short_by_one)};
+    const valtype sig_at_minus_one{SignMessage(*at_minus_one.Message())};
+    BOOST_REQUIRE_EQUAL(static_cast<int64_t>(GetSerializeSize(at_minus_one.Witness(Chunks(sig_at_minus_one)).stack)), checks * weight - VALIDATION_WEIGHT_OFFSET - 1);
+    CHECK_ERR(at_minus_one.Verify(Chunks(sig_at_minus_one), ACTIVE), SCRIPT_ERR_TAPSCRIPT_VALIDATION_WEIGHT);
+    // Without the opcode active, both are OP_SUCCESSx leaves, which succeed.
+    CHECK_ERR(at_minus_one.Verify(Chunks(sig_at_minus_one), BEFORE), SCRIPT_ERR_OK);
+
+    // Empty signatures charge nothing: a leaf of ten checks of an empty signature, each negated.
+    CScript empty_checks;
+    for (int c = 0; c < 10; ++c) {
+        for (size_t i = 0; i < SLHDSA128S_SIG_CHUNK_COUNT; ++i) empty_checks << OP_0;
+        empty_checks << ToByteVector(Key().pubkey) << OP_CHECKSLHDSA128S << OP_NOT << OP_VERIFY;
+    }
+    empty_checks << OP_1;
+    CHECK_ERR(P2MRSpend{empty_checks}.Verify({}, ACTIVE), SCRIPT_ERR_OK);
+}
+
+// Where 0xf1 is not OP_CHECKSLHDSA128S (4S-2, 4S-3, 4S-12).
+BOOST_AUTO_TEST_CASE(where_it_executes)
+{
+    const P2MRSpend spend{SLH1(Key().pubkey)};
+    const std::vector<valtype> junk{Chunks(valtype(SLHDSA128S_SIGNATURE_SIZE, 0x01))};
+
+    // Before activation, in a P2MR leaf of version 0xc0 or (executing) 0xe0: OP_SUCCESS241. The
+    // script succeeds with any witness, unless DISCOURAGE_OP_SUCCESS refuses it.
+    for (const uint8_t leaf_version : {TAPROOT_LEAF_TAPSCRIPT, P2MR_LEAF_TRIPWIRED}) {
+        const P2MRSpend before{SLH1(Key().pubkey), leaf_version};
+        CHECK_ERR(before.Verify(junk, BEFORE), SCRIPT_ERR_OK);
+        CHECK_ERR(before.Verify({}, BEFORE), SCRIPT_ERR_OK);
+        CHECK_ERR(before.Verify(junk, BEFORE | SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS), SCRIPT_ERR_DISCOURAGE_OP_SUCCESS);
+        // Once active, the same witness fails.
+        CHECK_ERR(before.Verify(junk, ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+    }
+    // Active, another OP_SUCCESSx in the same leaf still makes it succeed at once.
+    const P2MRSpend other_success{CScript{} << ToByteVector(Key().pubkey) << OP_CHECKSLHDSA128S << static_cast<opcodetype>(0xf2)};
+    CHECK_ERR(other_success.Verify(junk, ACTIVE), SCRIPT_ERR_OK);
+    CHECK_ERR(other_success.Verify(junk, ACTIVE | SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS), SCRIPT_ERR_DISCOURAGE_OP_SUCCESS);
+    // Active, an OP_CHECKSLHDSA128S in a branch that does not execute is no OP_SUCCESSx either.
+    const P2MRSpend unexecuted{CScript{} << OP_0 << OP_IF << OP_CHECKSLHDSA128S << OP_ENDIF << OP_1};
+    CHECK_ERR(unexecuted.Verify({}, ACTIVE | SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS), SCRIPT_ERR_OK);
+    CHECK_ERR(unexecuted.Verify({}, BEFORE | SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS), SCRIPT_ERR_DISCOURAGE_OP_SUCCESS);
+    // A 0xf1 byte inside pushed data is no opcode at all.
+    const P2MRSpend pushed{CScript{} << valtype{OP_CHECKSLHDSA128S} << OP_DROP << OP_1};
+    CHECK_ERR(pushed.Verify({}, BEFORE | SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS), SCRIPT_ERR_OK);
+
+    // A leaf at depth zero (m = 0) never executes: anyone can spend it, active or not.
+    {
+        const CScript leaf{SLH1(Key().pubkey)};
+        const valtype control{static_cast<unsigned char>(TAPROOT_LEAF_TAPSCRIPT | 1)};
+        const CScript script_pubkey{CScript{} << OP_2 << ToByteVector(ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, leaf))};
+        CMutableTransaction tx;
+        tx.vin.emplace_back(COutPoint{Txid::FromUint256(uint256::ONE), 0});
+        tx.vout.emplace_back(1, CScript{} << OP_TRUE);
+        PrecomputedTransactionData txdata;
+        txdata.Init(tx, {CTxOut{2, script_pubkey}}, /*force=*/true);
+        CScriptWitness witness;
+        witness.stack = {valtype(leaf.begin(), leaf.end()), control};
+        ScriptError err;
+        BOOST_CHECK(VerifyScript(CScript{}, script_pubkey, &witness, ACTIVE | SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS,
+                                 MutableTransactionSignatureChecker{&tx, 0, 2, txdata, MissingDataBehavior::ASSERT_FAIL}, &err));
+    }
+
+    // In a P2TR tapscript leaf it stays OP_SUCCESS241, whatever the flags.
+    {
+        const CScript leaf{SLH1(Key().pubkey)};
+        TaprootBuilder builder;
+        builder.Add(0, leaf, TAPROOT_LEAF_TAPSCRIPT).Finalize(XOnlyPubKey::NUMS_H);
+        const CScript script_pubkey{GetScriptForDestination(builder.GetOutput())};
+        const auto spend_data{builder.GetSpendData()};
+        const valtype control{*spend_data.scripts.at({valtype(leaf.begin(), leaf.end()), TAPROOT_LEAF_TAPSCRIPT}).begin()};
+        CMutableTransaction tx;
+        tx.vin.emplace_back(COutPoint{Txid::FromUint256(uint256::ONE), 0});
+        tx.vout.emplace_back(1, CScript{} << OP_TRUE);
+        PrecomputedTransactionData txdata;
+        txdata.Init(tx, {CTxOut{2, script_pubkey}}, /*force=*/true);
+        CScriptWitness witness;
+        witness.stack = junk;
+        witness.stack.emplace_back(leaf.begin(), leaf.end());
+        witness.stack.push_back(control);
+        const MutableTransactionSignatureChecker checker{&tx, 0, 2, txdata, MissingDataBehavior::ASSERT_FAIL};
+        ScriptError err;
+        BOOST_CHECK(VerifyScript(CScript{}, script_pubkey, &witness, ACTIVE, checker, &err));
+        BOOST_CHECK(!VerifyScript(CScript{}, script_pubkey, &witness, ACTIVE | SCRIPT_VERIFY_DISCOURAGE_OP_SUCCESS, checker, &err));
+        BOOST_CHECK_EQUAL(err, SCRIPT_ERR_DISCOURAGE_OP_SUCCESS);
+    }
+
+    // In legacy and witness v0 scripts it is a bad opcode, active or not.
+    {
+        const CScript redeem{CScript{} << OP_1 << OP_CHECKSLHDSA128S};
+        CMutableTransaction tx;
+        tx.vin.emplace_back(COutPoint{Txid::FromUint256(uint256::ONE), 0});
+        tx.vout.emplace_back(1, CScript{} << OP_TRUE);
+        const MutableTransactionSignatureChecker checker{&tx, 0, 2, MissingDataBehavior::ASSERT_FAIL};
+        ScriptError err;
+        BOOST_CHECK(!VerifyScript(CScript{}, redeem, nullptr, ACTIVE, checker, &err));
+        BOOST_CHECK_EQUAL(err, SCRIPT_ERR_BAD_OPCODE);
+        CScriptWitness witness;
+        witness.stack = {valtype(redeem.begin(), redeem.end())};
+        // P2WSH hashes the script with single SHA256.
+        uint256 hash;
+        CSHA256().Write(redeem.data(), redeem.size()).Finalize(hash.begin());
+        const CScript p2wsh_spk{CScript{} << OP_0 << ToByteVector(hash)};
+        BOOST_CHECK(!VerifyScript(CScript{}, p2wsh_spk, &witness, ACTIVE, checker, &err));
+        BOOST_CHECK_EQUAL(err, SCRIPT_ERR_BAD_OPCODE);
+    }
+}
+
+// The opcode's name, and the cache entries of its checks, which are kept apart from the others.
+BOOST_AUTO_TEST_CASE(names_and_cache)
+{
+    BOOST_CHECK_EQUAL(GetOpName(OP_CHECKSLHDSA128S), "OP_CHECKSLHDSA128S");
+    BOOST_CHECK_EQUAL(static_cast<int>(OP_CHECKSLHDSA128S), 0xf1);
+    BOOST_CHECK(IsOpSuccess(OP_CHECKSLHDSA128S));
+    BOOST_CHECK_EQUAL(ScriptErrorString(SCRIPT_ERR_SLHDSA128S_SIG), "Invalid SLH-DSA-SHA2-128s signature");
+
+    SignatureCache cache{DEFAULT_SIGNATURE_CACHE_BYTES};
+    const uint256 msg{uint256::ONE};
+    const valtype sig(SLHDSA128S_SIGNATURE_SIZE, 0x11);
+    const valtype pubkey(SLHDSA128S_PUBKEY_SIZE, 0x22);
+    uint256 slh_entry, mldsa_entry;
+    cache.ComputeEntrySLHDSA128S(slh_entry, msg, sig, pubkey);
+    cache.ComputeEntryMLDSA44(mldsa_entry, msg, sig, pubkey);
+    BOOST_CHECK(slh_entry != mldsa_entry);
+
+    // A valid spend checked by the caching checker that stores, then by one that only reads: the
+    // second finds the entry and does not call the library.
+    const P2MRSpend spend{SLH1(Key().pubkey)};
+    const CScriptWitness witness{spend.Witness(Chunks(SignMessage(*spend.Message())))};
+    const CTransaction tx{spend.tx};
+    const CScript& script_pubkey{spend.spent_outputs[0].scriptPubKey};
+    ScriptError err;
+    BOOST_CHECK(VerifyScript(CScript{}, script_pubkey, &witness, ACTIVE,
+                             CachingTransactionSignatureChecker{&tx, 0, spend.spent_outputs[0].nValue, /*storeIn=*/true, cache, spend.txdata}, &err));
+    const uint64_t calls{SLHDSA128SVerifyLibraryCalls()};
+    BOOST_CHECK(VerifyScript(CScript{}, script_pubkey, &witness, ACTIVE,
+                             CachingTransactionSignatureChecker{&tx, 0, spend.spent_outputs[0].nValue, /*storeIn=*/false, cache, spend.txdata}, &err));
+    BOOST_CHECK_EQUAL(SLHDSA128SVerifyLibraryCalls(), calls);
+}
+
+// Relay policy of doc/p2mr-slhdsa128s.md: P2MR witness elements stay within 80 bytes, but for the
+// sixteen signature chunks of SLH1, byte for byte, at depth one or more, in leaf version 0xc0 or 0xe0.
+// Any other leaf that has the opcode is not standard, whatever its elements.
+BOOST_AUTO_TEST_CASE(template_policy)
+{
+    BOOST_CHECK(HasSLHDSA128SOpcode(SLH1(Key().pubkey)));
+    BOOST_CHECK(!HasSLHDSA128SOpcode(CScript{} << valtype{OP_CHECKSLHDSA128S} << OP_DROP));
+    BOOST_CHECK(!HasMLDSA44Opcode(SLH1(Key().pubkey)));
+
+    const valtype sig(SLHDSA128S_SIGNATURE_SIZE, 0x5a);
+    auto standard = [](const P2MRSpend& spend, const std::vector<valtype>& stack) {
+        CCoinsView empty;
+        CCoinsViewCache view{&empty};
+        CMutableTransaction tx{spend.tx};
+        for (size_t i = 0; i < tx.vin.size(); ++i) {
+            view.AddCoin(tx.vin[i].prevout, Coin{spend.spent_outputs[i], 1, false}, false);
+        }
+        tx.vin[spend.input_index].scriptWitness = spend.Witness(stack);
+        return IsWitnessStandard(CTransaction{tx}, view);
+    };
+    for (const uint8_t leaf_version : {TAPROOT_LEAF_TAPSCRIPT, P2MR_LEAF_TRIPWIRED}) {
+        const P2MRSpend slh1{SLH1(Key().pubkey), leaf_version};
+        BOOST_CHECK(standard(slh1, Chunks(sig)));
+        BOOST_CHECK(standard(slh1, Chunks(WithHashType(sig, SIGHASH_ALL))));
+        BOOST_CHECK(standard(slh1, std::vector<valtype>(SLHDSA128S_SIG_CHUNK_COUNT)));
+        // A chunk of another size than its place has, beyond 80 bytes.
+        std::vector<valtype> chunks{Chunks(sig)};
+        chunks[0].pop_back();
+        BOOST_CHECK(!standard(slh1, chunks));
+        chunks = Chunks(sig);
+        chunks.back().resize(81, 0x00);
+        BOOST_CHECK(!standard(slh1, chunks));
+        // Another element on the stack: the exception does not apply, and the chunks are too big.
+        chunks = Chunks(sig);
+        chunks.insert(chunks.begin(), valtype{0x01});
+        BOOST_CHECK(!standard(slh1, chunks));
+    }
+    // Other leaves with the opcode: the key pushed another way, another key size, something before or
+    // after, a multisig of two checks, or the ML-DSA-44 check in the same leaf.
+    const valtype key{Key().pubkey.begin(), Key().pubkey.end()};
+    const std::vector<CScript> other_leaves{
+        CScript{} << OP_PUSHDATA1 << key << OP_CHECKSLHDSA128S,
+        CScript{} << valtype(33, 0x02) << OP_CHECKSLHDSA128S,
+        CScript{} << OP_NOP << key << OP_CHECKSLHDSA128S,
+        CScript{} << key << OP_CHECKSLHDSA128S << OP_VERIFY << OP_1,
+        CScript{} << key << OP_CHECKSLHDSA128S << OP_VERIFY << key << OP_CHECKSLHDSA128S,
+        CScript{} << OP_CHECKMLDSA44 << OP_VERIFY << key << OP_CHECKSLHDSA128S,
+    };
+    for (const CScript& leaf : other_leaves) {
+        const P2MRSpend spend{leaf};
+        BOOST_CHECK(!standard(spend, Chunks(sig)));
+        // Even with no element above 80 bytes.
+        BOOST_CHECK(!standard(spend, std::vector<valtype>(SLHDSA128S_SIG_CHUNK_COUNT)));
+    }
+    // A 0xf1 byte inside pushed data does not make a leaf non-standard.
+    BOOST_CHECK(standard(P2MRSpend{CScript{} << valtype{OP_CHECKSLHDSA128S} << OP_DROP << OP_1}, {}));
+    // In P2TR, or at depth zero, nothing executes and nothing gets the exception.
+}
+
+BOOST_AUTO_TEST_SUITE_END()
