+// The signature messages the functional test framework computes for key_version 2, next to the
+// ones of key_version 0 and 1, which must stay as they were (test/util/generate_p2mr_slhdsa128s_sighash.py).
+BOOST_AUTO_TEST_CASE(signature_message_vectors)
+{
+    const UniValue file{read_json(json_tests::p2mr_slhdsa128s_sighash)};
+    BOOST_REQUIRE_EQUAL(file.size(), 2U);
+    const UniValue& vectors{file[1]};
+    CMutableTransaction tx;
+    SpanReader{Hex(vectors["tx"])} >> TX_NO_WITNESS(tx);
+    std::vector<CTxOut> spent_outputs;
+    for (const UniValue& output : vectors["spent_outputs"].getValues()) {
+        const auto script_pubkey{Hex(output["script_pubkey"])};
+        spent_outputs.emplace_back(output["amount"].getInt<int64_t>(), CScript(script_pubkey.begin(), script_pubkey.end()));
+    }
+    PrecomputedTransactionData txdata;
+    txdata.Init(tx, std::move(spent_outputs), /*force=*/true);
+    int with_message{0}, without_message{0};
+    for (const UniValue& test : vectors["cases"].getValues()) {
+        ScriptExecutionData execdata;
+        execdata.m_annex_init = true;
+        execdata.m_annex_present = !test["annex"].isNull();
+        if (execdata.m_annex_present) execdata.m_annex_hash = (HashWriter{} << Hex(test["annex"])).GetSHA256();
+        execdata.m_tapleaf_hash = ComputeTapleafHash(test["leaf_version"].getInt<uint8_t>(), Hex(test["leaf_script"]));
+        execdata.m_tapleaf_hash_init = true;
+        execdata.m_codeseparator_pos = test["codeseparator_pos"].getInt<uint32_t>();
+        execdata.m_codeseparator_pos_init = true;
+        for (const uint8_t key_version : {uint8_t{0}, MLDSA44_KEY_VERSION, SLHDSA128S_KEY_VERSION}) {
+            const UniValue& expected{test[strprintf("msg_key_version_%d", int{key_version})]};
+            uint256 msg;
+            const bool ok{SignatureHashSchnorr(msg, execdata, tx, test["input_index"].getInt<uint32_t>(), test["hash_type"].getInt<uint8_t>(),
+                                               SigVersion::TAPSCRIPT, txdata, MissingDataBehavior::FAIL, key_version)};
+            if (expected.isNull()) {
+                BOOST_CHECK(!ok);
+                ++without_message;
+            } else {
+                BOOST_CHECK(ok);
+                BOOST_CHECK_EQUAL(HexStr(msg), expected.get_str());
+                ++with_message;
+            }
+        }
+    }
+    BOOST_CHECK_EQUAL(with_message, 30);
+    BOOST_CHECK_EQUAL(without_message, 3);
+}
