+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Generate src/test/data/p2mr_slhdsa128s_sighash.json, the signature messages of OP_CHECKSLHDSA128S.
+
+The messages are computed by the functional test framework (TaprootSignatureMsg with key_ver), an
+implementation of its own, so p2mr_slhdsa128s_tests checks SignatureHashSchnorr against it. The
+transaction and spent outputs are those of p2mr_mldsa44_sighash.json; the leaves are SLH1 for a fixed
+key, in leaf versions 0xc0 and 0xe0, with and without OP_CODESEPARATOR. Each case has the messages
+of key_version 0 (a BIP 342 signature), 1 (OP_CHECKMLDSA44) and 2 (OP_CHECKSLHDSA128S).
+
+    test/util/generate_p2mr_slhdsa128s_sighash.py [--write]
+
+Without --write it prints the file; with it, it rewrites the file in the source tree.
+"""
+import argparse
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "functional"))
+
+from test_framework.messages import CTransaction, CTxOut, from_hex  # noqa: E402
+from test_framework.p2mr_slhdsa128s import (  # noqa: E402
+    NO_CODESEPARATOR,
+    OP_CHECKSLHDSA128S,
+    slhdsa128s_leaf,
+    slhdsa128s_sighash,
+)
+from test_framework.script import CScript, OP_CODESEPARATOR  # noqa: E402
+
+DATA = os.path.join(HERE, "..", "..", "src", "test", "data")
+# A fixed 32-byte public key: SHA256("p2mr_slhdsa128s_sighash key"). Messages do not depend on whether
+# it is a real key.
+PUBKEY = bytes.fromhex("6b3c5d0e1a9f2c4b7d8e0f1a2b3c4d5e6f708192a3b4c5d6e7f8091a2b3c4d5e")
+
+
+def vectors():
+    with open(os.path.join(DATA, "p2mr_mldsa44_sighash.json"), encoding="utf-8") as f:
+        m1 = json.load(f)[1]
+    tx = from_hex(CTransaction(), m1["tx"])
+    spent = [CTxOut(o["amount"], bytes.fromhex(o["script_pubkey"])) for o in m1["spent_outputs"]]
+    slh1 = slhdsa128s_leaf(PUBKEY)
+    with_codesep = CScript([OP_CODESEPARATOR, PUBKEY, OP_CHECKSLHDSA128S])
+    rows = [
+        # (input index, leaf version, leaf script, hash type, annex, code separator position)
+        (0, 0xc0, slh1, 0x00, None, NO_CODESEPARATOR),
+        (0, 0xc0, slh1, 0x01, None, NO_CODESEPARATOR),
+        (1, 0xc0, slh1, 0x02, None, NO_CODESEPARATOR),
+        (1, 0xc0, slh1, 0x03, b"\x50\xaa\xbb", NO_CODESEPARATOR),
+        (0, 0xc0, slh1, 0x81, None, NO_CODESEPARATOR),
+        (1, 0xc0, slh1, 0x82, b"\x50\xaa\xbb", NO_CODESEPARATOR),
+        (0, 0xc0, with_codesep, 0x83, None, 0),
+        (0, 0xc0, with_codesep, 0x00, b"\x50\xaa\xbb", 0),
+        (0, 0xe0, slh1, 0x00, None, NO_CODESEPARATOR),
+        (1, 0xe0, slh1, 0x83, b"\x50\xaa\xbb", NO_CODESEPARATOR),
+        # SIGHASH_SINGLE for an input without an output of its index: no message.
+        (2, 0xc0, slh1, 0x03, None, NO_CODESEPARATOR),
+    ]
+    cases = []
+    for input_index, leaf_ver, leaf, hash_type, annex, codesep in rows:
+        case = {
+            "input_index": input_index,
+            "leaf_version": leaf_ver,
+            "leaf_script": bytes(leaf).hex(),
+            "hash_type": hash_type,
+            "annex": None if annex is None else annex.hex(),
+            "codeseparator_pos": codesep,
+        }
+        for key_ver in (0, 1, 2):
+            if input_index >= len(tx.vout) and hash_type & 3 == 3:
+                case[f"msg_key_version_{key_ver}"] = None
+                continue
+            case[f"msg_key_version_{key_ver}"] = slhdsa128s_sighash(
+                tx, spent, input_index, leaf, hash_type=hash_type, annex=annex, codeseparator_pos=codesep,
+                key_ver=key_ver, leaf_ver=leaf_ver).hex()
+        cases.append(case)
+    comment = ("Generated by test/util/generate_p2mr_slhdsa128s_sighash.py. msg_key_version_2 is the message an "
+               "OP_CHECKSLHDSA128S signature signs (doc/p2mr-slhdsa128s.md); msg_key_version_1 that of OP_CHECKMLDSA44 "
+               "and msg_key_version_0 that of a BIP 342 signature in the same leaf. The transaction and spent outputs "
+               "are those of p2mr_mldsa44_sighash.json.")
+    return [[comment], {"tx": m1["tx"], "spent_outputs": m1["spent_outputs"], "cases": cases}]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--write", action="store_true", help="rewrite src/test/data/p2mr_slhdsa128s_sighash.json")
+    args = parser.parse_args()
+    text = json.dumps(vectors(), indent=1) + "\n"
+    if args.write:
+        with open(os.path.join(DATA, "p2mr_slhdsa128s_sighash.json"), "w", encoding="utf-8", newline="\n") as f:
+            f.write(text)
+    else:
+        sys.stdout.write(text)
+
+
+if __name__ == "__main__":
+    main()
