+namespace {
+using valtype = std::vector<unsigned char>;
+
+constexpr int NEVER{std::numeric_limits<int>::max()};
+const std::string ARK0_CHALLENGE{"5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae"};
+constexpr uint32_t NO_CODESEPARATOR{0xffffffff};
+
+//! The flags of a block with P2MR, OP_CHECKMLDSA44, leaf version 0xe0 and OP_CHECKSLHDSA128S active.
+constexpr script_verify_flags ACTIVE{SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_TAPROOT | SCRIPT_VERIFY_P2MR |
+                                     SCRIPT_VERIFY_P2MR_MLDSA44 | SCRIPT_VERIFY_P2MR_TRIPWIRE | SCRIPT_VERIFY_P2MR_SLHDSA128S};
+//! The same before OP_CHECKSLHDSA128S is active.
+constexpr script_verify_flags BEFORE{ACTIVE & ~SCRIPT_VERIFY_P2MR_SLHDSA128S};
+
+valtype Bytes(std::string_view text) { return {text.begin(), text.end()}; }
+
+std::vector<valtype> Chunks(const valtype& sig)
+{
+    BOOST_REQUIRE(sig.size() == SLHDSA128S_SIGNATURE_SIZE || sig.size() == SLHDSA128S_SIGNATURE_SIZE + 1);
+    std::vector<valtype> chunks;
+    size_t pos{0};
+    for (size_t i = 0; i < SLHDSA128S_SIG_CHUNK_COUNT; ++i) {
+        const size_t size{i + 1 == SLHDSA128S_SIG_CHUNK_COUNT ? sig.size() - pos : SLHDSA128S_SIG_CHUNK_SIZES[i]};
+        chunks.emplace_back(sig.begin() + pos, sig.begin() + pos + size);
+        pos += size;
+    }
+    return chunks;
+}
+
+CScript SLH1(std::span<const unsigned char> pubkey) { return CScript{} << valtype{pubkey.begin(), pubkey.end()} << OP_CHECKSLHDSA128S; }
+
+/** One input spending a P2MR output of two leaves at depth one, `leaf` and OP_RETURN, both of
+ *  version leaf_version, in a transaction of `input_count` inputs (this one at `input_index`) and
+ *  one output. */
+struct P2MRSpend {
+    CScript leaf;
+    uint8_t leaf_version{TAPROOT_LEAF_TAPSCRIPT};
+    uint32_t input_index{0};
+    size_t input_count{1};
+    std::optional<valtype> annex;
+
+    CMutableTransaction tx;
+    std::vector<CTxOut> spent_outputs;
+    // The caching checker takes it by non-const reference.
+    mutable PrecomputedTransactionData txdata;
+    valtype control;
+
+    P2MRSpend(CScript leaf_in, uint8_t leaf_version_in = TAPROOT_LEAF_TAPSCRIPT, std::optional<valtype> annex_in = std::nullopt,
+              size_t input_count_in = 1, uint32_t input_index_in = 0)
+        : leaf{std::move(leaf_in)}, leaf_version{leaf_version_in}, input_index{input_index_in}, input_count{input_count_in}, annex{std::move(annex_in)}
+    {
+        const CScript fail{CScript{} << OP_RETURN};
+        const uint256 leaf_hash{ComputeTapleafHash(leaf_version, leaf)};
+        const uint256 fail_hash{ComputeTapleafHash(leaf_version, fail)};
+        const CScript script_pubkey{CScript{} << OP_2 << ToByteVector(ComputeTapbranchHash(leaf_hash, fail_hash))};
+        control = {static_cast<unsigned char>(leaf_version | 1)};
+        control.insert(control.end(), fail_hash.begin(), fail_hash.end());
+        tx.version = 2;
+        for (size_t i = 0; i < input_count; ++i) {
+            tx.vin.emplace_back(COutPoint{Txid::FromUint256(uint256{static_cast<uint8_t>(i + 1)}), static_cast<uint32_t>(i)});
+            spent_outputs.emplace_back(100'000 + i, script_pubkey);
+        }
+        tx.vout.emplace_back(90'000, CScript{} << OP_TRUE);
+        txdata.Init(tx, std::vector<CTxOut>{spent_outputs}, /*force=*/true);
+    }
+
+    /** The message an OP_CHECKSLHDSA128S signature in the leaf signs, with what the interpreter would
+     *  commit to, or nullopt where SignatureHashSchnorr has none (SIGHASH_SINGLE without an output). */
+    std::optional<uint256> Message(uint8_t hash_type = SIGHASH_DEFAULT, uint8_t key_version = SLHDSA128S_KEY_VERSION,
+                                   uint32_t codesep_pos = NO_CODESEPARATOR, std::optional<uint8_t> leaf_version_signed = std::nullopt,
+                                   const std::optional<valtype>& annex_signed = std::nullopt, bool use_own_annex = true) const
+    {
+        ScriptExecutionData execdata;
+        const std::optional<valtype>& a{use_own_annex ? annex : annex_signed};
+        execdata.m_annex_init = true;
+        execdata.m_annex_present = a.has_value();
+        if (a) execdata.m_annex_hash = (HashWriter{} << *a).GetSHA256();
+        execdata.m_tapleaf_hash = ComputeTapleafHash(leaf_version_signed.value_or(leaf_version), leaf);
+        execdata.m_tapleaf_hash_init = true;
+        execdata.m_codeseparator_pos = codesep_pos;
+        execdata.m_codeseparator_pos_init = true;
+        uint256 msg;
+        if (!SignatureHashSchnorr(msg, execdata, tx, input_index, hash_type, SigVersion::TAPSCRIPT, txdata, MissingDataBehavior::FAIL, key_version)) {
+            return std::nullopt;
+        }
+        return msg;
+    }
+
+    /** The witness: the given initial stack, the leaf, the control block and the annex. */
+    CScriptWitness Witness(std::vector<valtype> stack) const
+    {
+        CScriptWitness witness;
+        witness.stack = std::move(stack);
+        witness.stack.emplace_back(leaf.begin(), leaf.end());
+        witness.stack.push_back(control);
+        if (annex) witness.stack.push_back(*annex);
+        return witness;
+    }
+
+    /** The result of verifying the input with `stack` under `flags`, with the plain checker. The same
+     *  input through DeferringSignatureChecker, which must forward OP_CHECKSLHDSA128S, and through the
+     *  caching checker of block validation, must give the same result. */
+    ScriptError Verify(const std::vector<valtype>& stack, script_verify_flags flags) const
+    {
+        const CScriptWitness witness{Witness(stack)};
+        const CTransaction tx_const{tx};
+        const CAmount amount{spent_outputs[input_index].nValue};
+        const CScript& script_pubkey{spent_outputs[input_index].scriptPubKey};
+
+        ScriptError err{SCRIPT_ERR_UNKNOWN_ERROR};
+        const MutableTransactionSignatureChecker checker{&tx, input_index, amount, txdata, MissingDataBehavior::ASSERT_FAIL};
+        const bool ok{VerifyScript(CScript{}, script_pubkey, &witness, flags, checker, &err)};
+        BOOST_CHECK_EQUAL(ok, err == SCRIPT_ERR_OK);
+
+        ScriptError deferred_err{SCRIPT_ERR_UNKNOWN_ERROR};
+        const DeferringSignatureChecker deferring{checker};
+        VerifyScript(CScript{}, script_pubkey, &witness, flags, deferring, &deferred_err);
+        BOOST_CHECK_MESSAGE(deferred_err == err, "DeferringSignatureChecker: " << ScriptErrorString(deferred_err) << " instead of " << ScriptErrorString(err));
+
+        static SignatureCache signature_cache{DEFAULT_SIGNATURE_CACHE_BYTES};
+        ScriptError cached_err{SCRIPT_ERR_UNKNOWN_ERROR};
+        const CachingTransactionSignatureChecker caching{&tx_const, input_index, amount, /*storeIn=*/true, signature_cache, txdata};
+        VerifyScript(CScript{}, script_pubkey, &witness, flags, caching, &cached_err);
+        BOOST_CHECK_MESSAGE(cached_err == err, "CachingTransactionSignatureChecker: " << ScriptErrorString(cached_err) << " instead of " << ScriptErrorString(err));
+        return err;
+    }
+};
+
+#define CHECK_ERR(expr, expected) \
+    do { \
+        const ScriptError err_{expr}; \
+        BOOST_CHECK_MESSAGE(err_ == (expected), #expr ": " << ScriptErrorString(err_) << ", expected " << ScriptErrorString(expected)); \
+    } while (0)
+
+/** The keys every test signs with. Key generation builds the top XMSS tree, so it is done once. */
+const SLHDSA128SKey& Key()
+{
+    static const SLHDSA128SKey key{SLHDSA128SKey::FromLabel(Bytes("p2mr_slhdsa128s_tests key"))};
+    return key;
+}
+
+valtype SignMessage(const uint256& msg, std::span<const unsigned char> ctx = MakeUCharSpan(SLHDSA128S_CONTEXT))
+{
+    return Key().Sign(MakeUCharSpan(msg), ctx);
+}
+
+valtype WithHashType(valtype sig, uint8_t hash_type)
+{
+    sig.push_back(hash_type);
+    return sig;
+}
+
+std::unique_ptr<const CChainParams> MakeParams(ChainType chain, const std::vector<std::pair<std::string, std::string>>& settings)
+{
+    ArgsManager args;
+    for (const auto& [name, value] : settings) args.ForceSetArg(name, value);
+    return CreateChainParams(args, chain);
+}
+
+void Fails(ChainType chain, const std::vector<std::pair<std::string, std::string>>& settings, const std::string& message)
+{
+    BOOST_CHECK_EXCEPTION(MakeParams(chain, settings), std::runtime_error, HasReason{message});
+}
+
+valtype Hex(const UniValue& field)
+{
+    const auto bytes{TryParseHex<unsigned char>(field.get_str())};
+    BOOST_REQUIRE_MESSAGE(bytes.has_value(), "not hex: " << field.get_str().substr(0, 40));
+    return *bytes;
+}
