+// Valid spends of SLH1 (4S-1 to 4S-11): in leaf versions 0xc0 and 0xe0, with every hash type.
+BOOST_AUTO_TEST_CASE(valid_spends)
+{
+    for (const uint8_t leaf_version : {TAPROOT_LEAF_TAPSCRIPT, P2MR_LEAF_TRIPWIRED}) {
+        const P2MRSpend spend{SLH1(Key().pubkey), leaf_version};
+        const valtype sig{SignMessage(*spend.Message())};
+        CHECK_ERR(spend.Verify(Chunks(sig), ACTIVE), SCRIPT_ERR_OK);
+        // A tripwire output missing (SCRIPT_VERIFY_P2MR_EC_DISABLED) does not affect it (4S-13).
+        CHECK_ERR(spend.Verify(Chunks(sig), ACTIVE | SCRIPT_VERIFY_P2MR_EC_DISABLED), SCRIPT_ERR_OK);
+        // A signature for one leaf version does not spend the other (the tapleaf hash commits to it).
+        const uint8_t other_version{leaf_version == TAPROOT_LEAF_TAPSCRIPT ? P2MR_LEAF_TRIPWIRED : TAPROOT_LEAF_TAPSCRIPT};
+        const valtype other_sig{SignMessage(*spend.Message(SIGHASH_DEFAULT, SLHDSA128S_KEY_VERSION, NO_CODESEPARATOR, other_version))};
+        CHECK_ERR(spend.Verify(Chunks(other_sig), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+    }
+    // Leaf version 0xe0 only executes with SCRIPT_VERIFY_P2MR_TRIPWIRE: without it, an unknown leaf
+    // version, which succeeds whatever the witness.
+    {
+        const P2MRSpend spend{SLH1(Key().pubkey), P2MR_LEAF_TRIPWIRED};
+        const std::vector<valtype> junk(16, valtype(520, 0x01));
+        CHECK_ERR(spend.Verify(junk, ACTIVE & ~SCRIPT_VERIFY_P2MR_TRIPWIRE), SCRIPT_ERR_OK);
+        CHECK_ERR(spend.Verify(junk, (ACTIVE & ~SCRIPT_VERIFY_P2MR_TRIPWIRE) | SCRIPT_VERIFY_DISCOURAGE_UPGRADABLE_TAPROOT_VERSION),
+                  SCRIPT_ERR_DISCOURAGE_UPGRADABLE_TAPROOT_VERSION);
+    }
+    // Every hash type BIP 341 allows, as an explicit 57th byte of the last chunk. The transaction has
+    // two inputs so that SIGHASH_ANYONECANPAY makes a difference.
+    for (const uint8_t hash_type : {0x01, 0x02, 0x03, 0x81, 0x82, 0x83}) {
+        const P2MRSpend spend{SLH1(Key().pubkey), TAPROOT_LEAF_TAPSCRIPT, std::nullopt, 2, 0};
+        const valtype sig{WithHashType(SignMessage(*spend.Message(hash_type)), hash_type)};
+        BOOST_REQUIRE_EQUAL(Chunks(sig).back().size(), 57U);
+        CHECK_ERR(spend.Verify(Chunks(sig), ACTIVE), SCRIPT_ERR_OK);
+        // The same signature with another hash type byte signs another message.
+        const uint8_t other{static_cast<uint8_t>(hash_type == 0x01 ? 0x81 : 0x01)};
+        valtype changed{sig};
+        changed.back() = other;
+        CHECK_ERR(spend.Verify(Chunks(changed), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+    }
+}
+
+// The annex and OP_CODESEPARATOR are committed to (4S-10).
+BOOST_AUTO_TEST_CASE(annex_and_codeseparator)
+{
+    const valtype annex{ANNEX_TAG, 0x01, 0x02, 0x03};
+    const P2MRSpend with_annex{SLH1(Key().pubkey), TAPROOT_LEAF_TAPSCRIPT, annex};
+    const valtype sig{SignMessage(*with_annex.Message())};
+    CHECK_ERR(with_annex.Verify(Chunks(sig), ACTIVE), SCRIPT_ERR_OK);
+    // Another annex, or none, fails with the same signature.
+    const P2MRSpend other_annex{SLH1(Key().pubkey), TAPROOT_LEAF_TAPSCRIPT, valtype{ANNEX_TAG, 0x01, 0x02, 0x04}};
+    CHECK_ERR(other_annex.Verify(Chunks(sig), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+    const P2MRSpend no_annex{SLH1(Key().pubkey)};
+    CHECK_ERR(no_annex.Verify(Chunks(sig), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+    // And a signature made without the annex fails once one is added.
+    const valtype sig_no_annex{SignMessage(*no_annex.Message())};
+    CHECK_ERR(no_annex.Verify(Chunks(sig_no_annex), ACTIVE), SCRIPT_ERR_OK);
+    CHECK_ERR(with_annex.Verify(Chunks(sig_no_annex), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+
+    // OP_CODESEPARATOR before the check: the message commits to its position, 0.
+    const P2MRSpend codesep{CScript{} << OP_CODESEPARATOR << ToByteVector(Key().pubkey) << OP_CHECKSLHDSA128S};
+    CHECK_ERR(codesep.Verify(Chunks(SignMessage(*codesep.Message(SIGHASH_DEFAULT, SLHDSA128S_KEY_VERSION, 0))), ACTIVE), SCRIPT_ERR_OK);
+    CHECK_ERR(codesep.Verify(Chunks(SignMessage(*codesep.Message())), ACTIVE), SCRIPT_ERR_SLHDSA128S_SIG);
+}
