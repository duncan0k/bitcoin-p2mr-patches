new file mode 100644
index 0000000..df64b6f
--- /dev/null
+++ b/src/test/fuzz/slhdsa128s_verify.cpp
@@ -0,0 +1,74 @@
+// Copyright (c) 2026 duncan0k
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <crypto/slhdsa128s.h>
+#include <test/fuzz/FuzzedDataProvider.h>
+#include <test/fuzz/fuzz.h>
+#include <test/util/slhdsa128s_fixture.h>
+#include <util/strencodings.h>
+
+#include <cassert>
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+namespace {
+const std::vector<unsigned char> FIXTURE_PUBKEY{ParseHex(SLHDSA128S_FIXTURE_PUBKEY_HEX)};
+const std::vector<unsigned char> FIXTURE_MSG{ParseHex(SLHDSA128S_FIXTURE_MSG_HEX)};
+const std::vector<unsigned char> FIXTURE_CTX{SLHDSA128S_FIXTURE_CONTEXT.begin(), SLHDSA128S_FIXTURE_CONTEXT.end()};
+const std::vector<unsigned char> FIXTURE_SIG{ParseHex(SLHDSA128S_FIXTURE_SIG_HEX)};
+
+/** Mostly the size a field must have, so that the library is reached; now and then another. */
+size_t SizeOrOther(FuzzedDataProvider& provider, size_t size, size_t max)
+{
+    return provider.ConsumeIntegralInRange<int>(0, 3) == 0 ? provider.ConsumeIntegralInRange<size_t>(0, max) : size;
+}
+} // namespace
+
+// SLHDSA128SVerify (src/crypto/slhdsa128s.h) on inputs of any length: it must never read out of
+// bounds (the vendored slh_verify hashes the first 16 bytes of the signature before it checks its
+// length), never call the library with a wrong length, and accept nothing but the valid fixture
+// signature on its own message, key and context string.
+FUZZ_TARGET(slhdsa128s_verify)
+{
+    FuzzedDataProvider provider(buffer.data(), buffer.size());
+    const bool from_fixture{provider.ConsumeBool()};
+    std::vector<unsigned char> pubkey, msg, ctx, sig;
+    if (from_fixture) {
+        // The valid signature, its key, message and context, with a few bytes changed and lengths
+        // perhaps changed too.
+        pubkey = FIXTURE_PUBKEY;
+        msg = FIXTURE_MSG;
+        ctx = FIXTURE_CTX;
+        sig = FIXTURE_SIG;
+        const int edits{provider.ConsumeIntegralInRange<int>(0, 4)};
+        for (int i = 0; i < edits; ++i) {
+            const uint8_t mask{provider.ConsumeIntegral<uint8_t>()};
+            switch (provider.ConsumeIntegralInRange<int>(0, 4)) {
+            case 0: if (!sig.empty()) sig[provider.ConsumeIntegralInRange<size_t>(0, sig.size() - 1)] ^= mask; break;
+            case 1: pubkey[provider.ConsumeIntegralInRange<size_t>(0, pubkey.size() - 1)] ^= mask; break;
+            case 2: if (!msg.empty() && provider.ConsumeBool()) msg[provider.ConsumeIntegralInRange<size_t>(0, msg.size() - 1)] ^= mask; else msg.resize(SizeOrOther(provider, msg.size(), 64), mask); break;
+            case 3: if (!ctx.empty()) ctx[provider.ConsumeIntegralInRange<size_t>(0, ctx.size() - 1)] ^= mask; break;
+            case 4: sig.resize(SizeOrOther(provider, sig.size(), SLHDSA128S_SIGNATURE_SIZE + 2), mask); break;
+            }
+        }
+    } else {
+        pubkey = provider.ConsumeBytes<unsigned char>(SizeOrOther(provider, SLHDSA128S_PUBKEY_SIZE, 64));
+        msg = provider.ConsumeBytes<unsigned char>(SizeOrOther(provider, SLHDSA128S_MESSAGE_SIZE, 64));
+        ctx = provider.ConsumeBytes<unsigned char>(SizeOrOther(provider, provider.ConsumeIntegralInRange<size_t>(0, 32), 300));
+        sig = provider.ConsumeBytes<unsigned char>(SizeOrOther(provider, SLHDSA128S_SIGNATURE_SIZE, SLHDSA128S_SIGNATURE_SIZE + 2));
+        // ConsumeBytes gives fewer bytes when the input runs out; pad to the length asked for.
+        if (sig.size() + 2 >= SLHDSA128S_SIGNATURE_SIZE) sig.resize(SLHDSA128S_SIGNATURE_SIZE, 0x00);
+    }
+
+    const bool lengths_ok{pubkey.size() == SLHDSA128S_PUBKEY_SIZE && msg.size() == SLHDSA128S_MESSAGE_SIZE && sig.size() == SLHDSA128S_SIGNATURE_SIZE && ctx.size() <= SLHDSA128S_MAX_CONTEXT_SIZE};
+    const uint64_t calls_before{SLHDSA128SVerifyLibraryCalls()};
+    // Copies of exactly the given lengths, so that a sanitizer sees any read beyond them.
+    const std::vector<unsigned char> exact_sig{sig.begin(), sig.end()};
+    const bool valid{SLHDSA128SVerify(pubkey, msg, ctx, exact_sig)};
+    assert(SLHDSA128SVerifyLibraryCalls() == calls_before + (lengths_ok ? 1 : 0));
+    if (!lengths_ok) assert(!valid);
+    const bool fixture{pubkey == FIXTURE_PUBKEY && msg == FIXTURE_MSG && ctx == FIXTURE_CTX && sig == FIXTURE_SIG};
+    assert(valid == fixture);
+}
