+    if (chain != ChainType::SIGNET && args.IsArgSet("-signetslhdsa128s")) {
+        throw std::runtime_error("-signetslhdsa128s can only be used with signet.");
+    }
     if (chain != ChainType::SIGNET && chain != ChainType::REGTEST && args.IsArgSet("-signettripwire")) {
         throw std::runtime_error("-signettripwire can only be used with signet or regtest.");
     }
