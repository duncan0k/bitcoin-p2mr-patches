diff --git a/src/kernel/chainparams.h b/src/kernel/chainparams.h
index bcdd31f..b32534f 100644
--- a/src/kernel/chainparams.h
+++ b/src/kernel/chainparams.h
@@ -59,6 +59,20 @@ inline constexpr int ARK0_TRIPWIRE_HEIGHT{30000};
 // Leaf version 0xe0 runs OP_CHECKMLDSA44, which has to be active before the leaves are.
 static_assert(ARK0_TRIPWIRE_HEIGHT > ARK0_MLDSA44_HEIGHT);
 
+/**
+ * Height from which the Ark-0 signet executes OP_CHECKSLHDSA128S in P2MR leaves of leaf
+ * versions 0xc0 and 0xe0 (doc/p2mr-slhdsa128s.md). Like the heights above, a rule of that
+ * network, fixed here rather than given by an option.
+ *
+ * Set at the release of this rule, together with the final VALIDATION_WEIGHT_PER_SLHDSA128S_CHECK,
+ * about a week of blocks above the chain then. It covers this opcode only; other rules come with
+ * heights of their own. Once set, it does not change after a build carrying it has left the
+ * network's own nodes.
+ */
+inline constexpr int ARK0_SLHDSA128S_HEIGHT{32000};
+// Leaf version 0xe0 must execute before this opcode can run in it: the tripwire height comes first.
+static_assert(ARK0_TRIPWIRE_HEIGHT < ARK0_SLHDSA128S_HEIGHT);
+
 /** Height of the block that created both tripwire outputs of the Ark-0 signet. */
 inline constexpr int ARK0_TRIPWIRE_CREATION_HEIGHT{15748};
 // An output counts as present only when it was created below the height of the rules.
