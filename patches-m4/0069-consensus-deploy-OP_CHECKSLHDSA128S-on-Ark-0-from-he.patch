+    if (!args.GetArgs("-signetslhdsa128s").empty()) {
+        const auto values = args.GetArgs("-signetslhdsa128s");
+        if (values.size() != 1) {
+            throw std::runtime_error("-signetslhdsa128s cannot be multiple values.");
+        }
+        if (!options.challenge) {
+            throw std::runtime_error("-signetslhdsa128s requires -signetchallenge.");
+        }
+        if (IsArk0SignetChallenge(*options.challenge)) {
+            throw std::runtime_error("-signetslhdsa128s cannot be used on the Ark-0 signet, whose rules are fixed in the code.");
+        }
+        const auto height{ToIntegral<int32_t>(values[0])};
+        if (!height) {
+            throw std::runtime_error(strprintf("-signetslhdsa128s must be a height, not '%s'.", values[0]));
+        }
+        if (*height < 1 || *height == std::numeric_limits<int>::max()) {
+            throw std::runtime_error(strprintf("-signetslhdsa128s height must be at least 1 and below %d, not %d.", std::numeric_limits<int>::max(), *height));
+        }
+        options.slhdsa128s_height = *height;
+    }
     if (auto tripwire{ReadTripwireArg(args)}) {
         if (!options.challenge) {
             throw std::runtime_error("-signettripwire requires -signetchallenge.");
@@ -264,11 +284,14 @@ const CChainParams &Params() {
 
