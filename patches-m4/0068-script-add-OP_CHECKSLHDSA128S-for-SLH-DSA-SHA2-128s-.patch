+                    // Only executed in P2MR leaves with SCRIPT_VERIFY_P2MR_SLHDSA128S. Elsewhere this byte is
+                    // a bad opcode (legacy, witness v0), or an OP_SUCCESSx ExecuteWitnessScript acts on first.
+                    if (!CheckSLHDSA128SEnabled(sigversion, execdata, flags)) return set_error(serror, SCRIPT_ERR_BAD_OPCODE);
+
+                    // (sig[0] ... sig[15] pk -- bool)
+                    const size_t item_count{SLHDSA128S_SIG_CHUNK_COUNT + 1};
+                    if (stack.size() < item_count) return set_error(serror, SCRIPT_ERR_INVALID_STACK_OPERATION);
+
+                    bool success = true;
+                    if (!EvalCheckSLHDSA128S(std::span{stack}.last(item_count), execdata, checker, sigversion, serror, success)) return false;
+                    for (size_t i = 0; i < item_count; ++i) popstack(stack);
+                    stack.push_back(success ? vchTrue : vchFalse);
+                }
+                break;
+
                 case OP_CHECKMULTISIG:
                 case OP_CHECKMULTISIGVERIFY:
                 {
@@ -1583,8 +1659,9 @@ bool SignatureHashSchnorr(uint256& hash_out, ScriptExecutionData& execdata, cons
