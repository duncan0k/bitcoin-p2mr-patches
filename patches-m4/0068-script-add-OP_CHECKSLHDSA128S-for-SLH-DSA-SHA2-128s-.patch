+bool GenericTransactionSignatureChecker<T>::VerifySLHDSA128SSignature(std::span<const unsigned char, SLHDSA128S_SIGNATURE_SIZE> sig, std::span<const unsigned char, SLHDSA128S_PUBKEY_SIZE> pubkey, const uint256& sighash) const
+{
+    return SLHDSA128SVerify(pubkey, MakeUCharSpan(sighash), MakeUCharSpan(SLHDSA128S_CONTEXT), sig);
+}
