+/** Whether byte 0xf1 executes as OP_CHECKSLHDSA128S: in a P2MR leaf that is executed as
+ *  tapscript, with SCRIPT_VERIFY_P2MR_SLHDSA128S. Everywhere else it keeps its old meaning:
+ *  a bad opcode in legacy and witness v0 scripts, OP_SUCCESS241 in tapscript. */
+static bool CheckSLHDSA128SEnabled(SigVersion sigversion, const ScriptExecutionData& execdata, script_verify_flags flags)
+{
+    return sigversion == SigVersion::TAPSCRIPT && execdata.m_p2mr_leaf && (flags & SCRIPT_VERIFY_P2MR_SLHDSA128S);
+}
+
+/** Helper for OP_CHECKSLHDSA128S (doc/p2mr-slhdsa128s.md). items are the seventeen stack elements
+ *  it consumes from the bottom up: the signature chunks sig[0] .. sig[15], then the public key.
+ *
+ * A return value of false means the script fails entirely. When true is returned, the
+ * success variable indicates whether a signature was given and checked.
+ */
+static bool EvalCheckSLHDSA128S(std::span<const valtype> items, ScriptExecutionData& execdata, const BaseSignatureChecker& checker, SigVersion sigversion, ScriptError* serror, bool& success)
+{
+    assert(sigversion == SigVersion::TAPSCRIPT);
+    assert(items.size() == SLHDSA128S_SIG_CHUNK_COUNT + 1);
+    const auto sig_chunks{items.first(SLHDSA128S_SIG_CHUNK_COUNT)};
+    const valtype& pubkey{items.back()};
+
+    /*
+     *  The following validation sequence is consensus critical, and follows OP_CHECKMLDSA44, which
+     *  follows EvalChecksigTapscript:
+     *    a signature is charged validation weight before anything else is looked at;
+     *    the script execution fails on a public key of the wrong size, even with an empty signature;
+     *    sixteen empty signature chunks are an empty signature, which pushes false;
+     *    the script execution fails when using a non-empty invalid signature.
+     *  Elliptic curve checks failing in tripwired leaves (doc/p2mr-tripwire.md) does not apply here.
+     */
+    success = std::ranges::any_of(sig_chunks, [](const valtype& chunk) { return !chunk.empty(); });
+    if (success) {
+        assert(execdata.m_validation_weight_left_init);
+        execdata.m_validation_weight_left -= VALIDATION_WEIGHT_PER_SLHDSA128S_CHECK;
+        if (execdata.m_validation_weight_left < 0) {
+            return set_error(serror, SCRIPT_ERR_TAPSCRIPT_VALIDATION_WEIGHT);
+        }
+    }
+    if (pubkey.size() != SLHDSA128S_PUBKEY_SIZE) return set_error(serror, SCRIPT_ERR_SLHDSA128S_PUBKEY_SIZE);
+    if (!success) return true;
+    for (size_t i = 0; i < sig_chunks.size(); ++i) {
+        // The last chunk may end in an explicit hash type.
+        const bool last{i + 1 == sig_chunks.size()};
+        const size_t size{sig_chunks[i].size()};
+        if (size != SLHDSA128S_SIG_CHUNK_SIZES[i] && !(last && size == SLHDSA128S_SIG_CHUNK_SIZES[i] + 1)) {
+            return set_error(serror, SCRIPT_ERR_SLHDSA128S_SIG_SIZE);
+        }
+    }
+
+    std::vector<unsigned char> sig;
+    sig.reserve(SLHDSA128S_SIGNATURE_SIZE + 1);
+    for (const valtype& chunk : sig_chunks) sig.insert(sig.end(), chunk.begin(), chunk.end());
+    if (!checker.CheckSLHDSA128SSignature(sig, pubkey, sigversion, execdata, serror)) {
+        return false; // serror is set
+    }
+    return true;
+}
+
 /** Helper for OP_CHECKMLDSA44 (doc/p2mr-mldsa44.md). items are the eight stack elements it
  *  consumes from the bottom up: the signature chunks sig[0] .. sig[4], then the public key
  *  chunks pk[0] .. pk[2].
@@ -1191,6 +1250,23 @@ bool EvalScript(std::vector<std::vector<unsigned char> >& stack, const CScript&
                 }
                 break;
 
+                case OP_CHECKSLHDSA128S:
