+/** OP_CHECKSLHDSA128S (doc/p2mr-slhdsa128s.md) takes the 32-byte SLH-DSA-SHA2-128s public
+ *  key (PK.seed || PK.root) as one stack element, and the 7856-byte signature as sixteen:
+ *  fifteen of 520 bytes, then 56, or 57 with an explicit hash type. Fixed sizes give every
+ *  signature one encoding without raising MAX_SCRIPT_ELEMENT_SIZE. */
+static constexpr size_t SLHDSA128S_SIG_CHUNK_COUNT{16};
+static constexpr std::array<size_t, SLHDSA128S_SIG_CHUNK_COUNT> SLHDSA128S_SIG_CHUNK_SIZES{
