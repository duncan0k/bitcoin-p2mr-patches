+static constexpr uint8_t SLHDSA128S_KEY_VERSION{0x02};
+/** The FIPS 205 context string every OP_CHECKSLHDSA128S signature is made with. */
+static constexpr std::string_view SLHDSA128S_CONTEXT{"P2MR/SLHDSA128S/EXP0"};
+static_assert(SLHDSA128S_CONTEXT.size() == 20);
