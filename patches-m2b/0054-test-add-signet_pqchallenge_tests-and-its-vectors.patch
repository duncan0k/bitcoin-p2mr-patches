+// Copyright (c) 2026 CipherScope
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <test/data/signet_pqchallenge.json.h>
+#include <test/data/signet_pqchallenge_noble.json.h>
+
+#include <chainparams.h>
+#include <common/args.h>
+#include <consensus/merkle.h>
+#include <consensus/params.h>
+#include <consensus/validation.h>
+#include <kernel/chainparams.h>
+#include <primitives/block.h>
+#include <primitives/transaction.h>
+#include <script/script.h>
+#include <serialize.h>
+#include <signet.h>
+#include <streams.h>
+#include <test/util/common.h>
+#include <test/util/json.h>
+#include <test/util/setup_common.h>
+#include <util/chaintype.h>
+#include <util/strencodings.h>
+
+#include <univalue.h>
+
+#include <boost/test/unit_test.hpp>
+
+#include <limits>
+#include <string>
+#include <vector>
+
+namespace {
+std::vector<unsigned char> Hex(const UniValue& field)
+{
+    const auto bytes{TryParseHex<unsigned char>(field.get_str())};
+    BOOST_REQUIRE_MESSAGE(bytes.has_value(), "not hex: " << field.get_str().substr(0, 40));
+    return *bytes;
+}
+
+CBlock ReadBlock(const UniValue& field)
+{
+    CBlock block;
+    SpanReader{Hex(field)} >> TX_WITH_WITNESS(block);
+    return block;
+}
+
+std::unique_ptr<const CChainParams> SigNet(const std::vector<std::pair<std::string, std::string>>& settings)
+{
+    ArgsManager args;
+    for (const auto& [name, value] : settings) args.ForceSetArg(name, value);
+    return CreateChainParams(args, ChainType::SIGNET);
+}
+
+//! A copy of the block whose witness commitment output's script is replaced by script.
+CBlock WithCommitment(const CBlock& block, const CScript& script)
+{
+    CBlock copy{block};
+    CMutableTransaction coinbase{*copy.vtx[0]};
+    coinbase.vout.at(GetWitnessCommitmentIndex(block)).scriptPubKey = script;
+    copy.vtx[0] = MakeTransactionRef(std::move(coinbase));
+    copy.hashMerkleRoot = BlockMerkleRoot(copy);
+    return copy;
+}
+} // namespace
+
+BOOST_FIXTURE_TEST_SUITE(signet_pqchallenge_tests, BasicTestingSetup)
+
+// The challenge and a solution the functional test framework made (test/util/generate_signet_pqchallenge_tests.py).
+BOOST_AUTO_TEST_CASE(vectors)
+{
+    const UniValue file{read_json(json_tests::signet_pqchallenge)};
+    const UniValue& vectors{file[1]};
+    const auto pubkey{Hex(vectors["pubkey"])};
+    const auto challenge{Hex(vectors["challenge"])};
+    BOOST_CHECK_EQUAL(HexStr(SignetPQChallenge(pubkey)), vectors["challenge"].get_str());
+
+    const auto params{SigNet({{"-signetpqchallenge", HexStr(pubkey)}})};
+    const Consensus::Params& consensus{params->GetConsensus()};
+    BOOST_CHECK(consensus.signet_challenge == challenge);
+    BOOST_CHECK(consensus.signet_pq_challenge);
+    BOOST_CHECK_EQUAL(consensus.P2MRMLDSA44Height, 1);
+
+    const CBlock block{ReadBlock(vectors["block"])};
+    BOOST_CHECK(CheckSignetBlockSolution(block, consensus));
+    // The genesis block has no solution and no witness commitment; it is exempt, as on every signet.
+    BOOST_CHECK(CheckSignetBlockSolution(params->GenesisBlock(), consensus));
+    // Signed by another key: another challenge.
+    BOOST_CHECK(!CheckSignetBlockSolution(ReadBlock(vectors["block_other_key"]), consensus));
+    // The configured key's leaf, signed by another key: the tree matches, the signature does not.
+    BOOST_CHECK(!CheckSignetBlockSolution(ReadBlock(vectors["block_other_signer"]), consensus));
+    // An ordinary output after the witness commitment output.
+    const CBlock output_after{ReadBlock(vectors["block_output_after_commitment"])};
+    BOOST_REQUIRE_EQUAL(GetWitnessCommitmentIndex(output_after), 1);
+    BOOST_REQUIRE_EQUAL(output_after.vtx[0]->vout.size(), 3U);
+    BOOST_CHECK(CheckSignetBlockSolution(output_after, consensus));
+
+    // A flipped bit in the first signature chunk.
+    const CScript& script{block.vtx[0]->vout[GetWitnessCommitmentIndex(block)].scriptPubKey};
+    const std::vector<unsigned char> commitment(script.begin(), script.begin() + MINIMUM_WITNESS_COMMITMENT);
+    auto solution{Hex(vectors["solution"])};
+    std::vector<unsigned char> header{0xec, 0xc7, 0xda, 0xa2};
+    const auto with_solution{[&](const std::vector<unsigned char>& sol) {
+        std::vector<unsigned char> data{header};
+        data.insert(data.end(), sol.begin(), sol.end());
+        return WithCommitment(block, CScript(commitment.begin(), commitment.end()) << data);
+    }};
+    BOOST_CHECK(CheckSignetBlockSolution(with_solution(solution), consensus));
+    auto flipped{solution};
+    flipped[10] ^= 1;
+    BOOST_CHECK(!CheckSignetBlockSolution(with_solution(flipped), consensus));
+    // No witness at all: an empty scriptSig and an empty stack.
+    const std::vector<unsigned char> empty{0x00, 0x00};
+    BOOST_CHECK(!CheckSignetBlockSolution(with_solution(empty), consensus));
+    // No solution push, and a non-push opcode instead of it.
+    BOOST_CHECK(!CheckSignetBlockSolution(WithCommitment(block, CScript(commitment.begin(), commitment.end())), consensus));
+    BOOST_CHECK(!CheckSignetBlockSolution(WithCommitment(block, CScript(commitment.begin(), commitment.end()) << OP_1NEGATE), consensus));
+
+    // Nothing but OP_RETURN, the commitment and the solution push, in its shortest encoding.
+    CScript extra{script};
+    extra << OP_0;
+    BOOST_CHECK(!CheckSignetBlockSolution(WithCommitment(block, extra), consensus));
+    CScript second_push{script};
+    second_push << std::vector<unsigned char>{0x01, 0x02};
+    BOOST_CHECK(!CheckSignetBlockSolution(WithCommitment(block, second_push), consensus));
+    std::vector<unsigned char> data{header};
+    data.insert(data.end(), solution.begin(), solution.end());
+    CScript pushdata4(commitment.begin(), commitment.end());
+    pushdata4.push_back(OP_PUSHDATA4);
+    for (int i{0}; i < 4; ++i) pushdata4.push_back((data.size() >> (8 * i)) & 0xff);
+    pushdata4.insert(pushdata4.end(), data.begin(), data.end());
+    BOOST_CHECK(!CheckSignetBlockSolution(WithCommitment(block, pushdata4), consensus));
+
+    // A node given only the same challenge, without -signetpqchallenge, checks the solution with
+    // the old flags: a P2MR program is an unknown witness version, so any solution passes. This is
+    // why every node of such a network needs the option.
+    const auto old_params{SigNet({{"-signetchallenge", HexStr(challenge)}})};
+    BOOST_CHECK(!old_params->GetConsensus().signet_pq_challenge);
+    BOOST_CHECK(CheckSignetBlockSolution(with_solution(empty), old_params->GetConsensus()));
+    BOOST_CHECK(CheckSignetBlockSolution(with_solution(flipped), old_params->GetConsensus()));
+}
+
+BOOST_AUTO_TEST_CASE(option)
+{
+    const UniValue file{read_json(json_tests::signet_pqchallenge)};
+    const UniValue& vectors{file[1]};
+    const std::string key{vectors["pubkey"].get_str()};
+    const std::string challenge{vectors["challenge"].get_str()};
+
+    // The same challenge may be given too.
+    BOOST_CHECK(SigNet({{"-signetpqchallenge", key}, {"-signetchallenge", challenge}})->GetConsensus().signet_pq_challenge);
+
+    const auto fails{[](const std::vector<std::pair<std::string, std::string>>& settings, const std::string& message) {
+        BOOST_CHECK_EXCEPTION(SigNet(settings), std::runtime_error, HasReason{message});
+    }};
+    fails({{"-signetpqchallenge", key.substr(2)}}, "-signetpqchallenge needs a 1312-byte ML-DSA-44 public key in hex.");
+    fails({{"-signetpqchallenge", "zz"}}, "-signetpqchallenge needs a 1312-byte ML-DSA-44 public key in hex.");
+    fails({{"-signetpqchallenge", key}, {"-signetchallenge", "51"}},
+          "-signetpqchallenge makes the challenge " + challenge + ", which differs from -signetchallenge.");
+    fails({{"-signetpqchallenge", key}, {"-signetpqblock", key + "@5"}},
+          "-signetpqblock cannot be combined with -signetpqchallenge, whose blocks are signed with ML-DSA-44 already.");
+
+    // Without the option nothing changes: not for another challenge, the public signet or Ark-0.
+    const auto other{SigNet({{"-signetchallenge", "51"}})};
+    BOOST_CHECK(!other->GetConsensus().signet_pq_challenge);
+    BOOST_CHECK_EQUAL(other->GetConsensus().P2MRMLDSA44Height, std::numeric_limits<int>::max());
+    BOOST_CHECK(!SigNet({})->GetConsensus().signet_pq_challenge);
+    const auto ark0{SigNet({{"-signetchallenge", "5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae"}})};
+    BOOST_CHECK(!ark0->GetConsensus().signet_pq_challenge);
+    BOOST_CHECK_EQUAL(ark0->GetConsensus().P2MRMLDSA44Height, ARK0_MLDSA44_HEIGHT);
+}
+
+// A block whose solution another implementation made: p2mr-ts, which computed the signature
+// message on its own and signed it with @noble/post-quantum, hedged.
+BOOST_AUTO_TEST_CASE(other_implementation)
+{
+    const UniValue file{read_json(json_tests::signet_pqchallenge_noble)};
+    const UniValue& vectors{file[1]};
+    const UniValue own_file{read_json(json_tests::signet_pqchallenge)};
+    BOOST_REQUIRE_EQUAL(vectors["pubkey"].get_str(), own_file[1]["pubkey"].get_str());
+    const auto params{SigNet({{"-signetpqchallenge", vectors["pubkey"].get_str()}})};
+    const CBlock block{ReadBlock(vectors["block"])};
+    BOOST_CHECK(CheckSignetBlockSolution(block, params->GetConsensus()));
+    BOOST_CHECK(block.vtx[0]->vout != ReadBlock(own_file[1]["block"]).vtx[0]->vout);
+}
+
+BOOST_AUTO_TEST_SUITE_END()
