 an ML-DSA-44 block signature in the witness commitment output of every block,
@@ -20,8 +27,18 @@ import hashlib
 
 from .blocktools import SIGNET_HEADER, WITNESS_COMMITMENT_HEADER
 from .key import TaggedHash
-from .messages import CTransaction, CTxOut, ser_uint256
-from .p2mr_mldsa44 import MLDSA44_SIGNATURE_SIZE, mldsa44_keygen, mldsa44_sign, mldsa44_verify
+from .messages import COutPoint, CTransaction, CTxIn, CTxOut, ser_string, ser_string_vector, ser_uint256
+from .p2mr import p2mr_construct
+from .p2mr_mldsa44 import (
+    LEAF_FAIL,
+    MLDSA44_SIGNATURE_SIZE,
+    mldsa44_keygen,
+    mldsa44_leaf,
+    mldsa44_sig_chunks,
+    mldsa44_sighash,
+    mldsa44_sign,
+    mldsa44_verify,
+)
 from .script import CScript, CScriptOp, OP_RETURN
 
 SIGNET_PQ_HEADER = b"PQB1"
@@ -136,3 +153,58 @@ def add_signet_solution(block, solution):
                                              + CScriptOp.encode_op_pushdata(SIGNET_HEADER + bytes(solution)))
     block.hashMerkleRoot = block.calc_merkle_root()
 
+
+# -signetpqchallenge
+
+def signet_pq_challenge_tree(pubkey):
+    """The P2MR output a -signetpqchallenge key makes: its OP_CHECKMLDSA44 leaf next to a leaf that
+    can only fail, both at depth one."""
+    return p2mr_construct([("pq", mldsa44_leaf(pubkey)), ("fail", LEAF_FAIL)])
+
+
+def signet_pq_challenge(pubkey):
+    """The signet challenge -signetpqchallenge=<pubkey> sets."""
+    return bytes(signet_pq_challenge_tree(pubkey).scriptPubKey)
+
+
+def signet_txs(block, challenge):
+    """The two virtual transactions of BIP 325 for a block that carries no signet solution yet:
+    (to_sign, to_spend). As contrib/signet/miner computes them, except that the witness commitment
+    output is the one Core takes, not simply the last output."""
+    index = witness_commitment_index(block)
+    assert index is not None, "block has no witness commitment"
+    txs = block.vtx[:]
+    txs[0] = CTransaction(txs[0])
+    txs[0].vout[index].scriptPubKey = bytes(txs[0].vout[index].scriptPubKey) + CScriptOp.encode_op_pushdata(SIGNET_HEADER)
+    merkle = block.get_merkle_root([ser_uint256(tx.txid_int) for tx in txs])
+    data = (block.nVersion.to_bytes(4, "little", signed=True)
+            + ser_uint256(block.hashPrevBlock)
+            + ser_uint256(merkle)
+            + block.nTime.to_bytes(4, "little"))
+    to_spend = CTransaction()
+    to_spend.version = 0
+    to_spend.nLockTime = 0
+    to_spend.vin = [CTxIn(COutPoint(0, 0xFFFFFFFF), b"\x00" + CScriptOp.encode_op_pushdata(data), 0)]
+    to_spend.vout = [CTxOut(0, bytes(challenge))]
+    to_sign = CTransaction()
+    to_sign.version = 0
+    to_sign.nLockTime = 0
+    to_sign.vin = [CTxIn(COutPoint(to_spend.txid_int, 0), b"", 0)]
+    to_sign.vout = [CTxOut(0, bytes([OP_RETURN]))]
+    return to_sign, to_spend
+
+
+def signet_p2mr_witness(block, pubkey, seckey, *, rnd=None):
+    """The witness stack that spends a -signetpqchallenge challenge for a block: the five signature
+    chunks, the OP_CHECKMLDSA44 leaf and its control block. rnd None signs deterministically."""
+    tree = signet_pq_challenge_tree(pubkey)
+    leaf = tree.leaves["pq"]
+    to_sign, to_spend = signet_txs(block, tree.scriptPubKey)
+    message = mldsa44_sighash(to_sign, [to_spend.vout[0]], 0, leaf.script)
+    signature = mldsa44_sign(seckey, message, rnd=rnd)
+    return mldsa44_sig_chunks(signature) + [bytes(leaf.script), leaf.control_block]
+
+
+def signet_p2mr_solution(block, pubkey, seckey, *, rnd=None):
+    """The serialized signet solution (an empty scriptSig and that witness stack) for a block."""
+    return ser_string(b"") + ser_string_vector(signet_p2mr_witness(block, pubkey, seckey, rnd=rnd))
