+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Generate src/test/data/signet_pqchallenge.json, the vectors of signet_pqchallenge_tests.cpp (doc/signet-pqchallenge.md).
+
+The challenge -signetpqchallenge sets for a test key, and a block whose signet
+solution spends it: five ML-DSA-44 signature chunks over the BIP 325 virtual
+transaction, the OP_CHECKMLDSA44 leaf and its control block. The signature is
+real and deterministic (FIPS 204 with rnd = 0); the key comes from a public
+seed and is for tests only.
+
+Usage, from the repository root:
+
+    ./test/util/generate_signet_pqchallenge_tests.py            # print the JSON
+    ./test/util/generate_signet_pqchallenge_tests.py --inplace  # write the file
+"""
+
+import argparse
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "functional"))
+
+from test_framework.blocktools import add_witness_commitment, create_coinbase  # noqa: E402
+from test_framework.messages import CBlock, COutPoint, CTransaction, CTxIn, CTxOut  # noqa: E402
+from test_framework.script import CScript, OP_TRUE  # noqa: E402
+from test_framework.signet_pq import (  # noqa: E402
+    add_signet_solution,
+    signet_p2mr_solution,
+    signet_pq_challenge,
+    signet_pq_keygen,
+)
+
+PUBKEY, SECKEY = signet_pq_keygen(bytes([0x33] * 32))
+OTHER_PUBKEY, OTHER_SECKEY = signet_pq_keygen(bytes([0x44] * 32))
+
+
+def make_block(height):
+    block = CBlock()
+    block.nVersion = 0x20000000
+    block.hashPrevBlock = 0xcd
+    block.nTime = 1790000000
+    block.nBits = 0x1e0377ae
+    block.nNonce = 0
+    other = CTransaction()
+    other.vin = [CTxIn(COutPoint(0x5678, 0), b"")]
+    other.vout = [CTxOut(1000, CScript([OP_TRUE]))]
+    block.vtx = [create_coinbase(height, script_pubkey=CScript([OP_TRUE])), other]
+    add_witness_commitment(block)
+    return block
+
+
+def vectors():
+    block = make_block(20)
+    solution = signet_p2mr_solution(block, PUBKEY, SECKEY)
+    add_signet_solution(block, solution)
+    other = make_block(20)
+    add_signet_solution(other, signet_p2mr_solution(other, OTHER_PUBKEY, OTHER_SECKEY))
+    # The configured key's leaf and control block with another key's signature: the tree
+    # matches the challenge, the signature does not.
+    other_signer = make_block(20)
+    add_signet_solution(other_signer, signet_p2mr_solution(other_signer, PUBKEY, OTHER_SECKEY))
+    # An ordinary output after the witness commitment output: the solution goes into the
+    # commitment output all the same, and signs over it.
+    output_after = make_block(20)
+    output_after.vtx[0].vout.append(CTxOut(0, CScript([OP_TRUE])))
+    output_after.hashMerkleRoot = output_after.calc_merkle_root()
+    add_signet_solution(output_after, signet_p2mr_solution(output_after, PUBKEY, SECKEY))
+    return [
+        "Signet ML-DSA-44 challenge vectors, generated by test/util/generate_signet_pqchallenge_tests.py",
+        {
+            "pubkey": PUBKEY.hex(),
+            "challenge": signet_pq_challenge(PUBKEY).hex(),
+            "block": block.serialize().hex(),
+            "solution": solution.hex(),
+            "block_other_key": other.serialize().hex(),
+            "block_other_signer": other_signer.serialize().hex(),
+            "block_output_after_commitment": output_after.serialize().hex(),
+        },
+    ]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--inplace", action="store_true", help="write src/test/data/signet_pqchallenge.json")
+    args = parser.parse_args()
+    data = vectors()
+    if args.inplace:
+        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "src", "test", "data", "signet_pqchallenge.json")
+        with open(path, "w", encoding="utf-8", newline="\n") as f:
+            json.dump(data, f, indent=1)
+            f.write("\n")
+    else:
+        print(json.dumps(data, indent=1))
+
+
+if __name__ == "__main__":
+    main()
