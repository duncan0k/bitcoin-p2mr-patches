+//! The flags for a challenge that is an ML-DSA-44 key's P2MR output (doc/signet-pqchallenge.md).
+static constexpr script_verify_flags PQ_CHALLENGE_SCRIPT_VERIFY_FLAGS = BLOCK_SCRIPT_VERIFY_FLAGS | SCRIPT_VERIFY_P2MR | SCRIPT_VERIFY_P2MR_MLDSA44;
 
 static bool FetchAndClearCommitmentSection(const std::span<const uint8_t> header, CScript& witness_commitment, std::vector<uint8_t>& result)
 {
@@ -129,6 +131,24 @@ std::optional<SignetTxs> SignetTxs::Create(const CBlock& block, const CScript& c
     return SignetTxs{tx_to_spend, tx_spending};
 }
 
+/**
+ * Whether the block's witness commitment output is exactly OP_RETURN, the commitment and one
+ * signet solution push (the header and some data) in its shortest encoding.
+ */
+static bool IsExactSolutionCommitment(const CBlock& block)
+{
+    const int cidx{GetWitnessCommitmentIndex(block)};
+    if (cidx == NO_WITNESS_COMMITMENT) return false;
+    const CScript& script{block.vtx[0]->vout[cidx].scriptPubKey};
+    // CheckMinimalPush asserts a push opcode, so every other opcode is turned away before it.
+    CScript::const_iterator pc{script.begin() + MINIMUM_WITNESS_COMMITMENT};
+    opcodetype opcode;
+    std::vector<unsigned char> data;
+    if (!script.GetOp(pc, opcode, data) || opcode > OP_PUSHDATA4 || !CheckMinimalPush(data, opcode)) return false;
+    if (data.size() <= sizeof(SIGNET_HEADER) || !std::equal(std::begin(SIGNET_HEADER), std::end(SIGNET_HEADER), data.begin())) return false;
+    return pc == script.end();
+}
