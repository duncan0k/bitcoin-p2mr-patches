+std::vector<uint8_t> SignetPQChallenge(std::span<const uint8_t> pubkey)
+{
+    assert(pubkey.size() == MLDSA44_PUBKEY_SIZE);
+    // <pk[0]> <pk[1]> <pk[2]> OP_CHECKMLDSA44, with the key cut into 520, 520 and 272 bytes
+    // (doc/p2mr-mldsa44.md), next to OP_RETURN.
+    const CScript pq_leaf{CScript() << std::vector<uint8_t>(pubkey.begin(), pubkey.begin() + 520)
+                                    << std::vector<uint8_t>(pubkey.begin() + 520, pubkey.begin() + 1040)
+                                    << std::vector<uint8_t>(pubkey.begin() + 1040, pubkey.end())
+                                    << OP_CHECKMLDSA44};
+    const CScript fail_leaf{CScript() << OP_RETURN};
+    const uint256 root{ComputeTapbranchHash(ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, pq_leaf),
+                                            ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, fail_leaf))};
+    const CScript challenge{CScript() << OP_2 << std::vector<uint8_t>(root.begin(), root.end())};
+    return {challenge.begin(), challenge.end()};
+}
+
 static CBlock CreateGenesisBlock(const char* pszTimestamp, const CScript& genesisOutputScript, uint32_t nTime, uint32_t nNonce, uint32_t nBits, int32_t nVersion, const CAmount& genesisReward)
 {
     CMutableTransaction txNew;
@@ -505,6 +521,17 @@ public:
         // OP_CHECKMLDSA44 in P2MR leaves (doc/p2mr-mldsa44.md) only activates on the Ark-0 signet,
         // from the height this code fixes for that network. There is no option for it.
         consensus.P2MRMLDSA44Height = std::ranges::equal(bin, ARK0_SIGNET_CHALLENGE) ? ARK0_MLDSA44_HEIGHT : std::numeric_limits<int>::max();
+        // A signet whose challenge is an ML-DSA-44 key's (doc/signet-pqchallenge.md) checks its
+        // solution with OP_CHECKMLDSA44, and runs the opcode in transactions from height 1 too.
+        // ReadSigNetArgs only sets it together with that challenge.
+        if (options.pq_challenge_pubkey) {
+            // Only the challenge the key makes: a P2MR challenge taken as given could be a single
+            // leaf, which is spent without running it.
+            assert(options.challenge && *options.challenge == SignetPQChallenge(*options.pq_challenge_pubkey));
+            consensus.signet_pq_challenge = true;
+            consensus.P2MRMLDSA44Height = 1;
+            LogInfo("Signet blocks are signed with ML-DSA-44: the challenge is a P2MR output of an ML-DSA-44 key");
+        }
         consensus.nPowTargetTimespan = 14 * 24 * 60 * 60; // two weeks
         consensus.nPowTargetSpacing = 10 * 60;
         // A different target spacing for the retargets from a height on.
