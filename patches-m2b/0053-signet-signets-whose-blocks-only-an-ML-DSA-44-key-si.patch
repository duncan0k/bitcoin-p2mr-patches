+    if (consensusParams.signet_pq_challenge && !IsExactSolutionCommitment(block)) {
+        LogDebug(BCLog::VALIDATION, "CheckSignetBlockSolution: Errors in block (witness commitment output not in the required form)\n");
+        return false;
