+# MEASUREMENT ONLY (contrib/m4-measure, measurement-build.patch): the measurement variant of the
+# library, for the measurement configuration's executables (bench_bitcoin, bitcoind_m4_measure) only.
+# It is built from a copy that CMake generates here from the unmodified vendored slh_dsa.c, with the
+# worst-case hook (switch slh_measure_worst) inserted by exact replacements that must each match once.
+# In the counting build (SLH_MEASURE_COUNT, one script thread, never timed) it also counts complete
+# verifications and, in a copy of sha2_256.c, SHA-256 compressions; the builds that are timed have no
+# counters. bitcoin_slhdsa128s itself still compiles the vendored files as they are, so no compile flag
+# (-DSLH_MEASURE_WORST in APPEND_CFLAGS, say) puts the hook into it.
+if(SLH_MEASURE_WORST)
+  set(slh_measure_dir ${CMAKE_CURRENT_BINARY_DIR}/slhdsa128s_measure)
+  # The generated copies follow the vendored files: CMake configures again when one changes, and the
+  # files must be the ones the hook was written for. Any other content stops the configuration, so that
+  # an update of the vendored library forces a review of the hook and of these hashes.
+  set(slh_measure_pinned
+    slh_dsa.c  fbbf5c4ed4ea70bf9d90c1de4ddb168d5671e94621a708f110f57a81de0a5613
+    sha2_256.c b1b74abe3d4b6b925ca4ce3ded43a5f2188f0f16a41f8ae91c93de95fc0fa07b
+  )
+  while(slh_measure_pinned)
+    list(POP_FRONT slh_measure_pinned file expected)
+    set(path ${CMAKE_CURRENT_SOURCE_DIR}/slhdsa128s/${file})
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${path})
+    file(SHA256 ${path} actual)
+    if(NOT actual STREQUAL expected)
+      message(FATAL_ERROR "measurement build: the vendored ${file} is not the one the measurement hook was written for (SHA-256 ${actual}, expected ${expected}). Review the hook in measurement-build.patch against the new file, then update the pinned hash.")
+    endif()
