diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6109639..9a4cf1d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -184,6 +184,72 @@ endif()
 option(BUILD_BENCH "Build bench_bitcoin executable." OFF)
 option(BUILD_FUZZ_BINARY "Build fuzz binary." OFF)
 option(BUILD_FOR_FUZZING "Build for fuzzing. Enabling this will disable all other targets and override BUILD_FUZZ_BINARY." OFF)
+# MEASUREMENT ONLY (contrib/m4-measure): the worst-case hook of the vendored SLH-DSA code, and a choice
+# of SHA-256 in bench_bitcoin. Every executable or shared library linking the consensus code would get
+# the hook, so this configuration may define no such target but bench_bitcoin and, with
+# SLH_MEASURE_NODE, the measurement-only node bitcoind_m4_measure, which has no install rule; and
+# `cmake --install` fails. The check looks at the
+# targets themselves, not at options: deferred to the end of the top-level CMakeLists.txt
+# (cmake_language(DEFER)), it queues itself again while other deferred calls of that directory are
+# pending, so that it runs last, after any of them could still define a target; then it walks every
+# directory's BUILDSYSTEM_TARGETS and stops on any EXECUTABLE, SHARED_LIBRARY or MODULE_LIBRARY other
+# than those two, whichever option created it.
+option(SLH_MEASURE_WORST "Measurement build of contrib/m4-measure (bench_bitcoin only, never a node)." OFF)
+option(SLH_MEASURE_NODE "With SLH_MEASURE_WORST: the measurement-only node bitcoind_m4_measure of the whole-block script." OFF)
+if(SLH_MEASURE_NODE AND NOT SLH_MEASURE_WORST)
+  message(FATAL_ERROR "SLH_MEASURE_NODE needs SLH_MEASURE_WORST.")
+endif()
+if(SLH_MEASURE_WORST)
+  if(NOT BUILD_BENCH AND NOT SLH_MEASURE_NODE)
+    message(FATAL_ERROR "SLH_MEASURE_WORST needs -DBUILD_BENCH=ON or -DSLH_MEASURE_NODE=ON.")
+  endif()
+  # Nothing of a measurement build may be installed or packaged.
+  install(CODE "message(FATAL_ERROR \"A SLH_MEASURE_WORST build (contrib/m4-measure) cannot be installed.\")")
+  function(slh_measure_collect_targets dir out)
+    set(found)
+    get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
+    foreach(target IN LISTS targets)
+      get_target_property(type ${target} TYPE)
+      if(type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$" AND NOT target IN_LIST SLH_MEASURE_ALLOWED_TARGETS)
+        list(APPEND found ${target})
+      endif()
+    endforeach()
+    get_property(subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
+    foreach(subdir IN LISTS subdirs)
+      slh_measure_collect_targets("${subdir}" sub_found)
+      list(APPEND found ${sub_found})
+    endforeach()
+    set(${out} ${found} PARENT_SCOPE)
+  endfunction()
+  function(slh_measure_check_targets)
+    cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" GET_CALL_IDS pending)
+    if(pending)
+      get_property(rounds GLOBAL PROPERTY SLH_MEASURE_CHECK_ROUNDS)
+      if(NOT rounds)
+        set(rounds 0)
+      endif()
+      math(EXPR rounds "${rounds} + 1")
+      if(rounds GREATER 100)
+        message(FATAL_ERROR "SLH_MEASURE_WORST: the target check could not run after the other deferred calls.")
+      endif()
+      set_property(GLOBAL PROPERTY SLH_MEASURE_CHECK_ROUNDS ${rounds})
+      cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" CALL slh_measure_check_targets)
+      return()
+    endif()
+    slh_measure_collect_targets("${PROJECT_SOURCE_DIR}" others)
+    if(others)
+      list(JOIN others ", " others)
+      message(FATAL_ERROR "SLH_MEASURE_WORST builds bench_bitcoin (and bitcoind_m4_measure) only, but this configuration also defines: ${others}. Turn their options off (contrib/m4-measure/build.sh does).")
+    endif()
+    if(BUILD_BENCH AND NOT TARGET bench_bitcoin)
+      message(FATAL_ERROR "SLH_MEASURE_WORST: no bench_bitcoin target.")
+    endif()
+  endfunction()
+  # bench_bitcoin, and with SLH_MEASURE_NODE the measurement-only node; nothing else.
+  set(SLH_MEASURE_ALLOWED_TARGETS bench_bitcoin bitcoind_m4_measure)
+  cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" CALL slh_measure_check_targets)
+  add_compile_definitions(SLH_MEASURE_WORST)
+endif()
 
 option(INSTALL_MAN "Install man pages." ON)
 
@@ -427,7 +493,8 @@ endif()
 include(AddBoostIfNeeded)
 add_boost_if_needed()
 
-if(BUILD_DAEMON OR BUILD_GUI OR BUILD_CLI OR BUILD_TESTS OR BUILD_BENCH OR BUILD_FUZZ_BINARY)
+# MEASUREMENT ONLY (contrib/m4-measure): bitcoind_m4_measure needs libevent too.
+if(BUILD_DAEMON OR BUILD_GUI OR BUILD_CLI OR BUILD_TESTS OR BUILD_BENCH OR BUILD_FUZZ_BINARY OR SLH_MEASURE_NODE)
   find_package(Libevent 2.1.8 MODULE REQUIRED)
 endif()
 
