diff --git a/src/bench/m4_samples.h b/src/bench/m4_samples.h
new file mode 100644
index 0000000..9add331
--- /dev/null
+++ b/src/bench/m4_samples.h
@@ -0,0 +1,82 @@
+// Copyright (c) 2026 duncan0k
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_BENCH_M4_SAMPLES_H
+#define BITCOIN_BENCH_M4_SAMPLES_H
+
+// Measurement build only (contrib/m4-measure): the wall time and the thread CPU time of every single
+// check of a whole-path benchmark, written to <SLH_SAMPLES_DIR>/<name>.csv when the benchmark ends,
+// if that variable is set. The CPU time (CLOCK_THREAD_CPUTIME_ID) leaves out the time the thread did
+// not run, so a sample whose wall time exceeds it was preempted or stalled by the host.
+
+#ifndef SLH_MEASURE_WORST
+#error "bench/m4_samples.h is for the measurement build only"
+#endif
+
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <ctime>
+#include <string>
+#include <vector>
+
+class M4Samples
+{
+    std::string m_name;
+    std::vector<int64_t> m_wall, m_cpu;
+    int64_t m_wall0{0}, m_cpu0{0};
+    bool m_on{false};
+
+    static int64_t Cpu()
+    {
+        timespec ts;
+        clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts);
+        return int64_t{ts.tv_sec} * 1'000'000'000 + ts.tv_nsec;
+    }
+    static int64_t Wall()
+    {
+        return std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+public:
+    M4Samples(std::string name, bool measuring) : m_name{std::move(name)}, m_on{measuring && std::getenv("SLH_SAMPLES_DIR") != nullptr}
+    {
+        if (m_on) {
+            m_wall.reserve(20'000);
+            m_cpu.reserve(20'000);
+        }
+    }
+    void Start()
+    {
+        if (!m_on) return;
+        m_cpu0 = Cpu();
+        m_wall0 = Wall();
+    }
+    void Stop()
+    {
+        if (!m_on) return;
+        const int64_t wall{Wall()};
+        const int64_t cpu{Cpu()};
+        m_wall.push_back(wall - m_wall0);
+        m_cpu.push_back(cpu - m_cpu0);
+    }
+    ~M4Samples()
+    {
+        if (!m_on) return;
+        const std::string path{std::string{std::getenv("SLH_SAMPLES_DIR")} + "/" + m_name + ".csv"};
+        if (FILE* f{std::fopen(path.c_str(), "w")}) {
+            std::fprintf(f, "wall_ns,cpu_ns\n");
+            for (size_t i = 0; i < m_wall.size(); ++i) {
+                std::fprintf(f, "%lld,%lld\n", static_cast<long long>(m_wall[i]), static_cast<long long>(m_cpu[i]));
+            }
+            std::fclose(f);
+        } else {
+            std::fprintf(stderr, "cannot write %s\n", path.c_str());
+            std::abort();
+        }
+    }
+};
+
+#endif // BITCOIN_BENCH_M4_SAMPLES_H
