+
+/// MEASUREMENT ONLY (contrib/m4r-measure of the node, measurement-build.patch; compiled only with
+/// `--cfg m4r_measure`, which the M4R_MEASURE configuration alone passes): `available()` also says no
+/// while M4R_PORTABLE is set, so that every product takes the portable path, as on a CPU without
+/// PCLMULQDQ.
+#[cfg(m4r_measure)]
+#[inline]
+pub fn available() -> bool {
+    !M4R_PORTABLE.load(core::sync::atomic::Ordering::Relaxed) && cpu_has_clmul()
+}
+
+/// MEASUREMENT ONLY: whether the running CPU itself has PCLMULQDQ and SSE2, whatever M4R_PORTABLE says.
+#[cfg(m4r_measure)]
+#[inline]
+pub fn cpu_has_clmul() -> bool {
+    std::arch::is_x86_feature_detected!("pclmulqdq") && std::arch::is_x86_feature_detected!("sse2")
+}
+
+/// MEASUREMENT ONLY: when set, `available()` says no.
