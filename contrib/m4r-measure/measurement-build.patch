diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6109639..62f2522 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -184,6 +184,61 @@ endif()
 option(BUILD_BENCH "Build bench_bitcoin executable." OFF)
 option(BUILD_FUZZ_BINARY "Build fuzz binary." OFF)
 option(BUILD_FOR_FUZZING "Build for fuzzing. Enabling this will disable all other targets and override BUILD_FUZZ_BINARY." OFF)
+# MEASUREMENT ONLY (contrib/m4r-measure): the measurement-only node bitcoind_m4r_measure of the
+# whole-block gate of the P2MR rescue lane, with the worst-case hook of the rescue verifier (M4R_WORST),
+# the switch to its portable GF(2^128) multiplication (M4R_PORTABLE) and verification counters. This
+# configuration may define no executable or shared library target but bitcoind_m4r_measure, which has
+# no install rule, and `cmake --install` fails. The check looks at the targets themselves, not at
+# options: deferred to the end of the top-level CMakeLists.txt (cmake_language(DEFER)), it queues itself
+# again while other deferred calls of that directory are pending, so that it runs last; then it walks
+# every directory's BUILDSYSTEM_TARGETS and stops on any EXECUTABLE, SHARED_LIBRARY or MODULE_LIBRARY
+# other than that one, whichever option created it.
+option(M4R_MEASURE "Measurement build of contrib/m4r-measure (bitcoind_m4r_measure only, never a node)." OFF)
+if(M4R_MEASURE)
+  install(CODE "message(FATAL_ERROR \"A M4R_MEASURE build (contrib/m4r-measure) cannot be installed.\")" ALL_COMPONENTS)
+  function(m4r_measure_collect_targets dir out)
+    set(found)
+    get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
+    foreach(target IN LISTS targets)
+      get_target_property(type ${target} TYPE)
+      if(type MATCHES "^(EXECUTABLE|SHARED_LIBRARY|MODULE_LIBRARY)$" AND NOT target STREQUAL "bitcoind_m4r_measure")
+        list(APPEND found ${target})
+      endif()
+    endforeach()
+    get_property(subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
+    foreach(subdir IN LISTS subdirs)
+      m4r_measure_collect_targets("${subdir}" sub_found)
+      list(APPEND found ${sub_found})
+    endforeach()
+    set(${out} ${found} PARENT_SCOPE)
+  endfunction()
+  function(m4r_measure_check_targets)
+    cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" GET_CALL_IDS pending)
+    if(pending)
+      get_property(rounds GLOBAL PROPERTY M4R_MEASURE_CHECK_ROUNDS)
+      if(NOT rounds)
+        set(rounds 0)
+      endif()
+      math(EXPR rounds "${rounds} + 1")
+      if(rounds GREATER 100)
+        message(FATAL_ERROR "M4R_MEASURE: the target check could not run after the other deferred calls.")
+      endif()
+      set_property(GLOBAL PROPERTY M4R_MEASURE_CHECK_ROUNDS ${rounds})
+      cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" CALL m4r_measure_check_targets)
+      return()
+    endif()
+    m4r_measure_collect_targets("${PROJECT_SOURCE_DIR}" others)
+    if(others)
+      list(JOIN others ", " others)
+      message(FATAL_ERROR "M4R_MEASURE builds bitcoind_m4r_measure only, but this configuration also defines: ${others}. Turn their options off (contrib/m4r-measure/build.sh does).")
+    endif()
+    if(NOT TARGET bitcoind_m4r_measure)
+      message(FATAL_ERROR "M4R_MEASURE: no bitcoind_m4r_measure target.")
+    endif()
+  endfunction()
+  cmake_language(DEFER DIRECTORY "${PROJECT_SOURCE_DIR}" CALL m4r_measure_check_targets)
+  add_compile_definitions(M4R_MEASURE)
+endif()
 
 option(INSTALL_MAN "Install man pages." ON)
 
