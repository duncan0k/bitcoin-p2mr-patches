+uint64_t M4RMeasureWorstVerifications() { return g_worst_verifications.load(std::memory_order_relaxed); }
+#endif
+
 bool VerifyP2MRRescueProof(const P2MRRescueToken& token, std::span<const unsigned char, P2MR_RESCUE_MESSAGE_SIZE> m, std::span<const unsigned char> proof)
 {
     switch (token.sid) {
     case P2MR_RESCUE_STATEMENT_HMAC:
         g_proof_verifications.fetch_add(1, std::memory_order_relaxed);
+#ifdef M4R_MEASURE
+        if (m4r_measure_worst && proof.size() >= 16) {
+            std::vector<unsigned char> worst{proof.begin(), proof.end()};
+            std::fill(worst.end() - 16, worst.end(), 0xff);
