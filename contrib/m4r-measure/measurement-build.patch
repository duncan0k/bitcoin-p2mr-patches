+#[cfg(m4r_measure)]
+#[no_mangle]
+pub extern "C" fn voleith_m4r_set_portable(on: c_int) {
+    #[cfg(any(target_arch = "x86", target_arch = "x86_64"))]
+    crate::clmul::M4R_PORTABLE.store(on != 0, core::sync::atomic::Ordering::Relaxed);
+    #[cfg(not(any(target_arch = "x86", target_arch = "x86_64")))]
+    let _ = on;
+}
+
+/// MEASUREMENT ONLY: whether the products take the portable path (1) or not (0), forced or because the
+/// CPU has no PCLMULQDQ.
+#[cfg(m4r_measure)]
+#[no_mangle]
+pub extern "C" fn voleith_m4r_portable() -> c_int {
+    c_int::from(!crate::gf128::has_clmul())
+}
+
+/// MEASUREMENT ONLY: whether the running CPU has PCLMULQDQ (1) or not (0), whatever the switch says.
+#[cfg(m4r_measure)]
+#[no_mangle]
+pub extern "C" fn voleith_m4r_cpu_clmul() -> c_int {
+    #[cfg(any(target_arch = "x86", target_arch = "x86_64"))]
