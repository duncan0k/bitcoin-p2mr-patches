+    if (!args.GetArgs("-signetpqblock").empty()) {
+        const auto values = args.GetArgs("-signetpqblock");
+        if (values.size() != 1) {
+            throw std::runtime_error("-signetpqblock cannot be multiple values.");
+        }
+        if (!options.challenge) {
+            throw std::runtime_error("-signetpqblock requires -signetchallenge.");
+        }
+        if (IsArk0SignetChallenge(*options.challenge)) {
+            throw std::runtime_error("-signetpqblock cannot be used on the Ark-0 signet, whose rules are fixed in the code.");
+        }
+        const auto& value{values[0]};
+        const auto at{value.find('@')};
+        if (at == std::string::npos) {
+            throw std::runtime_error(strprintf("-signetpqblock must be <pubkey>@<height>, not '%s'.", value));
+        }
+        const auto pubkey{TryParseHex<uint8_t>(value.substr(0, at))};
+        const auto height{ToIntegral<int32_t>(value.substr(at + 1))};
+        if (!pubkey || !height) {
+            throw std::runtime_error(strprintf("-signetpqblock must be <pubkey>@<height>, not '%s'.", value));
+        }
+        if (pubkey->size() != MLDSA44_PUBKEY_SIZE) {
+            throw std::runtime_error(strprintf("-signetpqblock needs a %d-byte ML-DSA-44 public key, not %d bytes.", MLDSA44_PUBKEY_SIZE, pubkey->size()));
+        }
+        if (*height < 1) {
+            throw std::runtime_error(strprintf("-signetpqblock height must be at least 1, not %d.", *height));
+        }
+        options.pq_block.emplace(Consensus::SignetPQBlock{.height = *height, .pubkey = *pubkey});
+    }
 }
 
