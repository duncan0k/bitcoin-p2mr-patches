+
+// ML-DSA-44 block signature (doc/signet-pqblock.md)
+
+//! Context string of the ML-DSA-44 block signature: kept apart from OP_CHECKMLDSA44's.
+static constexpr std::string_view SIGNET_PQ_CONTEXT{"SIGNET/PQBLOCK/EXP0"};
+//! Size of the push that carries it: header, version and signature.
+static constexpr size_t SIGNET_PQ_PUSH_SIZE{SIGNET_PQ_HEADER.size() + 1 + MLDSA44_SIGNATURE_SIZE};
+
+static const HashWriter HASHER_SIGNET_PQ_BLOCK{TaggedHash("SignetPQBlock")};
+
+std::optional<uint256> SignetPQBlockMessage(const CBlock& block, std::span<const uint8_t> challenge)
+{
+    if (block.vtx.empty()) return std::nullopt;
+    const int cidx{GetWitnessCommitmentIndex(block)};
+    if (cidx == NO_WITNESS_COMMITMENT) return std::nullopt;
+
+    // The witness commitment output as the signer saw it: OP_RETURN, the commitment, and the
+    // PQ push cut back to its header and version. The signet solution, added after the ML-DSA-44
+    // signature, is not part of it.
+    CMutableTransaction coinbase{*block.vtx[0]};
+    CScript& script{coinbase.vout.at(cidx).scriptPubKey};
+    std::vector<uint8_t> cut{SIGNET_PQ_HEADER.begin(), SIGNET_PQ_HEADER.end()};
+    cut.push_back(SIGNET_PQ_VERSION);
+    script = CScript(script.begin(), script.begin() + MINIMUM_WITNESS_COMMITMENT) << cut;
+    const uint256 merkle{ComputeModifiedMerkleRoot(coinbase, block)};
+
+    // SHA256 of the raw challenge, without the length prefix a serialized script would have.
+    uint256 challenge_hash;
+    CSHA256().Write(challenge.data(), challenge.size()).Finalize(challenge_hash.begin());
+
+    HashWriter hasher{HASHER_SIGNET_PQ_BLOCK};
+    hasher << challenge_hash << block.nVersion << block.hashPrevBlock << merkle << block.nTime;
+    return hasher.GetSHA256();
+}
+
+/**
+ * The height a block's coinbase starts with (BIP34), if it starts with it in exactly the form
+ * BIP34 requires: the bytes of CScript() << height.
+ */
+static std::optional<int> CoinbaseHeight(const CBlock& block)
+{
+    if (block.vtx.empty() || block.vtx[0]->vin.empty()) return std::nullopt;
+    const CScript& script_sig{block.vtx[0]->vin[0].scriptSig};
+    CScript::const_iterator pc{script_sig.begin()};
+    opcodetype opcode;
+    std::vector<unsigned char> data;
+    if (!script_sig.GetOp(pc, opcode, data)) return std::nullopt;
+    int64_t height;
+    if (opcode == OP_0) {
+        height = 0;
+    } else if (opcode >= OP_1 && opcode <= OP_16) {
+        height = CScript::DecodeOP_N(opcode);
+    } else if (!data.empty() && data.size() <= 4) {
+        try {
+            height = CScriptNum{data, /*fRequireMinimal=*/true, /*nMaxNumSize=*/4}.GetInt64();
+        } catch (const scriptnum_error&) {
+            return std::nullopt;
+        }
+    } else {
+        return std::nullopt;
+    }
+    if (height < 0 || height > std::numeric_limits<int>::max()) return std::nullopt;
+    const CScript expected{CScript() << height};
+    if (!std::equal(expected.begin(), expected.end(), script_sig.begin(), pc)) return std::nullopt;
+    return static_cast<int>(height);
+}
+
+/**
+ * The ML-DSA-44 signature in a witness commitment output of exactly the form
+ * doc/signet-pqblock.md requires: OP_RETURN, the commitment, the PQ push, and at most one signet
+ * solution push after it, every push in its shortest encoding and nothing else. nullopt when the
+ * script has any other form.
+ */
+static std::optional<std::vector<unsigned char>> PQBlockSignature(const CScript& script)
+{
+    // OP_RETURN and the 36-byte commitment push were checked by GetWitnessCommitmentIndex.
+    // CheckMinimalPush asserts a push opcode, so every other opcode is turned away before it.
+    CScript::const_iterator pc{script.begin() + MINIMUM_WITNESS_COMMITMENT};
+    opcodetype opcode;
+    std::vector<unsigned char> data;
+    if (!script.GetOp(pc, opcode, data) || opcode > OP_PUSHDATA4 || !CheckMinimalPush(data, opcode) || data.size() != SIGNET_PQ_PUSH_SIZE) return std::nullopt;
+    if (!std::equal(SIGNET_PQ_HEADER.begin(), SIGNET_PQ_HEADER.end(), data.begin()) || data[SIGNET_PQ_HEADER.size()] != SIGNET_PQ_VERSION) return std::nullopt;
+    std::vector<unsigned char> signature(data.begin() + SIGNET_PQ_HEADER.size() + 1, data.end());
+
+    if (pc != script.end()) {
+        // The signet solution push, which the classical check reads: the header and some data.
+        if (!script.GetOp(pc, opcode, data) || opcode > OP_PUSHDATA4 || !CheckMinimalPush(data, opcode)) return std::nullopt;
+        if (data.size() <= sizeof(SIGNET_HEADER) || !std::equal(std::begin(SIGNET_HEADER), std::end(SIGNET_HEADER), data.begin())) return std::nullopt;
+        if (pc != script.end()) return std::nullopt;
+    }
+    return signature;
+}
+
+bool CheckSignetPQBlock(const CBlock& block, const Consensus::Params& consensusParams)
+{
+    const auto& rule{consensusParams.signet_pq_block};
+    if (!rule || block.GetHash() == consensusParams.hashGenesisBlock) return true;
+
+    // A height that cannot be read counts as reached: such a block also breaks BIP34, which
+    // ContextualCheckBlock enforces, so this can only reject blocks that are invalid anyway.
+    const std::optional<int> height{CoinbaseHeight(block)};
+    const bool enforced{!height || *height >= rule->height};
+    // Below the height nothing is rejected, and the block is only looked at to log whether it
+    // would pass, so that the signatures can be checked before they are enforced.
+    if (!enforced && !LogAcceptCategory(BCLog::VALIDATION, BCLog::Level::Debug)) return true;
+
+    const int cidx{GetWitnessCommitmentIndex(block)};
+    const std::optional<std::vector<unsigned char>> signature{cidx == NO_WITNESS_COMMITMENT ? std::nullopt : PQBlockSignature(block.vtx[0]->vout[cidx].scriptPubKey)};
+    bool valid{false};
+    if (signature) {
+        const std::optional<uint256> message{SignetPQBlockMessage(block, consensusParams.signet_challenge)};
+        valid = message && MLDSA44Verify(std::span<const unsigned char, MLDSA44_PUBKEY_SIZE>{rule->pubkey.data(), MLDSA44_PUBKEY_SIZE},
+                                         std::span<const unsigned char>{message->data(), message->size()},
+                                         MakeUCharSpan(SIGNET_PQ_CONTEXT),
+                                         std::span<const unsigned char, MLDSA44_SIGNATURE_SIZE>{signature->data(), MLDSA44_SIGNATURE_SIZE});
+    }
+    if (!enforced) {
+        LogDebug(BCLog::VALIDATION, "CheckSignetPQBlock: block %s below height %d, ML-DSA-44 block signature %s\n",
+                 block.GetHash().ToString(), rule->height, !signature ? "absent or not in the required form" : valid ? "valid" : "invalid");
+        return true;
+    }
+    if (!signature) {
+        LogDebug(BCLog::VALIDATION, "CheckSignetPQBlock: Errors in block (no ML-DSA-44 block signature in the required form)\n");
+        return false;
+    }
+    if (!valid) {
+        LogDebug(BCLog::VALIDATION, "CheckSignetPQBlock: Errors in block (ML-DSA-44 block signature invalid)\n");
+        return false;
+    }
+    return true;
+}
