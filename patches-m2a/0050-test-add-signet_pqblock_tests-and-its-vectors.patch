+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Generate src/test/data/signet_pqblock.json, the vectors of signet_pqblock_tests.cpp (doc/signet-pqblock.md).
+
+Each case is a block signed with ML-DSA-44 by the functional test framework
+(test_framework/signet_pq.py), together with what the node must compute from
+it: the coinbase the signature covers, the merkle root over it and the 32-byte
+message. The same block with a signet solution push after the PQ push must give
+the same message. The signatures are real and deterministic (FIPS 204 with
+rnd = 0); the keys come from public seeds and are for tests only.
+
+Usage, from the repository root:
+
+    ./test/util/generate_signet_pqblock_tests.py            # print the JSON
+    ./test/util/generate_signet_pqblock_tests.py --inplace  # write the file
+"""
+
+import argparse
+import json
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "functional"))
+
+from test_framework.blocktools import SIGNET_HEADER, add_witness_commitment, create_coinbase  # noqa: E402
+from test_framework.messages import CBlock, COutPoint, CTransaction, CTxIn, CTxOut, ser_uint256  # noqa: E402
+from test_framework.script import CScript, CScriptOp, OP_TRUE  # noqa: E402
+from test_framework.signet_pq import (  # noqa: E402
+    add_signet_pq_signature,
+    signet_pq_coinbase,
+    signet_pq_keygen,
+    signet_pq_merkle_root,
+    signet_pq_message,
+    verify_signet_pq_signature,
+    witness_commitment_index,
+)
+
+CHALLENGE = bytes(CScript([OP_TRUE]))
+PUBKEY, SECKEY = signet_pq_keygen(bytes([0x11] * 32))
+OTHER_PUBKEY, _ = signet_pq_keygen(bytes([0x22] * 32))
+# Heights at which BIP34 puts the height as OP_N and as a push.
+HEIGHTS = (5, 17)
+
+
+def make_block(height):
+    """A block at a height: a coinbase paying OP_TRUE and one other transaction, with a witness
+    commitment and nothing after it."""
+    block = CBlock()
+    block.nVersion = 0x20000000
+    block.hashPrevBlock = 0xab
+    block.nTime = 1790000000
+    block.nBits = 0x1e0377ae
+    block.nNonce = 0
+    other = CTransaction()
+    other.vin = [CTxIn(COutPoint(0x1234, 0), b"")]
+    other.vout = [CTxOut(1000, CScript([OP_TRUE]))]
+    block.vtx = [create_coinbase(height, script_pubkey=CScript([OP_TRUE])), other]
+    add_witness_commitment(block)
+    return block
+
+
+def with_signet_solution(block, solution):
+    copy = CBlock(block)
+    copy.vtx = [CTransaction(tx) for tx in block.vtx]
+    index = witness_commitment_index(copy)
+    copy.vtx[0].vout[index].scriptPubKey = CScript(bytes(copy.vtx[0].vout[index].scriptPubKey)
+                                                   + CScriptOp.encode_op_pushdata(SIGNET_HEADER + solution))
+    copy.hashMerkleRoot = copy.calc_merkle_root()
+    return copy
+
+
+def vectors():
+    cases = []
+    for height in HEIGHTS:
+        block = make_block(height)
+        add_signet_pq_signature(block, SECKEY, CHALLENGE)
+        assert verify_signet_pq_signature(block, PUBKEY, CHALLENGE)
+        message = signet_pq_message(block, CHALLENGE)
+        # An empty scriptSig and an empty witness: what an OP_TRUE challenge accepts.
+        solved = with_signet_solution(block, b"\x00\x00")
+        assert signet_pq_message(solved, CHALLENGE) == message
+        cases.append({
+            "height": height,
+            "block": block.serialize().hex(),
+            "block_with_solution": solved.serialize().hex(),
+            "pq_coinbase": signet_pq_coinbase(block).serialize_without_witness().hex(),
+            "pq_merkle": ser_uint256(signet_pq_merkle_root(block)).hex(),
+            "message": message.hex(),
+        })
+    return [
+        "Signet ML-DSA-44 block signature vectors, generated by test/util/generate_signet_pqblock_tests.py",
+        {
+            "challenge": CHALLENGE.hex(),
+            "pubkey": PUBKEY.hex(),
+            "other_pubkey": OTHER_PUBKEY.hex(),
+            "cases": cases,
+        },
+    ]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--inplace", action="store_true", help="write src/test/data/signet_pqblock.json")
+    args = parser.parse_args()
+    data = vectors()
+    if args.inplace:
+        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "src", "test", "data", "signet_pqblock.json")
+        with open(path, "w", encoding="utf-8", newline="\n") as f:
+            json.dump(data, f, indent=1)
+            f.write("\n")
+    else:
+        print(json.dumps(data, indent=1))
+
+
+if __name__ == "__main__":
+    main()
