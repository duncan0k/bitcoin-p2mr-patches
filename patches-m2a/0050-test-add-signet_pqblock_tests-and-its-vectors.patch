+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Signet blocks signed with ML-DSA-44 (doc/signet-pqblock.md).
+
+A signet given -signetpqblock=<pubkey>@<height> requires, from that height on,
+an ML-DSA-44 block signature in the witness commitment output of every block,
+next to the signet solution. Its witness commitment output must then be exactly
+
+    OP_RETURN <commitment> <PQ push> [<signet solution push>]
+
+with every push in its shortest encoding. The PQ push is SIGNET_PQ_HEADER,
+SIGNET_PQ_VERSION and the 2420-byte signature. These helpers build that push
+the way a block producer does: after the witness commitment and before the
+signet solution, which then signs over it.
+"""
+
+import hashlib
+
+from .blocktools import SIGNET_HEADER, WITNESS_COMMITMENT_HEADER
+from .key import TaggedHash
+from .messages import CTransaction, CTxOut, ser_uint256
+from .p2mr_mldsa44 import MLDSA44_SIGNATURE_SIZE, mldsa44_keygen, mldsa44_sign, mldsa44_verify
+from .script import CScript, CScriptOp, OP_RETURN
+
+SIGNET_PQ_HEADER = b"PQB1"
+SIGNET_PQ_VERSION = 0x01
+SIGNET_PQ_CONTEXT = b"SIGNET/PQBLOCK/EXP0"
+# The PQ push: header, version and signature.
+SIGNET_PQ_PUSH_SIZE = len(SIGNET_PQ_HEADER) + 1 + MLDSA44_SIGNATURE_SIZE
+# OP_RETURN, the push opcode of the commitment and the 36-byte commitment.
+WITNESS_COMMITMENT_SIZE = 38
+
+
+def signet_pq_keygen(seed):
+    """ML-DSA-44 block signing key pair (public key, secret key) from a 32-byte seed."""
+    return mldsa44_keygen(seed)
+
+
+def witness_commitment_index(block):
+    """Index of the coinbase output Core takes as the witness commitment: the last one that
+    starts with OP_RETURN and the 36-byte commitment push. None when there is none."""
+    prefix = bytes([OP_RETURN, 0x24]) + WITNESS_COMMITMENT_HEADER
+    index = None
+    for i, out in enumerate(block.vtx[0].vout):
+        script = bytes(out.scriptPubKey)
+        if len(script) >= WITNESS_COMMITMENT_SIZE and script[:6] == prefix:
+            index = i
+    return index
+
+
+def signet_pq_coinbase(block):
+    """The coinbase the ML-DSA-44 block signature covers: its witness commitment output cut back
+    to OP_RETURN, the commitment and a push of the header and version."""
+    index = witness_commitment_index(block)
+    assert index is not None, "block has no witness commitment"
+    coinbase = CTransaction(block.vtx[0])
+    script = bytes(coinbase.vout[index].scriptPubKey)
+    cut = SIGNET_PQ_HEADER + bytes([SIGNET_PQ_VERSION])
+    coinbase.vout[index] = CTxOut(coinbase.vout[index].nValue,
+                                  CScript(script[:WITNESS_COMMITMENT_SIZE] + CScriptOp.encode_op_pushdata(cut)))
+    return coinbase
+
+
+def signet_pq_merkle_root(block):
+    """The merkle root over that coinbase and the block's other transactions (an int, as
+    CBlock.hashMerkleRoot)."""
+    hashes = [ser_uint256(signet_pq_coinbase(block).txid_int)] + [ser_uint256(tx.txid_int) for tx in block.vtx[1:]]
+    return block.get_merkle_root(hashes)
+
+
+def signet_pq_message(block, challenge):
+    """The 32-byte message of the block's ML-DSA-44 block signature: everything in the block but
+    the PQ push and the signet solution push counts as it is."""
+    merkle = signet_pq_merkle_root(block)
+    data = (hashlib.sha256(bytes(challenge)).digest()
+            + block.nVersion.to_bytes(4, "little", signed=True)
+            + ser_uint256(block.hashPrevBlock)
+            + ser_uint256(merkle)
+            + block.nTime.to_bytes(4, "little"))
+    return TaggedHash("SignetPQBlock", data)
+
+
+def signet_pq_push(signature, *, version=SIGNET_PQ_VERSION):
+    """The data of the PQ push for a signature."""
+    return SIGNET_PQ_HEADER + bytes([version]) + bytes(signature)
+
+
+def add_signet_pq_signature(block, seckey, challenge, *, rnd=None):
+    """Sign the block with ML-DSA-44 and append the PQ push to its witness commitment output.
+
+    The block must not carry a signet solution yet: a producer adds the PQ push first and signs
+    the signet solution over it. rnd None signs deterministically (test vectors); a block producer
+    passes 32 random bytes (hedged signing). Recomputes the merkle root and returns the signature.
+
+    The output script stays plain bytes, as contrib/signet/miner's new_block leaves it: the miner
+    appends the signet push to it with +=, which a CScript does not support."""
+    index = witness_commitment_index(block)
+    assert index is not None, "block has no witness commitment"
+    script = bytes(block.vtx[0].vout[index].scriptPubKey)
+    assert len(script) == WITNESS_COMMITMENT_SIZE, "witness commitment output already carries pushes"
+    signature = mldsa44_sign(seckey, signet_pq_message(block, challenge), context=SIGNET_PQ_CONTEXT, rnd=rnd)
+    block.vtx[0].vout[index].scriptPubKey = script + CScriptOp.encode_op_pushdata(signet_pq_push(signature))
+    block.hashMerkleRoot = block.calc_merkle_root()
+    return signature
+
+
+def signet_pq_signature(block):
+    """The signature in the block's PQ push, or None when there is no PQ push in the required form."""
+    index = witness_commitment_index(block)
+    if index is None:
+        return None
+    ops = list(CScript(bytes(block.vtx[0].vout[index].scriptPubKey)[WITNESS_COMMITMENT_SIZE:]))
+    if not ops or not isinstance(ops[0], bytes) or len(ops[0]) != SIGNET_PQ_PUSH_SIZE:
+        return None
+    push = ops[0]
+    if push[:len(SIGNET_PQ_HEADER)] != SIGNET_PQ_HEADER or push[len(SIGNET_PQ_HEADER)] != SIGNET_PQ_VERSION:
+        return None
+    return push[len(SIGNET_PQ_HEADER) + 1:]
+
+
+def verify_signet_pq_signature(block, pubkey, challenge):
+    """Whether the block's PQ push holds a valid signature by pubkey (the node's check, less the
+    exact-encoding rules)."""
+    signature = signet_pq_signature(block)
+    return signature is not None and mldsa44_verify(pubkey, signet_pq_message(block, challenge), signature,
+                                                    context=SIGNET_PQ_CONTEXT)
+
+
+def add_signet_solution(block, solution):
+    """Append a signet solution push, as contrib/signet/miner does, and recompute the merkle root."""
+    index = witness_commitment_index(block)
+    assert index is not None, "block has no witness commitment"
+    block.vtx[0].vout[index].scriptPubKey = (bytes(block.vtx[0].vout[index].scriptPubKey)
+                                             + CScriptOp.encode_op_pushdata(SIGNET_HEADER + bytes(solution)))
+    block.hashMerkleRoot = block.calc_merkle_root()
+
