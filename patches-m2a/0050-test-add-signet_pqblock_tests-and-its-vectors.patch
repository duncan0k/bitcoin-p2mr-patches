+namespace {
+std::vector<unsigned char> Hex(const UniValue& field)
+{
+    const auto bytes{TryParseHex<unsigned char>(field.get_str())};
+    BOOST_REQUIRE_MESSAGE(bytes.has_value(), "not hex: " << field.get_str().substr(0, 40));
+    return *bytes;
+}
+
+CBlock ReadBlock(const UniValue& field)
+{
+    CBlock block;
+    SpanReader{Hex(field)} >> TX_WITH_WITNESS(block);
+    return block;
+}
+
+//! Signet parameters with an OP_TRUE challenge that require the block signature by pubkey from height on.
+std::unique_ptr<const CChainParams> PQParams(const std::vector<unsigned char>& pubkey, int height)
+{
+    ArgsManager args;
+    args.ForceSetArg("-signetchallenge", "51");
+    args.ForceSetArg("-signetpqblock", HexStr(pubkey) + "@" + std::to_string(height));
+    return CreateChainParams(args, ChainType::SIGNET);
+}
+
+//! The witness commitment output's script, as bytes.
+std::vector<unsigned char> Commitment(const CBlock& block)
+{
+    const int index{GetWitnessCommitmentIndex(block)};
+    BOOST_REQUIRE(index != NO_WITNESS_COMMITMENT);
+    const CScript& script{block.vtx[0]->vout[index].scriptPubKey};
+    return {script.begin(), script.end()};
+}
+
+//! A copy of the block whose witness commitment output's script is replaced by script.
+CBlock WithCommitment(const CBlock& block, const std::vector<unsigned char>& script)
+{
+    CBlock copy{block};
+    CMutableTransaction coinbase{*copy.vtx[0]};
+    coinbase.vout.at(GetWitnessCommitmentIndex(block)).scriptPubKey = CScript(script.begin(), script.end());
+    copy.vtx[0] = MakeTransactionRef(std::move(coinbase));
+    copy.hashMerkleRoot = BlockMerkleRoot(copy);
+    return copy;
+}
+
+//! A copy of the block whose coinbase scriptSig is replaced by script_sig.
+CBlock WithCoinbaseScriptSig(const CBlock& block, const CScript& script_sig)
+{
+    CBlock copy{block};
+    CMutableTransaction coinbase{*copy.vtx[0]};
+    coinbase.vin.at(0).scriptSig = script_sig;
+    copy.vtx[0] = MakeTransactionRef(std::move(coinbase));
+    copy.hashMerkleRoot = BlockMerkleRoot(copy);
+    return copy;
+}
+
+std::vector<unsigned char> Push(const std::vector<unsigned char>& data)
+{
+    const CScript script{CScript() << data};
+    return {script.begin(), script.end()};
+}
+
+std::vector<unsigned char> Concat(std::vector<unsigned char> a, const std::vector<unsigned char>& b)
+{
+    a.insert(a.end(), b.begin(), b.end());
+    return a;
+}
+} // namespace
+
+BOOST_FIXTURE_TEST_SUITE(signet_pqblock_tests, BasicTestingSetup)
+
+// Messages and signatures the functional test framework made (test/util/generate_signet_pqblock_tests.py).
+BOOST_AUTO_TEST_CASE(vectors)
+{
+    const UniValue file{read_json(json_tests::signet_pqblock)};
+    BOOST_REQUIRE_EQUAL(file.size(), 2U);
+    const UniValue& vectors{file[1]};
+    const auto challenge{Hex(vectors["challenge"])};
+    const auto pubkey{Hex(vectors["pubkey"])};
+    const auto other_pubkey{Hex(vectors["other_pubkey"])};
+    BOOST_REQUIRE_EQUAL(vectors["cases"].size(), 2U);
+
+    for (const UniValue& test : vectors["cases"].getValues()) {
+        const int height{test["height"].getInt<int>()};
+        const CBlock block{ReadBlock(test["block"])};
+
+        // The coinbase the signature covers and the merkle root over it, computed here from the
+        // specification, match the framework's...
+        CMutableTransaction coinbase{*block.vtx[0]};
+        const std::vector<unsigned char> commitment{Commitment(block)};
+        std::vector<unsigned char> cut{std::vector<unsigned char>(commitment.begin(), commitment.begin() + MINIMUM_WITNESS_COMMITMENT)};
+        cut = Concat(cut, Push({0x50, 0x51, 0x42, 0x31, 0x01}));
+        coinbase.vout.at(GetWitnessCommitmentIndex(block)).scriptPubKey = CScript(cut.begin(), cut.end());
+        DataStream serialized;
+        serialized << TX_NO_WITNESS(coinbase);
+        BOOST_CHECK_EQUAL(HexStr(serialized), test["pq_coinbase"].get_str());
+        std::vector<uint256> leaves{coinbase.GetHash().ToUint256()};
+        for (size_t i{1}; i < block.vtx.size(); ++i) leaves.push_back(block.vtx[i]->GetHash().ToUint256());
+        BOOST_CHECK_EQUAL(HexStr(ComputeMerkleRoot(leaves)), test["pq_merkle"].get_str());
+
+        // ...and so does the message the node signs over, with and without a signet solution after it.
+        const auto message{SignetPQBlockMessage(block, challenge)};
+        BOOST_REQUIRE(message);
+        BOOST_CHECK_EQUAL(HexStr(*message), test["message"].get_str());
+        const CBlock solved{ReadBlock(test["block_with_solution"])};
+        BOOST_CHECK_EQUAL(HexStr(*SignetPQBlockMessage(solved, challenge)), test["message"].get_str());
+
+        // The signature holds from the height on, with or without the solution push, and only for its key.
+        const auto params{PQParams(pubkey, height)};
+        BOOST_CHECK(CheckSignetPQBlock(block, params->GetConsensus()));
+        BOOST_CHECK(CheckSignetPQBlock(solved, params->GetConsensus()));
+        BOOST_CHECK(!CheckSignetPQBlock(block, PQParams(other_pubkey, height)->GetConsensus()));
+        // Another challenge is another network: the message changes.
+        BOOST_CHECK(*SignetPQBlockMessage(block, std::vector<unsigned char>{OP_16}) != *message);
+    }
+}
+
+// Every witness commitment output that is not exactly OP_RETURN, the commitment, the PQ push and
+// at most one signet solution push, each in its shortest encoding, is rejected from the height on.
+BOOST_AUTO_TEST_CASE(exact_form)
+{
+    const UniValue file{read_json(json_tests::signet_pqblock)};
+    const UniValue& vectors{file[1]};
+    const auto pubkey{Hex(vectors["pubkey"])};
+    const UniValue& test{vectors["cases"][1]};
+    const int height{test["height"].getInt<int>()};
+    const CBlock block{ReadBlock(test["block"])};
+    const auto params{PQParams(pubkey, height)};
+    const Consensus::Params& consensus{params->GetConsensus()};
+
+    const std::vector<unsigned char> script{Commitment(block)};
+    const std::vector<unsigned char> commitment(script.begin(), script.begin() + MINIMUM_WITNESS_COMMITMENT);
+    const std::vector<unsigned char> push(script.begin() + MINIMUM_WITNESS_COMMITMENT + 3, script.end()); // after 4d 79 09
+    BOOST_REQUIRE_EQUAL(push.size(), 2425U);
+    BOOST_REQUIRE(Concat(commitment, Push(push)) == script);
+    const std::vector<unsigned char> signet_push{Push({0xec, 0xc7, 0xda, 0xa2, 0x00, 0x00})};
+
+    // The block as it is, and with a signet solution push after the PQ push.
+    BOOST_CHECK(CheckSignetPQBlock(block, consensus));
+    BOOST_CHECK(CheckSignetPQBlock(WithCommitment(block, Concat(script, signet_push)), consensus));
+
+    auto flipped{push};
+    flipped[100] ^= 1;
+    auto other_version{push};
+    other_version[4] = 0x02;
+    std::vector<unsigned char> pushdata4{OP_PUSHDATA4, 0x79, 0x09, 0x00, 0x00};
+    pushdata4 = Concat(pushdata4, push);
+
+    const std::vector<std::vector<unsigned char>> invalid{
+        commitment,                                                      // no PQ push
+        Concat(commitment, {OP_1NEGATE}),                                // a non-push opcode instead of it
+        Concat(commitment, Push(flipped)),                               // a flipped bit
+        Concat(Concat(commitment, Push(push)), Push(push)),              // two PQ pushes
+        Concat(commitment, Push(other_version)),                         // another version
+        Concat(commitment, Push(Concat(push, {0x00}))),                  // a longer PQ push
+        Concat(commitment, pushdata4),                                   // not the shortest encoding
+        Concat(Concat(commitment, Push(push)), {OP_0}),                  // an opcode after it
+        Concat(Concat(commitment, Push(push)), {OP_RETURN}),             // a non-push opcode after it
+        Concat(Concat(commitment, Push(push)), {OP_PUSHDATA2, 0xff}),    // an unparsable tail
+        Concat(Concat(commitment, Push(push)), Push({0xec, 0xc7, 0xda, 0xa2})), // a signet push with no data
+        Concat(Concat(Concat(commitment, Push(push)), signet_push), signet_push), // two signet pushes
+        Concat(Concat(commitment, Push(push)), {OP_PUSHDATA1, 0x06, 0xec, 0xc7, 0xda, 0xa2, 0x00, 0x00}), // the signet push not in its shortest encoding
+        Concat(Concat(commitment, signet_push), Push(push)),             // the signet push first
+    };
+    for (const auto& variant : invalid) {
+        BOOST_CHECK(!CheckSignetPQBlock(WithCommitment(block, variant), consensus));
+        // Below the height nothing is rejected.
+        BOOST_CHECK(CheckSignetPQBlock(WithCommitment(block, variant), PQParams(pubkey, height + 1)->GetConsensus()));
+    }
+}
+
+// The height comes from the coinbase, in exactly the form BIP34 requires; any other form counts as
+// having reached the height.
+BOOST_AUTO_TEST_CASE(coinbase_height)
+{
+    const UniValue file{read_json(json_tests::signet_pqblock)};
+    const UniValue& vectors{file[1]};
+    const auto pubkey{Hex(vectors["pubkey"])};
+    // The height-5 block without its PQ push: valid only below the height.
+    const CBlock signed_block{ReadBlock(vectors["cases"][0]["block"])};
+    const std::vector<unsigned char> script{Commitment(signed_block)};
+    const CBlock block{WithCommitment(signed_block, std::vector<unsigned char>(script.begin(), script.begin() + MINIMUM_WITNESS_COMMITMENT))};
+    const auto params{PQParams(pubkey, 6)};
+    const Consensus::Params& consensus{params->GetConsensus()};
+
+    BOOST_CHECK(CheckSignetPQBlock(block, consensus));                                          // OP_5 OP_0, below 6
+    BOOST_CHECK(!CheckSignetPQBlock(block, PQParams(pubkey, 5)->GetConsensus()));                 // at 5
+    BOOST_CHECK(CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << 3 << OP_0), consensus));
+    BOOST_CHECK(!CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << 6 << OP_0), consensus));
+    BOOST_CHECK(CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << 0 << OP_0), consensus));
+    // Not the BIP34 form of 5: a one-byte push instead of OP_5, and a non-minimal push of 5.
+    BOOST_CHECK(!CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << std::vector<unsigned char>{5} << OP_0), consensus));
+    BOOST_CHECK(!CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << std::vector<unsigned char>{5, 0} << OP_0), consensus));
+    // No height at all, and a negative one.
+    BOOST_CHECK(!CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript()), consensus));
+    BOOST_CHECK(!CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << OP_1NEGATE << OP_0), consensus));
+    // A pushed height (17 and above): the vector block at 17, without its PQ push.
+    const CBlock signed17{ReadBlock(vectors["cases"][1]["block"])};
+    const std::vector<unsigned char> script17{Commitment(signed17)};
+    const CBlock block17{WithCommitment(signed17, std::vector<unsigned char>(script17.begin(), script17.begin() + MINIMUM_WITNESS_COMMITMENT))};
+    BOOST_CHECK(CheckSignetPQBlock(block17, PQParams(pubkey, 18)->GetConsensus()));
+    BOOST_CHECK(!CheckSignetPQBlock(block17, PQParams(pubkey, 17)->GetConsensus()));
+    // Pushes of every length a height takes, on both sides of the rule's height.
+    for (const int h : {127, 128, 255, 256, 32767, 32768, 8388607, 8388608, std::numeric_limits<int>::max() - 1}) {
+        const CBlock at{WithCoinbaseScriptSig(block, CScript() << h << OP_0)};
+        BOOST_CHECK_MESSAGE(CheckSignetPQBlock(at, PQParams(pubkey, h + 1)->GetConsensus()), "height " << h);
+        BOOST_CHECK_MESSAGE(!CheckSignetPQBlock(at, PQParams(pubkey, h)->GetConsensus()), "height " << h);
+    }
+    // 128 with a padding byte, and a push longer than any height: unreadable, so enforced.
+    BOOST_CHECK(!CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << std::vector<unsigned char>{0x80, 0x00, 0x00} << OP_0), PQParams(pubkey, 1000)->GetConsensus()));
+    BOOST_CHECK(!CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript() << std::vector<unsigned char>{0x00, 0x00, 0x00, 0x80, 0x00} << OP_0), PQParams(pubkey, 1000)->GetConsensus()));
+    // The genesis block is exempt: it has no witness commitment, and its coinbase starts with a push
+    // that reads as a height above any (486604799). Anything else without a signature is not.
+    const CBlock& genesis{params->GenesisBlock()};
+    BOOST_CHECK(CheckSignetPQBlock(genesis, PQParams(pubkey, 1)->GetConsensus()));
+    CBlock not_genesis{genesis};
+    ++not_genesis.nNonce;
+    BOOST_CHECK(!CheckSignetPQBlock(not_genesis, PQParams(pubkey, 1)->GetConsensus()));
+    // Without the rule nothing is checked.
+    ArgsManager args;
+    args.ForceSetArg("-signetchallenge", "51");
+    BOOST_CHECK(CheckSignetPQBlock(WithCoinbaseScriptSig(block, CScript()), CreateChainParams(args, ChainType::SIGNET)->GetConsensus()));
+}
+
+BOOST_AUTO_TEST_CASE(option)
+{
+    const UniValue file{read_json(json_tests::signet_pqblock)};
+    const auto pubkey{Hex(file[1]["pubkey"])};
+    const std::string key{HexStr(pubkey)};
+
+    const auto params{PQParams(pubkey, 42)};
+    BOOST_REQUIRE(params->GetConsensus().signet_pq_block);
+    BOOST_CHECK_EQUAL(params->GetConsensus().signet_pq_block->height, 42);
+    BOOST_CHECK(params->GetConsensus().signet_pq_block->pubkey == pubkey);
+
+    const auto fails{[](const std::vector<std::pair<std::string, std::string>>& settings, const std::string& message) {
+        ArgsManager args;
+        for (const auto& [name, value] : settings) args.ForceSetArg(name, value);
+        BOOST_CHECK_EXCEPTION(CreateChainParams(args, ChainType::SIGNET), std::runtime_error, HasReason{message});
+    }};
+    fails({{"-signetpqblock", key + "@5"}}, "-signetpqblock requires -signetchallenge.");
+    fails({{"-signetchallenge", "5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae"}, {"-signetpqblock", key + "@5"}},
+          "-signetpqblock cannot be used on the Ark-0 signet, whose rules are fixed in the code.");
+    fails({{"-signetchallenge", "51"}, {"-signetpqblock", key}}, "-signetpqblock must be <pubkey>@<height>, not '" + key + "'.");
+    fails({{"-signetchallenge", "51"}, {"-signetpqblock", key + "@x"}}, "-signetpqblock must be <pubkey>@<height>, not '" + key + "@x'.");
+    fails({{"-signetchallenge", "51"}, {"-signetpqblock", key.substr(2) + "@5"}}, "-signetpqblock needs a 1312-byte ML-DSA-44 public key, not 1311 bytes.");
+    fails({{"-signetchallenge", "51"}, {"-signetpqblock", key + "@0"}}, "-signetpqblock height must be at least 1, not 0.");
+
+    // Without the option, and on other chains, the rule does not exist.
+    ArgsManager args;
+    args.ForceSetArg("-signetchallenge", "51");
+    BOOST_CHECK(!CreateChainParams(args, ChainType::SIGNET)->GetConsensus().signet_pq_block);
+    BOOST_CHECK(!CreateChainParams(ArgsManager{}, ChainType::MAIN)->GetConsensus().signet_pq_block);
+    BOOST_CHECK(!CreateChainParams(ArgsManager{}, ChainType::SIGNET)->GetConsensus().signet_pq_block);
+}
+
+// A block whose signature another implementation made: p2mr-ts, which computed the message on its
+// own and signed it with @noble/post-quantum, hedged, so not with the deterministic signature the
+// vectors above carry for the same block.
+BOOST_AUTO_TEST_CASE(other_implementation)
+{
+    const UniValue file{read_json(json_tests::signet_pqblock_noble)};
+    const UniValue& vectors{file[1]};
+    const UniValue own_file{read_json(json_tests::signet_pqblock)};
+    const UniValue& own{own_file[1]};
+    BOOST_REQUIRE_EQUAL(vectors["challenge"].get_str(), own["challenge"].get_str());
+    BOOST_REQUIRE_EQUAL(vectors["pubkey"].get_str(), own["pubkey"].get_str());
+    const auto pubkey{Hex(vectors["pubkey"])};
+    const int height{vectors["height"].getInt<int>()};
+    const CBlock block{ReadBlock(vectors["block"])};
+    BOOST_CHECK(CheckSignetPQBlock(block, PQParams(pubkey, height)->GetConsensus()));
+    BOOST_CHECK(!CheckSignetPQBlock(block, PQParams(Hex(own["other_pubkey"]), height)->GetConsensus()));
+    BOOST_CHECK(Commitment(block) != Commitment(ReadBlock(own["cases"][1]["block"])));
+}
+
+BOOST_AUTO_TEST_SUITE_END()
