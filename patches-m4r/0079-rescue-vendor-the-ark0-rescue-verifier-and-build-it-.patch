+    pub unsafe fn si_pid(&self) -> crate::pid_t {
+        #[repr(C)]
+        struct siginfo_timer {
+            _si_signo: c_int,
+            _si_errno: c_int,
+            _si_code: c_int,
+            #[cfg(target_pointer_width = "64")]
+            __pad1: Padding<c_int>,
+            _pid: crate::pid_t,
+        }
