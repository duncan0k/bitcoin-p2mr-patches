+++ b/src/kernel/CMakeLists.txt
@@ -114,6 +114,34 @@ target_link_libraries(bitcoinkernel
 
 target_include_directories(bitcoinkernel PRIVATE $<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/src/leveldb/include>)
 
+# The P2MR rescue verifier (doc/p2mr-rescue.md), a Rust static library: linked, not merged. A
+# shared bitcoinkernel exports none of its symbols (voleith_verify_s1 and the Rust standard library,
+# which have default visibility); a static one is installed with it (below).
+get_target_property(bitcoinkernel_link_type bitcoinkernel TYPE)
+if(bitcoinkernel_link_type STREQUAL "SHARED_LIBRARY" AND APPLE)
+  # ld64 and lld for Mach-O: -hidden-l links an archive with every symbol in it hidden.
+  get_target_property(voleith_location voleith IMPORTED_LOCATION)
+  get_filename_component(voleith_dir ${voleith_location} DIRECTORY)
+  add_dependencies(bitcoinkernel voleith_build)
+  target_include_directories(bitcoinkernel PRIVATE $<TARGET_PROPERTY:voleith,INTERFACE_INCLUDE_DIRECTORIES>)
+  target_link_libraries(bitcoinkernel PRIVATE $<TARGET_PROPERTY:voleith,INTERFACE_LINK_LIBRARIES>)
+  target_link_options(bitcoinkernel PRIVATE "LINKER:-L,${voleith_dir}" "LINKER:-hidden-lvoleith")
+else()
+  target_link_libraries(bitcoinkernel PRIVATE voleith)
+endif()
+if(bitcoinkernel_link_type STREQUAL "SHARED_LIBRARY" AND NOT APPLE AND NOT WIN32)
+  # TARGET would add an INTERFACE option, for the targets that link the kernel: the option is the
+  # kernel's own.
+  set(voleith_exclude_libs "-Wl,--exclude-libs,${CMAKE_STATIC_LIBRARY_PREFIX}voleith${CMAKE_STATIC_LIBRARY_SUFFIX}")
+  try_append_linker_flag("${voleith_exclude_libs}" RESULT_VAR voleith_exclude_libs_supported)
+  if(voleith_exclude_libs_supported)
+    target_link_options(bitcoinkernel PRIVATE ${voleith_exclude_libs})
+  else()
+    message(FATAL_ERROR "A shared bitcoinkernel needs ${voleith_exclude_libs}, so that it exports no symbol of the Rust library.")
+  endif()
+endif()
+# A DLL exports what is marked __declspec(dllexport) only, which the Rust static library is not.
+
 # Add a convenience libbitcoinkernel target as a synonym for bitcoinkernel.
 add_custom_target(libbitcoinkernel)
 add_dependencies(libbitcoinkernel bitcoinkernel)
@@ -123,6 +151,34 @@ if(bitcoinkernel_type STREQUAL "STATIC_LIBRARY")
   target_compile_definitions(bitcoinkernel PUBLIC BITCOINKERNEL_STATIC)
 endif()
 
+# A static bitcoinkernel does not hold the objects of the Rust static library: it is installed next to
+# it, as bitcoinkernel_voleith. pkg-config --static then lists what a program that links the static
+# kernel needs beyond what upstream's lists: the archive; the kernel's own system library (bcrypt on
+# Windows, for BCryptGenRandom); and those of the Rust library (threads, dl, rt, m on Linux; frameworks
+# on macOS; the Windows system libraries). As with upstream's static kernel, a program links it with a
+# C++ compiler driver, which adds the C++ runtime. The rest of the interface is headers only (Boost,
+# USDT) and compile settings (core_interface).
+set(BITCOINKERNEL_LIBS_PRIVATE "")
+if(bitcoinkernel_type STREQUAL "STATIC_LIBRARY")
+  set(voleith_installed_name bitcoinkernel_voleith)
+  if(MSVC)
+    set(voleith_installed_file ${voleith_installed_name}.lib)
+  else()
+    set(voleith_installed_file ${CMAKE_STATIC_LIBRARY_PREFIX}${voleith_installed_name}${CMAKE_STATIC_LIBRARY_SUFFIX})
+  endif()
+  get_target_property(voleith_location voleith IMPORTED_LOCATION)
+  install(FILES ${voleith_location} DESTINATION ${CMAKE_INSTALL_LIBDIR} RENAME ${voleith_installed_file} COMPONENT libbitcoinkernel)
+  set(kernel_private_libs ${voleith_installed_name})
+  if(WIN32)
+    list(APPEND kernel_private_libs bcrypt)
+  endif()
+  get_target_property(voleith_system_libs voleith INTERFACE_LINK_LIBRARIES)
+  list(APPEND kernel_private_libs ${voleith_system_libs})
+  # Each entry as the .pc syntax needs it (cmake/module/PkgConfigLibs.cmake): options as they are,
+  # names as -l<name>.
+  include(PkgConfigLibs)
+  pkgconfig_libs(BITCOINKERNEL_LIBS_PRIVATE ${kernel_private_libs})
+endif()
 configure_file(${PROJECT_SOURCE_DIR}/libbitcoinkernel.pc.in ${PROJECT_BINARY_DIR}/libbitcoinkernel.pc @ONLY)
 install(FILES ${PROJECT_BINARY_DIR}/libbitcoinkernel.pc DESTINATION "${CMAKE_INSTALL_LIBDIR}/pkgconfig" COMPONENT libbitcoinkernel)
 
