diff --git a/src/rescue/CMakeLists.txt b/src/rescue/CMakeLists.txt
new file mode 100644
index 0000000..f065322
--- /dev/null
+++ b/src/rescue/CMakeLists.txt
@@ -0,0 +1,200 @@
+# Copyright (c) 2026 The Bitcoin Core developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+# The verifier of the P2MR rescue lane (doc/p2mr-rescue.md): the Rust crate voleith, vendored in
+# voleith/ with its dependencies in vendor/ (README.md), built as a static library that holds the
+# verifier and its C ABI only (voleith/include/voleith.h). It is part of consensus: a node cannot
+# be built without it, so a missing or different Rust toolchain stops the configuration.
+#
+# The build is pinned so that two builds give the same bytes: one exact toolchain, whose own cargo
+# and rustc binaries are run (not rustup's proxies, which an environment variable could redirect),
+# the release profile of the crate's own Cargo.toml, also given on the command line (lto,
+# codegen-units 1, panic = "unwind", which the C ABI needs to catch a panic; cargo-build.cmake
+# fails the build if anything is compiled with panic=abort), no default features (no prover), the
+# lock file as vendored, no network, a new CARGO_HOME, no cargo configuration file, none of the
+# environment's CARGO_* and RUST* variables, RUSTFLAGS of our own only, and every local path
+# remapped.
+
+set(VOLEITH_RUST_VERSION 1.97.0)
+
+find_program(VOLEITH_CARGO cargo HINTS $ENV{CARGO_HOME}/bin $ENV{HOME}/.cargo/bin)
+find_program(VOLEITH_RUSTC rustc HINTS $ENV{CARGO_HOME}/bin $ENV{HOME}/.cargo/bin)
+if(NOT VOLEITH_CARGO OR NOT VOLEITH_RUSTC)
+  message(FATAL_ERROR "The P2MR rescue lane needs cargo and rustc ${VOLEITH_RUST_VERSION} (doc/p2mr-rescue.md).")
+endif()
+
+# rust-toolchain.toml in this directory names the same version, so that a rustup installation
+# selects it for every cargo and rustc run from here. Without rustup the toolchain on PATH has to
+# be that version.
+set(VOLEITH_CRATE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/voleith)
+execute_process(
+  COMMAND ${VOLEITH_RUSTC} -vV
+  WORKING_DIRECTORY ${VOLEITH_CRATE_DIR}
+  OUTPUT_VARIABLE voleith_rustc_vv
+  RESULT_VARIABLE voleith_rustc_result
+)
+if(NOT voleith_rustc_result EQUAL 0 OR NOT voleith_rustc_vv MATCHES "release: ${VOLEITH_RUST_VERSION}\n")
+  message(FATAL_ERROR "The P2MR rescue lane is built with Rust ${VOLEITH_RUST_VERSION} exactly; ${VOLEITH_RUSTC} in ${VOLEITH_CRATE_DIR} is:\n${voleith_rustc_vv}")
+endif()
+# The toolchain's own binaries, in its sysroot: what rustup's proxies would run here, now fixed.
+execute_process(
+  COMMAND ${VOLEITH_RUSTC} --print sysroot
+  WORKING_DIRECTORY ${VOLEITH_CRATE_DIR}
+  OUTPUT_VARIABLE voleith_sysroot
+  OUTPUT_STRIP_TRAILING_WHITESPACE
+  RESULT_VARIABLE voleith_sysroot_result
+)
+set(voleith_toolchain_rustc ${voleith_sysroot}/bin/rustc${CMAKE_HOST_EXECUTABLE_SUFFIX})
+set(voleith_toolchain_cargo ${voleith_sysroot}/bin/cargo${CMAKE_HOST_EXECUTABLE_SUFFIX})
+if(NOT voleith_sysroot_result EQUAL 0 OR NOT EXISTS ${voleith_toolchain_rustc} OR NOT EXISTS ${voleith_toolchain_cargo})
+  message(FATAL_ERROR "The P2MR rescue lane needs the rustc and cargo of the Rust ${VOLEITH_RUST_VERSION} toolchain in its sysroot, ${voleith_sysroot}/bin.")
+endif()
+set(VOLEITH_RUSTC ${voleith_toolchain_rustc})
+set(VOLEITH_CARGO ${voleith_toolchain_cargo})
+foreach(tool IN ITEMS ${VOLEITH_RUSTC} ${VOLEITH_CARGO})
+  execute_process(COMMAND ${tool} -vV OUTPUT_VARIABLE voleith_tool_vv RESULT_VARIABLE voleith_tool_result)
+  if(NOT voleith_tool_result EQUAL 0 OR NOT voleith_tool_vv MATCHES "release: ${VOLEITH_RUST_VERSION}\n")
+    message(FATAL_ERROR "The P2MR rescue lane is built with Rust ${VOLEITH_RUST_VERSION} exactly; ${tool} is:\n${voleith_tool_vv}")
+  endif()
+endforeach()
+string(REGEX MATCH "host: [^\n]+" voleith_host "${voleith_rustc_vv}")
+string(REPLACE "host: " "" voleith_host "${voleith_host}")
+set(VOLEITH_RUST_TARGET "${voleith_host}" CACHE STRING "Rust target triple of the rescue verifier library (default: the host of rustc)")
+message(STATUS "P2MR rescue verifier: Rust ${VOLEITH_RUST_VERSION}, target ${VOLEITH_RUST_TARGET}")
+
+set(VOLEITH_CARGO_HOME ${CMAKE_CURRENT_BINARY_DIR}/cargo-home)
+set(VOLEITH_TARGET_DIR ${CMAKE_CURRENT_BINARY_DIR}/cargo-target)
+set(VOLEITH_LIBRARY ${VOLEITH_TARGET_DIR}/${VOLEITH_RUST_TARGET}/release/${CMAKE_STATIC_LIBRARY_PREFIX}voleith${CMAKE_STATIC_LIBRARY_SUFFIX})
+if(WIN32 AND NOT MINGW)
+  set(VOLEITH_LIBRARY ${VOLEITH_TARGET_DIR}/${VOLEITH_RUST_TARGET}/release/voleith.lib)
+endif()
+
+# The vendored sources replace crates.io. The paths of this directory, the build directory and
+# CARGO_HOME are remapped, so that neither the library nor the binaries hold a local path. The
+# standard library comes precompiled with its paths already under /rustc/<commit>.
+file(TO_CMAKE_PATH "${CMAKE_CURRENT_SOURCE_DIR}" voleith_src)
+file(TO_CMAKE_PATH "${CMAKE_CURRENT_BINARY_DIR}" voleith_bin)
+set(voleith_rustflags
+  "--remap-path-prefix=${voleith_src}=/p2mr-rescue"
+  "--remap-path-prefix=${voleith_bin}=/p2mr-rescue-build"
+  "-Cdebuginfo=0"
+)
+# CARGO_ENCODED_RUSTFLAGS separates the flags with 0x1f, so paths may contain spaces.
+string(ASCII 31 voleith_sep)
+list(JOIN voleith_rustflags "${voleith_sep}" voleith_encoded_rustflags)
+
+# Every input of the crate's build: a change to any file of the crate or of vendor/ builds the library
+# again from nothing (cargo-build.cmake), and a file added or removed is found at the next build too
+# (CONFIGURE_DEPENDS). A removed file, or one added with a time stamp older than the library (as cp -p
+# or an archive keeps it), changes no time stamp the build compares: the sorted list of inputs is
+# written to voleith-inputs.txt, exactly as it is (no substitution) and only when it differs from what
+# the file holds, and both cargo commands depend on it.
+file(GLOB_RECURSE voleith_sources CONFIGURE_DEPENDS LIST_DIRECTORIES false
+  ${VOLEITH_CRATE_DIR}/*
+  ${CMAKE_CURRENT_SOURCE_DIR}/vendor/*
+)
+list(APPEND voleith_sources
+  ${CMAKE_CURRENT_SOURCE_DIR}/rust-toolchain.toml
+  ${CMAKE_CURRENT_SOURCE_DIR}/cargo-build.cmake
+  ${CMAKE_CURRENT_SOURCE_DIR}/CMakeLists.txt
+)
+list(SORT voleith_sources)
+list(JOIN voleith_sources "\n" voleith_inputs_text)
+set(VOLEITH_INPUTS ${CMAKE_CURRENT_BINARY_DIR}/voleith-inputs.txt)
+set(voleith_inputs_old "")
+if(EXISTS ${VOLEITH_INPUTS})
+  file(READ ${VOLEITH_INPUTS} voleith_inputs_old)
+endif()
+if(NOT voleith_inputs_old STREQUAL "${voleith_inputs_text}\n")
+  file(WRITE ${VOLEITH_INPUTS} "${voleith_inputs_text}\n")
+endif()
+list(APPEND voleith_sources ${VOLEITH_INPUTS})
+
+# The release profile of the crate's Cargo.toml, given again on the command line, where it overrides
+# anything else (the other settings keep cargo's defaults: no configuration file or variable can
+# reach cargo to change them, nor name a rustc wrapper); and the vendored sources in place of
+# crates.io.
+set(voleith_cargo_config
+  --config "profile.release.opt-level=3"
+  --config "profile.release.lto=true"
+  --config "profile.release.codegen-units=1"
+  --config "profile.release.panic='unwind'"
+  --config "source.crates-io.replace-with='vendored-sources'"
+  --config "source.vendored-sources.directory='${voleith_src}/vendor'"
+)
+
+set(voleith_args
+  build --release --offline --locked --frozen --no-default-features --lib
+  --target ${VOLEITH_RUST_TARGET} --target-dir ${VOLEITH_TARGET_DIR}
+  ${voleith_cargo_config}
+)
+add_custom_command(
+  OUTPUT ${VOLEITH_LIBRARY}
+  COMMAND ${CMAKE_COMMAND}
+    -DCARGO=${VOLEITH_CARGO} -DRUSTC=${VOLEITH_RUSTC}
+    -DCRATE_DIR=${VOLEITH_CRATE_DIR} -DBUILD_DIR=${CMAKE_CURRENT_BINARY_DIR}
+    -DCARGO_HOME_DIR=${VOLEITH_CARGO_HOME}
+    -DTARGET_DIR=${VOLEITH_TARGET_DIR}
+    "-DRUSTFLAGS_ENCODED=${voleith_encoded_rustflags}"
+    -DLOG=${CMAKE_CURRENT_BINARY_DIR}/cargo-build.log
+    "-DARGS=${voleith_args}"
+    -P ${CMAKE_CURRENT_SOURCE_DIR}/cargo-build.cmake
+  WORKING_DIRECTORY ${VOLEITH_CRATE_DIR}
+  DEPENDS ${voleith_sources}
+  COMMENT "Building the P2MR rescue verifier (Rust ${VOLEITH_RUST_VERSION}, ${VOLEITH_RUST_TARGET}, verifier only)"
+  VERBATIM
+)
+add_custom_target(voleith_build DEPENDS ${VOLEITH_LIBRARY})
+
+add_library(voleith STATIC IMPORTED GLOBAL)
+set_target_properties(voleith PROPERTIES IMPORTED_LOCATION ${VOLEITH_LIBRARY})
+add_dependencies(voleith voleith_build)
+target_include_directories(voleith INTERFACE ${VOLEITH_CRATE_DIR}/include)
+
+# The system libraries the Rust standard library needs, from `--print native-static-libs` of the
+# pinned toolchain for the target (doc/p2mr-rescue.md). On Linux that is
+# -lgcc_s -lutil -lrt -lpthread -lm -ldl -lc, of which neither -lgcc_s nor -lutil is passed: the
+# library uses nothing of libutil, and the C++ link already provides _Unwind_*, from libgcc_s or,
+# with -static-libgcc, from libgcc_eh.
+if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
+  target_link_libraries(voleith INTERFACE Threads::Threads ${CMAKE_DL_LIBS} rt m)
+elseif(APPLE)
+  target_link_libraries(voleith INTERFACE "-framework CoreFoundation" System)
+elseif(WIN32)
+  target_link_libraries(voleith INTERFACE kernel32 advapi32 ntdll userenv ws2_32 synchronization)
+else()
+  target_link_libraries(voleith INTERFACE Threads::Threads ${CMAKE_DL_LIBS})
+endif()
+
+# A test-only build of the crate's own prover and its command-line tools (feature `cli`), for the
+# functional tests, which prove rescue spends as they run. Nothing of it is linked into a binary of
+# the node, and it is not installed.
+if(BUILD_TESTS)
+  set(VOLEITH_TOOLS_TARGET_DIR ${CMAKE_CURRENT_BINARY_DIR}/cargo-target-tools)
+  set(VOLEITH_PROVE ${VOLEITH_TOOLS_TARGET_DIR}/${VOLEITH_RUST_TARGET}/release/voleith-prove${CMAKE_EXECUTABLE_SUFFIX})
+  set(VOLEITH_VERIFY ${VOLEITH_TOOLS_TARGET_DIR}/${VOLEITH_RUST_TARGET}/release/voleith-verify${CMAKE_EXECUTABLE_SUFFIX})
+  set(voleith_tools_args
+    build --release --offline --locked --frozen --features cli --bins
+    --target ${VOLEITH_RUST_TARGET} --target-dir ${VOLEITH_TOOLS_TARGET_DIR}
+    ${voleith_cargo_config}
+  )
+  add_custom_command(
+    OUTPUT ${VOLEITH_PROVE} ${VOLEITH_VERIFY}
+    COMMAND ${CMAKE_COMMAND}
+      -DCARGO=${VOLEITH_CARGO} -DRUSTC=${VOLEITH_RUSTC}
+      -DCRATE_DIR=${VOLEITH_CRATE_DIR} -DBUILD_DIR=${CMAKE_CURRENT_BINARY_DIR}
+      -DCARGO_HOME_DIR=${VOLEITH_CARGO_HOME}-tools
+      -DTARGET_DIR=${VOLEITH_TOOLS_TARGET_DIR}
+      "-DRUSTFLAGS_ENCODED=${voleith_encoded_rustflags}"
+      -DLOG=${CMAKE_CURRENT_BINARY_DIR}/cargo-build-tools.log
+      "-DARGS=${voleith_tools_args}"
+      -P ${CMAKE_CURRENT_SOURCE_DIR}/cargo-build.cmake
+    WORKING_DIRECTORY ${VOLEITH_CRATE_DIR}
+    DEPENDS ${voleith_sources}
+    COMMENT "Building the test-only rescue prover tools (Rust ${VOLEITH_RUST_VERSION}, feature cli)"
+    VERBATIM
+  )
+  add_custom_target(voleith_test_tools ALL DEPENDS ${VOLEITH_PROVE} ${VOLEITH_VERIFY})
+  set(VOLEITH_PROVE ${VOLEITH_PROVE} PARENT_SCOPE)
+endif()
