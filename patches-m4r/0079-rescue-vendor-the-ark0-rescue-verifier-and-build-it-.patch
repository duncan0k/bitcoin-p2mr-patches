+        // specific value. Duplicates are allowed.
+        c_enum! {
+            pub enum e {
+                VAR0,
+                VAR2_0 = 2,
+                VAR3_0,
+                VAR4_0,
+                VAR2_1 = 2,
+                VAR3_1,
+                VAR4_1,
