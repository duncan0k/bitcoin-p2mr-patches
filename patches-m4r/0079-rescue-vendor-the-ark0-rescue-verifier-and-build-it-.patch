+    pub struct bpf_program {
+        pub bf_len: c_uint,
+        pub bf_insns: *mut bpf_insn,
+    }
+}
+
+s_no_extra_traits! {
+    #[repr(packed(4))]
+    pub struct bpf_dltlist {
+        pub bfl_len: u32,
+        pub bfl_u: __c_anonymous_bfl_u,
+    }
+
+    pub union __c_anonymous_bfl_u {
+        pub bflu_list: *mut u32,
+        pub bflu_pad: u64,
+    }
+}
