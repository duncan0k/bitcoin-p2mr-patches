+pub type __greg_t = u64;
+pub type __cpu_simple_lock_nv_t = c_uint;
+pub type __gregset_t = [__greg_t; _NGREG];
+pub type __fregset_t = [__fpreg; _NFREG];
+
+s_no_extra_traits! {
+    pub union __fpreg {
+        pub u_u64: u64,
+        pub u_d: c_double,
+    }
+}
