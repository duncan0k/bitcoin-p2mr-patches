diff --git a/src/rescue/cargo-build.cmake b/src/rescue/cargo-build.cmake
new file mode 100644
index 0000000..56d7a68
--- /dev/null
+++ b/src/rescue/cargo-build.cmake
@@ -0,0 +1,79 @@
+# Copyright (c) 2026 The Bitcoin Core developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+# Run by CMakeLists.txt at build time (cmake -P): cargo of the checked toolchain on the vendored
+# crate, isolated from the environment and from every cargo configuration file.
+#
+#   -DCARGO=<cargo> -DRUSTC=<rustc> -DCRATE_DIR=<dir> -DBUILD_DIR=<dir> -DCARGO_HOME_DIR=<dir>
+#   -DTARGET_DIR=<dir>
+#   -DRUSTFLAGS_ENCODED=<flags> -DLOG=<file> -DARGS=<cargo arguments, a list>
+
+cmake_minimum_required(VERSION 3.22)
+
+# Cargo reads .cargo/config.toml (and .cargo/config) from its working directory and every parent,
+# and from CARGO_HOME. CARGO_HOME is a new directory in the build tree; no parent of the crate or of
+# the build directory may hold one, since a [build], [target] or [profile] table there would change
+# what is built.
+foreach(start IN ITEMS "${CRATE_DIR}" "${BUILD_DIR}")
+  set(dir "${start}")
+  while(TRUE)
+    foreach(name IN ITEMS config.toml config)
+      if(EXISTS "${dir}/.cargo/${name}")
+        message(FATAL_ERROR "The P2MR rescue verifier is built without cargo configuration files, but ${dir}/.cargo/${name} exists.")
+      endif()
+    endforeach()
+    get_filename_component(parent "${dir}" DIRECTORY)
+    if(parent STREQUAL dir OR parent STREQUAL "")
+      break()
+    endif()
+    set(dir "${parent}")
+  endwhile()
+endforeach()
+file(REMOVE_RECURSE "${CARGO_HOME_DIR}")
+file(MAKE_DIRECTORY "${CARGO_HOME_DIR}")
+# CMake runs this when any file of the crate or of vendor/ changes. Cargo takes the vendored packages
+# for immutable, as it does crates.io, and would keep what it compiled from a vendored file that has
+# since changed: everything is compiled again, so that an incremental build is a clean one.
+file(REMOVE_RECURSE "${TARGET_DIR}")
+
+# Every variable cargo or rustc reads, and those of rustup and make that reach them, goes:
+# CARGO_*, RUST* (RUSTC, RUSTC_WRAPPER, RUSTFLAGS, RUSTDOCFLAGS, RUSTUP_TOOLCHAIN, ...), and the
+# jobserver of make. The names are taken from the whole text of `cmake -E environment` with one regular
+# expression, never through a CMake list, whose ";", "[" and "]" in a value would split or merge the
+# records after it; a name is matched only where a line starts, and only of the characters cargo's names
+# have, so every match is a plain name. A value with a newline can make a line that looks like a record:
+# unsetting such a name as well removes nothing that should stay. Windows looks names up without regard
+# to case (rustc_wrapper is RUSTC_WRAPPER there), so there they are matched upper-cased.
+execute_process(COMMAND "${CMAKE_COMMAND}" -E environment OUTPUT_VARIABLE environment)
+if(CMAKE_HOST_WIN32)
+  string(TOUPPER "${environment}" environment)
+endif()
+string(REGEX MATCHALL "\n((CARGO|RUST)[A-Za-z0-9_]*|MAKEFLAGS|MFLAGS|SOURCE_DATE_EPOCH)=" records "\n${environment}")
+foreach(record IN LISTS records)
+  string(REGEX REPLACE "^\n(.*)=$" "\\1" name "${record}")
+  unset(ENV{${name}})
+endforeach()
+set(ENV{CARGO_HOME} "${CARGO_HOME_DIR}")
+set(ENV{RUSTC} "${RUSTC}")
+set(ENV{CARGO_ENCODED_RUSTFLAGS} "${RUSTFLAGS_ENCODED}")
+
+execute_process(
+  COMMAND "${CARGO}" ${ARGS} --verbose
+  WORKING_DIRECTORY "${CRATE_DIR}"
+  OUTPUT_FILE "${LOG}"
+  ERROR_FILE "${LOG}.err"
+  RESULT_VARIABLE result
+)
+file(READ "${LOG}.err" log)
+if(NOT result EQUAL 0)
+  message(FATAL_ERROR "cargo failed (${result}):\n${log}")
+endif()
+# The C ABI catches every panic with catch_unwind, which panic = "abort" would defeat: no crate of
+# the build may be compiled so.
+if(log MATCHES "panic=abort")
+  message(FATAL_ERROR "The P2MR rescue verifier must be built with panic = \"unwind\"; cargo used panic=abort:\n${log}")
+endif()
+if(NOT log MATCHES "Running `[^`\n]*rustc[^`\n]* --crate-name voleith " AND NOT log MATCHES "Fresh voleith ")
+  message(FATAL_ERROR "cargo neither compiled the crate voleith nor found it up to date:\n${log}")
+endif()
