diff --git a/cmake/module/PkgConfigLibs.cmake b/cmake/module/PkgConfigLibs.cmake
new file mode 100644
index 0000000..ef6f29f
--- /dev/null
+++ b/cmake/module/PkgConfigLibs.cmake
@@ -0,0 +1,51 @@
+# Copyright (c) 2026 The Bitcoin Core developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+include_guard(GLOBAL)
+
+# pkgconfig_libs(<out> <entry>...): link entries (library names, linker options, Threads::Threads) as
+# one string for the Libs or Libs.private field of a .pc file, every entry as the arguments the linker
+# needs:
+#   - Threads::Threads: CMAKE_THREAD_LIBS_INIT, nothing if it is empty (threads in libc);
+#   - an option (starting with "-"), as it is: "-framework CoreFoundation" is the two arguments the
+#     linker needs, "-Wl,-z,relro" and "-l:libfoo.a" one each;
+#   - a plain library name (letters, digits and _ . + -, without the ".lib" a Windows name may end
+#     with): -l<name>.
+# Any other entry stops the configuration, naming it. It takes no paths: readers of .pc files do not
+# agree on escapes, quotes and "$", and a CMake list has already split a path with ";" before it gets
+# here, so no spelling of a path is safe. Entries that come out the same are listed once.
+function(pkgconfig_libs out)
+  # A string, not a list, so that "[", "]" or ";" in an option cannot split or merge entries; entries
+  # already written are recognised by their hash.
+  set(flags "")
+  set(seen "")
+  foreach(entry IN LISTS ARGN)
+    if(entry STREQUAL "")
+      set(flag "")
+    elseif(entry STREQUAL "Threads::Threads")
+      set(flag "${CMAKE_THREAD_LIBS_INIT}")
+    elseif(entry MATCHES "^-")
+      set(flag "${entry}")
+    else()
+      string(REGEX REPLACE "\\.lib$" "" name "${entry}")
+      if(NOT name MATCHES "^[A-Za-z0-9_.+-]+$")
+        message(FATAL_ERROR "libbitcoinkernel.pc cannot carry the link entry\n  ${entry}\n"
+          "which is neither an option nor a plain library name (letters, digits and _ . + -).")
+      endif()
+      set(flag "-l${name}")
+    endif()
+    if(NOT flag STREQUAL "")
+      string(SHA256 hash "${flag}")
+      if(NOT hash IN_LIST seen)
+        list(APPEND seen ${hash})
+        if(flags STREQUAL "")
+          set(flags "${flag}")
+        else()
+          string(APPEND flags " ${flag}")
+        endif()
+      endif()
+    endif()
+  endforeach()
+  set(${out} "${flags}" PARENT_SCOPE)
+endfunction()
