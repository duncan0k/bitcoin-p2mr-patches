@@ -0,0 +1,8 @@
+# Findings
+
+None. The 3 h 15 min campaign of 2026-10-15 produced no crash, timeout or
+accept of a modified proof, and none of the inputs flagged by the timing
+oracle reproduced on an idle core (see ../REPORT.md, section 4).
+
+Minimized inputs of future findings go here, named
+`<target>-<crash|timeout|accept|slow>-<hash>`.
diff --git a/src/rescue/voleith/fuzz/fuzz_targets/ffi.rs b/src/rescue/voleith/fuzz/fuzz_targets/ffi.rs
new file mode 100644
index 0000000..a7a1ef3
--- /dev/null
+++ b/src/rescue/voleith/fuzz/fuzz_targets/ffi.rs
@@ -0,0 +1,166 @@
+//! `voleith_verify_s1` with arbitrary lengths and null pointers. Run it under
+//! AddressSanitizer: every buffer is an exact-size heap allocation, so a read
+//! past a declared length, or a read of a buffer whose length should have been
+//! rejected first, is reported.
+//!
+//! Invariants: no crash, no panic (libfuzzer-sys aborts on any panic, even one
+//! the shim would catch), the result is 0 or 1, and 1 only for a known-valid
+//! (K, suffix, y, msg, proof).
+//!
+//! Input: u8 flags, then per pointer (k, y, msg, proof) a mode byte and a
+//! length, u8 suffix, then the payload used to fill buffers or edit a base.
+//! Modes per pointer:
+//!   0: exact-size buffer of the declared length (length clamped so the
+//!      buffer can be filled; for proof, 130218 is reachable);
+//!   1: null pointer with length 0 (allowed by the header);
+//!   2: null pointer with an arbitrary nonzero length (must return 0);
+//!   3: a short buffer with an out-of-range length (k_len outside 1..64,
+//!      msg_len > 65535, proof_len != 130218), which the length checks must
+//!      reject before any read.
+//! flags bit 0: start from a valid vector's fields (selector byte) and XOR the
+//! payload into them, so mode-0 inputs reach the full verification.
+
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+use voleith::ffi::voleith_verify_s1;
+use voleith_fuzz::{known, Reader, PROOF_LEN};
+
+#[derive(Clone, Copy)]
+enum Mode {
+    Exact(usize),
+    NullZero,
+    NullLen(usize),
+    ShortBad(usize),
+}
+
+fn mode(r: &mut Reader, max_valid: usize, valid: fn(usize) -> bool, default_len: usize) -> Mode {
+    let m = r.u8();
+    let len = r.u64() as usize;
+    match m % 4 {
+        0 => {
+            // Bias toward the expected length.
+            if m & 0x80 != 0 { Mode::Exact(default_len) } else { Mode::Exact(len % (max_valid + 1)) }
+        }
+        1 => Mode::NullZero,
+        2 => Mode::NullLen(len.max(1)),
+        _ => {
+            if valid(len) { Mode::Exact(len % (max_valid + 1)) } else { Mode::ShortBad(len) }
+        }
+    }
+}
+
+/// An exact-size buffer of `len` bytes from `src` (cycled), with `base`
+/// underneath when given.
+fn buffer(len: usize, base: Option<&[u8]>, src: &[u8], cursor: &mut usize) -> Vec<u8> {
+    let mut v = vec![0u8; len];
+    if let Some(b) = base {
+        let n = b.len().min(len);
+        v[..n].copy_from_slice(&b[..n]);
+    }
+    // Sparse XOR edits from the payload: (u24 offset, mask) pairs when a base
+    // is present; a straight fill otherwise.
+    if base.is_some() {
+        while *cursor + 4 <= src.len() {
+            let off = u32::from_le_bytes([src[*cursor], src[*cursor + 1], src[*cursor + 2], 0]) as usize;
+            let mask = src[*cursor + 3];
+            *cursor += 4;
+            if len > 0 {
+                v[off % len] ^= mask;
+            }
+            if mask == 0 {
+                break; // a zero mask ends this buffer's edits
+            }
+        }
+    } else if !src.is_empty() {
+        for b in v.iter_mut() {
+            *b = src[*cursor % src.len()];
+            *cursor += 1;
+        }
+    }
+    v
+}
+
+struct Arg {
+    buf: Option<Vec<u8>>,
+    len: usize,
+}
+
+impl Arg {
+    fn ptr(&self) -> *const u8 {
+        match &self.buf {
+            Some(b) if !b.is_empty() => b.as_ptr(),
+            // An empty Vec has a dangling (non-null) pointer, which the
+            // shim must never read for length 0.
+            Some(b) => b.as_ptr(),
+            None => std::ptr::null(),
+        }
+    }
+}
+
+fn arg(m: Mode, base: Option<&[u8]>, src: &[u8], cursor: &mut usize) -> Arg {
+    match m {
+        Mode::Exact(len) => Arg { buf: Some(buffer(len, base, src, cursor)), len },
+        Mode::NullZero => Arg { buf: None, len: 0 },
+        Mode::NullLen(len) => Arg { buf: None, len },
+        // 4 real bytes, but an out-of-range length: must not be read.
+        Mode::ShortBad(len) => Arg { buf: Some(buffer(4, base, src, cursor)), len },
+    }
+}
+
+fuzz_target!(|data: &[u8]| {
+    let k = known();
+    let mut r = Reader::new(data);
+    let flags = r.u8();
+    let sel = r.u8() as usize % k.valid.len();
+    let mk = mode(&mut r, 64, |l| (1..=64).contains(&l), k.valid[sel].key.len());
+    let my = r.u8() % 4; // 0/3: 32-byte buffer, 1/2: null
+    let mm = mode(&mut r, 65_535, |l| l <= 65_535, k.valid[sel].message.len());
+    let mp = mode(&mut r, PROOF_LEN, |l| l == PROOF_LEN, PROOF_LEN);
+    let suffix_raw = r.u8();
+    let payload = r.rest();
+
+    let v = &k.valid[sel];
+    let from_base = flags & 1 != 0;
+    let mut cur = 0usize;
+    let ka = arg(mk, from_base.then_some(&v.key[..]), payload, &mut cur);
+    let ya = match my {
+        1 | 2 => Arg { buf: None, len: 32 },
+        _ => Arg { buf: Some(buffer(32, from_base.then_some(&v.y[..]), payload, &mut cur)), len: 32 },
+    };
+    let ma = arg(mm, from_base.then_some(&v.message[..]), payload, &mut cur);
+    let pa = arg(mp, from_base.then_some(&v.proof[..]), payload, &mut cur);
+    let suffix = if from_base && flags & 2 == 0 { v.suffix } else { suffix_raw };
+
+    // SAFETY: every non-null pointer points to `len` readable bytes, except
+    // in mode 3 (ShortBad), where the length is out of range and the shim's
+    // contract is that it is checked before any read (ASan verifies this).
+    // A null y is outside the header's contract but the shim checks for it.
+    let res = unsafe {
+        voleith_verify_s1(ka.ptr(), ka.len, suffix, ya.ptr(), ma.ptr(), ma.len, pa.ptr(), pa.len)
+    };
+    assert!(res == 0 || res == 1, "result {res}");
+    if res == 1 {
+        // A null pointer with length 0 is the empty string (allowed by the
+        // header; a valid vector has an empty message).
+        let view = |a: &Arg| -> Option<Vec<u8>> {
+            match (&a.buf, a.len) {
+                (Some(b), _) => Some(b.clone()),
+                (None, 0) => Some(Vec::new()),
+                (None, _) => None,
+            }
+        };
+        let (Some(kb), Some(yb), Some(mb), Some(pb)) = (view(&ka), ya.buf.clone(), view(&ma), view(&pa)) else {
+            panic!("CRITICAL: accepted with a null pointer and a nonzero length");
+        };
+        assert!(
+            kb.len() == ka.len && mb.len() == ma.len && pb.len() == pa.len,
+            "CRITICAL: accepted with a declared length different from the buffer"
+        );
+        let (kb, mb, pb) = (&kb, &mb, &pb);
+        let mut y = [0u8; 32];
+        y.copy_from_slice(&yb);
+        let pubi = voleith::s1_encode_public(kb, suffix, &y).expect("accepted a non-canonical K");
+        assert!(k.contains(&pubi, mb, pb), "CRITICAL: FFI accepted a non-valid input");
+    }
+});
diff --git a/src/rescue/voleith/fuzz/fuzz_targets/verify_mutate.rs b/src/rescue/voleith/fuzz/fuzz_targets/verify_mutate.rs
new file mode 100644
index 0000000..85e3463
--- /dev/null
+++ b/src/rescue/voleith/fuzz/fuzz_targets/verify_mutate.rs
@@ -0,0 +1,264 @@
+//! Structured mutations of the valid proofs in vectors/.
+//!
+//! The fuzz input is a mutation program: a base-vector selector, then up to
+//! 16 operations on the (statement, message, proof) of that vector. libFuzzer
+//! mutates and minimizes the program; the harness decodes it.
+//!
+//! Invariants:
+//! - no panic;
+//! - `verify` returns false whenever the result differs from the base triple
+//!   (and true when it does not, as a sanity check of the oracle);
+//! - each verification takes at most 2x the time of a valid one (Timing).
+
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+use voleith_fuzz::{known, sections, Reader, Timing, C_BYTES, D_BYTES, OFF_C, OFF_CHALL3, OFF_D, PROOF_LEN, STATEMENT_ID, TAU};
+
+const MAX_OPS: usize = 16;
+
+fn xor_at(buf: &mut Vec<u8>, off: usize, mask: u8) {
+    if !buf.is_empty() {
+        let i = off % buf.len();
+        buf[i] ^= if mask == 0 { 1 } else { mask };
+    }
+}
+
+/// Generic byte-level edits shared by proof, message and statement.
+fn byte_op(r: &mut Reader, buf: &mut Vec<u8>, sel: u8) {
+    match sel % 6 {
+        // bit flip
+        0 => {
+            let off = r.u32() as usize;
+            let bit = r.u8() % 8;
+            xor_at(buf, off, 1 << bit);
+        }
+        // byte replace
+        1 => {
+            let off = r.u32() as usize;
+            let v = r.u8();
+            if !buf.is_empty() {
+                let n = buf.len();
+                buf[off % n] = v;
+            }
+        }
+        // chunk swap
+        2 => {
+            let a = r.u32() as usize;
+            let b = r.u32() as usize;
+            let len = r.u16() as usize;
+            let n = buf.len();
+            if n > 1 {
+                let len = len % (n / 2).max(1) + 1;
+                let a = a % (n - len + 1);
+                let b = b % (n - len + 1);
+                if a + len <= b || b + len <= a {
+                    for k in 0..len {
+                        buf.swap(a + k, b + k);
+                    }
+                }
+            }
+        }
+        // truncation
+        3 => {
+            let n = r.u32() as usize;
+            let new_len = if buf.is_empty() { 0 } else { n % buf.len() };
+            buf.truncate(new_len);
+        }
+        // extension
+        4 => {
+            let n = (r.u16() as usize % 1024) + 1;
+            let v = r.u8();
+            buf.extend(std::iter::repeat(v).take(n));
+        }
+        // splice of raw fuzz bytes
+        _ => {
+            let off = r.u32() as usize;
+            let n = r.u8() as usize;
+            let src = r.bytes(n);
+            if !buf.is_empty() {
+                let o = off % buf.len();
+                for (k, &b) in src.iter().enumerate() {
+                    if o + k < buf.len() {
+                        buf[o + k] = b;
+                    }
+                }
+            }
+        }
+    }
+}
+
+fuzz_target!(|data: &[u8]| {
+    let timing = Timing::get();
+    let k = known();
+    let secs = sections();
+    let mut r = Reader::new(data);
+    let base_idx = r.u8() as usize % k.valid.len();
+    let base = &k.valid[base_idx];
+    let mut pubi = base.public_inputs.clone();
+    let mut msg = base.message.clone();
+    let mut proof = base.proof.clone();
+
+    for _ in 0..MAX_OPS {
+        if r.is_empty() {
+            break;
+        }
+        let op = r.u8();
+        match op % 12 {
+            // 0-1: generic byte-level edits of the proof (bit flips, byte
+            // replacements, chunk swaps, truncations, extensions, splices).
+            0 | 1 => {
+                let sel = r.u8();
+                byte_op(&mut r, &mut proof, sel);
+            }
+            // 2: header changes.
+            2 => {
+                let which = r.u8() as usize % 2;
+                let v = r.u8();
+                if proof.len() > which {
+                    proof[which] = v;
+                }
+            }
+            // 3: edit at a field boundary of a §10 section: first/last byte,
+            // or the bytes just before/after it.
+            3 => {
+                let s = secs[r.u16() as usize % secs.len()];
+                let pos = match r.u8() % 4 {
+                    0 => s.start,
+                    1 => s.start + s.len - 1,
+                    2 => s.start.wrapping_sub(1),
+                    _ => s.start + s.len,
+                };
+                let mask = r.u8();
+                let bit_mode = r.u8() & 1 == 0;
+                if pos < proof.len() {
+                    proof[pos] ^= if bit_mode { 1 << (mask % 8) } else if mask == 0 { 0xff } else { mask };
+                }
+            }
+            // 4: overwrite a whole section (zeros, ones, constant).
+            4 => {
+                let s = secs[r.u16() as usize % secs.len()];
+                let v = match r.u8() % 3 {
+                    0 => 0x00,
+                    1 => 0xff,
+                    _ => r.u8(),
+                };
+                if s.start + s.len <= proof.len() {
+                    proof[s.start..s.start + s.len].fill(v);
+                }
+            }
+            // 5: copy a section from another valid proof (cross splicing).
+            5 => {
+                let s = secs[r.u16() as usize % secs.len()];
+                let other = &k.valid[r.u8() as usize % k.valid.len()];
+                if s.start + s.len <= proof.len() {
+                    proof[s.start..s.start + s.len]
+                        .copy_from_slice(&other.proof[s.start..s.start + s.len]);
+                }
+            }
+            // 6: swap two sections of equal length (e.g. two corrections,
+            // two seeds, two commitments).
+            6 => {
+                let a = secs[r.u16() as usize % secs.len()];
+                let b = secs[r.u16() as usize % secs.len()];
+                if a.len == b.len && a.start != b.start && b.start + b.len <= proof.len() && a.start + a.len <= proof.len() {
+                    for i in 0..a.len {
+                        proof.swap(a.start + i, b.start + i);
+                    }
+                }
+            }
+            // 7: set padding bits of a correction or of d.
+            7 => {
+                let i = r.u8() as usize % TAU; // TAU-1 corrections + d
+                let last = if i < TAU - 1 { OFF_C + (i + 1) * C_BYTES - 1 } else { OFF_D + D_BYTES - 1 };
+                let mask = r.u8() & 0xfe; // bits above the used bit 0
+                if last < proof.len() {
+                    proof[last] |= if mask == 0 { 0x80 } else { mask };
+                }
+            }
+            // 8: chall3 / Delta special values.
+            8 => {
+                if OFF_CHALL3 + 16 <= proof.len() {
+                    let c = &mut proof[OFF_CHALL3..OFF_CHALL3 + 16];
+                    match r.u8() % 4 {
+                        0 => c.fill(0),
+                        1 => c.fill(0xff),
+                        2 => {
+                            let other = &k.valid[r.u8() as usize % k.valid.len()];
+                            c.copy_from_slice(&other.proof[OFF_CHALL3..OFF_CHALL3 + 16]);
+                        }
+                        _ => {
+                            let b = r.u8() as usize % 128;
+                            c[b / 8] ^= 1 << (b % 8);
+                        }
+                    }
+                }
+            }
+            // 9: message edits.
+            9 => {
+                let sel = r.u8();
+                if sel % 7 == 6 {
+                    msg = k.valid[r.u8() as usize % k.valid.len()].message.clone();
+                } else {
+                    byte_op(&mut r, &mut msg, sel);
+                }
+            }
+            // 10: statement edits, byte level.
+            10 => {
+                let sel = r.u8();
+                byte_op(&mut r, &mut pubi, sel);
+            }
+            // 11: statement edits, field level (K, suffix, y).
+            _ => {
+                let kl = pubi.first().copied().unwrap_or(0) as usize;
+                match r.u8() % 5 {
+                    0 => {
+                        // suffix
+                        if 1 + kl < pubi.len() {
+                            pubi[1 + kl] = r.u8();
+                        }
+                    }
+                    1 => {
+                        // a y bit
+                        let b = r.u8() as usize;
+                        if 2 + kl + 32 <= pubi.len() {
+                            pubi[2 + kl + b % 32] ^= 1 << (b % 8);
+                        }
+                    }
+                    2 => {
+                        // K byte to another printable byte
+                        let i = r.u8() as usize;
+                        let v = 0x20 + r.u8() % 95;
+                        if kl > 0 && 1 + kl <= pubi.len() {
+                            pubi[1 + i % kl] = v;
+                        }
+                    }
+                    3 => {
+                        // the length byte
+                        if !pubi.is_empty() {
+                            pubi[0] = r.u8();
+                        }
+                    }
+                    _ => {
+                        pubi = k.valid[r.u8() as usize % k.valid.len()].public_inputs.clone();
+                    }
+                }
+            }
+        }
+    }
+
+    let unchanged = pubi == base.public_inputs && msg == base.message && proof == base.proof;
+    let ok = timing.check(data, || voleith::verify(STATEMENT_ID, &pubi, &msg, &proof));
+    if unchanged {
+        assert!(ok, "oracle: the unmodified valid proof was rejected");
+    } else if ok && !k.contains(&pubi, &msg, &proof) {
+        panic!(
+            "CRITICAL: verify accepted a modified proof (base {base_idx}, proof len {}, proof changed {}, msg changed {}, pub changed {})",
+            proof.len(),
+            proof != base.proof,
+            msg != base.message,
+            pubi != base.public_inputs,
+        );
+    }
+    let _ = PROOF_LEN;
+});
diff --git a/src/rescue/voleith/fuzz/fuzz_targets/verify_raw.rs b/src/rescue/voleith/fuzz/fuzz_targets/verify_raw.rs
new file mode 100644
index 0000000..cc2d70f
--- /dev/null
+++ b/src/rescue/voleith/fuzz/fuzz_targets/verify_raw.rs
@@ -0,0 +1,45 @@
+//! Arbitrary bytes split into (statement id, public inputs, message, proof)
+//! and passed to `voleith::verify`. Invariants: no panic, and no accept
+//! unless the triple is one of the known-valid vectors.
+//!
+//! Input layout:
+//!   u8 flags, u8 statement id, u16 |pub|, u32 |msg|, then pub, msg, proof
+//!   (the proof is the rest of the input).
+//! flags bit 0: zero-pad or truncate the proof to the statement 0x01 length;
+//! bit 1: force the header bytes to 0x02 0x01; bit 2: force the statement id
+//! to 0x01. Without them almost every input stops at steps 1–5; with them
+//! the fuzzer reaches the padding checks and the full verification.
+
+#![no_main]
+
+use libfuzzer_sys::fuzz_target;
+use voleith_fuzz::{known, Reader, Timing, PROOF_LEN, STATEMENT_ID};
+
+fuzz_target!(|data: &[u8]| {
+    let timing = Timing::get();
+    let mut r = Reader::new(data);
+    let flags = r.u8();
+    let mut sid = r.u8();
+    let pub_len = r.u16() as usize;
+    let msg_len = r.u32() as usize % 70_000;
+    let public_inputs = r.bytes(pub_len).to_vec();
+    let message = r.bytes(msg_len).to_vec();
+    let mut proof = r.rest().to_vec();
+    if flags & 1 != 0 {
+        proof.resize(PROOF_LEN, 0);
+    }
+    if flags & 2 != 0 && proof.len() >= 2 {
+        proof[0] = 0x02;
+        proof[1] = 0x01;
+    }
+    if flags & 4 != 0 {
+        sid = STATEMENT_ID;
+    }
+    let ok = timing.check(data, || voleith::verify(sid, &public_inputs, &message, &proof));
+    if ok {
+        assert!(
+            sid == STATEMENT_ID && known().contains(&public_inputs, &message, &proof),
+            "CRITICAL: verify accepted an input that is not a known-valid proof"
+        );
+    }
+});
diff --git a/src/rescue/voleith/fuzz/run_campaign.sh b/src/rescue/voleith/fuzz/run_campaign.sh
