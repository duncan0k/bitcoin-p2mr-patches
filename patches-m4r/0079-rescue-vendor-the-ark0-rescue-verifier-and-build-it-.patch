+/// Faults injected into voleith-prove (feature `fault-injection`): a
+/// failing random source, failing writes, sync, naming and removal, and a
+/// panic inside prove. In each case the exit code is right, no proof file
+/// appears under the final name, and no form of the seed or rho appears in
+/// standard output, standard error or any file in the working directory
+/// (where the output and temporary files go, with TMPDIR pointing into it).
+#[cfg(feature = "fault-injection")]
+#[test]
+fn faults_leak_nothing() {
+    let c = case();
+    let rho_hex = "a1c0d00d362bfb8d8bee5be89c3a50fe46893f2eb486fa70475e61c7dcf7a8e5";
+    let (x, rho) = (hex(&c.x_hex), hex(rho_hex));
+    let stdin = format!("{}\n", c.x_hex);
+    // VOLEITH_TEST_EXPECT_ABORT=1: the binaries were built with the `cli`
+    // profile, so a panic must abort.
+    let expect_abort = std::env::var_os("VOLEITH_TEST_EXPECT_ABORT").is_some();
+    let scenarios: &[(&str, i32)] = &[
+        ("", 0),
+        ("rng", 1),
+        ("write", 1),
+        ("write,remove", 1),
+        ("sync", 1),
+        ("publish", 1),
+        ("publish,remove", 1),
+        ("panic", 101),
+    ];
+    for (i, (fault, want)) in scenarios.iter().enumerate() {
+        let dir = fresh_dir(&format!("fault-{i}"));
+        let tmpdir = dir.join("tmp");
+        let tmps = tmpdir.to_str().unwrap();
+        let spec = format!("{fault},rho={rho_hex}");
+        let env = [
+            ("VOLEITH_FAULT", spec.as_str()),
+            ("TMPDIR", tmps),
+            ("TMP", tmps),
+            ("TEMP", tmps),
+            ("RUST_BACKTRACE", "full"),
+        ];
+        let mut args = prove_args(&c, "proof.bin");
+        args[7] = "proof.bin";
+        let o = run_env(PROVE, &args, stdin.as_bytes(), Some(&dir), &env);
+        let err = String::from_utf8_lossy(&o.stderr).into_owned();
+        if *fault == "panic" {
+            // Windows: the panic hook of no_crash_dumps ends the process
+            // with TerminateProcess and exit code 3, in every profile.
+            // Elsewhere: SIGABRT with the `cli` profile (panic = "abort"),
+            // exit 101 when unwinding (test profiles).
+            if cfg!(windows) {
+                assert_eq!(o.code, 3, "panic: {:?} {:?}", o.code, o.signal);
+            } else {
+                let aborted = o.signal == Some(6);
+                assert!(
+                    aborted || (o.code == 101 && !expect_abort),
+                    "panic: {:?} {:?} (expect abort: {expect_abort})",
+                    o.code,
+                    o.signal
+                );
+            }
+            assert!(err.contains("fault injection: panic inside prove"), "{err}");
+        } else {
+            assert_eq!(o.code, *want, "{fault}: {err}");
+        }
+        let files = all_files(&dir);
+        let names: Vec<String> = files
+            .iter()
+            .map(|(p, _)| p.strip_prefix(&dir).unwrap().display().to_string())
+            .collect();
+        match *fault {
+            "" => {
+                assert_eq!(names, ["proof.bin"], "{fault}");
+                assert_eq!(o.stdout, format!("y={}\n", c.y_hex).as_bytes());
+            }
+            "write,remove" | "publish,remove" => {
+                // The temporary file stays, the error names it.
+                assert_eq!(names.len(), 1, "{fault}: {names:?}");
+                assert!(names[0].starts_with(".proof.bin.") && names[0].ends_with(".tmp"));
+                assert!(err.contains("could not be removed"), "{fault}: {err}");
+                assert!(err.contains(&names[0]), "{fault}: {err}");
+                assert!(o.stdout.is_empty());
+            }
+            _ => {
+                assert!(names.is_empty(), "{fault}: {names:?}");
+                assert!(o.stdout.is_empty());
+            }
+        }
+        let mut outputs: Vec<(&str, &[u8])> = vec![("stdout", &o.stdout), ("stderr", &o.stderr)];
+        for (p, data) in &files {
+            outputs.push((p.to_str().unwrap(), data));
+        }
+        assert_clean(&[&x, &rho], &outputs);
+    }
+}
+
+/// `--require-mlock` (Linux): locks memory before reading and proves, or,
+/// where the memory limit is too low for an unprivileged user, fails with
+/// exit 1 before reading anything. Elsewhere it is a usage error.
+#[test]
+fn require_mlock() {
+    let c = case();
+    let out = tmp("mlock.bin");
+    let mut args = prove_args(&c, out.to_str().unwrap());
+    args.push("--require-mlock");
+    let p = run(PROVE, &args, format!("{}\n", c.x_hex).as_bytes());
+    let err = String::from_utf8_lossy(&p.stderr).into_owned();
+    if cfg!(target_os = "linux") {
+        if p.code == 0 {
+            assert_eq!(p.stdout, format!("y={}\n", c.y_hex).as_bytes());
+            assert!(out.exists());
+        } else {
+            assert_eq!(p.code, 1, "{err}");
+            assert!(err.contains("nothing read"), "{err}");
+            assert!(!out.exists());
+        }
+    } else {
+        assert_eq!(p.code, 2, "{err}");
+    }
+    assert_no_seed(&c.x_hex, &[&p.stdout, &p.stderr]);
+}
+
+/// A build with the test-only feature fault-injection refuses to run
+/// without VOLEITH_ALLOW_FAULT_INJECTION=tests (or with another value): exit
+/// 1, a message on standard error, nothing read or written.
+#[cfg(feature = "fault-injection")]
+#[test]
+fn fault_injection_build_refuses_to_run() {
+    let c = case();
+    for value in [None, Some(""), Some("1"), Some("test"), Some("TESTS")] {
+        let dir = fresh_dir("refuse");
+        let mut cmd = Command::new(PROVE);
+        cmd.args(prove_args(&c, "proof.bin"))
+            .current_dir(&dir)
+            .env_remove("VOLEITH_ALLOW_FAULT_INJECTION")
+            .env("VOLEITH_FAULT", "rng")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped());
+        if let Some(v) = value {
+            cmd.env("VOLEITH_ALLOW_FAULT_INJECTION", v);
+        }
+        let mut child = cmd.spawn().unwrap();
+        {
+            use std::io::Write;
+            let _ = child
+                .stdin
+                .take()
+                .unwrap()
+                .write_all(format!("{}\n", c.x_hex).as_bytes());
+        }
+        let o = child.wait_with_output().unwrap();
+        let err = String::from_utf8_lossy(&o.stderr);
+        assert_eq!(o.status.code(), Some(1), "{value:?}: {err}");
+        assert!(o.stdout.is_empty());
+        assert!(err.contains("test-only feature fault-injection"), "{err}");
+        assert!(all_files(&dir).is_empty(), "{value:?}");
+        assert_no_seed(&c.x_hex, &[&o.stdout, &o.stderr]);
+    }
+}
diff --git a/src/rescue/voleith/tests/cold_reject.rs b/src/rescue/voleith/tests/cold_reject.rs
new file mode 100644
index 0000000..4f5a600
--- /dev/null
+++ b/src/rescue/voleith/tests/cold_reject.rs
@@ -0,0 +1,86 @@
+//! Malformed inputs are rejected before the statement circuit is built
+//! (SPEC.md §11: steps 1–6 need only fixed sizes). This file holds a single
+//! test, so nothing else in its process builds the circuit first.
+
+use voleith::circuit_info::circuit_is_built;
+use voleith::params::VERSION;
+use voleith::STATEMENT1_ID;
+
+#[test]
+fn format_checks_do_not_build_the_circuit() {
+    assert!(!circuit_is_built(STATEMENT1_ID));
+    let len = voleith::proof_length(STATEMENT1_ID).expect("registered");
+    assert_eq!(len, 130_218);
+    let key = b"ark0-wallet v1 schnorr";
+    let y = [7u8; 32];
+    let pub_inputs = voleith::s1_encode_public(key, 0, &y).unwrap();
+    let msg = [0u8; 96];
+    let long_msg = vec![0u8; 65_536];
+    // A proof with a valid header, zero padding and a zero body: it passes
+    // steps 1-6 and fails only at the final comparison.
+    let mut proof = vec![0u8; len];
+    proof[0] = VERSION;
+    proof[1] = STATEMENT1_ID;
+    let edit = |off: usize, v: u8| {
+        let mut p = proof.clone();
+        p[off] = v;
+        p
+    };
+    let reject = |what: &str, sid: u8, p: &[u8], m: &[u8], pr: &[u8]| {
+        assert!(!voleith::verify(sid, p, m, pr), "{what}");
+        assert!(!circuit_is_built(STATEMENT1_ID), "{what} built the circuit");
+    };
+    reject("unknown statement id", 2, &pub_inputs, &msg, &proof);
+    reject("public inputs", 1, &pub_inputs[1..], &msg, &proof);
+    reject("message too long", 1, &pub_inputs, &long_msg, &proof);
+    reject("empty proof", 1, &pub_inputs, &msg, &[]);
+    reject("short proof", 1, &pub_inputs, &msg, &proof[..len - 1]);
+    reject("version byte", 1, &pub_inputs, &msg, &edit(0, 0x01));
+    reject("statement id byte", 1, &pub_inputs, &msg, &edit(1, 0x02));
+    // The last byte of c_1 holds one padding bit (bit 7), as does d's.
+    reject(
+        "padding bit of c_1",
+        1,
+        &pub_inputs,
+        &msg,
+        &edit(18 + 5_306, 0x80),
+    );
+    reject(
+        "padding bit of d",
+        1,
+        &pub_inputs,
+        &msg,
+        &edit(122_111 + 5_258, 0x80),
+    );
+
+    // The C ABI, with a wrong proof length.
+    // SAFETY: every pointer comes from a live slice of at least the stated
+    // length.
+    let r = unsafe {
+        voleith::ffi::voleith_verify_s1(
+            key.as_ptr(),
+            key.len(),
+            0,
+            y.as_ptr(),
+            msg.as_ptr(),
+            msg.len(),
+            proof.as_ptr(),
+            len - 1,
+        )
+    };
+    assert_eq!(r, 0);
+    // The prover's input checks: unknown id, witness length, relation.
+    #[cfg(feature = "prover")]
+    {
+        let x = [1u8; 32];
+        let rho = [0u8; 32];
+        assert!(voleith::prove(2, &pub_inputs, &x, &msg, &rho).is_err());
+        assert!(voleith::prove(1, &pub_inputs, &x[..31], &msg, &rho).is_err());
+        assert!(voleith::prove(1, &pub_inputs, &x, &msg, &rho).is_err());
+        assert!(!circuit_is_built(STATEMENT1_ID), "prove built the circuit");
+    }
+
+    // A structurally valid proof costs a full verification.
+    assert!(!voleith::verify(1, &pub_inputs, &msg, &proof));
+    assert!(circuit_is_built(STATEMENT1_ID));
+}
diff --git a/src/rescue/voleith/tests/common/mod.rs b/src/rescue/voleith/tests/common/mod.rs
new file mode 100644
index 0000000..addd17d
--- /dev/null
+++ b/src/rescue/voleith/tests/common/mod.rs
@@ -0,0 +1,94 @@
+//! Helpers shared by the integration tests: JSON vectors, hex and base64.
+
+#![allow(dead_code)]
+
+use serde_json::Value;
+
+pub fn vectors_dir() -> std::path::PathBuf {
+    std::path::Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("..")
+        .join("vectors")
+}
+
+pub fn load_json(name: &str) -> Value {
+    let path = vectors_dir().join(name);
+    let text =
+        std::fs::read_to_string(&path).unwrap_or_else(|e| panic!("read {}: {e}", path.display()));
+    serde_json::from_str(&text).expect("valid JSON")
+}
+
+pub fn hex(s: &str) -> Vec<u8> {
+    assert!(s.len() % 2 == 0, "odd hex length");
+    (0..s.len())
+        .step_by(2)
+        .map(|i| u8::from_str_radix(&s[i..i + 2], 16).expect("hex digit"))
+        .collect()
+}
+
+pub fn to_hex(b: &[u8]) -> String {
+    b.iter().map(|x| format!("{x:02x}")).collect()
+}
+
+pub fn base64(s: &str) -> Vec<u8> {
+    fn val(c: u8) -> u32 {
+        match c {
+            b'A'..=b'Z' => (c - b'A') as u32,
+            b'a'..=b'z' => (c - b'a') as u32 + 26,
+            b'0'..=b'9' => (c - b'0') as u32 + 52,
+            b'+' => 62,
+            b'/' => 63,
+            _ => panic!("bad base64 character {c}"),
+        }
+    }
+    let s = s.as_bytes();
+    assert!(s.len() % 4 == 0, "base64 length");
+    let mut out = Vec::with_capacity(s.len() / 4 * 3);
+    for chunk in s.chunks_exact(4) {
+        let pad = chunk.iter().rev().take_while(|&&c| c == b'=').count();
+        let mut n = 0u32;
+        for &c in &chunk[..4 - pad] {
+            n = (n << 6) | val(c);
+        }
+        n <<= 6 * pad as u32;
+        let bytes = [(n >> 16) as u8, (n >> 8) as u8, n as u8];
+        out.extend_from_slice(&bytes[..3 - pad]);
+    }
+    out
+}
+
+pub fn str_of<'a>(v: &'a Value, key: &str) -> &'a str {
+    v[key]
+        .as_str()
+        .unwrap_or_else(|| panic!("field {key} is not a string"))
+}
+
+pub fn u64_of(v: &Value, key: &str) -> u64 {
+    v[key]
+        .as_u64()
+        .unwrap_or_else(|| panic!("field {key} is not an integer"))
+}
+
+/// Apply the proof edits of the vector files (xor, set, truncate, append,
+/// prepend) in order.
+pub fn apply_edit(proof: &mut Vec<u8>, edit: &Value) {
+    match str_of(edit, "op") {
+        "none" => {}
+        "xor" => {
+            let off = u64_of(edit, "offset") as usize;
+            proof[off] ^= hex(str_of(edit, "mask"))[0];
+        }
+        "set" => {
+            let off = u64_of(edit, "offset") as usize;
+            let data = hex(str_of(edit, "data"));
+            proof[off..off + data.len()].copy_from_slice(&data);
+        }
+        "truncate" => proof.truncate(u64_of(edit, "length") as usize),
+        "append" => proof.extend_from_slice(&hex(str_of(edit, "data"))),
+        "prepend" => {
+            let mut data = hex(str_of(edit, "data"));
+            data.extend_from_slice(proof);
+            *proof = data;
+        }
+        op => panic!("unknown edit {op}"),
+    }
+}
diff --git a/src/rescue/voleith/tests/differential.rs b/src/rescue/voleith/tests/differential.rs
