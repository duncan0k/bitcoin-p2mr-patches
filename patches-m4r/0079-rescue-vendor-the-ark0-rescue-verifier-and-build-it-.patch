@@ -0,0 +1,393 @@
+//! Single-threaded timings for NOTES.md: verification under several tree
+//! splits, interleaved with a libsecp256k1 BIP-340 Schnorr baseline in the
+//! same binary, and the validation-weight rule of the v0.2 decision.
+//!
+//! Besides the valid proof with a 96-byte message, each split is timed on
+//! three other inputs: that proof with chall3 = ff..ff (it passes the format
+//! checks, so it costs a full verification, and a Delta with every bit set
+//! maximises the conditional XORs), a valid proof over a 65,535-byte
+//! message, and that proof with chall3 = ff..ff.
+//!
+//! Run: `cargo bench --features bench-splits --bench verify --
+//! [--taus 22,24] [--runs 1000] [--schnorr 20000]`
+
+use std::hint::black_box;
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use secp256k1::{Keypair, Secp256k1};
+use sha3::digest::{ExtendableOutput, Update, XofReader};
+use voleith::params::{TreeSplit, MAX_MESSAGE_LEN};
+
+fn utc_now() -> String {
+    let s = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_secs();
+    format!("{:02}:{:02}:{:02}Z", (s / 3600) % 24, (s / 60) % 60, s % 60)
+}
+
+struct Stats {
+    n: usize,
+    median: Duration,
+    p99: Duration,
+    min: Duration,
+    max: Duration,
+}
+
+fn stats(mut v: Vec<Duration>) -> Stats {
+    v.sort();
+    let n = v.len();
+    let pct = |p: f64| v[((p * n as f64).ceil() as usize).clamp(1, n) - 1];
+    Stats {
+        n,
+        median: pct(0.5),
+        p99: pct(0.99),
+        min: v[0],
+        max: v[n - 1],
+    }
+}
+
+fn ms(d: Duration) -> f64 {
+    d.as_secs_f64() * 1e3
+}
+
+fn us(d: Duration) -> f64 {
+    d.as_secs_f64() * 1e6
+}
+
+fn cpu_info() {
+    let Ok(text) = std::fs::read_to_string("/proc/cpuinfo") else {
+        println!("cpu: /proc/cpuinfo not readable");
+        return;
+    };
+    let field = |name: &str| {
+        text.lines()
+            .find(|l| l.starts_with(name))
+            .and_then(|l| l.split_once(':'))
+            .map(|(_, v)| v.trim().to_string())
+            .unwrap_or_default()
+    };
+    println!("cpu: {}", field("model name"));
+    let flags = field("flags");
+    let have: Vec<&str> = [
+        "avx2",
+        "avx512f",
+        "avx512vl",
+        "sha_ni",
+        "aes",
+        "vaes",
+        "pclmulqdq",
+        "vpclmulqdq",
+        "bmi2",
+    ]
+    .into_iter()
+    .filter(|f| flags.split_whitespace().any(|x| x == *f))
+    .collect();
+    println!("cpu flags (of interest): {}", have.join(" "));
+}
+
+fn arg_value<'a>(args: &'a [String], name: &str) -> Option<&'a str> {
+    args.iter()
+        .position(|a| a == name)
+        .and_then(|i| args.get(i + 1))
+        .map(|s| s.as_str())
+}
+
+/// One timed input: a proof under a split, with its message.
+struct Case<'a> {
+    label: &'static str,
+    split: TreeSplit,
+    message: &'a [u8],
+    proof: Vec<u8>,
+    valid: bool,
+}
+
+/// The proof with its last 16 bytes, chall3, set to ff..ff.
+fn chall3_all_ones(proof: &[u8]) -> Vec<u8> {
+    let mut p = proof.to_vec();
+    let n = p.len();
+    p[n - 16..].fill(0xff);
+    p
+}
+
+fn main() {
+    let args: Vec<String> = std::env::args().collect();
+    let taus: Vec<usize> = arg_value(&args, "--taus")
+        .unwrap_or("22,24")
+        .split(',')
+        .map(|t| t.parse().expect("tau"))
+        .collect();
+    let runs: usize = arg_value(&args, "--runs")
+        .map(|v| v.parse().expect("runs"))
+        .unwrap_or(1000)
+        .max(200);
+    let schnorr_runs: usize = arg_value(&args, "--schnorr")
+        .map(|v| v.parse().expect("schnorr runs"))
+        .unwrap_or(20_000)
+        .max(10_000);
+    let splits: Vec<TreeSplit> = taus
+        .iter()
+        .map(|&t| TreeSplit::for_tau(t).expect("supported tau"))
+        .collect();
+    println!("start {}", utc_now());
+    cpu_info();
+    println!(
+        "compiled with target features: sse4.1={} avx2={} bmi2={} pclmulqdq={} avx512f={}",
+        cfg!(target_feature = "sse4.1"),
+        cfg!(target_feature = "avx2"),
+        cfg!(target_feature = "bmi2"),
+        cfg!(target_feature = "pclmulqdq"),
+        cfg!(target_feature = "avx512f")
+    );
+
+    // One statement 0x01 instance; one proof per split from the crate's prover.
+    let key = b"ark0-wallet v1 schnorr";
+    let suffix = 0u8;
+    let x = voleith::hash::sha256(b"voleith bench seed");
+    let mut xs = x.to_vec();
+    xs.push(suffix);
+    let y = voleith::hash::hmac_sha256(key, &xs);
+    let pub_inputs = voleith::s1_encode_public(key, suffix, &y).unwrap();
+    let mut msg = Vec::new();
+    for part in [
+        &b"bench sighash"[..],
+        b"bench network id",
+        b"bench public key",
+    ] {
+        msg.extend_from_slice(&voleith::hash::sha256(part));
+    }
+    let long_msg: Vec<u8> = (0..MAX_MESSAGE_LEN).map(|i| (i % 251) as u8).collect();
+    let rho = [7u8; 32];
+    let t = Instant::now();
+    let _ = voleith::circuit_info::statement_circuit_info(1);
+    println!(
+        "circuit build and digest (once per process): {:.3} ms",
+        ms(t.elapsed())
+    );
+    let mut proofs = Vec::new();
+    let mut cases = Vec::new();
+    for &s in &splits {
+        let t = Instant::now();
+        let p = voleith::bench::prove(s, 1, &pub_inputs, &x, &msg, &rho).unwrap();
+        let dt = t.elapsed();
+        assert_eq!(Some(p.len()), voleith::bench::proof_length(s, 1));
+        assert!(voleith::bench::verify(s, 1, &pub_inputs, &msg, &p));
+        let digest: String = voleith::hash::sha256(&p)
+            .iter()
+            .map(|b| format!("{b:02x}"))
+            .collect();
+        println!(
+            "tau {:2} {:?}: proof {} bytes, sha256 {}, prove {:.1} ms",
+            s.tau(),
+            s.shape(),
+            p.len(),
+            digest,
+            ms(dt)
+        );
+        for _ in 0..5 {
+            assert!(voleith::bench::verify(s, 1, &pub_inputs, &msg, &p));
+        }
+        let long = voleith::bench::prove(s, 1, &pub_inputs, &x, &long_msg, &rho).unwrap();
+        assert!(voleith::bench::verify(s, 1, &pub_inputs, &long_msg, &long));
+        cases.push(Case {
+            label: "valid",
+            split: s,
+            message: &msg,
+            proof: p.clone(),
+            valid: true,
+        });
+        cases.push(Case {
+            label: "chall3 ff..ff",
+            split: s,
+            message: &msg,
+            proof: chall3_all_ones(&p),
+            valid: false,
+        });
+        cases.push(Case {
+            label: "max message",
+            split: s,
+            message: &long_msg,
+            proof: long.clone(),
+            valid: true,
+        });
+        cases.push(Case {
+            label: "max message, chall3 ff..ff",
+            split: s,
+            message: &long_msg,
+            proof: chall3_all_ones(&long),
+            valid: false,
+        });
+        proofs.push(p);
+    }
+
+    // Raw SHAKE256 speed, for context: 4,080 outputs of 5,307 bytes.
+    let mut buf = vec![0u8; 5307];
+    let mut v = Vec::new();
+    for _ in 0..7 {
+        let t = Instant::now();
+        for j in 0..4080u32 {
+            let mut h = sha3::Shake256::default();
+            h.update(b"\x17VOLEitH-rescue/v0.2/exp");
+            h.update(&j.to_le_bytes());
+            h.finalize_xof().read(&mut buf);
+            black_box(&buf);
+        }
+        v.push(t.elapsed());
+    }
+    let s = stats(v);
+    println!(
+        "SHAKE256: {:.0} MB/s",
+        4080.0 * 5307.0 / s.median.as_secs_f64() / 1e6
+    );
+
+    // Every case, interleaved, in four segments with a quarter of the
+    // Schnorr runs after each.
+    let secp = Secp256k1::new();
+    let kp = Keypair::from_seckey_byte_array(&secp, [0x42u8; 32]).unwrap();
+    let (xonly, _) = kp.x_only_public_key();
+    let smsg = [0x5au8; 32];
+    let sig = secp.sign_schnorr_no_aux_rand(&smsg, &kp);
+    for _ in 0..1000 {
+        assert!(secp.verify_schnorr(&sig, &smsg, &xonly).is_ok());
+    }
+    let mut times: Vec<Vec<Duration>> = vec![Vec::with_capacity(runs); cases.len()];
+    let mut sch = Vec::with_capacity(schnorr_runs);
+    for seg in 0..4 {
+        for r in seg * runs / 4..(seg + 1) * runs / 4 {
+            for k in 0..cases.len() {
+                let i = (r + k) % cases.len();
+                let c = &cases[i];
+                let t = Instant::now();
+                let ok = voleith::bench::verify(
+                    c.split,
+                    black_box(1),
+                    black_box(&pub_inputs),
+                    black_box(c.message),
+                    black_box(&c.proof),
+                );
+                times[i].push(t.elapsed());
+                assert_eq!(ok, c.valid, "{}", c.label);
+            }
+        }
+        for _ in seg * schnorr_runs / 4..(seg + 1) * schnorr_runs / 4 {
+            let t = Instant::now();
+            let ok = secp
+                .verify_schnorr(black_box(&sig), black_box(&smsg), black_box(&xonly))
+                .is_ok();
+            sch.push(t.elapsed());
+            assert!(ok);
+        }
+    }
+    let sch = stats(sch);
+    println!(
+        "libsecp256k1 BIP-340 Schnorr verify: n={} median {:.3} us  p99 {:.3} us  min {:.3}",
+        sch.n,
+        us(sch.median),
+        us(sch.p99),
+        us(sch.min)
+    );
+
+    // Rejections that fail only at the final comparison (full work).
+    for (i, s) in splits.iter().enumerate() {
+        let p = &proofs[i];
+        let lay_len = p.len();
+        let off_chall3 = lay_len - 16;
+        let off_a_tilde = 2 + 16 + (s.tau() - 1) * 5307 + 32 + 5259;
+        let mut flipped_a = p.clone();
+        flipped_a[off_a_tilde + 3] ^= 1;
+        let mut flipped_c = p.clone();
+        flipped_c[off_chall3 + 5] ^= 0x10;
+        let mut worst = Duration::ZERO;
+        let mut med = Duration::ZERO;
+        for bad in [&flipped_a, &flipped_c] {
+            let mut v = Vec::new();
+            for _ in 0..100 {
+                let t = Instant::now();
+                let ok = voleith::bench::verify(*s, 1, &pub_inputs, &msg, black_box(bad));
+                v.push(t.elapsed());
+                assert!(!ok);
+            }
+            let st = stats(v);
+            worst = worst.max(st.p99);
+            med = med.max(st.median);
+        }
+        println!(
+            "tau {:2}: rejection at the final check: median {:.3} ms, p99 {:.3} ms",
+            s.tau(),
+            ms(med),
+            ms(worst)
+        );
+    }
+
+    // The rule: C = 1.25 * 50 * p99 / median(Schnorr) <= budget / 1.5,
+    // budget = proof bytes + 50.
+    let weight = |p99: Duration| 1.25 * 50.0 * p99.as_secs_f64() / sch.median.as_secs_f64();
+    println!("tau | shape | proof bytes | verify median | verify p99 | Schnorr median | C | budget | margin | C <= budget/1.5");
+    for (i, c) in cases.iter().enumerate().filter(|(_, c)| c.label == "valid") {
+        let s = c.split;
+        let st = stats(times[i].clone());
+        let c_w = weight(st.p99);
+        let budget = (c.proof.len() + 50) as f64;
+        println!(
+            "{} | {:?} | {} | {:.3} ms | {:.3} ms | {:.3} us | {:.0} | {:.0} | {:.2} | {}",
+            s.tau(),
+            s.shape(),
+            c.proof.len(),
+            ms(st.median),
+            ms(st.p99),
+            us(sch.median),
+            c_w,
+            budget,
+            budget / c_w,
+            c_w <= budget / 1.5
+        );
+        println!(
+            "SUMMARY {{\"tau\":{},\"n\":{},\"proof_bytes\":{},\"verify_median_ms\":{:.3},\"verify_p99_ms\":{:.3},\"verify_min_ms\":{:.3},\"verify_max_ms\":{:.3},\"schnorr_median_us\":{:.3},\"C\":{:.0},\"budget\":{:.0},\"margin\":{:.3},\"qualifies\":{}}}",
+            s.tau(),
+            st.n,
+            c.proof.len(),
+            ms(st.median),
+            ms(st.p99),
+            ms(st.min),
+            ms(st.max),
+            us(sch.median),
+            c_w,
+            budget,
+            budget / c_w,
+            c_w <= budget / 1.5
+        );
+    }
+
+    // Every case, with C from its own p99 against the same budget.
+    println!("tau | case | message bytes | n | median | p99 | max | C | budget / C");
+    for (i, c) in cases.iter().enumerate() {
+        let st = stats(times[i].clone());
+        let c_w = weight(st.p99);
+        let budget = (c.proof.len() + 50) as f64;
+        println!(
+            "{} | {} | {} | {} | {:.3} ms | {:.3} ms | {:.3} ms | {:.0} | {:.2}",
+            c.split.tau(),
+            c.label,
+            c.message.len(),
+            st.n,
+            ms(st.median),
+            ms(st.p99),
+            ms(st.max),
+            c_w,
+            budget / c_w
+        );
+        println!(
+            "CASE {{\"tau\":{},\"case\":\"{}\",\"message_bytes\":{},\"n\":{},\"median_ms\":{:.3},\"p99_ms\":{:.3},\"max_ms\":{:.3},\"C\":{:.0},\"margin\":{:.3}}}",
+            c.split.tau(),
+            c.label,
+            c.message.len(),
+            st.n,
+            ms(st.median),
+            ms(st.p99),
+            ms(st.max),
+            c_w,
+            budget / c_w
+        );
+    }
+    println!("end {}", utc_now());
+}
diff --git a/src/rescue/voleith/build-windows.sh b/src/rescue/voleith/build-windows.sh
new file mode 100644
index 0000000..aa0d15f
--- /dev/null
+++ b/src/rescue/voleith/build-windows.sh
@@ -0,0 +1,400 @@
+#!/usr/bin/env bash
+# Cross-compiles voleith-prove.exe and voleith-verify.exe for
+# x86_64-pc-windows-gnu from Linux, reproducibly (README.md, "Windows").
+#
+# The hashes in NOTES.md are claimed for this environment, which the script
+# checks and refuses to build without:
+# - Ubuntu 24.04 (x86_64) packages, exact versions: gcc-mingw-w64-x86-64-win32
+#   13.2.0-6ubuntu1+26.1, gcc-mingw-w64-base 13.2.0-6ubuntu1+26.1,
+#   binutils-mingw-w64-x86-64 2.41.90.20240122-1ubuntu1+11.4,
+#   mingw-w64-x86-64-dev 11.0.1-3build1;
+# - the rustup toolchain 1.97.0 (rustc 2d8144b78 2026-07-07) with the target
+#   x86_64-pc-windows-gnu (rust-toolchain.toml in windows/);
+# - no cargo configuration file in any directory above the build directory
+#   or in CARGO_HOME;
+# - the tools that run, by absolute path, each owned by its package
+#   (dpkg -S) and listed with its SHA-256 (TOOLS below): the mingw-w64
+#   linker driver (rustc's linker), its collect2 and ld, dlltool (rustc's
+#   -Cdlltool, for getrandom's raw-dylib import) and the as it calls, and
+#   the host gcc, collect2 and ld that link getrandom's build script (their
+#   versions are recorded, not required: the build script only prints cfg
+#   lines). A tool that is a symbolic link must resolve to a file of the
+#   same package.
+# Before build 1, every allowed tool and the toolchain directory are
+# pinned: for a tool, the path, the file it resolves to, and that file's
+# device, inode and SHA-256; for the directory, the path, what it resolves
+# to, and its device and inode (no hash: its contents are the toolchain's,
+# checked by version and commit above). Both builds are checked against
+# the pins, and at the end nothing pinned may have changed. Both builds run under strace (execve and execveat, with -f,
+# exits written), and windows/exec_trace.py fails the build if the trace
+# shows a program other than the pinned tools, the toolchain's own and the
+# build scripts, if any line cannot be parsed (split unfinished/resumed
+# lines are joined per PID), or if it does not start with cargo's exec and
+# end with its exit 0; strace's status must be 0 and none of its own
+# messages may appear on standard error (compiler warnings may). strace
+# (/usr/bin/strace, package strace) is required: without it the script
+# refuses, unless --unpublished says that the hashes of this build will
+# not be published.
+#
+# Threat model: these checks catch an accidentally contaminated build
+# environment (a stray tool on PATH, a cargo configuration, another
+# toolchain or package version, a fault-injection build, a local path in a
+# binary) on a build machine that nobody else writes to during the build.
+# They do not defend against someone who can change that machine during
+# the build (fill the disk under the trace, swap a tool and back, edit the
+# trace): whoever can do that can as well replace the compiler.
+# cargo runs under `env -i` with a fixed environment: RUSTUP_TOOLCHAIN,
+# LC_ALL=C, TZ=UTC, SOURCE_DATE_EPOCH=0, the rustflags below, the linker,
+# and nothing else that cargo or rustc reads (no RUSTFLAGS, CARGO_BUILD_*,
+# CARGO_PROFILE_*, CARGO_TARGET_*, RUSTC_WRAPPER, CC, ...). Only the
+# network settings for downloading crates pass through (proxy variables and
+# CA files); `--locked` pins every crate by checksum.
+#
+# Usage: bash rust/build-windows.sh [--unpublished] [out dir]
+#   (default out dir rust/target/windows-out)
+# Builds twice, each time from an empty target directory, checks that the
+# two builds are byte-identical, copies the .exe files to the out dir and
+# prints their SHA-256. Every local path that could enter the binaries
+# (this checkout, the target directory, CARGO_HOME, RUSTUP_HOME) is
+# remapped, the linker writes no timestamp into the PE header, and the
+# symbol table is stripped.
+set -euo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd -P)
+OUT=
+UNPUBLISHED=0
+for a in "$@"; do
+  case "$a" in
+    --unpublished) UNPUBLISHED=1 ;;
+    -*)
+      echo "build-windows.sh: unknown option $a" >&2
+      exit 2
+      ;;
+    *)
+      if [ -n "$OUT" ]; then
+        echo "build-windows.sh: one out dir only" >&2
+        exit 2
+      fi
+      OUT=$a
+      ;;
+  esac
+done
+OUT=${OUT:-$HERE/target/windows-out}
+# Overridable only to test the refusal: a published build needs the file
+# to belong to the package strace.
+STRACE=${WINDOWS_BUILD_STRACE:-/usr/bin/strace}
+PYTHON=/usr/bin/python3
+# Where the two build directories go (check-windows-shadowing.sh moves them).
+BASE=${WINDOWS_BUILD_BASE:-$HERE/target}
+TARGET=x86_64-pc-windows-gnu
+TOOLCHAIN=1.97.0
+RUSTC_COMMIT=2d8144b7880597b6e6d3dfd63a9a9efae3f533d3
+LINKER=/usr/bin/x86_64-w64-mingw32-gcc-win32
+DLLTOOL=/usr/bin/x86_64-w64-mingw32-dlltool
+HOST_CC=/usr/bin/x86_64-linux-gnu-gcc-13
+# path|owning package[|package of the link target, if it differs]
+TOOLS=(
+  "$LINKER|gcc-mingw-w64-x86-64-win32"
+  "/usr/lib/gcc/x86_64-w64-mingw32/13-win32/collect2|gcc-mingw-w64-x86-64-win32"
+  "/usr/bin/x86_64-w64-mingw32-ld|binutils-mingw-w64-x86-64"
+  "$DLLTOOL|binutils-mingw-w64-x86-64"
+  "/usr/bin/x86_64-w64-mingw32-as|binutils-mingw-w64-x86-64"
+  "$HOST_CC|gcc-13-x86-64-linux-gnu"
+  "/usr/libexec/gcc/x86_64-linux-gnu/13/collect2|gcc-13-x86-64-linux-gnu"
+  "/usr/bin/ld|binutils|binutils-x86-64-linux-gnu"
+)
+PACKAGES=(
+  "gcc-mingw-w64-x86-64-win32 13.2.0-6ubuntu1+26.1"
+  "gcc-mingw-w64-base 13.2.0-6ubuntu1+26.1"
+  "binutils-mingw-w64-x86-64 2.41.90.20240122-1ubuntu1+11.4"
+  "mingw-w64-x86-64-dev 11.0.1-3build1"
+)
+CARGO_HOME=${CARGO_HOME:-$HOME/.cargo}
+RUSTUP_HOME=${RUSTUP_HOME:-$HOME/.rustup}
+CARGO_HOME=$(cd "$CARGO_HOME" && pwd -P)
+RUSTUP_HOME=$(cd "$RUSTUP_HOME" && pwd -P)
+ROOT=$(cd "$HERE/.." && pwd -P)
+BINS=(voleith-prove voleith-verify)
+BUILD_DIR=$HERE/windows
+
+refuse() {
+  echo "build-windows.sh: $*; not building" >&2
+  exit 1
+}
+
+# The mingw-w64 packages.
+command -v dpkg-query > /dev/null || refuse "dpkg-query not found (the recorded environment is Ubuntu 24.04)"
+for p in "${PACKAGES[@]}"; do
+  name=${p%% *}
+  want=${p#* }
+  have=$(dpkg-query -W -f='${Version}' "$name" 2> /dev/null || true)
+  [ "$have" = "$want" ] || refuse "$name is '${have:-not installed}', the hashes are for $want"
+done
+
+# The exec trace, required for a build whose hashes are published.
+TRACED=1
+if [ -x "$STRACE" ] && [ "$(dpkg -S "$STRACE" 2> /dev/null | cut -d: -f1 || true)" = strace ]; then
+  :
+elif [ "$UNPUBLISHED" = 1 ]; then
+  TRACED=0
+  echo "build-windows.sh: no $STRACE from package strace: building UNTRACED (--unpublished)" >&2
+else
+  refuse "$STRACE (package strace) is required to trace the build; use --unpublished for a build whose hashes are not published"
+fi
+[ -x "$PYTHON" ] || refuse "$PYTHON not found"
+
+# No cargo configuration that could change the build.
+d=$BUILD_DIR
+while :; do
+  for f in "$d/.cargo/config" "$d/.cargo/config.toml"; do
+    if [ -e "$f" ]; then refuse "$f exists"; fi
+  done
+  if [ "$d" = / ]; then break; fi
+  d=$(dirname "$d")
+done
+for f in "$CARGO_HOME/config" "$CARGO_HOME/config.toml"; do
+  if [ -e "$f" ]; then refuse "$f exists"; fi
+done
+
+# The tools: absolute paths, owned by the expected packages.
+for t in "${TOOLS[@]}"; do
+  IFS='|' read -r f pkg tpkg <<< "$t"
+  [ -x "$f" ] || refuse "$f not found"
+  for g in "$f|$pkg" "$(readlink -f "$f")|${tpkg:-$pkg}"; do
+    owner=$(dpkg -S "${g%%|*}" 2> /dev/null | cut -d: -f1 || true)
+    [ "$owner" = "${g#*|}" ] || refuse "${g%%|*} belongs to '${owner:-no package}', not ${g#*|}"
+  done
+done
+# The linker drivers find collect2 and ld (or the host's collect2) in their
+# own directories, not on PATH; check that they resolve to the listed files.
+[ "$(env -i "$LINKER" -print-prog-name=collect2)" = /usr/lib/gcc/x86_64-w64-mingw32/13-win32/collect2 ] ||
+  refuse "$LINKER does not use the listed collect2"
+[ "$(readlink -f "$(env -i "$LINKER" -print-prog-name=ld)")" = /usr/bin/x86_64-w64-mingw32-ld ] ||
+  refuse "$LINKER does not use the listed ld"
+[ "$(env -i "$HOST_CC" -print-prog-name=collect2)" = /usr/libexec/gcc/x86_64-linux-gnu/13/collect2 ] ||
+  refuse "$HOST_CC does not use the listed collect2"
+
+# The fixed environment of every cargo and rustc run. PATH has system
+# directories only; cargo and rustup are called by absolute path.
+CLEAN_ENV=(
+  "PATH=/usr/bin:/bin"
+  "HOME=$HOME"
+  "CARGO_HOME=$CARGO_HOME"
+  "RUSTUP_HOME=$RUSTUP_HOME"
+  "RUSTUP_TOOLCHAIN=$TOOLCHAIN"
+  "LC_ALL=C"
+  "TZ=UTC"
+  "SOURCE_DATE_EPOCH=0"
+)
+for v in HTTPS_PROXY https_proxy HTTP_PROXY http_proxy NO_PROXY no_proxy \
+  SSL_CERT_FILE CARGO_HTTP_CAINFO; do
+  if [ -n "${!v:-}" ]; then CLEAN_ENV+=("$v=${!v}"); fi
+done
+clean() { (cd "$BUILD_DIR" && env -i "${CLEAN_ENV[@]}" "$@"); }
+CARGO=$CARGO_HOME/bin/cargo
+RUSTUP=$CARGO_HOME/bin/rustup
+RUSTC=$CARGO_HOME/bin/rustc
+
+# The toolchain, exactly.
+clean "$RUSTUP" toolchain install "$TOOLCHAIN" --profile minimal --target "$TARGET" > /dev/null 2>&1 ||
+  refuse "cannot install the toolchain $TOOLCHAIN with $TARGET"
+vv=$(clean "$RUSTC" -vV) || refuse "rustc -vV failed"
+grep -qx "release: $TOOLCHAIN" <<< "$vv" || refuse "rustc is not $TOOLCHAIN"
+grep -qx "commit-hash: $RUSTC_COMMIT" <<< "$vv" || refuse "rustc is not commit $RUSTC_COMMIT"
+# No pipe into an early-exiting grep: under pipefail its exit could make
+# the writer die of SIGPIPE and the pipeline report a failure.
+targets=$(clean "$RUSTUP" target list --installed) || refuse "cannot list the installed targets"
+grep -qxF "$TARGET" <<< "$targets" || refuse "target $TARGET not installed"
+clean "$RUSTC" --version
+clean "$CARGO" --version
+for t in "${TOOLS[@]}"; do
+  IFS='|' read -r f pkg tpkg <<< "$t"
+  pkg=${tpkg:-$pkg}
+  # Each value on its own, so that a failure is not printed as an empty
+  # field.
+  h=$(sha256sum -- "$f") || refuse "cannot hash $f"
+  h=${h%% *}
+  r=$(readlink -f -- "$f") || refuse "cannot resolve $f"
+  v=$(dpkg-query -W -f='${Version}' "$pkg") || refuse "cannot read the version of $pkg"
+  if [ "$r" = "$f" ]; then
+    echo "tool $h $f ($pkg $v)"
+  else
+    echo "tool $h $f -> $r ($pkg $v)"
+  fi
+done
+rustc_path=$(clean "$RUSTUP" which rustc) || refuse "rustup which rustc failed"
+TOOLCHAIN_DIR=${rustc_path%/bin/rustc}
+[ "$TOOLCHAIN_DIR/bin/rustc" = "$rustc_path" ] && [ -d "$TOOLCHAIN_DIR" ] ||
+  refuse "unexpected rustc path: $rustc_path"
+
+build() { # n
+  local tdir=$BASE/windows-build-$1
+  if [ -e "$tdir" ]; then
+    refuse "$tdir exists; remove it first"
+  fi
+  local flags=(
+    "--remap-path-prefix=$tdir=/target"
+    "--remap-path-prefix=$ROOT=/src"
+    "--remap-path-prefix=$CARGO_HOME=/cargo"
+    "--remap-path-prefix=$RUSTUP_HOME=/rustup"
+    "-Clink-arg=-Wl,--no-insert-timestamp"
+    # No COFF symbol table: the import library that dlltool makes for
+    # getrandom's raw-dylib link to bcryptprimitives.dll names its symbols
+    # after rustc's random temporary path, which made voleith-prove.exe
+    # differ between builds and leaked the local path.
+    "-Cstrip=symbols"
+    "-Cdlltool=$DLLTOOL"
+  )
+  local bin_args=()
+  for b in "${BINS[@]}"; do bin_args+=(--bin "$b"); done
+  local encoded
+  # printf, not echo: echo would take a leading -n or -e as an option.
+  encoded=$(IFS=$'\x1f'; printf '%s' "${flags[*]}")
+  local trace=()
+  if [ "$TRACED" = 1 ]; then
+    mkdir -p "$tdir"
+    # --quiet=attach,personality (-q, not -qq): exit lines are written,
+    # and exec_trace.py needs the root's `+++ exited with 0 +++`.
+    trace=("$STRACE" -f --quiet=attach,personality -e trace=execve,execveat
+      -e signal=none -o "$tdir/exec.log")
+  fi
+  local cmd=(clean "CARGO_ENCODED_RUSTFLAGS=$encoded"
+    "CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER=$LINKER"
+    "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=$HOST_CC"
+    "${trace[@]}" "$CARGO" build --quiet --locked --profile cli --features cli --target "$TARGET"
+    --manifest-path "$HERE/Cargo.toml" --target-dir "$tdir" "${bin_args[@]}")
+  if [ "$TRACED" = 0 ]; then
+    "${cmd[@]}"
+    return
+  fi
+  # strace exits with cargo's status, but reports its own errors (a log it
+  # cannot write: a full disk, an I/O error) on standard error, with lines
+  # that start with "$STRACE: " or "strace: ", and may still exit 0. The
+  # traced build's standard error is read through a pipe that this script
+  # consumes (command substitution), shown in full, and the build fails on
+  # a non-zero status or on any line strace wrote; compiler warnings pass.
+  local rc=0 errout
+  exec 3>&1
+  errout=$("${cmd[@]}" 2>&1 1>&3 3>&-) || rc=$?
+  exec 3>&-
+  if [ -n "$errout" ]; then
+    sed "s/^/build $1 stderr: /" <<< "$errout" >&2
+  fi
+  if [ "$rc" -ne 0 ]; then
+    refuse "build $1 under strace exited $rc"
+  fi
+  "$PYTHON" -I "$HERE/windows/exec_trace.py" stderr "$STRACE" <<< "$errout" ||
+    refuse "build $1: strace reported an error (above)"
+  # Every program the build executed: the toolchain's, the build
+  # scripts', or one of the tools pinned before build 1; the log must start
+  # with the root's exec and end with its exit 0, cargo, rustc and the
+  # linker must have run, and every line must be readable.
+  "$PYTHON" -I "$HERE/windows/exec_trace.py" "$tdir/exec.log" --root "$CARGO" --pins "$PINS" \
+    --expect "$TOOLCHAIN_DIR/bin/cargo" --expect "$TOOLCHAIN_DIR/bin/rustc" --expect "$LINKER" \
+    --allow-build-scripts "$tdir/cli/build" ||
+    refuse "build $1: the exec trace is unreadable, does not end normally or shows a program that is not allowed"
+}
+
+# Pin, once and before build 1, every allowed tool (path as written, the
+# file it resolves to, that file's device, inode and SHA-256) and the
+# toolchain directory (path, resolved path, device, inode; no hash). Both
+# builds are checked against this record, and at the end nothing in it
+# may have changed.
+PINS=$BASE/windows-build-pins.json
+if [ "$TRACED" = 1 ]; then
+  pin_args=(--proxy "$CARGO" "$CARGO_HOME/bin/rustup" --dir "$TOOLCHAIN_DIR")
+  for t in "${TOOLS[@]}"; do pin_args+=(--tool "${t%%|*}"); done
+  mkdir -p "$BASE"
+  "$PYTHON" -I "$HERE/windows/exec_trace.py" pin "$PINS" "${pin_args[@]}" ||
+    refuse "cannot pin the tools"
+fi
+build 1
+build 2
+if [ "$TRACED" = 1 ]; then
+  "$PYTHON" -I "$HERE/windows/exec_trace.py" verify "$PINS" ||
+    refuse "a pinned tool or directory changed during the builds"
+fi
+mkdir -p "$OUT"
+status=0
+for b in "${BINS[@]}"; do
+  one=$BASE/windows-build-1/$TARGET/cli/$b.exe
+  two=$BASE/windows-build-2/$TARGET/cli/$b.exe
+  if cmp -s "$one" "$two"; then
+    echo "$b.exe: the two builds are identical"
+  else
+    echo "$b.exe: the two builds DIFFER" >&2
+    status=1
+  fi
+  cp "$one" "$OUT/$b.exe"
+done
+# The number of places in FILE (lines, to grep -a) that contain one of the
+# fixed strings given as -e arguments. grep reads the whole file itself,
+# with no pipe that an early exit could break, and "the scan failed"
+# (return 2, nothing printed) is kept apart from "none found" (0).
+count_in() {
+  local file=$1 n rc
+  shift
+  n=$(grep -a -c -F "$@" -- "$file") && rc=0 || rc=$?
+  if [ "$rc" -gt 1 ] || ! [[ "$n" =~ ^[0-9]+$ ]]; then
+    return 2
+  fi
+  echo "$n"
+}
+scan() { # label file strings...
+  local label=$1 file=$2 n
+  shift 2
+  if ! n=$(count_in "$file" "$@"); then
+    echo "$label: the scan of $file failed" >&2
+    status=1
+    return
+  fi
+  if [ "$n" -ne 0 ]; then
+    echo "$label: found in $file" >&2
+    status=1
+  fi
+}
+MARKER=VOLEITH_ALLOW_FAULT_INJECTION
+# Positive control: the marker followed by 64 MiB more is still found.
+control=$BASE/windows-build-1/marker-control.bin
+{
+  printf 'xx%s\n' "$MARKER"
+  head -c 67108864 /dev/zero
+} > "$control"
+n=$(count_in "$control" -e "$MARKER") || refuse "the scan of the marker control failed"
+[ "$n" -ge 1 ] || refuse "the marker scan misses a marker followed by 64 MiB"
+echo "marker scan: control with the marker and 64 MiB after it found"
+# The features are exactly `cli` (above); as a second check, the string
+# that a build with the test-only feature fault-injection carries in its
+# refusal message must be absent.
+for b in "${BINS[@]}"; do
+  scan "fault-injection marker in $b.exe" "$OUT/$b.exe" -e "$MARKER"
+done
+# Local paths left in the binaries (there should be none).
+# A path also counts with its separators turned into underscores, as in
+# dlltool's symbol names.
+leak=()
+for p in "$ROOT" "$CARGO_HOME" "$RUSTUP_HOME" "$HOME/" /tmp/; do
+  u=$(printf '%s' "$p" | tr '/.-' '___') || refuse "cannot form the underscore form of $p"
+  leak+=(-e "$p" -e "$u")
+done
+# Positive control: a file holding each form of one local path (as is, and
+# with separators turned into underscores) in 64 MiB is found by the same
+# patterns.
+root_u=$(printf '%s' "$ROOT" | tr '/.-' '___') || refuse "cannot form the underscore form of $ROOT"
+for form in "$ROOT" "$root_u"; do
+  {
+    head -c 33554432 /dev/zero
+    printf '%s\n' "$form"
+    head -c 33554432 /dev/zero
+  } > "$control"
+  n=$(count_in "$control" "${leak[@]}") || refuse "the scan of the local-path control failed"
+  [ "$n" -ge 1 ] || refuse "the local-path scan misses $form"
+done
+echo "local-path scan: controls with the checkout path, plain and as underscores, found"
+for b in "${BINS[@]}"; do
+  scan "a local path in $b.exe" "$OUT/$b.exe" "${leak[@]}"
+done
+(cd "$OUT" && sha256sum "${BINS[@]/%/.exe}")
+if [ "$TRACED" = 0 ]; then
+  echo "UNPUBLISHED BUILD: not traced; do not publish these hashes" >&2
+fi
+exit $status
diff --git a/src/rescue/voleith/check-verifier-only.sh b/src/rescue/voleith/check-verifier-only.sh
new file mode 100644
index 0000000..c616f4b
--- /dev/null
+++ b/src/rescue/voleith/check-verifier-only.sh
@@ -0,0 +1,325 @@
+#!/usr/bin/env bash
+# Builds the verifier-only static library (no `prover` feature) and checks
+# with nm that it exports voleith_verify_s1 and holds no prover symbol.
+#
+# Every pattern has a positive control: it must match in a build with the
+# prover, so that a pattern that can never match cannot pass. The controls
+# are a staticlib with the prover, `test-trace` and `fault-injection`, built
+# at opt-level 0 without LTO (so that nothing is inlined away), and, for the
+# dudect module, which exists only under cfg(test), the library's unit-test
+# binary. The verifier-only side is checked with LTO, without LTO, and at
+# opt-level 0 without LTO, and its unit-test binary too.
+#
+# A failed or incomplete scan never counts as "no match":
+# - nm must exit 0 with nothing on standard error, its listing must end
+#   with a newline, and the number of complete symbol lines of `nm -a -C`
+#   (address or blanks, type letter, a non-empty name) must equal the
+#   number of .symtab entries that `readelf -sW` reports (the sum over all
+#   members of an archive, less each table's null entry);
+# - grep's status 1 is "no match", status 2 or more fails the check.
+# A self-test runs these functions on a missing file, a directory, an
+# empty file, and copies of a real listing cut after a type letter (with
+# and without a newline), cut mid-line, cut in half, or with a message on
+# nm's standard error, and each must fail.
+# Usage: bash rust/check-verifier-only.sh   (from anywhere; needs nm, readelf)
+set -euo pipefail
+cd "$(dirname "$0")"
+OUT=${CHECK_TARGET_DIR:-target/check-verifier-only}
+
+# name|extended regex on `nm -a -C` output
+PATTERNS=(
+  'prove|voleith[0-9a-z_]*::proof::prove$'
+  'prove_scrubbed|proof::prove_scrubbed'
+  'prove_impl|proof::prove_impl'
+  'scrub_stack|proof::scrub_stack'
+  'prove_traced|proof::prove_traced'
+  'ProverTrace|ProverTrace'
+  'ProveError|ProveError'
+  'vc::commit|vc::commit'
+  'vc::Tree|vc::Tree'
+  'CtMul|unihash::CtMul'
+  'evaluate|Circuit>?::evaluate'
+  'prover_terms|Circuit>?::prover_terms'
+  's1_hmac|statements::s1_hmac'
+  's1_secret_bits|statements::s1_secret_bits'
+  'fault|voleith[0-9a-z_]*::fault::'
+  'dudect|voleith[0-9a-z_]*::dudect::'
+)
+
+fail=0
+SYMS=$OUT/symbols
+mkdir -p "$SYMS"
+
+# A complete symbol line of `nm -a`: an address or blanks, a type letter
+# and a non-empty name (a line cut after the type letter is not one).
+SYMLINE='^([0-9a-f]{8,16}| {8,16}) [A-Za-z?-] [^ ]'
+
+# The number of lines of FILE matching the extended regex RE; status 2,
+# with nothing printed, if grep could not read FILE (status 2 or more), so
+# that a failed scan is never a count of 0.
+count_re() { # file re
+  local n rc
+  n=$(grep -cE -- "$2" "$1" 2> /dev/null) && rc=0 || rc=$?
+  if [ "$rc" -gt 1 ] || ! [[ "$n" =~ ^[0-9]+$ ]]; then
+    return 2
+  fi
+  echo "$n"
+}
+
+# The .symtab entries of BINARY (an archive or an executable), less each
+# table's null entry, from readelf; status 2 if readelf fails or finds none.
+symtab_entries() { # binary
+  local listing n
+  listing=$(readelf -sW -- "$1" 2> /dev/null) || return 2
+  n=$(awk '/^Symbol table .\.symtab. contains [0-9]+ entr/ {s += $5 - 1; t++}
+    END {if (t) print s}' <<< "$listing") || return 2
+  [[ "$n" =~ ^[0-9]+$ ]] || return 2
+  echo "$n"
+}
+
+# Whether LISTING, nm's output for BINARY with nm's standard error in
+# ERRFILE, is complete: nm wrote nothing to standard error, the listing
+# ends with a newline, and its complete symbol lines are exactly the
+# .symtab entries readelf reports. Prints the count; status 2 otherwise.
+# Whether FILE ends with a newline: status 0 if so, 1 if not, 2 if it
+# cannot be read (tail fails), so that a failed read is never "a newline".
+# TAIL is the tail command; only the self-test sets it, to `false`.
+TAIL=tail
+ends_with_newline() { # file
+  local last
+  [ -f "$1" ] || return 2
+  last=$("$TAIL" -c 1 -- "$1" 2> /dev/null) || return 2
+  [ -z "$last" ] && [ -s "$1" ] && return 0
+  return 1
+}
+
+check_listing() { # binary listing errfile
+  local lines entries
+  [ -s "$2" ] || return 2
+  [ ! -s "$3" ] || return 2
+  ends_with_newline "$2" || return 2
+  lines=$(count_re "$2" "$SYMLINE") || return 2
+  entries=$(symtab_entries "$1") || return 2
+  [ "$lines" -eq "$entries" ] || return 2
+  echo "$lines"
+}
+
+# Lists the symbols of BINARY into LISTING with `nm -a -C`; status 2 if nm
+# fails or the listing is not complete (check_listing).
+list_symbols() { # binary listing
+  [ -f "$1" ] || return 2
+  nm -a -C -- "$1" > "$2" 2> "$2.err" || return 2
+  check_listing "$1" "$2" "$2.err"
+}
+
+# The self-test is called as `self_test || fail=1`, where bash does not
+# apply `set -e`: each step that makes a sample or a listing, or computes
+# a value from one, checks its status (`|| return 1`), and every defective
+# sample is checked to have the defect it is meant to have, so that a
+# sample that failed to be made cannot pass as a caught defect.
+st_fail() {
+  echo "self-test: $*" >&2
+  return 1
+}
+
+# The last complete symbol line of LISTING cut right after its type letter
+# and the space after it (the name field removed), whatever the width of
+# the address column (8 or 16 characters, or blanks); on standard output.
+cut_after_type() { # listing
+  local last line
+  last=$(grep -nE -- "$SYMLINE" "$1" | tail -n 1) || return 1
+  last=${last%%:*}
+  [[ "$last" =~ ^[0-9]+$ ]] || return 1
+  head -n "$((last - 1))" -- "$1" || return 1
+  line=$(sed -n "${last}p" -- "$1") || return 1
+  [[ "$line" =~ ^(([0-9a-f]{8}|[0-9a-f]{16}| {8}| {16})\ [A-Za-z?-]\ ) ]] || return 1
+  printf '%s\n' "${BASH_REMATCH[1]}"
+  sed -n "$((last + 1)),\$p" -- "$1" || return 1
+}
+
+# For BINARY: its listing passes check_listing, and each defect, put into
+# a copy and given to the same check_listing, fails. DIR holds the files.
+defect_samples() { # binary dir
+  local a=$1 d=$2 n total size
+  mkdir -p "$d" || st_fail "cannot make $d" || return 1
+  list_symbols "$a" "$d/full.txt" > /dev/null || st_fail "list_symbols failed on $a" || return 1
+  : > "$d/noerr.txt" || return 1
+  echo "nm: some warning" > "$d/err.txt" || return 1
+  total=$(wc -l < "$d/full.txt") || return 1
+  size=$(wc -c < "$d/full.txt") || return 1
+  # The last symbol line cut after its type letter, with a newline and
+  # without one; the cut line must then be exactly "<address> <type> ".
+  cut_after_type "$d/full.txt" > "$d/cut-type.txt" || st_fail "cannot cut $d/full.txt" || return 1
+  n=$(wc -l < "$d/cut-type.txt") || return 1
+  [ "$n" -eq "$total" ] || st_fail "cut-type has another line count" || return 1
+  n=$(grep -cE -- '^([0-9a-f]{8}|[0-9a-f]{16}| {8}| {16}) [A-Za-z?-] $' "$d/cut-type.txt") &&
+    [ "$n" -eq 1 ] || st_fail "cut-type does not end a line after the type letter" || return 1
+  { head -n "$((total - 1))" -- "$d/cut-type.txt" && tail -n 1 -- "$d/cut-type.txt" | tr -d '\n'; } \
+    > "$d/cut-type-nonl.txt" || return 1
+  # Cut in the middle of the last line, and in half at a line boundary.
+  head -c "$((size - 5))" -- "$d/full.txt" > "$d/cut-mid.txt" || return 1
+  head -n "$((total / 2))" -- "$d/full.txt" > "$d/cut-half.txt" || return 1
+  local f
+  for f in cut-type-nonl.txt cut-mid.txt; do
+    n=0
+    ends_with_newline "$d/$f" || n=$?
+    [ "$n" -eq 1 ] || st_fail "$f should end without a newline" || return 1
+  done
+  n=0
+  ends_with_newline "$d/cut-half.txt" || n=$?
+  [ "$n" -eq 0 ] || st_fail "cut-half.txt should end with a newline" || return 1
+  local case
+  for case in "full.txt|err.txt" "cut-type.txt|noerr.txt" "cut-type-nonl.txt|noerr.txt" \
+    "cut-mid.txt|noerr.txt" "cut-half.txt|noerr.txt" "noerr.txt|noerr.txt"; do
+    if check_listing "$a" "$d/${case%%|*}" "$d/${case#*|}" > /dev/null; then
+      st_fail "check_listing accepted $case for $a" || return 1
+    fi
+  done
+  check_listing "$a" "$d/full.txt" "$d/noerr.txt" > /dev/null ||
+    st_fail "check_listing refused the intact listing of $a" || return 1
+}
+
+self_test() {
+  local d=$SYMS/self-test n rc total
+  mkdir -p "$d/dir" || return 1
+  : > "$d/empty.txt" || return 1
+  printf 'x\n' > "$d/nl.txt" || return 1
+  for bad in "$d/missing.txt" "$d/dir"; do
+    if count_re "$bad" x > /dev/null; then
+      st_fail "count_re read $bad" || return 1
+    fi
+    # A file that tail cannot read is not "a newline".
+    rc=0
+    ends_with_newline "$bad" || rc=$?
+    [ "$rc" -eq 2 ] || st_fail "ends_with_newline gave $rc for $bad" || return 1
+  done
+  ends_with_newline "$d/nl.txt" || st_fail "ends_with_newline on a newline" || return 1
+  # tail failing on a readable file (as root, no file is unreadable): the
+  # same function with `false` as tail must report a failed read.
+  rc=0
+  TAIL=false ends_with_newline "$d/nl.txt" || rc=$?
+  [ "$rc" -eq 2 ] || st_fail "ends_with_newline gave $rc when tail failed" || return 1
+  n=$(count_re "$d/empty.txt" x) && [ "$n" -eq 0 ] || st_fail "count_re on an empty file" || return 1
+  # The real archive's listing (16-character addresses) for every defect.
+  defect_samples "$1" "$d/archive" || return 1
+  # The cut after the type letter for both address widths, on committed
+  # nm listings with 8- and 16-character address columns: the cut line
+  # must end right after the type letter and no longer count as a symbol
+  # line. (No assembler is needed, so this runs on any host.)
+  local fx full cut
+  for fx in nm-addr8.txt nm-addr16.txt; do
+    fx=tests/fixtures/$fx
+    total=$(wc -l < "$fx") || st_fail "cannot read $fx" || return 1
+    full=$(count_re "$fx" "$SYMLINE") || st_fail "cannot scan $fx" || return 1
+    [ "$full" -eq "$total" ] || st_fail "$fx has lines that are not symbol lines" || return 1
+    cut_after_type "$fx" > "$d/cut-${fx##*/}" || st_fail "cannot cut $fx" || return 1
+    n=$(wc -l < "$d/cut-${fx##*/}") || return 1
+    [ "$n" -eq "$total" ] || st_fail "the cut of $fx has another line count" || return 1
+    n=$(grep -cE -- '^([0-9a-f]{8}|[0-9a-f]{16}| {8}| {16}) [A-Za-z?-] $' "$d/cut-${fx##*/}") &&
+      [ "$n" -eq 1 ] || st_fail "the cut of $fx does not end a line after the type letter" || return 1
+    cut=$(count_re "$d/cut-${fx##*/}" "$SYMLINE") || return 1
+    [ "$cut" -eq "$((full - 1))" ] || st_fail "the cut line of $fx is still counted" || return 1
+  done
+  for bad in "$d/missing.a" "$d/empty.txt"; do
+    if list_symbols "$bad" "$d/x.txt" > /dev/null; then
+      st_fail "list_symbols accepted $bad" || return 1
+    fi
+  done
+  echo "self-test: an unreadable file, a cut or erroring listing (16- and 8-character addresses) and an empty binary are all caught"
+}
+
+lib() { # label lto opt-level codegen-units features...
+  local label=$1 lto=$2 opt=$3 cgu=$4 n exported
+  shift 4
+  CARGO_PROFILE_RELEASE_LTO=$lto CARGO_PROFILE_RELEASE_OPT_LEVEL=$opt \
+    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=$cgu \
+    cargo build --quiet --release --lib "$@" --target-dir "$OUT/$label"
+  if ! n=$(list_symbols "$OUT/$label/release/libvoleith.a" "$SYMS/$label.txt"); then
+    echo "$label: nm failed or its listing is incomplete" >&2
+    fail=1
+    return
+  fi
+  if ! exported=$(count_re "$SYMS/$label.txt" ' T voleith_verify_s1$'); then
+    echo "$label: cannot scan the listing" >&2
+    fail=1
+    return
+  fi
+  echo "$label: $n symbols (= readelf), voleith_verify_s1 exported $exported time(s)"
+  if [ "$exported" -lt 1 ]; then fail=1; fi
+}
+
+unit_tests() { # label features...
+  local label=$1 exe n
+  shift
+  # The JSON reader prints exactly one path, the last test executable,
+  # and fails (as does the pipeline, under pipefail) if there is none or
+  # if the path holds a newline; no `tail` cuts a path apart.
+  if ! exe=$(cargo test --quiet --release --lib --no-run "$@" --target-dir "$OUT/$label" \
+    --message-format=json 2> /dev/null |
+    python3 -I -c 'import json,sys
+exes = [m["executable"] for m in map(json.loads, sys.stdin)
+        if m.get("reason") == "compiler-artifact" and m.get("executable") and m["profile"]["test"]]
+if not exes or "\n" in exes[-1]:
+    sys.exit(1)
+sys.stdout.write(exes[-1])'); then
+    echo "$label: building the unit tests or finding their binary failed" >&2
+    fail=1
+    return
+  fi
+  if [ -z "$exe" ] || ! n=$(list_symbols "$exe" "$SYMS/$label.txt"); then
+    echo "$label: no unit-test binary, or nm failed or its listing is incomplete" >&2
+    fail=1
+    return
+  fi
+  echo "$label: $(basename "$exe"), $n symbols (= readelf)"
+}
+
+# verifier-only-lto is the release profile as it stands (lto = true,
+# codegen-units = 1): the archive that Bitcoin Core links. With 16
+# codegen units, lto = true left the archive unmerged, so it was not that.
+lib verifier-only-lto true 3 1 --no-default-features
+self_test "$OUT/verifier-only-lto/release/libvoleith.a" || fail=1
+lib verifier-only-nolto false 3 16 --no-default-features
+lib verifier-only-O0 false 0 16 --no-default-features
+unit_tests verifier-only-tests --no-default-features
+lib control-O0 false 0 16 --features test-trace,fault-injection
+unit_tests control-tests
+
+LABELS=(verifier-only-lto verifier-only-nolto verifier-only-O0 verifier-only-tests)
+for entry in "${PATTERNS[@]}"; do
+  name=${entry%%|*}
+  re=${entry#*|}
+  line="$name:"
+  for label in "${LABELS[@]}"; do
+    if ! n=$(count_re "$SYMS/$label.txt" "$re"); then
+      line="$line $label=SCAN-FAILED"
+      fail=1
+      continue
+    fi
+    line="$line $label=$n"
+    if [ "$n" -ne 0 ]; then
+      fail=1
+      grep -m 5 -E -- "$re" "$SYMS/$label.txt" || true
+    fi
+  done
+  c=0
+  for label in control-O0 control-tests; do
+    if ! k=$(count_re "$SYMS/$label.txt" "$re"); then
+      line="$line $label=SCAN-FAILED"
+      fail=1
+      continue
+    fi
+    c=$((c + k))
+  done
+  line="$line control=$c"
+  if [ "$c" -eq 0 ]; then
+    line="$line (NO MATCH IN THE CONTROL)"
+    fail=1
+  fi
+  echo "$line"
+done
+if [ "$fail" -ne 0 ]; then
+  echo FAIL
+  exit 1
+fi
+echo OK
diff --git a/src/rescue/voleith/check-windows-shadowing.sh b/src/rescue/voleith/check-windows-shadowing.sh
new file mode 100644
index 0000000..1af621b
--- /dev/null
+++ b/src/rescue/voleith/check-windows-shadowing.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+# build-windows.sh ignores tools of the same names earlier on PATH.
+#
+# Puts stand-ins for cc, ld and x86_64-w64-mingw32-{gcc,gcc-win32,as,
+# dlltool,ld} (symbolic links to /bin/false, so that any use fails the
+# build) into a fresh directory under /tmp, puts that directory first on
+# PATH, checks that the shell now finds the stand-ins (positive control),
+# runs build-windows.sh with its build directories in the same place, and
+# compares the two .exe files with those of a normal run. The directory is
+# removed afterwards.
+#
+# Usage: bash rust/check-windows-shadowing.sh [reference out dir]
+#   (default rust/target/windows-out, from a normal `bash build-windows.sh`)
+set -euo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd -P)
+REF=${1:-$HERE/target/windows-out}
+BINS=(voleith-prove voleith-verify)
+for b in "${BINS[@]}"; do
+  [ -f "$REF/$b.exe" ] || {
+    echo "no $REF/$b.exe: run build-windows.sh first" >&2
+    exit 1
+  }
+done
+
+DIR=$(mktemp -d /tmp/voleith-shadow.XXXXXX)
+trap 'rm -r -- "$DIR"' EXIT
+mkdir "$DIR/bin"
+TOOLS=(cc ld x86_64-w64-mingw32-gcc x86_64-w64-mingw32-gcc-win32
+  x86_64-w64-mingw32-as x86_64-w64-mingw32-dlltool x86_64-w64-mingw32-ld)
+for t in "${TOOLS[@]}"; do
+  ln -s /bin/false "$DIR/bin/$t"
+done
+export PATH="$DIR/bin:$PATH"
+for t in "${TOOLS[@]}"; do
+  [ "$(command -v "$t")" = "$DIR/bin/$t" ] || {
+    echo "the stand-in for $t is not found first on PATH" >&2
+    exit 1
+  }
+done
+echo "stand-ins first on PATH: ${TOOLS[*]}"
+
+WINDOWS_BUILD_BASE=$DIR bash "$HERE/build-windows.sh" "$DIR/out"
+status=0
+for b in "${BINS[@]}"; do
+  if cmp -s "$REF/$b.exe" "$DIR/out/$b.exe"; then
+    echo "$b.exe: the same as the reference"
+  else
+    echo "$b.exe: DIFFERS from the reference" >&2
+    status=1
+  fi
+done
+[ $status -eq 0 ] && echo OK || echo FAIL
+exit $status
