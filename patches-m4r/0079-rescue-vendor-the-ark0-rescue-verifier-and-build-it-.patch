+pub const PTHREAD_COND_INITIALIZER: pthread_cond_t = 0xFFFFFFFF;
+pub const PTHREAD_RWLOCK_INITIALIZER: pthread_rwlock_t = !0usize as pthread_rwlock_t;
+pub const PTHREAD_ONCE_INIT: pthread_once_t = 0;
