index 0000000..fdeaf36
--- /dev/null
+++ b/src/rescue/voleith/src/bin/voleith-prove.rs
@@ -0,0 +1,319 @@
+//! voleith-prove: prove statement 0x01 with a real seed (SPEC.md §9).
+//!
+//! ```text
+//! <restore command> | voleith-prove --k <ascii K> --suffix <0..255> --msg-hex <hex> --out <proof file> [--require-mlock]
+//! ```
+//!
+//! Turns off crash dumps and crash reporting for its process
+//! (`common::os::no_crash_dumps`), and with `--require-mlock` (Linux only)
+//! locks all its memory, before it reads anything; a failure of either is
+//! an error and nothing is read. Then it reads the seed x from standard
+//! input (64 hexadecimal digits and an optional newline, nothing else),
+//! computes y = HMAC-SHA256(K, x || suffix), draws rho from the operating
+//! system, proves with the constant-time prover, verifies the proof, writes
+//! it to a temporary file next to the output, syncs it, gives it the output
+//! name without ever replacing a file, and prints one line, `y=<64 hex>`.
+//! The seed and rho are never printed, logged or written. README.md says
+//! which copies of them are cleared.
+//!
+//! Exit codes: 0 success; 1 failure (crash dumps cannot be turned off,
+//! memory cannot be locked, the output file exists or cannot be written, no
+//! OS randomness, the prover refused, the self-check failed); 2 usage error
+//! (arguments or standard input malformed). Built with the `cli` profile, a
+//! panic ends the process at once.
+
+#![deny(unsafe_code)]
+
+mod common;
+
+use std::ffi::OsString;
+use std::fs::{File, OpenOptions};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::process::ExitCode;
+
+use common::{os, parse_hex, parse_k, parse_options, parse_suffix, read_seed, to_hex};
+use voleith::params::RHO_BYTES;
+use voleith::{prove, s1_encode_public, verify, STATEMENT1_ID};
+use zeroize::Zeroizing;
+
+const USAGE: &str = "usage: voleith-prove --k <ascii K> --suffix <0..255> --msg-hex <hex> \
+--out <proof file> [--require-mlock] < seed\n  standard input: the 32-byte seed as 64 \
+hexadecimal digits and an optional newline\n  --require-mlock: lock all memory first \
+(Linux only)";
+
+enum Fail {
+    Usage(String),
+    Other(String),
+}
+
+/// Faults injected by the tests (feature `fault-injection` only), from the
+/// comma-separated words of the environment variable VOLEITH_FAULT: `rng`
+/// (the random source fails), `rho=<64 hex>` (a fixed rho), `panic` (a
+/// panic inside prove), `write` (writing fails after half of the proof),
+/// `sync` (the sync fails), `publish` (naming the file fails), `remove`
+/// (removing the temporary file fails).
+#[derive(Default)]
+struct Faults {
+    rng: bool,
+    rho: Option<[u8; RHO_BYTES]>,
+    #[cfg_attr(not(feature = "fault-injection"), allow(dead_code))]
+    panic: bool,
+    write: bool,
+    sync: bool,
+    publish: bool,
+    remove: bool,
+}
+
+impl Faults {
+    #[cfg(feature = "fault-injection")]
+    fn from_env() -> Self {
+        let mut f = Faults::default();
+        let v = std::env::var("VOLEITH_FAULT").unwrap_or_default();
+        for w in v.split(',').filter(|w| !w.is_empty()) {
+            match w {
+                "rng" => f.rng = true,
+                "panic" => f.panic = true,
+                "write" => f.write = true,
+                "sync" => f.sync = true,
+                "publish" => f.publish = true,
+                "remove" => f.remove = true,
+                _ => {
+                    let h = w.strip_prefix("rho=").expect("VOLEITH_FAULT word");
+                    let b = parse_hex("rho", std::ffi::OsStr::new(h), RHO_BYTES).unwrap();
+                    f.rho = Some(b.try_into().expect("32 bytes"));
+                }
+            }
+        }
+        f
+    }
+
+    #[cfg(not(feature = "fault-injection"))]
+    fn from_env() -> Self {
+        Faults::default()
+    }
+}
+
+fn injected(what: &str) -> std::io::Error {
+    std::io::Error::other(format!("injected {what} failure"))
+}
+
+/// Removes the temporary file after a failure, and says so if it cannot.
+fn discard(tmp: &Path, msg: String, faults: &Faults) -> String {
+    let r = if faults.remove {
+        Err(injected("remove"))
+    } else {
+        std::fs::remove_file(tmp)
+    };
+    match r {
+        Ok(()) => msg,
+        Err(e) => format!(
+            "{msg}; the temporary file {} could not be removed ({e}): delete it",
+            tmp.display()
+        ),
+    }
+}
+
+/// Writes `proof` to a new temporary file in the directory of `out`, syncs
+/// and closes it, then gives it the name `out` without replacing any file.
+/// On failure the temporary file is removed (or the error says it could not
+/// be). Returns warnings for a published proof.
+fn write_new(out: &Path, proof: &[u8], faults: &Faults) -> Result<Vec<String>, String> {
+    let dir = match out.parent() {
+        Some(p) if !p.as_os_str().is_empty() => p.to_path_buf(),
+        _ => PathBuf::from("."),
+    };
+    let base = out.file_name().expect("checked in run");
+    let mut created: Option<(PathBuf, File)> = None;
+    for n in 0..100 {
+        let mut name = OsString::from(".");
+        name.push(base);
+        name.push(format!(".{}.{n}.tmp", std::process::id()));
+        let p = dir.join(name);
+        match OpenOptions::new().write(true).create_new(true).open(&p) {
+            Ok(f) => {
+                created = Some((p, f));
+                break;
+            }
+            Err(e) if e.kind() == std::io::ErrorKind::AlreadyExists => continue,
+            Err(e) => {
+                return Err(format!(
+                    "cannot create a temporary file in {}: {e}",
+                    dir.display()
+                ))
+            }
+        }
+    }
+    let (tmp, mut f) = created.ok_or("cannot create a temporary file: 100 names taken")?;
+    let written = if faults.write {
+        f.write_all(&proof[..proof.len() / 2])
+            .and_then(|()| Err(injected("write")))
+    } else {
+        f.write_all(proof)
+    }
+    .and_then(|()| {
+        if faults.sync {
+            Err(injected("sync"))
+        } else {
+            f.sync_all()
+        }
+    });
+    drop(f);
+    if let Err(e) = written {
+        let msg = format!("cannot write the temporary file {}: {e}", tmp.display());
+        return Err(discard(&tmp, msg, faults));
+    }
+    let published = if faults.publish {
+        Err(injected("publish"))
+    } else {
+        os::publish_no_replace(&tmp, out)
+    };
+    let mut warnings = Vec::new();
+    match published {
+        Err(e) => {
+            let msg = format!(
+                "cannot name the proof file {} (it is never overwritten): {e}",
+                out.display()
+            );
+            return Err(discard(&tmp, msg, faults));
+        }
+        Ok(Some(e)) => warnings.push(format!(
+            "the proof is in {}, but the temporary file {} could not be removed ({e}): delete it",
+            out.display(),
+            tmp.display()
+        )),
+        Ok(None) => {}
+    }
+    if let Err(e) = os::sync_dir(&dir) {
+        warnings.push(format!(
+            "the proof is in {}, but its directory could not be synced: {e}",
+            out.display()
+        ));
+    }
+    Ok(warnings)
+}
+
+/// Everything secret lives in this function's locals (in `Zeroizing`), so
+/// it is cleared when `run` returns, whichever path it takes; `main` exits
+/// only after that.
+fn run() -> Result<(String, Vec<String>), Fail> {
+    let faults = Faults::from_env();
+    let args: Vec<_> = std::env::args_os().skip(1).collect();
+    let opts = parse_options(
+        &args,
+        &["k", "suffix", "msg-hex", "out"],
+        &["require-mlock"],
+    )
+    .map_err(Fail::Usage)?;
+    let key = parse_k(&opts["k"]).map_err(Fail::Usage)?;
+    let suffix = parse_suffix(&opts["suffix"]).map_err(Fail::Usage)?;
+    let msg =
+        parse_hex("msg-hex", &opts["msg-hex"], common::MAX_MESSAGE_LEN).map_err(Fail::Usage)?;
+    let out = PathBuf::from(&opts["out"]);
+    if out.as_os_str().is_empty() || out.file_name().is_none() {
+        return Err(Fail::Usage("--out: not a file name".into()));
+    }
+    let require_mlock = opts.contains_key("require-mlock");
+    if require_mlock && !cfg!(target_os = "linux") {
+        return Err(Fail::Usage(
+            "--require-mlock is supported on Linux only".into(),
+        ));
+    }
+    if out.exists() {
+        return Err(Fail::Other(
+            "the output file already exists; not overwritten".into(),
+        ));
+    }
+
+    // Before anything is read: no crash dumps, and locked memory if asked.
+    os::no_crash_dumps().map_err(|e| Fail::Other(format!("{e}; nothing read")))?;
+    #[cfg(target_os = "linux")]
+    if require_mlock {
+        os::lock_all_memory().map_err(|e| Fail::Other(format!("{e}; nothing read")))?;
+    }
+
+    let mut stdin =
+        common::raw_stdin().map_err(|_| Fail::Other("cannot open standard input".into()))?;
+    let mut x = Zeroizing::new([0u8; 32]);
+    read_seed(&mut stdin, &mut x).map_err(Fail::Usage)?;
+
+    // y = HMAC-SHA256(K, x || suffix); the copy of x is cleared on drop.
+    let mut m = Zeroizing::new([0u8; 33]);
+    m[..32].copy_from_slice(&x[..]);
+    m[32] = suffix;
+    let y = voleith::hash::hmac_sha256(&key, &m[..]);
+    drop(m);
+    let public_inputs = s1_encode_public(&key, suffix, &y)
+        .ok_or_else(|| Fail::Usage("--k: not a valid K".into()))?;
+
+    let mut rho = Zeroizing::new([0u8; RHO_BYTES]);
+    let drawn = match (faults.rng, faults.rho) {
+        (true, _) => Err(()),
+        (false, Some(r)) => {
+            rho.copy_from_slice(&r);
+            Ok(())
+        }
+        (false, None) => getrandom::fill(&mut rho[..]).map_err(|_| ()),
+    };
+    drawn.map_err(|()| Fail::Other("no randomness from the operating system".into()))?;
+
+    #[cfg(feature = "fault-injection")]
+    voleith::fault::panic_in_prove(faults.panic);
+    let proof = prove(STATEMENT1_ID, &public_inputs, &x[..], &msg, &rho)
+        .map_err(|e| Fail::Other(format!("the prover refused: {e:?}")))?;
+    drop(rho);
+    drop(x);
+    if !verify(STATEMENT1_ID, &public_inputs, &msg, &proof) {
+        return Err(Fail::Other(
+            "the proof does not verify; nothing written".into(),
+        ));
+    }
+    let warnings = write_new(&out, &proof, &faults).map_err(Fail::Other)?;
+    Ok((to_hex(&y), warnings))
+}
+
+/// The value of VOLEITH_ALLOW_FAULT_INJECTION under which a build with the
+/// test-only feature `fault-injection` runs at all.
+#[cfg(feature = "fault-injection")]
+const FAULT_INJECTION_ALLOWED: &str = "tests";
+
+/// A build with `fault-injection` can fix rho, bypass the OS random
+/// source and force a panic: it refuses to run, before reading any
+/// argument or input, unless the tests allow it explicitly.
+#[cfg(feature = "fault-injection")]
+fn refuse_fault_injection_build() -> bool {
+    if std::env::var("VOLEITH_ALLOW_FAULT_INJECTION").as_deref() == Ok(FAULT_INJECTION_ALLOWED) {
+        eprintln!("voleith-prove: warning: test build with fault injection; never use a real seed");
+        return false;
+    }
+    eprintln!(
+        "voleith-prove: this build has the test-only feature fault-injection and does not \
+         run (set VOLEITH_ALLOW_FAULT_INJECTION={FAULT_INJECTION_ALLOWED} in tests only); \
+         nothing read. Build with --features cli."
+    );
+    true
+}
+
+fn main() -> ExitCode {
+    #[cfg(feature = "fault-injection")]
+    if refuse_fault_injection_build() {
+        return ExitCode::from(1);
+    }
+    match run() {
+        Ok((y, warnings)) => {
+            println!("y={y}");
+            for w in warnings {
+                eprintln!("voleith-prove: warning: {w}");
+            }
+            ExitCode::SUCCESS
+        }
+        Err(Fail::Usage(e)) => {
+            eprintln!("voleith-prove: {e}\n{USAGE}");
+            ExitCode::from(2)
+        }
+        Err(Fail::Other(e)) => {
+            eprintln!("voleith-prove: {e}");
+            ExitCode::from(1)
+        }
+    }
+}
diff --git a/src/rescue/voleith/src/bin/voleith-verify.rs b/src/rescue/voleith/src/bin/voleith-verify.rs
new file mode 100644
index 0000000..0d7e85f
--- /dev/null
+++ b/src/rescue/voleith/src/bin/voleith-verify.rs
@@ -0,0 +1,58 @@
+//! voleith-verify: verify a statement 0x01 proof (SPEC.md §11).
+//!
+//! ```text
+//! voleith-verify --k <ascii K> --suffix <0..255> --y-hex <64 hex> --msg-hex <hex> --proof <file>
+//! ```
+//!
+//! Prints `valid` and exits 0 for a valid proof, prints `invalid` and exits 1
+//! for an invalid one, and exits 2 with a message on standard error for a
+//! usage error: a missing, repeated or unknown option, a value outside its
+//! domain (see `common`), or a proof file that cannot be read. A proof file
+//! of the wrong length is an invalid proof. python/tools/verify_cli.py and
+//! go/cmd/voleith-verify behave the same.
+
+#![deny(unsafe_code)]
+
+mod common;
+
+use std::process::ExitCode;
+
+use common::{parse_hex, parse_k, parse_options, parse_suffix, parse_y, read_limited};
+use voleith::{proof_length, s1_encode_public, verify, STATEMENT1_ID};
+
+const USAGE: &str = "usage: voleith-verify --k <ascii K> --suffix <0..255> --y-hex <64 hex> \
+--msg-hex <hex> --proof <file>";
+
+fn run() -> Result<bool, String> {
+    let args: Vec<_> = std::env::args_os().skip(1).collect();
+    let opts = parse_options(&args, &["k", "suffix", "y-hex", "msg-hex", "proof"], &[])?;
+    let key = parse_k(&opts["k"])?;
+    let suffix = parse_suffix(&opts["suffix"])?;
+    let y = parse_y(&opts["y-hex"])?;
+    let msg = parse_hex("msg-hex", &opts["msg-hex"], common::MAX_MESSAGE_LEN)?;
+    let limit = proof_length(STATEMENT1_ID).expect("statement 0x01 is registered");
+    let proof = match read_limited(&opts["proof"], limit) {
+        Ok(Ok(p)) => p,
+        Ok(Err(())) => return Ok(false),
+        Err(e) => return Err(format!("--proof: cannot read the file: {e}")),
+    };
+    let public_inputs = s1_encode_public(&key, suffix, &y).ok_or("--k: not a valid K")?;
+    Ok(verify(STATEMENT1_ID, &public_inputs, &msg, &proof))
+}
+
+fn main() -> ExitCode {
+    match run() {
+        Ok(true) => {
+            println!("valid");
+            ExitCode::SUCCESS
+        }
+        Ok(false) => {
+            println!("invalid");
+            ExitCode::from(1)
+        }
+        Err(e) => {
+            eprintln!("voleith-verify: {e}\n{USAGE}");
+            ExitCode::from(2)
+        }
+    }
+}
diff --git a/src/rescue/voleith/src/bits.rs b/src/rescue/voleith/src/bits.rs
new file mode 100644
index 0000000..0fe12a3
--- /dev/null
+++ b/src/rescue/voleith/src/bits.rs
@@ -0,0 +1,98 @@
+//! Bit strings (SPEC.md §1.2): bit i is bit (i mod 8) of byte (i div 8);
+//! the unused high bits of the last byte are padding and must be zero.
+
+#![forbid(unsafe_code)]
+
+/// Bytes needed for `nbits` bits.
+#[inline]
+pub const fn nbytes(nbits: usize) -> usize {
+    nbits.div_ceil(8)
+}
+
+/// True iff `data` is exactly `nbytes(nbits)` long and every padding bit is
+/// zero.
+pub fn is_canonical(data: &[u8], nbits: usize) -> bool {
+    if data.len() != nbytes(nbits) {
+        return false;
+    }
+    let used = nbits % 8;
+    match data.last() {
+        Some(&last) if used != 0 => last >> used == 0,
+        _ => true,
+    }
+}
+
+/// Clear the padding bits of a bit string of `nbits` bits held in
+/// `nbytes(nbits)` bytes.
+#[inline]
+pub fn clear_padding(data: &mut [u8], nbits: usize) {
+    let used = nbits % 8;
+    if used != 0 {
+        if let Some(last) = data.last_mut() {
+            *last &= (1u8 << used) - 1;
+        }
+    }
+}
+
+/// Bits [start, start + nbits) of a bit string as an integer (nbits <= 128);
+/// positions beyond the end of `data` read as zero.
+pub fn load_bits(data: &[u8], start: usize, nbits: usize) -> u128 {
+    debug_assert!(nbits <= 128);
+    let off = start / 8;
+    let sh = start % 8;
+    let mut buf = [0u8; 17];
+    if off < data.len() {
+        let avail = (data.len() - off).min(17);
+        buf[..avail].copy_from_slice(&data[off..off + avail]);
+    }
+    let mut lo = [0u8; 16];
+    lo.copy_from_slice(&buf[..16]);
+    let mut v = u128::from_le_bytes(lo) >> sh;
+    if sh != 0 {
+        v |= (buf[16] as u128) << (128 - sh);
+    }
+    if nbits < 128 {
+        v &= (1u128 << nbits) - 1;
+    }
+    v
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn canonical_padding() {
+        assert!(is_canonical(&[0x7f], 7));
+        assert!(!is_canonical(&[0x80], 7));
+        assert!(!is_canonical(&[0x00, 0x00], 7));
+        assert!(is_canonical(&[0xff], 8));
+        assert!(is_canonical(&[], 0));
+        assert!(!is_canonical(&[0x00], 0));
+        let mut b = [0xffu8; 3];
+        clear_padding(&mut b, 17);
+        assert_eq!(b, [0xff, 0xff, 0x01]);
+    }
+
+    #[test]
+    fn load_bits_matches_big_integer_view() {
+        let data: Vec<u8> = (0..40u32).map(|i| (i * 37 + 11) as u8).collect();
+        // reference: bit i of the string
+        let bit = |i: usize| -> u128 {
+            if i / 8 < data.len() {
+                ((data[i / 8] >> (i % 8)) & 1) as u128
+            } else {
+                0
+            }
+        };
+        for start in [0usize, 1, 7, 8, 9, 63, 64, 100, 200, 250, 319, 320] {
+            for nbits in [1usize, 7, 64, 87, 127, 128] {
+                let mut expect = 0u128;
+                for k in 0..nbits {
+                    expect |= bit(start + k) << k;
+                }
+                assert_eq!(load_bits(&data, start, nbits), expect, "{start} {nbits}");
+            }
+        }
+    }
+}
diff --git a/src/rescue/voleith/src/circuit.rs b/src/rescue/voleith/src/circuit.rs
new file mode 100644
index 0000000..d3029f7
--- /dev/null
+++ b/src/rescue/voleith/src/circuit.rs
@@ -0,0 +1,415 @@
+//! Generic constraint layer: a straight-line Boolean program (SPEC.md §7.1–§7.3).
+//!
+//! Wires 0 and 1 are the constants; then come the public input bits, then the
+//! secret input bits; every emitted XOR/AND/NOT creates the next wire. An
+//! output is SEC if any input is SEC, otherwise PUB. An AND of two SEC wires
+//! (MUL) creates a witness bit and the constraint `a*b = out`; ASSERT(a,b,c)
+//! adds the constraint `a*b = c`. Constants are folded by fixed local rules,
+//! so the instruction list depends only on wire kinds, never on public values.
+
+#![forbid(unsafe_code)]
+
+use crate::gf128::{self, FixedMul};
+use crate::sha256;
+#[cfg(feature = "prover")]
+use zeroize::Zeroizing;
+
+pub const CONST: u8 = 0;
+pub const PUB: u8 = 1;
+pub const SEC: u8 = 2;
+
+/// An instruction as built, in call order (serialized by `Circuit::digest`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Instr {
+    Xor(u32, u32),
+    /// AND with at most one SEC input (linear in the witness).
+    And(u32, u32),
+    /// AND of two SEC inputs: a new witness bit and a constraint.
+    Mul(u32, u32),
+    Not(u32),
+    Assert(u32, u32, u32),
+}
+
+/// The same instruction with operand kinds resolved, for evaluation with
+/// MACs (prover) or keys (verifier). `S` = SEC operand, `P` = PUB or CONST
+/// operand; for mixed operations the SEC operand comes first.
+#[derive(Clone, Copy, Debug)]
+enum Op {
+    XorSS(u32, u32),
+    XorSP(u32, u32),
+    XorPP(u32, u32),
+    NotS(u32),
+    NotP(u32),
+    AndSP(u32, u32),
+    AndPP(u32, u32),
+    Mul(u32, u32),
+    /// Operands and a mask of which are SEC (bit 0: a, bit 1: b, bit 2: c).
+    Assert(u32, u32, u32, u8),
+}
+
+/// Emits a canonical instruction list (SPEC.md §7.2).
+pub struct Builder {
+    n_public: usize,
+    n_secret: usize,
+    kind: Vec<u8>,
+    instrs: Vec<Instr>,
+    ops: Vec<Op>,
+    n_mul: usize,
+    n_assert: usize,
+    pub outputs: Vec<u32>,
+}
+
+impl Builder {
+    pub fn new(n_public: usize, n_secret: usize) -> Self {
+        let mut kind = vec![CONST, CONST];
+        kind.extend(std::iter::repeat_n(PUB, n_public));
+        kind.extend(std::iter::repeat_n(SEC, n_secret));
+        Builder {
+            n_public,
+            n_secret,
+            kind,
+            instrs: Vec::new(),
+            ops: Vec::new(),
+            n_mul: 0,
+            n_assert: 0,
+            outputs: Vec::new(),
+        }
+    }
+
+    pub fn public(&self, i: usize) -> u32 {
+        debug_assert!(i < self.n_public);
+        (2 + i) as u32
+    }
+
+    pub fn secret(&self, i: usize) -> u32 {
+        debug_assert!(i < self.n_secret);
+        (2 + self.n_public + i) as u32
+    }
+
+    pub fn kind(&self, w: u32) -> u8 {
+        self.kind[w as usize]
+    }
+
+    pub fn is_secret(&self, w: u32) -> bool {
+        self.kind(w) == SEC
+    }
+
+    fn emit(&mut self, ins: Instr, op: Op, kind: u8) -> u32 {
+        self.instrs.push(ins);
+        self.ops.push(op);
+        self.kind.push(kind);
+        (self.kind.len() - 1) as u32
+    }
+
+    pub fn xor(&mut self, a: u32, b: u32) -> u32 {
+        if a <= 1 && b <= 1 {
+            return a ^ b;
+        }
+        let (a, b) = if a <= 1 { (b, a) } else { (a, b) };
+        if b <= 1 {
+            return if b == 0 { a } else { self.not(a) };
+        }
+        let (sa, sb) = (self.is_secret(a), self.is_secret(b));
+        let op = match (sa, sb) {
+            (true, true) => Op::XorSS(a, b),
+            (true, false) => Op::XorSP(a, b),
+            (false, true) => Op::XorSP(b, a),
+            (false, false) => Op::XorPP(a, b),
+        };
+        let kind = if sa || sb { SEC } else { PUB };
+        self.emit(Instr::Xor(a, b), op, kind)
+    }
+
+    pub fn and(&mut self, a: u32, b: u32) -> u32 {
+        if a <= 1 && b <= 1 {
+            return a & b;
+        }
+        let (a, b) = if a <= 1 { (b, a) } else { (a, b) };
+        if b <= 1 {
+            return if b == 1 { a } else { 0 };
+        }
+        match (self.is_secret(a), self.is_secret(b)) {
+            (true, true) => {
+                self.n_mul += 1;
+                self.emit(Instr::Mul(a, b), Op::Mul(a, b), SEC)
+            }
+            (true, false) => self.emit(Instr::And(a, b), Op::AndSP(a, b), SEC),
+            (false, true) => self.emit(Instr::And(a, b), Op::AndSP(b, a), SEC),
+            (false, false) => self.emit(Instr::And(a, b), Op::AndPP(a, b), PUB),
+        }
+    }
+
+    pub fn not(&mut self, a: u32) -> u32 {
+        if a <= 1 {
+            return 1 - a;
+        }
+        if self.is_secret(a) {
+            self.emit(Instr::Not(a), Op::NotS(a), SEC)
+        } else {
+            self.emit(Instr::Not(a), Op::NotP(a), PUB)
+        }
+    }
+
+    /// The constraint a * b = c over GF(2).
+    pub fn assert_mul(&mut self, a: u32, b: u32, c: u32) {
+        let mask = (self.is_secret(a) as u8)
+            | ((self.is_secret(b) as u8) << 1)
+            | ((self.is_secret(c) as u8) << 2);
+        self.instrs.push(Instr::Assert(a, b, c));
+        self.ops.push(Op::Assert(a, b, c, mask));
+        self.n_assert += 1;
+    }
+
+    pub fn build(self) -> Circuit {
+        Circuit {
+            n_public: self.n_public,
+            n_secret: self.n_secret,
+            n_wires: self.kind.len(),
+            n_mul: self.n_mul,
+            n_assert: self.n_assert,
+            n_witness: self.n_secret + self.n_mul,
+            n_constraints: self.n_mul + self.n_assert,
+            instrs: self.instrs,
+            ops: self.ops,
+            outputs: self.outputs,
+        }
+    }
+}
+
+/// Gate counts in the form of the vectors' `gate_counts` (AND includes MUL).
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct GateCounts {
+    pub xor: usize,
+    pub and: usize,
+    pub not: usize,
+    pub assert: usize,
+    pub and_secret_secret: usize,
+}
+
+pub struct Circuit {
+    pub n_public: usize,
+    pub n_secret: usize,
+    pub n_wires: usize,
+    pub n_mul: usize,
+    pub n_assert: usize,
+    /// Witness bits: secret inputs, then MUL outputs.
+    pub n_witness: usize,
+    /// Constraints: MULs and ASSERTs in instruction order.
+    pub n_constraints: usize,
+    pub instrs: Vec<Instr>,
+    ops: Vec<Op>,
+    pub outputs: Vec<u32>,
+}
+
+#[inline]
+fn mask(bit: u128) -> u128 {
+    0u128.wrapping_sub(bit)
+}
+
+impl Circuit {
+    pub fn counts(&self) -> GateCounts {
+        let mut c = GateCounts::default();
+        for ins in &self.instrs {
+            match ins {
+                Instr::Xor(..) => c.xor += 1,
+                Instr::And(..) => c.and += 1,
+                Instr::Mul(..) => {
+                    c.and += 1;
+                    c.and_secret_secret += 1;
+                }
+                Instr::Not(..) => c.not += 1,
+                Instr::Assert(..) => c.assert += 1,
+            }
+        }
+        c
+    }
+
+    /// Canonical serialization (SPEC.md §7.6).
+    pub fn serialize(&self) -> Vec<u8> {
+        let mut out = Vec::with_capacity(40 + 13 * self.instrs.len() + 4 * self.outputs.len());
+        out.extend_from_slice(b"VOLEitH-rescue circuit v0.1\x00");
+        out.extend_from_slice(&(self.n_public as u32).to_le_bytes());
+        out.extend_from_slice(&(self.n_secret as u32).to_le_bytes());
+        out.extend_from_slice(&(self.instrs.len() as u32).to_le_bytes());
+        for ins in &self.instrs {
+            let (code, operands): (u8, &[u32]) = match ins {
+                Instr::Xor(a, b) => (1, &[*a, *b][..]),
+                Instr::And(a, b) | Instr::Mul(a, b) => (2, &[*a, *b][..]),
+                Instr::Not(a) => (3, &[*a][..]),
+                Instr::Assert(a, b, c) => (4, &[*a, *b, *c][..]),
+            };
+            out.push(code);
+            for w in operands {
+                out.extend_from_slice(&w.to_le_bytes());
+            }
+        }
+        out.extend_from_slice(&(self.outputs.len() as u32).to_le_bytes());
+        for w in &self.outputs {
+            out.extend_from_slice(&w.to_le_bytes());
+        }
+        out
+    }
+
+    /// SHA-256 of the canonical serialization.
+    pub fn digest(&self) -> [u8; 32] {
+        sha256::sha256(&self.serialize())
+    }
+
+    /// Evaluate in the clear. Returns every wire value, the witness bits and
+    /// whether every ASSERT holds. The work and the memory accesses depend
+    /// only on the instruction list, never on the wire values. Both vectors
+    /// hold secrets and are zeroizing from their allocation on, at their
+    /// final capacity, so no reallocation leaves a copy behind.
+    #[cfg(feature = "prover")]
+    pub fn evaluate(
+        &self,
+        public_bits: &[u8],
+        secret_bits: &[u8],
+    ) -> (Zeroizing<Vec<u8>>, Zeroizing<Vec<u8>>, bool) {
+        assert_eq!(public_bits.len(), self.n_public, "public input length");
+        assert_eq!(secret_bits.len(), self.n_secret, "secret input length");
+        let mut vals = Zeroizing::new(Vec::<u8>::with_capacity(self.n_wires));
+        vals.extend_from_slice(&[0, 1]);
+        vals.extend_from_slice(public_bits);
+        vals.extend_from_slice(secret_bits);
+        let mut witness = Zeroizing::new(Vec::<u8>::with_capacity(self.n_witness));
+        witness.extend_from_slice(secret_bits);
+        // OR of (a & b) ^ c over every ASSERT: no branch on wire values.
+        let mut bad = 0u8;
+        for ins in &self.instrs {
+            match *ins {
+                Instr::Xor(a, b) => {
+                    let v = vals[a as usize] ^ vals[b as usize];
+                    vals.push(v);
+                }
+                Instr::And(a, b) => {
+                    let v = vals[a as usize] & vals[b as usize];
+                    vals.push(v);
+                }
+                Instr::Mul(a, b) => {
+                    let v = vals[a as usize] & vals[b as usize];
+                    vals.push(v);
+                    witness.push(v);
+                }
+                Instr::Not(a) => {
+                    let v = vals[a as usize] ^ 1;
+                    vals.push(v);
+                }
+                Instr::Assert(a, b, c) => {
+                    bad |= (vals[a as usize] & vals[b as usize]) ^ vals[c as usize];
+                }
+            }
+        }
+        // Filled exactly to the capacities above: nothing was reallocated.
+        debug_assert_eq!(vals.len(), self.n_wires);
+        debug_assert_eq!(witness.len(), self.n_witness);
+        (vals, witness, bad == 0)
+    }
+
+    /// Prover terms (SPEC.md §6.2) for every constraint in order:
+    /// `sink(A0_t, A1_t)` with A0 = v_a v_b and A1 = b_a v_b + b_b v_a + v_c.
+    /// `tags[r]` is the VOLE tag v[r] of witness bit r.
+    #[cfg(feature = "prover")]
+    pub fn prover_terms(
+        &self,
+        public_bits: &[u8],
+        witness_bits: &[u8],
+        tags: &[u128],
+        mut sink: impl FnMut(u128, u128),
+    ) {
+        assert_eq!(public_bits.len(), self.n_public, "public input length");
+        assert_eq!(witness_bits.len(), self.n_witness, "witness length");
+        assert!(tags.len() >= self.n_witness, "tag length");
+        // Wire values and MACs are secret: zeroized on return, and allocated
+        // at their final size so that no reallocation leaves a copy.
+        let mut bits = Zeroizing::new(Vec::<u8>::with_capacity(self.n_wires));
+        let mut macs = Zeroizing::new(Vec::<u128>::with_capacity(self.n_wires));
+        bits.extend_from_slice(&[0, 1]);
+        bits.extend_from_slice(public_bits);
+        bits.extend_from_slice(&witness_bits[..self.n_secret]);
+        macs.resize(2 + self.n_public, 0);
+        macs.extend_from_slice(&tags[..self.n_secret]);
+        let mut wi = self.n_secret;
+        for op in &self.ops {
+            let (bit, mac) = match *op {
+                Op::XorSS(a, b) | Op::XorPP(a, b) => (
+                    bits[a as usize] ^ bits[b as usize],
+                    macs[a as usize] ^ macs[b as usize],
+                ),
+                Op::XorSP(s, p) => (bits[s as usize] ^ bits[p as usize], macs[s as usize]),
+                Op::NotS(a) | Op::NotP(a) => (bits[a as usize] ^ 1, macs[a as usize]),
+                Op::AndSP(s, p) => {
+                    let bp = bits[p as usize];
+                    (bits[s as usize] & bp, macs[s as usize] & mask(bp as u128))
+                }
+                Op::AndPP(a, b) => (bits[a as usize] & bits[b as usize], 0),
+                Op::Mul(a, b) => {
+                    let (ba, ma) = (bits[a as usize] as u128, macs[a as usize]);
+                    let (bb, mb) = (bits[b as usize] as u128, macs[b as usize]);
+                    let (bz, mz) = (witness_bits[wi], tags[wi]);
+                    wi += 1;
+                    sink(gf128::mul(ma, mb), (mb & mask(ba)) ^ (ma & mask(bb)) ^ mz);
+                    (bz, mz)
+                }
+                Op::Assert(a, b, c, _) => {
+                    let (ba, ma) = (bits[a as usize] as u128, macs[a as usize]);
+                    let (bb, mb) = (bits[b as usize] as u128, macs[b as usize]);
+                    sink(
+                        gf128::mul(ma, mb),
+                        (mb & mask(ba)) ^ (ma & mask(bb)) ^ macs[c as usize],
+                    );
+                    continue;
+                }
+            };
+            bits.push(bit);
+            macs.push(mac);
+        }
+    }
+
+    /// Verifier terms (SPEC.md §6.2, §7.3) for every constraint in order:
+    /// `sink(B_t)` with B_t = q_a q_b + q_c Delta. `keys[r]` is the key q[r] of
+    /// witness bit r after the witness correction; a PUB or CONST wire with bit
+    /// p has key p * Delta.
+    pub fn verifier_terms(
+        &self,
+        public_bits: &[u8],
+        keys: &[u128],
+        delta: u128,
+        mul_delta: &FixedMul,
+        mut sink: impl FnMut(u128),
+    ) {
+        debug_assert_eq!(public_bits.len(), self.n_public);
+        debug_assert!(keys.len() >= self.n_witness);
+        // SEC wires hold keys, PUB/CONST wires hold their bit (0 or 1).
+        let mut vals: Vec<u128> = Vec::with_capacity(self.n_wires);
+        vals.extend_from_slice(&[0, 1]);
+        vals.extend(public_bits.iter().map(|&b| b as u128));
+        vals.extend_from_slice(&keys[..self.n_secret]);
+        let key_of = |v: u128, sec: bool| if sec { v } else { delta & mask(v) };
+        let mut wi = self.n_secret;
+        for op in &self.ops {
+            let v = match *op {
+                Op::XorSS(a, b) | Op::XorPP(a, b) => vals[a as usize] ^ vals[b as usize],
+                Op::XorSP(s, p) => vals[s as usize] ^ (delta & mask(vals[p as usize])),
+                Op::NotS(a) => vals[a as usize] ^ delta,
+                Op::NotP(a) => vals[a as usize] ^ 1,
+                Op::AndSP(s, p) => vals[s as usize] & mask(vals[p as usize]),
+                Op::AndPP(a, b) => vals[a as usize] & vals[b as usize],
+                Op::Mul(a, b) => {
+                    let kz = keys[wi];
+                    wi += 1;
+                    sink(gf128::mul_public(vals[a as usize], vals[b as usize]) ^ mul_delta.mul(kz));
+                    kz
+                }
+                Op::Assert(a, b, c, m) => {
+                    let ka = key_of(vals[a as usize], m & 1 != 0);
+                    let kb = key_of(vals[b as usize], m & 2 != 0);
+                    let kc = key_of(vals[c as usize], m & 4 != 0);
+                    sink(gf128::mul_public(ka, kb) ^ mul_delta.mul(kc));
+                    continue;
+                }
+            };
+            vals.push(v);
+        }
+    }
+}
diff --git a/src/rescue/voleith/src/clmul.rs b/src/rescue/voleith/src/clmul.rs
new file mode 100644
index 0000000..65b7f52
--- /dev/null
+++ b/src/rescue/voleith/src/clmul.rs
@@ -0,0 +1,69 @@
+//! Carry-less multiplication with PCLMULQDQ (x86 and x86-64), selected at
+//! run time with `is_x86_feature_detected!`.
+//!
+//! This module and [`crate::ffi`] are the only ones that may contain unsafe
+//! code: calling a `#[target_feature]` function, which is sound only after
+//! the feature has been detected on the running CPU.
+//!
+//! PCLMULQDQ runs in a fixed number of cycles independent of its operands,
+//! and nothing here branches on or indexes by the operands.
+
+#![allow(unsafe_code)]
+
+#[cfg(target_arch = "x86")]
+use core::arch::x86::{__m128i, _mm_clmulepi64_si128, _mm_set_epi64x, _mm_storeu_si128};
+#[cfg(target_arch = "x86_64")]
+use core::arch::x86_64::{__m128i, _mm_clmulepi64_si128, _mm_set_epi64x, _mm_storeu_si128};
+
+/// Whether the running CPU has PCLMULQDQ (and SSE2, which the loads and
+/// stores need). The detection result is cached by the standard library;
+/// with `-C target-feature=+pclmulqdq` it is a compile-time constant.
+#[inline]
+pub fn available() -> bool {
+    std::arch::is_x86_feature_detected!("pclmulqdq") && std::arch::is_x86_feature_detected!("sse2")
+}
+
+/// Carry-less product of two 128-bit polynomials as (low, high) halves.
+///
+/// # Safety
+/// The CPU must support PCLMULQDQ and SSE2 (`available()` returned true).
+#[target_feature(enable = "pclmulqdq,sse2")]
+unsafe fn clmul128_hw(a: u128, b: u128) -> (u128, u128) {
+    let va = _mm_set_epi64x((a >> 64) as u64 as i64, a as u64 as i64);
+    let vb = _mm_set_epi64x((b >> 64) as u64 as i64, b as u64 as i64);
+    // Schoolbook: four 64x64 products.
+    let lo = _mm_clmulepi64_si128(va, vb, 0x00);
+    let hi = _mm_clmulepi64_si128(va, vb, 0x11);
+    let m0 = _mm_clmulepi64_si128(va, vb, 0x01);
+    let m1 = _mm_clmulepi64_si128(va, vb, 0x10);
+    let mut out = [[0u8; 16]; 4];
+    for (o, v) in out.iter_mut().zip([lo, hi, m0, m1]) {
+        // Unaligned store into 16 writable bytes.
+        _mm_storeu_si128(o.as_mut_ptr().cast::<__m128i>(), v);
+    }
+    let lo = u128::from_le_bytes(out[0]);
+    let hi = u128::from_le_bytes(out[1]);
+    let mid = u128::from_le_bytes(out[2]) ^ u128::from_le_bytes(out[3]);
+    (lo ^ (mid << 64), hi ^ (mid >> 64))
+}
+
+/// Product in GF(2^128) with PCLMULQDQ.
+///
+/// # Safety
+/// The CPU must support PCLMULQDQ and SSE2 (`available()` returned true).
+#[target_feature(enable = "pclmulqdq,sse2")]
+unsafe fn mul_hw(a: u128, b: u128) -> u128 {
+    let (lo, hi) = clmul128_hw(a, b);
+    crate::gf128::reduce(lo, hi)
+}
+
+/// Product in GF(2^128) with PCLMULQDQ, or None if the running CPU lacks it.
+#[inline]
+pub fn mul(a: u128, b: u128) -> Option<u128> {
+    if available() {
+        // SAFETY: PCLMULQDQ and SSE2 were detected on the running CPU.
+        Some(unsafe { mul_hw(a, b) })
+    } else {
+        None
+    }
+}
diff --git a/src/rescue/voleith/src/dudect.rs b/src/rescue/voleith/src/dudect.rs
new file mode 100644
index 0000000..4840ae2
--- /dev/null
+++ b/src/rescue/voleith/src/dudect.rs
@@ -0,0 +1,430 @@
+//! dudect-style statistical timing tests (Reparaz, Balasch, Verbauwhede,
+//! "Dude, is my code constant time?", DATE 2017): fixed versus random
+//! secret inputs, classes interleaved at random, Welch's t-test on the raw
+//! timings and on timings cropped at several upper percentiles.
+//!
+//! A |t| below the threshold is evidence, not proof: it says that this
+//! machine, this build and this number of samples showed no difference
+//! between the classes. See rust/CT-AUDIT.md for the recorded results.
+//!
+//! The tests are `#[ignore]`d because timing is noisy on shared machines.
+//! Run them on a quiet machine, single-threaded and optimised:
+//!
+//! ```text
+//! cargo test --release --lib dudect -- --ignored --nocapture --test-threads=1
+//! ```
+//!
+//! `DUDECT_SAMPLES` (GF multiplication, default 200000) and
+//! `DUDECT_PROVE_SAMPLES` (prove(), default 1000) set the measurement count.
+
+use std::hint::black_box;
+use std::time::Instant;
+
+use crate::gf128::{self, FixedMul};
+
+/// |t| above this suggests a timing difference (the usual TVLA threshold).
+const T_THRESHOLD: f64 = 4.5;
+
+/// SplitMix64.
+struct Rng(u64);
+
+impl Rng {
+    fn from_time() -> Self {
+        let t = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos() as u64;
+        Rng(t ^ 0x5DEE_CE66_D1CE_4E5B)
+    }
+
+    fn next(&mut self) -> u64 {
+        self.0 = self.0.wrapping_add(0x9E37_79B9_7F4A_7C15);
+        let mut z = self.0;
+        z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+        z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+        z ^ (z >> 31)
+    }
+
+    fn u128(&mut self) -> u128 {
+        ((self.next() as u128) << 64) | self.next() as u128
+    }
+
+    fn fill(&mut self, out: &mut [u8]) {
+        for chunk in out.chunks_mut(8) {
+            let v = self.next().to_le_bytes();
+            chunk.copy_from_slice(&v[..chunk.len()]);
+        }
+    }
+}
+
+/// Welford's running mean and variance.
+#[derive(Clone, Copy, Default)]
+struct Moments {
+    n: f64,
+    mean: f64,
+    m2: f64,
+}
+
+impl Moments {
+    fn push(&mut self, x: f64) {
+        self.n += 1.0;
+        let d = x - self.mean;
+        self.mean += d / self.n;
+        self.m2 += d * (x - self.mean);
+    }
+}
+
+/// Welch's t of class `a` against class `b`.
+///
+/// - Fewer than 2 samples in a class: the variance is undefined and the
+///   test cannot decide, so the result is NaN. Every `|t| < threshold`
+///   check is false for NaN, so an undecidable test fails rather than
+///   passes.
+/// - Zero variance in both classes: the classes are fully distinguishable
+///   if their means differ, so the result is a signed infinity; equal means
+///   give 0.
+fn welch_t(a: &Moments, b: &Moments) -> f64 {
+    if a.n < 2.0 || b.n < 2.0 {
+        return f64::NAN;
+    }
+    let va = a.m2 / (a.n - 1.0);
+    let vb = b.m2 / (b.n - 1.0);
+    let den = (va / a.n + vb / b.n).sqrt();
+    let diff = a.mean - b.mean;
+    if den == 0.0 {
+        if diff == 0.0 {
+            0.0
+        } else {
+            diff.signum() * f64::INFINITY
+        }
+    } else {
+        diff / den
+    }
+}
+
+/// The result of one test: the largest |t| over the decidable crops (the
+/// raw timings count as a crop), which crop gave it, the first undecidable
+/// crop if any, and the class medians.
+struct Report {
+    max_t: f64,
+    worst: String,
+    undecidable: Option<String>,
+    median_fixed: f64,
+    median_random: f64,
+    n: usize,
+}
+
+/// Welch's t over the raw timings and over timings at or below each of a
+/// few upper percentiles of the pooled distribution (dudect's cropping,
+/// which removes interrupts and other long-tail noise).
+///
+/// An undecidable crop (NaN, see [`welch_t`]) does not touch `max_t`, so a
+/// leak found by another crop stays visible; it is recorded in
+/// `undecidable` and makes the report fail [`Report::passes`].
+fn analyse(samples: &[(bool, f64)]) -> Report {
+    let mut pooled: Vec<f64> = samples.iter().map(|s| s.1).collect();
+    pooled.sort_by(|a, b| a.partial_cmp(b).unwrap());
+    let pct = |p: f64| pooled[((p * pooled.len() as f64) as usize).min(pooled.len() - 1)];
+    let mut crops: Vec<(String, f64)> = vec![("raw".into(), f64::INFINITY)];
+    for p in [0.99, 0.95, 0.90, 0.75, 0.50] {
+        crops.push((format!("<= p{}", (p * 100.0) as u32), pct(p)));
+    }
+    let mut max_t = 0.0f64;
+    let mut worst = String::new();
+    let mut undecidable = None;
+    for (name, cut) in &crops {
+        let (mut f, mut r) = (Moments::default(), Moments::default());
+        for &(fixed, x) in samples {
+            if x <= *cut {
+                if fixed {
+                    f.push(x)
+                } else {
+                    r.push(x)
+                }
+            }
+        }
+        let t = welch_t(&f, &r);
+        if t.is_nan() {
+            undecidable.get_or_insert_with(|| name.clone());
+            continue;
+        }
+        if t.abs() > max_t.abs() {
+            max_t = t;
+            worst = name.clone();
+        }
+    }
+    let median = |want: bool| {
+        let mut v: Vec<f64> = samples
+            .iter()
+            .filter(|s| s.0 == want)
+            .map(|s| s.1)
+            .collect();
+        v.sort_by(|a, b| a.partial_cmp(b).unwrap());
+        v[v.len() / 2]
+    };
+    Report {
+        max_t,
+        worst,
+        undecidable,
+        median_fixed: median(true),
+        median_random: median(false),
+        n: samples.len(),
+    }
+}
+
+impl Report {
+    /// Whether a constant-time target passes: every crop decidable and
+    /// every |t| below the threshold (an infinite t fails).
+    fn passes(&self) -> bool {
+        self.undecidable.is_none() && self.max_t.abs() < T_THRESHOLD
+    }
+
+    /// Whether a leak was detected: some decidable crop gave |t| above the
+    /// threshold, infinities included. Undecidable crops neither add nor
+    /// hide evidence.
+    fn detects_leak(&self) -> bool {
+        self.max_t.abs() > T_THRESHOLD
+    }
+}
+
+fn print(label: &str, r: &Report) {
+    println!(
+        "dudect {label}: n {}, max |t| {:.2} ({}){}, median fixed {:.1} ns, random {:.1} ns",
+        r.n,
+        r.max_t.abs(),
+        r.worst,
+        match &r.undecidable {
+            Some(c) => format!(", undecidable crop {c}"),
+            None => String::new(),
+        },
+        r.median_fixed,
+        r.median_random
+    );
+}
+
+fn env_usize(name: &str, default: usize) -> usize {
+    std::env::var(name)
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(default)
+}
+
+/// Operations per GF measurement: enough to dwarf the timer's resolution.
+const BATCH: usize = 64;
+
+/// Measurements prepared at a time (64 KiB of classes and 2 MiB of
+/// operands per chunk).
+const CHUNK: usize = 1024;
+
+/// Times `f` on batches of BATCH operand pairs, all equal to `fixed`
+/// (class fixed) or all fresh from `random` (class random), in random class
+/// order. As in dudect, the classes and operands of a whole chunk are
+/// generated before any of its measurements, so both classes run exactly
+/// the same code between the timer reads and only the operand values differ.
+fn measure_gf(
+    rng: &mut Rng,
+    n: usize,
+    fixed: (u128, u128),
+    random: impl Fn(&mut Rng) -> (u128, u128),
+    f: impl Fn(u128, u128) -> u128,
+) -> Report {
+    let warmup = n / 10;
+    let mut classes = vec![false; CHUNK];
+    let mut ops = vec![(0u128, 0u128); CHUNK * BATCH];
+    let mut out = Vec::with_capacity(n);
+    let mut done = 0;
+    while done < n + warmup {
+        for (c, batch) in classes.iter_mut().zip(ops.chunks_exact_mut(BATCH)) {
+            *c = rng.next() & 1 == 0;
+            for op in batch.iter_mut() {
+                *op = if *c { fixed } else { random(rng) };
+            }
+        }
+        for (&is_fixed, batch) in classes.iter().zip(ops.chunks_exact(BATCH)) {
+            let t = Instant::now();
+            let mut acc = 0u128;
+            for &(a, b) in batch {
+                acc ^= f(black_box(a), black_box(b));
+            }
+            black_box(acc);
+            let dt = t.elapsed().as_nanos() as f64;
+            // The first n/10 measurements warm up caches and frequency
+            // scaling.
+            if done >= warmup && out.len() < n {
+                out.push((is_fixed, dt));
+            }
+            done += 1;
+        }
+    }
+    analyse(&out)
+}
+
+/// A deliberately leaky multiplication: it skips the work when the low byte
+/// of `a` is zero. Fixed-class operands get a zero low byte, so the harness
+/// must flag it.
+fn leaky_mul(a: u128, b: u128) -> u128 {
+    if a & 0xff == 0 {
+        return 0;
+    }
+    gf128::mul(a, b)
+}
+
+#[test]
+#[ignore = "timing test: run explicitly on a quiet machine"]
+fn dudect_gf128_mul() {
+    let n = env_usize("DUDECT_SAMPLES", 200_000);
+    let mut rng = Rng::from_time();
+    println!("pclmulqdq in use: {}", gf128::has_clmul());
+
+    let random = |r: &mut Rng| (r.u128(), r.u128());
+
+    // Positive control: the harness must detect a known leak. Fixed-class
+    // operands have a zero low byte, random ones never do.
+    let control_fixed = (rng.u128() & !0xff, rng.u128());
+    let control = measure_gf(
+        &mut rng,
+        n.min(20_000),
+        control_fixed,
+        |r| (r.u128() | 1, r.u128()),
+        leaky_mul,
+    );
+    print("control (leaky by construction)", &control);
+    assert!(
+        control.detects_leak(),
+        "the harness failed to detect a known leak"
+    );
+
+    let fixed = random(&mut rng);
+    let ct = measure_gf(&mut rng, n, fixed, random, gf128::mul);
+    print("gf128::mul", &ct);
+    let portable = measure_gf(&mut rng, n, fixed, random, gf128::mul_portable);
+    print("gf128::mul_portable", &portable);
+
+    // For information only: the verifier's table-driven multiplication,
+    // which the prover no longer uses, is expected to be variable time.
+    let tables = FixedMul::new_tables(rng.u128());
+    let fixed_table = measure_gf(&mut rng, n, fixed, random, |_, x| tables.mul(x));
+    print("FixedMul tables (verifier only, not CT)", &fixed_table);
+
+    assert!(ct.passes(), "gf128::mul: |t| too large");
+    assert!(portable.passes(), "gf128::mul_portable: |t| too large");
+}
+
+#[test]
+#[ignore = "timing test: run explicitly on a quiet machine"]
+fn dudect_prove() {
+    let n = env_usize("DUDECT_PROVE_SAMPLES", 1000);
+    let mut rng = Rng::from_time();
+    let key = b"ark0-wallet v1 schnorr";
+    let suffix = 0u8;
+    let msg = [0x42u8; 96];
+    let instance = |x: [u8; 32]| {
+        let mut xs = x.to_vec();
+        xs.push(suffix);
+        let y = crate::hash::hmac_sha256(key, &xs);
+        crate::s1_encode_public(key, suffix, &y).unwrap()
+    };
+    let mut fixed_x = [0u8; 32];
+    let mut fixed_rho = [0u8; 32];
+    rng.fill(&mut fixed_x);
+    rng.fill(&mut fixed_rho);
+    let fixed_pub = instance(fixed_x);
+    // Builds the circuit, warms up.
+    crate::prove(1, &fixed_pub, &fixed_x, &msg, &fixed_rho).unwrap();
+
+    // Every input is generated before the first measurement.
+    let warmup = n / 10;
+    let inputs: Vec<_> = (0..n + warmup)
+        .map(|_| {
+            if rng.next() & 1 == 0 {
+                (true, fixed_pub.clone(), fixed_x, fixed_rho)
+            } else {
+                let mut x = [0u8; 32];
+                let mut rho = [0u8; 32];
+                rng.fill(&mut x);
+                rng.fill(&mut rho);
+                (false, instance(x), x, rho)
+            }
+        })
+        .collect();
+    let mut out = Vec::with_capacity(n);
+    for (i, (is_fixed, pub_inputs, x, rho)) in inputs.iter().enumerate() {
+        let t = Instant::now();
+        let p = crate::prove(
+            1,
+            black_box(pub_inputs),
+            black_box(x),
+            black_box(&msg),
+            black_box(rho),
+        );
+        let dt = t.elapsed().as_nanos() as f64;
+        black_box(p.unwrap());
+        if i >= warmup {
+            out.push((*is_fixed, dt));
+        }
+    }
+    let r = analyse(&out);
+    print("prove()", &r);
+    assert!(r.passes(), "prove(): |t| too large");
+}
+
+/// Welch's t must not pass a fully distinguishable sample: 100 samples of
+/// 100 ns against 100 of 200 ns have zero variance in each class, and an
+/// earlier version returned t = 0 for them (raw and every crop).
+#[test]
+fn welch_t_zero_variance_distinct_means() {
+    let samples: Vec<(bool, f64)> = (0..200)
+        .map(|i| (i % 2 == 0, if i % 2 == 0 { 100.0 } else { 200.0 }))
+        .collect();
+    let r = analyse(&samples);
+    assert_eq!(r.max_t, f64::NEG_INFINITY);
+    assert!(!r.passes());
+
+    let (mut a, mut b) = (Moments::default(), Moments::default());
+    for _ in 0..100 {
+        a.push(100.0);
+        b.push(200.0);
+    }
+    assert_eq!(welch_t(&a, &b), f64::NEG_INFINITY);
+    assert_eq!(welch_t(&b, &a), f64::INFINITY);
+    assert_eq!(welch_t(&a, &a), 0.0);
+}
+
+/// Fewer than 2 samples in a class is undecidable and must fail the test.
+#[test]
+fn welch_t_too_few_samples_fails() {
+    let (mut a, mut b) = (Moments::default(), Moments::default());
+    a.push(100.0);
+    for x in [100.0, 101.0, 99.0] {
+        b.push(x);
+    }
+    assert!(welch_t(&a, &b).is_nan());
+    assert!(welch_t(&Moments::default(), &b).is_nan());
+    let samples = [(true, 100.0), (false, 100.0), (false, 101.0)];
+    let r = analyse(&samples);
+    assert!(r.undecidable.is_some());
+    assert!(!r.passes());
+}
+
+/// An undecidable crop must not hide a leak that another crop found
+/// (review finding R1): the leak is still detected and the report still
+/// fails as a constant-time target. Unequal class sizes on purpose.
+#[test]
+fn undecidable_crop_keeps_detected_leak() {
+    // 101 fixed samples of 100 ns, 99 random of 200 ns: raw t = -inf, the
+    // p50 crop keeps only the fixed class.
+    let mut a: Vec<(bool, f64)> = vec![(true, 100.0); 101];
+    a.extend(vec![(false, 200.0); 99]);
+    // 100 fixed of 100 ns, 100 random at 200..299 ns: the p50 crop keeps a
+    // single random sample.
+    let mut b: Vec<(bool, f64)> = vec![(true, 100.0); 100];
+    b.extend((0..100).map(|i| (false, 200.0 + i as f64)));
+    for (samples, raw_infinite) in [(a, true), (b, false)] {
+        let r = analyse(&samples);
+        assert!(r.undecidable.is_some(), "a crop must be undecidable");
+        assert!(r.detects_leak(), "max |t| {}", r.max_t);
+        assert!(r.max_t < 0.0);
+        assert_eq!(r.max_t.is_infinite(), raw_infinite);
+        assert!(!r.passes());
+    }
+}
