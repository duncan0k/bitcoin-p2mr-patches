+                VAR3,
+                VAR4,
+            }
+        }
+
+        assert_eq!(VAR2, 2 as CEnumRepr);
+        assert_eq!(VAR3, 3 as CEnumRepr);
+        assert_eq!(VAR4, 4 as CEnumRepr);
+    }
+
+    #[test]
+    fn c_enum_multiple_set_value() {
