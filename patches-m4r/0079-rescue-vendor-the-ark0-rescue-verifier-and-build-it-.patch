+
+        assert_eq!(VAR0, 0 as CEnumRepr);
+        assert_eq!(VAR2_0, 2 as CEnumRepr);
+        assert_eq!(VAR3_0, 3 as CEnumRepr);
+        assert_eq!(VAR4_0, 4 as CEnumRepr);
+        assert_eq!(VAR2_1, 2 as CEnumRepr);
