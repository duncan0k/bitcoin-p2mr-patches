+
+        assert_eq!(TypeId::of::<e>(), TypeId::of::<u16>());
+        assert_eq!(VAR0, 0_u16);
+
+        assert_eq!(type_id_of_val(&ANON0), TypeId::of::<u16>());
+        assert_eq!(ANON0, 0_u16);
