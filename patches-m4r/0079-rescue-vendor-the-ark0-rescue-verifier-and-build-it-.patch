diff --git a/src/rescue/stub-vendor.py b/src/rescue/stub-vendor.py
new file mode 100644
index 0000000..28016d9
--- /dev/null
+++ b/src/rescue/stub-vendor.py
@@ -0,0 +1,63 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Reduce the vendored crates that no build of this tree compiles to their manifest.
+
+`cargo vendor` copies every package of Cargo.lock, the dev-dependencies of the tests and benchmarks
+of voleith included. Cargo still reads the manifest of each to resolve the lock file, but compiles
+none of them for the library or the test-only command-line tools. This keeps, for each such package,
+its Cargo.toml and a .cargo-checksum.json that lists only that file, with the package checksum that
+Cargo.lock pins unchanged; and src/lib.rs too when the manifest names no path for the library
+(packages published by older versions of cargo), since cargo then needs that file to parse the
+manifest. The packages named on the command line are left exactly as cargo vendor
+wrote them (see README.md).
+
+    stub-vendor.py <vendor directory> <package,package,...>
+"""
+import json
+import os
+import sys
+import tomllib
+
+
+def package_name(directory):
+    # cargo vendor --versioned-dirs names a directory <name>-<version>.
+    name, _, version = directory.rpartition("-")
+    while name and not version[:1].isdigit():
+        name, _, rest = name.rpartition("-")
+        version = rest + "-" + version
+    return name
+
+
+def main():
+    vendor = sys.argv[1]
+    keep = set(sys.argv[2].split(","))
+    for directory in sorted(os.listdir(vendor)):
+        if package_name(directory) in keep:
+            continue
+        path = os.path.join(vendor, directory)
+        with open(os.path.join(path, ".cargo-checksum.json"), encoding="utf-8") as f:
+            checksum = json.load(f)
+        kept = {"Cargo.toml": checksum["files"]["Cargo.toml"]}
+        with open(os.path.join(path, "Cargo.toml"), "rb") as f:
+            manifest = tomllib.load(f)
+        if "path" not in manifest.get("lib", {}) and "src/lib.rs" in checksum["files"]:
+            kept["src/lib.rs"] = checksum["files"]["src/lib.rs"]
+        for root, dirs, files in os.walk(path, topdown=False):
+            for name in files:
+                rel = os.path.relpath(os.path.join(root, name), path)
+                if rel not in kept and rel != ".cargo-checksum.json":
+                    os.remove(os.path.join(root, name))
+            for name in dirs:
+                sub = os.path.join(root, name)
+                if not os.listdir(sub):
+                    os.rmdir(sub)
+        checksum["files"] = kept
+        with open(os.path.join(path, ".cargo-checksum.json"), "w", encoding="utf-8") as f:
+            json.dump(checksum, f, separators=(",", ":"), sort_keys=True)
+        print("stub", directory)
+
+
+if __name__ == "__main__":
+    main()
