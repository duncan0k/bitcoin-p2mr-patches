+/**
+ * Height from which the Ark-0 signet opens the P2MR rescue lane (doc/p2mr-rescue.md), H4R. NOT
+ * DECIDED YET: until it is, it is std::numeric_limits<int>::max() and the lane stays closed on
+ * Ark-0, as OP_CHECKSLHDSA128S stayed before its height was fixed. The lane relaxes the rules (a
+ * hard fork): the height is announced at least four weeks before it, and never changes once a
+ * build carrying it has left the network's own nodes.
+ */
+inline constexpr int ARK0_RESCUE_HEIGHT{std::numeric_limits<int>::max()};
+// The lane rescues what the tripwire leaves froze: it comes after their height.
+static_assert(ARK0_RESCUE_HEIGHT > ARK0_TRIPWIRE_HEIGHT);
+static_assert(ARK0_RESCUE_HEIGHT > ARK0_SLHDSA128S_HEIGHT);
+
+/** The bytes regtest's rescue network id is the SHA256 of (doc/p2mr-rescue.md). */
+inline constexpr std::string_view P2MR_RESCUE_REGTEST_ID{"regtest"};
