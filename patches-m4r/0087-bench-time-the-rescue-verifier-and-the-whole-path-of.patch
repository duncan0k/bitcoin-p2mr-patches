From f9e971a636eed6ca86a3464a5dc793bed271f26d Mon Sep 17 00:00:00 2001
From: duncan0k <dev@ark0.si>
Date: Fri, 23 Oct 2026 22:45:10 +0000
Subject: [PATCH 87/94] bench: time the rescue verifier and the whole path of a
 rescue check

The validation weight of a rescue check is fixed by measurement:
VerifyP2MRRescueProofValid and VerifyP2MRRescueProofWorstInvalid
(chall3 = ff..ff, the most work a verification does) time the verifier,
VerifyScriptP2MRRescue the whole check as a block validates it, next to
VerifySchnorrBIP340 and VerifyScriptP2MRSchnorr of bench/mldsa44.cpp.
---
 src/bench/CMakeLists.txt             |   2 +
 src/bench/data/p2mr_rescue_spend.raw | Bin 0 -> 130493 bytes
 src/bench/p2mr_rescue.cpp            | 103 +++++++++++++++++++++++++++
 3 files changed, 105 insertions(+)
 create mode 100644 src/bench/data/p2mr_rescue_spend.raw
 create mode 100644 src/bench/p2mr_rescue.cpp

diff --git a/src/bench/CMakeLists.txt b/src/bench/CMakeLists.txt
index 9c228e2..663fdb2 100644
--- a/src/bench/CMakeLists.txt
+++ b/src/bench/CMakeLists.txt
@@ -49,6 +49,7 @@ add_executable(bench_bitcoin
   rpc_blockchain.cpp
   rpc_mempool.cpp
   sign_transaction.cpp
+  p2mr_rescue.cpp
   slhdsa128s.cpp
   streams_findbyte.cpp
   strencodings.cpp
@@ -64,6 +65,7 @@ include(TargetDataSources)
 target_raw_data_sources(bench_bitcoin NAMESPACE benchmark::data
   data/block413567.raw
   data/p2mr_mldsa44_spends.raw
+  data/p2mr_rescue_spend.raw
 )
 
 target_link_libraries(bench_bitcoin
diff --git a/src/bench/data/p2mr_rescue_spend.raw b/src/bench/data/p2mr_rescue_spend.raw
new file mode 100644
