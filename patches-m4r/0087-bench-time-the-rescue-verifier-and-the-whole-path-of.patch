diff --git a/src/bench/p2mr_rescue.cpp b/src/bench/p2mr_rescue.cpp
new file mode 100644
index 0000000..4b482fb
--- /dev/null
+++ b/src/bench/p2mr_rescue.cpp
@@ -0,0 +1,103 @@
+// Copyright (c) 2026 duncan0k
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <bench/bench.h>
+#include <bench/data/p2mr_rescue_spend.raw.h>
+#include <crypto/sha256.h>
+#include <primitives/transaction.h>
+#include <script/interpreter.h>
+#include <script/p2mr_rescue.h>
+#include <script/script.h>
+#include <streams.h>
+#include <uint256.h>
+
+#include <cassert>
+#include <cstdint>
+#include <vector>
+
+// What the validation weight of a rescue check (doc/p2mr-rescue.md) is measured with against BIP 340:
+// the proof verification on its own, valid and in its most expensive invalid form, and the whole
+// path of a check as a block validates it. VerifySchnorrBIP340 and VerifyScriptP2MRSchnorr
+// (bench/mldsa44.cpp) are the other side; run them in the same process on the same machine. The
+// spend is the vector "r1" of src/test/data/p2mr_rescue_vectors.json, on regtest.
+
+namespace {
+struct RescueSpend {
+    CMutableTransaction tx;
+    CTxOut spent;
+    uint256 network_id;
+
+    RescueSpend()
+    {
+        DataStream stream{benchmark::data::p2mr_rescue_spend};
+        stream >> TX_WITH_WITNESS(tx) >> spent;
+        CSHA256().Write(reinterpret_cast<const unsigned char*>("regtest"), 7).Finalize(network_id.begin());
+    }
+
+    /** The token, the 96-byte message and the proof of the check, as the interpreter has them. */
+    void Parts(std::vector<unsigned char>& m, std::vector<unsigned char>& proof) const
+    {
+        const auto& stack{tx.vin[0].scriptWitness.stack};
+        const auto token{ParseP2MRRescueToken(stack[0])};
+        assert(token);
+        PrecomputedTransactionData txdata;
+        txdata.Init(tx, {spent});
+        ScriptExecutionData execdata;
+        execdata.m_annex_init = execdata.m_annex_present = true;
+        execdata.m_tapleaf_hash_init = execdata.m_codeseparator_pos_init = true;
+        execdata.m_tapleaf_hash = ComputeTapleafHash(P2MR_LEAF_TRIPWIRED, stack[1]);
+        execdata.m_codeseparator_pos = 0xffffffff;
+        uint256 sighash;
+        assert(SignatureHashP2MRRescue(sighash, execdata, tx, 0, txdata, MissingDataBehavior::ASSERT_FAIL, network_id, token->sid, token->pub));
+        const valtype pubkey{stack[1].begin() + 1, stack[1].begin() + 33};
+        const uint256 commitment{P2MRRescueKeyCommitment(std::span<const unsigned char, 32>{pubkey})};
+        m.assign(sighash.begin(), sighash.end());
+        m.insert(m.end(), network_id.begin(), network_id.end());
+        m.insert(m.end(), commitment.begin(), commitment.end());
+        proof.assign(stack.back().begin() + 2, stack.back().end());
+    }
+
+    using valtype = std::vector<unsigned char>;
+};
+
+void VerifyProof(benchmark::Bench& bench, bool worst_invalid)
+{
+    const RescueSpend spend;
+    std::vector<unsigned char> m, proof;
+    spend.Parts(m, proof);
+    // chall3 = ff..ff: the most XOR work a verification can do (SPEC.md section 11), and invalid.
+    if (worst_invalid) std::fill(proof.end() - 16, proof.end(), 0xff);
+    const auto token{ParseP2MRRescueToken(spend.tx.vin[0].scriptWitness.stack[0])};
+    assert(VerifyP2MRRescueProof(*token, std::span<const unsigned char, 96>{m}, proof) == !worst_invalid);
+    bench.unit("verification").run([&] {
+        const bool ok{VerifyP2MRRescueProof(*token, std::span<const unsigned char, 96>{m}, proof)};
+        assert(ok == !worst_invalid);
+    });
+}
+} // namespace
+
+static void VerifyP2MRRescueProofValid(benchmark::Bench& bench) { VerifyProof(bench, /*worst_invalid=*/false); }
+static void VerifyP2MRRescueProofWorstInvalid(benchmark::Bench& bench) { VerifyProof(bench, /*worst_invalid=*/true); }
+
+/** The whole path of a rescue check, as a block validates the input: VerifyScript with the flags of an
+ *  open lane and elliptic curve checks disabled, without a signature cache. */
+static void VerifyScriptP2MRRescue(benchmark::Bench& bench)
+{
+    const RescueSpend spend;
+    PrecomputedTransactionData txdata;
+    txdata.Init(spend.tx, {spend.spent});
+    txdata.m_p2mr_rescue_network_id = spend.network_id;
+    const script_verify_flags flags{SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_TAPROOT | SCRIPT_VERIFY_P2MR |
+                                    SCRIPT_VERIFY_P2MR_TRIPWIRE | SCRIPT_VERIFY_P2MR_EC_DISABLED};
+    const MutableTransactionSignatureChecker checker{&spend.tx, 0, spend.spent.nValue, txdata, MissingDataBehavior::ASSERT_FAIL};
+    bench.unit("check").run([&] {
+        ScriptError err;
+        const bool ok{VerifyScript(CScript{}, spend.spent.scriptPubKey, &spend.tx.vin[0].scriptWitness, flags, checker, &err)};
+        assert(ok);
+    });
+}
+
+BENCHMARK(VerifyP2MRRescueProofValid);
+BENCHMARK(VerifyP2MRRescueProofWorstInvalid);
+BENCHMARK(VerifyScriptP2MRRescue);
