+void SignatureCache::ComputeEntryP2MRRescue(uint256& entry, std::span<const unsigned char, P2MR_RESCUE_MESSAGE_SIZE> m, uint8_t sid, std::span<const unsigned char> pub, std::span<const unsigned char> proof) const
