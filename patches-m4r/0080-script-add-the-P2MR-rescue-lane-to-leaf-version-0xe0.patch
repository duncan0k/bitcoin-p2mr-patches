+/** Rules R2 to R8 of a rescue check (doc/p2mr-rescue.md), after R1 has found a rescue token in place
+ *  of the signature of an elliptic curve check with a 32-byte key in an executed leaf of version 0xe0.
+ *  True means the check passes, as a valid signature does. */
+static bool EvalP2MRRescue(const valtype& token, const valtype& pubkey, ScriptExecutionData& execdata, const BaseSignatureChecker& checker, SigVersion sigversion, ScriptError* serror)
+{
+    // R2: the rescue weight, on top of the 50 the signature was charged, before any hashing or
+    // parsing of the annex.
+    assert(execdata.m_validation_weight_left_init);
+    execdata.m_validation_weight_left -= VALIDATION_WEIGHT_PER_P2MR_RESCUE_CHECK;
+    if (execdata.m_validation_weight_left < 0) {
+        return set_error(serror, SCRIPT_ERR_TAPSCRIPT_VALIDATION_WEIGHT);
+    }
+    // R3: one rescue check per input, counted before the signature cache is looked at, so a cache
+    // hit counts too.
+    if (execdata.m_rescue_done) return set_error(serror, SCRIPT_ERR_P2MR_RESCUE_REPEAT);
+    execdata.m_rescue_done = true;
+    // R4 to R7.
+    return checker.CheckP2MRRescue(token, pubkey, sigversion, execdata, serror);
+}
+
