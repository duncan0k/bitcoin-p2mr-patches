+std::optional<P2MRRescueToken> ParseP2MRRescueToken(std::span<const unsigned char> element)
+{
+    // Lengths first: |K| + 36 bytes, |K| in [1, 64], and never 64 or 65 bytes.
+    if (element.size() < P2MR_RESCUE_MIN_K_SIZE + P2MR_RESCUE_TOKEN_OVERHEAD ||
+        element.size() > P2MR_RESCUE_MAX_TOKEN_SIZE) return std::nullopt;
+    if (element.size() == 64 || element.size() == 65) return std::nullopt;
+    if (element[0] != P2MR_RESCUE_KEY_VERSION) return std::nullopt;
+    const uint8_t sid{element[1]};
+    if (!P2MRRescueProofSize(sid)) return std::nullopt;
+    const std::span<const unsigned char> pub{element.subspan(2)};
+    const size_t k_size{pub[0]};
+    if (k_size < P2MR_RESCUE_MIN_K_SIZE || k_size > P2MR_RESCUE_MAX_K_SIZE) return std::nullopt;
+    if (pub.size() != k_size + 34) return std::nullopt;
+    const std::span<const unsigned char> k{pub.subspan(1, k_size)};
+    if (!std::ranges::all_of(k, [](unsigned char c) { return c >= 0x20 && c <= 0x7e; })) return std::nullopt;
+    return P2MRRescueToken{
+        .sid = sid,
+        .pub = pub,
+        .k = k,
+        .suffix = pub[1 + k_size],
+        .y = pub.subspan(2 + k_size).first<32>(),
+    };
+}
+
+std::optional<size_t> P2MRRescueProofSize(uint8_t sid)
+{
+    if (sid == P2MR_RESCUE_STATEMENT_HMAC) return P2MR_RESCUE_S1_PROOF_SIZE;
+    return std::nullopt;
+}
+
+bool IsP2MRRescueAnnex(std::span<const unsigned char> annex, uint8_t sid)
+{
+    const auto proof_size{P2MRRescueProofSize(sid)};
+    return proof_size && annex.size() == 2 + *proof_size && annex[0] == ANNEX_TAG && annex[1] == P2MR_RESCUE_ANNEX_TYPE;
+}
+
+bool HasP2MRRescueRecordMark(std::span<const std::vector<unsigned char>> witness_stack)
+{
+    if (witness_stack.size() < 2) return false;
+    const std::vector<unsigned char>& last{witness_stack.back()};
+    return last.size() >= 2 && last[0] == ANNEX_TAG && last[1] == P2MR_RESCUE_ANNEX_TYPE;
+}
+
+namespace {
+/** A context for the key relation of R5. secp256k1_keypair_create needs one other than
+ *  secp256k1_context_static; y is public, so it is not randomized. */
+const secp256k1_context* RescueKeyContext()
+{
+    static const secp256k1_context* const ctx{[] {
+        secp256k1_context* c{secp256k1_context_create(SECP256K1_CONTEXT_NONE)};
+        assert(c != nullptr);
+        return c;
+    }()};
+    return ctx;
+}
+} // namespace
+
+bool CheckP2MRRescueKey(std::span<const unsigned char, 32> y, std::span<const unsigned char> pubkey)
+{
+    if (pubkey.size() != 32) return false;
+    const secp256k1_context* ctx{RescueKeyContext()};
+    // 0 < y < n.
+    if (!secp256k1_ec_seckey_verify(ctx, y.data())) return false;
+    secp256k1_keypair keypair;
+    if (!secp256k1_keypair_create(ctx, &keypair, y.data())) return false;
+    secp256k1_xonly_pubkey xonly;
+    // The parity is ignored: an x-only key stands for both y and n - y.
+    if (!secp256k1_keypair_xonly_pub(ctx, &xonly, nullptr, &keypair)) return false;
+    unsigned char x[32];
+    if (!secp256k1_xonly_pubkey_serialize(ctx, x, &xonly)) return false;
+    return std::memcmp(x, pubkey.data(), 32) == 0;
+}
+
+uint256 P2MRRescueKeyCommitment(std::span<const unsigned char, 32> pubkey)
+{
+    static const HashWriter HASHER_P2MR_RESCUE_KEY{TaggedHash("P2MR/Rescue/Key")};
+    HashWriter ss{HASHER_P2MR_RESCUE_KEY};
+    ss << uint8_t{0x00};
+    ss.write(std::as_bytes(pubkey));
+    return ss.GetSHA256();
+}
+
+namespace {
+std::atomic<uint64_t> g_proof_verifications{0};
+} // namespace
+
+bool VerifyP2MRRescueProof(const P2MRRescueToken& token, std::span<const unsigned char, P2MR_RESCUE_MESSAGE_SIZE> m, std::span<const unsigned char> proof)
+{
+    switch (token.sid) {
+    case P2MR_RESCUE_STATEMENT_HMAC:
+        g_proof_verifications.fetch_add(1, std::memory_order_relaxed);
+        // The library checks every length before it reads a pointer, returns 0 for any malformed
+        // input or internal error, and catches any panic inside itself.
+        return voleith_verify_s1(token.k.data(), token.k.size(), token.suffix, token.y.data(),
+                                 m.data(), m.size(), proof.data(), proof.size()) == 1;
+    }
+    return false;
+}
+
+uint64_t P2MRRescueProofVerifications()
+{
+    return g_proof_verifications.load(std::memory_order_relaxed);
+}
