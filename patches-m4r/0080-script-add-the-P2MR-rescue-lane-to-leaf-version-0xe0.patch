+#ifndef BITCOIN_SCRIPT_P2MR_RESCUE_H
+#define BITCOIN_SCRIPT_P2MR_RESCUE_H
+
+#include <uint256.h>
+
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+#include <vector>
+
+/**
+ * The P2MR rescue lane (doc/p2mr-rescue.md): an elliptic curve signature check in an executed P2MR
+ * leaf of version 0xe0 whose signature element is a rescue token is checked by verifying a
+ * VOLE-in-the-head proof, carried in the input's annex, that the spender knows the seed behind the
+ * key (ark0-rescue SPEC.md v0.2, version byte 0x02, statement 0x01).
+ *
+ * token = 0x03 || sid || pub, pub = u8(|K|) || K || u8(suffix) || y   (SPEC.md section 7.5)
+ * annex = 0x50 || 0x01 || proof
+ */
+
+/** The first byte of a rescue token, the key_version of the rescue signature message. */
+static constexpr uint8_t P2MR_RESCUE_KEY_VERSION{0x03};
+/** Statement 0x01 of SPEC.md: knowledge of x with HMAC-SHA256(K, x || suffix) = y. The only
+ *  registered statement. */
+static constexpr uint8_t P2MR_RESCUE_STATEMENT_HMAC{0x01};
+/** The second byte of the annex of a rescue spend: the record type "P2MR rescue proof v1". */
+static constexpr uint8_t P2MR_RESCUE_ANNEX_TYPE{0x01};
+/** The length of a statement 0x01 proof (SPEC.md section 10), and of the annex that carries it. */
+static constexpr size_t P2MR_RESCUE_S1_PROOF_SIZE{130218};
+static constexpr size_t P2MR_RESCUE_S1_ANNEX_SIZE{2 + P2MR_RESCUE_S1_PROOF_SIZE};
+/** The bounds of K (SPEC.md section 7.5). */
+static constexpr size_t P2MR_RESCUE_MIN_K_SIZE{1};
+static constexpr size_t P2MR_RESCUE_MAX_K_SIZE{64};
+/** A token is |K| + 36 bytes: 0x03, sid, |K|, K, suffix and the 32 bytes of y. */
+static constexpr size_t P2MR_RESCUE_TOKEN_OVERHEAD{36};
+static constexpr size_t P2MR_RESCUE_MAX_TOKEN_SIZE{P2MR_RESCUE_MAX_K_SIZE + P2MR_RESCUE_TOKEN_OVERHEAD};
+/** The length of the message a rescue proof binds: rescue sighash || network id || key commitment. */
+static constexpr size_t P2MR_RESCUE_MESSAGE_SIZE{96};
+
+/** A well-formed rescue token, as spans into the element it was parsed from. */
+struct P2MRRescueToken {
+    //! The statement id.
+    uint8_t sid;
+    //! The public inputs, as received: u8(|K|) || K || u8(suffix) || y.
+    std::span<const unsigned char> pub;
+    std::span<const unsigned char> k;
+    uint8_t suffix;
+    std::span<const unsigned char, 32> y;
+};
+
+/**
+ * Parse a stack element as a rescue token. Every condition is structural, and nullopt for any
+ * element that fails one: such an element is a signature and nothing else.
+ *  - the first byte is 0x03 and the second a registered statement id (only 0x01);
+ *  - the rest is the canonical encoding of SPEC.md section 7.5: 1 <= |K| <= 64, every byte of K
+ *    in 0x20..0x7e, y 32 bytes, nothing after it;
+ *  - the token is not 64 or 65 bytes long (|K| is not 28 or 29), the lengths of a BIP 340
+ *    signature, so that no element that can be a valid Schnorr signature is a token.
+ */
+std::optional<P2MRRescueToken> ParseP2MRRescueToken(std::span<const unsigned char> element);
+inline bool IsP2MRRescueToken(std::span<const unsigned char> element) { return ParseP2MRRescueToken(element).has_value(); }
+
+/** The length of a proof for a registered statement id, nullopt for any other id. */
+std::optional<size_t> P2MRRescueProofSize(uint8_t sid);
+
+/** Whether `annex` is exactly one rescue record for statement `sid`: 0x50, 0x01, and a proof of the
+ *  length of that statement, with nothing before or after. */
+bool IsP2MRRescueAnnex(std::span<const unsigned char> annex, uint8_t sid);
+
+/** The structural mark of a rescue record that policy looks for, without reading any coin: a
+ *  witness of at least two elements whose last one starts with 0x50 0x01 (doc/p2mr-rescue.md). */
+bool HasP2MRRescueRecordMark(std::span<const std::vector<unsigned char>> witness_stack);
+
+/** Rule R5: 0 < y < n, the order of secp256k1, and x(y * G) equals the 32-byte x-only key `pubkey`,
+ *  either parity of the point. */
+bool CheckP2MRRescueKey(std::span<const unsigned char, 32> y, std::span<const unsigned char> pubkey);
+
+/** pk_commitment = TaggedHash("P2MR/Rescue/Key", 0x00 || P), 0x00 for a BIP 340 x-only key. */
+uint256 P2MRRescueKeyCommitment(std::span<const unsigned char, 32> pubkey);
+
+/** Rule R7: verify the proof of a token's statement against the 96-byte message, through the C ABI
+ *  of the Rust library (voleith_verify_s1). Any error inside the library is a rejection. */
+bool VerifyP2MRRescueProof(const P2MRRescueToken& token, std::span<const unsigned char, P2MR_RESCUE_MESSAGE_SIZE> m, std::span<const unsigned char> proof);
+
+/** How many proofs VerifyP2MRRescueProof has given to the library since the process started. For the
+ *  tests, which check that a signature cache hit skips the verification. */
+uint64_t P2MRRescueProofVerifications();
+
+#endif // BITCOIN_SCRIPT_P2MR_RESCUE_H
