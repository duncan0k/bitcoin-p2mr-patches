      *    in a tripwired P2MR leaf with SCRIPT_VERIFY_P2MR_EC_DISABLED, the script execution
-     *    fails when using any non-empty signature with a 32-byte public key.
+     *    fails when using any other non-empty signature with a 32-byte public key.
      */
     success = !sig.empty();
     if (success) {
@@ -373,6 +396,12 @@ static bool EvalChecksigTapscript(const valtype& sig, const valtype& pubkey, Scr
     if (pubkey.size() == 0) {
