+template <class T>
+bool GenericTransactionSignatureChecker<T>::CheckP2MRRescue(std::span<const unsigned char> token_in, std::span<const unsigned char> pubkey, SigVersion sigversion, ScriptExecutionData& execdata, ScriptError* serror) const
+{
+    assert(sigversion == SigVersion::TAPSCRIPT);
+    // EvalChecksigTapscript only calls this for a well-formed token and a 32-byte key.
+    assert(pubkey.size() == 32);
+    const std::optional<P2MRRescueToken> token{ParseP2MRRescueToken(token_in)};
+    assert(token);
+    // R4: the annex is exactly one rescue record for the token's statement.
+    assert(execdata.m_annex_init);
+    if (!execdata.m_annex_present || !IsP2MRRescueAnnex(execdata.m_annex, token->sid)) {
+        return set_error(serror, SCRIPT_ERR_P2MR_RESCUE_ANNEX);
+    }
+    // R5: y belongs to the key of the check.
+    if (!CheckP2MRRescueKey(token->y, pubkey)) return set_error(serror, SCRIPT_ERR_P2MR_RESCUE_KEY);
+    // R6: the rescue signature message, which needs the BIP 341 data and the network id.
+    if (!this->txdata) {
+        HandleMissingData(m_mdb);
+        return set_error(serror, SCRIPT_ERR_P2MR_RESCUE_PROOF);
+    }
+    // No network id: the rescue lane is not for this network, and no proof can be bound to it.
+    if (!this->txdata->m_p2mr_rescue_network_id) return set_error(serror, SCRIPT_ERR_P2MR_RESCUE_PROOF);
+    const uint256& network_id{*this->txdata->m_p2mr_rescue_network_id};
+    uint256 sighash;
+    if (!SignatureHashP2MRRescue(sighash, execdata, *txTo, nIn, *this->txdata, m_mdb, network_id, token->sid, token->pub)) {
+        return set_error(serror, SCRIPT_ERR_P2MR_RESCUE_PROOF);
+    }
+    // R7: m = rescue_sighash || network_id || pk_commitment, exactly 96 bytes.
+    std::array<unsigned char, P2MR_RESCUE_MESSAGE_SIZE> m;
+    const uint256 pk_commitment{P2MRRescueKeyCommitment(pubkey.first<32>())};
+    std::ranges::copy(sighash, m.begin());
+    std::ranges::copy(network_id, m.begin() + 32);
+    std::ranges::copy(pk_commitment, m.begin() + 64);
+    if (!VerifyP2MRRescueProof(*token, m, execdata.m_annex.subspan(2))) {
+        return set_error(serror, SCRIPT_ERR_P2MR_RESCUE_PROOF);
+    }
+    return true;
+}
