+
+bool CachingTransactionSignatureChecker::VerifyP2MRRescueProof(const P2MRRescueToken& token, std::span<const unsigned char, P2MR_RESCUE_MESSAGE_SIZE> m, std::span<const unsigned char> proof) const
+{
+    // Rules R1 to R6 have run before this point, on a cache hit too: only the verification of the
+    // proof (R7) is saved. m holds this input's rescue signature message, so an entry never stands
+    // for another transaction or input (doc/p2mr-rescue.md).
+    uint256 entry;
+    m_signature_cache.ComputeEntryP2MRRescue(entry, m, token.sid, token.pub, proof);
+    if (m_signature_cache.Get(entry, !store)) return true;
+    if (!TransactionSignatureChecker::VerifyP2MRRescueProof(token, m, proof)) return false;
+    if (store) m_signature_cache.Set(entry);
+    return true;
