+template<typename T>
+bool SignatureHashP2MRRescue(uint256& hash_out, const ScriptExecutionData& execdata, const T& tx_to, uint32_t in_pos, const PrecomputedTransactionData& cache, MissingDataBehavior mdb, const uint256& network_id, uint8_t sid, std::span<const unsigned char> pub)
+{
+    assert(in_pos < tx_to.vin.size());
+    if (!(cache.m_bip341_taproot_ready && cache.m_spent_outputs_ready)) {
+        return HandleMissingData(mdb);
+    }
+
+    HashWriter ss{HASHER_P2MR_RESCUE_SIGHASH};
+    // Epoch, and the hash type: SIGHASH_DEFAULT, the only one.
+    ss << uint8_t{0x00} << uint8_t{SIGHASH_DEFAULT};
+    // Every input and output (SIGHASH_ALL).
+    ss << tx_to.version;
+    ss << tx_to.nLockTime;
+    ss << cache.m_prevouts_single_hash;
+    ss << cache.m_spent_amounts_single_hash;
+    ss << cache.m_spent_scripts_single_hash;
+    ss << cache.m_sequences_single_hash;
+    ss << cache.m_outputs_single_hash;
+    // spend_type: ext_flag 1 (tapscript), and an annex, which a rescue check always has. Unlike
+    // BIP 341, sha_annex is not committed: the proof is in the annex.
+    assert(execdata.m_annex_init && execdata.m_annex_present);
+    ss << uint8_t{0x03};
+    ss << in_pos;
+    assert(execdata.m_tapleaf_hash_init);
+    ss << execdata.m_tapleaf_hash;
+    ss << P2MR_RESCUE_KEY_VERSION;
+    assert(execdata.m_codeseparator_pos_init);
+    ss << execdata.m_codeseparator_pos;
+    ss << network_id;
+    ss << sid;
+    uint256 pub_hash;
+    CSHA256().Write(pub.data(), pub.size()).Finalize(pub_hash.begin());
+    ss << pub_hash;
+
+    hash_out = ss.GetSHA256();
+    return true;
+}
+
