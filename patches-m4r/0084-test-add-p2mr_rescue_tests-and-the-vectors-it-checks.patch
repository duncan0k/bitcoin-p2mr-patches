+// Through validation itself: a rescue spend the mempool accepts is verified once there (the policy
+// checks verify and store; the consensus checks after them hit the signature cache), and the block
+// that confirms it afterwards verifies nothing (its scripts were cached with the block's flags); a
+// spend the block brings first is verified when the block connects.
+BOOST_FIXTURE_TEST_CASE(signature_cache_mempool_then_block, RescueChainSetup)
+{
+    const RescueVectors& vectors{LoadVectors()};
+    ChainstateManager& chainman{*m_node.chainman};
+    BOOST_REQUIRE_EQUAL(chainman.GetConsensus().P2MRRescueHeight, 50);
+    const RescueVector& r1{vectors.Get("r1")};
+    const RescueVector& k1{vectors.Get("k1_odd")};
+    {
+        LOCK(cs_main);
+        BOOST_REQUIRE(P2MRECDisabledAfter(chainman.ActiveChain().Tip(), chainman.ActiveChainstate().CoinsTip(), chainman));
+        // The outputs the two vectors spend, as if confirmed long ago.
+        for (const RescueVector* v : {&r1, &k1}) {
+            chainman.ActiveChainstate().CoinsTip().AddCoin(v->tx.vin[0].prevout, Coin{v->spent_outputs[0], 1, false}, /*possible_overwrite=*/false);
+        }
+    }
+    // The vectors pay a fee below the minimum relay fee rate.
+    m_node.mempool->PrioritiseTransaction(r1.tx.GetHash(), 1'000'000);
+    const uint64_t before{P2MRRescueProofVerifications()};
+    {
+        LOCK(cs_main);
+        const MempoolAcceptResult result{chainman.ProcessTransaction(MakeTransactionRef(r1.tx))};
+        BOOST_REQUIRE_MESSAGE(result.m_result_type == MempoolAcceptResult::ResultType::VALID, result.m_state.ToString());
+    }
+    BOOST_CHECK_EQUAL(P2MRRescueProofVerifications() - before, 1U);
+
+    const uint64_t accepted{P2MRRescueProofVerifications()};
+    const CBlock block{CreateAndProcessBlock({r1.tx}, CScript{} << OP_TRUE)};
+    BOOST_REQUIRE_EQUAL(WITH_LOCK(cs_main, return chainman.ActiveChain().Tip()->GetBlockHash()), block.GetHash());
+    BOOST_CHECK_EQUAL(P2MRRescueProofVerifications() - accepted, 0U);
+    BOOST_CHECK(!m_node.mempool->exists(r1.tx.GetHash()));
+
+    const uint64_t connected{P2MRRescueProofVerifications()};
+    const CBlock block2{CreateAndProcessBlock({k1.tx}, CScript{} << OP_TRUE)};
+    BOOST_REQUIRE_EQUAL(WITH_LOCK(cs_main, return chainman.ActiveChain().Tip()->GetBlockHash()), block2.GetHash());
+    BOOST_CHECK_EQUAL(P2MRRescueProofVerifications() - connected, 1U);
+}
