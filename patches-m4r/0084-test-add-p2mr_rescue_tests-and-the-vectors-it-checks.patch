+// R5 with libsecp256k1: 0 < y < n, and x(y*G) is the key, either parity.
+BOOST_AUTO_TEST_CASE(key_relation)
+{
+    const RescueVectors& vectors{LoadVectors()};
+    bool seen_odd{false}, seen_even{false};
+    for (const RescueVector& v : vectors.vectors) {
+        for (const VectorInput& in : v.inputs) {
+            const std::span<const unsigned char, 32> y{in.y};
+            BOOST_CHECK(CheckP2MRRescueKey(y, in.pubkey));
+            // n - y is the secret of the same x-only key.
+            const valtype neg{Negate(in.y)};
+            BOOST_CHECK(CheckP2MRRescueKey(std::span<const unsigned char, 32>{neg}, in.pubkey));
+            (in.negated ? seen_odd : seen_even) = true;
+            // Another key.
+            valtype other{in.pubkey};
+            other[31] ^= 1;
+            BOOST_CHECK(!CheckP2MRRescueKey(y, other));
+        }
+    }
+    BOOST_CHECK(seen_odd && seen_even);
+    const valtype& pubkey{vectors.Get("r1").inputs[0].pubkey};
+    const valtype zero(32, 0);
+    BOOST_CHECK(!CheckP2MRRescueKey(std::span<const unsigned char, 32>{zero}, pubkey));
+    BOOST_CHECK(!CheckP2MRRescueKey(std::span<const unsigned char, 32>{ORDER}, pubkey));
+    valtype n_minus_1{ORDER};
+    n_minus_1[31] -= 1;
+    BOOST_CHECK(!CheckP2MRRescueKey(std::span<const unsigned char, 32>{n_minus_1}, pubkey));
+    // n - 1 is the secret of -G, whose x is that of G.
+    const valtype g_x{ParseHex("79be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798")};
+    BOOST_CHECK(CheckP2MRRescueKey(std::span<const unsigned char, 32>{n_minus_1}, g_x));
+    const valtype all_ff(32, 0xff);
+    BOOST_CHECK(!CheckP2MRRescueKey(std::span<const unsigned char, 32>{all_ff}, g_x));
+}
