+// Every vector input passes, and under the eight combinations of P2MR_TRIPWIRE, P2MR_EC_DISABLED and
+// P2MR_NO_RESCUE gives what doc/p2mr-rescue.md says.
+BOOST_AUTO_TEST_CASE(flag_combinations)
+{
+    for (const RescueVector& v : LoadVectors().vectors) {
+        if (v.name == "two_checks") continue;
+        for (const VectorInput& in : v.inputs) {
+            for (const bool tripwire : {false, true}) {
+                for (const bool ec_disabled : {false, true}) {
+                    for (const bool no_rescue : {false, true}) {
+                        script_verify_flags flags{ACTIVE & ~SCRIPT_VERIFY_P2MR_TRIPWIRE};
+                        if (tripwire) flags |= SCRIPT_VERIFY_P2MR_TRIPWIRE;
+                        if (ec_disabled) flags |= SCRIPT_VERIFY_P2MR_EC_DISABLED;
+                        if (no_rescue) flags |= SCRIPT_VERIFY_P2MR_NO_RESCUE;
+                        ScriptError expected{SCRIPT_ERR_OK};
+                        // Without P2MR_TRIPWIRE the leaf is of an unknown version and not executed.
+                        if (tripwire && no_rescue) {
+                            // The token is a signature: of a size no BIP 340 signature has.
+                            expected = ec_disabled ? SCRIPT_ERR_P2MR_EC_DISABLED : SCRIPT_ERR_SCHNORR_SIG_SIZE;
+                        }
+                        CHECK_ERR(Verify(v, in.index, flags), expected);
+                    }
+                }
+            }
+            // With DISCOURAGE_UPGRADABLE_TAPROOT_VERSION and no P2MR_TRIPWIRE, as the mempool has it
+            // below the tripwire height.
