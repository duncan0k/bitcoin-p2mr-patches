+//! The 100 blocks of TestChain100Setup on regtest with a tripwire output the chain never creates and
+//! the tripwire rules from height 50: elliptic curve checks in leaves of version 0xe0 disabled, and
+//! the rescue lane, which follows that height, open.
+struct RescueChainSetup : public TestChain100Setup {
+    RescueChainSetup()
