+// The signature cache keeps the result of R7 under the fifth salted hasher, 'R'; R1 to R6 still run on
+// a hit (doc/p2mr-rescue.md).
+BOOST_AUTO_TEST_CASE(signature_cache)
+{
+    const RescueVectors& vectors{LoadVectors()};
+    const RescueVector& r1{vectors.Get("r1")};
+    const VectorInput& in{r1.inputs[0]};
+    SignatureCache cache{DEFAULT_SIGNATURE_CACHE_BYTES};
+    const auto parsed{ParseP2MRRescueToken(in.token)};
+    const valtype& annex{r1.tx.vin[0].scriptWitness.stack.back()};
+    const std::span<const unsigned char> proof{std::span{annex}.subspan(2)};
+    uint256 entry;
+    cache.ComputeEntryP2MRRescue(entry, std::span<const unsigned char, 96>{in.m}, parsed->sid, parsed->pub, proof);
+    BOOST_CHECK(!cache.Get(entry, /*erase=*/false));
+    // Not stored without `store`; stored with it. Each miss gives the proof to the library once, and a
+    // hit does not, with `store` or without.
+    uint64_t last{P2MRRescueProofVerifications()};
+    auto verifications = [&last] {
+        const uint64_t now{P2MRRescueProofVerifications()};
+        return now - std::exchange(last, now);
+    };
+    CHECK_ERR(Verify(r1.tx, r1.spent_outputs, 0, ACTIVE, vectors.regtest, &cache, /*store=*/false), SCRIPT_ERR_OK);
+    BOOST_CHECK(!cache.Get(entry, /*erase=*/false));
+    BOOST_CHECK_EQUAL(verifications(), 1U);
+    CHECK_ERR(Verify(r1.tx, r1.spent_outputs, 0, ACTIVE, vectors.regtest, &cache, /*store=*/false), SCRIPT_ERR_OK);
+    BOOST_CHECK_EQUAL(verifications(), 1U);
+    CHECK_ERR(Verify(r1.tx, r1.spent_outputs, 0, ACTIVE, vectors.regtest, &cache, /*store=*/true), SCRIPT_ERR_OK);
+    BOOST_CHECK(cache.Get(entry, /*erase=*/false));
+    BOOST_CHECK_EQUAL(verifications(), 1U);
+    CHECK_ERR(Verify(r1.tx, r1.spent_outputs, 0, ACTIVE, vectors.regtest, &cache, /*store=*/true), SCRIPT_ERR_OK);
+    CHECK_ERR(Verify(r1.tx, r1.spent_outputs, 0, ACTIVE, vectors.regtest, &cache, /*store=*/false), SCRIPT_ERR_OK);
+    BOOST_CHECK_EQUAL(verifications(), 0U);
+    // Without a cache, every check verifies.
+    CHECK_ERR(Verify(r1.tx, r1.spent_outputs, 0, ACTIVE, vectors.regtest), SCRIPT_ERR_OK);
+    BOOST_CHECK_EQUAL(verifications(), 1U);
+    // A hit without `store` (as in a block) lets the cache erase the entry when it needs the slot: put it
+    // back, so that the cases below look it up while it is surely there.
+    cache.Set(entry);
+    BOOST_REQUIRE(cache.Get(entry, /*erase=*/false));
+    // Through the caching checker, with the entry there: another m (a changed output), another pub (K
+    // changed, y kept, so R5 passes) and another proof are each a miss, verified once and rejected, and
+    // leave the entry as it was.
+    CMutableTransaction other_m{r1.tx};
+    other_m.vout[0].nValue -= 1;
+    valtype other_k{in.k};
+    other_k[0] = other_k[0] == 'a' ? 'b' : 'a';
+    for (const CMutableTransaction& tx : {other_m,
+                                          Changed(r1, 0, [&](std::vector<valtype>& stack) { stack[0] = Token(other_k, in.suffix, in.y); }),
+                                          Changed(r1, 0, [](std::vector<valtype>& stack) { stack.back()[1000] ^= 1; })}) {
+        CHECK_ERR(Verify(tx, r1.spent_outputs, 0, ACTIVE, vectors.regtest, &cache, /*store=*/false), SCRIPT_ERR_P2MR_RESCUE_PROOF);
+        BOOST_CHECK_EQUAL(verifications(), 1U);
+        BOOST_CHECK(cache.Get(entry, /*erase=*/false));
+    }
+    // Another m, sid, pub or proof is another entry.
+    valtype m{in.m};
+    m[0] ^= 1;
+    valtype pub{parsed->pub.begin(), parsed->pub.end()};
+    pub.back() ^= 1;
+    valtype proof2{proof.begin(), proof.end()};
+    proof2[1000] ^= 1;
+    for (int i = 0; i < 4; ++i) {
+        uint256 other;
+        cache.ComputeEntryP2MRRescue(other, std::span<const unsigned char, 96>{i == 0 ? m : in.m}, i == 1 ? 0x02 : parsed->sid,
+                                     i == 2 ? std::span<const unsigned char>{pub} : parsed->pub, i == 3 ? std::span<const unsigned char>{proof2} : proof);
+        BOOST_CHECK(other != entry);
+        BOOST_CHECK(!cache.Get(other, /*erase=*/false));
+    }
+    // No other kind of entry collides: a Schnorr entry of the same bytes uses another salt.
+    uint256 schnorr;
+    cache.ComputeEntrySchnorr(schnorr, uint256{std::span<const unsigned char, 32>{std::span{in.m}.first<32>()}}, proof, XOnlyPubKey{std::span{in.pubkey}});
