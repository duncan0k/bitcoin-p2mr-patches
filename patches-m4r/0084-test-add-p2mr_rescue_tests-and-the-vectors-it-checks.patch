+// The token is recognised by its structure alone (doc/p2mr-rescue.md).
+BOOST_AUTO_TEST_CASE(token_and_annex)
+{
+    const valtype y(32, 0x11);
+    auto k_of = [](size_t size) { return valtype(size, 'a'); };
+    for (const size_t k_size : {1U, 27U, 30U, 63U, 64U}) {
+        const valtype token{Token(k_of(k_size), 0, y)};
+        BOOST_CHECK_EQUAL(token.size(), k_size + 36);
+        const auto parsed{ParseP2MRRescueToken(token)};
+        BOOST_REQUIRE(parsed);
+        BOOST_CHECK_EQUAL(parsed->sid, P2MR_RESCUE_STATEMENT_HMAC);
+        BOOST_CHECK_EQUAL(parsed->k.size(), k_size);
+        BOOST_CHECK(std::ranges::equal(parsed->pub, std::span{token}.subspan(2)));
+        BOOST_CHECK(std::ranges::equal(parsed->y, y));
+        // One byte more or less, at the end.
+        valtype longer{token};
+        longer.push_back(0);
+        BOOST_CHECK(!IsP2MRRescueToken(longer));
+        BOOST_CHECK(!IsP2MRRescueToken(std::span{token}.first(token.size() - 1)));
+        // |K| that does not match the length.
+        valtype wrong{token};
+        wrong[2] = static_cast<unsigned char>(k_size + 1);
+        BOOST_CHECK(!IsP2MRRescueToken(wrong));
+    }
+    // |K| of 0 and 65, and 28 and 29, whose tokens would be 64 and 65 bytes, the sizes of BIP 340
+    // signatures.
+    for (const size_t k_size : {28U, 29U}) {
+        const valtype token{Token(k_of(k_size), 0, y)};
+        BOOST_CHECK(token.size() == 64 || token.size() == 65);
+        BOOST_CHECK(!IsP2MRRescueToken(token));
+    }
+    BOOST_CHECK(!IsP2MRRescueToken(Token(k_of(0), 0, y)));
+    BOOST_CHECK(!IsP2MRRescueToken(Token(k_of(65), 0, y)));
+    // K outside 0x20..0x7e.
+    for (const unsigned char c : {0x1f, 0x7f, 0x00, 0x80, 0xff}) {
+        valtype k{k_of(22)};
+        k[5] = c;
+        BOOST_CHECK(!IsP2MRRescueToken(Token(k, 0, y)));
+    }
+    BOOST_CHECK(IsP2MRRescueToken(Token(valtype{0x20, 0x7e}, 0, y)));
+    // Another first byte, another statement id.
+    for (const uint8_t sid : {0x00, 0x02, 0xff}) BOOST_CHECK(!IsP2MRRescueToken(Token(k_of(22), 0, y, sid)));
+    valtype token{Token(k_of(22), 0, y)};
+    for (const unsigned char first : {0x00, 0x01, 0x02, 0x04, 0x50}) {
+        token[0] = first;
+        BOOST_CHECK(!IsP2MRRescueToken(token));
+    }
+    BOOST_CHECK(!IsP2MRRescueToken({}));
+    BOOST_CHECK(!IsP2MRRescueToken(valtype{0x03, 0x01}));
+
+    // The annex: 0x50, 0x01 and exactly one proof.
+    valtype annex(P2MR_RESCUE_S1_ANNEX_SIZE, 0x00);
+    annex[0] = 0x50;
+    annex[1] = 0x01;
+    BOOST_CHECK(IsP2MRRescueAnnex(annex, P2MR_RESCUE_STATEMENT_HMAC));
+    BOOST_CHECK(!IsP2MRRescueAnnex(annex, 0x02));
+    annex[1] = 0x02;
+    BOOST_CHECK(!IsP2MRRescueAnnex(annex, P2MR_RESCUE_STATEMENT_HMAC));
+    annex[1] = 0x01;
+    annex.push_back(0);
+    BOOST_CHECK(!IsP2MRRescueAnnex(annex, P2MR_RESCUE_STATEMENT_HMAC));
+    annex.resize(P2MR_RESCUE_S1_ANNEX_SIZE - 1);
+    BOOST_CHECK(!IsP2MRRescueAnnex(annex, P2MR_RESCUE_STATEMENT_HMAC));
+    // The structural mark policy uses.
+    BOOST_CHECK(HasP2MRRescueRecordMark(std::vector<valtype>{{0x01}, {0x50, 0x01}}));
+    BOOST_CHECK(!HasP2MRRescueRecordMark(std::vector<valtype>{{0x50, 0x01}}));
+    BOOST_CHECK(!HasP2MRRescueRecordMark(std::vector<valtype>{{0x01}, {0x50}}));
+    BOOST_CHECK(!HasP2MRRescueRecordMark(std::vector<valtype>{{0x01}, {0x50, 0x02}}));
+}
