+// What a passing rescue check does, and where a token is not one (doc/p2mr-rescue.md).
+BOOST_AUTO_TEST_CASE(semantics_and_position)
+{
+    const RescueVectors& vectors{LoadVectors()};
+    // OP_CHECKSIG pushes true, OP_CHECKSIGVERIFY goes on, OP_CHECKSIGADD adds 1, after OP_CODESEPARATOR
+    // too: the vectors pass, the largest and smallest tokens among them.
+    for (const char* name : {"r1", "checksigverify", "checksigadd", "codesep", "k1_odd", "k64"}) {
+        CHECK_ERR(Verify(vectors.Get(name), 0, ACTIVE), SCRIPT_ERR_OK);
+    }
+    // The smallest rescue input, |K| = 1 at m = 1 in template R1, has a witness of 130,333 bytes: a
+    // budget of 130,383, which pays for the 50 and the rescue weight (doc/p2mr-rescue.md, section 2.5).
+    const auto& smallest{vectors.Get("k1_odd").tx.vin[0].scriptWitness.stack};
+    BOOST_CHECK_EQUAL(::GetSerializeSize(smallest), 130'333U);
+    static_assert(VALIDATION_WEIGHT_PER_P2MR_RESCUE_CHECK <= 130'333);
+    const RescueVector& r1{vectors.Get("r1")};
+    const VectorInput& in{r1.inputs[0]};
+    const valtype& annex{r1.tx.vin[0].scriptWitness.stack.back()};
+    const valtype pubkey{in.pubkey};
+    // A failing rescue check fails the whole script: OP_NOT after it does not turn it into a pass.
+    CHECK_ERR(P2MRSpend(CScript{} << pubkey << OP_CHECKSIG << OP_NOT, P2MR_LEAF_TRIPWIRED, {in.token}, annex).Verify(ACTIVE), SCRIPT_ERR_P2MR_RESCUE_PROOF);
+    // An empty signature pushes false and is no rescue check.
+    CHECK_ERR(P2MRSpend(CScript{} << pubkey << OP_CHECKSIG << OP_NOT, P2MR_LEAF_TRIPWIRED, {{}}, annex).Verify(ACTIVE | SCRIPT_VERIFY_P2MR_EC_DISABLED), SCRIPT_ERR_OK);
+    // An element more below the token: the check would pass, but tapscript needs a clean stack.
+    CMutableTransaction extra{Changed(r1, 0, [](std::vector<valtype>& stack) { stack.insert(stack.begin(), valtype{0x01}); })};
+    CHECK_ERR(Verify(extra, r1.spent_outputs, 0, ACTIVE, vectors.regtest), SCRIPT_ERR_CLEANSTACK);
+    // In a check after OP_CHECKSIGVERIFY of another key, the proof is for the leaf of r1.
+    CHECK_ERR(P2MRSpend(CScript{} << pubkey << OP_CHECKSIGVERIFY << OP_1, P2MR_LEAF_TRIPWIRED, {in.token}, annex).Verify(ACTIVE), SCRIPT_ERR_P2MR_RESCUE_PROOF);
+    // A 33-byte key is an upgradable key type: no rescue, and passes as before.
+    CHECK_ERR(P2MRSpend(CScript{} << valtype(33, 0x02) << OP_CHECKSIG, P2MR_LEAF_TRIPWIRED, {in.token}, annex).Verify(ACTIVE), SCRIPT_ERR_OK);
+    // At depth zero nothing executes: the spend passes, with the token and the annex.
+    CHECK_ERR(P2MRSpend(CScript{} << pubkey << OP_CHECKSIG, P2MR_LEAF_TRIPWIRED, {in.token}, annex, /*depth_zero=*/true).Verify(ACTIVE), SCRIPT_ERR_OK);
+    // Leaf version 0xc0: the token is a signature.
+    CHECK_ERR(P2MRSpend(CScript{} << pubkey << OP_CHECKSIG, TAPROOT_LEAF_TAPSCRIPT, {in.token}, annex).Verify(ACTIVE), SCRIPT_ERR_SCHNORR_SIG_SIZE);
+    CHECK_ERR(P2MRSpend(CScript{} << pubkey << OP_CHECKSIG, TAPROOT_LEAF_TAPSCRIPT, {in.token}, annex).Verify(ACTIVE | SCRIPT_VERIFY_P2MR_EC_DISABLED), SCRIPT_ERR_SCHNORR_SIG_SIZE);
+    // P2TR: a script path spend with leaf version 0xc0 and the token as a signature.
+    {
+        const CScript leaf{CScript{} << pubkey << OP_CHECKSIG};
+        const XOnlyPubKey internal{XOnlyPubKey::NUMS_H};
+        const uint256 leaf_hash{ComputeTapleafHash(TAPROOT_LEAF_TAPSCRIPT, leaf)};
+        const auto tweaked{internal.CreateTapTweak(&leaf_hash)};
+        BOOST_REQUIRE(tweaked);
+        CMutableTransaction tx;
+        tx.version = 2;
+        tx.vin.emplace_back(COutPoint{Txid::FromUint256(uint256{9}), 0});
+        tx.vout.emplace_back(90'000, CScript{} << OP_TRUE);
+        valtype control{static_cast<unsigned char>(TAPROOT_LEAF_TAPSCRIPT | (tweaked->second ? 1 : 0))};
+        control.insert(control.end(), internal.begin(), internal.end());
+        tx.vin[0].scriptWitness.stack = {in.token, valtype{leaf.begin(), leaf.end()}, control};
+        const std::vector<CTxOut> spent{CTxOut{100'000, CScript{} << OP_1 << ToByteVector(tweaked->first)}};
+        CHECK_ERR(Verify(tx, spent, 0, ACTIVE | SCRIPT_VERIFY_P2MR_EC_DISABLED, vectors.regtest), SCRIPT_ERR_SCHNORR_SIG_SIZE);
+    }
+
+    // An element that a node with the tripwire rules takes as a valid Schnorr signature is never a
+    // token: 64 bytes starting 03 01 1c, followed by 28 printable bytes, a suffix and 32 bytes, which
+    // would be a token of |K| = 28. Through the test hook that accepts every Schnorr signature, it
+    // passes with the lane open and closed, while elliptic curve checks work.
+    valtype lookalike{0x03, 0x01, 0x1c};
+    lookalike.insert(lookalike.end(), 28, 'k');
+    lookalike.push_back(0x00);
+    lookalike.insert(lookalike.end(), 32, 0x22);
+    BOOST_REQUIRE_EQUAL(lookalike.size(), 64U);
+    BOOST_CHECK(!IsP2MRRescueToken(lookalike));
+    for (const bool with_hash_type : {false, true}) {
+        valtype sig{lookalike};
+        if (with_hash_type) {
+            // 65 bytes: |K| = 29 with SIGHASH_ALL as the last byte.
+            sig[2] = 0x1d;
+            sig.insert(sig.begin() + 31, 'k');
+            sig.back() = SIGHASH_ALL;
+            sig.resize(65);
+            BOOST_CHECK(!IsP2MRRescueToken(sig));
+        }
+        const P2MRSpend spend{CScript{} << pubkey << OP_CHECKSIG, P2MR_LEAF_TRIPWIRED, {sig}, std::nullopt};
+        for (const script_verify_flags flags : {ACTIVE, ACTIVE | SCRIPT_VERIFY_P2MR_NO_RESCUE}) {
+            const CTransaction tx{spend.tx};
+            PrecomputedTransactionData txdata;
+            txdata.Init(tx, std::vector<CTxOut>{spend.spent});
+            txdata.m_p2mr_rescue_network_id = vectors.regtest;
+            const AcceptingSchnorrChecker checker{&spend.tx, 0, spend.spent[0].nValue, txdata, MissingDataBehavior::ASSERT_FAIL};
+            ScriptError err;
+            BOOST_CHECK(VerifyScript(CScript{}, spend.spent[0].scriptPubKey, &spend.tx.vin[0].scriptWitness, flags, checker, &err));
+            BOOST_CHECK_EQUAL(err, SCRIPT_ERR_OK);
+            // And with EC disabled, M3's error, whether the lane is open or not.
+            BOOST_CHECK(!VerifyScript(CScript{}, spend.spent[0].scriptPubKey, &spend.tx.vin[0].scriptWitness, flags | SCRIPT_VERIFY_P2MR_EC_DISABLED, checker, &err));
+            BOOST_CHECK_EQUAL(err, SCRIPT_ERR_P2MR_EC_DISABLED);
+        }
+    }
+}
