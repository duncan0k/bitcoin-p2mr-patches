+const std::string ARK0_CHALLENGE{"5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae"};
+constexpr uint32_t NO_CODESEPARATOR{0xffffffff};
+//! secp256k1's group order n.
+const valtype ORDER{ParseHex("fffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141")};
+
+//! The flags of a block with P2MR, OP_CHECKMLDSA44, leaf version 0xe0 and OP_CHECKSLHDSA128S
+//! active, and the rescue lane open (no SCRIPT_VERIFY_P2MR_NO_RESCUE).
+constexpr script_verify_flags ACTIVE{SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_TAPROOT | SCRIPT_VERIFY_P2MR |
+                                     SCRIPT_VERIFY_P2MR_MLDSA44 | SCRIPT_VERIFY_P2MR_TRIPWIRE | SCRIPT_VERIFY_P2MR_SLHDSA128S};
+//! The flags that make a script execute that meets an upgrade hook without them: they stay set in
+//! the monotonicity checks (doc/p2mr-rescue.md, as the fuzz target script_flags does).
+constexpr script_verify_flags UPGRADE_HOOKS{SCRIPT_VERIFY_P2MR | SCRIPT_VERIFY_P2MR_MLDSA44 | SCRIPT_VERIFY_P2MR_TRIPWIRE | SCRIPT_VERIFY_P2MR_SLHDSA128S};
+
+valtype Hex(const UniValue& field)
+{
+    const auto bytes{TryParseHex<unsigned char>(field.get_str())};
+    BOOST_REQUIRE_MESSAGE(bytes.has_value(), "not hex: " << field.get_str().substr(0, 40));
+    return *bytes;
+}
+
+uint256 Hash256(const UniValue& field)
+{
+    const valtype bytes{Hex(field)};
+    BOOST_REQUIRE_EQUAL(bytes.size(), 32U);
+    return uint256{std::span<const unsigned char, 32>{bytes}};
+}
+
+struct VectorInput {
+    uint32_t index;
+    CScript leaf_script;
+    uint32_t codesep_pos;
+    valtype k;
+    uint8_t suffix;
+    valtype y;
+    valtype pubkey;
+    bool negated;
+    valtype token;
+    uint256 sighash;
+    valtype m;
+};
+
+struct RescueVector {
+    std::string name;
+    CMutableTransaction tx;
+    std::vector<CTxOut> spent_outputs;
+    std::vector<VectorInput> inputs;
+};
+
+struct RescueVectors {
+    uint256 regtest;
+    uint256 ark0;
+    std::vector<std::pair<valtype, uint256>> custom_signets;
+    std::vector<RescueVector> vectors;
+
+    const RescueVector& Get(const std::string& name) const
+    {
+        const auto it{std::ranges::find(vectors, name, &RescueVector::name)};
+        BOOST_REQUIRE(it != vectors.end());
+        return *it;
+    }
+};
+
+const RescueVectors& LoadVectors()
+{
+    static const RescueVectors vectors{[] {
+        RescueVectors out;
+        UniValue root;
+        // One object, not the array read_json expects.
+        BOOST_REQUIRE(root.read(json_tests::p2mr_rescue_vectors) && root.isObject());
+        const UniValue& ids{root.find_value("network_ids")};
+        out.regtest = Hash256(ids.find_value("regtest"));
+        out.ark0 = Hash256(ids.find_value("ark0"));
+        for (const UniValue& c : ids.find_value("custom_signets").getValues()) {
+            out.custom_signets.emplace_back(Hex(c.find_value("challenge")), Hash256(c.find_value("network_id")));
+        }
+        for (const UniValue& v : root.find_value("vectors").getValues()) {
+            RescueVector vec;
+            vec.name = v.find_value("name").get_str();
+            DataStream ds{Hex(v.find_value("tx"))};
+            ds >> TX_WITH_WITNESS(vec.tx);
+            for (const UniValue& o : v.find_value("spent_outputs").getValues()) {
+                const valtype spk{Hex(o.find_value("script_pubkey"))};
+                vec.spent_outputs.emplace_back(o.find_value("amount").getInt<int64_t>(), CScript{spk.begin(), spk.end()});
+            }
+            for (const UniValue& i : v.find_value("inputs").getValues()) {
+                const valtype leaf{Hex(i.find_value("leaf_script"))};
+                vec.inputs.push_back(VectorInput{
+                    .index = i.find_value("index").getInt<uint32_t>(),
+                    .leaf_script = CScript{leaf.begin(), leaf.end()},
+                    .codesep_pos = i.find_value("codesep_pos").getInt<uint32_t>(),
+                    .k = Hex(i.find_value("k")),
+                    .suffix = i.find_value("suffix").getInt<uint8_t>(),
+                    .y = Hex(i.find_value("y")),
+                    .pubkey = Hex(i.find_value("pubkey")),
+                    .negated = i.find_value("negated").get_bool(),
+                    .token = Hex(i.find_value("token")),
+                    .sighash = Hash256(i.find_value("sighash")),
+                    .m = Hex(i.find_value("m")),
+                });
+            }
+            out.vectors.push_back(std::move(vec));
+        }
+        return out;
+    }()};
+    return vectors;
+}
+
+/** Verify input `index` of `tx` as a block would: the full prevouts in the transaction data, the
+ *  network id given (regtest's by default, none for nullopt), and through a signature cache when one
+ *  is given. */
+ScriptError Verify(const CMutableTransaction& mtx, const std::vector<CTxOut>& spent, uint32_t index, script_verify_flags flags,
+                   std::optional<uint256> network_id, SignatureCache* cache = nullptr, bool store = true)
+{
+    const CTransaction tx{mtx};
+    PrecomputedTransactionData txdata;
+    txdata.Init(tx, std::vector<CTxOut>{spent});
+    txdata.m_p2mr_rescue_network_id = network_id;
+    ScriptError err{SCRIPT_ERR_UNKNOWN_ERROR};
+    bool ok;
+    if (cache) {
+        const CachingTransactionSignatureChecker checker{&tx, index, spent[index].nValue, store, *cache, txdata};
+        ok = VerifyScript(tx.vin[index].scriptSig, spent[index].scriptPubKey, &tx.vin[index].scriptWitness, flags, checker, &err);
+    } else {
+        const TransactionSignatureChecker checker{&tx, index, spent[index].nValue, txdata, MissingDataBehavior::ASSERT_FAIL};
+        ok = VerifyScript(tx.vin[index].scriptSig, spent[index].scriptPubKey, &tx.vin[index].scriptWitness, flags, checker, &err);
+    }
+    BOOST_CHECK_EQUAL(ok, err == SCRIPT_ERR_OK);
+    return err;
+}
+
+ScriptError Verify(const RescueVector& v, uint32_t index, script_verify_flags flags)
+{
+    return Verify(v.tx, v.spent_outputs, index, flags, LoadVectors().regtest);
+}
+
+#define CHECK_ERR(expr, expected)                                                            \
+    do {                                                                                     \
+        const ScriptError err_{expr};                                                        \
+        BOOST_CHECK_MESSAGE(err_ == (expected), #expr ": " << ScriptErrorString(err_)        \
+                                                           << ", expected " << ScriptErrorString(expected)); \
+    } while (0)
+
+/** The vector with the witness of input `index` changed by `change`. */
+template <typename F>
+CMutableTransaction Changed(const RescueVector& v, uint32_t index, F change)
+{
+    CMutableTransaction tx{v.tx};
+    change(tx.vin[index].scriptWitness.stack);
+    return tx;
+}
+
+/** A token for K, suffix and y, as the vectors build them. */
+valtype Token(std::span<const unsigned char> k, uint8_t suffix, std::span<const unsigned char> y, uint8_t sid = P2MR_RESCUE_STATEMENT_HMAC)
+{
+    valtype token{P2MR_RESCUE_KEY_VERSION, sid, static_cast<unsigned char>(k.size())};
+    token.insert(token.end(), k.begin(), k.end());
+    token.push_back(suffix);
+    token.insert(token.end(), y.begin(), y.end());
+    return token;
+}
+
+/** n - y, the other secret of the same x-only key. */
+valtype Negate(const valtype& y)
+{
+    valtype out(32);
+    int borrow{0};
+    for (int i = 31; i >= 0; --i) {
+        int d{ORDER[i] - y[i] - borrow};
+        borrow = d < 0;
+        out[i] = static_cast<unsigned char>(d + (borrow ? 256 : 0));
+    }
+    return out;
+}
+
+/** A spend of a P2MR output of two leaves at depth one, `leaf` of `leaf_version` and OP_RETURN, with
+ *  the witness elements `stack` below the leaf script and the control block, and `annex` on top. */
+struct P2MRSpend {
+    CMutableTransaction tx;
+    std::vector<CTxOut> spent;
+
+    P2MRSpend(const CScript& leaf, uint8_t leaf_version, std::vector<valtype> stack, std::optional<valtype> annex, bool depth_zero = false)
+    {
+        const uint256 leaf_hash{ComputeTapleafHash(leaf_version, leaf)};
+        valtype control{static_cast<unsigned char>(leaf_version | 1)};
+        uint256 root{leaf_hash};
+        if (!depth_zero) {
+            const uint256 fail_hash{ComputeTapleafHash(leaf_version, CScript{} << OP_RETURN)};
+            control.insert(control.end(), fail_hash.begin(), fail_hash.end());
+            root = ComputeTapbranchHash(leaf_hash, fail_hash);
+        }
+        tx.version = 2;
+        tx.vin.emplace_back(COutPoint{Txid::FromUint256(uint256{7}), 0});
+        tx.vout.emplace_back(90'000, CScript{} << OP_TRUE);
+        spent.emplace_back(100'000, CScript{} << OP_2 << ToByteVector(root));
+        stack.emplace_back(leaf.begin(), leaf.end());
+        stack.push_back(control);
+        if (annex) stack.push_back(*annex);
+        tx.vin[0].scriptWitness.stack = std::move(stack);
+    }
+
+    ScriptError Verify(script_verify_flags flags) const { return ::Verify(tx, spent, 0, flags, LoadVectors().regtest); }
+};
+
+/** A checker whose Schnorr verification accepts every signature: the test hook for an element that
+ *  a node with the tripwire rules takes as a valid Schnorr signature. */
+class AcceptingSchnorrChecker : public MutableTransactionSignatureChecker
+{
+public:
+    using MutableTransactionSignatureChecker::MutableTransactionSignatureChecker;
+
+protected:
+    bool VerifySchnorrSignature(std::span<const unsigned char>, const XOnlyPubKey&, const uint256&) const override { return true; }
+};
+
+std::unique_ptr<const CChainParams> MakeParams(ChainType chain, const std::vector<std::pair<std::string, std::string>>& settings)
+{
+    ArgsManager args;
+    for (const auto& [name, value] : settings) args.ForceSetArg(name, value);
+    return CreateChainParams(args, chain);
+}
+
+void Fails(ChainType chain, const std::vector<std::pair<std::string, std::string>>& settings, const std::string& message)
+{
+    BOOST_CHECK_EXCEPTION(MakeParams(chain, settings), std::runtime_error, HasReason{message});
+}
+
+/** Force several values of one option, as several -name=value on a command line do. */
+void SetMulti(ArgsManager& args, const std::string& name, const std::vector<std::string>& values)
+{
+    UniValue list{UniValue::VARR};
+    for (const std::string& value : values) list.push_back(value);
+    args.LockSettings([&](common::Settings& settings) { settings.forced_settings[name.substr(1)] = list; });
+}
