+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Generate src/test/data/p2mr_rescue_vectors.json, the rescue spends p2mr_rescue_tests checks.
+
+Each vector is a transaction with every witness in place and the outputs it spends, made here once:
+the rescue signature messages come from test_framework/p2mr_rescue.py, an implementation of its
+own, and the proofs from the crate's command-line prover, voleith-prove (feature `cli`), which the
+build compiles for the tests only. The proofs are randomized, so a second run gives other bytes; the
+file is generated once and committed. p2mr_rescue_tests checks SignatureHashP2MRRescue against the
+messages recorded here, then verifies the spends with the node's verifier and derives every failure
+case from them.
+
+    test/util/generate_p2mr_rescue_vectors.py --prover <path to voleith-prove> [--write]
+
+Without --write it prints the file; with it, it rewrites the file in the source tree. The prover is
+under the build directory, in src/rescue/cargo-target-tools/<target>/release/.
+"""
+import argparse
+import hashlib
+import json
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "functional"))
+
+from test_framework.key import compute_xonly_pubkey  # noqa: E402
+from test_framework.messages import COutPoint, CTransaction, CTxIn, CTxInWitness, CTxOut  # noqa: E402
+from test_framework.p2mr import p2mr_construct  # noqa: E402
+from test_framework.p2mr_rescue import (  # noqa: E402
+    P2MR_LEAF_TRIPWIRED,
+    RESCUE_STATEMENT_HMAC,
+    WALLET_V1_SCHNORR_K,
+    network_id_regtest,
+    network_id_signet,
+    prove,
+    rescue_annex,
+    rescue_key,
+    rescue_message,
+    rescue_pub,
+    rescue_sighash,
+    rescue_token,
+    rescue_y,
+)
+from test_framework.script import (  # noqa: E402
+    CScript,
+    OP_0,
+    OP_1,
+    OP_2DROP,
+    OP_CHECKSIG,
+    OP_CHECKSIGADD,
+    OP_CHECKSIGVERIFY,
+    OP_CODESEPARATOR,
+    OP_NUMEQUAL,
+    OP_TRUE,
+)
+
+DATA = os.path.join(HERE, "..", "..", "src", "test", "data")
+NO_CODESEPARATOR = 0xffffffff
+# The Ark-0 signet's challenge, and two other custom signet challenges, for the network ids.
+ARK0_CHALLENGE = bytes.fromhex("5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae")
+CUSTOM_CHALLENGES = [bytes.fromhex("51"), bytes.fromhex("5121" + "02" + "11" * 32 + "51ae")]
+# The number of 520-byte elements the two-check leaf drops (two per OP_2DROP): enough budget for a
+# second rescue check, so that R3 rather than R2 stops it.
+PAD_ELEMENTS = 140
+
+
+def h(label):
+    return hashlib.sha256(label.encode()).digest()
+
+
+def find_seed(label, k, suffix, odd):
+    """The first seed of a label whose y*G has an odd Y or not, as asked, found by counting."""
+    for i in range(1000):
+        x = h(f"p2mr_rescue vector seed {label} {i}")
+        y = rescue_y(k, x, suffix)
+        if compute_xonly_pubkey(y)[1] == odd:
+            return x
+    raise AssertionError
+
+
+class Input:
+    def __init__(self, name, k, suffix, odd, leaf_script_fn, leaf_witness_fn, codesep_pos=NO_CODESEPARATOR):
+        self.k = k
+        self.suffix = suffix
+        self.x = find_seed(name, k, suffix, odd)
+        self.y = rescue_y(k, self.x, suffix)
+        self.pubkey, self.negated = compute_xonly_pubkey(self.y)
+        assert self.pubkey == rescue_key(self.y)
+        self.leaf_script = leaf_script_fn(self.pubkey)
+        self.leaf_witness_fn = leaf_witness_fn
+        self.codesep_pos = codesep_pos
+        # m = 1: the rescue leaf next to a leaf that is never used.
+        self.p2mr = p2mr_construct([("rescue", self.leaf_script, P2MR_LEAF_TRIPWIRED), ("other", CScript([OP_TRUE]))])
+        self.token = rescue_token(k, suffix, self.y)
+
+
+def r1(p):
+    return CScript([p, OP_CHECKSIG])
+
+
+def build(name, inputs, prover, network_id):
+    tx = CTransaction()
+    tx.version = 2
+    tx.nLockTime = 0
+    spent = []
+    for i, inp in enumerate(inputs):
+        tx.vin.append(CTxIn(COutPoint(int.from_bytes(h(f"p2mr_rescue vector {name} prevout {i}"), "little"), i), nSequence=0xfffffffd))
+        spent.append(CTxOut(100_000 + i, inp.p2mr.scriptPubKey))
+    tx.vout.append(CTxOut(99_000, CScript([OP_1, h(f"p2mr_rescue vector {name} output")])))
+    rows = []
+    for i, inp in enumerate(inputs):
+        pub = rescue_pub(inp.k, inp.suffix, inp.y)
+        sighash = rescue_sighash(tx, i, spent, inp.leaf_script, network_id, RESCUE_STATEMENT_HMAC, pub, codesep_pos=inp.codesep_pos)
+        m = rescue_message(sighash, network_id, inp.pubkey)
+        y, proof = prove(prover, inp.k, inp.suffix, inp.x, m)
+        assert y == inp.y
+        leaf = inp.p2mr.leaves["rescue"]
+        wit = CTxInWitness()
+        wit.scriptWitness.stack = inp.leaf_witness_fn(inp.token) + [bytes(inp.leaf_script), leaf.control_block, rescue_annex(proof)]
+        rows.append({
+            "index": i,
+            "leaf_script": bytes(inp.leaf_script).hex(),
+            "codesep_pos": inp.codesep_pos,
+            "k": inp.k.hex(),
+            "suffix": inp.suffix,
+            "y": inp.y.hex(),
+            "pubkey": inp.pubkey.hex(),
+            "negated": inp.negated,
+            "token": inp.token.hex(),
+            "sighash": sighash.hex(),
+            "m": m.hex(),
+        })
+        tx.wit.vtxinwit.append(wit)
+    return {
+        "name": name,
+        "tx": tx.serialize_with_witness().hex(),
+        "spent_outputs": [{"amount": o.nValue, "script_pubkey": bytes(o.scriptPubKey).hex()} for o in spent],
+        "inputs": rows,
+    }
+
+
+def vectors(prover):
+    nid = network_id_regtest()
+    k = WALLET_V1_SCHNORR_K
+    two_checks = lambda p: CScript([OP_2DROP] * (PAD_ELEMENTS // 2) + [p, OP_CHECKSIGVERIFY, p, OP_CHECKSIG])  # noqa: E731
+    cases = [
+        # R1, the relayed template, K of the web wallet v1, y*G with even Y.
+        ("r1", [Input("r1", k, 0, False, r1, lambda t: [t])]),
+        # Two inputs of one key's statement in one transaction, for swapping proofs.
+        ("two_inputs", [Input("two_inputs a", k, 0, False, r1, lambda t: [t]), Input("two_inputs b", k, 1, True, r1, lambda t: [t])]),
+        # |K| = 1: the smallest rescue input and its budget; y*G with odd Y (x-only key of -y*G).
+        ("k1_odd", [Input("k1_odd", b"A", 7, True, r1, lambda t: [t])]),
+        # |K| = 64 and suffix 255: the largest token, 100 bytes.
+        ("k64", [Input("k64", bytes(range(0x20, 0x60)), 255, False, r1, lambda t: [t])]),
+        # OP_CHECKSIGVERIFY, then OP_1.
+        ("checksigverify", [Input("checksigverify", k, 0, False, lambda p: CScript([p, OP_CHECKSIGVERIFY, OP_1]), lambda t: [t])]),
+        # OP_CHECKSIGADD adds 1.
+        ("checksigadd", [Input("checksigadd", k, 0, False, lambda p: CScript([OP_0, p, OP_CHECKSIGADD, OP_1, OP_NUMEQUAL]), lambda t: [t])]),
+        # After OP_CODESEPARATOR, at opcode position 0.
+        ("codesep", [Input("codesep", k, 0, False, lambda p: CScript([OP_CODESEPARATOR, p, OP_CHECKSIG]), lambda t: [t], codesep_pos=0)]),
+        # Two checks of one key in one input: the second is a second rescue check (R3), given the
+        # budget of 140 elements of 520 bytes that the leaf drops first.
+        ("two_checks", [Input("two_checks", k, 0, False, two_checks, lambda t: [t, t] + [b"\x00" * 520] * PAD_ELEMENTS)]),
+    ]
+    out = {
+        "comment": "Generated by test/util/generate_p2mr_rescue_vectors.py; see doc/p2mr-rescue.md.",
+        "network_ids": {
+            "regtest": network_id_regtest().hex(),
+            "ark0": network_id_signet(ARK0_CHALLENGE).hex(),
+            "custom_signets": [{"challenge": c.hex(), "network_id": network_id_signet(c).hex()} for c in CUSTOM_CHALLENGES],
+        },
+        "vectors": [build(name, inputs, prover, nid) for name, inputs in cases],
+    }
+    return out
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument("--prover", required=True, help="path to voleith-prove")
+    parser.add_argument("--write", action="store_true", help="rewrite the file in the source tree")
+    args = parser.parse_args()
+    text = json.dumps(vectors(args.prover), indent=1) + "\n"
+    if args.write:
+        with open(os.path.join(DATA, "p2mr_rescue_vectors.json"), "w", encoding="utf-8") as f:
+            f.write(text)
+    else:
+        sys.stdout.write(text)
+
+
+if __name__ == "__main__":
+    main()
