+#!/usr/bin/env python3
+# Copyright (c) 2026-present The Bitcoin Core developers
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Helpers for spends through the P2MR rescue lane (doc/p2mr-rescue.md).
+
+In an executed P2MR leaf of version 0xe0, an elliptic curve check whose
+signature element is a rescue token is checked with a VOLE-in-the-head proof
+in the input's annex (ark0-rescue SPEC.md v0.2, statement 0x01):
+
+    token = 0x03 || sid || pub,  pub = u8(|K|) || K || u8(suffix) || y
+    annex = 0x50 || 0x01 || proof
+    m     = rescue_sighash || network_id || pk_commitment      (96 bytes)
+
+where y = HMAC-SHA256(K, x || suffix) is the secret key of the spent x-only
+key P = x(y*G). This module computes the rescue signature message on its own,
+independently of the C++ code, and proves with the crate's own command-line
+prover, voleith-prove, which the build compiles for the tests only (feature
+`cli`, src/rescue/CMakeLists.txt).
+"""
+
+import glob
+import hashlib
+import hmac
+import os
+import subprocess
+import tempfile
+
+from .key import TaggedHash, compute_xonly_pubkey
+from .messages import ser_string
+from .p2mr import P2MR_LEAF_MASK
+
+P2MR_LEAF_TRIPWIRED = 0xe0
+RESCUE_KEY_VERSION = 0x03
+RESCUE_STATEMENT_HMAC = 0x01
+RESCUE_ANNEX_TYPE = 0x01
+RESCUE_S1_PROOF_SIZE = 130218
+RESCUE_S1_ANNEX_SIZE = 2 + RESCUE_S1_PROOF_SIZE
+# The provisional VALIDATION_WEIGHT_PER_P2MR_RESCUE_CHECK of src/script/script.h.
+VALIDATION_WEIGHT_PER_P2MR_RESCUE_CHECK = 100000
+# The K of the Ark-0 web wallet v1 Schnorr keys.
+WALLET_V1_SCHNORR_K = b"ark0-wallet v1 schnorr"
+# secp256k1's group order.
+SECP256K1_ORDER = 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFEBAAEDCE6AF48A03BBFD25E8CD0364141
+
+
+def sha256(data):
+    return hashlib.sha256(data).digest()
+
+
+def network_id_regtest():
+    return sha256(b"regtest")
+
+
+def network_id_signet(challenge):
+    return sha256(bytes(challenge))
+
+
+def rescue_y(k, x, suffix):
+    """y = HMAC-SHA256(K, x || suffix), the statement 0x01 relation."""
+    assert 1 <= len(k) <= 64 and len(x) == 32 and 0 <= suffix <= 255
+    return hmac.new(k, x + bytes([suffix]), hashlib.sha256).digest()
+
+
+def rescue_key(y):
+    """The x-only key P = x(y*G) that y is the secret of, either parity."""
+    return compute_xonly_pubkey(y)[0]
+
+
+def rescue_pub(k, suffix, y):
+    """The canonical public inputs of SPEC.md section 7.5."""
+    return bytes([len(k)]) + bytes(k) + bytes([suffix]) + bytes(y)
+
+
+def rescue_token(k, suffix, y, sid=RESCUE_STATEMENT_HMAC):
+    return bytes([RESCUE_KEY_VERSION, sid]) + rescue_pub(k, suffix, y)
+
+
+def rescue_annex(proof):
+    return bytes([0x50, RESCUE_ANNEX_TYPE]) + bytes(proof)
+
+
+def pk_commitment(pubkey):
+    return TaggedHash("P2MR/Rescue/Key", b"\x00" + bytes(pubkey))
+
+
+def rescue_sighash(tx, input_index, spent_utxos, leaf_script, network_id, sid, pub,
+                   leaf_ver=P2MR_LEAF_TRIPWIRED, codesep_pos=0xffffffff):
+    """The rescue signature message (doc/p2mr-rescue.md): the BIP 342 SIGHASH_DEFAULT
+    fields without sha_annex, key_version 0x03, then the network id, the statement id
+    and SHA256(pub), under the tag P2MR/Rescue/Sighash."""
+    assert len(spent_utxos) == len(tx.vin)
+    sha_prevouts = sha256(b"".join(i.prevout.serialize() for i in tx.vin))
+    sha_amounts = sha256(b"".join(u.nValue.to_bytes(8, "little", signed=True) for u in spent_utxos))
+    sha_scriptpubkeys = sha256(b"".join(ser_string(bytes(u.scriptPubKey)) for u in spent_utxos))
+    sha_sequences = sha256(b"".join(i.nSequence.to_bytes(4, "little") for i in tx.vin))
+    sha_outputs = sha256(b"".join(o.serialize() for o in tx.vout))
+    leaf_hash = TaggedHash("TapLeaf", bytes([leaf_ver & P2MR_LEAF_MASK]) + ser_string(bytes(leaf_script)))
+    msg = bytes([0x00, 0x00])
+    msg += tx.version.to_bytes(4, "little")
+    msg += tx.nLockTime.to_bytes(4, "little")
+    msg += sha_prevouts + sha_amounts + sha_scriptpubkeys + sha_sequences + sha_outputs
+    msg += bytes([0x03])
+    msg += input_index.to_bytes(4, "little")
+    msg += leaf_hash + bytes([RESCUE_KEY_VERSION]) + codesep_pos.to_bytes(4, "little")
+    msg += bytes(network_id) + bytes([sid]) + sha256(bytes(pub))
+    return TaggedHash("P2MR/Rescue/Sighash", msg)
+
+
+def rescue_message(sighash, network_id, pubkey):
+    m = bytes(sighash) + bytes(network_id) + pk_commitment(pubkey)
+    assert len(m) == 96
+    return m
+
+
+def find_prover(config=None):
+    """The test-only voleith-prove of the build, or $VOLEITH_PROVE."""
+    if os.environ.get("VOLEITH_PROVE"):
+        return os.environ["VOLEITH_PROVE"]
+    builddir = config["environment"]["BUILDDIR"] if config else os.environ["BUILDDIR"]
+    exeext = config["environment"].get("EXEEXT", "") if config else ""
+    found = glob.glob(os.path.join(builddir, "src", "rescue", "cargo-target-tools", "*", "release", "voleith-prove" + exeext))
+    assert len(found) == 1, f"voleith-prove not found under {builddir} (build with -DBUILD_TESTS=ON)"
+    return found[0]
+
+
+def prove(prover, k, suffix, x, m):
+    """Prove statement 0x01 for the seed x over the message m with voleith-prove; returns
+    (y, proof). The seed goes in on standard input, as the tool requires."""
+    with tempfile.TemporaryDirectory() as tmp:
+        out = os.path.join(tmp, "proof.bin")
+        res = subprocess.run([prover, "--k", k.decode("ascii"), "--suffix", str(suffix), "--msg-hex", m.hex(), "--out", out],
+                             input=(x.hex() + "\n").encode(), capture_output=True, check=False)
+        assert res.returncode == 0, f"voleith-prove failed: {res.stderr.decode()}"
+        line = res.stdout.decode().strip()
+        assert line.startswith("y="), line
+        with open(out, "rb") as f:
+            proof = f.read()
+    y = bytes.fromhex(line[2:])
+    assert y == rescue_y(k, x, suffix)
+    assert len(proof) == RESCUE_S1_PROOF_SIZE
+    return y, proof
