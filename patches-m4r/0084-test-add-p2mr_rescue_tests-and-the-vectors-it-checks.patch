+                BOOST_CHECK_EQUAL(Verify(v.tx, v.spent_outputs, vin.index, flags, vectors.regtest, &cache), plain);
+            }
+        }
+    }
+}
+
+// SCRIPT_VERIFY_P2MR_NO_RESCUE only restricts: as tx_valid does, but with every prevout in the
+// transaction data (doc/p2mr-rescue.md, section 6 item 8), a valid rescue spend stays valid when any
+// restricting flag is taken away, one at a time and in random sets; the upgrade hooks stay set.
+BOOST_AUTO_TEST_CASE(flag_monotonicity)
+{
+    const RescueVectors& vectors{LoadVectors()};
+    const script_verify_flags all{STANDARD_SCRIPT_VERIFY_FLAGS | SCRIPT_VERIFY_P2MR_EC_DISABLED};
+    std::vector<script_verify_flags> restricting;
+    for (int bit = 0; bit < static_cast<int>(script_verify_flag_name::SCRIPT_VERIFY_END_MARKER); ++bit) {
+        const script_verify_flags flag{script_verify_flags::from_int(script_verify_flags::value_type{1} << bit)};
+        if ((all & flag) && !(UPGRADE_HOOKS & flag)) restricting.push_back(flag);
+    }
+    BOOST_CHECK(restricting.size() > 15);
+    // The combinations VerifyScript accepts, as tx_valid trims them: CLEANSTACK needs WITNESS, which
+    // needs P2SH.
+    auto Trim = [](script_verify_flags flags) {
+        if (!(flags & SCRIPT_VERIFY_P2SH)) flags &= ~SCRIPT_VERIFY_WITNESS;
+        if (!(flags & SCRIPT_VERIFY_WITNESS)) flags &= ~SCRIPT_VERIFY_CLEANSTACK;
+        return flags;
+    };
+    FastRandomContext rng{/*fDeterministic=*/true};
+    for (const RescueVector& v : vectors.vectors) {
+        if (v.name == "two_checks") continue;
+        for (const VectorInput& in : v.inputs) {
+            CHECK_ERR(Verify(v, in.index, all), SCRIPT_ERR_OK);
+            for (const script_verify_flags flag : restricting) CHECK_ERR(Verify(v, in.index, Trim(all & ~flag)), SCRIPT_ERR_OK);
+            for (int i = 0; i < 20; ++i) {
+                script_verify_flags flags{all};
+                for (const script_verify_flags flag : restricting) {
+                    if (rng.randbool()) flags &= ~flag;
+                }
+                flags = Trim(flags);
+                CHECK_ERR(Verify(v, in.index, flags), SCRIPT_ERR_OK);
+                // Adding NO_RESCUE restricts: the spend fails in every combination that checks witnesses.
+                if (flags & SCRIPT_VERIFY_WITNESS) BOOST_CHECK(Verify(v, in.index, flags | SCRIPT_VERIFY_P2MR_NO_RESCUE) != SCRIPT_ERR_OK);
+            }
+        }
+    }
+    // A Schnorr-free leaf of version 0xe0 that passes with NO_RESCUE passes without it.
+    const P2MRSpend plain{CScript{} << OP_TRUE, P2MR_LEAF_TRIPWIRED, {}, std::nullopt};
+    CHECK_ERR(plain.Verify(ACTIVE | SCRIPT_VERIFY_P2MR_NO_RESCUE | SCRIPT_VERIFY_P2MR_EC_DISABLED), SCRIPT_ERR_OK);
+    CHECK_ERR(plain.Verify(ACTIVE | SCRIPT_VERIFY_P2MR_EC_DISABLED), SCRIPT_ERR_OK);
+}
+
+// Relay policy (doc/p2mr-rescue.md, section 6 item 2): the template R1 only, its token exempt from
+// the 80-byte limit and its annex allowed.
+BOOST_AUTO_TEST_CASE(template_policy)
+{
+    const RescueVectors& vectors{LoadVectors()};
+    auto standard = [](const CMutableTransaction& mtx, const std::vector<CTxOut>& spent) {
+        CCoinsView empty;
+        CCoinsViewCache view{&empty};
+        for (size_t i = 0; i < mtx.vin.size(); ++i) view.AddCoin(mtx.vin[i].prevout, Coin{spent[i], 1, false}, false);
+        return IsWitnessStandard(CTransaction{mtx}, view);
+    };
+    for (const char* name : {"r1", "two_inputs", "k1_odd", "k64"}) {
+        const RescueVector& v{vectors.Get(name)};
+        BOOST_CHECK_MESSAGE(standard(v.tx, v.spent_outputs), name);
+        BOOST_CHECK(HasP2MRRescueRecord(CTransaction{v.tx}));
+    }
+    // The 100-byte token of |K| = 64 is above 80 bytes.
+    BOOST_CHECK_EQUAL(vectors.Get("k64").tx.vin[0].scriptWitness.stack[0].size(), 100U);
+    for (const char* name : {"checksigverify", "checksigadd", "codesep", "two_checks"}) {
+        const RescueVector& v{vectors.Get(name)};
+        BOOST_CHECK_MESSAGE(!standard(v.tx, v.spent_outputs), name);
+        CHECK_ERR(Verify(v, 0, ACTIVE), std::string{name} == "two_checks" ? SCRIPT_ERR_P2MR_RESCUE_REPEAT : SCRIPT_ERR_OK);
+    }
+    const RescueVector& r1{vectors.Get("r1")};
+    const VectorInput& in{r1.inputs[0]};
+    // An element more, an annex of another kind, a token that is not one, at depth zero, leaf 0xc0.
+    BOOST_CHECK(!standard(Changed(r1, 0, [](std::vector<valtype>& stack) { stack.insert(stack.begin(), valtype{0x01}); }), r1.spent_outputs));
+    BOOST_CHECK(!standard(Changed(r1, 0, [](std::vector<valtype>& stack) { stack.back()[1] = 0x02; }), r1.spent_outputs));
+    BOOST_CHECK(!standard(Changed(r1, 0, [](std::vector<valtype>& stack) { stack.back().pop_back(); }), r1.spent_outputs));
+    BOOST_CHECK(!standard(Changed(r1, 0, [](std::vector<valtype>& stack) { stack[0][0] = 0x04; }), r1.spent_outputs));
+    BOOST_CHECK(standard(Changed(r1, 0, [](std::vector<valtype>& stack) { stack.pop_back(); }), r1.spent_outputs));
+    const valtype& annex{r1.tx.vin[0].scriptWitness.stack.back()};
+    for (const auto& spend : {P2MRSpend{CScript{} << in.pubkey << OP_CHECKSIG, P2MR_LEAF_TRIPWIRED, {in.token}, annex, /*depth_zero=*/true},
+                              P2MRSpend{CScript{} << in.pubkey << OP_CHECKSIG, TAPROOT_LEAF_TAPSCRIPT, {in.token}, annex},
+                              P2MRSpend{CScript{} << OP_PUSHDATA1 << in.pubkey << OP_CHECKSIG, P2MR_LEAF_TRIPWIRED, {in.token}, annex}}) {
+        BOOST_CHECK(!standard(spend.tx, spend.spent));
+    }
+    // Other annexes stay non-standard.
+    BOOST_CHECK(!standard(P2MRSpend{CScript{} << OP_TRUE, P2MR_LEAF_TRIPWIRED, {}, valtype{0x50, 0x00}}.tx,
+                          P2MRSpend{CScript{} << OP_TRUE, P2MR_LEAF_TRIPWIRED, {}, valtype{0x50, 0x00}}.spent));
+}
+
+// The rescue vectors of p2mr-ts, the TypeScript P2MR library, made independently of this code base
+// (src/test/data/p2mr_ts_rescue_vectors.md has their origin and SHA-256): the network ids, the five
+// single hashes, the signature message's preimage and digest per input and network, the key
+// commitment and m agree byte for byte, and the spend, proved over regtest's m, verifies.
+BOOST_AUTO_TEST_CASE(p2mr_ts_vectors)
+{
+    UniValue root;
+    BOOST_REQUIRE(root.read(json_tests::p2mr_ts_rescue) && root.isObject());
+    const UniValue& constants{root.find_value("constants")};
+    BOOST_CHECK_EQUAL(constants.find_value("tokenFirstByte").getInt<int>(), P2MR_RESCUE_KEY_VERSION);
+    BOOST_CHECK_EQUAL(constants.find_value("statementId").getInt<int>(), P2MR_RESCUE_STATEMENT_HMAC);
+    BOOST_CHECK_EQUAL(constants.find_value("proofSize").getInt<size_t>(), *P2MRRescueProofSize(P2MR_RESCUE_STATEMENT_HMAC));
+    BOOST_CHECK_EQUAL(constants.find_value("validationWeightPerRescueCheck").getInt<int64_t>(), VALIDATION_WEIGHT_PER_P2MR_RESCUE_CHECK);
+
+    // The networks: a custom signet by its challenge, and regtest, through the chain parameters.
+    std::map<std::string, uint256> network_ids;
+    for (const UniValue& n : root.find_value("networks").getValues()) {
+        const std::string name{n.find_value("name").get_str()};
+        const uint256 id{Hash256(n.find_value("networkId"))};
+        if (name == "signet") {
+            CChainParams::SigNetOptions options;
+            options.challenge = Hex(n.find_value("challenge"));
+            BOOST_CHECK(*CChainParams::SigNet(options)->GetConsensus().p2mr_rescue_network_id == id);
+            BOOST_CHECK(P2MRRescueNetworkId(*options.challenge) == id);
+        } else {
+            BOOST_REQUIRE_EQUAL(name, "regtest");
+            BOOST_CHECK(*CChainParams::RegTest({})->GetConsensus().p2mr_rescue_network_id == id);
+        }
+        network_ids.emplace(name, id);
+    }
+    BOOST_REQUIRE_EQUAL(network_ids.size(), 2U);
+
+    // The transaction, with the witnesses of the vector, and the outputs it spends.
+    const UniValue& vec{root.find_value("transaction")};
+    const UniValue& given{vec.find_value("given")};
+    const UniValue& mid{vec.find_value("intermediate")};
+    CMutableTransaction mtx;
+    {
+        DataStream ds{Hex(vec.find_value("unsignedTx"))};
+        ds >> TX_NO_WITNESS(mtx);
+        BOOST_CHECK(ds.empty());
+    }
+    const UniValue& inputs{vec.find_value("inputs")};
+    BOOST_REQUIRE_EQUAL(inputs.size(), mtx.vin.size());
+    BOOST_REQUIRE_EQUAL(inputs.size(), 2U);
+    const valtype spent_spk{Hex(mid.find_value("spentScriptPubKey"))};
+    std::vector<CTxOut> spent;
+    for (size_t i = 0; i < inputs.size(); ++i) {
+        const UniValue& in{inputs[i]};
+        BOOST_CHECK_EQUAL(in.find_value("inputIndex").getInt<size_t>(), i);
+        BOOST_CHECK(mtx.vin[i].prevout.hash.ToUint256() == Hash256(in.find_value("outpoint").find_value("txid")));
+        BOOST_CHECK_EQUAL(mtx.vin[i].prevout.n, in.find_value("outpoint").find_value("vout").getInt<uint32_t>());
+        for (const UniValue& w : in.find_value("witness").getValues()) mtx.vin[i].scriptWitness.stack.push_back(Hex(w));
+        spent.emplace_back(given.find_value("amount").getInt<int64_t>(), CScript{spent_spk.begin(), spent_spk.end()});
+    }
+    const CTransaction tx{mtx};
+    BOOST_CHECK(tx.GetHash().ToUint256() == Hash256(vec.find_value("txid")));
+    BOOST_CHECK(tx.GetWitnessHash().ToUint256() == Hash256(vec.find_value("wtxid")));
+    BOOST_CHECK_EQUAL(GetTransactionWeight(tx), vec.find_value("size").find_value("weight").getInt<int64_t>());
+
+    // The leaf, the key and the token.
+    const valtype leaf{Hex(mid.find_value("leafScript"))};
+    const valtype pubkey{Hex(mid.find_value("publicKey"))};
+    BOOST_REQUIRE_EQUAL(pubkey.size(), 32U);
+    BOOST_CHECK(CScript(leaf.begin(), leaf.end()) == (CScript{} << pubkey << OP_CHECKSIG));
+    const uint256 leaf_hash{ComputeTapleafHash(P2MR_LEAF_TRIPWIRED, CScript(leaf.begin(), leaf.end()))};
+    BOOST_CHECK(leaf_hash == Hash256(mid.find_value("leafHash")));
+    const valtype token_bytes{Hex(mid.find_value("token"))};
+    BOOST_CHECK(token_bytes == tx.vin[0].scriptWitness.stack[0] && token_bytes == tx.vin[1].scriptWitness.stack[0]);
+    const auto token{ParseP2MRRescueToken(token_bytes)};
+    BOOST_REQUIRE(token);
+    BOOST_CHECK_EQUAL(token->sid, P2MR_RESCUE_STATEMENT_HMAC);
+    BOOST_CHECK(valtype(token->pub.begin(), token->pub.end()) == Hex(mid.find_value("pub")));
+    uint256 pub_hash;
+    CSHA256().Write(token->pub.data(), token->pub.size()).Finalize(pub_hash.begin());
+    BOOST_CHECK(pub_hash == Hash256(mid.find_value("pubSha256")));
+    BOOST_CHECK(CheckP2MRRescueKey(token->y, pubkey));
+    const uint256 commitment{P2MRRescueKeyCommitment(std::span<const unsigned char, 32>{pubkey})};
+    BOOST_CHECK(commitment == Hash256(mid.find_value("pkCommitment")));
+
+    // The five single hashes of BIP 341.
+    PrecomputedTransactionData txdata;
+    txdata.Init(tx, std::vector<CTxOut>{spent});
+    const UniValue& single{mid.find_value("singleHashes")};
+    BOOST_CHECK(txdata.m_prevouts_single_hash == Hash256(single.find_value("shaPrevouts")));
+    BOOST_CHECK(txdata.m_spent_amounts_single_hash == Hash256(single.find_value("shaAmounts")));
+    BOOST_CHECK(txdata.m_spent_scripts_single_hash == Hash256(single.find_value("shaScriptPubKeys")));
+    BOOST_CHECK(txdata.m_sequences_single_hash == Hash256(single.find_value("shaSequences")));
+    BOOST_CHECK(txdata.m_outputs_single_hash == Hash256(single.find_value("shaOutputs")));
+
+    // Per input and network: the preimage is the serialization of the fields and hashes above, its
+    // tagged hash is SignatureHashP2MRRescue's, and m = sighash || network id || key commitment.
+    size_t count{0};
+    for (size_t i = 0; i < inputs.size(); ++i) {
+        for (const auto& [name, id] : network_ids) {
+            const UniValue& n{inputs[i].find_value("networks").find_value(name)};
+            BOOST_CHECK(Hash256(n.find_value("networkId")) == id);
+            DataStream expected{};
+            expected << uint8_t{0x00} << uint8_t{SIGHASH_DEFAULT} << tx.version << tx.nLockTime
+                     << txdata.m_prevouts_single_hash << txdata.m_spent_amounts_single_hash << txdata.m_spent_scripts_single_hash
+                     << txdata.m_sequences_single_hash << txdata.m_outputs_single_hash
+                     << uint8_t{0x03} << static_cast<uint32_t>(i) << leaf_hash << P2MR_RESCUE_KEY_VERSION << NO_CODESEPARATOR
+                     << id << token->sid << pub_hash;
+            const valtype preimage{Hex(n.find_value("preimage"))};
+            BOOST_CHECK_MESSAGE(valtype(UCharCast(expected.data()), UCharCast(expected.data() + expected.size())) == preimage,
+                                "preimage, input " << i << ", " << name);
+            BOOST_CHECK_EQUAL(preimage.size(), 277U);
+
+            ScriptExecutionData execdata;
+            execdata.m_annex_init = execdata.m_annex_present = true;
+            execdata.m_tapleaf_hash_init = true;
+            execdata.m_tapleaf_hash = leaf_hash;
+            execdata.m_codeseparator_pos_init = true;
+            execdata.m_codeseparator_pos = NO_CODESEPARATOR;
+            uint256 hash;
+            BOOST_REQUIRE(SignatureHashP2MRRescue(hash, execdata, tx, i, txdata, MissingDataBehavior::FAIL, id, token->sid, token->pub));
+            const uint256 sighash{Hash256(n.find_value("sighash"))};
+            BOOST_CHECK_MESSAGE(hash == sighash, "sighash, input " << i << ", " << name << ": " << HexStr(hash) << " != " << HexStr(sighash));
+            BOOST_CHECK((HashWriter{TaggedHash("P2MR/Rescue/Sighash")} << std::span{preimage}).GetSHA256() == sighash);
+            valtype m{hash.begin(), hash.end()};
+            m.insert(m.end(), id.begin(), id.end());
+            m.insert(m.end(), commitment.begin(), commitment.end());
+            BOOST_CHECK_MESSAGE(m == Hex(n.find_value("m")), "m, input " << i << ", " << name);
+            ++count;
+        }
+        // The proof in the annex.
+        const UniValue& proof{inputs[i].find_value("proof")};
+        BOOST_CHECK_EQUAL(proof.find_value("network").get_str(), "regtest");
+        const valtype& annex{tx.vin[i].scriptWitness.stack.back()};
+        BOOST_REQUIRE(IsP2MRRescueAnnex(annex, token->sid));
+        uint256 proof_hash;
+        CSHA256().Write(annex.data() + 2, annex.size() - 2).Finalize(proof_hash.begin());
+        BOOST_CHECK(proof_hash == Hash256(proof.find_value("sha256")));
+    }
+    BOOST_CHECK_EQUAL(count, 4U);
+
+    // The spend verifies at the rescue flags on regtest, in both inputs; it fails with
+    // SCRIPT_VERIFY_P2MR_NO_RESCUE, where the token is a signature of no BIP 340 size, and on the
+    // signet, whose m the proofs are not over.
+    for (uint32_t i = 0; i < tx.vin.size(); ++i) {
+        CHECK_ERR(Verify(mtx, spent, i, ACTIVE, network_ids.at("regtest")), SCRIPT_ERR_OK);
+        CHECK_ERR(Verify(mtx, spent, i, ACTIVE | SCRIPT_VERIFY_P2MR_EC_DISABLED, network_ids.at("regtest")), SCRIPT_ERR_OK);
+        CHECK_ERR(Verify(mtx, spent, i, STANDARD_SCRIPT_VERIFY_FLAGS | SCRIPT_VERIFY_P2MR_EC_DISABLED, network_ids.at("regtest")), SCRIPT_ERR_OK);
+        CHECK_ERR(Verify(mtx, spent, i, ACTIVE | SCRIPT_VERIFY_P2MR_NO_RESCUE, network_ids.at("regtest")), SCRIPT_ERR_SCHNORR_SIG_SIZE);
+        CHECK_ERR(Verify(mtx, spent, i, ACTIVE | SCRIPT_VERIFY_P2MR_EC_DISABLED | SCRIPT_VERIFY_P2MR_NO_RESCUE, network_ids.at("regtest")),
+                  SCRIPT_ERR_P2MR_EC_DISABLED);
+        CHECK_ERR(Verify(mtx, spent, i, ACTIVE, network_ids.at("signet")), SCRIPT_ERR_P2MR_RESCUE_PROOF);
+    }
+}
+
+BOOST_AUTO_TEST_SUITE_END()
