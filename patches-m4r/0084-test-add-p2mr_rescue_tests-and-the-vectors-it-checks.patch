+BOOST_FIXTURE_TEST_SUITE(p2mr_rescue_tests, BasicTestingSetup)
+
+// H4R is not decided: the lane stays closed on Ark-0, as OP_CHECKSLHDSA128S did before its height
+// was fixed, and every block there is checked with SCRIPT_VERIFY_P2MR_NO_RESCUE. The default signet,
+// the testnets and mainnet never open it.
+BOOST_AUTO_TEST_CASE(ark0_lane_closed)
+{
+    static_assert(ARK0_RESCUE_HEIGHT == NEVER);
+    static_assert(ARK0_RESCUE_HEIGHT > ARK0_TRIPWIRE_HEIGHT);
+    CChainParams::SigNetOptions options;
+    options.challenge = ParseHex(ARK0_CHALLENGE);
+    const auto ark0{CChainParams::SigNet(options)};
+    const Consensus::Params& consensus{ark0->GetConsensus()};
+    BOOST_CHECK_EQUAL(consensus.P2MRRescueHeight, NEVER);
+    BOOST_CHECK(!DeploymentEnabled(consensus, Consensus::DEPLOYMENT_P2MR_RESCUE));
+    // Ark-0's network id is the SHA256 of its challenge.
+    BOOST_CHECK(*consensus.p2mr_rescue_network_id == LoadVectors().ark0);
+
+    kernel::Notifications notifications{};
+    const ChainstateManager::Options chainman_opts{
+        .chainparams = *ark0,
+        .datadir = m_args.GetDataDirNet(),
+        .notifications = notifications,
+    };
+    const node::BlockManager::Options blockman_opts{
+        .chainparams = *ark0,
+        .blocks_dir = m_args.GetBlocksDirPath(),
+        .notifications = notifications,
+        .block_tree_db_params = DBParams{
+            .path = m_args.GetDataDirNet() / "blocks" / "index",
+            .cache_bytes = 1 << 20,
+            .memory_only = true,
+        },
+    };
+    ChainstateManager chainman{m_interrupt, chainman_opts, blockman_opts};
+    BOOST_CHECK(*chainman.m_validation_cache.m_p2mr_rescue_network_id == LoadVectors().ark0);
+    const uint256 hash{1};
+    CBlockIndex block;
+    block.phashBlock = &hash;
+    for (const int height : {ARK0_TRIPWIRE_HEIGHT, ARK0_SLHDSA128S_HEIGHT, 70'000, 1'000'000}) {
+        block.nHeight = height;
+        BOOST_CHECK(GetBlockScriptFlags(block, chainman) & SCRIPT_VERIFY_P2MR_NO_RESCUE);
+    }
+
+    for (const auto& params : {CChainParams::Main(), CChainParams::TestNet(), CChainParams::TestNet4(), CChainParams::SigNet({})}) {
+        BOOST_CHECK_EQUAL(params->GetConsensus().P2MRRescueHeight, NEVER);
+    }
+    BOOST_CHECK(!CChainParams::Main()->GetConsensus().p2mr_rescue_network_id);
+}
+
+// The parameters of regtest and of another custom signet (doc/p2mr-rescue.md).
+BOOST_AUTO_TEST_CASE(parameters)
+{
