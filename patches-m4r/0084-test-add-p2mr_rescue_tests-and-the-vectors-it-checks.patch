+    CHECK_ERR(Verify(Changed(r1, 0, [](std::vector<valtype>& stack) { stack.back()[1] = 0x02; }), r1.spent_outputs, 0, ACTIVE, vectors.regtest, &cache), SCRIPT_ERR_P2MR_RESCUE_ANNEX);
