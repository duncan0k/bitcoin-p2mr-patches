+// SignatureHashP2MRRescue against the messages of the functional test framework
+// (test/util/generate_p2mr_rescue_vectors.py), and what it commits to.
+BOOST_AUTO_TEST_CASE(signature_message)
+{
+    const RescueVectors& vectors{LoadVectors()};
+    auto message = [](const CMutableTransaction& tx, const std::vector<CTxOut>& spent, uint32_t index, const CScript& leaf,
+                      uint32_t codesep_pos, const uint256& network_id, const valtype& token) {
+        PrecomputedTransactionData txdata;
+        txdata.Init(tx, std::vector<CTxOut>{spent});
+        ScriptExecutionData execdata;
+        execdata.m_annex_init = true;
+        execdata.m_annex_present = true;
+        execdata.m_tapleaf_hash_init = true;
+        execdata.m_tapleaf_hash = ComputeTapleafHash(P2MR_LEAF_TRIPWIRED, leaf);
+        execdata.m_codeseparator_pos_init = true;
+        execdata.m_codeseparator_pos = codesep_pos;
+        const auto parsed{ParseP2MRRescueToken(token)};
+        BOOST_REQUIRE(parsed);
+        uint256 hash;
+        BOOST_REQUIRE(SignatureHashP2MRRescue(hash, execdata, tx, index, txdata, MissingDataBehavior::FAIL, network_id, parsed->sid, parsed->pub));
+        return hash;
+    };
+    size_t count{0};
+    for (const RescueVector& v : vectors.vectors) {
+        for (const VectorInput& in : v.inputs) {
+            const uint256 hash{message(v.tx, v.spent_outputs, in.index, in.leaf_script, in.codesep_pos, vectors.regtest, in.token)};
+            BOOST_CHECK_MESSAGE(hash == in.sighash, v.name << " input " << in.index);
+            // m = sighash || network id || TaggedHash("P2MR/Rescue/Key", 0x00 || P).
+            valtype m{hash.begin(), hash.end()};
+            m.insert(m.end(), vectors.regtest.begin(), vectors.regtest.end());
+            const uint256 commitment{P2MRRescueKeyCommitment(std::span<const unsigned char, 32>{in.pubkey})};
+            m.insert(m.end(), commitment.begin(), commitment.end());
+            BOOST_CHECK(m == in.m);
+            ++count;
+        }
+    }
+    BOOST_CHECK_EQUAL(count, 9U);
+
+    // Every committed field changes the message.
+    const RescueVector& v{vectors.Get("two_inputs")};
+    const VectorInput& in{v.inputs[0]};
+    const uint256 base{message(v.tx, v.spent_outputs, 0, in.leaf_script, in.codesep_pos, vectors.regtest, in.token)};
+    std::vector<uint256> changed;
+    auto with_tx = [&](auto change) {
+        CMutableTransaction tx{v.tx};
+        change(tx);
+        changed.push_back(message(tx, v.spent_outputs, 0, in.leaf_script, in.codesep_pos, vectors.regtest, in.token));
+    };
+    auto with_spent = [&](auto change) {
+        std::vector<CTxOut> spent{v.spent_outputs};
+        change(spent);
+        changed.push_back(message(v.tx, spent, 0, in.leaf_script, in.codesep_pos, vectors.regtest, in.token));
+    };
+    with_tx([](CMutableTransaction& tx) { tx.version = 3; });
+    with_tx([](CMutableTransaction& tx) { tx.nLockTime = 1; });
+    with_tx([](CMutableTransaction& tx) { tx.vin[1].prevout.n ^= 1; });
+    with_tx([](CMutableTransaction& tx) { tx.vin[1].nSequence ^= 1; });
+    with_tx([](CMutableTransaction& tx) { tx.vout[0].nValue -= 1; });
+    with_tx([](CMutableTransaction& tx) { tx.vout.emplace_back(0, CScript{} << OP_RETURN); });
+    with_spent([](std::vector<CTxOut>& spent) { spent[1].nValue += 1; });
+    with_spent([](std::vector<CTxOut>& spent) { spent[1].scriptPubKey = CScript{} << OP_TRUE; });
+    // The input's position, the leaf, the code separator, the network, the token.
+    changed.push_back(message(v.tx, v.spent_outputs, 1, in.leaf_script, in.codesep_pos, vectors.regtest, in.token));
+    changed.push_back(message(v.tx, v.spent_outputs, 0, CScript{} << OP_TRUE, in.codesep_pos, vectors.regtest, in.token));
+    changed.push_back(message(v.tx, v.spent_outputs, 0, in.leaf_script, 0, vectors.regtest, in.token));
+    changed.push_back(message(v.tx, v.spent_outputs, 0, in.leaf_script, in.codesep_pos, vectors.ark0, in.token));
+    changed.push_back(message(v.tx, v.spent_outputs, 0, in.leaf_script, in.codesep_pos, vectors.custom_signets[0].second, in.token));
+    valtype other_token{in.token};
+    other_token.back() ^= 1;
+    changed.push_back(message(v.tx, v.spent_outputs, 0, in.leaf_script, in.codesep_pos, vectors.regtest, other_token));
+    for (const uint256& hash : changed) BOOST_CHECK(hash != base);
+    std::sort(changed.begin(), changed.end());
+    BOOST_CHECK(std::adjacent_find(changed.begin(), changed.end()) == changed.end());
+
+    // Not the annex, which holds the proof, nor any other witness: a changed proof leaves the message
+    // as it was (and fails R7 rather than R6).
+    CMutableTransaction tx{v.tx};
+    tx.vin[0].scriptWitness.stack.back()[1000] ^= 1;
+    tx.vin[1].scriptWitness.stack.back()[1000] ^= 1;
+    BOOST_CHECK(message(tx, v.spent_outputs, 0, in.leaf_script, in.codesep_pos, vectors.regtest, in.token) == base);
+
+    // Without the BIP 341 data, no message, after MissingDataBehavior.
+    PrecomputedTransactionData empty;
+    ScriptExecutionData execdata;
+    execdata.m_annex_init = execdata.m_annex_present = execdata.m_tapleaf_hash_init = execdata.m_codeseparator_pos_init = true;
+    const auto parsed{ParseP2MRRescueToken(in.token)};
+    uint256 hash;
+    BOOST_CHECK(!SignatureHashP2MRRescue(hash, execdata, v.tx, 0, empty, MissingDataBehavior::FAIL, vectors.regtest, parsed->sid, parsed->pub));
+}
