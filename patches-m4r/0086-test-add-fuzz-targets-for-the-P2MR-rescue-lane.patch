+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Write seed inputs for the fuzz target p2mr_rescue_script_flags from the rescue vectors.
+
+Each seed is what the target reads: a transaction with its witnesses, the flags to verify with and
+the flags to take away or add (little-endian uint64 each), then every spent output. The vectors are
+valid rescue spends with every prevout (src/test/data/p2mr_rescue_vectors.json); each is written with
+the flags of a block where the rescue lane is open, and again below it (SCRIPT_VERIFY_P2MR_NO_RESCUE),
+so that the target starts from a pass and from a failure.
+
+    test/util/p2mr_rescue_fuzz_seeds.py <output directory>
+
+Then, for example: FUZZ=p2mr_rescue_script_flags build_fuzz/bin/fuzz <output directory>
+"""
+import json
+import os
+import struct
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.join(HERE, "..", "functional"))
+
+from test_framework.messages import CTxOut  # noqa: E402
+from test_framework.script import CScript  # noqa: E402
+
+# Bit positions of script_verify_flag_name (src/script/interpreter.h).
+FLAG_BITS = {
+    "P2SH": 0, "DERSIG": 2, "NULLDUMMY": 4, "CHECKLOCKTIMEVERIFY": 9, "CHECKSEQUENCEVERIFY": 10, "WITNESS": 11,
+    "TAPROOT": 17, "P2MR": 21, "P2MR_MLDSA44": 22, "P2MR_TRIPWIRE": 23, "P2MR_EC_DISABLED": 24,
+    "P2MR_SLHDSA128S": 25, "P2MR_NO_RESCUE": 26,
+}
+
+
+def flags(*names):
+    return sum(1 << FLAG_BITS[n] for n in names)
+
+
+def main():
+    out = sys.argv[1]
+    os.makedirs(out, exist_ok=True)
+    with open(os.path.join(HERE, "..", "..", "src", "test", "data", "p2mr_rescue_vectors.json"), encoding="utf-8") as f:
+        vectors = json.load(f)["vectors"]
+    block = flags("P2SH", "DERSIG", "NULLDUMMY", "CHECKLOCKTIMEVERIFY", "CHECKSEQUENCEVERIFY", "WITNESS", "TAPROOT",
