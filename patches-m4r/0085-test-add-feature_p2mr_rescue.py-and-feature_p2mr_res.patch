+"""Test the P2MR rescue lane (doc/p2mr-rescue.md) on regtest.
+
+From the rescue lane's height H4R, in an executed P2MR leaf of version 0xe0, an elliptic curve
+signature check whose signature element is a rescue token is checked with the VOLE-in-the-head proof
+in the input's annex. The proofs are made as the test runs, by the crate's own prover (voleith-prove,
+feature `cli`), which the build compiles for the tests only.
+
+Heights: the tripwire rules from H3 = 220 with one tripwire output T, the rescue lane from H4R = 240
+(-testactivationheight=p2mr_rescue@240).
+
+  node 0  the rules, the default policy; no permissions on its P2P port, noban on a second one
+  node 1  the rules, -acceptnonstdtxn=1 and -maxsigcachesize=0
+  node 2  an M4-S node (the build without M4-R, from $M4S_BITCOIND), or, without it, this build with
+          the lane never open, which is the same to every block; it upgrades late
+  node 3  the rules, pruned
+
+Covered (doc/p2mr-rescue.md, section 10): the activation boundary in blocks (H4R - 1 refused, H4R
+through generateblock) and in the mempool (refused at tip H4R - 1 without the BUG! line, taken at tip
+H4R, in sendrawtransaction, testmempoolaccept and packages); the policy check on the state of
+elliptic curve checks, before the trigger, and after a reorganization over it, when the spends in the
+mempool stay and a block template works while those from disconnected blocks are refused; removal
+below H4R with elliptic curve checks disabled and enabled; one, two, three inputs standard, four not
+but valid in a block; spends outside template R1 valid but not relayed, -acceptnonstdtxn; other
+annexes; the hard fork: the M4-S node refuses the first rescue block, stops and does not fork, and
+after its upgrade and reconsiderblock catches up; the P2P gate with and without wtxid relay, repeated
+sends, orphans, and the -whitelist directions; the logs and gettripwireinfo, the log only for
+template R1 and of constant cost per input (many tokens and key-sized pushes); restarts, -reindex,
+-reindex-chainstate, VerifyDB level 4, pruning, and a signature cache of size 0.
+"""
+
+from decimal import Decimal
+import hashlib
+import os
+import time
+
+from test_framework.messages import (
+    COIN,
+    COutPoint,
+    CTransaction,
+    CTxIn,
+    CTxInWitness,
+    CTxOut,
+    CInv,
+    MSG_TX,
+    MSG_WTX,
+    msg_inv,
+    msg_tx,
+)
+from test_framework.p2mr import p2mr_construct
+from test_framework.p2mr_rescue import (
+    P2MR_LEAF_TRIPWIRED,
+    RESCUE_STATEMENT_HMAC,
+    WALLET_V1_SCHNORR_K,
+    find_prover,
+    network_id_regtest,
+    prove,
+    rescue_annex,
+    rescue_key,
+    rescue_message,
+    rescue_pub,
+    rescue_sighash,
+    rescue_token,
+    rescue_y,
+)
+from test_framework.p2p import P2PInterface, p2p_lock
+from test_framework.script import CScript, OP_0, OP_1, OP_CHECKSIG, OP_CHECKSIGVERIFY, OP_DROP, OP_ENDIF, OP_IF, OP_RETURN, OP_TRUE
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, assert_raises_rpc_error, p2p_port
+from test_framework.wallet import MiniWallet
+
+H3 = 220
+H4R = 240
+NEVER = 2147483646
+FUND_SATS = 1_000_000
+FEE_SATS = 60_000
+EC_DISABLED_ERROR = "Elliptic curve signature checks are disabled in this leaf"
+SCHNORR_SIZE_ERROR = "Invalid Schnorr signature size"
+EC_ENABLED = "p2mr-rescue-ec-enabled"
+NONSTANDARD = "bad-witness-nonstandard"
+# Review round 1, item 1: tokens on the stack (below the 1,000-element limit) and 32-byte pushes of
+# the leaf script, which a search of every pair would try against each other.
+BOMB_TOKENS = 998
+BOMB_PUSHES = 50_000
+
+
+def seed(tag):
+    return hashlib.sha256(b"feature_p2mr_rescue " + tag.encode()).digest()
+
+
+class RescueKey:
+    """A web wallet v1 style key: y = HMAC-SHA256(K, x || suffix), P = x(y*G), and P2MR outputs whose
+    leaf of version 0xe0 checks P."""
+
+    def __init__(self, tag, *, k=WALLET_V1_SCHNORR_K, suffix=0):
+        self.k = k
+        self.suffix = suffix
+        self.x = seed(tag)
+        self.y = rescue_y(k, self.x, suffix)
+        self.pubkey = rescue_key(self.y)
+        self.token = rescue_token(k, suffix, self.y)
+        self.pub = rescue_pub(k, suffix, self.y)
+        # R1 at depth one, next to a leaf that is never used.
+        self.r1 = p2mr_construct([("rescue", CScript([self.pubkey, OP_CHECKSIG]), P2MR_LEAF_TRIPWIRED), ("fail", CScript([OP_RETURN]))])
+        # Valid, but not the relayed template.
+        self.verify = p2mr_construct([("rescue", CScript([self.pubkey, OP_CHECKSIGVERIFY, OP_1]), P2MR_LEAF_TRIPWIRED), ("fail", CScript([OP_RETURN]))])
+
+
+class P2MRRescueTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 4
+        self.rpc_timeout = 240
+        self.m4s_binary = os.environ.get("M4S_BITCOIND")
+        self.extra_args = [[], ["-acceptnonstdtxn=1", "-maxsigcachesize=0"], [], ["-fastprune", "-prune=1"]]
+
+    def setup_network(self):
+        self.add_nodes(self.num_nodes, self.extra_args)
+        self.start_nodes()
+        for i in (1, 2, 3):
+            self.connect_nodes(0, i)
+        self.sync_all()
+
+    def skip_test_if_missing_module(self):
+        pass
+
+    # ------------------------------------------------------------------
+    # Helpers
+    # ------------------------------------------------------------------
+
+    def rules_args(self, i):
+        """The options of node i once the tripwire output exists."""
+        tripwire = [f"-signettripwire={H3}@{self.tripwire_outpoint}"]
+        if i == 2:
+            # The late node: an M4-S build knows nothing of the lane; this build is told it never opens.
+            return tripwire + ([] if self.m4s_binary else [f"-testactivationheight=p2mr_rescue@{NEVER}"])
+        args = tripwire + [f"-testactivationheight=p2mr_rescue@{H4R}"]
+        if i == 0:
+            args.append(f"-whitebind=noban@127.0.0.1:{self.noban_port}")
+        return args + self.extra_args[i]
+
+    def use_binary(self, node, binary):
+        n = len(node.binaries.node_argv())
+        node.args = [binary] + node.args[n:] if binary else self.default_argv[node.index] + node.args[n:]
+
+    def main_nodes(self):
+        return [self.nodes[0], self.nodes[1], self.nodes[3]]
+
+    def sync_main(self):
+        self.sync_blocks(self.main_nodes())
+
+    def mine(self, count=1):
+        return self.generate(self.nodes[0], count, sync_fun=self.sync_main)
+
+    def fund(self, script_pubkeys, amount=FUND_SATS):
+        """One confirmed output for each scriptPubKey, in one transaction."""
+        utxo = self.wallet.get_utxo(confirmed_only=True)
+        tx = CTransaction()
+        tx.vin = [CTxIn(COutPoint(int(utxo["txid"], 16), utxo["vout"]))]
+        tx.vout = [CTxOut(amount, spk) for spk in script_pubkeys]
+        change = int(utxo["value"] * COIN) - amount * len(script_pubkeys) - 10_000
+        tx.vout.append(CTxOut(change, self.wallet.get_output_script()))
+        self.wallet.sign_tx(tx)
+        self.wallet.sendrawtransaction(from_node=self.nodes[0], tx_hex=tx.serialize().hex())
+        self.mine()
+        return [{"txid": tx.txid_int, "vout": n, "value": amount, "spk": tx.vout[n].scriptPubKey} for n in range(len(script_pubkeys))]
+
+    def rescue_tx(self, inputs, *, outputs=None, network_id=None):
+        """A transaction spending (utxo, key, tree) inputs through their rescue leaf with a proof made
+        now, one output to the wallet by default."""
+        network_id = network_id or network_id_regtest()
+        tx = CTransaction()
+        tx.version = 2
+        tx.vin = [CTxIn(COutPoint(u["txid"], u["vout"]), b"", 0xfffffffd) for u, _, _ in inputs]
+        total = sum(u["value"] for u, _, _ in inputs)
+        tx.vout = outputs if outputs is not None else [CTxOut(total - FEE_SATS * len(inputs), self.wallet.get_output_script())]
+        spent = [CTxOut(u["value"], u["spk"]) for u, _, _ in inputs]
+        tx.wit.vtxinwit = [CTxInWitness() for _ in inputs]
+        for i, (_, key, tree) in enumerate(inputs):
+            leaf = tree.leaves["rescue"]
+            sighash = rescue_sighash(tx, i, spent, leaf.script, network_id, RESCUE_STATEMENT_HMAC, key.pub)
+            _, proof = prove(self.prover, key.k, key.suffix, key.x, rescue_message(sighash, network_id, key.pubkey))
+            tx.wit.vtxinwit[i].scriptWitness.stack = [key.token, bytes(leaf.script), leaf.control_block, rescue_annex(proof)]
+        return tx
+
+    def new_rescue(self, tag, count=1, *, tree="r1"):
+        """Fund `count` outputs of one new key and return the (utxo, key, tree) inputs."""
+        key = RescueKey(tag)
+        t = getattr(key, tree)
+        return [(u, key, t) for u in self.fund([t.scriptPubKey] * count)]
+
+    def parent_and_child(self, tag):
+        """A parent that funds a rescue output from the wallet, and the rescue spend of that output."""
+        key = RescueKey(tag)
+        utxo = self.wallet.get_utxo(confirmed_only=True)
+        parent = CTransaction()
+        parent.vin = [CTxIn(COutPoint(int(utxo["txid"], 16), utxo["vout"]))]
+        parent.vout = [CTxOut(FUND_SATS, key.r1.scriptPubKey), CTxOut(int(utxo["value"] * COIN) - FUND_SATS - 20_000, self.wallet.get_output_script())]
+        self.wallet.sign_tx(parent)
+        child = self.rescue_tx([({"txid": parent.txid_int, "vout": 0, "value": FUND_SATS, "spk": key.r1.scriptPubKey}, key, key.r1)])
+        return parent, child
+
+    def accept(self, tx, node=0):
+        self.nodes[node].sendrawtransaction(tx.serialize().hex(), 0)
+        assert tx.txid_hex in self.nodes[node].getrawmempool()
+
+    def reject(self, tx, reason, node=0):
+        assert_raises_rpc_error(-26, reason, self.nodes[node].sendrawtransaction, tx.serialize().hex(), 0)
+
+    def block_with(self, txs, node=0):
+        """Mine a block with exactly these transactions, through generateblock (submitted directly)."""
+        return self.nodes[node].generateblock(self.wallet.get_address(), [tx.serialize().hex() for tx in txs], called_by_framework=True)["hash"]
+
+    def refuse_block(self, txs, reason, node=0):
+        assert_raises_rpc_error(-25, reason, self.nodes[node].generateblock, self.wallet.get_address(),
+                                [tx.serialize().hex() for tx in txs], called_by_framework=True)
+
+    def rescue_info(self, node=0):
+        return self.nodes[node].gettripwireinfo()["rescue"]
+
+    def rescue_log(self, utxo, tx, block_hash, height, key):
+        return (f"P2MR rescue of {utxo['txid']:064x}:{utxo['vout']} by {tx.txid_hex} in block {block_hash} "
+                f"(height {height}): statement 01, key {key.pubkey.hex()}")
+
+    # ------------------------------------------------------------------
+    # Test body
+    # ------------------------------------------------------------------
+
+    def run_test(self):
+        self.prover = find_prover(self.config)
+        self.noban_port = p2p_port(self.num_nodes + 5)
+        self.default_argv = {node.index: node.binaries.node_argv() for node in self.nodes}
+        # The coinbases of the cached chain to the MiniWallet address are mature: no blocks are needed
+        # before the tripwire height.
+        self.wallet = MiniWallet(self.nodes[0])
+        self.wallet.rescan_utxos()
+
+        self.log.info("Create the tripwire output and restart the nodes with the rules")
+        t = self.wallet.send_self_transfer(from_node=self.nodes[0])
+        self.tripwire_utxo = t["new_utxo"]
+        self.tripwire_outpoint = f"{t['txid']}:0"
+        self.generate(self.nodes[0], 1)
+        assert self.nodes[0].getblockcount() < H3
+        self.restart_with_rules()
+
+        self.test_parameters()
+        self.fund_everything()
+        self.test_before_trigger_is_irrelevant_below_h4r()
+        self.test_activation_boundary()
+        self.test_relay_policy()
+        self.test_p2p_gate()
+        self.test_removal_below_h4r_ec_disabled()
+        self.test_parent_back_child_removed()
+        self.test_rescue_filter_alone()
+        self.test_reorganization_across_h3()
+        self.test_ec_enabled_branch()
+        self.test_late_upgrade()
+        self.test_restarts()
+        self.test_log_needs_p2mr()
+
+    def restart_with_rules(self):
+        for i, node in enumerate(self.nodes):
+            if i == 2 and self.m4s_binary:
+                self.use_binary(node, self.m4s_binary)
+            self.restart_node(i, extra_args=self.rules_args(i))
+        for i in (1, 2, 3):
+            self.connect_nodes(0, i)
+        self.sync_all()
+        self.wallet.rescan_utxos()
+
+    def test_parameters(self):
+        self.log.info("Startup log, getdeploymentinfo and gettripwireinfo")
+        node = self.nodes[0]
+        with node.assert_debug_log([f"Regtest P2MR rescue lane from height {H4R} for elliptic curve checks disabled by the tripwire "
+                                    f"(VOLEitH v0.2, statement 0x01); network id {network_id_regtest().hex()}"]):
+            self.restart_node(0, extra_args=self.rules_args(0))
+        for i in (1, 2, 3):
+            self.connect_nodes(0, i)
+        dep = node.getdeploymentinfo()["deployments"]["p2mr_rescue"]
+        assert_equal(dep["type"], "buried")
+        assert_equal(dep["height"], H4R)
+        assert_equal(dep["active"], False)
+        info = self.rescue_info()
+        assert_equal(info, {"height": H4R, "active_next_block": False, "mempool_accepts": False,
+                            "network_id": network_id_regtest().hex(), "statements": ["01"]})
+        # The late node: without the lane, an M4-S build, or this build with the lane never open.
+        if self.m4s_binary:
+            assert "p2mr_rescue" not in self.nodes[2].getdeploymentinfo()["deployments"]
+        else:
+            assert_equal(self.nodes[2].getdeploymentinfo()["deployments"]["p2mr_rescue"]["height"], NEVER)
+
+        self.log.info("Options: an explicit height below the final tripwire height is refused")
+        self.stop_node(1)
+        self.nodes[1].assert_start_raises_init_error(
+            extra_args=[f"-signettripwire={H3}@{self.tripwire_outpoint}", f"-testactivationheight=p2mr_rescue@{H3 - 1}"],
+            expected_msg=f"Error: The p2mr_rescue height must be at or above the p2mr_tripwire height {H3}, not {H3 - 1}.")
+        self.nodes[1].assert_start_raises_init_error(extra_args=["-signetrescue=300"],
+                                                     expected_msg="Error: -signetrescue can only be used with signet.")
+        self.start_node(1, extra_args=self.rules_args(1))
+        self.connect_nodes(0, 1)
+        self.sync_all()
+
+    def fund_everything(self):
+        self.log.info("Fund the rescue outputs below the tripwire height")
+        self.r_boundary = self.new_rescue("boundary", 4)
+        self.r_two = self.new_rescue("two", 2)
+        self.r_three = self.new_rescue("three", 3)
+        self.r_four = self.new_rescue("four", 4)
+        self.r_verify = self.new_rescue("verify", 2, tree="verify")
+        self.r_p2p = self.new_rescue("p2p", 6)
+        self.r_removal = self.new_rescue("removal", 3)
+        self.r_branch = self.new_rescue("branch", 6)
+        self.r_late = self.new_rescue("late", 1)
+        # An output with a leaf that executes a rescue check and drops a 0x50-tagged annex otherwise:
+        # a P2MR leaf of version 0xe0 with another annex.
+        self.other_annex = p2mr_construct([("rescue", CScript([OP_TRUE]), P2MR_LEAF_TRIPWIRED), ("fail", CScript([OP_RETURN]))])
+        self.r_other_annex = self.fund([self.other_annex.scriptPubKey])
+        # The shape of review round 1, item 1: tokens dropped, 32-byte pushes in a branch never run.
+        self.bomb = p2mr_construct([("rescue", CScript([OP_DROP] * BOMB_TOKENS + [OP_0, OP_IF] +
+                                                       [hashlib.sha256(b"bomb %d" % i).digest() for i in range(BOMB_PUSHES)] +
+                                                       [OP_ENDIF, OP_TRUE]), P2MR_LEAF_TRIPWIRED),
+                                    ("fail", CScript([OP_RETURN]))])
+        self.r_bomb = self.fund([self.bomb.scriptPubKey])
+        assert self.nodes[0].getblockcount() < H3
+
+    def test_before_trigger_is_irrelevant_below_h4r(self):
+        self.log.info("Spend the tripwire output at height 230: elliptic curve checks disabled from 231")
+        self.generate(self.nodes[0], 229 - self.nodes[0].getblockcount(), sync_fun=self.sync_main)
+        spend_t = self.wallet.create_self_transfer(utxo_to_spend=self.tripwire_utxo)["tx"]
+        self.trigger_hash = self.block_with([spend_t])
+        self.sync_main()
+        assert_equal(self.nodes[0].getblockcount(), 230)
+        assert_equal(self.nodes[0].gettripwireinfo()["ec_disabled_next_block"], True)
+
+    def test_activation_boundary(self):
+        node = self.nodes[0]
+        self.generate(node, H4R - 2 - node.getblockcount(), sync_fun=self.sync_main)
+        assert_equal(node.getblockcount(), H4R - 2)
+        (u0, key, tree), (u1, _, _), (u2, _, _), (u3, _, _) = self.r_boundary
+
+        self.log.info("H4R - 1: a rescue spend in a block is refused: the token is a signature there")
+        x0 = self.rescue_tx([(u0, key, tree)])
+        self.refuse_block([x0], EC_DISABLED_ERROR)
+        self.mine()
+        assert_equal(node.getblockcount(), H4R - 1)
+
+        self.log.info("Tip H4R - 1: the mempool refuses it, by the tip's own flags, without the BUG! line")
+        assert_equal(self.rescue_info(), {"height": H4R, "active_next_block": True, "mempool_accepts": False,
+                                          "network_id": network_id_regtest().hex(), "statements": ["01"]})
+        with node.assert_debug_log(expected_msgs=[], unexpected_msgs=["BUG! PLEASE REPORT THIS!"]):
+            self.reject(x0, EC_DISABLED_ERROR)
+            res = node.testmempoolaccept([x0.serialize().hex()])[0]
+            assert_equal(res["allowed"], False)
+            assert EC_DISABLED_ERROR in res["reject-reason"]
+            # A package of a parent and the rescue spend of its output.
+            parent, child = self.parent_and_child("package below")
+            pkg = node.submitpackage([parent.serialize().hex(), child.serialize().hex()])
+            assert EC_DISABLED_ERROR in pkg["tx-results"][child.wtxid_hex]["error"]
+            assert child.txid_hex not in node.getrawmempool()
+        self.wallet.rescan_utxos()
+
+        self.log.info("H4R: a rescue spend in a block through generateblock, which the M4-S node refuses")
+        self.first_rescue_hash = self.block_with([x0])
+        self.sync_main()
+        assert_equal(node.getblockcount(), H4R)
+        # Logged once, on the active chainstate, when the block is connected.
+        assert_equal(node.debug_log_path.read_text().count(self.rescue_log(u0, x0, self.first_rescue_hash, H4R, key)), 1)
+        self.wait_until(lambda: any(tip["hash"] == self.first_rescue_hash and tip["status"] == "invalid" for tip in self.nodes[2].getchaintips()))
+        assert_equal(self.nodes[2].getblockcount(), H4R - 1)
+
+        self.log.info("Tip H4R: the mempool takes rescue spends, through every entry; H4R + 1 confirms them")
+        assert_equal(self.rescue_info()["mempool_accepts"], True)
+        x1 = self.rescue_tx([(u1, key, tree)])
+        res = node.testmempoolaccept([x1.serialize().hex()])[0]
+        assert_equal(res["allowed"], True)
+        self.accept(x1)
+        # A package: a parent that funds a rescue output, and the rescue spend of it.
+        parent, child = self.parent_and_child("package")
+        pkg = node.submitpackage([parent.serialize().hex(), child.serialize().hex()])
+        assert_equal(pkg["package_msg"], "success")
+        assert child.txid_hex in node.getrawmempool()
+        self.wallet.rescan_utxos()
+        # The proof is bound to the network: one made for another network id is refused.
+        other = self.rescue_tx([(u2, key, tree)], network_id=hashlib.sha256(b"another network").digest())
+        self.reject(other, "Invalid rescue proof")
+        hashes = self.mine()
+        block = node.getblock(hashes[0])
+        assert x1.txid_hex in block["tx"] and child.txid_hex in block["tx"]
+        assert node.debug_log_path.read_text().count(f"by {x1.txid_hex} in block {hashes[0]} (height {H4R + 1})") == 1
+        # Not on a template, which is checked with TestBlockValidity: no log line until the block connects.
