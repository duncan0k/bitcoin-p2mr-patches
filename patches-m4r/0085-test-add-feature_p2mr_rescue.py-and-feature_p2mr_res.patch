+    def test_parent_back_child_removed(self):
+        node = self.nodes[0]
+        self.log.info("A parent put back from a disconnected block: its rescue child and that child's child")
+        parent, child = self.parent_and_child("resurrected")
+        self.accept(parent)
+        block = self.mine()[0]
+        assert parent.txid_hex in node.getblock(block)["tx"]
+        self.accept(child)
+        # The child's own child: not a rescue spend, so the filter can only remove it as a descendant.
+        # nSequence 0xfffffffd, as the rescue spends have: with nSequence 0, a reorganization that
+        # disconnects its grandparent drops such a transaction, with or without the rescue lane.
+        grandchild = self.wallet.create_self_transfer(utxo_to_spend={"txid": child.txid_hex, "vout": 0, "value": Decimal(child.vout[0].nValue) / COIN,
+                                                                     "height": 0, "coinbase": False, "confirmations": 0}, sequence=0xfffffffd)
+        self.wallet.sendrawtransaction(from_node=node, tx_hex=grandchild["hex"])
+
+        # A reorganization that keeps the lane open: the parent comes back, and the whole chain stays,
+        # with the dependency edges restored.
+        node.invalidateblock(block)
+        assert node.getblockcount() >= H4R
+        assert_equal(self.rescue_info()["mempool_accepts"], True)
+        entry = {t: node.getmempoolentry(t) for t in (parent.txid_hex, child.txid_hex, grandchild["txid"])}
+        assert_equal(entry[parent.txid_hex]["depends"], [])
+        assert_equal(entry[parent.txid_hex]["spentby"], [child.txid_hex])
+        assert_equal(entry[child.txid_hex]["depends"], [parent.txid_hex])
+        assert_equal(entry[child.txid_hex]["spentby"], [grandchild["txid"]])
+        assert_equal(entry[grandchild["txid"]]["depends"], [child.txid_hex])
+        # And in the transaction graph, not only in the inputs and the outpoint index.
+        assert_equal([entry[t]["ancestorcount"] for t in (parent.txid_hex, child.txid_hex, grandchild["txid"])], [1, 2, 3])
+        assert_equal([entry[t]["descendantcount"] for t in (parent.txid_hex, child.txid_hex, grandchild["txid"])], [3, 2, 1])
+
+        # One that closes the lane, without crossing H3: the parent stays, the rescue child goes by the
+        # filter, which runs after the parent is back, and its child goes with it as a descendant.
+        node.invalidateblock(self.first_rescue_hash)
+        assert_equal(node.getblockcount(), H4R - 1)
+        assert_equal(node.gettripwireinfo()["ec_disabled_next_block"], True)
+        mempool = set(node.getrawmempool())
+        assert parent.txid_hex in mempool
+        assert_equal(node.getmempoolentry(parent.txid_hex)["spentby"], [])
+        assert child.txid_hex not in mempool
+        assert grandchild["txid"] not in mempool
+        node.reconsiderblock(self.first_rescue_hash)
+        self.sync_main()
+        self.wallet.rescan_utxos()
