+        leaf = key.r1.leaves["rescue"]
+        tx = CTransaction()
+        tx.vin = [CTxIn(COutPoint(int(sent["txid"], 16), sent["sent_vout"]))]
+        tx.vout = [CTxOut(FUND_SATS - 10_000, wallet.get_output_script())]
+        tx.wit.vtxinwit = [CTxInWitness()]
+        # Any proof: without P2MR the output is an unknown witness version, which any witness spends.
+        tx.wit.vtxinwit[0].scriptWitness.stack = [key.token, bytes(leaf.script), leaf.control_block, rescue_annex(bytes(130_218))]
+        block = self.block_with([tx], node=3)
+        assert_equal(node.getbestblockhash(), block)
+        assert_equal(node.debug_log_path.read_text().count(f"by {tx.txid_hex}"), 0)
+
+
+if __name__ == '__main__':
+    P2MRRescueTest(__file__).main()
