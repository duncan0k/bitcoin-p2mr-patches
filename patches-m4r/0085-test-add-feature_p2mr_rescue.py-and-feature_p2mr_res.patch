+        assert_equal([p["permissions"] for p in peers if p["inbound"] and not p["addrbind"].endswith(f":{self.noban_port}")], [[]])
+        tx = self.rescue_tx(p2p[:1])
+        with node.assert_debug_log([f"dropped rescue spend {tx.txid_hex} (wtxid={tx.wtxid_hex}) from peer="]):
+            plain.send_and_ping(msg_tx(tx))
+        assert tx.txid_hex not in node.getrawmempool()
+        # Sent again by the same peer: dropped again, the peer stays connected.
+        with node.assert_debug_log([f"dropped rescue spend {tx.txid_hex}"]):
+            plain.send_and_ping(msg_tx(tx))
+        assert plain.is_connected
+        # Not in the reject filters: the same transaction from a noban peer is taken.
+        trusted.send_and_ping(msg_tx(tx))
+        assert tx.txid_hex in node.getrawmempool()
+        self.mine()
+
+        self.log.info("P2P: both txid and wtxid count as answered, so another peer is asked at once")
+        for wtxid_relay in (True, False):
+            tx = self.rescue_tx(p2p[1:2] if wtxid_relay else p2p[2:3])
+            inv_type, inv_hash = (MSG_WTX, tx.wtxid_int) if wtxid_relay else (MSG_TX, tx.txid_int)
+            now = int(time.time())
+            node.setmocktime(now)
+            a = node.add_p2p_connection(P2PInterface(wtxidrelay=wtxid_relay))
+            b = node.add_p2p_connection(P2PInterface(wtxidrelay=wtxid_relay), dstport=self.noban_port)
+            a.send_and_ping(msg_inv([CInv(inv_type, inv_hash)]))
+            node.setmocktime(now + 5)
+            a.wait_for_getdata([inv_hash])
+            b.send_and_ping(msg_inv([CInv(inv_type, inv_hash)]))
+            with p2p_lock:
+                b.last_message.pop("getdata", None)
+            a.send_and_ping(msg_tx(tx))
+            # No time passes beyond the announcement delays: b is asked because a's request is done.
+            node.setmocktime(now + 8)
+            b.wait_for_getdata([inv_hash], timeout=20)
+            b.send_and_ping(msg_tx(tx))
+            assert tx.txid_hex in node.getrawmempool()
+            a.peer_disconnect()
+            b.peer_disconnect()
+            node.setmocktime(0)
+            self.mine()
+
+        self.log.info("P2P: an orphan rescue spend from a peer without noban never reaches the orphanage")
+        key = RescueKey("orphan")
+        utxo = self.wallet.get_utxo(confirmed_only=True)
+        parent = CTransaction()
+        parent.vin = [CTxIn(COutPoint(int(utxo["txid"], 16), utxo["vout"]))]
