--- /dev/null
+++ b/test/functional/feature_p2mr_rescue_signet.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 duncan0k
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Test the P2MR rescue lane on a custom signet, with -signetrescue (doc/p2mr-rescue.md).
+
+The lane opens at the height -signetrescue gives, at or above that of -signettripwire, which it
+needs, and its proofs are bound to the signet's network id, SHA256 of the challenge: a proof made
+for regtest's id is refused there. The options are refused without a challenge, without the tripwire
+rules, below the tripwire height, on Ark-0 and on the default signet.
+"""
+
+import hashlib
+
+from test_framework.messages import COutPoint, CTransaction, CTxIn, CTxInWitness, CTxOut
+from test_framework.p2mr import p2mr_construct
+from test_framework.p2mr_rescue import (
+    P2MR_LEAF_TRIPWIRED,
+    RESCUE_STATEMENT_HMAC,
+    WALLET_V1_SCHNORR_K,
+    find_prover,
+    network_id_regtest,
+    network_id_signet,
+    prove,
+    rescue_annex,
+    rescue_key,
+    rescue_message,
+    rescue_pub,
+    rescue_sighash,
+    rescue_token,
+    rescue_y,
+)
+from test_framework.script import CScript, OP_CHECKSIG, OP_RETURN
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import assert_equal, assert_raises_rpc_error
+
+CHALLENGE = "51"
+H3 = 120
+H4R = 125
+# Signet blocks need real proof of work, about 2^22 hashes each.
+MAXTRIES = 10**9
+ARK0_CHALLENGE = "5121026fc5d8e79a9fbc8bc3dea07d82641d16717ce0b000c13c512d8e8c1788c6e5da51ae"
+# A tripwire output that never existed: elliptic curve checks in leaf version 0xe0 are disabled from H3.
+TRIPWIRE = f"{H3}@{'11' * 32}:0"
+ARGS = [f"-signetchallenge={CHALLENGE}", "-signetmldsa44=1", f"-signettripwire={TRIPWIRE}", f"-signetrescue={H4R}", "-acceptnonstdtxn=1"]
+
+
+class P2MRRescueSignetTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.chain = "signet"
+        self.num_nodes = 1
+        self.setup_clean_chain = True
+        self.extra_args = [ARGS]
+        self.rpc_timeout = 600
+
+    def run_test(self):
+        node = self.nodes[0]
+        prover = find_prover(self.config)
+        nid = network_id_signet(bytes.fromhex(CHALLENGE))
+        assert_equal(nid, hashlib.sha256(b"\x51").digest())
+
+        self.log.info("Parameters, the startup log and gettripwireinfo")
+        dep = node.getdeploymentinfo()["deployments"]["p2mr_rescue"]
+        assert_equal((dep["type"], dep["height"]), ("buried", H4R))
+        assert_equal(node.gettripwireinfo()["rescue"]["network_id"], nid.hex())
+        assert node.debug_log_path.read_text().count(
+            f"Signet P2MR rescue lane from height {H4R} for elliptic curve checks disabled by the tripwire (VOLEitH v0.2, statement 0x01); network id {nid.hex()}") == 1
+
+        # Blocks to a bare OP_TRUE output, whose first coinbase funds the rescue output.
+        hashes = []
+        for _ in range(11):
+            hashes += self.generatetodescriptor(node, 10, "raw(51)", maxtries=MAXTRIES)
+        coinbase = node.getblock(hashes[0], 2)["tx"][0]
+        x = hashlib.sha256(b"feature_p2mr_rescue_signet seed").digest()
+        y = rescue_y(WALLET_V1_SCHNORR_K, x, 0)
+        pubkey = rescue_key(y)
+        tree = p2mr_construct([("rescue", CScript([pubkey, OP_CHECKSIG]), P2MR_LEAF_TRIPWIRED), ("fail", CScript([OP_RETURN]))])
+        fund_tx = CTransaction()
+        fund_tx.vin = [CTxIn(COutPoint(int(coinbase["txid"], 16), 0))]
+        fund_tx.vout = [CTxOut(1_000_000, tree.scriptPubKey)]
+        node.sendrawtransaction(fund_tx.serialize().hex(), 0)
+        fund = {"txid": fund_tx.txid_hex, "sent_vout": 0}
+        self.generate(node, H4R - node.getblockcount(), maxtries=MAXTRIES)
+        assert_equal(node.getblockcount(), H4R)
+        assert_equal(node.gettripwireinfo()["rescue"]["mempool_accepts"], True)
+
+        def spend(network_id):
+            tx = CTransaction()
+            tx.vin = [CTxIn(COutPoint(int(fund["txid"], 16), fund["sent_vout"]))]
+            # A P2MR output, so that the transaction is not below the minimum size of policy.
+            tx.vout = [CTxOut(900_000, tree.scriptPubKey)]
+            spent = [CTxOut(1_000_000, tree.scriptPubKey)]
+            leaf = tree.leaves["rescue"]
+            pub = rescue_pub(WALLET_V1_SCHNORR_K, 0, y)
+            sighash = rescue_sighash(tx, 0, spent, leaf.script, network_id, RESCUE_STATEMENT_HMAC, pub)
+            _, proof = prove(prover, WALLET_V1_SCHNORR_K, 0, x, rescue_message(sighash, network_id, pubkey))
+            tx.wit.vtxinwit = [CTxInWitness()]
+            tx.wit.vtxinwit[0].scriptWitness.stack = [rescue_token(WALLET_V1_SCHNORR_K, 0, y), bytes(leaf.script), leaf.control_block, rescue_annex(proof)]
+            return tx
+
+        self.log.info("A proof bound to regtest's network id is refused on this signet; one bound to its own is taken")
+        wrong = spend(network_id_regtest())
+        assert_raises_rpc_error(-26, "Invalid rescue proof", node.sendrawtransaction, wrong.serialize().hex())
+        right = spend(nid)
+        node.sendrawtransaction(right.serialize().hex())
+        block = self.generate(node, 1, maxtries=MAXTRIES)[0]
+        assert right.txid_hex in node.getblock(block)["tx"]
+        assert f"by {right.txid_hex} in block {block} (height {H4R + 1}): statement 01, key {pubkey.hex()}" in node.debug_log_path.read_text()
+
+        self.log.info("The options")
+        self.stop_node(0)
+        base = [f"-signetchallenge={CHALLENGE}", "-signetmldsa44=1"]
+        node.assert_start_raises_init_error(extra_args=base + [f"-signetrescue={H4R}"],
+                                            expected_msg="Error: -signetrescue requires -signettripwire.")
+        node.assert_start_raises_init_error(extra_args=base + [f"-signettripwire={TRIPWIRE}", f"-signetrescue={H3 - 1}"],
+                                            expected_msg=f"Error: -signetrescue height must be at or above the -signettripwire height {H3}, not {H3 - 1}.")
+        node.assert_start_raises_init_error(extra_args=[f"-signetrescue={H4R}"],
+                                            expected_msg="Error: -signetrescue requires -signetchallenge.")
+        node.assert_start_raises_init_error(extra_args=[f"-signetchallenge={ARK0_CHALLENGE}", f"-signetrescue={H4R}"],
+                                            expected_msg="Error: -signetrescue cannot be used on the Ark-0 signet, whose rules are fixed in the code.")
+        node.assert_start_raises_init_error(extra_args=base + [f"-signettripwire={TRIPWIRE}", f"-signetrescue={H4R}", f"-signetrescue={H4R + 1}"],
+                                            expected_msg="Error: -signetrescue cannot be multiple values.")
+        self.start_node(0, extra_args=ARGS)
+
+
+if __name__ == '__main__':
+    P2MRRescueSignetTest(__file__).main()
