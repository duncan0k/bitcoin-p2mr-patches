From e43f491ff3de2730b0fe0c19092315274ec39578 Mon Sep 17 00:00:00 2001
From: duncan0k <dev@ark0.si>
Date: Fri, 23 Oct 2026 22:45:09 +0000
Subject: [PATCH 83/92] rpc, validation: report the rescue lane in
 gettripwireinfo and log rescue spends

- gettripwireinfo has a rescue object where the lane has a height, from
  the same snapshot as the rest: the height, whether the lane is open for
  the next block, whether the mempool takes rescue spends (open at the
  tip and elliptic curve checks disabled for the next block), the network
  id and the statement ids. Wallets and the explorer read it.
- When a block joins the active chain, each rescue spend in it is logged
  with the spent output, the statement and the key, after ConnectTip,
  and on the active chainstate only: not for proposals, candidates that
  turn out invalid, VerifyDB or the background chainstate. Only inputs
  that spend a P2MR output through template R1 are logged: the whole
  witness a token, <key> OP_CHECKSIG at leaf version 0xe0 and depth one
  or more, the control block and one rescue record, with the spent
  output read before the block spends it. A token is never a valid
  BIP 340 signature, so in a valid block such an input went through the
  rescue path. The test costs a constant amount per input and makes no
  elliptic curve operation; rescue checks in other leaf shapes are not
  logged. Whether the lane applies is read from the flags the block is
  checked with (P2MR and leaf version 0xe0 in force, the lane open), not
  from the deployment alone, so that a regtest with P2MR later than the
  lane logs no unknown witness version spend.

feature_p2mr_tripwire.py compares a whole gettripwireinfo result, which
now has the rescue object on regtest, where the lane follows the
tripwire height.
---
 src/rpc/blockchain.cpp                   | 25 ++++++++-
 src/validation.cpp                       | 69 ++++++++++++++++++++++++
 test/functional/feature_p2mr_tripwire.py |  3 ++
 3 files changed, 96 insertions(+), 1 deletion(-)

diff --git a/src/rpc/blockchain.cpp b/src/rpc/blockchain.cpp
index fdbd35a..605b271 100644
--- a/src/rpc/blockchain.cpp
+++ b/src/rpc/blockchain.cpp
@@ -1569,6 +1569,15 @@ static RPCHelpMan gettripwireinfo()
                     }},
                 }},
                 {RPCResult::Type::BOOL, "ec_disabled_next_block", "whether elliptic curve signature checks in those leaves fail in the next block"},
+                {RPCResult::Type::OBJ, "rescue", /*optional=*/true, "the P2MR rescue lane (doc/p2mr-rescue.md), only where it has a height", {
+                    {RPCResult::Type::NUM, "height", "the height from which the lane is open"},
+                    {RPCResult::Type::BOOL, "active_next_block", "whether the lane is open in the next block"},
+                    {RPCResult::Type::BOOL, "mempool_accepts", "whether the mempool takes rescue spends: the lane is open at the tip itself, and elliptic curve checks in those leaves fail in the next block"},
+                    {RPCResult::Type::STR_HEX, "network_id", "the network id rescue proofs are bound to"},
+                    {RPCResult::Type::ARR, "statements", "the statement ids a rescue token may name", {
+                        {RPCResult::Type::STR_HEX, "", "a statement id"},
+                    }},
+                }},
             }},
         RPCExamples{
             HelpExampleCli("gettripwireinfo", "")
@@ -1605,7 +1614,21 @@ static RPCHelpMan gettripwireinfo()
     result.pushKV("height", consensus.P2MRTripwireHeight);
     result.pushKV("leaf_version", strprintf("%02x", P2MR_LEAF_TRIPWIRED));
     result.pushKV("tripwires", std::move(tripwires));
-    result.pushKV("ec_disabled_next_block", P2MRECDisabledAfter(&tip, coins, chainman));
+    const bool ec_disabled_next_block{P2MRECDisabledAfter(&tip, coins, chainman)};
+    result.pushKV("ec_disabled_next_block", ec_disabled_next_block);
+    if (DeploymentEnabled(chainman, Consensus::DEPLOYMENT_P2MR_RESCUE)) {
+        // From the same snapshot. The mempool's rules: the lane open at the tip itself (not only for
+        // the next block), and the policy check on the state of elliptic curve checks.
+        UniValue rescue(UniValue::VOBJ);
+        rescue.pushKV("height", consensus.P2MRRescueHeight);
+        rescue.pushKV("active_next_block", DeploymentActiveAfter(&tip, chainman, Consensus::DEPLOYMENT_P2MR_RESCUE));
+        rescue.pushKV("mempool_accepts", DeploymentActiveAt(tip, chainman, Consensus::DEPLOYMENT_P2MR_RESCUE) && ec_disabled_next_block);
+        rescue.pushKV("network_id", HexStr(*CHECK_NONFATAL(consensus.p2mr_rescue_network_id)));
+        UniValue statements(UniValue::VARR);
+        statements.push_back(strprintf("%02x", P2MR_RESCUE_STATEMENT_HMAC));
+        rescue.pushKV("statements", std::move(statements));
+        result.pushKV("rescue", std::move(rescue));
+    }
     return result;
 },
     };
diff --git a/src/validation.cpp b/src/validation.cpp
index 90364b4..c136b9c 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -40,6 +40,7 @@
 #include <primitives/block.h>
