@@ -342,6 +344,25 @@ static bool SpendsP2MRTripwiredLeaf(const CTransaction& tx, const CCoinsView& vi
     });
 }
 
+/**
+ * For the log of the rescue lane (doc/p2mr-rescue.md): the statement id and the key of the rescue
+ * check an input of a valid block made, when the input spends a P2MR output through template R1, its
+ * whole witness the token, <32-byte key> OP_CHECKSIG, the control block of a leaf of version 0xe0 at
+ * depth one or more, and the rescue record. A token is never a valid BIP 340 signature, so in a valid
+ * block with the lane open that check passed through the rescue path. Of constant cost, with no
+ * elliptic curve operation; rescue checks in other leaf shapes, valid but not relayed, are not logged.
+ */
+static std::optional<std::pair<uint8_t, std::vector<unsigned char>>> P2MRRescueLogEntry(const CTxIn& txin, const CScript& spent_script)
+{
+    int version;
+    std::vector<unsigned char> program;
+    if (!spent_script.IsWitnessProgram(version, program) || version != 2 || program.size() != WITNESS_V2_P2MR_SIZE) return std::nullopt;
+    const std::vector<std::vector<unsigned char>>& stack{txin.scriptWitness.stack};
+    if (!IsP2MRRescueTemplate(stack)) return std::nullopt;
+    // The token's second byte is its statement id; the leaf script is 0x20 <key> OP_CHECKSIG.
+    return std::make_pair(stack[0][1], std::vector<unsigned char>{stack[1].begin() + 1, stack[1].begin() + 33});
+}
+
 /** The script verification flags the mempool checks a transaction with: the standard ones, as they
  *  apply to the block after `tip`, whose UTXO set `coins` is. */
 static script_verify_flags MempoolScriptFlags(const CBlockIndex* tip, const CCoinsView& coins, const ChainstateManager& chainman)
@@ -3316,9 +3337,49 @@ bool Chainstate::ConnectTip(
     // num_blocks_total may be zero until the ConnectBlock() call below.
     LogDebug(BCLog::BENCH, "  - Load block from disk: %.2fms\n",
              Ticks<MillisecondsDouble>(time_2 - time_1));
+    struct RescueLogEntry {
+        COutPoint prevout;
+        Txid txid;
+        uint8_t sid;
+        std::vector<unsigned char> key;
+    };
+    std::vector<RescueLogEntry> rescue_log;
     {
         CCoinsViewCache& view{*m_coins_views->m_connect_block_view};
         const auto reset_guard{view.CreateResetGuard()};
+        // The rescue spends to log once the block is in the active chain (doc/p2mr-rescue.md): the
+        // inputs whose witness is template R1, with the outputs they spend read before the block
+        // spends them, from the UTXO set or from an earlier transaction of the block. Only where the
+        // flags the block is checked with make such an input go through the rescue path: P2MR and
+        // leaf version 0xe0 in force, and the lane open. Without P2MR (a regtest with
+        // -testactivationheight=p2mr@N above the lane's height) a witness version 2 output is spent as
+        // an unknown witness version, and without the tripwire rules a leaf of version 0xe0 is not
+        // executed.
+        const script_verify_flags block_flags{GetBlockScriptFlags(*pindexNew, m_chainman)};
+        if (this == &m_chainman.ActiveChainstate() && (block_flags & SCRIPT_VERIFY_P2MR) && (block_flags & SCRIPT_VERIFY_P2MR_TRIPWIRE) &&
+            !(block_flags & SCRIPT_VERIFY_P2MR_NO_RESCUE)) {
+            std::map<Txid, const CTransaction*> block_txs;
+            for (const CTransactionRef& tx : block_to_connect->vtx) {
+                if (tx->IsCoinBase()) continue;
+                for (const CTxIn& txin : tx->vin) {
+                    if (!IsP2MRRescueTemplate(txin.scriptWitness.stack)) continue;
+                    const CScript* spent_script{nullptr};
+                    if (const Coin& coin{view.AccessCoin(txin.prevout)}; !coin.IsSpent()) {
+                        spent_script = &coin.out.scriptPubKey;
+                    } else {
+                        if (block_txs.empty()) {
+                            for (const CTransactionRef& t : block_to_connect->vtx) block_txs.emplace(t->GetHash(), t.get());
+                        }
+                        const auto it{block_txs.find(txin.prevout.hash)};
+                        if (it == block_txs.end() || txin.prevout.n >= it->second->vout.size()) continue;
+                        spent_script = &it->second->vout[txin.prevout.n].scriptPubKey;
+                    }
+                    if (auto entry{P2MRRescueLogEntry(txin, *spent_script)}) {
+                        rescue_log.push_back({txin.prevout, tx->GetHash(), entry->first, std::move(entry->second)});
+                    }
+                }
+            }
+        }
         bool rv = ConnectBlock(*block_to_connect, state, pindexNew, view);
         if (m_chainman.m_options.signals) {
             m_chainman.m_options.signals->BlockChecked(block_to_connect, state);
@@ -3381,6 +3442,14 @@ bool Chainstate::ConnectTip(
         });
     }
 
+    // The rescue spends of this block (doc/p2mr-rescue.md), found before ConnectBlock, now that it
+    // is in the active chain, under the same restriction as the log of tripwire spends below.
+    for (const RescueLogEntry& rescue : rescue_log) {
+        LogInfo("P2MR rescue of %s:%u by %s in block %s (height %d): statement %02x, key %s",
+                rescue.prevout.hash.ToString(), rescue.prevout.n, rescue.txid.ToString(),
+                pindexNew->GetBlockHash().ToString(), pindexNew->nHeight, rescue.sid, HexStr(rescue.key));
+    }
+
     // The tripwire outputs this block spends, now that they are spent in the active chain, and the
     // state of all of them when the block reaches the activation height (doc/p2mr-tripwire.md).
     // Nowhere else: ConnectBlock also checks proposals, candidates that turn out invalid and blocks
