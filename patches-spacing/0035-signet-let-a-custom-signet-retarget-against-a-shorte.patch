 /**
  * Parameters that influence chain consensus.
  */
@@ -128,6 +138,22 @@ struct Params {
         return std::chrono::seconds{nPowTargetSpacing};
     }
     int64_t DifficultyAdjustmentInterval() const { return nPowTargetTimespan / nPowTargetSpacing; }
+    /**
+     * A change of the target spacing that difficulty retargets measure their
+     * period against: retargets for blocks at or above `height` use `spacing`
+     * seconds per block instead of nPowTargetSpacing. The retarget interval,
+     * DifficultyAdjustmentInterval(), is not changed by it. Only set on a
+     * signet given -signetpowtargetspacing, which requires -signetchallenge.
+     */
+    std::optional<PowTargetSpacingChange> pow_target_spacing_change{};
+    /** The timespan the retarget for the block at `height` measures against. */
+    int64_t PowTargetTimespan(int64_t height) const
+    {
+        if (pow_target_spacing_change && height >= pow_target_spacing_change->height) {
+            return pow_target_spacing_change->spacing * DifficultyAdjustmentInterval();
+        }
+        return nPowTargetTimespan;
+    }
