+/** A custom signet (OP_TRUE challenge) whose retargets use `spacing` seconds per block from `height` on */
+static std::unique_ptr<const CChainParams> SigNetWithTargetSpacing(int height, int64_t spacing)
+{
+    CChainParams::SigNetOptions options;
+    options.challenge.emplace(std::vector<uint8_t>{0x51});
+    options.pow_target_spacing_change.emplace(Consensus::PowTargetSpacingChange{.height = height, .spacing = spacing});
+    return CChainParams::SigNet(options);
+}
+
+/* A signet with its own challenge may retarget against a shorter target spacing from a height on */
+BOOST_AUTO_TEST_CASE(get_next_work_signet_target_spacing_change)
+{
+    // No chain has the change by default, so every retarget measures against nPowTargetTimespan.
+    for (const auto chain : {ChainType::MAIN, ChainType::TESTNET, ChainType::TESTNET4, ChainType::SIGNET, ChainType::REGTEST}) {
+        const auto params = CreateChainParams(*m_node.args, chain);
+        const auto& consensus = params->GetConsensus();
+        BOOST_CHECK(!consensus.pow_target_spacing_change);
+        BOOST_CHECK_EQUAL(consensus.PowTargetTimespan(0), consensus.nPowTargetTimespan);
+        BOOST_CHECK_EQUAL(consensus.PowTargetTimespan(std::numeric_limits<int>::max()), consensus.nPowTargetTimespan);
+    }
+
+    const auto chainParams = SigNetWithTargetSpacing(8064, 90);
+    const auto& consensus = chainParams->GetConsensus();
+    BOOST_CHECK_EQUAL(consensus.DifficultyAdjustmentInterval(), 2016);
+    BOOST_CHECK_EQUAL(consensus.PowTargetTimespan(8063), 14 * 24 * 60 * 60);
+    BOOST_CHECK_EQUAL(consensus.PowTargetTimespan(8064), 90 * 2016);
+
+    // The largest spacing the option accepts leaves room for the retarget's 256-bit product,
+    // powLimit times four times the timespan (as sanity_check_chainparams checks for every
+    // chain), and one second more would not.
+    {
+        const arith_uint256 pow_limit{UintToArith256(consensus.powLimit)};
+        arith_uint256 room{~arith_uint256{}};
+        room /= SigNetWithTargetSpacing(0, 600)->GetConsensus().PowTargetTimespan(0) * 4;
+        BOOST_CHECK(pow_limit < room);
+        arith_uint256 too_little{~arith_uint256{}};
+        too_little /= int64_t{601} * 2016 * 4;
+        BOOST_CHECK(!(pow_limit < too_little));
+    }
+
+    // Ark-0's retarget at 6048: blocks 4032..6047 took 234,329 s. Below the change height the
+    // retarget measures against two weeks, clamps the period to a quarter of that, and shrinks
+    // the target by four.
+    CBlockIndex pindexLast;
+    pindexLast.nHeight = 6047;
+    pindexLast.nTime = 1790051219;
+    pindexLast.nBits = 0x1e00ddeb;
+    const int64_t nFirstBlockTime = 1789816890;
+    BOOST_CHECK_EQUAL(CalculateNextWorkRequired(&pindexLast, nFirstBlockTime, consensus), 0x1d377ac0U);
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 6048, 0x1e00ddeb, 0x1d377ac0U));
+
+    // The same period at the change height measures against 2016 * 90 s = 181,440 s. It took
+    // longer than that and less than four times as long, so the target grows by
+    // 234,329 / 181,440: 0xddeb * 234,329 / 181,440 = 0x11e9b.2b..., in compact form 0x1e011e9b.
+    pindexLast.nHeight = 8063;
+    BOOST_CHECK_EQUAL(CalculateNextWorkRequired(&pindexLast, nFirstBlockTime, consensus), 0x1e011e9bU);
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 8064, 0x1e00ddeb, 0x1e011e9bU));
+
+    // A period under a quarter of 181,440 s is clamped to it: the target shrinks by four and a
+    // smaller one is not a permitted transition.
+    pindexLast.nTime = nFirstBlockTime + 45360 - 1;
+    BOOST_CHECK_EQUAL(CalculateNextWorkRequired(&pindexLast, nFirstBlockTime, consensus), 0x1d377ac0U);
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 8064, 0x1e00ddeb, 0x1d377ac0U));
+    BOOST_CHECK(!PermittedDifficultyTransition(consensus, 8064, 0x1e00ddeb, 0x1d377abfU));
+
+    // A period over four times 181,440 s is clamped the other way: the target grows by four,
+    // and a larger one is not a permitted transition even though it is still below powLimit
+    // (0x1e0377ae).
+    pindexLast.nTime = nFirstBlockTime + 2016 * 1000;
+    BOOST_CHECK_EQUAL(CalculateNextWorkRequired(&pindexLast, nFirstBlockTime, consensus), 0x1e0377acU);
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 8064, 0x1e00ddeb, 0x1e0377acU));
+    BOOST_CHECK(!PermittedDifficultyTransition(consensus, 8064, 0x1e00ddeb, 0x1e0377adU));
+
+    // At powLimit the target cannot grow, however long the period took.
+    pindexLast.nTime = nFirstBlockTime + 234329;
+    pindexLast.nBits = 0x1e0377ae;
+    BOOST_CHECK_EQUAL(CalculateNextWorkRequired(&pindexLast, nFirstBlockTime, consensus), 0x1e0377aeU);
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 8064, 0x1e0377ae, 0x1e0377aeU));
+
+    // A change height inside a retarget period takes effect at the next retarget: with 90@8065
+    // the retarget at 8064 still measures against two weeks, the one at 10080 against 181,440 s.
+    const auto late = SigNetWithTargetSpacing(8065, 90);
+    pindexLast.nTime = 1790051219;
+    pindexLast.nBits = 0x1e00ddeb;
+    pindexLast.nHeight = 8063;
+    BOOST_CHECK_EQUAL(CalculateNextWorkRequired(&pindexLast, nFirstBlockTime, late->GetConsensus()), 0x1d377ac0U);
+    pindexLast.nHeight = 10079;
+    BOOST_CHECK_EQUAL(CalculateNextWorkRequired(&pindexLast, nFirstBlockTime, late->GetConsensus()), 0x1e011e9bU);
+
+    // Between retargets the target does not move, before or after the change height.
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 8065, 0x1e011e9bU, 0x1e011e9bU));
+    BOOST_CHECK(!PermittedDifficultyTransition(consensus, 8065, 0x1e011e9bU, 0x1e00ddebU));
+    BOOST_CHECK(PermittedDifficultyTransition(consensus, 6049, 0x1d377ac0U, 0x1d377ac0U));
+    BOOST_CHECK(!PermittedDifficultyTransition(consensus, 6049, 0x1d377ac0U, 0x1e00ddebU));
+}
+
+/**
+ * Fill `blocks` with a signet chain: a genesis block years before the rest, then one block every
+ * 90 s, each with the nBits GetNextWorkRequired gives it under `params`.
+ */
+static void BuildSigNetChain(std::vector<CBlockIndex>& blocks, std::vector<uint256>& hashes, const Consensus::Params& params)
+{
+    for (size_t i = 0; i < blocks.size(); i++) {
+        hashes[i] = ArithToUint256(arith_uint256{i + 1}); // distinct, and never looked up
+        blocks[i].phashBlock = &hashes[i];
+        blocks[i].pprev = i ? &blocks[i - 1] : nullptr;
+        blocks[i].nHeight = i;
+        blocks[i].nTime = i ? 1789391179 + i * 90 : 1598918400;
+        blocks[i].BuildSkip();
+        if (i == 0) {
+            blocks[i].nBits = UintToArith256(params.powLimit).GetCompact();
+        } else {
+            const CBlockHeader header{blocks[i].GetBlockHeader()};
+            blocks[i].nBits = GetNextWorkRequired(&blocks[i - 1], &header, params);
+        }
+    }
+}
+
+/* A signet node started under a different retarget rule from the one it accepted headers under finds them */
+BOOST_AUTO_TEST_CASE(retarget_conflicts_after_target_spacing_change)
+{
+    CChainParams::SigNetOptions options;
+    options.challenge.emplace(std::vector<uint8_t>{0x51});
+    const auto old_rule = CChainParams::SigNet(options);
+    const auto new_rule = SigNetWithTargetSpacing(4032, 90);
+    const auto later_rule = SigNetWithTargetSpacing(4033, 90);
+    const auto from_genesis = SigNetWithTargetSpacing(0, 90);
+    const auto conflicts = [](const std::vector<CBlockIndex>& chain, const Consensus::Params& params) {
+        std::vector<int> heights;
+        for (const auto& block : chain) {
+            if (RetargetConflicts(block, params)) heights.push_back(block.nHeight);
+        }
+        return heights;
+    };
+
+    // Built under the old rule, up to and including the retarget at 4032. The retarget at 2016
+    // stays at powLimit (the genesis block is years older); 2015 blocks of 90 s are under a
+    // quarter of two weeks, so the one at 4032 is clamped and quadruples the difficulty.
+    std::vector<uint256> hashes(4033);
+    std::vector<CBlockIndex> blocks(4033);
+    BuildSigNetChain(blocks, hashes, old_rule->GetConsensus());
+    BOOST_CHECK_EQUAL(blocks[2016].nBits, 0x1e0377aeU);
+    BOOST_CHECK_EQUAL(blocks[4032].nBits, 0x1e00ddebU);
+    BOOST_CHECK(conflicts(blocks, old_rule->GetConsensus()).empty());
+    // A node given 90@4032 finds the retarget at 4032 and nothing else. One given 90@0 finds the
+    // same: at 2016 both rules clamp the target to powLimit, so that retarget does not differ.
+    // One given 90@4033 finds nothing, because the first retarget it changes (6048) is not in
+    // this chain.
+    BOOST_CHECK(conflicts(blocks, new_rule->GetConsensus()) == std::vector<int>{4032});
+    BOOST_CHECK(conflicts(blocks, from_genesis->GetConsensus()) == std::vector<int>{4032});
+    BOOST_CHECK(conflicts(blocks, later_rule->GetConsensus()).empty());
+
+    // Built under 90@4032: 2015 blocks of 90 s against 181,440 s shrink powLimit by
+    // 181,350 / 181,440, which is 0x377ae * 181,350 / 181,440 = 0x3773d.47..., compact 0x1e03773d.
+    std::vector<uint256> new_hashes(4033);
+    std::vector<CBlockIndex> new_blocks(4033);
+    BuildSigNetChain(new_blocks, new_hashes, new_rule->GetConsensus());
+    BOOST_CHECK_EQUAL(new_blocks[4032].nBits, 0x1e03773dU);
+    BOOST_CHECK(conflicts(new_blocks, new_rule->GetConsensus()).empty());
+    // A node whose option was removed, or moved to a later height, finds the retarget it
+    // accepted under the option.
+    BOOST_CHECK(conflicts(new_blocks, old_rule->GetConsensus()) == std::vector<int>{4032});
+    BOOST_CHECK(conflicts(new_blocks, later_rule->GetConsensus()) == std::vector<int>{4032});
+}
+
 BOOST_AUTO_TEST_SUITE_END()
