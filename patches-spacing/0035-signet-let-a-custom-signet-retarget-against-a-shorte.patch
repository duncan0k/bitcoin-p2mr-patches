+bool RetargetConflicts(const CBlockIndex& index, const Consensus::Params& params)
+{
+    // Without min-difficulty blocks, nBits between retargets has to equal the
+    // parent's under any retarget rule, and the header's first acceptance
+    // checked that, so only a retarget can differ.
+    if (index.pprev == nullptr || index.nHeight % params.DifficultyAdjustmentInterval() != 0) return false;
+    const CBlockHeader header{index.GetBlockHeader()};
+    return index.nBits != GetNextWorkRequired(index.pprev, &header, params);
+}
