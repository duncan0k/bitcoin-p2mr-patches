@@ -248,6 +249,52 @@ bool AreInputsStandard(const CTransaction& tx, const CCoinsViewCache& mapInputs)
     return true;
 }
 
+/**
+ * Match a P2MR leaf script against the two OP_CHECKMLDSA44 templates of doc/p2mr-mldsa44.md,
+ * byte for byte apart from the key data:
+ *   S1: <pk[0]> <pk[1]> <pk[2]> OP_CHECKMLDSA44, each public key chunk pushed with OP_PUSHDATA2;
+ *   S2: S1 OP_VERIFY <32-byte x-only public key> OP_CHECKSIG.
+ * Returns how many elements of the initial stack lie below the five signature chunks: none for
+ * S1, and for S2 the Schnorr signature. Returns nullopt for any other script.
+ */
+static std::optional<size_t> MatchMLDSA44Template(std::span<const unsigned char> script)
+{
+    size_t pos{0};
+    for (const size_t chunk_size : MLDSA44_PUBKEY_CHUNK_SIZES) {
+        if (script.size() < pos + 3 + chunk_size || script[pos] != OP_PUSHDATA2 ||
+            script[pos + 1] != (chunk_size & 0xff) || script[pos + 2] != (chunk_size >> 8)) {
+            return std::nullopt;
+        }
+        pos += 3 + chunk_size;
+    }
+    if (script.size() <= pos || script[pos] != OP_CHECKMLDSA44) return std::nullopt;
+    ++pos;
+    if (script.size() == pos) return 0; // S1
+    if (script.size() == pos + 35 && script[pos] == OP_VERIFY && script[pos + 1] == 32 && script[pos + 34] == OP_CHECKSIG) {
+        return 1; // S2
+    }
+    return std::nullopt;
+}
+
+bool HasMLDSA44Opcode(std::span<const unsigned char> script)
+{
+    const CScript leaf{script.begin(), script.end()};
+    opcodetype opcode;
+    for (CScript::const_iterator pc{leaf.begin()}; leaf.GetOp(pc, opcode);) {
+        if (opcode == OP_CHECKMLDSA44) return true;
+    }
+    return false;
+}
+
+/** Whether a size is that of the signature chunk at index `index` (0 to 4) of OP_CHECKMLDSA44. */
+static bool IsMLDSA44SigChunkSize(size_t index, size_t size)
+{
+    if (index >= MLDSA44_SIG_CHUNK_SIZES.size()) return false;
+    // The last chunk may end in an explicit hash type.
+    const bool last{index + 1 == MLDSA44_SIG_CHUNK_SIZES.size()};
+    return size == MLDSA44_SIG_CHUNK_SIZES[index] || (last && size == MLDSA44_SIG_CHUNK_SIZES[index] + 1);
+}
+
 bool IsWitnessStandard(const CTransaction& tx, const CCoinsViewCache& mapInputs)
 {
     if (tx.IsCoinBase())
@@ -351,7 +398,7 @@ bool IsWitnessStandard(const CTransaction& tx, const CCoinsViewCache& mapInputs)
             }
             // Script path spend is the only spend type (2 or more stack elements)
             const auto& control_block = SpanPopBack(stack);
-            SpanPopBack(stack); // Ignore script
+            const auto& script = SpanPopBack(stack);
             if (control_block.empty()) return false; // Empty control block is invalid
             if (control_block.size() > P2MR_CONTROL_MAX_SIZE ||
                 (control_block.size() - P2MR_CONTROL_BASE_SIZE) % P2MR_CONTROL_NODE_SIZE != 0) {
@@ -360,8 +407,17 @@ bool IsWitnessStandard(const CTransaction& tx, const CCoinsViewCache& mapInputs)
             }
             if ((control_block[0] & TAPROOT_LEAF_MASK) == TAPROOT_LEAF_TAPSCRIPT) {
                 // Leaf version 0xc0 (aka Tapscript, see BIP 342)
-                for (const auto& item : stack) {
-                    if (item.size() > MAX_STANDARD_TAPSCRIPT_STACK_ITEM_SIZE) return false;
+                // A leaf that is executed (m >= 1) may use OP_CHECKMLDSA44 only as one of its two templates,
+                // whose ML-DSA-44 signature chunks may then have their sizes (doc/p2mr-mldsa44.md).
+                std::optional<size_t> sig_chunks_at;
+                if (control_block.size() > P2MR_CONTROL_BASE_SIZE) {
+                    sig_chunks_at = MatchMLDSA44Template(script);
+                    if (!sig_chunks_at && HasMLDSA44Opcode(script)) return false;
+                }
+                if (sig_chunks_at && stack.size() != *sig_chunks_at + MLDSA44_SIG_CHUNK_SIZES.size()) sig_chunks_at.reset();
+                for (size_t j = 0; j < stack.size(); ++j) {
+                    if (sig_chunks_at && j >= *sig_chunks_at && IsMLDSA44SigChunkSize(j - *sig_chunks_at, stack[j].size())) continue;
+                    if (stack[j].size() > MAX_STANDARD_TAPSCRIPT_STACK_ITEM_SIZE) return false;
                 }
             }
         }
