diff --git a/src/validation.cpp b/src/validation.cpp
index 4ca6be9..47b384e 100644
--- a/src/validation.cpp
+++ b/src/validation.cpp
@@ -298,6 +298,23 @@ static bool IsCurrentForFeeEstimation(Chainstate& active_chainstate) EXCLUSIVE_L
     return true;
 }
 
+/** Whether an input of the transaction executes a P2MR leaf (leaf version 0xc0, depth one or
+ *  more) that has OP_CHECKMLDSA44 among its opcodes (doc/p2mr-mldsa44.md). */
+static bool SpendsP2MRMLDSA44Leaf(const CTransaction& tx, const CCoinsView& view)
+{
+    for (const CTxIn& txin : tx.vin) {
+        std::span<const std::vector<unsigned char>> stack{txin.scriptWitness.stack};
+        if (stack.size() >= 2 && !stack.back().empty() && stack.back()[0] == ANNEX_TAG) stack = stack.first(stack.size() - 1);
+        if (stack.size() < 2) continue;
+        const std::vector<unsigned char>& control{stack.back()};
+        if (control.size() <= P2MR_CONTROL_BASE_SIZE || (control[0] & TAPROOT_LEAF_MASK) != TAPROOT_LEAF_TAPSCRIPT) continue;
+        if (!HasMLDSA44Opcode(stack[stack.size() - 2])) continue;
+        const std::optional<Coin> coin{view.GetCoin(txin.prevout)};
+        if (coin && coin->out.scriptPubKey.IsPayToMerkleRoot()) return true;
+    }
+    return false;
+}
+
 void Chainstate::MaybeUpdateMempoolForReorg(
     DisconnectedBlockTransactions& disconnectpool,
     bool fAddToMempool)
@@ -338,6 +355,13 @@ void Chainstate::MaybeUpdateMempoolForReorg(
     // the disconnectpool that were added back and cleans up the mempool state.
     m_mempool->UpdateTransactionsFromBlock(vHashUpdate);
 
+    // Below its activation height OP_CHECKMLDSA44 is OP_SUCCESS240 again (doc/p2mr-mldsa44.md). The
+    // mempool only takes its spends while it is active for the next block, so once the reorganized
+    // chain puts the next block below that height, the spends accepted before are removed: a block
+    // there would include them without the protection they were accepted under.
+    const bool remove_mldsa44_spends{DeploymentEnabled(m_chainman, Consensus::DEPLOYMENT_P2MR_MLDSA44) &&
+                                     !DeploymentActiveAfter(m_chain.Tip(), m_chainman, Consensus::DEPLOYMENT_P2MR_MLDSA44)};
+
     // Predicate to use for filtering transactions in removeForReorg.
     // Checks whether the transaction is still final and, if it spends a coinbase output, mature.
     // Also updates valid entries' cached LockPoints if needed.
@@ -351,6 +375,8 @@ void Chainstate::MaybeUpdateMempoolForReorg(
         AssertLockHeld(::cs_main);
         const CTransaction& tx = it->GetTx();
 
+        if (remove_mldsa44_spends && SpendsP2MRMLDSA44Leaf(tx, CCoinsViewMemPool{&CoinsTip(), *m_mempool})) return true;
+
         // The transaction must be final.
         if (!CheckFinalTxAtTip(*Assert(m_chain.Tip()), tx)) return true;
 
@@ -1143,7 +1169,13 @@ bool MemPoolAccept::PolicyScriptChecks(const ATMPArgs& args, Workspace& ws)
     const CTransaction& tx = *ws.m_ptx;
     TxValidationState& state = ws.m_state;
 
-    constexpr script_verify_flags scriptVerifyFlags = STANDARD_SCRIPT_VERIFY_FLAGS;
+    script_verify_flags scriptVerifyFlags{STANDARD_SCRIPT_VERIFY_FLAGS};
+    // Until OP_CHECKMLDSA44 is active for the next block, its byte stays the OP_SUCCESSx that
+    // DISCOURAGE_OP_SUCCESS keeps out of the mempool, whatever the signature
+    // (doc/p2mr-mldsa44.md): a P2MR leaf that is not yet protected is not relayed as if it were.
+    if (!DeploymentActiveAfter(m_active_chainstate.m_chain.Tip(), m_active_chainstate.m_chainman, Consensus::DEPLOYMENT_P2MR_MLDSA44)) {
+        scriptVerifyFlags &= ~SCRIPT_VERIFY_P2MR_MLDSA44;
+    }
 
     // Check input scripts and signatures.
     // This is done last to help prevent CPU exhaustion denial-of-service attacks.
