@@ -58,5 +65,59 @@ static void VerifySchnorrBIP340(benchmark::Bench& bench)
     });
 }
 
+namespace {
+struct Spend {
+    CTransaction tx;
+    CTxOut spent;
+    PrecomputedTransactionData txdata;
+};
+
+std::vector<Spend> ReadSpends(DataStream& stream)
+{
+    const uint64_t count{ReadCompactSize(stream)};
+    std::vector<Spend> spends;
+    spends.reserve(count);
+    for (uint64_t i{0}; i < count; ++i) {
+        CMutableTransaction tx;
+        CTxOut spent;
+        stream >> TX_WITH_WITNESS(tx) >> spent;
+        Spend& spend{spends.emplace_back(CTransaction{tx}, spent)};
+        spend.txdata.Init(spend.tx, {spend.spent});
+    }
+    return spends;
+}
+
+/** The whole path of one signature check as a block validates it: VerifyScript on a P2MR input,
+ *  with the caching checker blocks use, whose cache it never fills, so that every check misses
+ *  the cache after hashing its entry, as a block does with signatures it has not seen. The spends
+ *  have 64 different keys and messages of each kind (see
+ *  test/util/generate_p2mr_mldsa44_bench_spends.py). Every epoch is a single check, so that the
+ *  results written by -output-json hold the distribution of single checks. */
+void VerifyScriptP2MR(benchmark::Bench& bench, bool mldsa44)
+{
+    DataStream stream{benchmark::data::p2mr_mldsa44_spends};
+    std::vector<Spend> mldsa44_spends{ReadSpends(stream)};
+    std::vector<Spend> schnorr_spends{ReadSpends(stream)};
+    std::vector<Spend>& spends{mldsa44 ? mldsa44_spends : schnorr_spends};
+    SignatureCache signature_cache{DEFAULT_SIGNATURE_CACHE_BYTES};
+    constexpr script_verify_flags flags{SCRIPT_VERIFY_P2SH | SCRIPT_VERIFY_WITNESS | SCRIPT_VERIFY_TAPROOT |
+                                        SCRIPT_VERIFY_P2MR | SCRIPT_VERIFY_P2MR_MLDSA44};
+    // bench_bitcoin -sanity-check runs one epoch without output; keep that.
+    if (bench.output() != nullptr) bench.epochs(10'000).epochIterations(1);
+    size_t next{0};
+    bench.unit("verification").run([&] {
+        Spend& spend{spends[next++ % spends.size()]};
+        const CachingTransactionSignatureChecker checker{&spend.tx, 0, spend.spent.nValue, /*storeIn=*/false, signature_cache, spend.txdata};
+        const bool ok{VerifyScript(CScript{}, spend.spent.scriptPubKey, &spend.tx.vin[0].scriptWitness, flags, checker)};
+        assert(ok);
+    });
+}
+} // namespace
+
+static void VerifyScriptP2MRMLDSA44(benchmark::Bench& bench) { VerifyScriptP2MR(bench, /*mldsa44=*/true); }
+static void VerifyScriptP2MRSchnorr(benchmark::Bench& bench) { VerifyScriptP2MR(bench, /*mldsa44=*/false); }
+
 BENCHMARK(VerifyMLDSA44);
 BENCHMARK(VerifySchnorrBIP340);
+BENCHMARK(VerifyScriptP2MRMLDSA44);
+BENCHMARK(VerifyScriptP2MRSchnorr);
diff --git a/test/util/generate_p2mr_mldsa44_bench_spends.py b/test/util/generate_p2mr_mldsa44_bench_spends.py
new file mode 100644
index 0000000..f4bbc0f
--- /dev/null
+++ b/test/util/generate_p2mr_mldsa44_bench_spends.py
@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Generate src/bench/data/p2mr_mldsa44_spends.raw for src/bench/mldsa44.cpp.
+
+The file holds signed one-input spends of P2MR outputs: first 64 spends of
+template S1 (an OP_CHECKMLDSA44 leaf, doc/p2mr-mldsa44.md), then 64 spends of a
+leaf <x-only key> OP_CHECKSIG. Every spend has its own key and message. Each
+list is a compact size count followed by, for each spend, the transaction with
+its witness and the output it spends, in network serialization.
+
+Usage, from the repository root:
+
+    ./test/util/generate_p2mr_mldsa44_bench_spends.py
+
+The output is deterministic: the keys come from fixed seeds and both signature
+schemes sign deterministically.
+"""
+
+import hashlib
+import os
+import sys
+
+sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "functional"))
+
+from test_framework.key import compute_xonly_pubkey, sign_schnorr  # noqa: E402
+from test_framework.messages import (  # noqa: E402
+    COutPoint,
+    CTransaction,
+    CTxIn,
+    CTxInWitness,
+    CTxOut,
+    ser_compact_size,
+)
+from test_framework.p2mr import p2mr_construct  # noqa: E402
+from test_framework.p2mr_mldsa44 import (  # noqa: E402
+    LEAF_FAIL,
+    NO_CODESEPARATOR,
+    mldsa44_keygen,
+    mldsa44_leaf,
+    mldsa44_sig_chunks,
+    mldsa44_sign_input,
+    mldsa44_tree,
+)
+from test_framework.script import (  # noqa: E402
+    CScript,
+    LEAF_VERSION_TAPSCRIPT,
+    OP_CHECKSIG,
+    OP_TRUE,
+    SIGHASH_DEFAULT,
+    TaprootSignatureHash,
+)
+
+COUNT = 64
+AMOUNT = 100_000
+
+
+def spending_tx(index, script_pubkey):
+    """A one-input, one-output transaction spending an output of script_pubkey."""
+    tx = CTransaction()
+    tx.version = 2
+    tx.vin = [CTxIn(COutPoint(int.from_bytes(hashlib.sha256(b"bench spend %d" % index).digest(), "little"), 0))]
+    tx.vout = [CTxOut(AMOUNT - 1_000, CScript([OP_TRUE]))]
+    tx.wit.vtxinwit = [CTxInWitness()]
+    return tx, CTxOut(AMOUNT, script_pubkey)
+
+
+def mldsa44_spend(index):
+    pubkey, seckey = mldsa44_keygen(hashlib.sha256(b"bench mldsa44 key %d" % index).digest())
+    tree = mldsa44_tree(mldsa44_leaf(pubkey))
+    leaf = tree.leaves["pq"]
+    tx, spent = spending_tx(index, tree.scriptPubKey)
+    sig = mldsa44_sign_input(seckey, tx, [spent], 0, leaf.script)
+    tx.wit.vtxinwit[0].scriptWitness.stack = mldsa44_sig_chunks(sig) + [bytes(leaf.script), leaf.control_block]
+    return tx, spent
+
+
+def schnorr_spend(index):
+    seckey = hashlib.sha256(b"bench schnorr key %d" % index).digest()
+    tree = p2mr_construct([("csig", CScript([compute_xonly_pubkey(seckey)[0], OP_CHECKSIG])), ("fail", LEAF_FAIL)])
+    leaf = tree.leaves["csig"]
+    tx, spent = spending_tx(COUNT + index, tree.scriptPubKey)
+    msg = TaprootSignatureHash(tx, [spent], SIGHASH_DEFAULT, 0, scriptpath=True, leaf_script=leaf.script,
+                               leaf_ver=LEAF_VERSION_TAPSCRIPT, codeseparator_pos=NO_CODESEPARATOR)
+    tx.wit.vtxinwit[0].scriptWitness.stack = [sign_schnorr(seckey, msg), bytes(leaf.script), leaf.control_block]
+    return tx, spent
+
+
+def main():
+    out = b""
+    for make in (mldsa44_spend, schnorr_spend):
+        out += ser_compact_size(COUNT)
+        for index in range(COUNT):
+            tx, spent = make(index)
+            out += tx.serialize() + spent.serialize()
+    path = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..",
+                                         "src", "bench", "data", "p2mr_mldsa44_spends.raw"))
+    with open(path, "wb") as f:
+        f.write(out)
+    print(f"wrote {2 * COUNT} spends, {len(out)} bytes, to {path}", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
