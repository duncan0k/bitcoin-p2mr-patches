+template <class T>
+bool GenericTransactionSignatureChecker<T>::VerifyMLDSA44Signature(std::span<const unsigned char, MLDSA44_SIGNATURE_SIZE> sig, std::span<const unsigned char, MLDSA44_PUBKEY_SIZE> pubkey, const uint256& sighash) const
+{
+    return MLDSA44Verify(pubkey, MakeUCharSpan(sighash), MakeUCharSpan(MLDSA44_CONTEXT), sig);
+}
