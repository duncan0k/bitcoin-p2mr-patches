+/** Whether byte 0xf0 executes as OP_CHECKMLDSA44: in a P2MR leaf that is executed as
+ *  tapscript, with SCRIPT_VERIFY_P2MR_MLDSA44. Everywhere else it keeps its old meaning:
+ *  a bad opcode in legacy and witness v0 scripts, OP_SUCCESS240 in tapscript. */
+static bool CheckMLDSA44Enabled(SigVersion sigversion, const ScriptExecutionData& execdata, script_verify_flags flags)
+{
+    return sigversion == SigVersion::TAPSCRIPT && execdata.m_p2mr_leaf && (flags & SCRIPT_VERIFY_P2MR_MLDSA44);
+}
+
+/** Helper for OP_CHECKMLDSA44 (doc/p2mr-mldsa44.md). items are the eight stack elements it
+ *  consumes from the bottom up: the signature chunks sig[0] .. sig[4], then the public key
+ *  chunks pk[0] .. pk[2].
+ *
+ * A return value of false means the script fails entirely. When true is returned, the
+ * success variable indicates whether a signature was given and checked.
+ */
+static bool EvalCheckMLDSA44(std::span<const valtype> items, ScriptExecutionData& execdata, const BaseSignatureChecker& checker, SigVersion sigversion, ScriptError* serror, bool& success)
+{
+    assert(sigversion == SigVersion::TAPSCRIPT);
+    assert(items.size() == MLDSA44_SIG_CHUNK_SIZES.size() + MLDSA44_PUBKEY_CHUNK_SIZES.size());
+    const auto sig_chunks{items.first(MLDSA44_SIG_CHUNK_SIZES.size())};
+    const auto pubkey_chunks{items.last(MLDSA44_PUBKEY_CHUNK_SIZES.size())};
+
+    /*
+     *  The following validation sequence is consensus critical, and follows EvalChecksigTapscript:
+     *    a signature is charged validation weight before anything else is looked at;
+     *    the script execution fails on a public key of the wrong size, even with an empty signature;
+     *    five empty signature chunks are an empty signature, which pushes false;
+     *    the script execution fails when using a non-empty invalid signature.
+     */
+    success = std::ranges::any_of(sig_chunks, [](const valtype& chunk) { return !chunk.empty(); });
+    if (success) {
+        assert(execdata.m_validation_weight_left_init);
+        execdata.m_validation_weight_left -= VALIDATION_WEIGHT_PER_MLDSA44_CHECK;
+        if (execdata.m_validation_weight_left < 0) {
+            return set_error(serror, SCRIPT_ERR_TAPSCRIPT_VALIDATION_WEIGHT);
+        }
+    }
+    for (size_t i = 0; i < pubkey_chunks.size(); ++i) {
+        if (pubkey_chunks[i].size() != MLDSA44_PUBKEY_CHUNK_SIZES[i]) return set_error(serror, SCRIPT_ERR_MLDSA44_PUBKEY_SIZE);
+    }
+    if (!success) return true;
+    for (size_t i = 0; i < sig_chunks.size(); ++i) {
+        // The last chunk may end in an explicit hash type.
+        const bool last{i + 1 == sig_chunks.size()};
+        const size_t size{sig_chunks[i].size()};
+        if (size != MLDSA44_SIG_CHUNK_SIZES[i] && !(last && size == MLDSA44_SIG_CHUNK_SIZES[i] + 1)) {
+            return set_error(serror, SCRIPT_ERR_MLDSA44_SIG_SIZE);
+        }
+    }
+
+    std::vector<unsigned char> pubkey;
+    pubkey.reserve(MLDSA44_PUBKEY_SIZE);
+    for (const valtype& chunk : pubkey_chunks) pubkey.insert(pubkey.end(), chunk.begin(), chunk.end());
+    std::vector<unsigned char> sig;
+    sig.reserve(MLDSA44_SIGNATURE_SIZE + 1);
+    for (const valtype& chunk : sig_chunks) sig.insert(sig.end(), chunk.begin(), chunk.end());
+    if (!checker.CheckMLDSA44Signature(sig, pubkey, sigversion, execdata, serror)) {
+        return false; // serror is set
+    }
+    return true;
+}
