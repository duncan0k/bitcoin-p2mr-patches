+// Copyright (c) 2026 CipherScope
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+// Build configuration for the vendored mldsa-native library, selected with
+// -DMLD_CONFIG_FILE="bitcoin_mldsa44_config.h" for both the library and every
+// file that includes mldsa_native.h, so that both see the same API.
+//
+// ML-DSA-44 only, verification only: nodes never create keys or signatures,
+// so key generation and signing are compiled out, and with them the need for
+// a randombytes() implementation. No native backend is enabled: the portable
+// C code is the only implementation, on every platform.
+
+#ifndef BITCOIN_CRYPTO_MLDSA44_BITCOIN_MLDSA44_CONFIG_H
+#define BITCOIN_CRYPTO_MLDSA44_BITCOIN_MLDSA44_CONFIG_H
+
+#define MLD_CONFIG_PARAMETER_SET 44
+#define MLD_CONFIG_NAMESPACE_PREFIX bitcoin_mldsa
+#define MLD_CONFIG_NO_KEYPAIR_API
+#define MLD_CONFIG_NO_SIGN_API
+
+#include "mldsa_native_config.h"
+
+#endif // BITCOIN_CRYPTO_MLDSA44_BITCOIN_MLDSA44_CONFIG_H
