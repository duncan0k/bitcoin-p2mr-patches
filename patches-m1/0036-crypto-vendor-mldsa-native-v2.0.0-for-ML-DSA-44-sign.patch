diff --git a/src/crypto/CMakeLists.txt b/src/crypto/CMakeLists.txt
index 92653ad..e1ae782 100644
--- a/src/crypto/CMakeLists.txt
+++ b/src/crypto/CMakeLists.txt
@@ -2,6 +2,25 @@
 # Distributed under the MIT software license, see the accompanying
 # file COPYING or https://opensource.org/license/mit/.
 
+# ML-DSA-44 (FIPS 204) verification, vendored from mldsa-native: see
+# mldsa44/README.md. The portable C code only, as one translation unit, built
+# verification-only by bitcoin_mldsa44_config.h. Every file that includes
+# mldsa_native.h must see the same MLD_CONFIG_FILE, hence PUBLIC.
+add_library(bitcoin_mldsa44 STATIC EXCLUDE_FROM_ALL
+  mldsa44/mldsa_native.c
+)
+target_compile_definitions(bitcoin_mldsa44
+  PUBLIC
+    MLD_CONFIG_FILE="bitcoin_mldsa44_config.h"
+)
+target_include_directories(bitcoin_mldsa44
+  PUBLIC
+    ${CMAKE_CURRENT_SOURCE_DIR}/mldsa44
+)
+set_target_properties(bitcoin_mldsa44 PROPERTIES
+  C_VISIBILITY_PRESET hidden
+)
+
 add_library(bitcoin_crypto STATIC EXCLUDE_FROM_ALL
   aes.cpp
   chacha20.cpp
@@ -10,6 +29,7 @@ add_library(bitcoin_crypto STATIC EXCLUDE_FROM_ALL
   hkdf_sha256_32.cpp
   hmac_sha256.cpp
   hmac_sha512.cpp
+  mldsa44.cpp
   muhash.cpp
   poly1305.cpp
   ripemd160.cpp
@@ -25,6 +45,7 @@ add_library(bitcoin_crypto STATIC EXCLUDE_FROM_ALL
 target_link_libraries(bitcoin_crypto
   PRIVATE
     core_interface
+    bitcoin_mldsa44
 )
 
 if(HAVE_SSE41)
diff --git a/src/crypto/mldsa44.cpp b/src/crypto/mldsa44.cpp
new file mode 100644
index 0000000..2e34324
--- /dev/null
+++ b/src/crypto/mldsa44.cpp
@@ -0,0 +1,22 @@
+// Copyright (c) 2026 CipherScope
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#include <crypto/mldsa44.h>
+
+// Configured by bitcoin_mldsa44_config.h through MLD_CONFIG_FILE, the same
+// definition the library itself is compiled with (src/crypto/CMakeLists.txt).
+#include <mldsa_native.h>
+
+static_assert(MLDSA44_PUBLICKEYBYTES == MLDSA44_PUBKEY_SIZE);
+static_assert(MLDSA44_BYTES == MLDSA44_SIGNATURE_SIZE);
+
+bool MLDSA44Verify(std::span<const unsigned char, MLDSA44_PUBKEY_SIZE> pubkey,
+                   std::span<const unsigned char> msg,
+                   std::span<const unsigned char> ctx,
+                   std::span<const unsigned char, MLDSA44_SIGNATURE_SIZE> sig)
+{
+    // Zero on success; any other value (an invalid signature, or a context
+    // longer than 255 bytes) is a failure.
+    return bitcoin_mldsa_verify(sig.data(), msg.data(), msg.size(), ctx.data(), ctx.size(), pubkey.data()) == 0;
+}
diff --git a/src/crypto/mldsa44.h b/src/crypto/mldsa44.h
new file mode 100644
index 0000000..b08b4a6
--- /dev/null
+++ b/src/crypto/mldsa44.h
@@ -0,0 +1,30 @@
+// Copyright (c) 2026 CipherScope
+// Distributed under the MIT software license, see the accompanying
+// file COPYING or http://www.opensource.org/licenses/mit-license.php.
+
+#ifndef BITCOIN_CRYPTO_MLDSA44_H
+#define BITCOIN_CRYPTO_MLDSA44_H
+
+#include <cstddef>
+#include <span>
+
+/** Size in bytes of an ML-DSA-44 (FIPS 204) public key. */
+static constexpr size_t MLDSA44_PUBKEY_SIZE{1312};
+/** Size in bytes of an ML-DSA-44 (FIPS 204) signature. */
+static constexpr size_t MLDSA44_SIGNATURE_SIZE{2420};
+
+/** Verify an ML-DSA-44 signature on msg under the context string ctx.
+ *
+ *  This is ML-DSA.Verify of FIPS 204 (Algorithm 3): the external interface of
+ *  pure ML-DSA, which verifies over 0x00 || len(ctx) || ctx || msg. It is not
+ *  the external-mu interface and not HashML-DSA.
+ *
+ *  Returns false for an invalid signature, including one that is not in its
+ *  unique encoding, and for a context string longer than 255 bytes.
+ */
+bool MLDSA44Verify(std::span<const unsigned char, MLDSA44_PUBKEY_SIZE> pubkey,
+                   std::span<const unsigned char> msg,
+                   std::span<const unsigned char> ctx,
+                   std::span<const unsigned char, MLDSA44_SIGNATURE_SIZE> sig);
+
+#endif // BITCOIN_CRYPTO_MLDSA44_H
