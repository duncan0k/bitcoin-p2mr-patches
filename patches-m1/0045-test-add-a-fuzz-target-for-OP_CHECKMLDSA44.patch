diff --git a/src/test/fuzz/p2mr_mldsa44.cpp b/src/test/fuzz/p2mr_mldsa44.cpp
new file mode 100644
index 0000000..b77ec5f
--- /dev/null
+++ b/src/test/fuzz/p2mr_mldsa44.cpp
@@ -0,0 +1,167 @@
+// Copyright (c) 2026 CipherScope
