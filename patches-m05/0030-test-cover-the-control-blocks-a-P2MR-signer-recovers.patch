From 0b78b3123bcaadf3de57fda747dc613a329e0ce2 Mon Sep 17 00:00:00 2001
From: CipherScope <dev@cipherscope.io>
Date: Wed, 16 Sep 2026 06:28:00 -0600
Subject: [PATCH 30/30] test: cover the control blocks a P2MR signer recovers

Strip a funded PSBT down to one malformed control block per signable leaf, so
the PSBT alone finalizes nothing, then sign it without finalizing, serialize it
and finalize it through the node RPC, which has no wallet and no way to rebuild
the tree. The existing bogus control block case adds bad blocks while keeping
the real ones, so it cannot see a signer that drops what it recovered.
combinepsbt is checked in both orders, since only the one that starts from the
stripped PSBT can lose the recovered blocks.

Also pin that a P2MR signature commits to the scriptPubKey of every spent
output, not only its own. Sign the same two input PSBT twice, once over the
second input's real spent output and once over a wrong one, then put the second
signature into the finished transaction and require the node to reject it
against the outputs really being spent. Only the signature differs between the
accepted transaction and the rejected one. The wrong scriptPubKey case next to
it shows the wallet refusing a tree it does not know, which is a different
thing.
---
 test/functional/wallet_p2mr.py | 130 +++++++++++++++++++++++++++++++--
 1 file changed, 124 insertions(+), 6 deletions(-)

diff --git a/test/functional/wallet_p2mr.py b/test/functional/wallet_p2mr.py
index e03c20d..43651e9 100644
--- a/test/functional/wallet_p2mr.py
+++ b/test/functional/wallet_p2mr.py
@@ -178,6 +178,15 @@ class WalletP2MRTest(BitcoinTestFramework):
     def only_utxo(self, wallet, address):
         return next(u for u in wallet.listunspent() if u["address"] == address)
 
+    def leaf_controls(self, psbt_b64, index=0):
+        """Every control block an input of `psbt_b64` records, as a set of hex strings.
+
+        A PSBT keys a leaf script by its control block alone, so one input can never hold the same
+        block twice and the set loses nothing.
+        """
+        entries = self.nodes[0].decodepsbt(psbt_b64)["inputs"][index]["taproot_scripts"]
+        return {control for entry in entries for control in entry["control_blocks"]}
+
     def roundtrip_and_broadcast(self, wallet, psbt, sighash="DEFAULT"):
         """Sign, serialize, combine, finalize and broadcast; return the txid.
 
@@ -273,6 +282,7 @@ class WalletP2MRTest(BitcoinTestFramework):
         self.test_psbt_roundtrip()
         self.test_sighash_types()
         self.test_bogus_control_block()
+        self.test_recovered_control_blocks()
         self.test_missing_spent_output()
         self.test_leaf_selection()
         self.test_signature_invalidation()
@@ -433,17 +443,63 @@ class WalletP2MRTest(BitcoinTestFramework):
                 psbt.i[0].map[bytes([PSBT_IN_TAP_LEAF_SCRIPT]) + bytes(candidate)] = value
         poisoned = psbt.to_base64()
 
-        def control_blocks(psbt_b64):
-            entries = node.decodepsbt(psbt_b64)["inputs"][0]["taproot_scripts"]
-            return sum(len(entry["control_blocks"]) for entry in entries)
-
-        assert_equal(control_blocks(poisoned), 3 * control_blocks(funded["psbt"]))
+        assert_equal(len(self.leaf_controls(poisoned)), 3 * len(self.leaf_controls(funded["psbt"])))
 
         txid = self.roundtrip_and_broadcast(wallet, poisoned)
         self.generate(node, 1)
         # The witness carries the valid control block, not the poisoned one.
         self.assert_p2mr_spend(txid, expected_control_len=CONTROL_DEPTH_1)
 
+    def test_recovered_control_blocks(self):
+        self.log.info("Signing hands on the control blocks it recovered, so anyone can finalize")
+        node = self.nodes[0]
+        keys = self.make_leaf_keys(2)
+        inner = "{{pk({}),pk({})}}".format(keys[0][0], keys[1][0])
+        wallet, address = self.new_p2mr_wallet("p2mr_recovered", inner)
+        self.fund(address, 1)
+
+        funded = self.pinned_psbt(
+            wallet, self.only_utxo(wallet, address), self.funder.getnewaddress(), amount=Decimal("0.5"))
+        real = self.leaf_controls(funded["psbt"])
+        assert_greater_than(len(real), 0)
+
+        # Leave every signable leaf with one malformed control block and nothing else. Unlike the
+        # poisoned PSBT above, this one carries no usable block at all: the wallet has to put back
+        # what it knows about the tree while signing, because no one downstream can work it out.
+        psbt = PSBT.from_base64(funded["psbt"])
+        for key, value in list(psbt.i[0].map.items()):
+            if not isinstance(key, bytes) or key[0] != PSBT_IN_TAP_LEAF_SCRIPT:
+                continue
+            broken = bytearray(key[1:])
+            # BIP360 requires the last bit of c[0] to be set, so this block can never be used.
+            broken[0] &= 0xFE
+            del psbt.i[0].map[key]
+            psbt.i[0].map[bytes([PSBT_IN_TAP_LEAF_SCRIPT]) + bytes(broken)] = value
+        stripped = psbt.to_base64()
+        assert_equal(self.leaf_controls(stripped) & real, set())
+        assert_equal(node.finalizepsbt(stripped)["complete"], False)
+
+        signed = self.sign_without_finalizing(wallet, stripped)
+        assert real <= self.leaf_controls(signed), self.leaf_controls(signed)
+
+        # finalizepsbt is a node RPC: no wallet, no tree, nothing but the PSBT to work from.
+        finalized = node.finalizepsbt(signed)
+        assert_equal(finalized["complete"], True)
+        self.assert_accepted(finalized["hex"])
+
+        # A combiner merges leaves control block by control block, so neither order may drop the
+        # recovered ones in favour of the set it already holds.
+        for order in ([stripped, signed], [signed, stripped]):
+            combined = node.combinepsbt(order)
+            assert real <= self.leaf_controls(combined), self.leaf_controls(combined)
+            merged = node.finalizepsbt(combined)
+            assert_equal(merged["complete"], True)
+            assert_equal(merged["hex"], finalized["hex"])
+
+        txid = node.sendrawtransaction(finalized["hex"])
+        self.generate(node, 1)
+        self.assert_p2mr_spend(txid, expected_control_len=CONTROL_DEPTH_1)
+
