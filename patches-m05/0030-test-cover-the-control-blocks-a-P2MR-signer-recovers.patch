@@ -628,6 +687,65 @@ class WalletP2MRTest(BitcoinTestFramework):
         node.sendrawtransaction(truthful["hex"])
         self.generate(node, 1)
 
+    def check_spent_script_commitment(self, wallet, address):
+        """The signature commits to the scriptPubKey of every spent output, not only its own."""
+        node = self.nodes[0]
+        p2mr_utxo = self.fund_utxo(wallet, address)
+        # A second input this wallet does not own, so a lie about it leaves this wallet's own
+        # input, its tree and its signing untouched, and only the signed message changes.
+        external_address = self.funder.getnewaddress(address_type="bech32m")
+        self.fund(external_address, 2)
+        external = next(u for u in self.funder.listunspent() if u["address"] == external_address)
+
+        utxos = [p2mr_utxo, external]
+        spent = [tx_from_hex(node.getrawtransaction(u["txid"])).vout[u["vout"]] for u in utxos]
+        base = PSBT.from_base64(node.createpsbt(
+            [{"txid": u["txid"], "vout": u["vout"]} for u in utxos],
+            [{self.funder.getnewaddress(): sum(u["amount"] for u in utxos) - Decimal("0.001")}],
+        ))
+        # Both inputs carry a witness_utxo and nothing else, so what the PSBT says about a spent
+        # output is all either signer has to go on.
+        for index, out in enumerate(spent):
+            base.i[index].map[PSBT_IN_WITNESS_UTXO] = out.serialize()
+
+        def sign_claiming(script_pubkey):
+            """Sign the P2MR input while the second input claims to spend `script_pubkey`."""
+            psbt = PSBT.from_base64(base.to_base64())
+            psbt.i[1].map[PSBT_IN_WITNESS_UTXO] = CTxOut(spent[1].nValue, script_pubkey).serialize()
+            return self.sign_without_finalizing(wallet, psbt.to_base64())
+
+        # The honest spend, signed by both wallets over the outputs really being spent. Finalizing
+        # tests the satisfaction it builds, so this is also the only one that can be finalized.
+        truthful = self.funder.walletprocesspsbt(
+            sign_claiming(spent[1].scriptPubKey), True, "DEFAULT", True, False)
+        finalized = node.finalizepsbt(truthful["psbt"])
+        assert_equal(finalized["complete"], True)
+        self.assert_accepted(finalized["hex"])
+
+        forged = bytearray(spent[1].scriptPubKey)
+        forged[-1] ^= 0xFF
+        assert bytes(forged) != spent[1].scriptPubKey
+        lying = sign_claiming(bytes(forged))
+
+        # Put the signature made over the wrong scriptPubKey into the finished transaction and
+        # change nothing else, not even which leaf is used. The BIP341 message commits to the
+        # scriptPubKey of every spent output, so it cannot stand against the outputs really spent.
+        tx = tx_from_hex(finalized["hex"])
+        stack = tx.wit.vtxinwit[0].scriptWitness.stack
+        assert_equal(len(stack), 3)
+        # A pk() leaf is a 32 byte pubkey push followed by OP_CHECKSIG, so it names its own key.
+        pubkey = stack[-2].hex()[2:2 + 64]
+        sigs = node.decodepsbt(lying)["inputs"][0]["taproot_script_path_sigs"]
+        over_wrong_script = bytes.fromhex(next(s["sig"] for s in sigs if s["pubkey"] == pubkey))
+        assert_equal(len(over_wrong_script), len(stack[0]))
+        assert over_wrong_script != stack[0], over_wrong_script.hex()
+        stack[0] = over_wrong_script
+        self.assert_rejected(tx.serialize().hex(), MEMPOOL_SIG_FAILURE)
+        self.log.info("  signing over another input's wrong scriptPubKey: rejected")
+
+        node.sendrawtransaction(finalized["hex"])
+        self.generate(node, 1)
+
     def test_mixed_inputs(self):
         self.log.info("Estimate and spend P2MR alongside legacy and segwit inputs")
         node = self.nodes[0]
