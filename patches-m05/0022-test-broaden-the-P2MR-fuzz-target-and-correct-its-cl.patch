+/** Build the deepest legal tree: one tracked leaf under 128 omitted Merkle nodes.
+ *
+ * This is the only shape that produces a full size 4097 byte control block.
+ */
+TaprootBuilder DeepTree(const CScript& leaf_script, int leaf_version)
+{
+    TaprootBuilder builder;
+    builder.Add(P2MR_CONTROL_MAX_NODE_COUNT, leaf_script, leaf_version);
+    for (int depth = P2MR_CONTROL_MAX_NODE_COUNT; depth >= 1; --depth) {
+        builder.AddOmitted(depth, uint256{static_cast<uint8_t>(depth)});
     }
     assert(builder.IsComplete());
     return builder;
 }
