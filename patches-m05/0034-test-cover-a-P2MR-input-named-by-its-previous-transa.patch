+    def check_swapped_associations_from_previous_tx(self, wallet, address, inner):
+        """The same repair when the input names what it spends by the whole previous transaction."""
+        node = self.nodes[0]
+        utxo = self.fund_utxo(wallet, address)
+        funded = self.pinned_psbt(wallet, utxo, self.funder.getnewaddress(), amount=Decimal("0.5"))
+        truthful = self.leaf_associations(funded["psbt"])
+
+        psbt = PSBT.from_base64(funded["psbt"])
+        self.swap_leaf_entries(psbt)
+        # Name the spent output by the transaction that created it, which is the other way a PSBT
+        # is allowed to say what an input spends. The output is then something a signer has to
+        # look up rather than read, and until it does it cannot tell which leaf a block proves.
+        del psbt.i[0].map[PSBT_IN_WITNESS_UTXO]
+        psbt.i[0].map[PSBT_IN_NON_WITNESS_UTXO] = tx_from_hex(
+            node.getrawtransaction(utxo["txid"])).serialize()
+        swapped = psbt.to_base64()
+        decoded = node.decodepsbt(swapped)["inputs"][0]
+        assert "witness_utxo" not in decoded, decoded
+        assert "non_witness_utxo" in decoded, decoded
+
+        # A wallet with nothing in it but this tree, so the tree and the output being spent are
+        # the only things that can put a control block back under its own leaf.
+        node.createwallet(wallet_name="p2mr_assoc_blank", blank=True)
+        blank = node.get_wallet_rpc("p2mr_assoc_blank")
+        assert_equal(self.import_tmr(blank, inner)[0]["success"], True)
+
+        signed = self.sign_without_finalizing(blank, swapped)
+        assert_equal(self.leaf_associations(signed), truthful)
+        finalized = node.finalizepsbt(signed)
+        assert_equal(finalized["complete"], True)
+        txid = node.sendrawtransaction(finalized["hex"])
+        self.generate(node, 1)
+        self.assert_p2mr_spend(txid, expected_control_len=CONTROL_DEPTH_1)
+        self.log.info("  the same, with only the previous transaction to go on: repaired")
+
     def check_conflicting_merge(self, wallet, address):
         """Combining two PSBTs that disagree about a control block keeps the provable reading."""
         node = self.nodes[0]
-        funded = self.pinned_psbt(
-            wallet, self.fund_utxo(wallet, address), self.funder.getnewaddress(), amount=Decimal("0.5"))
+        utxo = self.fund_utxo(wallet, address)
+        funded = self.pinned_psbt(wallet, utxo, self.funder.getnewaddress(), amount=Decimal("0.5"))
