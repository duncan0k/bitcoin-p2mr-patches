+        spends = set()
         for order in ([signed, conflicting], [conflicting, signed]):
-            combined = node.combinepsbt(order)
-            assert_equal(self.leaf_associations(combined), truthful)
-            merged = node.finalizepsbt(combined)
-            assert_equal(merged["complete"], True)
-            spends.append(merged["hex"])
-        assert_equal(spends[0], spends[1])
-
-        txid = node.sendrawtransaction(spends[0])
+            for sides in (order, [named_by_previous_tx(side) for side in order]):
+                combined = node.combinepsbt(sides)
+                assert_equal(self.leaf_associations(combined), truthful)
+                merged = node.finalizepsbt(combined)
+                assert_equal(merged["complete"], True)
+                spends.add(merged["hex"])
+        assert_equal(len(spends), 1)
+
+        txid = node.sendrawtransaction(spends.pop())
         self.generate(node, 1)
         self.assert_p2mr_spend(txid, expected_control_len=CONTROL_DEPTH_1)
         self.log.info("  combining a PSBT that names a leaf with the wrong control block: resolved")
 
+    def check_merge_without_a_spent_output(self, wallet, address):
+        """Combining PSBTs that do not say what they spend still names one leaf per block."""
+        node = self.nodes[0]
+        funded = self.pinned_psbt(
+            wallet, self.fund_utxo(wallet, address), self.funder.getnewaddress(), amount=Decimal("0.5"))
+        (key_a, value_a), (_, value_b) = self.leaf_entries(PSBT.from_base64(funded["psbt"])).items()
+
+        def naming(entry):
+            """The funded PSBT cut down to one leaf entry, saying nothing about what it spends."""
+            psbt = PSBT.from_base64(funded["psbt"])
+            for key in self.leaf_entries(psbt):
+                del psbt.i[0].map[key]
+            del psbt.i[0].map[PSBT_IN_WITNESS_UTXO]
+            psbt.i[0].map.update(entry)
+            return psbt.to_base64()
+
+        # Two readings of the same control block, neither of which can be checked, because with no
+        # spent output there is no Merkle root to check against and no way to tell a P2MR input
+        # from a tr() one. Combining then leaves the side merged into as it was, and above all it
+        # may not record the block under both leaves, which would write one key twice.
+        mine = naming({key_a: value_a})
+        theirs = naming({key_a: value_b})
+        for side in (mine, theirs):
+            decoded = node.decodepsbt(side)["inputs"][0]
+            assert "witness_utxo" not in decoded, decoded
+            assert "non_witness_utxo" not in decoded, decoded
+            assert_equal(len(self.leaf_associations(side)), 1)
+        assert self.leaf_associations(mine) != self.leaf_associations(theirs)
+
+        for base, other in ([mine, theirs], [theirs, mine]):
+            combined = node.combinepsbt([base, other])
+            assert_equal(self.leaf_associations(combined), self.leaf_associations(base))
+        self.log.info("  combining two PSBTs that say nothing about the spent output: one leaf each")
+
     def test_taproot_merge_unchanged(self):
         self.log.info("Combining a tr() input keeps the control blocks of the side merged into")
         node = self.nodes[0]
