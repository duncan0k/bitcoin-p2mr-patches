+        def named_by_previous_tx(psbt_b64):
+            """The same PSBT, saying what it spends with the whole previous transaction."""
+            psbt = PSBT.from_base64(psbt_b64)
+            del psbt.i[0].map[PSBT_IN_WITNESS_UTXO]
+            psbt.i[0].map[PSBT_IN_NON_WITNESS_UTXO] = previous_tx
