+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""The wallet refuses P2MR receiving addresses where BIP360 is not deployed.
+
+Where P2MR never activates, a 32 byte witness v2 program is an unknown witness
+program: consensus accepts any witness for it, so coins paid to such an address
+can be taken by the first miner that notices. The entry points that produce
+addresses for receiving therefore have to refuse on those chains, while parsing
+and inspection stay available.
+
+Signet is the only chain whose P2MR activation depends on configuration: a
+custom -signetchallenge enables it at height 1, the default challenge never
+does. That makes it the one place where both sides can be tested.
+"""
+
+from test_framework.descriptors import descsum_create
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import (
+    assert_equal,
+    assert_raises_rpc_error,
+)
+from test_framework.wallet_util import generate_keypair
+
+NOT_ENABLED = "P2MR (BIP 360) is not enabled on this chain"
+
+
+class WalletP2MRSignetTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.chain = "signet"
+        self.num_nodes = 2
+        self.setup_clean_chain = True
+        # node0: custom signet, where P2MR activates at height 1.
+        # node1: default signet parameters, where it never activates.
+        self.extra_args = [["-signetchallenge=51"], []]
+
+    def skip_test_if_missing_module(self):
+        self.skip_if_no_wallet()
+
+    def setup_network(self):
+        # The two nodes are on different signets; never connect them.
+        self.setup_nodes()
+
+    def init_wallet(self, *, node):
+        pass
+
+    def run_test(self):
+        enabled, disabled = self.nodes
+        assert "p2mr" in enabled.getdeploymentinfo()["deployments"]
+        assert "p2mr" not in disabled.getdeploymentinfo()["deployments"]
+
+        wifs = [generate_keypair(wif=True)[0] for _ in range(2)]
+        tmr = descsum_create("tmr({{pk({}),pk({})}})".format(*wifs))
+        wpkh = descsum_create("wpkh({})".format(wifs[0]))
+
+        self.log.info("custom signet: the descriptor imports and derives normally")
+        enabled.createwallet(wallet_name="p2mr")
+        wallet = enabled.get_wallet_rpc("p2mr")
+        assert_equal(wallet.importdescriptors([{"desc": tmr, "timestamp": "now"}])[0]["success"], True)
+        address = enabled.deriveaddresses(tmr)[0]
+        assert address.startswith("tb1z"), address
+        assert_equal(wallet.getaddressinfo(address)["ismine"], True)
+
+        self.log.info("default signet: importing and deriving are both refused")
+        disabled.createwallet(wallet_name="p2mr")
+        blocked = disabled.get_wallet_rpc("p2mr")
+        result = blocked.importdescriptors([{"desc": tmr, "timestamp": "now"}])[0]
+        assert_equal(result["success"], False)
+        assert NOT_ENABLED in result["error"]["message"], result
+        assert_raises_rpc_error(-5, NOT_ENABLED, disabled.deriveaddresses, tmr)
+        # Nothing was added to the wallet, so the address is not watched either.
+        assert_equal(blocked.getaddressinfo(address)["ismine"], False)
+
+        self.log.info("default signet: parsing and other descriptors are unaffected")
+        info = disabled.getdescriptorinfo(tmr)
+        assert info["descriptor"].startswith("tmr("), info
+        assert_equal(info["isrange"], False)
+        assert_equal(info["hasprivatekeys"], True)
+        assert disabled.deriveaddresses(wpkh)[0].startswith("tb1q")
+        assert_equal(blocked.importdescriptors([{"desc": wpkh, "timestamp": "now"}])[0]["success"], True)
+
+
+if __name__ == "__main__":
+    WalletP2MRSignetTest(__file__).main()
