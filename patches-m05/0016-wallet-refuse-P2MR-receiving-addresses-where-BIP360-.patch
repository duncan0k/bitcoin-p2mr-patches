+void CheckP2MRReceiveAllowed(std::span<const CScript> scripts)
+{
+    if (DeploymentEnabled(Params().GetConsensus(), Consensus::DEPLOYMENT_P2MR)) return;
+    for (const CScript& script : scripts) {
+        if (!script.IsPayToMerkleRoot()) continue;
+        throw JSONRPCError(RPC_INVALID_ADDRESS_OR_KEY,
+                           "P2MR (BIP 360) is not enabled on this chain. A P2MR output is an unknown "
+                           "witness program here, which consensus lets anyone spend, so any miner can "
+                           "take coins sent to such an address. Refusing to produce a P2MR receiving "
+                           "address on this chain.");
+    }
+}
