+    def roundtrip_and_broadcast(self, wallet, psbt, sighash="DEFAULT"):
+        """Sign, serialize, combine, finalize and broadcast; return the txid.
+
+        This is the collaborative flow: the signer never finalizes, the PSBT travels as bytes, and
+        a separate finalizer has to work out the signature length from what the PSBT records.
+        """
+        node = self.nodes[0]
+        signed = self.sign_without_finalizing(wallet, psbt, sighash)
+        reserialized = PSBT.from_base64(signed).to_base64()
+        assert_equal(reserialized, signed)
+        combined = node.combinepsbt([signed, reserialized])
+        finalized = node.finalizepsbt(combined)
+        assert_equal(finalized["complete"], True)
+        return node.sendrawtransaction(finalized["hex"])
+
+    def estimated_vsize(self, funded, fee_rate):
+        """Recover the size the wallet estimated from the fee it charged."""
+        fee_sat = int(funded["fee"] * 100000000)
+        assert_equal(fee_sat % fee_rate, 0)
+        return fee_sat // fee_rate
+
+    def assert_estimate_matches(self, funded, fee_rate, signed_hex, num_inputs):
+        """The estimate must cover the signed transaction without overshooting by much."""
+        estimated = self.estimated_vsize(funded, fee_rate)
+        actual = self.nodes[0].decoderawtransaction(signed_hex)["vsize"]
+        assert_greater_than_or_equal(estimated, actual)
+        assert_greater_than_or_equal(actual + num_inputs * MAX_ESTIMATE_SLACK_PER_INPUT, estimated)
+        return estimated, actual
