-        # Add a second control block for the same leaf whose last bit is clear, which consensus
-        # rejects for every leaf version. It is the same length and sorts first.
+        # Add two more control blocks for every leaf. Both are the same length as the real one and
+        # sort ahead of it, so picking the first candidate blindly would take one of them:
+        #   - the real block with the mandatory last bit of c[0] cleared, which is malformed;
+        #   - a well formed block whose Merkle path is all zeroes, which rebuilds a different root.
         psbt = PSBT.from_base64(funded["psbt"])
         leaves = {k: v for k, v in psbt.i[0].map.items()
                   if isinstance(k, bytes) and k[0] == PSBT_IN_TAP_LEAF_SCRIPT}
         assert_greater_than(len(leaves), 0)
-        for key, value in leaves.items():
+        for tag, (key, value) in enumerate(leaves.items(), start=1):
             control = bytearray(key[1:])
-            control[0] &= 0xFE
-            psbt.i[0].map[bytes([PSBT_IN_TAP_LEAF_SCRIPT]) + bytes(control)] = value
+            assert_greater_than(len(control), P2MR_CONTROL_BASE_SIZE)
+            bad_parity = bytearray(control)
+            bad_parity[0] &= 0xFE
+            # A near zero Merkle path sorts before any real one and cannot rebuild the root. The
+            # trailing tag keeps the candidates distinct, since a PSBT keys a leaf script by its
+            # control block alone.
+            wrong_root = bytearray([control[0]]) + bytearray(len(control) - P2MR_CONTROL_BASE_SIZE - 1) + bytearray([tag])
+            assert wrong_root < control, (bytes(wrong_root).hex(), bytes(control).hex())
+            for candidate in (bad_parity, wrong_root):
+                assert_equal(len(candidate), len(control))
+                assert bytes(candidate) != bytes(control)
+                psbt.i[0].map[bytes([PSBT_IN_TAP_LEAF_SCRIPT]) + bytes(candidate)] = value
         poisoned = psbt.to_base64()
 
         def control_blocks(psbt_b64):
             entries = node.decodepsbt(psbt_b64)["inputs"][0]["taproot_scripts"]
             return sum(len(entry["control_blocks"]) for entry in entries)
 
