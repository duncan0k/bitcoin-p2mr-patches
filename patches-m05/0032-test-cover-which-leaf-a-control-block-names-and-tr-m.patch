 from decimal import Decimal
@@ -41,6 +42,10 @@ TAPROOT_LEAF_TAPSCRIPT = 0xC0
 # Control block sizes for a leaf one and two Merkle nodes below the root.
 CONTROL_DEPTH_1 = P2MR_CONTROL_BASE_SIZE + P2MR_CONTROL_NODE_SIZE
 CONTROL_DEPTH_2 = P2MR_CONTROL_BASE_SIZE + 2 * P2MR_CONTROL_NODE_SIZE
+# A BIP341 control block carries an internal key as well, which is what makes it longer than a
+# P2MR one of the same depth. tmr() has no internal key and no key path.
+TAPROOT_CONTROL_BASE_SIZE = 33
+TAPROOT_CONTROL_NODE_SIZE = 32
 # Test-only extended private key, reused from wallet_taproot.py.
 XPRV = "tprv8ZgxMBicQKsPeNLUGrbv3b7qhUk1LQJZAGMuk9gVuKh9sd4BWGp1eMsehUni6qGb8bjkdwBxCbgNGdh2bYGACK5C5dRTaif9KBKGVnSezxV"
 
@@ -178,14 +183,24 @@ class WalletP2MRTest(BitcoinTestFramework):
     def only_utxo(self, wallet, address):
         return next(u for u in wallet.listunspent() if u["address"] == address)
 
-    def leaf_controls(self, psbt_b64, index=0):
-        """Every control block an input of `psbt_b64` records, as a set of hex strings.
+    def leaf_associations(self, psbt_b64, index=0):
+        """Map every control block an input of `psbt_b64` records to the leaf script it names.
 
         A PSBT keys a leaf script by its control block alone, so one input can never hold the same
-        block twice and the set loses nothing.
+        block twice and this loses nothing. decodepsbt is also the parser that enforces it: an
+        input that repeats a key does not come back at all.
         """
         entries = self.nodes[0].decodepsbt(psbt_b64)["inputs"][index]["taproot_scripts"]
-        return {control for entry in entries for control in entry["control_blocks"]}
+        return {control: entry["script"] for entry in entries for control in entry["control_blocks"]}
+
+    def leaf_controls(self, psbt_b64, index=0):
+        """Every control block an input of `psbt_b64` records, as a set of hex strings."""
+        return set(self.leaf_associations(psbt_b64, index))
+
+    def leaf_entries(self, psbt):
+        """The (key, value) pairs of a parsed PSBT's first input that record a leaf script."""
+        return {key: value for key, value in psbt.i[0].map.items()
+                if isinstance(key, bytes) and key[0] == PSBT_IN_TAP_LEAF_SCRIPT}
 
     def roundtrip_and_broadcast(self, wallet, psbt, sighash="DEFAULT"):
         """Sign, serialize, combine, finalize and broadcast; return the txid.
@@ -283,6 +298,8 @@ class WalletP2MRTest(BitcoinTestFramework):
         self.test_sighash_types()
