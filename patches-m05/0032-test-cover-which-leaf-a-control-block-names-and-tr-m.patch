@@ -500,6 +514,129 @@ class WalletP2MRTest(BitcoinTestFramework):
         self.generate(node, 1)
         self.assert_p2mr_spend(txid, expected_control_len=CONTROL_DEPTH_1)
 
+    def test_control_block_associations(self):
+        self.log.info("A control block names one leaf, whatever the PSBT it arrived in claimed")
+        keys = self.make_leaf_keys(2)
+        inner = "{{pk({}),pk({})}}".format(keys[0][0], keys[1][0])
+        wallet, address = self.new_p2mr_wallet("p2mr_assoc", inner)
+
+        self.check_swapped_associations(wallet, address)
+        self.check_conflicting_merge(wallet, address)
+
+    def check_swapped_associations(self, wallet, address):
+        """Signing puts each control block back under the leaf the output proves it belongs to."""
+        node = self.nodes[0]
+        funded = self.pinned_psbt(
+            wallet, self.fund_utxo(wallet, address), self.funder.getnewaddress(), amount=Decimal("0.5"))
+        truthful = self.leaf_associations(funded["psbt"])
+        assert_equal(len(truthful), 2)
+
+        # Give each leaf the other leaf's control block. Both keys stay unique and both values
+        # still parse, so this is a PSBT a wallet is handed and has to make sense of, not a
+        # malformed one it may reject. Signing adds the associations the output does prove, and
+        # keeping those beside the swapped ones would write each key twice.
+        psbt = PSBT.from_base64(funded["psbt"])
+        (key_a, value_a), (key_b, value_b) = self.leaf_entries(psbt).items()
+        for key in (key_a, key_b):
+            del psbt.i[0].map[key]
+        psbt.i[0].map[key_a] = value_b
+        psbt.i[0].map[key_b] = value_a
+        swapped = psbt.to_base64()
+        assert_equal(self.leaf_controls(swapped), set(truthful))
+        assert self.leaf_associations(swapped) != truthful
+
+        signed = self.sign_without_finalizing(wallet, swapped)
+        assert_equal(self.leaf_associations(signed), truthful)
+        finalized = node.finalizepsbt(signed)
+        assert_equal(finalized["complete"], True)
+        txid = node.sendrawtransaction(finalized["hex"])
+        self.generate(node, 1)
+        self.assert_p2mr_spend(txid, expected_control_len=CONTROL_DEPTH_1)
+        self.log.info("  a PSBT that swapped the two leaves' control blocks: repaired")
+
+    def check_conflicting_merge(self, wallet, address):
+        """Combining two PSBTs that disagree about a control block keeps the provable reading."""
+        node = self.nodes[0]
+        funded = self.pinned_psbt(
+            wallet, self.fund_utxo(wallet, address), self.funder.getnewaddress(), amount=Decimal("0.5"))
+        truthful = self.leaf_associations(funded["psbt"])
+        signed = self.sign_without_finalizing(wallet, funded["psbt"])
+
+        # One leaf, named by the control block that belongs to the other one. Merged either way
+        # round, that control block would otherwise end up under two leaves at once.
+        psbt = PSBT.from_base64(funded["psbt"])
+        (key_a, _), (key_b, value_b) = self.leaf_entries(psbt).items()
+        for key in (key_a, key_b):
+            del psbt.i[0].map[key]
+        psbt.i[0].map[key_a] = value_b
+        conflicting = psbt.to_base64()
+        assert_equal(len(self.leaf_associations(conflicting)), 1)
+
+        spends = []
+        for order in ([signed, conflicting], [conflicting, signed]):
+            combined = node.combinepsbt(order)
+            assert_equal(self.leaf_associations(combined), truthful)
+            merged = node.finalizepsbt(combined)
+            assert_equal(merged["complete"], True)
+            spends.append(merged["hex"])
+        assert_equal(spends[0], spends[1])
+
+        txid = node.sendrawtransaction(spends[0])
+        self.generate(node, 1)
+        self.assert_p2mr_spend(txid, expected_control_len=CONTROL_DEPTH_1)
+        self.log.info("  combining a PSBT that names a leaf with the wrong control block: resolved")
+
+    def test_taproot_merge_unchanged(self):
+        self.log.info("Combining a tr() input keeps the control blocks of the side merged into")
+        node = self.nodes[0]
+        # The internal key goes in by public key alone, so there is no key path to sign with and
+        # the wallet has to take a script path, which is what carries a control block.
+        internal = self.make_leaf_keys(1)[0][1]
+        leaves = self.make_leaf_keys(2)
+        desc = descsum_create("tr({},{{pk({}),pk({})}})".format(internal, leaves[0][0], leaves[1][0]))
+        node.createwallet(wallet_name="p2mr_tr")
+        wallet = node.get_wallet_rpc("p2mr_tr")
+        assert_equal(wallet.importdescriptors([{"desc": desc, "timestamp": "now"}])[0]["success"], True)
+        address = self.derive_address(desc)
+
+        funded = self.pinned_psbt(
+            wallet, self.fund_utxo(wallet, address), self.funder.getnewaddress(), amount=Decimal("0.5"))
+        good = self.sign_without_finalizing(wallet, funded["psbt"])
+
+        # Truncating a control block to its base drops the Merkle path, which leaves a well formed
+        # depth zero block that commits to a different output key. It also sorts before the real
+        # one, and a tr() signer takes the shortest block a leaf has without trying another. Only
+        # one leaf is given it: a control block's base is the leaf version and the internal key,
+        # so both leaves of this tree truncate to the very same bytes.
+        psbt = PSBT.from_base64(funded["psbt"])
+        key, value = next(iter(self.leaf_entries(psbt).items()))
+        control = key[1:]
+        assert_equal(len(control), TAPROOT_CONTROL_BASE_SIZE + TAPROOT_CONTROL_NODE_SIZE)
+        truncated = control[:TAPROOT_CONTROL_BASE_SIZE]
+        del psbt.i[0].map[key]
+        psbt.i[0].map[bytes([PSBT_IN_TAP_LEAF_SCRIPT]) + truncated] = value
+        bogus = psbt.to_base64()
+        assert_equal(len(self.leaf_controls(bogus)), len(self.leaf_controls(good)))
+        assert_equal(self.leaf_controls(bogus) - self.leaf_controls(good), {truncated.hex()})
+
+        # A P2MR input takes the union of both sides' control blocks, because its signer checks
+        # each one against the output root. Doing that to a tr() input instead hands its signer a
+        # shorter block it cannot use, so merging has to leave tr() inputs as they were.
+        merged = node.combinepsbt([good, bogus])
+        assert_equal(self.leaf_controls(merged), self.leaf_controls(good))
+        finalized = node.finalizepsbt(merged)
+        assert_equal(finalized["complete"], True)
+        self.assert_accepted(finalized["hex"])
+
+        other_way = node.combinepsbt([bogus, good])
+        assert_equal(self.leaf_controls(other_way), self.leaf_controls(bogus))
+        # Nothing recovers from the shortest block being the wrong one, which is the whole reason
+        # the union must not reach a tr() input.
+        assert_equal(node.finalizepsbt(other_way)["complete"], False)
+
+        node.sendrawtransaction(finalized["hex"])
+        self.generate(node, 1)
+
     def test_missing_spent_output(self):
         self.log.info("Signing a P2MR input needs every spent output of the transaction")
         node = self.nodes[0]
