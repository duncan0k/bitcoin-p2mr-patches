+    def sign_without_finalizing(self, wallet, psbt, sighash="DEFAULT", index=0):
+        """Sign a PSBT input without finalizing it and return the resulting PSBT.
+
+        walletprocesspsbt reports "complete" only once every input is finalized, so the signature
+        itself has to be read out of the tap script signature field.
+        """
+        signed = wallet.walletprocesspsbt(psbt, True, sighash, True, False)
+        decoded = self.nodes[0].decodepsbt(signed["psbt"])["inputs"][index]
+        assert "final_scriptwitness" not in decoded, decoded
+        # The wallet signs every leaf it can satisfy, so there is one signature per such leaf.
+        sigs = decoded["taproot_script_path_sigs"]
+        assert_greater_than(len(sigs), 0)
+        for sig in sigs:
+            # SIGHASH_DEFAULT signatures are 64 bytes and carry no sighash byte.
+            assert_equal(len(bytes.fromhex(sig["sig"])), 64 if sighash == "DEFAULT" else 65)
+        # Like taproot, the sighash field stays out of the PSBT for the default type and is
+        # recorded for every other one, so that a separate finalizer asks for the right length.
+        if sighash == "DEFAULT":
+            assert "sighash" not in decoded, decoded
+        else:
+            assert_equal(decoded["sighash"], sighash)
+        return signed["psbt"]
