+namespace {
+//! A distinct, never executed leaf script.
+CScript TestLeaf(uint8_t tag)
+{
+    return CScript() << std::vector<unsigned char>(4, tag) << OP_CHECKSIG;
+}
+
+using TreeLeaves = std::vector<std::tuple<int, std::vector<unsigned char>, int>>;
+
+TreeLeaves ExpectedLeaves(const std::vector<std::pair<int, CScript>>& leaves)
+{
+    TreeLeaves ret;
+    for (const auto& [depth, script] : leaves) {
+        ret.emplace_back(depth, std::vector<unsigned char>(script.begin(), script.end()), TAPROOT_LEAF_TAPSCRIPT);
+    }
+    return ret;
+}
+
+TaprootBuilder BuildTree(const std::vector<std::pair<int, CScript>>& leaves)
+{
+    TaprootBuilder builder;
+    for (const auto& [depth, script] : leaves) builder.Add(depth, script, TAPROOT_LEAF_TAPSCRIPT);
+    BOOST_CHECK(builder.IsComplete());
+    return builder;
+}
+} // namespace
+
+/** InferTaprootTree() and InferP2MRTree() share one reconstruction helper, which differs only in
+ *  the fixed prefix of a control block. Pin both against the same three tree shapes. */
+BOOST_AUTO_TEST_CASE(infer_script_tree_test)
+{
+    const XOnlyPubKey internal_key{"a34b99f22c790c4e36b2b3c2c35a36db06226e41c692fc82b8b56ac1c540c5bd"_hex_u8};
+    BOOST_CHECK(internal_key.IsFullyValid());
+
+    // An unbalanced tree with three distinct leaves.
+    const std::vector<std::pair<int, CScript>> unbalanced{{1, TestLeaf(1)}, {2, TestLeaf(2)}, {2, TestLeaf(3)}};
+    // Two identical subtrees under the root, which the reconstruction has to special case because
+    // the leaves below them have identical control blocks.
+    const std::vector<std::pair<int, CScript>> duplicated{{2, TestLeaf(4)}, {2, TestLeaf(5)}, {2, TestLeaf(4)}, {2, TestLeaf(5)}};
+
+    for (const auto& leaves : {unbalanced, duplicated}) {
+        TaprootBuilder builder{BuildTree(leaves)};
+
+        // BIP360: the output is the Merkle root, and control blocks carry no internal key.
+        const WitnessV2P2MR p2mr_output{builder.GetP2MROutput()};
+        P2MRSpendData p2mr_spend{builder.GetP2MRSpendData()};
+        const auto p2mr_tree{InferP2MRTree(p2mr_spend, p2mr_output)};
+        BOOST_REQUIRE(p2mr_tree.has_value());
+        BOOST_CHECK(*p2mr_tree == ExpectedLeaves(leaves));
+
+        // BIP341: the same tree under a tweaked internal key.
+        builder.Finalize(internal_key);
+        const WitnessV1Taproot tr_output{builder.GetOutput()};
+        TaprootSpendData tr_spend{builder.GetSpendData()};
+        const auto tr_tree{InferTaprootTree(tr_spend, tr_output)};
+        BOOST_REQUIRE(tr_tree.has_value());
+        BOOST_CHECK(*tr_tree == ExpectedLeaves(leaves));
+
+        // Dropping any leaf leaves a branch that cannot be explored, so neither reconstructs.
+        P2MRSpendData p2mr_partial{p2mr_spend};
+        p2mr_partial.scripts.erase(p2mr_partial.scripts.begin());
+        BOOST_CHECK(!InferP2MRTree(p2mr_partial, p2mr_output).has_value());
+        TaprootSpendData tr_partial{tr_spend};
+        tr_partial.scripts.erase(tr_partial.scripts.begin());
+        BOOST_CHECK(!InferTaprootTree(tr_partial, tr_output).has_value());
+
+        // A Merkle root that does not belong to the output is refused before any reconstruction.
+        P2MRSpendData p2mr_wrong{p2mr_spend};
+        p2mr_wrong.merkle_root = uint256::ONE;
+        BOOST_CHECK(!InferP2MRTree(p2mr_wrong, p2mr_output).has_value());
+        TaprootSpendData tr_wrong{tr_spend};
+        tr_wrong.merkle_root = uint256::ONE;
+        BOOST_CHECK(!InferTaprootTree(tr_wrong, tr_output).has_value());
+    }
+}
+
+/** BIP360 allows a Merkle path of at most 128 nodes, so tmr() accepts 128 nesting levels and
+ *  refuses 129. */
+BOOST_AUTO_TEST_CASE(tmr_max_depth_test)
+{
+    const std::string key_a{"a34b99f22c790c4e36b2b3c2c35a36db06226e41c692fc82b8b56ac1c540c5bd"};
+    const std::string key_b{"03a34b99f22c790c4e36b2b3c2c35a36db06226e41c692fc82b8b56ac1c540c5"};
+    const auto caterpillar{[&](int depth) {
+        std::string desc{"tmr("};
+        for (int i = 0; i < depth; ++i) desc += "{";
+        desc += "pk(" + key_a + ")";
+        for (int i = 0; i < depth; ++i) desc += ",pk(" + key_b + ")}";
+        return desc + ")";
+    }};
+
+    FlatSigningProvider keys;
+    std::string error;
+    auto parsed{Parse(caterpillar(128), keys, error)};
+    BOOST_CHECK_MESSAGE(parsed.size() == 1, error);
+    std::vector<CScript> scripts;
+    FlatSigningProvider out;
+    BOOST_CHECK(parsed.at(0)->Expand(0, keys, scripts, out));
+    BOOST_CHECK_EQUAL(scripts.size(), 1U);
+    BOOST_CHECK_EQUAL(scripts.at(0).size(), 34U);
+    // The single leaf at the bottom of the caterpillar needs the full 128 node Merkle path.
+    BOOST_REQUIRE_EQUAL(out.p2mr_trees.size(), 1U);
+    const CScript deep_leaf{CScript() << "a34b99f22c790c4e36b2b3c2c35a36db06226e41c692fc82b8b56ac1c540c5bd"_hex_v_u8 << OP_CHECKSIG};
+    const P2MRSpendData deep_spend{out.p2mr_trees.begin()->second.GetP2MRSpendData()};
+    const auto deep_it{deep_spend.scripts.find({std::vector<unsigned char>(deep_leaf.begin(), deep_leaf.end()), TAPROOT_LEAF_TAPSCRIPT})};
+    BOOST_REQUIRE(deep_it != deep_spend.scripts.end());
+    BOOST_CHECK_EQUAL(deep_it->second.begin()->size(), P2MR_CONTROL_BASE_SIZE + P2MR_CONTROL_NODE_SIZE * 128);
+
+    CheckUnparsable("", caterpillar(129), "tmr() supports at most 128 nesting levels");
+}
