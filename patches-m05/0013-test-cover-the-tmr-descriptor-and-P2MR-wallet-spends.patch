+#!/usr/bin/env python3
+# Copyright (c) 2026 CipherScope
+# Distributed under the MIT software license, see the accompanying
+# file COPYING or http://www.opensource.org/licenses/mit-license.php.
+"""Wallet support for BIP360 P2MR outputs through the provisional tmr() descriptor.
+
+Covers importing a tmr() descriptor, receiving to the resulting bcrt1z address,
+spending it automatically with send() and through the PSBT flow, the descriptor
+inferred for a P2MR output, and the refusal to express an anyone-can-spend
+single-leaf tree.
+"""
+
+from decimal import Decimal
+
+from test_framework.descriptors import descsum_create
+from test_framework.test_framework import BitcoinTestFramework
+from test_framework.util import (
+    assert_equal,
+    assert_greater_than,
+    assert_raises_rpc_error,
+)
+from test_framework.wallet_util import generate_keypair
+
+# BIP360 control block: one leaf version byte plus 32 bytes per Merkle path element.
+P2MR_CONTROL_BASE_SIZE = 1
+P2MR_CONTROL_NODE_SIZE = 32
+# BIP341 tapscript leaf version, the only one tmr() builds.
+TAPROOT_LEAF_TAPSCRIPT = 0xC0
+# Test-only extended private key, reused from wallet_taproot.py.
+XPRV = "tprv8ZgxMBicQKsPeNLUGrbv3b7qhUk1LQJZAGMuk9gVuKh9sd4BWGp1eMsehUni6qGb8bjkdwBxCbgNGdh2bYGACK5C5dRTaif9KBKGVnSezxV"
+
+
+class WalletP2MRTest(BitcoinTestFramework):
+    def set_test_params(self):
+        self.num_nodes = 1
+        self.setup_clean_chain = True
+        self.extra_args = [["-txindex"]]
+
+    def skip_test_if_missing_module(self):
+        self.skip_if_no_wallet()
+
+    def init_wallet(self, *, node):
+        pass
+
+    # -- helpers -------------------------------------------------------------
+
+    def make_leaf_keys(self, count):
+        """Return (wif, xonly_hex) pairs for `count` freshly generated keys."""
+        keys = []
+        for _ in range(count):
+            wif, pubkey = generate_keypair(wif=True)
+            keys.append((wif, pubkey[1:].hex()))
+        return keys
+
+    def import_tmr(self, wallet, inner, **kwargs):
+        """Import tmr(<inner>) into `wallet`; return (import result, descriptor)."""
+        desc = descsum_create(f"tmr({inner})")
+        request = {"desc": desc, "timestamp": "now"}
+        request.update(kwargs)
+        return wallet.importdescriptors([request])[0], desc
+
+    def derive_address(self, desc, desc_range=None):
+        args = [desc] if desc_range is None else [desc, desc_range]
+        addresses = self.nodes[0].deriveaddresses(*args)
+        if desc_range is None:
+            assert_equal(len(addresses), 1)
+            return addresses[0]
+        return addresses
+
+    def assert_p2mr_address(self, wallet, address):
+        info = wallet.getaddressinfo(address)
+        assert address.startswith("bcrt1z"), address
+        assert_equal(info["iswitness"], True)
+        assert_equal(info["witness_version"], 2)
+        assert_equal(len(info["witness_program"]), 64)
+        assert_equal(info["ismine"], True)
+        assert_equal(info["solvable"], True)
+        # getaddressinfo reports the witness version and program; the script type
+        # itself is spelled out by decodescript.
+        assert_equal(self.nodes[0].decodescript(info["scriptPubKey"])["type"], "witness_v2_p2mr")
+        # The wallet knows the whole tree, so it infers a tmr() descriptor back.
+        assert info["desc"].startswith("tmr("), info["desc"]
+        return info
+
+    def assert_p2mr_spend(self, txid, expected_control_len=None):
+        """Check that every P2MR input of `txid` is a BIP360 script path spend."""
+        tx = self.nodes[0].getrawtransaction(txid, True)
+        p2mr_inputs = 0
+        for txin in tx["vin"]:
+            prev = self.nodes[0].getrawtransaction(txin["txid"], True)
+            if prev["vout"][txin["vout"]]["scriptPubKey"]["type"] != "witness_v2_p2mr":
+                continue
+            p2mr_inputs += 1
+            witness = txin["txinwitness"]
+            # [leaf satisfaction..., leaf script, control block]; there is no key path.
+            assert_greater_than(len(witness), 2)
+            control = bytes.fromhex(witness[-1])
+            depth, remainder = divmod(len(control) - P2MR_CONTROL_BASE_SIZE, P2MR_CONTROL_NODE_SIZE)
+            assert_equal(remainder, 0)
+            # A depth-zero leaf would be anyone-can-spend, and tmr() never builds one.
+            assert_greater_than(depth, 0)
+            # BIP360 leaves the last bit of c[0] unused and requires it to be 1.
+            assert_equal(control[0] & 1, 1)
+            assert_equal(control[0] & 0xFE, TAPROOT_LEAF_TAPSCRIPT)
+            if expected_control_len is not None:
+                assert_equal(len(control), expected_control_len)
+        assert_greater_than(p2mr_inputs, 0)
+        return tx
+
+    # -- test cases ----------------------------------------------------------
+
+    def run_test(self):
+        node = self.nodes[0]
+
+        node.createwallet(wallet_name="funder")
+        self.funder = node.get_wallet_rpc("funder")
+        self.generatetoaddress(node, 101, self.funder.getnewaddress())
+
+        self.test_import_and_receive()
+        self.test_send()
+        self.test_psbt()
+        self.test_single_leaf_refused()
+        self.test_ranged_and_no_output_type()
+        self.test_nested_tree()
+
+    def test_import_and_receive(self):
+        self.log.info("Import a two leaf tmr() descriptor and receive to it")
+        node = self.nodes[0]
+        node.createwallet(wallet_name="p2mr")
+        self.wallet = node.get_wallet_rpc("p2mr")
+
+        keys = self.make_leaf_keys(2)
+        inner = "{{pk({}),pk({})}}".format(keys[0][0], keys[1][0])
+        result, desc = self.import_tmr(self.wallet, inner)
+        assert_equal(result["success"], True)
+
+        self.address = self.derive_address(desc)
+        info = self.assert_p2mr_address(self.wallet, self.address)
+        for _, xonly in keys:
+            assert xonly in info["desc"], info["desc"]
+
+        self.funder.sendtoaddress(self.address, 5)
+        self.generate(node, 1)
+
+        utxos = self.wallet.listunspent()
+        assert_equal(len(utxos), 1)
+        assert_equal(utxos[0]["address"], self.address)
+        assert_equal(utxos[0]["amount"], Decimal("5"))
+        assert_equal(utxos[0]["solvable"], True)
+        assert utxos[0]["desc"].startswith("tmr("), utxos[0]["desc"]
+        assert_equal(self.wallet.getbalance(), Decimal("5"))
+
+    def test_send(self):
+        self.log.info("Spend a P2MR output automatically with send()")
+        destination = self.funder.getnewaddress()
+        result = self.wallet.send({destination: 1}, fee_rate=10)
+        assert_equal(result["complete"], True)
+        txid = result["txid"]
+
+        tx = self.assert_p2mr_spend(txid, expected_control_len=P2MR_CONTROL_BASE_SIZE + P2MR_CONTROL_NODE_SIZE)
+        assert_equal(len(tx["vin"]), 1)
+
+        # The change must not be P2MR: the wallet cannot generate P2MR addresses.
+        change_types = {
+            vout["scriptPubKey"]["type"]
+            for vout in tx["vout"]
+            if vout["scriptPubKey"]["address"] != destination
+        }
+        assert_equal(len(change_types), 1)
+        assert "witness_v2_p2mr" not in change_types, change_types
+
+        self.generate(self.nodes[0], 1)
+        wtx = self.wallet.gettransaction(txid)
+        assert_equal(wtx["confirmations"], 1)
+        # The spent P2MR output is gone; the change came back to the wallet.
+        assert self.address not in {u["address"] for u in self.wallet.listunspent()}
+        assert_greater_than(self.wallet.getbalance(), Decimal("3"))
+
+    def test_psbt(self):
+        self.log.info("Spend a P2MR output through the PSBT flow")
+        node = self.nodes[0]
+        self.funder.sendtoaddress(self.address, 2)
+        self.generate(node, 1)
+
+        utxo = next(u for u in self.wallet.listunspent() if u["address"] == self.address)
+        destination = self.funder.getnewaddress()
+        funded = self.wallet.walletcreatefundedpsbt(
+            inputs=[{"txid": utxo["txid"], "vout": utxo["vout"]}],
+            outputs=[{destination: 1}],
+            options={"fee_rate": 10, "add_inputs": False},
+        )
+        processed = self.wallet.walletprocesspsbt(funded["psbt"])
+        assert_equal(processed["complete"], True)
+        finalized = node.finalizepsbt(processed["psbt"])
+        assert_equal(finalized["complete"], True)
+
+        txid = node.sendrawtransaction(finalized["hex"])
+        self.generate(node, 1)
+        self.assert_p2mr_spend(txid, expected_control_len=P2MR_CONTROL_BASE_SIZE + P2MR_CONTROL_NODE_SIZE)
+        assert_equal(self.wallet.gettransaction(txid)["confirmations"], 1)
+
+    def test_single_leaf_refused(self):
+        self.log.info("A single leaf tmr() tree is refused because it is anyone-can-spend")
+        keys = self.make_leaf_keys(1)
+        assert_raises_rpc_error(
+            -5,
+            "tmr(): a single-leaf tree is anyone-can-spend",
+            self.nodes[0].getdescriptorinfo,
+            "tmr(pk({}))".format(keys[0][1]),
+        )
+
+    def test_ranged_and_no_output_type(self):
+        self.log.info("A ranged tmr() descriptor derives addresses but cannot become active")
+        node = self.nodes[0]
+        node.createwallet(wallet_name="p2mr_ranged")
+        wallet = node.get_wallet_rpc("p2mr_ranged")
+        inner = "{{pk({x}/0/*),pk({x}/1/*)}}".format(x=XPRV)
+        # Only ranged descriptors may be requested as active, so this is also the
+        # case that reaches the output type check.
+        result, desc = self.import_tmr(wallet, inner, active=True, range=[0, 4])
+        assert_equal(result["success"], True)
+        assert_equal(result["warnings"], ["Unknown output type, cannot set descriptor to active."])
+
+        addresses = self.derive_address(desc, [0, 4])
+        assert_equal(len(addresses), 5)
+        assert_equal(len(set(addresses)), 5)
+        for address in addresses:
+            self.assert_p2mr_address(wallet, address)
+
+        # Address generation keeps using the wallet's own descriptors.
+        assert not wallet.getnewaddress().startswith("bcrt1z")
+        assert not wallet.getrawchangeaddress().startswith("bcrt1z")
+
+        # The derived P2MR outputs are still spendable.
+        self.funder.sendtoaddress(addresses[3], 1)
+        self.generate(node, 1)
+        assert_equal(wallet.getbalance(), Decimal("1"))
+        result = wallet.sendall([self.funder.getnewaddress()])
+        assert_equal(result["complete"], True)
+        self.assert_p2mr_spend(result["txid"])
+        self.generate(node, 1)
+        assert_equal(wallet.getbalance(), Decimal("0"))
+
+    def test_nested_tree(self):
+        self.log.info("Receive and spend a nested three leaf tmr() tree")
+        node = self.nodes[0]
+        node.createwallet(wallet_name="p2mr_nested")
+        wallet = node.get_wallet_rpc("p2mr_nested")
+        keys = self.make_leaf_keys(3)
+        inner = "{{{{pk({}),pk({})}},pk({})}}".format(keys[0][0], keys[1][0], keys[2][0])
+        result, desc = self.import_tmr(wallet, inner)
+        assert_equal(result["success"], True)
+
+        address = self.derive_address(desc)
+        self.assert_p2mr_address(wallet, address)
+
+        self.funder.sendtoaddress(address, 3)
+        self.generate(node, 1)
+        assert_equal(wallet.getbalance(), Decimal("3"))
+
+        result = wallet.sendall([self.funder.getnewaddress()])
+        assert_equal(result["complete"], True)
+        # Two leaves sit at depth 2 and one at depth 1; signing picks the cheapest
+        # control block, which is the single Merkle node of the shallow leaf.
+        self.assert_p2mr_spend(
+            result["txid"], expected_control_len=P2MR_CONTROL_BASE_SIZE + P2MR_CONTROL_NODE_SIZE
+        )
+
+        self.generate(node, 1)
+        assert_equal(wallet.getbalance(), Decimal("0"))
+
+
+if __name__ == "__main__":
+    WalletP2MRTest(__file__).main()
