-        && a.tr_trees == b.tr_trees;
+        && a.tr_trees == b.tr_trees
+        && a.p2mr_trees == b.p2mr_trees;
 }
 
 std::string UseHInsteadOfApostrophe(const std::string& desc)
@@ -623,6 +624,12 @@ BOOST_AUTO_TEST_CASE(descriptor_test)
